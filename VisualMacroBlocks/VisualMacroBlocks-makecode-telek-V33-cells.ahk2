        check("V25 trim: last 200 kept, newest last", v25Cut.Length . "|" . v25Cut[1]["When"] . "|" . v25Cut[200]["When"], "200|t6|t205")
        check("V25 trim: header stays first, short file unchanged", SubStr(V25_TrimRuns(v25Many), 1, 5) . "|" . (V25_TrimRuns(v25Txt . "") != "" ? 1 : 0), "When,|1")
        check("V25 runs path", V25_RunsPath("C:\m\order.vmacro.json") . "|" . V25_RunsPath("") . "|" . V25_RunsPath("C:\m\plain"), "C:\m\order.vmacro.runs.csv||C:\m\plain.runs.csv")
