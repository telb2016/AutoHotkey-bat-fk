        check("V27 typed text: in quotes", v27T["text"], v27Q . "hello" . v27Q)
        check("V27 typed text: no mouse cells", v27T["button"], "–")
        v27A := V27_Cells(Map("type", "text", "text", "secret password", "ask", 1), v27Ctx)
