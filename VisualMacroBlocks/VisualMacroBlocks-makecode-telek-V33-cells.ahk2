    const base = el.id ? "#" + E(el.id) : ec.length ? tag + "." + ec[0] : tag;
    for (let p = el.parentElement; p; p = p.parentElement)
        if (p.id && unique(rt, "#" + E(p.id))) { add("#" + E(p.id) + " " + base); break; }
    if (el.parentElement) add(compact(el.parentElement) + " > " + base);
    add(tag);
    const cands = [];
    for (const l of locals) {
        let found;
        try { found = query(doc, prefix + l); } catch (_) { continue; }
        const pos = found.indexOf(el) + 1;
        if (pos) cands.push({selector: prefix + l, count: found.length, pos: pos});
    }
    cands.sort((x, y) => (x.count === 1 ? 0 : x.count) - (y.count === 1 ? 0 : y.count));
    const parts = [{group: "tag", label: "tag     " + tag, css: tag}];
    if (el.id) parts.push({group: "id", label: "id     #" + el.id, css: "#" + E(el.id)});
    for (const c of cl) parts.push({group: "class", label: "class     ." + c, css: "." + E(c)});
    for (const at of Array.from(el.attributes)) {
        if (["id", "class", "style", "value"].includes(at.name) || /^on/i.test(at.name) || at.value.length > 150) continue;
        parts.push({group: "attr", label: at.name + (at.value === "" ? "     (present)" : '     = "' + short(at.value, 70) + '"'),
            css: "[" + E(at.name) + (at.value === "" ? "" : '="' + E(at.value) + '"') + "]"});
    }
    const par = el.parentElement;
    if (par) {
        const peers = Array.from(par.children).filter(e => e.localName === tag);
        if (peers.length > 1) {
            const k = peers.indexOf(el) + 1;
            parts.push({group: "position", label: "position     :nth-of-type(" + k + ")     (" + tag + " number " + k + " of " + peers.length + " here)",
                css: ":nth-of-type(" + k + ")"});
        }
        parts.push({group: "parent", label: "directly inside     " + compact(par) + "  >", css: compact(par) + " > "});
        for (let p = par.parentElement; p; p = p.parentElement) {
            if (p.id && unique(rt, "#" + E(p.id))) {
                parts.push({group: "inside", label: "somewhere inside     #" + p.id, css: "#" + E(p.id) + " "});
                break;
            }
            const tid = p.getAttribute("data-testid");
            if (tid && unique(rt, '[data-testid="' + E(tid) + '"]')) {
                parts.push({group: "inside", label: 'somewhere inside     [data-testid="' + tid + '"]', css: '[data-testid="' + E(tid) + '"] '});
                break;
            }
        }
    }
    return {element: true, label: info(el).label, props: props, cands: cands, parts: parts, prefix: prefix, frame: frame, tag: tag};
}
if (a.cmd === "find") {
    const needle = String(a.text || "").toLowerCase().trim(), ids = [];
    let total = 0;
    if (!needle) return {ids: ids, total: 0};
    const walk = root => {
        for (const el of Array.from(root.querySelectorAll("*"))) {
            const hay = [el.localName, el.id, el.getAttribute("class"), el.getAttribute("name"), el.getAttribute("aria-label"),
                el.getAttribute("placeholder"), el.getAttribute("title"), el.getAttribute("data-testid"), el.getAttribute("href"),
                el.getAttribute("role"), ownText(el)].join(" ").toLowerCase();
            if (hay.includes(needle)) { total++; if (ids.length < 300) ids.push(reg(el)); }
            if (el.shadowRoot) walk(el.shadowRoot);
            const fd = frameDoc(el);
            if (fd) walk(fd);
        }
    };
    walk(document);
    return {ids: ids, total: total};
}
if (a.cmd === "highlight") {
    api.clear();
    let first = null;
    const done = new Set();
    for (const id of (a.ids || []).slice(0, 60)) {
        const el = api.nodes[Number(id)];
        if (!isEl(el) || !el.style || done.has(el)) continue;
        done.add(el);
        api.lit.push([el, el.style.outline, el.style.outlineOffset]);
        el.style.outline = first ? "2px dashed #ff00aa" : "3px solid #ff00aa";
        el.style.outlineOffset = "2px";
        if (!first) first = el;
    }
    if (first && a.scroll) {
        try {
            for (let d = first.ownerDocument; d && d !== document; ) {
                const fe = d.defaultView.frameElement;
                if (!fe) break;
                fe.scrollIntoView({block: "nearest", inline: "nearest"});
                d = fe.ownerDocument;
            }
            first.scrollIntoView({block: "nearest", inline: "nearest"});
        } catch (_) {}
    }
    return api.lit.length;
}
if (a.cmd === "clear") { api.clear(); return true; }
throw new Error("Unknown element tree command: " + a.cmd);
}
)"
}


; ============================================================================
; V7 APPLE-INSPIRED UX, ADHD WORKING-MEMORY HUB & PROTOTYPING HUD
; ============================================================================

; @summary Shows and activates the main Visual Macro Blocks editor window.
; @tags macro, gui, v7
V7_ShowMainGui(*) {
    s := VMB()
    if !s.Gui
        return
    s.Gui.Show()
    WinActivate("ahk_id " . s.Gui.Hwnd)
    V7_RefreshMemoryBar()
    V7_SyncIdleHud()
}

; @summary Ctrl+Shift+M: brings back the main window when hidden/inactive, or opens the "Where Was I?" Memory Hub when already active.
; @tags macro, gui, hotkey, v7
V7_ShowOrHub(*) {
    s := VMB()
    if !s.Gui
        return
    if !DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int") || !WinActive("ahk_id " . s.Gui.Hwnd)
        V7_ShowMainGui()
    else
        V7_MemoryHub()
}

; @summary Schedules a debounced background auto-save (1.5 s after the last edit) so work is never lost.
; @tags macro, file, autosave, v7
V7_ScheduleAutoSave() {
    SetTimer(V7_AutoSaveNow, -1500)
}

; @summary Saves a draft copy silently (and saves to the current file if Auto-save is checked and no privacy warning triggers).
; @tags macro, file, autosave, v7
V7_AutoSaveNow(*) {
    s := VMB()
    if !s.Gui || !(s.Macro is Map) || VM_IsRecording() || VM_IsPlaying()
        return
    try VMB_ControlsToSettings()
    try {
        if s.AutoSavePath != "" && s.Macro["blocks"].Length
            VM_Save(s.Macro, s.AutoSavePath)
    }
    if s.Ctl.Has("AutoSave") && s.Ctl["AutoSave"].Value && s.Path != "" && s.Dirty {
        if !VM_Validate(s.Macro).Length && !V7_HasPrivacyFindings(s.Macro) {
            try {
                VM_Save(s.Macro, s.Path)
                s.Dirty := false
                s.LastSavedAt := FormatTime(, "HH:mm:ss")
                VMB_UpdateTitle()
            }
        }
    }
    V7_RefreshMemoryBar()
}

; @summary Non-interactive check for whether the macro has potential PHI findings (so auto-save never pops a modal).
; @tags macro, privacy, v7
V7_HasPrivacyFindings(macro) {
    setText := []
    VMB__CollectSetValues(macro["blocks"], setText)
    if setText.Length && VM_PrivacyScan(Map("steps", setText)).Length
        return true
    return VM_PrivacyScan(Map("steps", VMF_Flatten(macro["blocks"]))).Length > 0
}

; @summary Loads the macro's saved Goal / Next-Step note into the top "Where Was I:" bar.
; @tags macro, adhd, memory, v7
V7_LoadMemoryBar() {
    s := VMB()
    if !s.Ctl.Has("GoalNote")
        return
    note := ""
    if s.Macro is Map && s.Macro.Get("settings", "") is Map
        note := s.Macro["settings"].Get("goalNote", "")
    if note = "" && s.Ini != ""
        note := IniRead(s.Ini, "V7", "LastGoalNote", "")
    s.Ctl["GoalNote"].Value := note
    V7_RefreshMemoryBar()
}

; @summary Updates the Goal / Next-Step note when typed in the "Where Was I:" bar.
; @tags macro, adhd, memory, v7
V7_OnGoalChanged(ctl, *) {
    s := VMB()
    if !(s.Macro is Map) || !(s.Macro.Get("settings", "") is Map)
        return
    val := Trim(ctl.Value)
    if s.Macro["settings"].Get("goalNote", "") == val
        return
    VM__SetOrDelete(s.Macro["settings"], "goalNote", val)
    if s.Ini != ""
        try IniWrite(StrReplace(val, "`n", " "), s.Ini, "V7", "LastGoalNote")
    s.Dirty := true
    V7_ScheduleAutoSave()
    V7_SyncIdleHud()
}

; @summary Updates the right-hand summary in the "Where Was I:" bar with script name, pinned app, and last save time.
; @tags macro, adhd, memory, v7
V7_RefreshMemoryBar() {
    s := VMB()
    if !s.Ctl.Has("WhereInfo")
        return
    pins := V7_GetRecent("PinnedContext")
    pinLabel := pins.Length ? pins[1] : "(no app pinned)"
    if InStr(pinLabel, "|") {
        parts := StrSplit(pinLabel, "|")
        pinLabel := parts[1] . (parts.Length >= 2 && parts[2] != "" ? " (" . SubStr(parts[2], 1, 26) . ")" : "")
    }
    savedInfo := s.LastSavedAt != "" ? "Saved " . s.LastSavedAt : (s.Path != "" ? "File ready" : "Draft auto-saved")
    s.Ctl["WhereInfo"].Value := savedInfo . "  •  Pinned: " . pinLabel . "  •  Script: " . A_ScriptName
}

; @summary Stores a recent item (up to 10 unique entries, newest first) in the V7 INI under key.
; @tags macro, adhd, memory, v7
V7_AddRecent(key, value) {
    s := VMB()
    value := Trim(String(value))
    if value = "" || s.Ini = ""
        return
    items := V7_GetRecent(key)
    out := [value]
    for item in items {
        if StrLower(item) != StrLower(value) && out.Length < 10
            out.Push(item)
    }
    joined := ""
    for i, item in out
        joined .= (i > 1 ? "||" : "") . StrReplace(StrReplace(item, "`r"), "`n", " ")
    try IniWrite(joined, s.Ini, "V7Recent", key)
    V7_RefreshMemoryBar()
}

; @summary Reads a recent list from the V7 INI under key.
; @tags macro, adhd, memory, v7
V7_GetRecent(key) {
    s := VMB()
    if s.Ini = ""
        return []
    raw := IniRead(s.Ini, "V7Recent", key, "")
    if raw = ""
        return []
    out := []
    for item in StrSplit(raw, "||") {
        if Trim(item) != ""
            out.Push(Trim(item))
    }
    return out
}

; @summary Pins the last active external window (process, title, executable path) so you can remember and reopen it tomorrow.
; @tags macro, adhd, memory, v7
V7_PinActiveContext(*) {
    s := VMB()
    targetHwnd := 0
    for hwnd in WinGetList() {
        try {
            if WinGetPID("ahk_id " . hwnd) = DllCall("GetCurrentProcessId")
                continue
            title := WinGetTitle("ahk_id " . hwnd)
            cls := WinGetClass("ahk_id " . hwnd)
            if title = "" || cls = "Progman" || cls = "WorkerW" || cls = "Shell_TrayWnd"
                continue
            targetHwnd := hwnd
            break
        }
    }
    if !targetHwnd
        return VMB_Status("Could not find an active external window to pin.")
    exe := "", title := "", fullPath := ""
    try exe := WinGetProcessName("ahk_id " . targetHwnd)
    try title := WinGetTitle("ahk_id " . targetHwnd)
    try fullPath := ProcessGetPath(WinGetPID("ahk_id " . targetHwnd))
    entry := exe . "|" . StrReplace(title, "|", "-") . "|" . fullPath . "|" . FormatTime(, "yyyy-MM-dd HH:mm")
    V7_AddRecent("PinnedContext", entry)
    VMB_Status("📌 Pinned: " . exe . " - " . SubStr(title, 1, 60) . " (use 'Open pinned' or F1 Memory Hub tomorrow).")
}

; @summary Shows a menu of pinned apps/windows and pinned files to jump back to or relaunch.
; @tags macro, adhd, memory, v7
V7_OpenPinnedMenu(*) {
    m := Menu()
    pins := V7_GetRecent("PinnedContext")
    if pins.Length {
        for entry in pins {
            parts := StrSplit(entry, "|")
            exe := parts.Length >= 1 ? parts[1] : entry
            title := parts.Length >= 2 ? parts[2] : ""
            path := parts.Length >= 3 ? parts[3] : ""
            when := parts.Length >= 4 ? parts[4] : ""
            label := "📌 " . exe . (title != "" ? "  —  " . SubStr(title, 1, 45) : "") . (when != "" ? "  [" . when . "]" : "")
            m.Add(label, ((e, t, p, *) => V7_ActivateOrLaunchPin(e, t, p)).Bind(exe, title, path))
        }
        m.Add()
    }
    files := V7_GetRecent("PinnedFiles")
    if files.Length {
        for f in files
            m.Add("📄 " . f, ((fp, *) => V7_OpenPathOrReveal(fp)).Bind(f))
        m.Add()
    }
    m.Add("Pin current external window now", V7_PinActiveContext)
    m.Add("Pin a reference file or document...", V7_PinFileDialog)
    m.Add("Open full 'Where Was I?' Memory Hub...`tF1", V7_MemoryHub)
    m.Show()
}

; @summary Activates a pinned window if open, or launches its executable / file path if closed.
; @tags macro, adhd, memory, v7
V7_ActivateOrLaunchPin(exe, title, path) {
    if exe != "" && WinExist("ahk_exe " . exe) {
        WinActivate("ahk_exe " . exe)
        VMB_Status("Switched to " . exe . ".")
        return
    }
    if path != "" && FileExist(path) {
        try {
            Run('"' . path . '"')
            VMB_Status("Launched " . path)
            return
        }
    }
    VMB_Status("Window '" . exe . "' is not currently open.")
}

; @summary Lets the user pin any reference file, spreadsheet, or script so it stays on their Memory Hub list.
; @tags macro, adhd, memory, v7
V7_PinFileDialog(*) {
    s := VMB()
    path := FileSelect(1, s.Dir, "Pin a file or script to remember for this project")
    if path = ""
        return
    V7_AddRecent("PinnedFiles", path)
    VMB_Status("Pinned file: " . path)
}

; @summary Shows a quick menu of recent macros and recent data files.
; @tags macro, file, adhd, v7
V7_ShowRecentMenu(*) {
    m := Menu()
    macros := V7_GetRecent("Macros")
    if macros.Length {
        for path in macros
            m.Add("Macro: " . path, ((p, *) => V7_OpenRecentMacro(p)).Bind(path))
    } else {
        m.Add("(No recent macros yet)", (*) => 0)
        m.Disable("(No recent macros yet)")
    }
    m.Add()
    datas := V7_GetRecent("DataFiles")
    if datas.Length {
        for path in datas
            m.Add("Data: " . path, ((p, *) => VMB_SetDataFile(p)).Bind(path))
    }
    if FileExist(VMB().AutoSavePath) {
        m.Add()
        m.Add("Restore last auto-saved session draft", (*) => VMB_LoadFile(VMB().AutoSavePath))
    }
    m.Show()
}

V7_OpenRecentMacro(path) {
    if VM_IsRecording() || VM_IsPlaying() || !VMB_ConfirmDiscard()
        return
    if !FileExist(path)
        return VMB_Status("File no longer exists: " . path)
    try VMB_LoadFile(path)
    catch as err
        VMB_Status(err.Message)
}

; @summary Shows a one-click Folders & Files menu so you never forget where your script, macros, data, or logs live.
; @tags macro, file, adhd, v7
V7_ShowFoldersMenu(*) {
    s := VMB()
    m := Menu()
    m.Add("📂 Open Macros folder (" . s.Dir . ")", (*) => V7_OpenFolder(s.Dir))
    if s.Path != ""
        m.Add("📄 Reveal current macro file in Explorer", (*) => V7_RevealInExplorer(s.Path))
    m.Add("📜 Reveal this running AHK script (" . A_ScriptName . ")", (*) => V7_OpenScriptFolder())
    m.Add("📋 Copy this script's full path to clipboard", (*) => (A_Clipboard := A_ScriptFullPath, VMB_Status("Copied: " . A_ScriptFullPath)))
    m.Add()
    m.Add("📊 Open Data files folder", (*) => V7_OpenFolder(s.Dir . "\data"))
    m.Add("📈 Open Results CSV folder", (*) => V7_OpenFolder(s.Dir . "\results"))
    m.Add("📦 Open Exported players folder", (*) => V7_OpenFolder(s.Dir . "\export"))
    if FileExist(VM_Config().LogPath)
        m.Add("📝 Open last playback log", (*) => V7_OpenPathOrReveal(VM_Config().LogPath))
    m.Show()
}

V7_OpenFolder(dir) {
    try {
        if !DirExist(dir)
            DirCreate(dir)
        Run('explorer.exe "' . dir . '"')
    } catch as err
        VMB_Status("Could not open folder: " . err.Message)
}

V7_RevealInExplorer(path) {
    if FileExist(path) {
        try Run('explorer.exe /select,"' . path . '"')
    } else
        V7_OpenFolder(VMB().Dir)
}

V7_OpenScriptFolder(*) {
    V7_RevealInExplorer(A_ScriptFullPath)
}

V7_OpenPathOrReveal(path) {
    if FileExist(path) {
        try Run('"' . path . '"')
    } else
        VMB_Status("File not found: " . path)
}

; @summary F1 / "Where Was I?" button: opens the ADHD Working-Memory & Context Hub showing everything about what you
;          were doing, which script/macro/data files were in use, pinned windows, and project scratchpad notes.
; @tags macro, adhd, memory, gui, v7
V7_MemoryHub(*) {
    s := VMB()
    V7_ShowMainGui()
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "Where Was I? — Working Memory & File Hub (Visual Macro Blocks V8)")
    dlg.SetFont("s10 bold", "Segoe UI")
    dlg.AddText("xm ym w760 c0A84FF", "🧠 Welcome back! Here is everything you were working on:")
    dlg.SetFont("s9 norm", "Segoe UI")

    curMacro := s.Path != "" ? s.Path : "(Unsaved draft — auto-saved to " . s.AutoSavePath . ")"
    dataSet := s.Macro["settings"].Get("data", "")
    curData := dataSet is Map && dataSet.Get("path", "") != "" ? dataSet["path"] : "(No data file attached)"
    targetApps := V7_CollectMacroApps(s.Macro["blocks"])

    infoText := "Running Script:   " . A_ScriptFullPath
        . "`r`nCurrent Macro:    " . curMacro . "   (" . s.FlatIndex.Count . " steps)"
        . "`r`nCurrent Data:     " . curData
        . "`r`nTarget Programs:  " . (targetApps != "" ? targetApps : "(none recorded yet)")
    dlg.AddEdit("xm y+8 w760 r4 ReadOnly BackgroundF5F7FA", infoText)

    btnScript := dlg.AddButton("xm y+6 w180 h26", "Reveal Running Script")
    btnMacroDir := dlg.AddButton("x+6 yp w170 h26", "Open Macros Folder")
    btnDataDir := dlg.AddButton("x+6 yp w160 h26", "Open Data Folder")
    btnResDir := dlg.AddButton("x+6 yp w160 h26", "Open Results Folder")
    btnCopyAll := dlg.AddButton("x+6 yp w66 h26", "Copy")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+14 w760", "1. What I was doing / Next step to build or test (saved with macro & remembered tomorrow):")
    dlg.SetFont("s9 norm", "Segoe UI")
    edGoal := dlg.AddEdit("xm y+4 w760", s.Ctl["GoalNote"].Value)

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+10 w760", "2. Project Scratchpad & Checklist (jot file paths, test accounts, or reminders):")
    dlg.SetFont("s9 norm", "Segoe UI")
    scratch := s.Macro["settings"].Get("scratchpad", "")
    if scratch = "" && s.Ini != ""
        scratch := StrReplace(IniRead(s.Ini, "V7", "Scratchpad", ""), "\n", "`r`n")
    edScratch := dlg.AddEdit("xm y+4 w760 r5 +WantReturn", scratch)

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+10 w375", "3. Recent Macros & Data Files (double-click to open):")
    dlg.AddText("x+10 yp w375", "4. Pinned Windows & Reference Files (double-click to open):")
    dlg.SetFont("s9 norm", "Segoe UI")
    lvRecent := dlg.AddListView("xm y+4 w375 h150 -Multi +NoSortHdr", ["Type", "Path"])
    lvRecent.ModifyCol(1, 65), lvRecent.ModifyCol(2, 290)
    for mPath in V7_GetRecent("Macros")
        lvRecent.Add(, "Macro", mPath)
    for dPath in V7_GetRecent("DataFiles")
        lvRecent.Add(, "Data", dPath)
    if FileExist(s.AutoSavePath)
        lvRecent.Add(, "Draft", s.AutoSavePath)

    lvPins := dlg.AddListView("x+10 yp w375 h150 -Multi +NoSortHdr", ["Kind", "Target / File"])
    lvPins.ModifyCol(1, 75), lvPins.ModifyCol(2, 280)
    for pEntry in V7_GetRecent("PinnedContext") {
        parts := StrSplit(pEntry, "|")
        lvPins.Add(, "App", (parts.Length >= 1 ? parts[1] : "") . " — " . (parts.Length >= 2 ? parts[2] : ""))
    }
    for fEntry in V7_GetRecent("PinnedFiles")
        lvPins.Add(, "File", fEntry)

    btnPinWin := dlg.AddButton("xm y+8 w170 h28", "📌 Pin Active Window")
    btnPinFile := dlg.AddButton("x+6 yp w170 h28", "📎 Pin a File...")
    btnSave := dlg.AddButton("x+230 yp w110 h28 Default", "Save & Close")
    btnCancel := dlg.AddButton("x+6 yp w80 h28", "Close")

    btnScript.OnEvent("Click", V7_OpenScriptFolder)
    btnMacroDir.OnEvent("Click", (*) => V7_OpenFolder(s.Dir))
    btnDataDir.OnEvent("Click", (*) => V7_OpenFolder(s.Dir . "\data"))
    btnResDir.OnEvent("Click", (*) => V7_OpenFolder(s.Dir . "\results"))
    btnCopyAll.OnEvent("Click", (*) => (A_Clipboard := infoText . "`r`nGoal: " . edGoal.Value . "`r`nNotes:`r`n" . edScratch.Value,
        VMB_Status("Copied project summary to clipboard.")))
    btnPinWin.OnEvent("Click", (*) => (V7_PinActiveContext(), dlg.Destroy(), V7_MemoryHub()))
    btnPinFile.OnEvent("Click", (*) => (V7_PinFileDialog(), dlg.Destroy(), V7_MemoryHub()))

    lvRecent.OnEvent("DoubleClick", (ctl, row) => row ? (
        kind := ctl.GetText(row, 1), p := ctl.GetText(row, 2),
        saveHub(),
        kind = "Data" ? VMB_SetDataFile(p) : V7_OpenRecentMacro(p)
    ) : 0)

    lvPins.OnEvent("DoubleClick", (ctl, row) => row ? (
        kind := ctl.GetText(row, 1), val := ctl.GetText(row, 2),
        kind = "File" ? V7_OpenPathOrReveal(val) : V7_OpenPinnedRow(row)
    ) : 0)

    saveHub(*) {
        s.Ctl["GoalNote"].Value := Trim(edGoal.Value)
        V7_OnGoalChanged(s.Ctl["GoalNote"])
        VM__SetOrDelete(s.Macro["settings"], "scratchpad", edScratch.Value)
        if s.Ini != ""
            try IniWrite(StrReplace(StrReplace(edScratch.Value, "`r"), "`n", "\n"), s.Ini, "V7", "Scratchpad")
        V7_AutoSaveNow()
        dlg.Destroy()
    }
    btnSave.OnEvent("Click", saveHub)
    btnCancel.OnEvent("Click", saveHub)
    dlg.OnEvent("Escape", saveHub)
    dlg.OnEvent("Close", saveHub)
    dlg.Show()
}

V7_OpenPinnedRow(row) {
    pins := V7_GetRecent("PinnedContext")
    if row >= 1 && row <= pins.Length {
        parts := StrSplit(pins[row], "|")
        V7_ActivateOrLaunchPin(parts.Length >= 1 ? parts[1] : "", parts.Length >= 2 ? parts[2] : "", parts.Length >= 3 ? parts[3] : "")
    }
}

; @summary Lists the unique target executables referenced across the macro's blocks.
; @tags macro, adhd, memory, v7
V7_CollectMacroApps(blocks) {
    seen := Map(), out := ""
    for step in VMF_Flatten(blocks) {
        win := step.Get("win", "")
        if win is Map && win.Get("exe", "") != "" {
            exe := win["exe"]
            if !seen.Has(StrLower(exe)) {
                seen[StrLower(exe)] := 1
                out .= (out = "" ? "" : ", ") . exe
            }
        }
    }
    return out
}

; @summary Apple Spotlight-style Command Palette (Ctrl+K or Ctrl+Shift+K): fuzzy-search every editor action,
;          every block in the palette, recent macros, or steps in your current macro, and press Enter to run/jump.
; @tags macro, gui, apple, command-palette, v7
V7_CommandPalette(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    V7_ShowMainGui()
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "⌘ Command Palette — Type what you want to do or add (Enter runs, Esc closes)")
    dlg.SetFont("s10", "Segoe UI")
    ed := dlg.AddEdit("xm ym w680")
    DllCall("SendMessage", "Ptr", ed.Hwnd, "UInt", 0x1501, "Ptr", 1,
        "WStr", "Search actions, blocks to insert, recent files, or steps in your macro...")
    dlg.SetFont("s9", "Segoe UI")
    lv := dlg.AddListView("xm y+8 w680 h320 -Multi +NoSortHdr", ["Category", "Command / Block / File", "Shortcut / Detail"])
    lv.ModifyCol(1, 95), lv.ModifyCol(2, 365), lv.ModifyCol(3, 195)
    btnRun := dlg.AddButton("xm y+8 w120 h28 Default", "Run / Insert")
    btnClose := dlg.AddButton("x+6 yp w90 h28", "Cancel")

    allItems := V7_BuildCommandItems()
    shown := []

    refill(query := "") {
        lv.Opt("-Redraw")
        lv.Delete()
        shown := V7_FilterCommandItems(allItems, query)
        for item in shown
            lv.Add(, item.Cat, item.Title, item.Detail)
        if shown.Length
            lv.Modify(1, "Select Focus Vis")
        lv.Opt("+Redraw")
    }
    runChosen(*) {
        row := lv.GetNext()
        if !row && shown.Length
            row := 1
        if !row || row > shown.Length
            return
        chosen := shown[row]
        dlg.Destroy()
        chosen.Action.Call()
    }
    ed.OnEvent("Change", (ctl, *) => refill(ctl.Value))
    lv.OnEvent("DoubleClick", runChosen)
    btnRun.OnEvent("Click", runChosen)
    btnClose.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    refill("")
    dlg.Show()
    ed.Focus()
}

; @summary Builds the list of searchable items for the Command Palette (actions, blocks, recent files, current steps).
; @tags macro, apple, command-palette, v7
V7_BuildCommandItems() {
    s := VMB()
    items := [
        {Cat: "Action", Title: "🧭 Open V10 Deterministic Inspector & Layout Physics Lab", Detail: "Ctrl+Shift+D / Measure CRC, Pixels & Anchors", Action: V10_ShowDeterministicLab},
        {Cat: "Action", Title: "🎯 Convert Ticked / Selected Steps to Coordinates + Any Window", Detail: "1-click fix for strict steps", Action: (*) => VMB_MakeFlexible("selection", "program")},
        {Cat: "Action", Title: "🌐 Convert ENTIRE Macro to Coordinates + Any Window of Program", Detail: "Fixes strict picture/window failures", Action: (*) => VMB_MakeFlexible("all", "program")},
        {Cat: "Action", Title: "Convert Ticked / Selected Clicks to Coordinates Only", Detail: "Find by recorded spot", Action: (*) => VMB_SetFindMode("spot", "selection")},
        {Cat: "Action", Title: "Convert Ticked / Selected Steps to Any Window of Program", Detail: "Ignore changing window titles", Action: (*) => VMB_SetWinMatch("program", "selection")},
        {Cat: "Action", Title: "⚡ Make Selected Step Vary & Auto-Loop", Detail: "Ctrl+L / Right-click", Action: V8_VarySelectedDialog},
        {Cat: "Action", Title: "📏 Measure Row 1 -> Row 2 Pixel Stride + Auto-Loop", Detail: "F6 twice on screen", Action: V8_QuickMeasureStrideForSelected},
        {Cat: "Action", Title: "🎯 Pick Multiple Click Spots to Cycle Through + Auto-Loop", Detail: "F6 on each spot", Action: V8_QuickPickSpotsForSelected},
        {Cat: "Action", Title: "Where Was I? (Memory & Files Hub)", Detail: "F1 / Ctrl+Shift+M", Action: V7_MemoryHub},
        {Cat: "Action", Title: "Toggle Floating Prototyping HUD", Detail: "Ctrl+Shift+H", Action: V7_ToggleIdleHud},
        {Cat: "Action", Title: "Quick Look Preview of Selected Step", Detail: "Space (in tree)", Action: V7_QuickLook},
        {Cat: "Action", Title: "Start / Stop Recording", Detail: "Ctrl+Shift+R", Action: VMB_ToggleRecord},
        {Cat: "Action", Title: "Play Macro", Detail: "F5 / Ctrl+Shift+P", Action: (*) => VMB_Play()},
        {Cat: "Action", Title: "Step by Step Debugger", Detail: "F10", Action: (*) => VMB_Play(false, "step")},
        {Cat: "Action", Title: "Run to Selected Line", Detail: "Ctrl+F10", Action: VMB_RunToHere},
        {Cat: "Action", Title: "Pin Current Active App / Window", Detail: "Remember window", Action: V7_PinActiveContext},
        {Cat: "Action", Title: "Quick Capture: Add a Click Step Now", Detail: "Point + F6", Action: V7_HudQuickClick},
        {Cat: "Action", Title: "Quick Capture: Add a Wait-for-Image Step", Detail: "Drag rectangle", Action: V7_HudQuickWait},
        {Cat: "Action", Title: "Open Macros Folder in Explorer", Detail: s.Dir, Action: (*) => V7_OpenFolder(s.Dir)},
        {Cat: "Action", Title: "Reveal Running AHK Script in Explorer", Detail: A_ScriptName, Action: V7_OpenScriptFolder},
        {Cat: "Action", Title: "Open Step Grid (Bulk Edit)", Detail: "Window / Find / Wait", Action: VMB_StepGrid},
        {Cat: "Action", Title: "Open Web / CDP Panel", Detail: "Edge / Chrome", Action: V4_WebPanel},
        {Cat: "Action", Title: "Open Code View", Detail: "Read-only pseudocode", Action: VMB_CodeView},
        {Cat: "Action", Title: "Save Macro", Detail: "Ctrl+S", Action: (*) => VMB_SaveTo(s.Path)},
        {Cat: "Action", Title: "Export Standalone Player (.ahk + .txt)", Detail: "Single-file bundle", Action: VMB_ExportPlayer}
    ]
    for group in VMB_PaletteGroups() {
        catName := "Add: " . group[1]
        for entry in group[2] {
            label := entry[1], kind := entry[2], desc := entry[3]
            items.Push({Cat: catName, Title: label, Detail: desc, Action: ((k, *) => V7_InsertBlockByKind(k)).Bind(kind)})
        }
    }
    for mPath in V7_GetRecent("Macros")
        items.Push({Cat: "Recent Macro", Title: mPath, Detail: "Open macro file", Action: ((p, *) => V7_OpenRecentMacro(p)).Bind(mPath)})
    for i, step in VMF_Flatten(s.Macro["blocks"]) {
        sum := VM_StepSummary(step)
        items.Push({Cat: "Go to Step", Title: "#" . i . "  " . sum[1] . "  " . sum[3], Detail: sum[2],
            Action: ((st, *) => VMB_Refresh(st)).Bind(step)})
    }
    return items
}

; @summary Filters Command Palette items by space-separated search tokens (case-insensitive).
; @tags macro, apple, command-palette, v7
V7_FilterCommandItems(items, query) {
    q := Trim(StrLower(query))
    if q = ""
        return items
    tokens := StrSplit(q, " ", " `t")
    out := []
    for item in items {
        hay := StrLower(item.Cat . " " . item.Title . " " . item.Detail)
        matchAll := true
        for tok in tokens {
            if tok != "" && !InStr(hay, tok) {
                matchAll := false
                break
            }
        }
        if matchAll
            out.Push(item)
    }
    return out
}

V7_InsertBlockByKind(kind) {
    if kind = "elif"
        return VMB_AddElifToSelection()
    where := VMB_InsertPoint()
    node := VMB_MakeNode(kind)
    if node
        VMB_InsertNode(node, where.List, where.Index)
}

; @summary Apple Finder-style Quick Look (Spacebar on a macro step, or Quick Look button): pops up a clean inspector
;          showing the captured target BMP image, coordinates, target window, and plain-English behavior without a modal dialog.
; @tags macro, gui, apple, quicklook, v7
V7_QuickLook(*) {
    s := VMB()
    if s.QuickLookGui && DllCall("IsWindowVisible", "Ptr", s.QuickLookGui.Hwnd, "Int") {
        s.QuickLookGui.Destroy()
        s.QuickLookGui := 0
        return
    }
    V7_ShowQuickLookForSelection()
}

V7_RefreshQuickLookIfOpen() {
    s := VMB()
    if s.QuickLookGui && DllCall("IsWindowVisible", "Ptr", s.QuickLookGui.Hwnd, "Int")
        V7_ShowQuickLookForSelection()
}

V7_ShowQuickLookForSelection() {
    s := VMB()
    node := VMB_SelectedTarget()
    if !node
        return VMB_Status("Select a step or block first, then press Space for Quick Look.")
    if s.QuickLookGui {
        try s.QuickLookGui.Destroy()
        s.QuickLookGui := 0
    }
    ql := Gui("+Owner" . s.Gui.Hwnd . " +ToolWindow -MinimizeBox", "Quick Look  (Space or Esc closes)")
    ql.BackColor := "FFFFFF"
    ql.SetFont("s10 bold", "Segoe UI")
    idx := s.FlatIndex.Get(node, 0)
    ql.AddText("xm ym w440 c0A84FF", (idx ? "Step #" . idx . "  —  " : "") . VMF_BlockName(node.Get("type", "")))
    ql.SetFont("s9 norm", "Segoe UI")
    ql.AddEdit("xm y+6 w440 r5 ReadOnly BackgroundF5F7FA", V7_DescribeNodePlain(node))

    pattern := node.Get("pattern", "")
    if SubStr(pattern, 1, 6) = "V4BMP:" {
        try {
            bmpPath := V4_ImageCache(pattern)
            ql.AddText("xm y+8 w440 c606060", "Captured Target Image:")
            ql.AddPicture("xm y+4 Border", bmpPath)
        }
    }
    btnTest := ql.AddButton("xm y+10 w110 h26", "Test Target")
    btnEdit := ql.AddButton("x+6 yp w95 h26", "Edit Step...")
    btnPic := ql.AddButton("x+6 yp w115 h26", "New Picture...")
    btnClose := ql.AddButton("x+6 yp w90 h26 Default", "Close")

    closeQL(*) {
        if s.QuickLookGui {
            try s.QuickLookGui.Destroy()
            s.QuickLookGui := 0
        }
    }
    btnTest.OnEvent("Click", (*) => (closeQL(), VMB_TestSelected()))
    btnEdit.OnEvent("Click", (*) => (closeQL(), VMB_EditSelected()))
    btnPic.OnEvent("Click", (*) => (closeQL(), VMB_NewPicture()))
    btnClose.OnEvent("Click", closeQL)
    ql.OnEvent("Escape", closeQL)
    ql.OnEvent("Close", closeQL)
    s.QuickLookGui := ql
    ql.Show("NA")
}

; @summary Plain-English summary of any step or block for Quick Look and self-tests.
; @tags macro, apple, quicklook, v7
V7_DescribeNodePlain(node) {
    if !(node is Map)
        return "(no step selected)"
    t := node.Get("type", "")
    win := node.Get("win", "")
    winStr := win is Map && VM_WindowLabel(win) != "" ? VM_WindowLabel(win) : "(any active window)"
    matchMode := node.Get("winMatch", "") = "program" ? "Any window of program"
        : node.Get("winMatch", "") = "active" ? "Whatever window is active" : "Exact window title"
    lines := "Action:         " . VMF_BlockName(t)
        . "`r`nTarget Window:  " . winStr . "  [" . matchMode . "]"
    if t = "click" || t = "drag" {
        findHow := node.Get("find", "") = "spot" ? "Coordinates (" . node.Get("scrX", 0) . ", " . node.Get("scrY", 0) . ")"
            : "Embedded Picture (fallback spot " . node.Get("scrX", 0) . ", " . node.Get("scrY", 0) . ")"
        lines .= "`r`nFind Target By: " . findHow . "   •   Button: " . node.Get("button", "Left")
    } else if t = "text" {
        lines .= "`r`nTypes Text:     " . (node.Get("ask", 0) ? "(Asks at runtime: " . node.Get("prompt", "") . ")" : node.Get("text", ""))
    } else if t = "keys" {
        lines .= "`r`nPresses Keys:   " . node.Get("keys", "")
    } else if node.Has("selector") {
        lines .= "`r`nWeb Selector:   " . node.Get("selector", "")
            . (node.Get("frame", "") != "" ? "   [Frame: " . node["frame"] . "]" : "")
            . "   [Match index: " . node.Get("index", 0) . "]"
    } else if !VMF_IsStep(node) {
        lines .= "`r`nSummary:        " . VMF_BlockText(node)
    }
    if node.Get("note", "") != ""
        lines .= "`r`nNote:           " . node["note"]
    return lines
}

; @summary Run bar "Re-capture target..." button: lets you recapture a desktop click/wait/check/if picture right from
;          the paused or failed HUD without stopping the macro run, then press Down to retry immediately.
; @tags macro, playback, debug, hud, v7
V7_FixDesktopTargetFromBar(bar) {
    d := V5_Dbg()
    node := bar.Node, runner := bar.Runner
    if d.Editing || !d.Waiting || !(node is Map) || !IsObject(runner)
        return
    t := node.Get("type", "")
    d.Editing := true
    V5_HideOverlays()
    try {
        if t = "click" || t = "drag" {
            point := VM_UiPickPoint("Point at the exact spot to click and press F6 (Esc cancels).")
            if point {
                fresh := VM_CaptureClickStep(point.X, point.Y, node.Get("button", "Left"), node.Get("count", 1))
                for key in ["x", "y", "scrX", "scrY", "rx", "ry", "offsetX", "offsetY", "q", "pattern"]
                    node[key] := fresh[key]
                VM__SetOrDelete(node, "geo", fresh.Get("geo", ""))
                node["win"] := fresh["win"]
                VM__SetOrDelete(node, "find", "")
                runner.Changed := true
                bar.Next.Text := V5_NodeTitle(runner, node)
                bar.Note("✓ New target picture captured! Press Down (or Try again) to run this step now.")
            }
        } else if RegExMatch(t, "^(wait|check|if|until)$") {
            patternText := VM_UiDragImage("Re-capture image", "Drag a rectangle around the image on screen. Esc cancels.", bar.G)
            if patternText != "" {
                fresh := VM_NewWaitStep(patternText)
                node["pattern"] := fresh["pattern"], node["q"] := fresh["q"]
                runner.Changed := true
                bar.Note("✓ New image captured! Press Down (or Try again) to run this step now.")
            }
        }
    } catch as err
        bar.Note(err.Message, true)
    finally {
        V5_RestoreOverlays()
        d.Editing := false
    }
}

; @summary Run bar "Edit step..." button: opens the step editor for the paused/failed step right from the HUD.
; @tags macro, playback, debug, hud, v7
V7_EditStepFromBar(bar) {
    d := V5_Dbg()
    node := bar.Node, runner := bar.Runner
    if d.Editing || !d.Waiting || !(node is Map) || !IsObject(runner)
        return
    d.Editing := true
    try {
        saved := VMF_IsStep(node) ? VM_UiEditStep(node, "Edit paused step", bar.G.Hwnd, VMB_ColumnChoices()) : VMB_EditBlock(node)
        if saved {
            runner.Changed := true
            bar.Next.Text := V5_NodeTitle(runner, node)
            bar.Note("✓ Step updated! Press Down (or Try again) to run it with your changes.")
        }
    } catch as err
        bar.Note(err.Message, true)
    finally d.Editing := false
}

; @summary Toggles the persistent Floating Prototyping HUD (Ctrl+Shift+H or "Float HUD" button).
; @tags macro, hud, gui, v7
V7_ToggleIdleHud(*) {
    s := VMB()
    if s.IdleHud && s.IdleHud.IsVisible() {
        s.IdleHud.Hide()
        IniWrite(0, s.Ini, "V7", "ShowHud")
        VMB_Status("Floating HUD hidden (press Ctrl+Shift+H or 'Float HUD' to show it again).")
    } else {
        V7_EnsureIdleHud()
        IniWrite(1, s.Ini, "V7", "ShowHud")
        VMB_Status("Floating Prototyping HUD is active — build, record, or play while working in any app.")
    }
}

V7_EnsureIdleHud() {
    s := VMB()
    if !s.IdleHud
        s.IdleHud := V7ProtoHud()
    s.IdleHud.Show()
    V7_SyncIdleHud()
}

V7_SyncIdleHud() {
    s := VMB()
    if s.IdleHud
        s.IdleHud.Refresh()
}

; @summary 1-click rapid prototyping from the HUD: hides the editor, lets you point + F6 to capture a Click step,
;          and appends it right into the macro without switching windows.
; @tags macro, hud, prototype, v7
V7_HudQuickClick(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    wasVis := DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int")
    if wasVis
        s.Gui.Hide()
    V5_HideOverlays()
    try {
        pt := VM_UiPickPoint("Rapid Prototype (+ Click): Point at the button/spot to click and press F6 (Esc cancels).")
        if pt {
            step := VM_CaptureClickStep(pt.X, pt.Y, "Left", 1)
            VMB_ApplyDefaultFind([step])
            where := VMB_InsertPoint()
            VMB_InsertNode(step, where.List, where.Index)
            V7_AutoSaveNow()
            TrayTip("Added Click step (#" . s.FlatIndex.Count . ") at " . pt.X . ", " . pt.Y, "Prototyping HUD", "Iconi")
        }
    } finally {
        V5_RestoreOverlays()
        if wasVis
            s.Gui.Show("NA")
        V7_SyncIdleHud()
    }
}

; @summary 1-click rapid prototyping from the HUD: drag a rectangle around an image on screen to add a Wait-for-Image step.
; @tags macro, hud, prototype, v7
V7_HudQuickWait(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    V5_HideOverlays()
    try {
        pat := VM_UiDragImage("Rapid Prototype (+ Wait for Image)",
            "After OK, drag a rectangle around the image to wait for. Esc cancels.", s.Gui)
        if pat != "" {
            step := VM_NewWaitStep(pat)
            where := VMB_InsertPoint()
            VMB_InsertNode(step, where.List, where.Index)
            V7_AutoSaveNow()
            TrayTip("Added Wait-for-image step (#" . s.FlatIndex.Count . ").", "Prototyping HUD", "Iconi")
        }
    } finally {
        V5_RestoreOverlays()
        V7_SyncIdleHud()
    }
}

; @summary 1-click rapid prototyping from the HUD: prompts for text or {{Column}} to type into the active window.
; @tags macro, hud, prototype, v7
V7_HudQuickText(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    ans := InputBox("Text to type (can include {{Column}}, {{clipboard}}, {{index}}):",
        "Rapid Prototype (+ Type Text)", "w420 h130")
    if ans.Result != "OK" || ans.Value = ""
        return
    step := Map("type", "text", "text", ans.Value, "win", V4_RecordWin())
    where := VMB_InsertPoint()
    VMB_InsertNode(step, where.List, where.Index)
    V7_AutoSaveNow()
    V7_SyncIdleHud()
}

; @summary The V7 Always-On Prototyping Companion HUD: a non-activating (WS_EX_NOACTIVATE) floating bar that stays
;          out of the way in the corner when idle or recording, displays your current macro & "Where Was I" goal,
;          and lets you record, step-debug, or add Click / Wait / Text blocks on the fly. Automatically yields to
;          V5RunBar while playback is running.
; @tags macro, hud, gui, prototype, v7
class V7ProtoHud {
    __New() {
        s := VMB()
        this.Compact := IniRead(s.Ini, "V7", "HudCompact", 0) ? true : false
        this.Suspended := false
        g := Gui("+AlwaysOnTop +ToolWindow -MinimizeBox +E0x08000000", "Visual Macro Blocks V8  -  Prototyping HUD")
        g.MarginX := 10, g.MarginY := 8
        g.BackColor := "FFFFFF"
        g.SetFont("s9 bold", "Segoe UI")
        this.Head := g.AddText("xm ym w390 h24 +0x200 Background1C1C1E cFFFFFF", "   ⚡ Prototyping HUD")
        this.BtnFold := g.AddButton("x+4 yp w72 h24", this.Compact ? "Expand ▾" : "Mini ▴")
        g.SetFont("s8 norm", "Segoe UI")
        this.Goal := g.AddText("xm y+6 w466 c0A84FF +0x4000", "")
        this.Info := g.AddText("xm y+2 w466 c505050 +0x4000", "")

        this.BRec := g.AddButton("xm y+6 w82 h28", "● Record")
        this.BPlay := g.AddButton("x+4 yp w68 h28", "▶ Play")
        this.BStep := g.AddButton("x+4 yp w72 h28", "👣 Step")
        this.BVary := g.AddButton("x+6 yp w84 h28", "⚡ Vary+Loop")
        this.BClick := g.AddButton("x+4 yp w66 h28", "+ Click")
        this.BWait := g.AddButton("x+4 yp w64 h28", "+ Wait")

        this.BMacro := g.AddButton("xm y+6 w112 h24", "Editor (Ctrl+Shift+M)")
        this.BHub := g.AddButton("x+4 yp w118 h24", "🧠 Where Was I?")
        this.BCmd := g.AddButton("x+4 yp w114 h24", "⌘ Command (Ctrl+K)")
        this.BPin := g.AddButton("x+4 yp w110 h24", "📌 Pin active app")

        this.BtnFold.OnEvent("Click", (*) => this.ToggleCompact())
        this.BRec.OnEvent("Click", VMB_ToggleRecord)
        this.BPlay.OnEvent("Click", (*) => VMB_Play())
        this.BStep.OnEvent("Click", (*) => VMB_Play(false, "step"))
        this.BVary.OnEvent("Click", V8_HudVaryButton)
        this.BClick.OnEvent("Click", V7_HudQuickClick)
        this.BWait.OnEvent("Click", V7_HudQuickWait)
        this.BMacro.OnEvent("Click", V7_ShowMainGui)
        this.BHub.OnEvent("Click", V7_MemoryHub)
        this.BCmd.OnEvent("Click", V7_CommandPalette)
        this.BPin.OnEvent("Click", V7_PinActiveContext)
        g.OnEvent("Close", (*) => (this.Hide(), IniWrite(0, VMB().Ini, "V7", "ShowHud"), true))

        this.G := g
        V5_Overlays().Windows[g.Hwnd] := 1
        this.ApplyCompact()
    }
    IsVisible() => DllCall("IsWindowVisible", "Ptr", this.G.Hwnd, "Int") != 0
    Show() {
        if this.Suspended
            return
        s := VMB()
        this.G.Show("Hide AutoSize")
        V5_WindowRect(this.G.Hwnd, , , &w, &h)
        hx := IniRead(s.Ini, "V7", "HudX", ""), hy := IniRead(s.Ini, "V7", "HudY", "")
        x := IsInteger(hx) ? Integer(hx) : "", y := IsInteger(hy) ? Integer(hy) : ""
        if x = "" || y = "" || !V5_OnScreen(x, y, w) {
            MonitorGetWorkArea(MonitorGetPrimary(), , , &right, &bottom)
            x := right - w - 16, y := bottom - h - 16
        }
        this.G.Show("NA x" . x . " y" . y)
        this.Refresh()
    }
    Hide() {
        if DllCall("IsWindow", "Ptr", this.G.Hwnd, "Int") && this.IsVisible() {
            V5_WindowRect(this.G.Hwnd, &x, &y)
            IniWrite(x, VMB().Ini, "V7", "HudX")
            IniWrite(y, VMB().Ini, "V7", "HudY")
        }
        this.G.Hide()
    }
    SuspendForRun(on) {
        this.Suspended := on
        if on
            this.Hide()
        else if IniRead(VMB().Ini, "V7", "ShowHud", 1)
            this.Show()
    }
    ToggleCompact() {
        this.Compact := !this.Compact
        IniWrite(this.Compact ? 1 : 0, VMB().Ini, "V7", "HudCompact")
        this.ApplyCompact()
        if this.IsVisible()
            this.G.Show("NA AutoSize")
    }
    ApplyCompact() {
        this.BtnFold.Text := this.Compact ? "Expand ▾" : "Mini ▴"
        for ctl in [this.Goal, this.Info, this.BMacro, this.BHub, this.BCmd, this.BPin]
            ctl.Visible := !this.Compact
    }
    Refresh() {
        s := VMB()
        name := "Untitled"
        if s.Path != ""
            SplitPath(s.Path, &name)
        if VM_IsRecording() {
            paused := VM_Rec().Paused
            this.Head.Opt("+Background" . (paused ? "FF9F0A" : "D70015"))
            this.Head.Text := "   " . (paused ? "|| PAUSED" : "● REC") . "  •  "
                . (IsObject(s.RecSteps) ? s.RecSteps.Length : 0) . " steps  (Alt+Click or F7 = mark vary)"
            this.BRec.Text := "■ Stop Rec"
            this.BVary.Text := "⚡ Mark F7"
        } else {
            this.Head.Opt("+Background1C1C1E")
            this.Head.Text := "   ⚡ " . name . (s.Dirty ? " *" : "") . "  •  " . s.FlatIndex.Count . " steps"
            this.BRec.Text := "● Record"
            this.BVary.Text := "⚡ Vary+Loop"
        }
        goal := s.Ctl.Has("GoalNote") && Trim(s.Ctl["GoalNote"].Value) != "" ? Trim(s.Ctl["GoalNote"].Value)
            : "(No 'Where Was I' goal set — click 'Where Was I?' to add one)"
        this.Goal.Text := "Goal: " . goal
        pins := V7_GetRecent("PinnedContext")
        pinShort := pins.Length ? StrSplit(pins[1], "|")[1] : "none"
        this.Info.Text := (s.LastSavedAt != "" ? "Saved " . s.LastSavedAt : "Auto-save ready")
            . "  •  Pinned app: " . pinShort . "  •  +Click / +Wait adds steps right here"
    }
}

; ============================================================================
; V8 SMART VARY & 1-CLICK AUTO-LOOP (ZERO-FRICTION RAPID PROTOTYPING)
; ============================================================================

; @summary Returns the 1-based iteration/round number for a varying step during playback.
; @tags macro, vary, loop, v8
V8_RoundNumber(node, runner := 0) {
    if !IsObject(runner)
        return 1
    varName := Trim(node.Get("varyVar", ""))
    if varName != "" {
        if runner.Vars.Has(varName) && IsNumber(runner.Vars[varName])
            return Max(1, Integer(runner.Vars[varName]))
        if StrLower(varName) = "row" && runner.RowNumber > 0
            return runner.RowNumber
        if StrLower(varName) = "index" && runner.LoopIndex > 0
            return runner.LoopIndex
    }
    if runner.LoopIndex > 0
        return runner.LoopIndex
    if runner.RowNumber > 0
        return runner.RowNumber
    for k, v in runner.Vars {
        if IsNumber(v)
            return Max(1, Integer(v))
    }
    return 1
}

; @summary Computes {DX, DY} pixel shift for a click/drag/image step on the current loop round (round 1 = +0, +0).
; @tags macro, vary, click, v8
V8_CalcPixelShift(node, runner := 0) {
    if !(node is Map)
        return {DX: 0, DY: 0}
    stepX := Number(node.Get("varyDX", 0))
    stepY := Number(node.Get("varyDY", 0))
    if stepX = 0 && stepY = 0
        return {DX: 0, DY: 0}
    rIdx := V8_RoundNumber(node, runner)
    mult := Max(0, rIdx - 1)
    return {DX: Round(stepX * mult), DY: Round(stepY * mult)}
}

; @summary Resolves the keys string for a "keys" step, including V8 dynamic key repetition (e.g. press {Down} N times on round N).
; @tags macro, vary, keys, v8
V8_ResolveKeys(node, runner := 0) {
    if !(node is Map)
        return ""
    if node.Get("varyKey", 0) {
        keyName := Trim(node.Get("varyKeyName", "Down"))
        if keyName = ""
            keyName := "Down"
        startCount := Integer(node.Get("varyKeyStart", 1))
        perRound := Integer(node.Get("varyKeyStep", 1))
        rIdx := V8_RoundNumber(node, runner)
        total := startCount + (Max(1, rIdx) - 1) * perRound
        if total <= 0
            return ""
        cleanKey := RegExReplace(keyName, "^\{|\}$")
        return "{" . cleanKey . " " . total . "}"
    }
    raw := node.Get("keys", "")
    return IsObject(runner) ? runner.Expand(raw) : raw
}

; @summary Short badge shown in the macro tree and step summary when a step has V8 Smart Vary enabled.
; @tags macro, vary, gui, v8
V8_VarySummaryBadge(node) {
    if !(node is Map)
        return ""
    spots := node.Get("varySpots", "")
    if spots is Array && spots.Length
        return "⚡[varies: cycles " . spots.Length . " spots]"
    dx := Number(node.Get("varyDX", 0)), dy := Number(node.Get("varyDY", 0))
    if dx != 0 || dy != 0 {
        parts := ""
        if dx != 0
            parts .= (dx > 0 ? "+" : "") . dx . "px X"
        if dy != 0
            parts .= (parts != "" ? ", " : "") . (dy > 0 ? "+" : "") . dy . "px Y"
        return "⚡[varies: " . parts . " / round]"
    }
    if node.Get("varyKey", 0) {
        kName := node.Get("varyKeyName", "Down")
        kStart := node.Get("varyKeyStart", 1)
        kStep := node.Get("varyKeyStep", 1)
        return "⚡[varies: {" . kName . "} " . kStart . "x, +" . kStep . "x / round]"
    }
    if node.Get("type", "") = "text" && InStr(node.Get("text", ""), "{{")
        return "⚡[varies: " . node.Get("text", "") . "]"
    return ""
}

; @summary Extra note shown on the paused Run Bar preview when a step has a V8 variation active.
; @tags macro, vary, debug, v8
V8_VaryPreviewNote(node, runner := 0) {
    badge := V8_VarySummaryBadge(node)
    if badge = ""
        return ""
    rIdx := V8_RoundNumber(node, runner)
    return "  (Round #" . rIdx . " " . badge . ")"
}

; @summary While recording: F7 (or HUD "⚡ Mark F7" button) marks the most recently recorded step (or next click)
;          as the step that varies, so V8 opens the Vary + Auto-Loop wizard automatically when recording stops.
; @tags macro, record, vary, v8
V8_MarkLastRecordedStepVary(*) {
    s := VMB()
    if !VM_IsRecording() || !IsObject(s.RecSteps)
        return
    if s.RecSteps.Length {
        last := s.RecSteps[s.RecSteps.Length]
        last["varyMarked"] := 1
        if last.Get("type", "") = "click"
            last["find"] := "spot"
        ToolTip("⚡ Marked step #" . s.RecSteps.Length . " (" . VMF_BlockName(last.Get("type", "")) . ") as Variable Step!`nWhen you stop recording, the Auto-Loop wizard will open automatically.")
        SetTimer(() => ToolTip(), -2000)
    } else {
        ToolTip("⚡ Hold Alt while clicking the target that changes, or press F7 right after clicking/typing it!")
        SetTimer(() => ToolTip(), -2000)
    }
}

; @summary HUD "⚡ Vary+Loop" / "⚡ Mark F7" button handler: marks the last step while recording, or opens the Vary + Auto-Loop wizard when idle.
; @tags macro, hud, vary, v8
V8_HudVaryButton(*) {
    if VM_IsRecording()
        V8_MarkLastRecordedStepVary()
    else
        V8_VarySelectedDialog()
}

; @summary Clears any V8 variation settings on the selected step.
; @tags macro, vary, gui, v8
V8_ClearVaryOnSelected(*) {
    info := VMB_SelectedNode("the step to clear variation from")
    if !info
        return
    VMB_Snapshot()
    V8_ClearVaryProps(info.Node)
    VMB().Dirty := true
    VMB_Refresh(info.Node)
    V7_AutoSaveNow()
    VMB_Status("Cleared variation on step — it will use its fixed recorded values again.")
}

V8_ClearVaryProps(node) {
    for k in ["varyDX", "varyDY", "varySpots", "varyKey", "varyKeyName", "varyKeyStart", "varyKeyStep", "varyVar"] {
        if node.Has(k)
            node.Delete(k)
    }
}

; @summary Wraps a list of steps (by default the sibling block list containing targetNode) inside a loop container
;          ("repeat", "for", or "foreach"). If targetNode is ALREADY inside a loop, updates that loop instead of double-wrapping!
; @returns the loop container Map
; @tags macro, vary, loop, blocks, v8
V8_AutoWrapInLoop(macroBlocks, targetNode, loopKind := "repeat", loopCount := 10, forVar := "i", forFrom := 1, forStep := 1, scopeList := 0) {
    if loopKind = "none" || loopKind = ""
        return 0
    loc := V8_FindNodeContainer(macroBlocks, targetNode, 0)
    if !loc
        return 0
    ; If the step is already directly inside a Repeat / For / ForEach loop, update that loop's parameters in place.
    if loc.Owner is Map && RegExMatch(loc.Owner.Get("type", ""), "^(repeat|for|foreach)$") {
        loopNode := loc.Owner
        V8_ConfigureLoopNode(loopNode, loopKind, loopCount, forVar, forFrom, forStep)
        return loopNode
    }
    parentList := loc.List
    loopNode := Map("type", loopKind = "for" ? "for" : loopKind = "foreach" ? "foreach" : "repeat", "body", [])
    V8_ConfigureLoopNode(loopNode, loopKind, loopCount, forVar, forFrom, forStep)

    ; Determine which steps in parentList to move into loopNode["body"]
    if scopeList is Array && scopeList.Length {
        scopeSet := Map()
        for st in scopeList
            scopeSet[st] := 1
        firstIdx := 0
        moved := []
        i := 1
        while i <= parentList.Length {
            item := parentList[i]
            if scopeSet.Has(item) {
                if !firstIdx
                    firstIdx := i
                moved.Push(item)
                parentList.RemoveAt(i)
            } else {
                i += 1
            }
        }
        if moved.Length {
            loopNode["body"] := moved
            parentList.InsertAt(VF_Clamp(firstIdx, 1, parentList.Length + 1), loopNode)
            return loopNode
        }
    }
    ; Default: wrap all non-pickdata steps in parentList into the loop
    moved := [], insertIdx := 1
    i := 1
    while i <= parentList.Length {
        item := parentList[i]
        if item is Map && item.Get("type", "") = "pickdata" {
            insertIdx := i + 1
            i += 1
            continue
        }
        moved.Push(item)
        parentList.RemoveAt(i)
    }
    loopNode["body"] := moved
    parentList.InsertAt(VF_Clamp(insertIdx, 1, parentList.Length + 1), loopNode)
    return loopNode
}

V8_ConfigureLoopNode(loopNode, loopKind, loopCount, forVar, forFrom, forStep) {
    for k in ["count", "name", "from", "to", "step"]
        if loopNode.Has(k)
            loopNode.Delete(k)
    switch loopKind {
        case "for":
            loopNode["type"] := "for"
            loopNode["name"] := Trim(forVar) != "" ? Trim(forVar) : "i"
            loopNode["from"] := forFrom
            loopNode["to"] := loopCount
            loopNode["step"] := forStep
        case "foreach":
            loopNode["type"] := "foreach"
        default:
            loopNode["type"] := "repeat"
            loopNode["count"] := Max(1, Integer(loopCount))
    }
}

V8_FindNodeContainer(list, targetNode, owner := 0) {
    for idx, node in list {
        if node = targetNode
            return {List: list, Index: idx, Owner: owner}
        if node is Map {
            for childList in VMF_Children(node) {
                found := V8_FindNodeContainer(childList, targetNode, node)
                if found
                    return found
            }
        }
    }
    return 0
}

; @summary 1-click preset from right-click menu: applies a pixel shift per round to the selected click step and wraps in a loop.
; @tags macro, vary, preset, v8
V8_ApplyQuickPreset(dx, dy, loopKind := "repeat", loopCount := 10) {
    s := VMB()
    info := VMB_SelectedNode("the click step to vary")
    if !info
        return
    node := info.Node
    if node.Get("type", "") != "click" && node.Get("type", "") != "drag"
        return VMB_Status("Select a Click or Drag step for pixel-offset presets (or press Ctrl+L for all step types).")
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["find"] := "spot"
    if dx != 0
        node["varyDX"] := Integer(dx)
    if dy != 0
        node["varyDY"] := Integer(dy)
    V8_AutoWrapInLoop(s.Macro["blocks"], node, loopKind, loopCount)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("⚡ Applied: shift (" . dx . ", " . dy . ") px per round + wrapped in Repeat " . loopCount . "x loop! Press F5 to play or F10 to step.")
}

; @summary 1-click preset from right-click menu: turns the selected step into a dynamic repeated key press per round + wraps in a loop.
; @tags macro, vary, preset, v8
V8_ApplyQuickKeyPreset(keyName, startCount, stepCount, loopKind := "repeat", loopCount := 10) {
    s := VMB()
    info := VMB_SelectedNode("the step to vary")
    if !info
        return
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["type"] := "keys"
    node["keys"] := "{" . keyName . "}"
    node["varyKey"] := 1
    node["varyKeyName"] := keyName
    node["varyKeyStart"] := Integer(startCount)
    node["varyKeyStep"] := Integer(stepCount)
    V8_AutoWrapInLoop(s.Macro["blocks"], node, loopKind, loopCount)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("⚡ Applied: press {" . keyName . "} " . startCount . "x on round 1, +" . stepCount . "x each round + wrapped in Repeat " . loopCount . "x loop!")
}

; @summary 1-click preset from right-click menu: sets a Type step to an incrementing variable/column and wraps in a loop.
; @tags macro, vary, preset, v8
V8_ApplyQuickTextPreset(templateText, loopKind := "repeat", loopCount := 10) {
    s := VMB()
    info := VMB_SelectedNode("the step to vary")
    if !info
        return
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["type"] := "text"
    node["text"] := templateText
    VM__SetOrDelete(node, "ask", "")
    V8_AutoWrapInLoop(s.Macro["blocks"], node, loopKind, loopCount)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("⚡ Applied: type '" . templateText . "' each round + wrapped in Repeat " . loopCount . "x loop!")
}

; @summary 2-Click Row-1 -> Row-2 Auto-Measure on screen: point at Row 1 and press F6, then point at Row 2 and press F6.
;          Automatically calculates the exact DX/DY pixel stride, sets Row 1 as the starting spot, and wraps in a loop!
; @tags macro, vary, measure, v8
V8_MeasureTwoPointsOnScreen() {
    s := VMB()
    wasVis := s.Gui && DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int")
    if wasVis
        s.Gui.Hide()
    V5_HideOverlays()
    try {
        p1 := VM_UiPickPoint("📏 Step 1 of 2: Point at ROW 1 (first click spot) and press F6.   (Esc cancels)")
        if !p1
            return 0
        SoundBeep(750, 90)
        Sleep(180)
        p2 := VM_UiPickPoint("📏 Step 2 of 2: Now point at ROW 2 (next click spot) and press F6.   (Esc cancels)")
        if !p2
            return 0
        SoundBeep(950, 90)
        return {X1: p1.X, Y1: p1.Y, X2: p2.X, Y2: p2.Y, DX: p2.X - p1.X, DY: p2.Y - p1.Y}
    } finally {
        V5_RestoreOverlays()
        if wasVis
            s.Gui.Show()
    }
}

V8_QuickMeasureStrideForSelected(*) {
    s := VMB()
    info := VMB_SelectedNode("the click step to measure Row 1 -> Row 2 for")
    if !info
        return
    m := V8_MeasureTwoPointsOnScreen()
    if !m
        return VMB_Status("Row measurement cancelled.")
    ans := InputBox("Measured exact stride from Row 1 (" . m.X1 . ", " . m.Y1 . ") to Row 2 (" . m.X2 . ", " . m.Y2 . "):`n"
        . "  • Horizontal shift (DX): " . m.DX . " px per round`n"
        . "  • Vertical shift (DY):   " . m.DY . " px per round`n`n"
        . "How many total rounds / rows should the loop run?", "📏 Auto-Measure & Loop", "w420 h190", "10")
    if ans.Result != "OK"
        return
    cnt := RegExMatch(Trim(ans.Value), "^\d+$") ? Max(1, Integer(Trim(ans.Value))) : 10
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    fresh := VM_CaptureClickStep(m.X1, m.Y1, node.Get("button", "Left"), node.Get("count", 1))
    for k in ["x", "y", "scrX", "scrY", "rx", "ry", "offsetX", "offsetY", "q", "pattern", "win"]
        node[k] := fresh[k]
    VM__SetOrDelete(node, "geo", fresh.Get("geo", ""))
    node["find"] := "spot"
    if m.DX != 0
        node["varyDX"] := m.DX
    if m.DY != 0
        node["varyDY"] := m.DY
    V8_AutoWrapInLoop(s.Macro["blocks"], node, "repeat", cnt)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("📏 Measured (" . m.DX . ", " . m.DY . ") px per round and wrapped in a Repeat " . cnt . "x loop!")
}

; @summary Multi-spot screen picker: point at Spot 1, Spot 2, Spot 3... pressing F6 on each, then press Esc when done.
;          Automatically sets the step to cycle through those exact spots and sets the Repeat count to match!
; @tags macro, vary, spots, v8
V8_PickMultipleSpotsOnScreen() {
    s := VMB()
    wasVis := s.Gui && DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int")
    if wasVis
        s.Gui.Hide()
    V5_HideOverlays()
    spots := []
    try {
        loop {
            pt := VM_UiPickPoint("🎯 Multi-Spot Picker (" . spots.Length . " captured so far):`nPoint at Spot #" . (spots.Length + 1) . " and press F6.   Press Esc when finished!")
            if !pt
                break
            SoundBeep(800, 70)
            captured := VM_CaptureClickStep(pt.X, pt.Y, "Left", 1)
            spotEntry := Map("scrX", captured["scrX"], "scrY", captured["scrY"])
            if captured.Has("rx")
                spotEntry["rx"] := captured["rx"], spotEntry["ry"] := captured["ry"]
            if captured.Has("geo")
                spotEntry["geo"] := captured["geo"]
            spots.Push(spotEntry)
            Sleep(180)
        }
    } finally {
        V5_RestoreOverlays()
        if wasVis
            s.Gui.Show()
    }
    return spots
}

V8_QuickPickSpotsForSelected(*) {
    s := VMB()
    info := VMB_SelectedNode("the click step to pick multiple spots for")
    if !info
        return
    spots := V8_PickMultipleSpotsOnScreen()
    if !spots.Length
        return VMB_Status("No spots captured.")
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["type"] := "click"
    node["find"] := "spot"
    node["scrX"] := spots[1]["scrX"], node["scrY"] := spots[1]["scrY"]
    node["varySpots"] := spots
    V8_AutoWrapInLoop(s.Macro["blocks"], node, "repeat", spots.Length)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("🎯 Captured " . spots.Length . " spots and wrapped your macro in a Repeat " . spots.Length . "x loop!")
}

; @summary Opens the Smart Vary & 1-Click Auto-Loop wizard for the currently selected step in the macro tree.
; @tags macro, vary, gui, v8
V8_VarySelectedDialog(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    info := VMB_SelectedNode("the step that changes on each round")
    if !info
        return
    if !VMF_IsStep(info.Node)
        return VMB_Status("Select a step (such as a Click, Press keys, or Type text step) to make it vary across rounds.")
    V8_VaryDialog(info.Node)
}

; @summary The V8 "Make This Step Vary & Auto-Loop" dialog: lets you pick how the step changes on each round AND
;          automatically wraps your recorded steps in a Repeat / For / For-Each-Row loop in a single click.
; @tags macro, vary, loop, gui, v8
V8_VaryDialog(node, scopeSteps := 0) {
    s := VMB()
    idx := s.FlatIndex.Get(node, "?")
    t := node.Get("type", "click")
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "⚡ Make Step #" . idx . " Vary & Auto-Loop — Visual Macro Blocks V8")
    dlg.SetFont("s10 bold", "Segoe UI")
    dlg.AddText("xm ym w660 c0A84FF", "⚡ Turn one changing step into a smart loop in 1 click")
    dlg.SetFont("s9 norm", "Segoe UI")
    sum := VM_StepSummary(node)
    dlg.AddText("xm y+4 w660 c505050", "Selected step:   #" . idx . "   " . sum[1] . "   " . sum[3] . (sum[2] != "" ? "   [" . sum[2] . "]" : ""))

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w660", "1. How should this step change on each round of the loop?")
    dlg.SetFont("s9 norm", "Segoe UI")

    hasSpots := node.Get("varySpots", "") is Array && node["varySpots"].Length > 0
    hasKeyVary := node.Get("varyKey", 0) != 0
    defaultMode := hasSpots ? 2 : hasKeyVary ? 3 : t = "keys" ? 3 : t = "text" ? 4 : 1

    rPixel := dlg.AddRadio("xm y+6" . (defaultMode = 1 ? " Checked" : ""), "📍 Move click spot by pixels each round (e.g. next row down in a table or list)")
    dlg.AddText("xm+24 y+6", "Shift X per round (px):")
    edDX := dlg.AddEdit("x+6 yp-3 w65", node.Get("varyDX", 0))
    dlg.AddText("x+14 yp+3", "Shift Y per round (px, + = down):")
    edDY := dlg.AddEdit("x+6 yp-3 w65", node.Get("varyDY", 24))
    btnMeasure := dlg.AddButton("x+12 yp-1 w215 h25", "📏 Point at Row 1 & Row 2 (F6)...")

    dlg.AddText("xm+24 y+6 c606060", "Quick row-height presets:")
    btnP20 := dlg.AddButton("x+8 yp-3 w64 h22", "↓ +20 px")
    btnP24 := dlg.AddButton("x+4 yp w64 h22", "↓ +24 px")
    btnP30 := dlg.AddButton("x+4 yp w64 h22", "↓ +30 px")
    btnP40 := dlg.AddButton("x+4 yp w64 h22", "↓ +40 px")
    btnPRight := dlg.AddButton("x+4 yp w80 h22", "→ +100 px X")

    rSpots := dlg.AddRadio("xm y+12" . (defaultMode = 2 ? " Checked" : ""), "🎯 Cycle through a list of specific screen spots (Spot 1 on round 1, Spot 2 on round 2...)")
    pickedSpots := hasSpots ? node["varySpots"].Clone() : []
    txtSpots := dlg.AddText("xm+24 y+6 w380 c505050", pickedSpots.Length ? pickedSpots.Length . " spot(s) recorded." : "(No multi-spots picked yet)")
    btnPickSpots := dlg.AddButton("x+8 yp-4 w220 h25", "🎯 Pick spots on screen (F6)...")

    rKeys := dlg.AddRadio("xm y+12" . (defaultMode = 3 ? " Checked" : ""), "⌨ Press a key more times each round (e.g. Down arrow 1x, then 2x, then 3x...)")
    dlg.AddText("xm+24 y+6", "Key:")
    cbKey := dlg.AddComboBox("x+6 yp-3 w110", ["Down", "Up", "Tab", "Right", "Left", "PgDn", "Enter", "Space"])
    cbKey.Text := node.Get("varyKeyName", "Down")
    dlg.AddText("x+14 yp+3", "Presses on Round 1:")
    edKeyStart := dlg.AddEdit("x+6 yp-3 w55 Number", node.Get("varyKeyStart", 1))
    dlg.AddText("x+14 yp+3", "Add per round:")
    edKeyStep := dlg.AddEdit("x+6 yp-3 w55", node.Get("varyKeyStep", 1))

    rText := dlg.AddRadio("xm y+12" . (defaultMode = 4 ? " Checked" : ""), "🔢 Type a changing number, counter, or data column ({{index}}, {{i}}, {{Column}})")
    dlg.AddText("xm+24 y+6", "Text / template to type:")
    edText := dlg.AddEdit("x+6 yp-3 w260", node.Get("type", "") = "text" && node.Get("text", "") != "" ? node["text"] : "{{index}}")
    cols := VMB_ColumnChoices()
    ddCol := dlg.AddDropDownList("x+8 yp w140", cols)
    if cols.Length
        ddCol.Value := 1
    btnInsCol := dlg.AddButton("x+4 yp-1 w85 h24", "Insert {{...}}")

    ; Loop auto-wrap section
    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+16 w660", "2. Automatically wrap your steps in a loop (no manual dragging needed):")
    dlg.SetFont("s9 norm", "Segoe UI")
    chkWrap := dlg.AddCheckbox("xm y+6 Checked", "Wrap the macro steps in a loop automatically:")
    ddLoop := dlg.AddDropDownList("x+8 yp-3 w270", [
        "Repeat N times (uses {{index}} = 1, 2, 3...)",
        "For counter variable (e.g. i = 1 to N)",
        "For each row in Data File ({{Column}})"])
    ddLoop.Value := VMB_HasData() && defaultMode = 4 ? 3 : 1
    dlg.AddText("xm+24 y+8", "How many rounds (N):")
    edCount := dlg.AddEdit("x+6 yp-3 w70 Number", pickedSpots.Length ? pickedSpots.Length : 10)
    dlg.AddText("x+16 yp+3", "For variable name:")
    edVar := dlg.AddEdit("x+6 yp-3 w65", "i")
    dlg.AddText("x+12 yp+3", "Start at:")
    edFrom := dlg.AddEdit("x+6 yp-3 w55", "1")
    dlg.AddText("x+12 yp+3", "Step by:")
    edStep := dlg.AddEdit("x+6 yp-3 w55", "1")

    ; Ensure mutual exclusion across all 4 radio buttons
    radios := [rPixel, rSpots, rKeys, rText]
    selectRadio(which, *) {
        for r in radios
            r.Value := (r = which ? 1 : 0)
    }
    for r in radios
        r.OnEvent("Click", selectRadio.Bind(r))

    btnP20.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 20))
    btnP24.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 24))
    btnP30.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 30))
    btnP40.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 40))
    btnPRight.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 100, edDY.Value := 0))

    btnMeasure.OnEvent("Click", (*) => (
        dlg.Hide(),
        m := V8_MeasureTwoPointsOnScreen(),
        dlg.Show(),
        m ? (
            selectRadio(rPixel),
            edDX.Value := m.DX,
            edDY.Value := m.DY,
            node["scrX"] := m.X1, node["scrY"] := m.Y1,
            node["x"] := m.X1, node["y"] := m.Y1
        ) : 0
    ))

    btnPickSpots.OnEvent("Click", (*) => (
        dlg.Hide(),
        pts := V8_PickMultipleSpotsOnScreen(),
        dlg.Show(),
        pts.Length ? (
            selectRadio(rSpots),
            pickedSpots := pts,
            txtSpots.Text := pickedSpots.Length . " spot(s) captured! Loop count set to " . pickedSpots.Length . ".",
            edCount.Value := pickedSpots.Length
        ) : 0
    ))

    btnInsCol.OnEvent("Click", (*) => (selectRadio(rText), ddCol.Text != "" ? EditPaste("{{" . ddCol.Text . "}}", edText) : 0))

    btnApply := dlg.AddButton("xm y+16 w210 h30 Default", "⚡ Apply Vary & Auto-Loop")
    btnClear := dlg.AddButton("x+8 yp w150 h30", "Clear Variation")
    btnCancel := dlg.AddButton("x+8 yp w100 h30", "Cancel")

    applyVary(*) {
        try {
            VMB_Snapshot()
            V8_ClearVaryProps(node)
            if rPixel.Value {
                if !IsInteger(Trim(edDX.Value)) || !IsInteger(Trim(edDY.Value))
                    throw Error("Shift X and Shift Y must be whole numbers (e.g. 0 and 24).")
                node["find"] := "spot"
                dx := Integer(Trim(edDX.Value)), dy := Integer(Trim(edDY.Value))
                if dx != 0
                    node["varyDX"] := dx
                if dy != 0
                    node["varyDY"] := dy
            } else if rSpots.Value {
                if !pickedSpots.Length
                    throw Error("Click 'Pick spots on screen (F6)...' to capture at least 1 spot first.")
                node["type"] := "click"
                node["find"] := "spot"
                node["scrX"] := pickedSpots[1]["scrX"], node["scrY"] := pickedSpots[1]["scrY"]
                node["varySpots"] := pickedSpots
            } else if rKeys.Value {
                kName := Trim(cbKey.Text)
                if kName = ""
                    throw Error("Choose or type a key name (such as Down or Tab).")
                node["type"] := "keys"
                node["keys"] := "{" . kName . "}"
                node["varyKey"] := 1
                node["varyKeyName"] := kName
                node["varyKeyStart"] := IsInteger(Trim(edKeyStart.Value)) ? Integer(Trim(edKeyStart.Value)) : 1
                node["varyKeyStep"] := IsInteger(Trim(edKeyStep.Value)) ? Integer(Trim(edKeyStep.Value)) : 1
            } else if rText.Value {
                node["type"] := "text"
                node["text"] := edText.Value
                VM__SetOrDelete(node, "ask", "")
            }
            if chkWrap.Value {
                loopKinds := ["repeat", "for", "foreach"]
                lKind := loopKinds[Max(1, ddLoop.Value)]
                lCount := IsInteger(Trim(edCount.Value)) ? Max(1, Integer(Trim(edCount.Value))) : 10
                fVar := Trim(edVar.Value) != "" ? Trim(edVar.Value) : "i"
                fFrom := IsNumber(Trim(edFrom.Value)) ? Number(Trim(edFrom.Value)) : 1
                fStep := IsNumber(Trim(edStep.Value)) && Number(Trim(edStep.Value)) != 0 ? Number(Trim(edStep.Value)) : 1
                if lKind = "for"
                    node["varyVar"] := fVar
                V8_AutoWrapInLoop(s.Macro["blocks"], node, lKind, lCount, fVar, fFrom, fStep, scopeSteps)
            }
            s.Dirty := true
            dlg.Destroy()
            VMB_Refresh(node)
            V7_AutoSaveNow()
            VMB_Status("⚡ Smart Vary & Auto-Loop applied! Press F5 to play or F10 to step through it.")
        } catch as err {
            MsgBox(err.Message, "Smart Vary & Auto-Loop", "Icon! Owner" . dlg.Hwnd)
        }
    }

    btnApply.OnEvent("Click", applyVary)
    btnClear.OnEvent("Click", (*) => (dlg.Destroy(), V8_ClearVaryOnSelected()))
    btnCancel.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    dlg.Show()
}

; ============================================================================
; V10 CLASSICAL NON-OCR / NON-IMAGE DETERMINISTIC AUTOMATION ENGINE
; - Region CRC32 State-Machine Waits (GDI BitBlt + ntdll\RtlComputeCrc32)
; - Semantic Single-Pixel & Color-Family Sentinels
; - Geometry-Anchored & Edge-Relative Coordinates (TopLeft/BottomCenter/TopRight/Center/Pct)
; - Layout Physics & Deterministic List/Dropdown Row Predictor (Partitioned Sort + Conditional Shift)
; - Human-Physics Mouse (WindMouse / Minimum-Jerk trajectory + Hover-Dwell) & Citrix 3-Stage Field Clear
; - Interactive "Deterministic Inspector & Layout Physics Lab" (Ctrl+Shift+D)
; ============================================================================

; @summary Definitions for all V10 Classical Deterministic blocks in the left toolbox.
; @tags macro, deterministic, crc32, pixel, anchor, layout-physics, v10
V10_DetDefs() {
    static defs := 0
    if defs
        return defs
    defs := Map()
    target := ["target", "Window selector (blank = Macro window, else active/recorded; e.g. ahk_exe wfica32.exe)", "text"]
    defs["det_anchor_click"] := {
        Label: "Anchor-Relative Click (No Image/OCR)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("anchor", "BottomCenter", "dx", -41, "dy", -60, "pctX", 50, "pctY", 50,
            "button", "Left", "count", 1, "hoverMs", 40, "target", ""),
        Fields: [
            ["anchor", "Window Geometry Anchor (why the control sits where it does)", "choice",
                ["TopLeft", "BottomCenter", "TopRight", "BottomRight", "BottomLeft", "Center", "ProportionalPct"]],
            ["dx", "Offset X from anchor in pixels (e.g. -41 from BottomCenter)", "number"],
            ["dy", "Offset Y from anchor in pixels (e.g. -60 from BottomCenter)", "number"],
            ["pctX", "Proportional X % (0-100, used when anchor = ProportionalPct)", "number"],
            ["pctY", "Proportional Y % (0-100, used when anchor = ProportionalPct)", "number"],
            ["button", "Mouse button", "choice", ["Left", "Right", "Middle"]],
            ["count", "Click count (1 or 2)", "number"],
            ["hoverMs", "Hover dwell before click in ms (prevents dropdown/menu auto-close)", "number"],
            target
        ],
        Desc: "Clicks by window layout math (Dialog Right/Bottom Anchors or Proportional %) instead of brittle screen pixels or image search."
    }
    defs["det_human_click"] := {
        Label: "Human-Physics Click (WindMouse + Hover Dwell)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x", 300, "y", 200, "coordRel", "Window", "profile", "MinimumJerk",
            "durationMs", 180, "hoverMs", 65, "button", "Left", "count", 1, "target", ""),
        Fields: [
            ["x", "Target X (supports {{variables}})", "text"],
            ["y", "Target Y (supports {{variables}})", "text"],
            ["coordRel", "Coordinates relative to", "choice", ["Window", "Screen"]],
            ["profile", "Trajectory physics model", "choice", ["MinimumJerk", "WindMouse", "Instant"]],
            ["durationMs", "Movement duration in milliseconds (0 = instant)", "number"],
            ["hoverMs", "Pre-click hover dwell in milliseconds (triggers WM_MOUSEHOVER / menu open)", "number"],
            ["button", "Mouse button", "choice", ["Left", "Right", "Middle"]],
            ["count", "Click count (1 or 2)", "number"],
            target
        ],
        Desc: "Replicates human hand physics (Flash & Hogan minimum-jerk curve or WindMouse gravity/wind) + hover dwell so custom UIs never drop clicks."
    }
    defs["det_predict_row"] := {
        Label: "Predict & Select List/Dropdown Row (Layout Physics)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("wantItem", "{{Product}}", "allItems", "", "tickedItems", "",
            "sortRule", "Partitioned_TickedFirst_AZ", "conditionalShiftItems", "541-RX-CLINIC-IP",
            "selectMethod", "CheckboxClick", "row1X", 175, "row1Y", 388, "rowHeight", 17,
            "maxVisibleRows", 6, "variable", "predicted_row", "target", ""),
        Fields: [
            ["wantItem", "Target item to find/click (or {{Column}} / {{variable}})", "text"],
            ["allItems", "All candidate items (comma or newline separated)", "multiline"],
            ["tickedItems", "Currently ticked/active items (for Partitioned Sort: Ticked A-Z then Unticked A-Z)", "multiline"],
            ["sortRule", "How the application's code orders the list", "choice",
                ["Partitioned_TickedFirst_AZ", "Alphabetical_AZ", "ExactGivenOrder"]],
            ["conditionalShiftItems", "Conditional items omitted when unticked (shifts later rows up by 1)", "text"],
            ["selectMethod", "How to select the predicted row", "choice",
                ["CheckboxClick", "KeyboardHomeDownSpace", "StoreRowOnly"]],
            ["row1X", "Row 1 click X (window-relative)", "number"],
            ["row1Y", "Row 1 click Y (window-relative, e.g. 388)", "number"],
            ["rowHeight", "Exact row stride height in pixels (e.g. 17)", "number"],
            ["maxVisibleRows", "Max visible rows before scrollbar is required (0 = no limit)", "number"],
            ["variable", "Store 1-based predicted row index in variable", "text"],
            target
        ],
        Desc: "Calculates exact row position and pixel Y = row1Y + (row-1)*rowHeight from the app's sort/partition algorithm — zero OCR required."
    }
    defs["det_wait_settled"] := {
        Label: "Wait for Region CRC32 Change & Settle",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x1", 165, "y1", 95, "x2", 660, "y2", 190, "waitForChangeMs", 1500,
            "stableMs", 150, "timeoutMs", 10000, "compareVar", "", "variable", "region_crc", "target", ""),
        Fields: [
            ["x1", "Region Left X1 (window-relative)", "number"],
            ["y1", "Region Top Y1 (window-relative)", "number"],
            ["x2", "Region Right X2 (window-relative)", "number"],
            ["y2", "Region Bottom Y2 (window-relative)", "number"],
            ["waitForChangeMs", "Phase 1: Max ms to wait for region to START changing (0 = skip Phase 1)", "number"],
            ["stableMs", "Phase 2: Ms region must stay 100% identical to count as settled", "number"],
            ["timeoutMs", "Overall timeout in milliseconds", "number"],
            ["compareVar", "Optional variable holding previous CRC32 (sets {{compareVar}}_unchanged = 1 at end-of-list!)", "text"],
            ["variable", "Store final settled 32-bit CRC hex in variable", "text"],
            target
        ],
        Desc: "Hashes rectangle pixels via GDI BitBlt + ntdll\\RtlComputeCrc32. Replaces fixed Sleeps and detects end-of-list when CRC stops changing."
    }
    defs["det_wait_pixel"] := {
        Label: "Wait for Pixel Sentinel (Color / State)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x", 300, "y", 76, "colorMode", "DiscernYellow", "colorHex", "FFFF80",
            "tolerance", 40, "appear", 1, "timeoutMs", 15000, "target", ""),
        Fields: [
            ["x", "Pixel X (window-relative)", "number"],
            ["y", "Pixel Y (window-relative)", "number"],
            ["colorMode", "Semantic color state to check", "choice",
                ["DiscernYellow", "NearHex", "CernerDoorBlue", "HighlightBlue", "DisabledGrey", "WhiteReady"]],
            ["colorHex", "Reference RGB Hex (RRGGBB, used when mode = NearHex)", "text"],
            ["tolerance", "Per-channel RGB tolerance (0-255, used when mode = NearHex)", "number"],
            ["appear", "Wait until state is TRUE (uncheck = wait until state goes away)", "check"],
            ["timeoutMs", "Timeout in milliseconds", "number"],
            target
        ],
        Desc: "Waits for a 1-pixel UI state change (e.g. yellow active input, blue selection highlight, or portal door icon) in <1 ms per check."
    }
    defs["det_if_pixel"] := {
        Label: "If Pixel Sentinel Matches / Else...",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("cond", "pixel", "x", 250, "y", 342, "colorMode", "DiscernYellow",
            "colorHex", "FFFF80", "tolerance", 40, "appear", 1, "target", ""),
        Fields: [
            ["x", "Pixel X (window-relative)", "number"],
            ["y", "Pixel Y (window-relative)", "number"],
            ["colorMode", "Semantic color state to check", "choice",
                ["DiscernYellow", "NearHex", "CernerDoorBlue", "HighlightBlue", "DisabledGrey", "WhiteReady"]],
            ["colorHex", "Reference RGB Hex (RRGGBB, used when mode = NearHex)", "text"],
            ["tolerance", "Per-channel RGB tolerance (0-255)", "number"],
            ["appear", "Condition is TRUE when pixel matches (uncheck = when it does NOT match)", "check"],
            target
        ],
        Desc: "Branches macro execution (IF / ELSE) based on a single-pixel color state (e.g. detecting {Empty} list when Flex rows stay yellow)."
    }
    defs["det_normalize_win"] := {
        Label: "Normalize Window Geometry (Size & Spot)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("width", 693, "height", 803, "marginX", 20, "marginY", 20, "strictDpiCheck", 1, "maximize", 0, "target", ""),
        Fields: [
            ["width", "Canonical window width in pixels (e.g. 693)", "number"],
            ["height", "Canonical window height in pixels (e.g. 803)", "number"],
            ["marginX", "Left work-area margin in pixels", "number"],
            ["marginY", "Top work-area margin in pixels", "number"],
            ["maximize", "Maximize the window instead (width, height and margins are ignored)", "check"],
            ["strictDpiCheck", "Check the final size (±4 px); a window that can't reach it is noted in the playback log and the run keeps going", "check"],
            target
        ],
        Desc: "Restores the target window to the exact canonical width/height on the primary work area so window-relative coordinates never miss."
            . " Fixed-size dialogs are only moved."
    }
    defs["det_citrix_fill"] := {
        Label: "Citrix-Safe Field Clear & Type",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x", 300, "y", 76, "value", "{{Product}}", "pressTab", 1, "settleMs", 250, "target", ""),
        Fields: [
            ["x", "Field click X (window-relative; 0 = do not click first)", "number"],
            ["y", "Field click Y (window-relative; 0 = do not click first)", "number"],
            ["value", "Text to enter (supports {{Column}} / {{variable}})", "text"],
            ["pressTab", "Press {Tab} after typing to trigger query/commit", "check"],
            ["settleMs", "Wait after focus/clear in milliseconds", "number"],
            target
        ],
        Desc: "Clicks field, runs 3-stage Citrix-proof clear (2x End+Shift+Home+Delete + Backspace sweep so dropped modifiers never leave text), types, and Tabs."
    }
    defs["det_wait_window"] := {                                  ; V31: Wait until window ... is open / closed
        Label: "Wait Until Window Is Open / Closed",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("target", "", "timeoutSec", 10, "closed", 0),
        Fields: [
            ["target", "Part of the window title (any program)", "text"],
            ["timeoutSec", "Fails after this many seconds (then 'If it fails' decides what happens)", "number"],
            ["closed", "Wait until the window is CLOSED instead of open", "check"]
        ],
        Desc: "Waits until a window whose title contains the text is open (or closed). If it takes longer than the seconds given, the step fails."
    }
    defs["det_use_window"] := {
        Label: "Use Window From Here On",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("target", "", "waitSec", 10, "activate", 1),
        Fields: [
            ["target", "Window for the next steps (e.g. ahk_exe notepad.exe; blank = back to Macro window)", "text"],
            ["waitSec", "Wait up to this many seconds for the window to appear", "number"],
            ["activate", "Bring the window to the front now", "check"]
        ],
        Desc: "Switches the window for every later step whose Window selector is blank, until the next Use Window block. "
            . "Put one wherever the macro moves to a different program."
    }
    return defs
}

; @summary Short summary string shown in the macro tree for V10 deterministic steps.
; @tags macro, deterministic, gui, v10
V10_DetStepInfo(node) {
    t := node.Get("type", "")
    switch t {
        case "det_anchor_click":
            anc := node.Get("anchor", "BottomCenter")
            return anc = "ProportionalPct"
                ? "Pct (" . node.Get("pctX", 50) . "%, " . node.Get("pctY", 50) . "%)"
                : anc . " (" . (node.Get("dx", 0) >= 0 ? "+" : "") . node.Get("dx", 0) . ", " . (node.Get("dy", 0) >= 0 ? "+" : "") . node.Get("dy", 0) . ")"
        case "det_human_click":
            return node.Get("profile", "MinimumJerk") . " -> (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") dwell " . node.Get("hoverMs", 65) . "ms"
        case "det_predict_row":
            return "'" . node.Get("wantItem", "") . "' [" . node.Get("sortRule", "Partitioned_TickedFirst_AZ") . " -> " . node.Get("selectMethod", "CheckboxClick") . "]"
        case "det_wait_settled":
            return "rect [" . node.Get("x1", 0) . "," . node.Get("y1", 0) . ".." . node.Get("x2", 0) . "," . node.Get("y2", 0) . "] stable " . node.Get("stableMs", 150) . "ms"
        case "det_wait_pixel":
            return "(" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") = " . node.Get("colorMode", "DiscernYellow")
        case "det_normalize_win":
            return V4_Bool(node.Get("maximize", 0)) ? "maximized" : node.Get("width", 693) . "x" . node.Get("height", 803)
        case "det_citrix_fill":
            return "(" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") := " . SubStr(node.Get("value", ""), 1, 40)
        case "det_use_window":
            return node.Get("target", "") = "" ? "(back to Macro window)" : node["target"]
        case "det_wait_window":
            return V31_WaitText(node)
    }
    return ""
}

; @summary Validates a V10 deterministic block before saving or running.
; @tags macro, deterministic, validate, v10
V10_DetValidate(node) {
    t := node.Get("cond", "") = "pixel" ? "det_if_pixel" : node.Get("type", "")
    if !V10_DetDefs().Has(t)
        throw Error("Unknown V10 deterministic block: " . t)
    if t = "det_wait_settled" {
        if Integer(node.Get("x2", 0)) <= Integer(node.Get("x1", 0)) || Integer(node.Get("y2", 0)) <= Integer(node.Get("y1", 0))
            throw Error("Region X2/Y2 must be greater than X1/Y1.")
        if Integer(node.Get("stableMs", 150)) < 10
            throw Error("stableMs must be at least 10 ms.")
    }
    if t = "det_normalize_win" {
        if Integer(node.Get("width", 0)) < 50 || Integer(node.Get("height", 0)) < 50
            throw Error("Window width and height must be at least 50 pixels.")
    }
    if t = "det_predict_row" {
        if Integer(node.Get("rowHeight", 17)) < 1
            throw Error("rowHeight must be at least 1 pixel.")
    }
}

; @summary Window for a step with a blank Window selector: the last "Use Window From Here On", else the Macro window.
; @tags macro, window, v16
V16_FallbackTarget(ctx) {
    if !IsObject(ctx)
        return ""
    if ctx.HasOwnProp("UseTarget") && ctx.UseTarget != ""
        return ctx.UseTarget
    return ctx.HasOwnProp("Settings") ? Trim(ctx.Expand(ctx.Settings.Get("defaultTarget", ""))) : ""
}

; @summary Runs a "Use Window From Here On" block: waits for the window, optionally activates it, and makes it the
;          window for later steps with a blank Window selector (blank target = back to the Macro window).
; @tags macro, window, play, v16
V16_UseWindow(node, ctx) {
    want := Trim(ctx.Expand(node.Get("target", "")))
    ctx.UseTarget := want
    if want = ""
        want := V16_FallbackTarget(ctx)
    if want = ""
        return
    deadline := A_TickCount + Max(0, Number(node.Get("waitSec", 10))) * 1000
    while !(hwnd := WinExist(want)) {
        if A_TickCount >= deadline
            throw Error("Use Window: '" . want . "' did not appear within " . node.Get("waitSec", 10) . " s.")
        ctx.Sleep(100)
    }
    if V4_Bool(node.Get("activate", 1)) {
        WinActivate("ahk_id " . hwnd)
        if !WinWaitActive("ahk_id " . hwnd, , 3)
            throw Error("Use Window: '" . want . "' did not come to the front.")
    }
}

; @summary Resolves the target window HWND for a V10 deterministic step (activates it if needed).
; @tags macro, deterministic, window, v10
V10_ResolveWindow(node, ctx := 0) {
    target := Trim(IsObject(ctx) ? ctx.Expand(node.Get("target", "")) : node.Get("target", ""))
    if target = ""
        target := V16_FallbackTarget(ctx)
    if target != "" {
        hwnd := WinExist(target)
        if !hwnd && V18_Steady(ctx)     ; V18: give the window time to open, then stop with a clear message
            hwnd := V18_WaitTarget(target, ctx)
        if !hwnd
            return V4_Window(node)
        if V18_Steady(ctx)
            V18_Activate(hwnd, ctx, true)
        else if !WinActive("ahk_id " . hwnd) {
            WinActivate("ahk_id " . hwnd)
            WinWaitActive("ahk_id " . hwnd, , 2)
        }
        return hwnd
    }
    return V4_Window(node, ctx)
}

; @summary Computes exact screen and window-relative coordinates from a window geometry anchor:
;          TopLeft, BottomCenter, TopRight, BottomRight, BottomLeft, Center, or ProportionalPct.
; @returns {ScreenX, ScreenY, WinX, WinY, W, H}
; @tags macro, deterministic, anchor, geometry, v10
V10_CalcAnchorPoint(winW, winH, anchor, dx := 0, dy := 0, pctX := 50, pctY := 50, winX := 0, winY := 0) {
    winW := Max(1, Integer(winW)), winH := Max(1, Integer(winH))
    dx := Integer(dx), dy := Integer(dy)
    switch anchor {
        case "BottomCenter":
            rx := (winW // 2) + dx, ry := winH + dy
        case "TopRight":
            rx := winW + dx, ry := dy
        case "BottomRight":
            rx := winW + dx, ry := winH + dy
        case "BottomLeft":
            rx := dx, ry := winH + dy
        case "Center":
            rx := (winW // 2) + dx, ry := (winH // 2) + dy
        case "ProportionalPct":
            rx := Round(winW * (Number(pctX) / 100.0)) + dx
            ry := Round(winH * (Number(pctY) / 100.0)) + dy
        default: ; TopLeft
            rx := dx, ry := dy
    }
    return {WinX: rx, WinY: ry, ScreenX: winX + rx, ScreenY: winY + ry, W: winW, H: winH}
}

; @summary Evaluates a color integer (0xRRGGBB) against a V10 semantic pixel sentinel mode.
; @tags macro, deterministic, pixel, color, v10
V10_MatchColorSentinel(c, mode := "DiscernYellow", hexRef := "FFFF80", tol := 40) {
    c := Integer(c)
    r := (c >> 16) & 0xFF, g := (c >> 8) & 0xFF, b := c & 0xFF
    switch mode {
        case "DiscernYellow":
            ; Cerner Discern Prompt yellow input/row background (FFFF80-ish: high R & G, lower B)
            return r > 0xF0 && g > 0xF0 && b < 0xB0
        case "CernerDoorBlue":
            ; Reporting Portal exit door icon (0x9999FF-ish)
            return Abs(r - 0x99) < 40 && Abs(g - 0x99) < 40 && Abs(b - 0xFF) < 40
        case "HighlightBlue":
            ; Standard Windows / Citrix selection highlight (low R, medium-high G/B or classic Navy 000080 / 0078D7)
            return (b > 0x70 && b > r + 40)
        case "DisabledGrey":
            ; Neutral grey where R, G, B are within 12 of each other and between 0x80 and 0xE8
            return Abs(r - g) <= 12 && Abs(g - b) <= 12 && r >= 0x80 && r <= 0xE8
        case "WhiteReady":
            return r > 0xF0 && g > 0xF0 && b > 0xF0
        default: ; NearHex
            clean := RegExReplace(Trim(hexRef), "i)^0x|^#")
            ref := IsXDigit(clean) && StrLen(clean) ? Integer("0x" . clean) : 0xFFFF80
            rr := (ref >> 16) & 0xFF, rg := (ref >> 8) & 0xFF, rb := ref & 0xFF
            tol := Max(0, Integer(tol))
            return Abs(r - rr) <= tol && Abs(g - rg) <= tol && Abs(b - rb) <= tol
    }
}

IsXDigit(str) => RegExMatch(str, "i)^[0-9a-f]+$") != 0

; @summary Reads a window-relative pixel and checks it against the node's semantic sentinel settings.
; @tags macro, deterministic, pixel, v10
V10_CheckPixelSentinel(node, ctx := 0) {
    hwnd := V10_ResolveWindow(node, ctx)
    WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
    px := wx + Integer(node.Get("x", 0)), py := wy + Integer(node.Get("y", 0))
    V5_HideOverlays(px, py)
    CoordMode("Pixel", "Screen")
    c := PixelGetColor(px, py)
    return V10_MatchColorSentinel(c, node.Get("colorMode", "DiscernYellow"),
        IsObject(ctx) ? ctx.Expand(node.Get("colorHex", "FFFF80")) : node.Get("colorHex", "FFFF80"),
        node.Get("tolerance", 40))
}

; @summary Computes a fast 32-bit hardware CRC32 hash of a window-relative rectangle's pixels using GDI BitBlt + ntdll\RtlComputeCrc32.
;          Takes ~0.3 ms and requires zero disk I/O, zero OCR, and zero image template files.
; @tags macro, deterministic, crc32, gdi, v10
V10_RegionCRC(hwnd, x1, y1, x2, y2) {
    WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
    x := wx + Integer(x1), y := wy + Integer(y1)
    w := Max(1, Integer(x2) - Integer(x1)), h := Max(1, Integer(y2) - Integer(y1))
    V5_HideOverlays()
    hdcScreen := DllCall("GetDC", "Ptr", 0, "Ptr")
    hdcMem := DllCall("CreateCompatibleDC", "Ptr", hdcScreen, "Ptr")
    bi := Buffer(40, 0)
    NumPut("UInt", 40, bi, 0), NumPut("Int", w, bi, 4), NumPut("Int", -h, bi, 8)
    NumPut("UShort", 1, bi, 12), NumPut("UShort", 32, bi, 14)
    bits := 0
    hbm := DllCall("CreateDIBSection", "Ptr", hdcMem, "Ptr", bi, "UInt", 0, "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
    old := DllCall("SelectObject", "Ptr", hdcMem, "Ptr", hbm, "Ptr")
    DllCall("BitBlt", "Ptr", hdcMem, "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr", hdcScreen, "Int", x, "Int", y, "UInt", 0x00CC0020)
    crc := DllCall("ntdll\RtlComputeCrc32", "UInt", 0, "Ptr", bits, "UInt", w * h * 4, "UInt")
    DllCall("SelectObject", "Ptr", hdcMem, "Ptr", old)
    DllCall("DeleteObject", "Ptr", hbm)
    DllCall("DeleteDC", "Ptr", hdcMem)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcScreen)
    return Format("0x{:08X}", crc & 0xFFFFFFFF)
}

; @summary Two-Phase Region CRC32 State Machine:
;          Phase 1 (optional): Waits up to waitForChangeMs for the region's CRC32 to DIFFER from its initial value (reacting!).
;          Phase 2: Waits until the region's CRC32 remains completely unchanged for stableMs (settled!).
; @tags macro, deterministic, crc32, wait, v10
V10_WaitRegionSettled(hwnd, x1, y1, x2, y2, waitForChangeMs := 1500, stableMs := 150, timeoutMs := 10000, runner := 0) {
    t0 := A_TickCount
    before := V10_RegionCRC(hwnd, x1, y1, x2, y2)
    if waitForChangeMs > 0 {
        while V10_RegionCRC(hwnd, x1, y1, x2, y2) = before && (A_TickCount - t0) < waitForChangeMs {
            if IsObject(runner)
                runner.Sleep(20)
            else
                Sleep(20)
        }
    }
    last := V10_RegionCRC(hwnd, x1, y1, x2, y2), since := A_TickCount
    while (A_TickCount - since) < stableMs && (A_TickCount - t0) < timeoutMs {
        if IsObject(runner)
            runner.Sleep(25)
        else
            Sleep(25)
        cur := V10_RegionCRC(hwnd, x1, y1, x2, y2)
        if cur != last
            last := cur, since := A_TickCount
    }
    return last
}

; @summary Predicts the exact 1-based row position and pixel coordinate of an item inside a sorted/partitioned list or dropdown
;          (such as Cerner Discern Prompt's Pharmacy Selection list where ticked items sort A-Z at the top, followed by unticked A-Z,
;          and conditional items like 541-RX-CLINIC-IP shift subsequent rows when absent).
; @returns {Found, Row, ClickX, ClickY, DownCount, Order, ShiftedByConditional}
; @tags macro, deterministic, layout-physics, list, dropdown, v10
V10_PredictListRow(wantItem, allItemsText, tickedItemsText := "", sortRule := "Partitioned_TickedFirst_AZ",
    conditionalShiftText := "", row1X := 175, row1Y := 388, rowHeight := 17) {
    wantItem := Trim(wantItem)
    allList := V10_SplitListItems(allItemsText)
    tickedSet := Map(), tickedSet.CaseSense := false
    for it in V10_SplitListItems(tickedItemsText)
        tickedSet[it] := true
    condSet := Map(), condSet.CaseSense := false
    for it in V10_SplitListItems(conditionalShiftText)
        condSet[it] := true

    order := []
    if sortRule = "Partitioned_TickedFirst_AZ" {
        tBucket := "", uBucket := ""
        for it in allList {
            ; Conditional items that are NOT currently ticked are omitted by the app's query, shifting later rows up!
            if condSet.Has(it) && !tickedSet.Has(it)
                continue
            if tickedSet.Has(it)
                tBucket .= it . "`n"
            else
                uBucket .= it . "`n"
        }
        for part in [tBucket, uBucket] {
            if part != "" {
                for line in StrSplit(Sort(RTrim(part, "`n")), "`n")
                    if Trim(line) != ""
                        order.Push(Trim(line))
            }
        }
    } else if sortRule = "Alphabetical_AZ" {
        bucket := ""
        for it in allList {
            if condSet.Has(it) && !tickedSet.Has(it)
                continue
            bucket .= it . "`n"
        }
        if bucket != "" {
            for line in StrSplit(Sort(RTrim(bucket, "`n")), "`n")
                if Trim(line) != ""
                    order.Push(Trim(line))
        }
    } else { ; ExactGivenOrder
        for it in allList {
            if condSet.Has(it) && !tickedSet.Has(it)
                continue
            order.Push(it)
        }
    }

    foundRow := 0
    for idx, it in order {
        if StrLower(it) = StrLower(wantItem) {
            foundRow := idx
            break
        }
    }
    if !foundRow {
        for idx, it in order {
            if InStr(it, wantItem) || InStr(wantItem, it) {
                foundRow := idx
                break
            }
        }
    }
    clickX := Integer(row1X)
    clickY := foundRow ? Integer(row1Y) + (foundRow - 1) * Integer(rowHeight) : Integer(row1Y)
    return {
        Found: foundRow > 0,
        Row: foundRow,
        ClickX: clickX,
        ClickY: clickY,
        DownCount: Max(0, foundRow - 1),
        Order: order
    }
}

V10_SplitListItems(text) {
    out := [], seen := Map(), seen.CaseSense := false
    for raw in StrSplit(String(text), ["`n", ",", ";"], " `t`r") {
        val := Trim(raw)
        if val != "" && !seen.Has(val) {
            seen[val] := true
            out.Push(val)
        }
    }
    return out
}

; @summary Generates intermediate trajectory waypoints from (x1, y1) to (x2, y2) using either:
;          • MinimumJerk (Flash & Hogan 1985 bell-shaped velocity profile: 10*t^3 - 15*t^4 + 6*t^5)
;          • WindMouse (BenLand100 gravity + wind + velocity clipping)
; @returns Array of {X, Y} waypoints ending at exact {X: x2, Y: y2}
; @tags macro, deterministic, human-mouse, windmouse, minimum-jerk, v10
V10_GenerateMousePath(x1, y1, x2, y2, profile := "MinimumJerk", steps := 14) {
    x1 := Round(x1), y1 := Round(y1), x2 := Round(x2), y2 := Round(y2)
    pts := []
    dist := Sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)
    if dist < 2 || profile = "Instant" || steps <= 1 {
        pts.Push({X: x2, Y: y2})
        return pts
    }
    if profile = "WindMouse" {
        cx := Float(x1), cy := Float(y1), vx := 0.0, vy := 0.0, wx := 0.0, wy := 0.0
        gravity := 9.0, wind := 2.5, maxStep := Max(8.0, dist / Max(4, steps))
        Loop Max(12, steps * 2) {
            rem := Sqrt((x2 - cx) ** 2 + (y2 - cy) ** 2)
            if rem < 2.0
                break
            wMag := Min(wind, rem)
            ; Deterministic pseudo-random oscillation based on step index so paths are organic yet reproducible
            angle := A_Index * 1.9
            wx := wx / 1.414 + (Cos(angle) * wMag) / 2.236
            wy := wy / 1.414 + (Sin(angle) * wMag) / 2.236
            vx += wx + gravity * (x2 - cx) / rem
            vy += wy + gravity * (y2 - cy) / rem
            vMag := Sqrt(vx * vx + vy * vy)
            limit := rem < 18 ? Max(2.0, rem / 2.5) : maxStep
            if vMag > limit {
                vx := (vx / vMag) * limit
                vy := (vy / vMag) * limit
            }
            cx += vx, cy += vy
            pts.Push({X: Round(cx), Y: Round(cy)})
        }
        pts.Push({X: x2, Y: y2})
        return pts
    }
    ; Default: Minimum-Jerk trajectory (Flash & Hogan 1985: s(t) = 10t^3 - 15t^4 + 6t^5)
    ; Slight natural arc perpendicular to chord (peaks at t=0.5)
    dx := x2 - x1, dy := y2 - y1
    arcMag := Min(12.0, dist * 0.04)
    perpX := dist > 0 ? -dy / dist : 0.0
    perpY := dist > 0 ? dx / dist : 0.0
    steps := VF_Clamp(Integer(steps), 4, 40)
    Loop steps {
        t := A_Index / Float(steps)
        s := (10.0 * (t ** 3)) - (15.0 * (t ** 4)) + (6.0 * (t ** 5))
        arc := 4.0 * t * (1.0 - t) * arcMag * (A_Index = steps ? 0.0 : 1.0)
        px := Round(x1 + dx * s + perpX * arc)
        py := Round(y1 + dy * s + perpY * arc)
        pts.Push({X: px, Y: py})
    }
    pts[pts.Length] := {X: x2, Y: y2}
    return pts
}

; @summary Moves the mouse along a human-physics path, pauses for hoverMs so hover states / dropdown menus register, and clicks.
; @tags macro, deterministic, human-mouse, click, v10
V10_HumanMoveAndClick(targetX, targetY, profile := "MinimumJerk", durationMs := 160, hoverMs := 60, button := "Left", count := 1) {
    CoordMode("Mouse", "Screen")
    MouseGetPos(&startX, &startY)
    V5_HideOverlays(targetX, targetY)
    durationMs := Max(0, Integer(durationMs))
    if durationMs > 0 && profile != "Instant" {
        steps := VF_Clamp( durationMs // 12, 5, 30 )
        stepSleep := Max(1, durationMs // steps)
        pts := V10_GenerateMousePath(startX, startY, targetX, targetY, profile, steps)
        for pt in pts {
            MouseMove(pt.X, pt.Y, 0)
            DllCall("Sleep", "UInt", stepSleep)
        }
    } else {
        MouseMove(targetX, targetY, 0)
    }
    if hoverMs > 0
        DllCall("Sleep", "UInt", Integer(hoverMs))
    if count > 0
        Click(targetX, targetY, button, Integer(count))
}

; @summary Executes a V10 Classical Deterministic block during playback.
; @tags macro, deterministic, playback, v10
V10_DetExecute(node, ctx) {
    t := node["type"]
    if t = "det_use_window"
        return V16_UseWindow(node, ctx)
    if t = "det_wait_window"
        return V31_WaitWindow(node, ctx)
    hwnd := V10_ResolveWindow(node, ctx)
    WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
    switch t {
        case "det_anchor_click":
            pt := V10_CalcAnchorPoint(ww, wh, node.Get("anchor", "BottomCenter"),
                node.Get("dx", 0), node.Get("dy", 0), node.Get("pctX", 50), node.Get("pctY", 50), wx, wy)
            shift := V8_CalcPixelShift(node, ctx)
            V10_HumanMoveAndClick(pt.ScreenX + shift.DX, pt.ScreenY + shift.DY, "MinimumJerk", 90,
                node.Get("hoverMs", 40), node.Get("button", "Left"), node.Get("count", 1))
        case "det_human_click":
            rawX := Number(ctx.Expand(node.Get("x", 0))), rawY := Number(ctx.Expand(node.Get("y", 0)))
            isWin := node.Get("coordRel", "Window") = "Window"
            sx := (isWin ? wx : 0) + Round(rawX), sy := (isWin ? wy : 0) + Round(rawY)
            shift := V8_CalcPixelShift(node, ctx)
            V10_HumanMoveAndClick(sx + shift.DX, sy + shift.DY, node.Get("profile", "MinimumJerk"),
                node.Get("durationMs", 180), node.Get("hoverMs", 65), node.Get("button", "Left"), node.Get("count", 1))
        case "det_predict_row":
            want := ctx.Expand(node.Get("wantItem", ""))
            allTxt := ctx.Expand(node.Get("allItems", ""))
            tickTxt := ctx.Expand(node.Get("tickedItems", ""))
            condTxt := ctx.Expand(node.Get("conditionalShiftItems", ""))
            pred := V10_PredictListRow(want, allTxt, tickTxt, node.Get("sortRule", "Partitioned_TickedFirst_AZ"),
                condTxt, node.Get("row1X", 175), node.Get("row1Y", 388), node.Get("rowHeight", 17))
            if node.Get("variable", "") != ""
                ctx.Vars[node["variable"]] := pred.Row
            if !pred.Found
                throw Error("Predicted row: item '" . want . "' is not in the candidate list.")
            maxVis := Integer(node.Get("maxVisibleRows", 6))
            method := node.Get("selectMethod", "CheckboxClick")
            if method = "CheckboxClick" {
                if maxVis > 0 && pred.Row > maxVis
                    throw Error("Predicted row #" . pred.Row . " for '" . want . "' is below the visible viewport (maxVisibleRows = " . maxVis . ").")
                V10_HumanMoveAndClick(wx + pred.ClickX, wy + pred.ClickY, "MinimumJerk", 80, 40, "Left", 1)
            } else if method = "KeyboardHomeDownSpace" {
                V10_HumanMoveAndClick(wx + pred.ClickX, wy + Integer(node.Get("row1Y", 388)), "Instant", 0, 30, "Left", 1)
                keys := pred.DownCount > 0 ? "{Home}{Down " . pred.DownCount . "}{Space}" : "{Home}{Space}"
                SendEvent(keys)
            }
        case "det_wait_settled":
            crc := V10_WaitRegionSettled(hwnd, node.Get("x1", 165), node.Get("y1", 95), node.Get("x2", 660), node.Get("y2", 190),
                node.Get("waitForChangeMs", 1500), node.Get("stableMs", 150), node.Get("timeoutMs", 10000), ctx)
            cmpVar := Trim(node.Get("compareVar", ""))
            if cmpVar != "" {
                prev := ctx.Vars.Get(cmpVar, "")
                ctx.Vars[cmpVar . "_unchanged"] := (prev != "" && prev = crc) ? 1 : 0
                ctx.Vars[cmpVar] := crc
            }
            if node.Get("variable", "") != ""
                ctx.Vars[node["variable"]] := crc
        case "det_wait_pixel":
            deadline := A_TickCount + Max(1, Integer(node.Get("timeoutMs", 15000)))
            wantAppear := V4_Bool(node.Get("appear", 1))
            loop {
                matched := V10_CheckPixelSentinel(node, ctx)
                if (wantAppear ? matched : !matched)
                    break
                if A_TickCount >= deadline
                    throw Error("Timed out waiting for pixel sentinel (" . node.Get("colorMode", "DiscernYellow") . ") at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ").")
                ctx.Sleep(50)
            }
        case "det_normalize_win":
            V17_NormalizeWindow(node, hwnd, ctx)
        case "det_citrix_fill":         ; V18: this line was missing in V17, so every Normalize step ALSO cleared the
            ; focused field (End, Shift+Home, Delete x2, 40 Backspaces) and pressed Tab, and a Citrix fill did nothing.
            fx := Integer(node.Get("x", 0)), fy := Integer(node.Get("y", 0))
            settle := Max(50, Integer(node.Get("settleMs", 250)))
            if fx > 0 || fy > 0 {
                V10_HumanMoveAndClick(wx + fx, wy + fy, "MinimumJerk", 70, 35, "Left", 1)
                ctx.Sleep(settle)
            }
            ; 3-stage Citrix-safe clear: twice End + Shift+Home + Delete, then End + Backspace sweep
            Loop 2 {
                SendEvent("{End}{Shift down}{Home}{Shift up}")
                ctx.Sleep(70)
                SendEvent("{Delete}")
                ctx.Sleep(100)
            }
            SendEvent("{End}{BS 40}")
            ctx.Sleep(90)
            val := ctx.Expand(node.Get("value", ""))
            if val != ""
                SendText(val)
            ctx.Sleep(120)
            if V4_Bool(node.Get("pressTab", 1))
                SendEvent("{Tab}")
    }
}

; @summary Step-debugger preview for V10 deterministic steps (shows the target ring and live pixel/CRC/row status).
; @tags macro, deterministic, debug, preview, v10
V10_DetPreview(node, runner) {
    t := node["type"]
    if t = "det_use_window" {
        want := Trim(runner.Expand(node.Get("target", "")))
        if want = ""
            return {Text: "Next steps go back to the Macro window: " . V4_Text(runner.Settings.Get("defaultTarget", "(active window)")), Ok: true}
        return {Text: "Next steps will use " . want . (WinExist(want) ? " (open now)." : " (not open yet - will wait " . node.Get("waitSec", 10) . " s)."), Ok: true}
    }
    if t = "det_wait_window"
        return {Text: "Will wait until " . V31_WaitText(node) . (V31_WindowOpen(runner.Expand(node.Get("target", ""))) ? " (a window like that is open now)." : " (no window like that is open now)."), Ok: true}
    try {
        hwnd := V10_ResolveWindow(node, runner)
        WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
        switch t {
            case "det_anchor_click":
                pt := V10_CalcAnchorPoint(ww, wh, node.Get("anchor", "BottomCenter"),
                    node.Get("dx", 0), node.Get("dy", 0), node.Get("pctX", 50), node.Get("pctY", 50), wx, wy)
                return {Text: "Will click anchor " . node.Get("anchor", "BottomCenter") . " -> screen (" . pt.ScreenX . ", " . pt.ScreenY . "), win (" . pt.WinX . ", " . pt.WinY . ").", Ok: true, X: pt.ScreenX, Y: pt.ScreenY}
            case "det_human_click":
                rx := Round(Number(runner.Expand(node.Get("x", 0)))), ry := Round(Number(runner.Expand(node.Get("y", 0))))
                sx := (node.Get("coordRel", "Window") = "Window" ? wx : 0) + rx
                sy := (node.Get("coordRel", "Window") = "Window" ? wy : 0) + ry
                return {Text: "Will move via " . node.Get("profile", "MinimumJerk") . " (" . node.Get("durationMs", 180) . " ms + " . node.Get("hoverMs", 65) . " ms dwell) to (" . sx . ", " . sy . ").", Ok: true, X: sx, Y: sy}
            case "det_predict_row":
                want := runner.Expand(node.Get("wantItem", ""))
                pred := V10_PredictListRow(want, runner.Expand(node.Get("allItems", "")), runner.Expand(node.Get("tickedItems", "")),
                    node.Get("sortRule", "Partitioned_TickedFirst_AZ"), runner.Expand(node.Get("conditionalShiftItems", "")),
                    node.Get("row1X", 175), node.Get("row1Y", 388), node.Get("rowHeight", 17))
                if !pred.Found
                    return {Text: "Predicted row: '" . want . "' NOT found in candidate list.", Ok: false}
                return {Text: "Predicted '" . want . "' at Row #" . pred.Row . " -> win (" . pred.ClickX . ", " . pred.ClickY . ").", Ok: true, X: wx + pred.ClickX, Y: wy + pred.ClickY}
            case "det_wait_settled":
                crc := V10_RegionCRC(hwnd, node.Get("x1", 165), node.Get("y1", 95), node.Get("x2", 660), node.Get("y2", 190))
                return {Text: "Region [" . node.Get("x1", 165) . "," . node.Get("y1", 95) . ".." . node.Get("x2", 660) . "," . node.Get("y2", 190) . "] live CRC32 = " . crc . " (waits until settled " . node.Get("stableMs", 150) . " ms).", Ok: true, X: wx + node.Get("x1", 165), Y: wy + node.Get("y1", 95)}
            case "det_wait_pixel":
                matched := V10_CheckPixelSentinel(node, runner)
                return {Text: "Pixel (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") sentinel " . node.Get("colorMode", "DiscernYellow") . " is currently " . (matched ? "MATCHED" : "not matched") . ".", Ok: true, X: wx + node.Get("x", 0), Y: wy + node.Get("y", 0)}
            case "det_normalize_win":
                if V4_Bool(node.Get("maximize", 0))
                    return {Text: "Will maximize the window (currently " . ww . "x" . wh . ").", Ok: true}
                return {Text: "Will normalize window (currently " . ww . "x" . wh . ") to canonical " . node.Get("width", 693) . "x" . node.Get("height", 803)
                    . (V17_IsResizable(WinGetStyle("ahk_id " . hwnd)) ? "." : " (fixed-size: it will only be moved)."), Ok: true}
            case "det_citrix_fill":
                return {Text: "Will Citrix-safe clear (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") and type: " . V5_Short(runner.Expand(node.Get("value", "")), 50), Ok: true, X: wx + node.Get("x", 0), Y: wy + node.Get("y", 0)}
        }
    } catch as err {
        return {Text: err.Message, Ok: false}
    }
    return {Text: VMF_BlockName(t), Ok: true}
}

; @summary 1-click screen measurement inside any V10 deterministic block editor dialog.
; @tags macro, deterministic, measure, gui, v10
V10_MeasureIntoDialog(kind, controls, dlg) {
    dlg.Hide()
    V5_HideOverlays()
    try {
        if kind = "det_wait_settled" {
            p1 := VM_UiPickPoint("🧭 Region Corner 1: Point at TOP-LEFT of the list/region and press F6 (Esc cancels).")
            if !p1
                return
            SoundBeep(750, 80)
            Sleep(180)
            p2 := VM_UiPickPoint("🧭 Region Corner 2: Point at BOTTOM-RIGHT of the list/region and press F6 (Esc cancels).")
            if !p2
                return
            SoundBeep(950, 80)
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
            controls["x1"].Value := Min(p1.X, p2.X) - wx
            controls["y1"].Value := Min(p1.Y, p2.Y) - wy
            controls["x2"].Value := Max(p1.X, p2.X) - wx
            controls["y2"].Value := Max(p1.Y, p2.Y) - wy
            return
        }
        if kind = "det_predict_row" {
            m := V8_MeasureTwoPointsOnScreen()
            if !m
                return
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
            controls["row1X"].Value := m.X1 - wx
            controls["row1Y"].Value := m.Y1 - wy
            controls["rowHeight"].Value := Max(1, Abs(m.DY))
            return
        }
        pt := VM_UiPickPoint("🧭 Point at the target control/pixel on screen and press F6 (Esc cancels).")
        if !pt
            return
        SoundBeep(850, 80)
        CoordMode("Mouse", "Screen")
        CoordMode("Pixel", "Screen")
        MouseGetPos(, , &hwnd)
        WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
        rx := pt.X - wx, ry := pt.Y - wy
        col := PixelGetColor(pt.X, pt.Y)
        hex := Format("{:06X}", col & 0xFFFFFF)
        if controls.Has("x")
            controls["x"].Value := rx
        if controls.Has("y")
            controls["y"].Value := ry
        if controls.Has("colorHex")
            controls["colorHex"].Value := hex
        if controls.Has("width") && controls.Has("height") {
            controls["width"].Value := ww
            controls["height"].Value := wh
        }
        if kind = "det_anchor_click" {
            anc := ["TopLeft", "BottomCenter", "TopRight", "BottomRight", "BottomLeft", "Center", "ProportionalPct"][Max(1, controls["anchor"].Value)]
            switch anc {
                case "BottomCenter":
                    controls["dx"].Value := rx - (ww // 2), controls["dy"].Value := ry - wh
                case "TopRight":
                    controls["dx"].Value := rx - ww, controls["dy"].Value := ry
                case "BottomRight":
                    controls["dx"].Value := rx - ww, controls["dy"].Value := ry - wh
                case "BottomLeft":
                    controls["dx"].Value := rx, controls["dy"].Value := ry - wh
                case "Center":
                    controls["dx"].Value := rx - (ww // 2), controls["dy"].Value := ry - (wh // 2)
                case "ProportionalPct":
                    controls["pctX"].Value := Round((rx / Max(1.0, ww)) * 100)
                    controls["pctY"].Value := Round((ry / Max(1.0, wh)) * 100)
                    controls["dx"].Value := 0, controls["dy"].Value := 0
                default:
                    controls["dx"].Value := rx, controls["dy"].Value := ry
            }
        }
    } finally {
        V5_RestoreOverlays()
        dlg.Show()
    }
}

; @summary Opens the V10 "🧭 Deterministic Inspector & Layout Physics Lab" (Ctrl+Shift+D or toolbar "🧭 Lab...").
;          Lets you inspect live window geometry anchors, pixel sentinels, region CRC32 hashes, and test list row prediction!
; @tags macro, deterministic, lab, inspector, gui, v10
V10_ShowDeterministicLab(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    V7_ShowMainGui()
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "🧭 V10 Deterministic Inspector & Layout Physics Lab (No OCR / No Image Search)")
    dlg.SetFont("s10 bold", "Segoe UI")
    dlg.AddText("xm ym w780 c0A84FF", "🧭 Classical Non-OCR / Non-Image Automation Lab — Measure Geometry, Pixel Sentinels, CRC32 & List Physics")
    dlg.SetFont("s9 norm", "Segoe UI")
    dlg.AddText("xm y+4 w780 c505050", "Why controls move & how to replicate human accuracy without OCR: anchor offsets, 1-pixel state sentinels, GDI BitBlt CRC32 settle waits, and list sort math.")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w780", "1. Live Screen Probe (Point + F6 on any window, button, or listbox row):")
    dlg.SetFont("s9 norm", "Segoe UI")
    btnProbePt := dlg.AddButton("xm y+6 w230 h28", "🎯 Probe Point / Anchor / Pixel (F6)")
    btnProbeRect := dlg.AddButton("x+8 yp w240 h28", "🔲 Probe Region CRC32 Hash (F6 x2)")
    btnProbeStride := dlg.AddButton("x+8 yp w250 h28", "📏 Probe List Row 1 -> Row 2 Stride (F6 x2)")

    edProbe := dlg.AddEdit("xm y+8 w780 r7 ReadOnly FontConsolas BackgroundF5F7FA",
        "Click one of the Probe buttons above to measure any live window on screen:`r`n"
        . "  • Window Geometry Anchors: Top-Left (rx, ry), Bottom-Center (dx, dy), Top-Right (dx, dy), and Proportional (%)`r`n"
        . "  • Pixel Sentinel: Exact 0xRRGGBB hex + semantic classifier (DiscernYellow, CernerDoorBlue, HighlightBlue, DisabledGrey)`r`n"
        . "  • Region CRC32: Hardware ntdll\RtlComputeCrc32 hash of any list/form rectangle`r`n"
        . "  • Row Stride: Exact row1Y and pixel height between Row 1 and Row 2")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w780", "2. Layout Physics & Partitioned List Row Predictor (Test why a dropdown/listbox item is in its position):")
    dlg.SetFont("s9 norm", "Segoe UI")
    dlg.AddText("xm y+6", "Target item:")
    edWant := dlg.AddEdit("x+6 yp-3 w200", "541-INP-MAIN")
    dlg.AddText("x+12 yp+3", "Sort rule:")
    ddSort := dlg.AddDropDownList("x+6 yp-3 w220", ["Partitioned_TickedFirst_AZ", "Alphabetical_AZ", "ExactGivenOrder"])
    ddSort.Value := 1
    dlg.AddText("x+12 yp+3", "Row1 Y:")
    edR1Y := dlg.AddEdit("x+4 yp-3 w50 Number", "388")
    dlg.AddText("x+8 yp+3", "Stride H:")
    edRH := dlg.AddEdit("x+4 yp-3 w45 Number", "17")

    dlg.AddText("xm y+8 w250", "All candidate items (comma/newline):")
    dlg.AddText("x+14 yp w250", "Currently Ticked items (sorted A-Z first):")
    dlg.AddText("x+14 yp w250", "Conditional items (omitted if unticked):")
    edAll := dlg.AddEdit("xm y+4 w250 r4 +WantReturn", "541-INP-CARES`n541-INP-CLC`n541-INP-DOM`n541-INP-MAIN`n541-RX-CLINIC-IP")
    edTick := dlg.AddEdit("x+14 yp w250 r4 +WantReturn", "541-INP-MAIN`n541-INP-CLC")
    edCond := dlg.AddEdit("x+14 yp w250 r4 +WantReturn", "541-RX-CLINIC-IP")

    btnCalcRow := dlg.AddButton("xm y+8 w220 h26", "🧮 Calculate Predicted Row & Y")
    txtPredOut := dlg.AddText("x+12 yp+4 w540 c0A84FF", "Click 'Calculate' to see the exact predicted row order and click coordinate.")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w780", "3. 1-Click Insert into Current Macro:")
    dlg.SetFont("s9 norm", "Segoe UI")
    btnAddAnchor := dlg.AddButton("xm y+6 w185 h28", "+ Anchor-Relative Click...")
    btnAddCRC := dlg.AddButton("x+6 yp w185 h28", "+ Region CRC32 Settle...")
    btnAddPixel := dlg.AddButton("x+6 yp w185 h28", "+ Pixel Sentinel Wait...")
    btnAddPred := dlg.AddButton("x+6 yp w205 h28", "+ List Row Predictor Block...")

    btnClose := dlg.AddButton("xm y+12 w110 h28 Default", "Close")

    lastProbe := {Hwnd: 0, W: 693, H: 803, RX: 300, RY: 76, Hex: "FFFF80", X1: 165, Y1: 95, X2: 660, Y2: 190, RowH: 17}

    doProbePt(*) {
        dlg.Hide()
        V5_HideOverlays()
        try {
            pt := VM_UiPickPoint("🎯 Point at any UI control or sentinel pixel and press F6 (Esc cancels).")
            if !pt
                return
            SoundBeep(850, 80)
            CoordMode("Mouse", "Screen")
            CoordMode("Pixel", "Screen")
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
            wTitle := WinGetTitle("ahk_id " . hwnd), wExe := WinGetProcessName("ahk_id " . hwnd)
            rx := pt.X - wx, ry := pt.Y - wy
            col := PixelGetColor(pt.X, pt.Y)
            hex := Format("{:06X}", col & 0xFFFFFF)
            bc := V10_CalcAnchorPoint(ww, wh, "BottomCenter", rx - (ww // 2), ry - wh, 50, 50, wx, wy)
            tags := ""
            for mName in ["DiscernYellow", "CernerDoorBlue", "HighlightBlue", "DisabledGrey", "WhiteReady"]
                if V10_MatchColorSentinel(col, mName)
                    tags .= (tags = "" ? "" : ", ") . mName
            if tags = ""
                tags := "NearHex (" . hex . ")"
            lastProbe.Hwnd := hwnd, lastProbe.W := ww, lastProbe.H := wh, lastProbe.RX := rx, lastProbe.RY := ry, lastProbe.Hex := hex
            edProbe.Value := "Window:          " . wExe . "  |  " . wTitle . "   (Size: " . ww . " x " . wh . ")`r`n"
                . "Screen / Win XY: Screen (" . pt.X . ", " . pt.Y . ")   |   TopLeft Win-Relative: (" . rx . ", " . ry . ")`r`n"
                . "Anchor Offsets:  BottomCenter: dx=" . (rx - (ww // 2)) . ", dy=" . (ry - wh)
                . "   |   TopRight: dx=" . (rx - ww) . ", dy=" . ry
                . "   |   Proportional: " . Round(rx * 100.0 / Max(1, ww), 1) . "%, " . Round(ry * 100.0 / Max(1, wh), 1) . "%`r`n"
                . "Pixel Sentinel:  0x" . hex . "   ->   Matches semantic state: [ " . tags . " ]"
        } finally {
            V5_RestoreOverlays()
            dlg.Show()
        }
    }

    doProbeRect(*) {
        dlg.Hide()
        V5_HideOverlays()
        try {
            p1 := VM_UiPickPoint("🔲 Point at TOP-LEFT of the region to hash and press F6 (Esc cancels).")
            if !p1
                return
            SoundBeep(750, 80)
            Sleep(180)
            p2 := VM_UiPickPoint("🔲 Point at BOTTOM-RIGHT of the region to hash and press F6 (Esc cancels).")
            if !p2
                return
            SoundBeep(950, 80)
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
            x1 := Min(p1.X, p2.X) - wx, y1 := Min(p1.Y, p2.Y) - wy
            x2 := Max(p1.X, p2.X) - wx, y2 := Max(p1.Y, p2.Y) - wy
            crc := V10_RegionCRC(hwnd, x1, y1, x2, y2)
            lastProbe.X1 := x1, lastProbe.Y1 := y1, lastProbe.X2 := x2, lastProbe.Y2 := y2
            edProbe.Value := "Region CRC32:    " . crc . "   (computed via GDI BitBlt + ntdll\RtlComputeCrc32)`r`n"
                . "Window Rect:     x1=" . x1 . ", y1=" . y1 . ", x2=" . x2 . ", y2=" . y2 . "   (Size: " . (x2 - x1) . " x " . (y2 - y1) . " px)`r`n"
                . "Use in V10:      Insert a 'Wait for Region CRC32 Change & Settle' block with these exact coordinates!"
        } finally {
            V5_RestoreOverlays()
            dlg.Show()
        }
    }

    doProbeStride(*) {
        dlg.Hide()
        m := V8_MeasureTwoPointsOnScreen()
        dlg.Show()
        if !m
            return
        MouseGetPos(, , &hwnd)
        WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
        r1x := m.X1 - wx, r1y := m.Y1 - wy, rh := Max(1, Abs(m.DY))
        edR1Y.Value := r1y, edRH.Value := rh
        lastProbe.RX := r1x, lastProbe.RY := r1y, lastProbe.RowH := rh
        edProbe.Value := "Measured List Geometry:`r`n"
            . "  • Row 1 Window Coordinate: x=" . r1x . ", y=" . r1y . "`r`n"
            . "  • Exact Row Stride (DY):   " . rh . " px per row   (Formula: clickY = " . r1y . " + (row - 1) * " . rh . ")`r`n"
            . "  • Copied Row1 Y (" . r1y . ") and Stride H (" . rh . ") into the Layout Physics predictor below!"
    }

    doCalcRow(*) {
        pred := V10_PredictListRow(edWant.Value, edAll.Value, edTick.Value, ddSort.Text, edCond.Value,
            lastProbe.RX, IsInteger(edR1Y.Value) ? Integer(edR1Y.Value) : 388, IsInteger(edRH.Value) ? Integer(edRH.Value) : 17)
        orderStr := V4_Join(pred.Order, " -> ")
        if pred.Found
            txtPredOut.Text := "✓ '" . edWant.Value . "' is at Row #" . pred.Row . " (Click win Y = " . pred.ClickY . ", or {Home}{Down " . pred.DownCount . "}{Space})  |  Order: " . orderStr
        else
            txtPredOut.Text := "✗ '" . edWant.Value . "' was not found in the active list.  |  Order: " . orderStr
    }

    btnProbePt.OnEvent("Click", doProbePt)
    btnProbeRect.OnEvent("Click", doProbeRect)
    btnProbeStride.OnEvent("Click", doProbeStride)
    btnCalcRow.OnEvent("Click", doCalcRow)
    btnAddAnchor.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_anchor_click")))
    btnAddCRC.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_wait_settled")))
    btnAddPixel.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_wait_pixel")))
    btnAddPred.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_predict_row")))
    btnClose.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    doCalcRow()
    dlg.Show()
}

; ============================================================================
; V13 STEP SETTINGS PANEL (beside the macro tree) + PLAIN-ENGLISH TREE LABELS
; ============================================================================

; @summary Builds the Step settings panel to the right of the macro tree; V13_InspLayout positions it on resize.
; @tags macro, gui, blocks, inspector, v13
V13_BuildInspector(g) {
    s := VMB()
    p := {Node: 0, Info: 0, Fields: [], Loaded: [], LoadedOn: 1, Slots: [], Busy: false, Width: 360, RowCount: 0,
        HasGeo: false}
    p.Box := g.AddGroupBox("x0 y0 w10 h10 Hidden", "Step settings")
    g.SetFont("s10 bold")
    p.Title := g.AddText("x0 y0 w10 h20 Hidden", "")
    g.SetFont("s9 norm")
    p.On := g.AddCheckbox("x0 y0 w10 h20 Hidden", "On  (untick = skipped when the macro plays)")
    p.Meaning := g.AddEdit("x0 y0 w10 h52 Hidden ReadOnly +Multi +VScroll -TabStop BackgroundF5F7FA", "")
    p.Empty := g.AddText("x0 y0 w10 h60 Hidden c606060", "")
    loop 16 {
        slot := {ChoiceKey: ""}
        slot.Label := g.AddText("x0 y0 w10 h20 Hidden Right", "")
        slot.Edit := g.AddEdit("x0 y0 w10 r1 -Multi Hidden", "")
        slot.DDL := g.AddDropDownList("x0 y0 w10 Hidden", [])
        slot.Check := g.AddCheckbox("x0 y0 w10 h22 Hidden", "")
        slot.Edit.OnEvent("LoseFocus", V13_InspCommit)
        slot.Edit.OnEvent("Focus", V13_InspFieldHint.Bind(A_Index))
        slot.DDL.OnEvent("Change", V13_InspCommit)
        slot.DDL.OnEvent("Focus", V13_InspFieldHint.Bind(A_Index))
        slot.Check.OnEvent("Click", V13_InspCommit)
        p.Slots.Push(slot)
    }
    p.Hint := g.AddText("x0 y0 w10 h32 Hidden c606060", "")
    p.BtnAll := g.AddButton("x0 y0 w10 h26 Hidden", "All settings...")
    p.BtnTest := g.AddButton("x0 y0 w10 h26 Hidden", "Test target")
    p.BtnLook := g.AddButton("x0 y0 w10 h26 Hidden", "Quick Look")
    p.Explain := g.AddCheckbox("x0 y0 w10 h20 Hidden", "Explain steps in the tree (meaning, wait, window, note)")
    p.Explain.Value := s.ShowMeaning
    p.Columns := g.AddCheckbox("x0 y0 w10 h20 Hidden", "Columns")         ; V22: step list in fixed columns
    p.Columns.Value := s.Columns
    p.Columns.OnEvent("Click", V22_ToggleColumns)
    p.On.OnEvent("Click", V13_InspCommit)
    p.BtnAll.OnEvent("Click", VMB_EditSelected)
    p.BtnTest.OnEvent("Click", VMB_TestSelected)
    p.BtnLook.OnEvent("Click", V7_QuickLook)
    p.Explain.OnEvent("Click", V13_ToggleExplain)
    s.Insp := p
}

; @summary Places the panel at x/y with width w and height h (the macro tree's height); rows that do not fit are hidden.
; @tags macro, gui, inspector, v13
V13_InspLayout(x, y, w, h) {
    p := VMB().Insp
    p.HasGeo := true
    ix := x + 10, iw := w - 20
    p.Box.Move(x, y - 8, w, h + 8)
    cy := y + 12
    p.Title.Move(ix, cy, iw, 20), cy += 22
    p.On.Move(ix, cy, iw, 20), cy += 23
    p.Meaning.Move(ix, cy, iw, 52), cy += 58
    p.Empty.Move(ix, cy, iw, 60)
    footTop := y + h - 94
    labW := 112, cx := ix + labW + 6, cw := iw - labW - 6
    p.RowCount := 0
    for i, slot in p.Slots {
        ry := cy + (i - 1) * 26
        slot.Label.Move(ix, ry + 4, labW, 20)
        slot.Edit.Move(cx, ry, cw)
        slot.DDL.Move(cx, ry, cw)
        slot.Check.Move(ix + 4, ry + 1, iw - 4, 22)
        if ry + 26 <= footTop
            p.RowCount := i
    }
    p.Hint.Move(ix, footTop + 2, iw, 32)
    p.BtnAll.Move(ix, footTop + 38, 106, 26)
    p.BtnTest.Move(ix + 112, footTop + 38, 90, 26)
    p.BtnLook.Move(ix + 208, footTop + 38, 90, 26)
    p.Explain.Move(ix, footTop + 68, iw - 84, 20)
    p.Columns.Move(ix + iw - 80, footTop + 68, 80, 20)
    V13_InspArrange()
}

; @summary Shows only the controls the loaded step needs (edit, drop-down or tick box per row).
; @tags macro, gui, inspector, v13
V13_InspArrange() {
    s := VMB(), p := s.Insp
    if !p || !p.HasGeo
        return
    show := s.InspShown
    for ctl in [p.Box, p.Title, p.Meaning, p.Hint, p.BtnAll, p.BtnTest, p.BtnLook, p.Explain, p.Columns]
        ctl.Visible := show
    p.On.Visible := show && p.Node && p.Info && p.Info.Kind = "node"
    p.Empty.Visible := show && !p.Fields.Length
    rows := show ? Min(p.Fields.Length, p.RowCount, p.Slots.Length) : 0
    for i, slot in p.Slots {
        ftype := i <= rows ? p.Fields[i].Type : ""
        slot.Label.Visible := ftype != "" && ftype != "check"
        slot.Edit.Visible := ftype != "" && ftype != "choice" && ftype != "check"
        slot.DDL.Visible := ftype = "choice"
        slot.Check.Visible := ftype = "check"
    }
    V13_InspHint("")
}

; @summary Hint line under the fields; "" shows the default tip (or how many rows did not fit).
; @tags macro, gui, inspector, v13
V13_InspHint(text, isError := false) {
    p := VMB().Insp
    if !p
        return
    if text = "" {
        more := p.Fields.Length - Min(p.Fields.Length, p.RowCount, p.Slots.Length)
        text := more > 0 ? "+" . more . " more setting(s) - make the window taller or press All settings..."
            : p.Fields.Length ? "Enter, Tab or clicking away applies a change.  Esc puts it back.  Ctrl+Z undoes." : ""
    }
    p.Hint.Opt(isError ? "cC00000" : "c606060")
    p.Hint.Text := text
}

V13_InspFieldHint(i, *) {
    p := VMB().Insp
    if p && i <= p.Fields.Length
        V13_InspHint(p.Fields[i].Short . ": " . p.Fields[i].Long)
}

; @summary Loads the selected step/block into the panel. commitFirst keeps anything typed for the previous step.
; @tags macro, gui, inspector, v13
V13_InspLoad(commitFirst := true) {
    s := VMB(), p := s.Insp
    if !p || p.Busy
        return
    if commitFirst
        V13_InspCommit()
    info := VMB_SelectedInfo()
    node := !info ? 0 : info.Kind = "node" ? info.Node : info.Kind = "elif" ? info.Elif : 0
    p.Node := node, p.Info := info
    p.Fields := node ? V13_InspFields(node) : []
    p.Loaded := []
    p.Busy := true
    try {
        for i, f in p.Fields {
            if i > p.Slots.Length
                break
            slot := p.Slots[i]
            val := node.Get(f.Key, f.Default)
            switch f.Type {
                case "choice":
                    slot.Label.Text := f.Short
                    key := V4_Join(f.Choices, "|")
                    if slot.ChoiceKey != key {
                        slot.DDL.Delete()
                        slot.DDL.Add(f.Choices)
                        slot.ChoiceKey := key
                    }
                    want := Max(1, VM__IndexOf(f.Vals, V4_Text(val)))
                    if slot.DDL.Value != want
                        slot.DDL.Value := want
                    p.Loaded.Push(want)
                case "check":
                    slot.Check.Text := f.Short
                    slot.Check.Value := V4_Bool(val) ? 1 : 0
                    p.Loaded.Push(slot.Check.Value)
                default:
                    slot.Label.Text := f.Short
                    text := V4_Text(val)
                    multi := InStr(text, "`n") > 0
                    slot.Edit.Opt(multi ? "+ReadOnly" : "-ReadOnly")
                    if multi
                        text := StrReplace(StrReplace(text, "`r"), "`n", " ⏎ ")
                    if !(slot.Edit.Value == text)       ; leave the caret alone when nothing changed
                        slot.Edit.Value := text
                    p.Loaded.Push(text)
            }
        }
        p.On.Value := node && !node.Get("disabled", 0) ? 1 : 0
        p.LoadedOn := p.On.Value
        V13_InspHeader()
    } finally
        p.Busy := false
    V13_InspArrange()
}

; @summary Panel title, plain-English description and empty-state text for the loaded line.
; @tags macro, gui, inspector, v13
V13_InspHeader() {
    s := VMB(), p := s.Insp
    node := p.Node, info := p.Info
    if node && info.Kind = "node"
        title := (VMF_IsStep(node) ? "#" . s.FlatIndex.Get(node, "?") . "   " : "") . VMF_BlockName(node.Get("type", ""))
    else if node
        title := "ELSE IF part"
    else if info && info.Kind = "else"
        title := "ELSE part"
    else
        title := info ? "Empty spot" : "No step selected"
    p.Title.Text := title
    p.Meaning.Value := V13_Explain(node, info)
    p.Empty.Text := !node ? (info ? "Drag, record or paste steps here." : "Click a step in the macro to see and change its settings here.")
        : "This block has no quick settings.  Press All settings... (or double-click it in the macro)."
}

; @summary Writes any changed panel values into the loaded step (one Undo step), then relabels it in the tree.
;          Bad values are refused, put back, and explained in red under the fields.
; @tags macro, gui, inspector, v13
V13_InspCommit(*) {
    s := VMB(), p := s.Insp
    if !p || p.Busy || !p.Node || !p.Info || VM_IsPlaying() || VM_IsRecording()
        return
    node := p.Node, owner := p.Info.Kind = "elif" ? p.Info.Node : node
    if !s.NodeItem.Has(owner)            ; the macro was replaced (undo, open...) since this was loaded
        return
    work := node.Clone(), changed := [], onNow := p.On.Value
    onChanged := p.Info.Kind = "node" && onNow != p.LoadedOn
    try {
        for i, f in p.Fields {
            if i > p.Loaded.Length
                break
            slot := p.Slots[i]
            cur := f.Type = "choice" ? slot.DDL.Value : f.Type = "check" ? slot.Check.Value : slot.Edit.Value
            if cur == p.Loaded[i]
                continue
            V13_InspSetField(work, f, cur)
            changed.Push([i, cur, f.Short])
        }
        if !changed.Length && !onChanged
            return
        if onChanged
            VM__SetOrDelete(work, "disabled", onNow ? "" : 1)
        V13_InspFinish(work, node, p.Fields)
    } catch as err {
        V13_InspLoad(false)
        V13_InspHint("⚠ " . err.Message . "  (old value put back)", true)
        return
    }
    hadNotes := s.LastNotes.Count       ; V21: VMB_Snapshot clears them, so the other rows' ⚠ must go too
    VMB_Snapshot()
    keys := Map()
    for k in work
        keys[k] := 1
    for k in node
        keys[k] := 1
    for k in keys {
        if work.Has(k)
            node[k] := work[k]
        else if node.Has(k)
            node.Delete(k)
    }
    s.Dirty := true
    for c in changed
        p.Loaded[c[1]] := c[2]
    p.LoadedOn := onNow
    names := ""
    for c in changed
        names .= (names = "" ? "" : ", ") . c[3]
    if onChanged
        names .= (names = "" ? "" : ", ") . (onNow ? "turned on" : "turned off")
    if onChanged || p.Info.Kind = "elif" || hadNotes {
        VMB_Refresh()                    ; recolours / relabels everything inside
    } else {
        s.AppShow := V21_AppRuns(VMF_Flatten(s.Macro["blocks"]))     ; V21: keep the "in <program>" marks up to date
        r := V22_FillApps(VMF_Flatten(s.Macro["blocks"]), s.Macro["settings"])     ; V22: and the Program column
        V24_MarkApps(r.App, s.OpenExes, VMF_Flatten(s.Macro["blocks"]))     ; V24: same "?" marks as the last refresh
        s.ColApp := r.App, s.ColStarts := r.Starts
        s.TV.Modify(s.NodeItem[owner], , VMB_NodeLabel(owner))
        V13_InspLoad(false)
    }
    VMB_UpdateTitle()
    VMB_SyncWinMatch()
    V7_RefreshQuickLookIfOpen()
    VMB_Status("Changed " . names . ".  Ctrl+Z undoes - Save to keep it.")
}

; @summary Converts one panel value into the step map (work); throws a plain-English error for bad input.
; @tags macro, inspector, validate, v13
V13_InspSetField(work, f, cur) {
    switch f.Type {
        case "choice":
            VM__SetOrDelete(work, f.Key, f.Vals[cur])
        case "check":
            if f.OffDeletes
                VM__SetOrDelete(work, f.Key, cur ? 1 : "")
            else
                work[f.Key] := cur ? 1 : 0
        case "number":
            v := Trim(cur)
            if v = "" {
                if !f.Blank
                    throw Error(f.Short . " needs a whole number.")
                if work.Has(f.Key)
                    work.Delete(f.Key)
                return
            }
            if !IsInteger(v)
                throw Error(f.Short . " must be a whole number.")
            v := Integer(v)
            if f.Min != "" && v < f.Min
                throw Error(f.Short . " must be " . f.Min . " or more.")
            work[f.Key] := v
        case "decimal":
            if !IsNumber(Trim(cur))
                throw Error(f.Short . " must be a number, for example 1 or -1.")
            work[f.Key] := Number(Trim(cur))
        case "numvar":
            v := Trim(cur)
            if !IsNumber(v) && !InStr(v, "{{")
                throw Error(f.Short . " must be a number or a {{variable}}.")
            work[f.Key] := IsNumber(v) ? Number(v) : v
        case "var":
            if !VMF_ValidVarName(Trim(cur))
                throw Error("Variable names use letters, digits and _ (start with a letter) and cannot be row, index,"
                    . " date, time or clipboard.")
            work[f.Key] := Trim(cur)
        case "path":
            if !FileExist(cur)
                throw Error("That macro file does not exist.")
            work[f.Key] := cur
        default:
            if f.Blank
                VM__SetOrDelete(work, f.Key, Trim(cur))
            else
                work[f.Key] := cur
    }
}

; @summary Side effects and block validation the full edit dialogs also apply (stale offsets, ask = no saved text).
; @tags macro, inspector, validate, v13
V13_InspFinish(work, orig, fields) {
    t := work.Get("type", ""), cond := work.Get("cond", "")
    if (t = "click" || t = "drag") && (work.Get("scrX", 0) != orig.Get("scrX", 0) || work.Get("scrY", 0) != orig.Get("scrY", 0))
        for key in ["rx", "ry", "geo"]
            if work.Has(key)
                work.Delete(key)
    if t = "text" && work.Get("ask", 0)
        work["text"] := ""
    if t = "for" && IsNumber(work.Get("step", 1)) && Number(work.Get("step", 1)) = 0
        throw Error("Step cannot be 0.")
    for f in fields
        if f.FromDefs && !work.Has(f.Key)
            work[f.Key] := f.Default
    isDet := cond = "pixel" || SubStr(t, 1, 4) = "det_"
    isWeb := cond = "web" || SubStr(t, 1, 4) = "web_"
    isInput := SubStr(t, 1, 6) = "input_"
    if (isWeb || isInput) && V4_Bool(work.Get("ask", 0)) && work.Has("value")
        work["value"] := ""
    if isDet
        V10_DetValidate(work)
    else if isInput
        V4_InputValidate(work)
    else if isWeb
        V4_WebValidate(work)
}

; @summary Quick-edit rows for a step or block: [{Key, Short, Type, Long, Choices, Vals, Default, Blank, Min, ...}].
;          Types: text, multiline, number, decimal, numvar, var, path, choice (Choices shown / Vals saved), check.
; @tags macro, inspector, v13
V13_InspFields(node) {
    out := []
    add(key, short, ftype := "text", long := "", extra := 0) {
        f := {Key: key, Short: short, Type: ftype, Long: long = "" ? short : long, Choices: [], Vals: [], Blank: false,
            Min: "", Default: "", OffDeletes: false, FromDefs: false}
        if IsObject(extra)
            for name, value in extra.OwnProps()
                f.%name% := value
        out.Push(f)
    }
    pick(key, short, long, choices, vals, default := "") {
        add(key, short, "choice", long, {Choices: choices, Vals: vals, Default: default})
    }
    t := node.Get("type", ""), cond := node.Get("cond", "")
    kind := cond = "web" ? "web_if" : cond = "pixel" ? "det_if_pixel" : t
    defs := V10_DetDefs().Has(kind) ? V10_DetDefs() : V4_InputDefs().Has(kind) ? V4_InputDefs()
        : V4_WebDefs().Has(kind) ? V4_WebDefs() : 0
    if defs {
        spec := defs[kind]
        for fd in spec.Fields {
            ftype := RegExMatch(fd[3], "^(choice|check|number|multiline)$") ? fd[3] : "text"
            add(fd[1], ftype = "check" ? V13_TrimLabel(fd[2], 46) : V13_ShortLabel(fd[1], fd[2]), ftype, fd[2],
                {Choices: fd.Length > 3 ? fd[4] : [], Vals: fd.Length > 3 ? fd[4] : [],
                Default: spec.Defaults.Get(fd[1], ""), FromDefs: true})
        }
    } else {
        ops := ["=", "!=", "<", ">", "<=", ">=", "contains", "empty", "notempty"]
        opText := ["equals (=)", "is not (!=)", "less than (<)", "more than (>)", "at most (<=)", "at least (>=)",
            "contains", "is empty", "is not empty"]
        switch t {
            case "click", "drag":
                pick("find", "Find by", "How the target is found when playing: the saved picture (follows moved windows)"
                    . " or the exact recorded screen spot.", ["picture", "coordinates (recorded spot)"], ["", "spot"])
                pick("button", "Button", "Mouse button.", ["Left", "Right", "Middle"], ["Left", "Right", "Middle"], "Left")
                if t = "click"
                    pick("count", "Clicks", "Single or double click.", ["single", "double"], [1, 2], 1)
                add("scrX", "Screen X", "number", "Recorded screen X - used for coordinates and as the fallback spot.",
                    {Default: 0})
                add("scrY", "Screen Y", "number", "Recorded screen Y - used for coordinates and as the fallback spot.",
                    {Default: 0})
                if t = "drag" {
                    add("dx", "Drag X (px)", "number", "How far to drag across (negative = left).", {Default: 0})
                    add("dy", "Drag Y (px)", "number", "How far to drag down (negative = up).", {Default: 0})
                }
                add("variation", "Picture variation", "number", "How different the picture may look, 0-255."
                    . " Blank = 60. Higher = more forgiving.", {Blank: true, Min: 0})
            case "text":
                add("text", "Text", "multiline", "Text to type; can use {{Column}}, {{variable}}, {{index}}, {{row}}, {{date}}.")
                add("ask", "Ask me for this text each run", "check", "Asks when the step runs instead of saving the text.",
                    {OffDeletes: true})
                add("prompt", "Ask prompt", "text", "Question shown when 'Ask me' is ticked.", {Blank: true})
            case "keys":
                add("keys", "Keys", "text", "AutoHotkey keys: {Enter} {Tab} {Down} ^a = Ctrl+A, !{F4} = Alt+F4,"
                    . " +{Tab} = Shift+Tab, {Tab 3} = Tab 3 times.")
            case "delay":
                add("ms", "Delay (ms)", "number", "How long to pause, in milliseconds (1000 = 1 second).",
                    {Min: 0, Default: 0})
            case "wait", "check":
                pick("appear", t = "wait" ? "Wait for" : "Check for", "Appear or go away.",
                    ["picture to appear", "picture to go away"], [1, 0], 1)
                add("timeoutMs", "Timeout (ms)", "number", "How long to keep looking. Blank = 10000 ms.",
                    {Blank: true, Min: 0})
                add("variation", "Picture variation", "number", "How different the picture may look, 0-255."
                    . " Blank = 60. Higher = more forgiving.", {Blank: true, Min: 0})
            case "wheel":
                pick("direction", "Direction", "Which way to scroll.", ["down", "up", "left", "right"],
                    ["WheelDown", "WheelUp", "WheelLeft", "WheelRight"], "WheelDown")
                add("count", "Notches", "number", "How many wheel notches.", {Min: 1, Default: 1})
            case "repeat":
                add("count", "Repeat times", "number", "How many times the steps inside run ({{index}} = the round).",
                    {Min: 1, Default: 1})
            case "for":
                add("name", "Variable", "var", "Counter name, used in steps as {{name}}.", {Default: "i"})
                add("from", "From", "numvar", "Start number (or a {{variable}}).", {Default: 1})
                add("to", "To", "numvar", "End number (or a {{variable}}).", {Default: 10})
                add("step", "Step", "numvar", "Count by this much (-1 counts down; cannot be 0).", {Default: 1})
            case "until", "if", "elif":
                if t = "until" {
                    pick("check", "Check", "When the condition is checked.",
                        ["before each round", "after each round (runs once at least)"], ["", "after"])
                    add("max", "At most (rounds)", "number", "The run stops after this many rounds.", {Min: 1, Default: 100})
                }
                if cond = "var" {
                    add("name", "Variable", "var", "Variable to test.")
                    pick("op", "Test", "How to compare.", opText, ops, "=")
                    add("value", "Value", "text", "A number, text or {{another variable / column}}.")
                } else {
                    pick("appear", "Image", "True when the image is on screen, or when it is not.",
                        ["is on screen", "is NOT on screen"], [1, 0], 1)
                    add("timeoutMs", "Look for (ms)", "number", "How long to look for the image. Blank = "
                        . VM_Config().CheckTimeoutMs . " ms.", {Blank: true, Min: 200})
                }
            case "set":
                add("name", "Variable", "var", "Variable name (letters, digits, _).")
                add("value", "Value", "text", "Number or text; can use {{clipboard}}, {{Column}}, {{index}}, {{other}}.")
                add("ask", "Ask me for the value when it runs", "check", "The value above becomes the default answer.",
                    {OffDeletes: true})
                add("prompt", "Ask prompt", "text", "Question to show (blank = 'Value for <name>:').", {Blank: true})
            case "change":
                add("name", "Variable", "var", "Variable to change.")
                add("by", "Change by", "decimal", "Number to add (use -1 to count down).", {Default: 1})
            case "ndc":
                add("name", "Variable", "var", "Variable that gets the 11-digit NDC (no dashes).", {Default: "ndc"})
                add("source", "Barcode from", "text", "Blank = ask the tech to scan. Or {{clipboard}}, {{Column}}, {{other}}.",
                    {Blank: true})
                add("prompt", "Scan prompt", "text", "Question to show (blank = 'Scan the NDC barcode now').", {Blank: true})
            case "ask":
                add("prompt", "Question", "text", "Shown with Continue / Skip this row / Stop.")
            case "stop":
                pick("action", "Does", "What this block does when it runs.",
                    ["exit the loop", "next round", "skip this data row", "end the run (done)", "stop the run"],
                    ["break", "continue", "nextrow", "endrun", "stop"], "break")
            case "call":
                add("path", "Macro file", "path", "Saved macro to run here (uses the current data row and variables).")
            case "pickdata":
                pick("format", "File type", "Data file type to ask for.", ["CSV / TSV", "Text list", "Excel", "Any supported"],
                    ["csv", "text", "excel", "any"], "csv")
                pick("header", "Header row", "Does the file have column names?",
                    ["detect automatically", "first row = column names", "no header row"], ["", "yes", "no"])
                add("columns", "Needs columns", "text", "Comma-separated columns the file must have.", {Blank: true})
                add("prompt", "Picker title", "text", "Title of the file picker (blank = default).", {Blank: true})
        }
    }
    if VMF_IsStep(node) {
        add("delayMs", "Wait before (ms)", "number", "Fixed pause before this step runs, in ms."
            . " Blank = automatic (Speed setting + recorded gap).", {Blank: true, Min: 0})
        if node.Get("win", "") is Map
            pick("winMatch", "Window", "Which window this step uses: the exact recorded one, any window of the same"
                . " program, or whatever is active.", ["exact window", "any window of program", "whatever is active"],
                ["", "program", "active"])
    }
    if t != "elif"
        add("note", "Note", "text", "Your own reminder - shown in the tree.", {Blank: true})
    return out
}

; @summary Short row label for a V4/V10 block field (the long label shows in the hint line on focus).
; @tags macro, inspector, v13
V13_ShortLabel(key, long) {
    static known := Map("target", "Window", "selector", "CSS selector", "frame", "Frame", "index", "Match #",
        "timeoutMs", "Timeout (ms)", "button", "Button", "count", "Clicks", "value", "Value", "prompt", "Ask prompt",
        "mode", "Method", "key", "Key", "variable", "Save in variable", "x", "X", "y", "Y", "dx", "Offset X",
        "dy", "Offset Y", "anchor", "Anchor", "hoverMs", "Hover (ms)", "url", "URL", "by", "Match by",
        "match", "Match text", "port", "Port", "browser", "Browser", "condition", "Condition", "attribute", "Attribute",
        "selectBy", "Select by", "path", "File", "delay", "Key delay (ms)", "duration", "Press time (ms)",
        "colorMode", "Color state", "colorHex", "Color hex", "tolerance", "Tolerance", "pctX", "Percent X",
        "pctY", "Percent Y", "durationMs", "Move time (ms)", "profile", "Motion", "coordRel", "Relative to",
        "x1", "Left X1", "y1", "Top Y1", "x2", "Right X2", "y2", "Bottom Y2", "waitForChangeMs", "Change wait (ms)",
        "stableMs", "Stable (ms)", "compareVar", "Compare var", "width", "Width", "height", "Height",
        "marginX", "Margin X", "marginY", "Margin Y", "wantItem", "Item", "allItems", "All items",
        "tickedItems", "Ticked items", "sortRule", "Sort rule", "conditionalShiftItems", "Shift items",
        "selectMethod", "Select method", "row1X", "Row 1 X", "row1Y", "Row 1 Y", "rowHeight", "Row height",
        "maxVisibleRows", "Visible rows", "settleMs", "Settle (ms)", "scope", "Target", "method", "CDP method",
        "params", "Params", "expression", "Expression")
    return known.Has(key) ? known[key] : V13_TrimLabel(long, 22)
}

V13_TrimLabel(text, maxLen) {
    text := RegExReplace(text, "\s*[(;:].*$")
    return StrLen(text) > maxLen ? SubStr(text, 1, maxLen - 1) . "…" : text
}

; @summary Plain-English meaning of an AutoHotkey Send string, e.g. "^{a}" -> "Ctrl+A: select all",
;          "{Tab 3}" -> "Tab ×3: next field", "ab{Enter}" -> 'types "ab", then Enter: OK / submit / new line'.
; @tags macro, keys, explain, v13
V13_KeysMeaning(keys) {
    static names := Map("esc", "Esc", "escape", "Esc", "bs", "Backspace", "backspace", "Backspace", "del", "Delete",
        "delete", "Delete", "ins", "Insert", "insert", "Insert", "enter", "Enter", "return", "Enter",
        "numpadenter", "Enter", "tab", "Tab", "space", "Space", "up", "Up", "down", "Down", "left", "Left",
        "right", "Right", "home", "Home", "end", "End", "pgup", "Page Up", "pageup", "Page Up", "pgdn", "Page Down",
        "pagedown", "Page Down", "appskey", "Menu key", "ctrl", "Ctrl", "control", "Ctrl", "lctrl", "Ctrl",
        "alt", "Alt", "lalt", "Alt", "shift", "Shift", "lshift", "Shift", "lwin", "Win", "rwin", "Win",
        "printscreen", "PrintScreen")
    static what := Map("Ctrl+A", "select all", "Ctrl+C", "copy", "Ctrl+V", "paste", "Ctrl+X", "cut", "Ctrl+Z", "undo",
        "Ctrl+Y", "redo", "Ctrl+S", "save", "Ctrl+F", "find", "Ctrl+P", "print", "Ctrl+N", "new", "Ctrl+O", "open",
        "Ctrl+W", "close tab", "Ctrl+T", "new tab", "Ctrl+Tab", "next tab", "Ctrl+Shift+Tab", "previous tab",
        "Ctrl+Home", "go to the top", "Ctrl+End", "go to the bottom", "Alt+Tab", "switch window",
        "Alt+F4", "close window", "Alt+Down", "open the drop-down list", "Shift+Tab", "previous field",
        "Tab", "next field", "Enter", "OK / submit / new line", "Esc", "cancel / close", "Backspace", "delete left",
        "Delete", "delete right", "Space", "tick box / press button", "Down", "next item / line",
        "Up", "previous item / line", "Left", "move left", "Right", "move right", "Home", "start of line",
        "End", "end of line", "Shift+Home", "select to start of line", "Shift+End", "select to end of line",
        "Ctrl+Shift+End", "select to the bottom", "Page Down", "page down", "Page Up", "page up", "F5", "refresh",
        "F2", "rename / edit", "Win+D", "show desktop", "Win+E", "File Explorer", "Win+R", "Run box",
        "Ctrl+Shift+Esc", "Task Manager", "Alt+Enter", "properties", "Shift+F10", "right-click menu",
        "Menu key", "right-click menu")
    static mods := [["^", "Ctrl+"], ["!", "Alt+"], ["+", "Shift+"], ["#", "Win+"]]
    out := [], plain := "", pos := 1
    while pos <= StrLen(keys) && RegExMatch(keys, "s)\G([\^!+#]*)(\{[^}]+\}|.)", &m, pos) {
        pos := m.Pos + m.Len
        tok := m[2]
        if m[1] = "" && StrLen(tok) = 1 {
            plain .= tok
            continue
        }
        if plain != ""
            out.Push('types "' . plain . '"'), plain := ""
        inner := tok, count := 1, action := ""
        if StrLen(tok) > 2 && SubStr(tok, 1, 1) = "{" {
            inner := Trim(SubStr(tok, 2, -1))
            if RegExMatch(inner, "i)^(.+?)\s+(down|up)$", &d)
                inner := d[1], action := StrLower(d[2])
            else if RegExMatch(inner, "^(.+?)\s+(\d+)$", &d)
                inner := d[1], count := Integer(d[2])
        }
        combo := ""
        for pair in mods
            if InStr(m[1], pair[1])
                combo .= pair[2]
        combo .= names.Get(StrLower(inner), StrLen(inner) = 1 ? StrUpper(inner) : inner)
        if action != "" {
            out.Push((action = "down" ? "hold " : "let go of ") . combo)
            continue
        }
        text := combo . (count > 1 ? " ×" . count : "")
        if what.Has(combo)
            text .= ": " . what[combo]
        else if RegExMatch(combo, "^Alt\+([A-Z0-9])$", &a)
            text .= ": app menu / shortcut letter " . a[1]
        out.Push(text)
    }
    if plain != ""
        out.Push('types "' . plain . '"')
    return V4_Join(out, ", then ")
}

V13_Ms(ms) {
    ms := IsNumber(ms) ? Number(ms) : 0
    return ms >= 1000 ? Round(ms / 1000, 2) . " s" : Round(ms) . " ms"
}

; @summary Short plain-English meaning of a step for the tree label ("" when the summary already says it).
; @tags macro, explain, gui, v13
V13_StepMeaning(node) {
    t := node.Get("type", "")
    switch t {
        case "keys":
            return V13_KeysMeaning(node.Get("keys", ""))
        case "click", "drag":
            btn := node.Get("button", "Left")
            geo := node.Get("geo", "")
            where := node.Get("find", "") != "spot" ? "on the saved picture"
                : geo is Map ? "at window spot (" . geo["cx"] . ", " . geo["cy"] . ") " . V14_AnchorText(geo)
                : "at screen spot (" . node.Get("scrX", 0) . ", " . node.Get("scrY", 0) . ")"
            if t = "drag"
                return StrLower(btn) . "-drag " . where . " by (" . node.Get("dx", 0) . ", " . node.Get("dy", 0) . ")"
            return (node.Get("count", 1) = 2 ? "double-click " : btn = "Left" ? "click " : StrLower(btn) . "-click ") . where
        case "text":
            if node.Get("ask", 0)
                return "asks you for the text each run, then types it"
            return InStr(node.Get("text", ""), "{{") ? "fills in {{...}} from data / variables" : ""
        case "delay":
            return "pause " . V13_Ms(node.Get("ms", 0))
        case "wait":
            return "wait " . (node.Has("timeoutMs") ? "up to " . V13_Ms(node["timeoutMs"]) . " " : "")
                . "for the picture to " . (V4_Bool(node.Get("appear", 1)) ? "appear" : "go away")
        case "check":
            return "check whether the picture is " . (V4_Bool(node.Get("appear", 1)) ? "on screen" : "gone")
        case "wheel":
            return "scroll " . StrLower(RegExReplace(node.Get("direction", "WheelDown"), "i)^Wheel")) . " ×" . node.Get("count", 1)
        case "input_send", "input_sendinput", "input_sendevent":
            return node.Get("ask", 0) ? "asks you each run, then sends it" : V13_KeysMeaning(node.Get("value", ""))
        case "input_sendtext":
            return node.Get("ask", 0) ? "asks you each run, then types it" : ""
        case "input_keydown":
            return "hold " . node.Get("key", "") . " down"
        case "input_keyup":
            return "let go of " . node.Get("key", "")
    }
    return ""
}

; @summary "from top-left" style text for a geo map's anchors.
; @tags macro, explain, coordinates, v14
V14_AnchorText(geo) {
    y := geo.Get("ay", "T") = "B" ? "bottom" : "top"
    switch geo.Get("ax", "L") {
        case "R": return "from " . y . "-right"
        case "P": return "from " . y . ", scaled across"
    }
    return "from " . y . "-left"
}

; @summary Tree badges after the window: fixed wait-before, loose window matching and the step's note.
; @tags macro, explain, gui, v13
V13_StepBadges(node) {
    out := ""
    if node.Has("delayMs")
        out .= "   ⏱ waits " . V13_Ms(node["delayMs"]) . " first"
    if node.Get("win", "") is Map {
        switch node.Get("winMatch", "") {
            case "program": out .= "   ◇ any window of program"
            case "active": out .= "   ◇ active window"
        }
    }
    if node.Get("note", "") != ""
        out .= "   // " . node["note"]
    return out
}

; @summary Palette description of a block kind ("" when unknown).
; @tags macro, explain, v13
V13_KindDesc(kind) {
    static descs := 0
    if !descs {
        descs := Map()
        for group in VMB_PaletteGroups()
            for item in group[2]
                descs[item[2]] := item[3]
    }
    return descs.Get(kind, "")
}

; @summary Multi-line plain-English description of a step or block for the panel.
; @tags macro, explain, gui, v13
V13_Explain(node, info := 0) {
    if !node
        return info && info.Kind = "else" ? "Runs the steps inside when none of the IF / ELSE IF conditions above are true." : ""
    lines := []
    t := node.Get("type", ""), cond := node.Get("cond", "")
    if node.Get("disabled", 0)
        lines.Push("(OFF - skipped when the macro plays)")
    if VMF_IsStep(node) {
        meaning := V13_StepMeaning(node), sum := VM_StepSummary(node)
        lines.Push("Does: " . VMF_BlockName(t) . (meaning != "" ? " - " . meaning : sum[3] != "" ? " - " . sum[3] : ""))
        if (desc := V13_KindDesc(t)) != ""
            lines.Push(desc)
        win := node.Get("win", "")
        if win is Map && VM_WindowLabel(win) != ""
            lines.Push("In: " . VM_WindowLabel(win) . "  (" . ["exact window", "any window of the program",
                "whatever window is active"][Max(1, VM__IndexOf(["", "program", "active"], node.Get("winMatch", "")))] . ")")
        lines.Push(node.Has("delayMs") ? "Waits " . V13_Ms(node["delayMs"]) . " before it runs."
            : "Wait before: automatic (Speed setting; recorded gap " . V13_Ms(node.Get("gapMs", 0)) . ").")
        if (badge := V8_VarySummaryBadge(node)) != ""
            lines.Push(badge)
        if node.Get("note", "") != ""
            lines.Push("Note: " . node["note"])
    } else {
        lines.Push(t = "elif" ? "ELSE IF " . VMF__CondText(node) : VMF_BlockText(node))
        if VMF_IsContainer(node) || t = "elif"
            lines.Push("Contains " . VMF_CountSteps(VMF_Children(node)[1]) . " line(s).")
        if t = "elif"
            lines.Push("Runs its steps when this is true and the IF / ELSE IF parts above were not.")
        else if (desc := V13_KindDesc(cond = "web" ? "web_if" : cond = "pixel" ? "det_if_pixel" : t)) != ""
            lines.Push(desc)
    }
    return V4_Join(lines, "`r`n")
}

; @summary "Settings panel" button: shows or hides the panel (remembered).
; @tags macro, gui, inspector, v13
V13_ToggleInspector(*) {
    s := VMB()
    s.InspShown := !s.InspShown
    IniWrite(s.InspShown, s.Ini, "V13", "ShowSettingsPanel")
    s.Ctl["InspToggle"].Text := s.InspShown ? "Settings panel ◂" : "Settings panel ▸"
    s.Gui.GetClientPos(, , &w, &h)
    VMB_OnSize(s.Gui, 0, w, h)
    if s.InspShown
        V13_InspLoad()
}

; @summary "Explain steps in the tree" tick box: plain-English meanings and badges on/off (remembered).
; @tags macro, gui, explain, v13
V13_ToggleExplain(ctl, *) {
    s := VMB()
    s.ShowMeaning := ctl.Value
    IniWrite(ctl.Value, s.Ini, "V13", "ExplainSteps")
    VMB_Refresh()
}

; @summary True while a text box in the Step settings panel has the keyboard focus (Enter applies, Esc puts back).
; @tags macro, gui, hotkey, v13
V13_InspFocused(*) {
    s := VMB(), p := s.Insp
    if !p || !s.Gui || !s.InspShown || VM_IsPlaying() || VM_IsRecording() || !WinActive("ahk_id " . s.Gui.Hwnd)
        return false
    focus := DllCall("GetFocus", "Ptr")
    for slot in p.Slots
        if focus = slot.Edit.Hwnd
            return true
    return false
}

; ============================================================================
; NDC FROM BARCODE SCAN (FDA NDC Directory lookup, kept as a local file so it works offline)
; ============================================================================

; @summary Local FDA NDC package list: a header line, then one dashed NDC per line.
; @tags ndc, pharmacy, barcode
NDC_ListPath() => A_MyDocuments . "\VisualMacros\fda-ndc-packages.txt"

; @summary 10-digit NDC -> dashed FDA code(s) ("a|b" if more than one), loaded once from NDC_ListPath().
;          reload = read the file again; override = use this Map instead (self-test).
; @tags ndc, pharmacy, barcode
NDC_List(reload := false, override := 0) {
    static list := 0
    if IsObject(override)
        return list := override
    if list && !reload
        return list
    list := Map()
    if !FileExist(NDC_ListPath())
        return list
    loop parse FileRead(NDC_ListPath(), "UTF-8"), "`n", "`r" {
        if A_LoopField = "" || SubStr(A_LoopField, 1, 1) = "#"
            continue
        key := StrReplace(A_LoopField, "-")
        list[key] := list.Has(key) ? list[key] . "|" . A_LoopField : A_LoopField
    }
    return list
}

; @summary One-line status of the local FDA list (count and download date, or not downloaded).
; @tags ndc, pharmacy
NDC_ListStatus() {
    path := NDC_ListPath()
    if !FileExist(path)
        return "FDA NDC list: not downloaded yet (" . path . ")."
    loop read path
        return "FDA NDC list: " . (SubStr(A_LoopReadLine, 1, 1) = "#" ? LTrim(A_LoopReadLine, "# ")
            : "saved " . FormatTime(FileGetTime(path), "yyyy-MM-dd")) . "."
    return "FDA NDC list: empty."
}

; @summary Downloads the FDA NDC Directory (text zip + excluded-drugs zip), keeps only the dashed package NDCs and
;          writes them to NDC_ListPath(). Returns the number of NDCs saved.
; @tags ndc, pharmacy, download
NDC_DownloadList() {
    tmp := A_Temp . "\vmb-ndc-" . A_TickCount
    DirCreate(tmp)
    codes := Map()
    try {
        for i, url in ["https://www.accessdata.fda.gov/cder/ndctext.zip", "https://www.accessdata.fda.gov/cder/ndc_excluded.zip"] {
            zip := tmp . "\" . i . ".zip", dir := tmp . "\" . i
            try {
                NDC__Fetch(url, zip)
            } catch as err {
                if i = 1
                    throw Error("Could not download the FDA NDC list (" . url . "): " . err.Message)
                continue    ; the excluded-drugs list only adds coverage
            }
            DirCreate(dir)
            if RunWait('tar.exe -xf "' . zip . '" -C "' . dir . '"', , "Hide") != 0
                throw Error("Could not unzip " . url)
            loop files dir . "\*.txt", "R"
                NDC__ReadPackages(A_LoopFileFullPath, codes)
        }
    } finally {
        try DirDelete(tmp, true)
    }
    if codes.Count < 1000
        throw Error("The FDA download did not contain the NDC package list.")
    out := "# " . codes.Count . " NDCs from the FDA NDC Directory, downloaded " . FormatTime(, "yyyy-MM-dd") . "`n"
    for code in codes
        out .= code . "`n"
    V4_Write(NDC_ListPath(), out)
    NDC_List(true)
    return codes.Count
}

; @summary Saves url to path. FDA's bot filter returns an HTML page to the default Download() client, so this sends
;          a browser User-Agent and checks that a zip came back.
; @tags ndc, download
NDC__Fetch(url, path) {
    req := ComObject("MSXML2.XMLHTTP.6.0")
    req.Open("GET", url, false)
    req.SetRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        . " (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0")
    req.Send()
    if req.Status != 200
        throw Error("HTTP " . req.Status)
    st := ComObject("ADODB.Stream")
    st.Type := 1
    st.Open()
    st.Write(req.ResponseBody)
    st.SaveToFile(path, 2)
    st.Close()
    f := FileOpen(path, "r", "CP0")
    head := f.Read(2)
    f.Close()
    if head != "PK"
        throw Error("fda.gov did not send a zip file (blocked or offline).")
}

; @summary Adds every valid dashed NDCPACKAGECODE in a tab-delimited FDA file to codes; other files are skipped.
; @tags ndc, pharmacy
NDC__ReadPackages(path, codes) {
    col := 0
    loop read path {
        cells := StrSplit(A_LoopReadLine, "`t")
        if !col {
            for j, name in cells
                if InStr(name, "NDCPACKAGECODE") {
                    col := j
                    break
                }
            if !col
                return
            continue
        }
        if cells.Length >= col && RegExMatch(Trim(cells[col], ' "'), "^(\d{4,5})-(\d{3,4})-(\d{1,2})$", &m)
            && StrLen(m[1] . m[2] . m[3]) = 10
            codes[m[0]] := 1
    }
}

; @summary Pads the three NDC parts to the 11-digit 5-4-2 form (no dashes).
; @tags ndc, pharmacy
NDC_Pad(labeler, product, package) => SubStr("0" . labeler, -5) . SubStr("0" . product, -4) . SubStr("0" . package, -2)

; @summary "0002-3227-30" -> "00002322730".
; @tags ndc, pharmacy
NDC_DashedTo11(code) {
    parts := StrSplit(code, "-")
    return NDC_Pad(parts[1], parts[2], parts[3])
}

; @summary The three possible dashed readings (4-4-2, 5-3-2, 5-4-1) of a 10-digit NDC.
; @tags ndc, pharmacy
NDC_Readings(d) => [SubStr(d, 1, 4) . "-" . SubStr(d, 5, 4) . "-" . SubStr(d, 9, 2),
    SubStr(d, 1, 5) . "-" . SubStr(d, 6, 3) . "-" . SubStr(d, 9, 2),
    SubStr(d, 1, 5) . "-" . SubStr(d, 6, 4) . "-" . SubStr(d, 10, 1)]

; @summary Reads a scan: dashed NDC, 11 digits, 10 digits, UPC-A (3 + NDC + check), GTIN-13/14 or a GS1 element
;          string ((01) + GTIN-14, then lot/expiry). Returns {D10, Ndc11}; Ndc11 is set when the layout is already known.
; @throws ValueError when it is not an NDC barcode
; @tags ndc, pharmacy, barcode
NDC_Parse(raw) {
    text := Trim(RegExReplace(raw, "[\x00-\x1F]", " "))
    text := RegExReplace(text, "^\][A-Za-z]\d")    ; symbology id such as ]d2 or ]C1
    if RegExMatch(text, "^(\d{4,5})-(\d{3,4})-(\d{1,2})$", &m) {
        d := m[1] . m[2] . m[3]
        if StrLen(d) = 10
            return {D10: d, Ndc11: NDC_Pad(m[1], m[2], m[3])}
        if StrLen(d) = 11 && StrLen(m[1]) = 5 && StrLen(m[2]) = 4
            return {D10: "", Ndc11: d}
    }
    digits := RegExReplace(text, "[\s-]")
    gtin := ""
    if RegExMatch(digits, "^\d{10,14}$") {
        switch StrLen(digits) {
            case 10: return {D10: digits, Ndc11: ""}
            case 11: return {D10: "", Ndc11: digits}
            case 12: gtin := "00" . digits
            case 13: gtin := "0" . digits
            case 14: gtin := digits
        }
    } else if RegExMatch(text, "^\(?01\)?\s*(\d{14})", &m) {
        gtin := m[1]
    }
    if gtin = ""
        throw ValueError("Not an NDC barcode: " . Trim(raw))
    if SubStr(gtin, 2, 2) != "03"     ; drug GTINs are (indicator) 0 3 + 10-digit NDC + check digit
        throw ValueError("This barcode is not a drug NDC: " . Trim(raw))
    return {D10: SubStr(gtin, 4, 10), Ndc11: ""}
}

; @summary Scan -> {Ndc11, Choices, Found}. Ndc11 is "" when the FDA list has no single match; Choices then holds
;          the dashed NDCs to pick from (the FDA matches, or the three possible readings).
; @tags ndc, pharmacy, barcode
NDC_Normalize(raw, list := 0) {
    p := NDC_Parse(raw)
    if p.Ndc11 != ""
        return {Ndc11: p.Ndc11, Choices: [], Found: true}
    list := IsObject(list) ? list : NDC_List()
    hits := list.Has(p.D10) ? StrSplit(list[p.D10], "|") : []
    if hits.Length = 1
        return {Ndc11: NDC_DashedTo11(hits[1]), Choices: hits, Found: true}
    return {Ndc11: "", Choices: hits.Length ? hits : NDC_Readings(p.D10), Found: hits.Length > 0}
}

; @summary Scan -> 11-digit NDC (no dashes). Offers the FDA download once if the list is missing and asks the tech
;          to pick when the list has no single match. Returns "" if cancelled; throws if it is not an NDC barcode.
; @tags ndc, pharmacy, barcode
NDC_FromScan(raw) {
    static offered := false
    if !offered && !NDC_List().Count {
        offered := true
        if MsgBox("The FDA NDC list is not on this PC yet. It shows which way to pad a scanned NDC to 11 digits."
            . "`n`nDownload it now from fda.gov (about 10-20 MB; after that it works offline)?", "NDC from scan",
            "YesNo Icon? 4096") = "Yes" {
            ToolTip("Downloading the FDA NDC list...")
            try NDC_DownloadList()
            catch as err
                MsgBox(err.Message, "FDA NDC list", "Icon! 4096")
            ToolTip()
        }
    }
    r := NDC_Normalize(raw)
    return r.Ndc11 != "" ? r.Ndc11 : NDC_Pick(raw, r)
}

; @summary Lets the tech pick the right NDC from r.Choices. Returns the 11-digit NDC or "" (cancel).
; @tags ndc, pharmacy, gui
NDC_Pick(raw, r) {
    why := r.Found ? "The FDA list has more than one NDC for this scan."
        : NDC_List().Count ? "This NDC is not in the FDA list." : "The FDA NDC list is not downloaded."
    dlg := Gui("+AlwaysOnTop -MinimizeBox", "Pick the NDC")
    dlg.SetFont("s10", "Segoe UI")
    dlg.AddText("w400", "Scanned: " . Trim(RegExReplace(raw, "[\x00-\x1F]", " ")) . "`n" . why
        . "`nCheck the label and pick the NDC that matches it:")
    state := {Value: ""}
    choose(value, *) {
        state.Value := value
        dlg.Destroy()
    }
    for code in r.Choices {
        layout := ""
        for part in StrSplit(code, "-")
            layout .= (layout = "" ? "" : "-") . StrLen(part)
        ndc := NDC_DashedTo11(code)
        dlg.AddButton("xm w400", code . "   (" . layout . ")   ->   " . ndc).OnEvent("Click", choose.Bind(ndc))
    }
    dlg.AddButton("xm w400", "Cancel (stop the macro)").OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    hwnd := dlg.Hwnd
    dlg.Show()
    WinWaitClose("ahk_id " . hwnd)
    return state.Value
}

; ============================================================================
; V17 EASY MODE, PICK WINDOW, NORMALIZE ON WINDOW SWITCH, SIZE NOTES
; Easy mode only hides and moves controls; every V16 feature, hotkey and file format is unchanged.
; ============================================================================

; @summary Easy / Full mode toggle (button, tray, Ctrl+Shift+E in the editor). Remembered in the ini.
; @tags macro, gui, easy, v17
V17_ToggleEasy(*) {
    s := VMB()
    if !s.Gui || VM_IsRecording() || VM_IsPlaying()
        return
    s.Easy := s.Easy ? 0 : 1
    IniWrite(s.Easy, s.Ini, "V17", "EasyMode")
    V17_ApplyMode()
    s.Gui.Show()
    VMB_Status(s.Easy ? "Easy mode. 'More features ▸' (Ctrl+Shift+E) shows everything again."
        : "Full mode: every feature is back. '◂ Easy mode' (Ctrl+Shift+E) hides the extras again.")
}

; @summary Every main-window control V17_ApplyMode moves or hides: s.Ctl by name, labels as "lbl:Name", Pal, TV.
; @tags macro, gui, easy, v17
V17_LayoutControls() {
    s := VMB(), all := Map()
    for name, ctl in s.Ctl
        all[name] := ctl
    for name, ctl in s.Lbl
        all["lbl:" . name] := ctl
    all["Pal"] := s.Pal, all["TV"] := s.TV
    return all
}

; @summary Shows the Easy or Full layout. Full positions are saved once at startup; Easy positions come from them.
;          Easy mode also hides the Step settings panel without changing its saved on/off choice.
; @tags macro, gui, easy, v17
V17_ApplyMode() {
    s := VMB(), g := s.Gui
    if !g || !s.Ctl.Has("EasyToggle")
        return
    all := V17_LayoutControls()
    if !(s.FullPos is Map) {
        s.FullPos := Map()
        for name, ctl in all {
            ctl.GetPos(&x, &y, &w, &h)
            s.FullPos[name] := [x, y, w, h]
        }
    }
    DllCall("SendMessage", "Ptr", g.Hwnd, "UInt", 0x000B, "Ptr", 0, "Ptr", 0)      ; WM_SETREDRAW off (no flicker)
    try {
        layout := s.Easy ? V17_EasyLayout(s.FullPos) : s.FullPos
        for name, ctl in all {
            if layout.Has(name) {
                p := layout[name]
                ctl.Move(p[1], p[2], p[3], p[4])
            }
            ctl.Visible := layout.Has(name) && (s.Easy || name != "WinInfo")
        }
        s.InspShown := s.Easy ? 0 : Integer(IniRead(s.Ini, "V13", "ShowSettingsPanel", 1))
        s.Ctl["EasyToggle"].Text := s.Easy ? "More features ▸" : "◂ Easy mode"
        g.Opt(s.Easy ? "+MinSize720x480" : "+MinSize1270x630")
        VMB_FillPalette(s.Ctl["Search"].Value)
        g.GetClientPos(, , &cw, &ch)
        if cw > 0 && ch > 0
            VMB_OnSize(g, 0, cw, ch)
    } finally {
        DllCall("SendMessage", "Ptr", g.Hwnd, "UInt", 0x000B, "Ptr", 1, "Ptr", 0)
        DllCall("RedrawWindow", "Ptr", g.Hwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x0485)     ; erase + all children + frame
    }
    V27_PlaceGrid()
    if !s.Easy && s.InspShown
        V13_InspLoad()
    V17_UpdateWinInfo()
    VMB_UpdateTitle()
}

; @summary Easy-mode positions worked out from the Full-mode ones (Map name -> [x, y, w, h]): row 1 = Record, Stop,
;          Play, Step by step, Pick window, More features, ?; row 2 = New, Open, Recent, Save, Save as + window info;
;          toolbox and macro moved up; bottom = Edit, Delete, Move up / down, Into / Out of block.
; @returns Map name -> [x, y, w, h] for the controls Easy mode shows (all others are hidden)
; @tags macro, gui, easy, v17
V17_EasyLayout(full) {
    out := Map()
    place(name, px, py, pw := "", ph := "") {
        q := full[name]
        out[name] := [px, py, pw = "" ? q[3] : pw, ph = "" ? q[4] : ph]
        return px + out[name][3]
    }
    xm := full["Record"][1], y1 := full["Record"][2], h1 := full["Record"][4]
    x := xm
    for name in ["Record", "Stop", "Play", "Step"]
        x := place(name, x, y1) + 6
    x := place("PickWin", x + 10, y1, 130, h1) + 16
    x := place("EasyToggle", x, y1, 130, h1) + 6
    place("Help", x, y1, 30, h1)
    y2 := full["New"][2]
    x := xm
    for name in ["New", "Open", "Recent", "Save", "SaveAs"]
        x := place(name, x, y2) + 6
    place("WinInfo", x + 14, y2 + 5, 760, 20)
    dy := full["lbl:HdrBlocks"][2] - (y2 + full["New"][4] + 14)
    for name in ["lbl:HdrBlocks", "lbl:HdrMacro", "Undo", "Redo", "Search", "Pal", "TV", "ColHead", "ViewList", "ViewGrid"] {
        q := full[name]
        out[name] := [q[1], q[2] - dy, q[3], q[4]]
    }
    yb := full["Edit"][2], x := xm
    for name in ["Edit", "Delete", "Up", "Down", "In", "Out"]
        x := place(name, x + (name = "Up" ? 5 : 0), yb) + 5
    return out
}

; @summary The 9-block Easy toolbox (same labels, kinds and descriptions as the full toolbox).
; @tags macro, gui, blocks, easy, v17
V17_EasyPaletteGroups() {
    static want := [["Window", ["det_normalize_win", "det_use_window"]],
        ["Actions", ["click", "text", "keys", "det_citrix_fill"]],
        ["Flow", ["delay", "repeat", "ask"]]]
    index := Map()
    for group in VMB_PaletteGroups()
        for item in group[2]
            index[item[2]] := item
    out := []
    for group in want {
        items := []
        for kind in group[2]
            if index.Has(kind)
                items.Push(index[kind])
        out.Push([group[1], items])
    }
    return out
}

; @summary Boxes an Easy-mode popup shows for a block kind (Map key -> label, "" = keep the normal label),
;          or "" when the kind has no short form (its popup shows everything).
; @tags macro, gui, blocks, easy, v17
V17_EasyFieldsFor(kind) {
    switch kind {
        case "det_normalize_win":
            return Map("width", "Window width in pixels  (📐 Pick window fills this in)", "height", "Window height in pixels")
        case "det_use_window":
            return Map("target", "Window to use from here on  (📐 Pick window fills this in)")
        case "det_citrix_fill":
            return Map("value", "Text to type (can use {{Column}})",
                "x", "Box spot X inside the window  (🧭 Measure fills this in)", "y", "Box spot Y inside the window")
        case "text":
            return Map("text", "", "ask", "", "prompt", "")
        case "keys":
            return Map("keys", "")
        case "delay":
            return Map("ms", "")
        case "click":
            return Map("button", "", "count", "")
        case "drag":
            return Map("button", "")
        case "wait", "check":
            return Map("timeoutMs", "", "appear", "")
        case "wheel":
            return Map("direction", "", "count", "")
    }
    return ""
}
V17_EasyFields(kind) => VMB().Easy ? V17_EasyFieldsFor(kind) : ""

; @summary Plain description for an Easy-mode popup (falls back to the block's normal description).
; @tags macro, gui, blocks, easy, v17
V17_EasyDesc(kind, fallback) {
    switch kind {
        case "det_normalize_win":
            return "Puts the window back to this exact size and spot, so every click lands in the same place."
                . " Click 📐 Pick window, then click the window's title bar. Fixed-size dialogs are only moved."
        case "det_use_window":
            return "From here on, steps use this window. It waits up to 10 seconds for the window to open,"
                . " then brings it to the front."
        case "det_citrix_fill":
            return "Clicks a box, clears it fully (safe over Citrix), types the text, then presses Tab."
    }
    return fallback
}

; @summary Easy-mode "?" help: the three-step flow in plain words.
; @tags macro, gui, help, easy, v17
V17_EasyHelp(*) {
    MsgBox("CELLS - THE EXCEL WAY"
        . "`nShift+arrows (or Shift+click) select a block of cells; the status bar adds them up. Ctrl+C copies, Ctrl+V pastes a block (or one value onto all selected cells),"
        . " Ctrl+D fills down, Ctrl+R fills right, Delete clears. One Ctrl+Z undoes a whole paste. # and Action stay in view when you scroll sideways."
        . "`n`nROWS - THE EXCEL WAY"
        . "`nClick a row: Alt+Up / Alt+Down move it, Shift+Delete deletes it, Ctrl+Shift+D duplicates it, Ctrl+Shift+plus adds a Type step below."
        . " Shift+Up / Shift+Down pick several rows. Click the arrow in a column title to pick which values to show. Ctrl+F finds text. Ctrl+Z undoes."
        . "`n`nRULES - THE EXCEL WAY"
        . "`nOnly when: type a rule such as  Status = On  to do a step only for some rows. Type  otherwise  on the next step for the"
        . " other rows. If it fails: choose what happens when a step cannot be done. Values: names you can type as =name (the Values tab: a fixed text,"
        . " ask at start, today's date, or a number that counts up); the Remember step keeps the clipboard or a text under a name."
        . "`n`nTO DO THE SAME THING FOR MANY ITEMS"
        . "`n1. Record it once for the first item.  2. Click the List tab and paste your items from Excel."
        . "`n3. Say Yes when asked to use the list columns.  4. Choose 'for each row of the List' and press Play."
        . "`n`nEASY MODE - RECORD, THEN PLAY"
        . "`n`n1. Open the program you want to automate. Click Record (Ctrl+Shift+R)."
        . "`n`n2. Do the task once, at a normal pace. The first program you click becomes the macro's window:"
        . "`n    step #1 puts it back to the same size and spot on every run. When you switch to another"
        . "`n    window, two steps are added: one finds that window, one sets its size."
        . "`n`n3. Click the red REC bar (bottom-left) or press Ctrl+Shift+R to stop."
        . "`n`n4. Click Play (F5). Use Step by step (F10) for the first test. Press Esc to stop."
        . "`n`nSTEADY PLAYBACK (always on for macros recorded here): each step waits for its window to be open"
        . "`nand in front, and each click waits until the screen at that spot looks like it did when you recorded."
        . "`nIf the screen never matches, the recorded spot is clicked and a note is shown at the end."
        . "`n`nFor the most repeatable result: start every run from the same screen of the program, don't touch"
        . "`nthe mouse or keyboard while it plays, and never type passwords while recording."
        . "`n📐 Pick window is only needed to choose a different window for an existing macro."
        . "`n`nTo change a step, double-click it. 'More options...' shows every setting."
        . "`nIf a window can't reach its saved size, the run keeps going and the status bar tells you."
        . "`nLists and pages are scrolled back to where they were when you recorded, before each click (standard"
        . "`nWindows lists and boxes only - not web pages, Citrix or Remote Desktop). For those, start each run from the"
        . "`nsame screen and scroll with the keyboard (Ctrl+Home, PgDn) while recording: key presses replay the same way every time."
        . "`n`nNEW IN V22 - THE STEP LIST IN COLUMNS"
        . "`n• Every step row has fixed columns:  #   Program   Waits   Marks   What it does. The Program column is filled on"
        . "  every row (a Wait step shows the program of the step before it)."
        . "`n• Waits = the pause before the step. A * after the time (500 ms*) = a wait you set by hand."
        . "`n• Marks: ► the task moves to another program here, ↕ the list is scrolled back first, ⚡ changes each round,"
        . "  ◇ uses whatever window is active, ✎ has your note, ⚠ had a note in the last run, ≈ often shaky (a note in 3 or more of"
        . "  the last 10 runs - check this step)."
        . "`n• Right-click the list -> Show columns (or the Columns tick box in the Step settings panel) for the V21 lines."
        . "`n`nNeed CSV rows, web pages, pictures or anything else? Click 'More features ▸' (Ctrl+Shift+E)."
        . "`n`nNEW IN V31: rules are columns, not blocks. Only when = do the step only for some rows (Status = On, Amount > 100, Name is empty,"
        . " Name contains Smith, # > 1, window Save As is open; join two with and / or). The next steps can say otherwise (or otherwise, Amount > 50)."
        . " Right-click an Only when cell to build a rule by picking. A step left out by its rule is not a failure; the grid greys it for the Preview row."
        . " If it fails = stop / skip this step / skip this row / try 3 times, per step. Right-click a row -> Add step: Type text, Press keys, Wait,"
        . " Wait until window, Skip this row, Stop the run. A list run now stops after 3 bad rows in a row. The Blocks toolbox is plain (black on white)"
        . " like the step list; right-click the list -> Coloured rows brings the colours back."
        . "`n`nNEW IN V30: do the same thing for many items, without loops. The Steps sheet is what to do once; the List sheet (tab under the grid) is the things to do it for."
        . "`n• Paste your items from Excel (Ctrl+V on the List sheet, or Paste list). Say Yes when asked to use the list columns: a Type step that typed Smith now types =Name, the Name column."
        . " You can also right-click a Type text cell -> Use list column, or type =Name in the cell (=# is the round number, '=x types a text that starts with =). =Name works on its own in a cell; inside longer text write {{Name}}."
        . "`n• Run: choose 'for each row of the List' (or 'N times') above the grid and press Play. 'Preview row' shows what each =Column cell will type. The Repeats column says which steps repeat; the first window steps are 'once at start'."
        . "`n• The status bar says how many rows were done or skipped; the List sheet's Result column shows each row. A row that fails is skipped and the run goes on."
        . "`n`nNEW IN V29: the grid works more like Excel. Ctrl + mouse wheel (or Ctrl + plus / minus, Ctrl + 0 for 100 %, or the - 100 % + at the"
        . " right end of the filter row) zooms the grid. A green frame shows the current cell: click a cell, or use the arrow keys, Home / End"
        . " (first / last column), Ctrl+Home / Ctrl+End, Tab / Shift+Tab. Ctrl+C copies the cell, Ctrl+V pastes into it, Ctrl+X cuts a Note or Waits"
        . " cell, Shift+Ctrl+C copies the whole row. Drag a column title to move the column; right-click a title to hide or show columns. All remembered."
        . "`n`nNEW IN V28: you can change a value right in the grid. Double-click a cell (or select a row, press Left / Right to pick the"
        . " column, then F2 or Enter, or just start typing). Enter saves and goes down, Tab saves and goes to the next cell you can change,"
        . " Esc cancels. Delete clears a Note or Waits cell, Ctrl+D copies the cell above. Ctrl+Z undoes a change."
        . " You can edit: Text / keys, Button, Clicks, Held keys, X, Y, Waits first, Scroll back, Window size, On and Note."
        . " The other cells are worked out; double-click them to open the full Edit box. A Waits value of 2 means 2 seconds (below 30 = seconds)."
        . "`n`nNEW IN V27: the [List] [Grid] buttons above the steps switch to a table with one row per step and every detail in its own"
        . " cell (program, window, size, action, spot, keys...). A dash (–) means it does not apply to that step. The grid is only a view: Edit,"
        . " Delete and the other buttons work on the selected row as before. Click a column title to sort (only the view changes, not the"
        . " run order); the filter box and the Program / Action lists above the grid show fewer rows; Copy table puts the grid on the clipboard for Excel."
        . "`n`nNEW IN V26: ? button > Check this PC (or right-click the list) runs a 20-second check and shows one result to copy."
        . "`nEmergency exit: Ctrl+Shift+X." . V22_ColumnCheckLine(VMB().IndentSeen), "Visual Macro Blocks V18 - Easy mode", "Iconi")
}

; @summary Waits for one left-click on another program's window and returns its top-level HWND
;          (0 = Esc, or the click was on this editor). Tell the user to click the title bar: the click reaches the app.
; @tags macro, window, pick, v17
V17_ClickWindow(prompt) {
    picked := 0
    ToolTip(prompt)
    try {
        KeyWait("LButton")
        loop {
            if GetKeyState("Esc", "P")
                break
            if GetKeyState("LButton", "P") {
                KeyWait("LButton")
                CoordMode("Mouse", "Screen")
                MouseGetPos(, , &picked)
                picked := picked ? DllCall("GetAncestor", "Ptr", picked, "UInt", 2, "Ptr") : 0    ; GA_ROOT
                try {
                    if picked && WinGetPID("ahk_id " . picked) = DllCall("GetCurrentProcessId")
                        picked := 0
                } catch
                    picked := 0
                break
            }
            Sleep(30)
        }
    } finally ToolTip()
    return picked
}

; @summary Size and spot of a window for a Normalize step. Margins are measured from the primary work area, the same
;          origin the Normalize step uses, so the window goes back to exactly this spot (any monitor).
; @returns {Exe, Cls, X, Y, W, H, MarginX, MarginY, Max, Resizable}
; @tags macro, window, normalize, v17
V17_WindowGeometry(hwnd) {
    id := "ahk_id " . hwnd
    WinGetPos(&wx, &wy, &ww, &wh, id)
    MonitorGetWorkArea(MonitorGetPrimary(), &left, &top)
    exe := ""
    try exe := WinGetProcessName(id)
    return {Exe: exe, Cls: WinGetClass(id), X: wx, Y: wy, W: ww, H: wh, MarginX: wx - left, MarginY: wy - top,
        Max: WinGetMinMax(id) = 1, Resizable: V17_IsResizable(WinGetStyle(id))}
}

; @summary Normalize-step values from V17_WindowGeometry.
; @tags macro, window, normalize, v17
V17_GeometryFields(geo) {
    return Map("width", geo.W, "height", geo.H, "marginX", geo.MarginX, "marginY", geo.MarginY,
        "maximize", geo.Max ? 1 : 0)
}

; @summary True when a window style has a sizing border (WS_THICKFRAME); fixed-size dialogs do not.
; @tags macro, window, normalize, v17
V17_IsResizable(style) => (style & 0x40000) != 0

; @summary Window selector for a program window: class + exe, or exe only when the class changes from run to run
;          (WPF HwndWrapper[...], WinForms, MFC Afx:, ATL:, or a long hex number in the class).
; @tags macro, window, v17
V17_WindowSelector(exe, cls) {
    if exe = ""
        return cls != "" ? "ahk_class " . cls : ""
    if cls = "" || RegExMatch(cls, "i)^(HwndWrapper\[|WindowsForms10\.|Afx:|ATL:)|[0-9A-F]{8,}")
        return "ahk_exe " . exe
    return "ahk_class " . cls . " ahk_exe " . exe
}

; @summary The Normalize step at the top of the macro that sets up the Macro window (blank target or this target).
;          create = insert a new one at the top when there is none.
; @returns the node, or 0
; @tags macro, window, normalize, v17
V17_TopNormalize(blocks, target, create := false) {
    if blocks.Length && blocks[1].Get("type", "") = "det_normalize_win" {
        t := Trim(blocks[1].Get("target", ""))
        if t = "" || t = target
            return blocks[1]
    }
    if !create
        return 0
    node := V4_CreateNode("det_normalize_win")
    blocks.InsertAt(1, node)
    return node
}

; @summary "800x600 at (20, 20)" or "maximized" for a Normalize step.
; @tags macro, window, normalize, v17
V17_NormText(node) {
    if V4_Bool(node.Get("maximize", 0))
        return "maximized"
    return node.Get("width", 693) . "x" . node.Get("height", 803) . " at (" . node.Get("marginX", 20) . ", " . node.Get("marginY", 20) . ")"
}

; @summary "📐 Pick window": click a program's title bar. It becomes the Macro window, and step #1 becomes (or is
;          updated to) a Normalize step with that window's current size and spot.
; @returns true when a window was picked
; @tags macro, window, normalize, gui, v17
V17_PickWindow(*) {
    s := VMB()
    if !s.Gui || VM_IsRecording() || VM_IsPlaying()
        return false
    s.Gui.Hide()
    picked := 0
    try picked := V17_ClickWindow("Click the TITLE BAR of the program this macro should use   (Esc = cancel)")
    finally s.Gui.Show()
    if !picked {
        VMB_Status("Pick window cancelled (Esc, or you clicked this editor).")
        return false
    }
    try geo := V17_WindowGeometry(picked)
    catch as err {
        VMB_Status("Could not read that window: " . err.Message)
        return false
    }
    target := V17_WindowSelector(geo.Exe, geo.Cls)
    if target = "" {
        VMB_Status("Could not read that window's program name. Try another window.")
        return false
    }
    VMB_Snapshot()
    s.Ctl["DefaultTarget"].Value := target
    VMB_ControlsToSettings()
    s.PinHwnd := picked
    norm := V17_TopNormalize(s.Macro["blocks"], target, true)
    for key, value in V17_GeometryFields(geo)
        norm[key] := value
    norm["target"] := ""
    s.Dirty := true
    VMB_Refresh(norm)
    V7_AutoSaveNow()
    VMB_Status("📐 Macro window: " . target . ".  Step #1 puts it back to " . V17_NormText(norm)
        . (geo.Resizable ? "" : " (fixed-size: it is only moved)") . " before each run.  Now press Record.")
    return true
}

; @summary Easy-mode line beside Save as: which window the macro uses and what step #1 sets it to.
; @tags macro, gui, window, easy, v17
V17_UpdateWinInfo() {
    s := VMB()
    if !s.Ctl.Has("WinInfo") || !(s.Macro is Map)
        return
    target := Trim(s.Macro["settings"].Get("defaultTarget", ""))
    norm := target != "" ? V17_TopNormalize(s.Macro["blocks"], target) : 0
    s.Ctl["WinInfo"].Value := target = "" ? (s.Macro["blocks"].Length ? "No window picked yet. Click 📐 Pick window."
        : "Just press Record - the first program you click becomes this macro's window.")
        : "Window: " . target . (norm ? "      Step #1 sets it to " . V17_NormText(norm) : "      (no Normalize step at the top)")
}

; @summary Runs a Normalize step: maximize, or restore + move + resize (fixed-size windows are only moved). A size that
;          is more than 4 px off is noted (status bar + playback log) and the run keeps going.
; @tags macro, window, normalize, playback, v17
V17_NormalizeWindow(node, hwnd, ctx) {
    id := "ahk_id " . hwnd
    if V4_Bool(node.Get("maximize", 0)) {
        if WinGetMinMax(id) != 1 {
            WinMaximize(id)
            ctx.Sleep(250)
        }
        return
    }
    if WinGetMinMax(id) != 0 {
        WinRestore(id)
        ctx.Sleep(150)
    }
    MonitorGetWorkArea(MonitorGetPrimary(), &left, &top)
    wantW := Integer(node.Get("width", 693)), wantH := Integer(node.Get("height", 803))
    mx := Integer(node.Get("marginX", 20)), my := Integer(node.Get("marginY", 20))
    resizable := V17_IsResizable(WinGetStyle(id))
    x := left + mx, y := top + my
    if V18_Steady(ctx) {                ; V21: keep the window on a screen that exists (a different monitor layout)
        rects := []
        Loop MonitorGetCount() {
            MonitorGet(A_Index, &monL, &monT, &monR, &monB)
            rects.Push([monL, monT, monR, monB])
        }
        if !V21_OnAnyScreen(x + 8, y + 8, rects) {
            V14_FitOnMonitor(&x, &y, wantW, wantH)
            V17_Warn(ctx, "Step #" . ctx.Index . ": the saved window spot is off this screen; moved the window onto the main screen.")
        }
    }
    try {
        if resizable
            WinMove(x, y, wantW, wantH, id)
        else
            WinMove(x, y, , , id)
    }
    if resizable                        ; V19: wait until the window has its size, instead of a fixed 250 ms pause
        V19_WaitSize(id, wantW, wantH, ctx)
    else                                ; fixed-size window: only wait until it stops moving
        V19_WaitSize(id, x, y, ctx, , true)
    ctx.Sleep(120)                      ; let the program re-draw its controls
    if !V4_Bool(node.Get("strictDpiCheck", 1))
        return
    WinGetPos(, , &actualW, &actualH, id)
    msg := V17_SizeNote(wantW, wantH, actualW, actualH, resizable)
    if msg != "" {
        exe := "window"
        try exe := WinGetProcessName(id)
        if ctx.HasOwnProp("Settings") && ctx.Settings.Get("sizeMismatch", "") = "stop"     ; V19: stop instead of a note
            throw Error("The window " . V19_MismatchText(msg) . " Fix the window, then retry this step.")
        V17_Warn(ctx, "Step #" . ctx.Index . " (" . exe . ") " . msg)
    }
}

; @summary Plain note when a window did not reach its saved size (more than 4 px off), with the likely reason; "" = fine.
; @tags macro, window, normalize, v17
V17_SizeNote(wantW, wantH, actualW, actualH, resizable) {
    if Abs(actualW - wantW) <= 4 && Abs(actualH - wantH) <= 4
        return ""
    why := !resizable ? "it is a fixed-size window"
        : actualW >= wantW - 4 && actualH >= wantH - 4 ? "it has a minimum size, or the display scaling is different"
        : actualW <= wantW + 4 && actualH <= wantH + 4 ? "it has a maximum size or does not fit the screen, or the display scaling is different"
        : "it has a size limit, or the display scaling is different"
    return "stayed " . actualW . "x" . actualH . " instead of " . wantW . "x" . wantH . " (" . why . "). Kept going."
}

; @summary A note that does not stop the run: kept on the runner (shown at the end), logged, and shown in the status bar.
; @tags macro, playback, log, v17
V17_Warn(ctx, msg) {
    if IsObject(ctx) && ctx.HasOwnProp("Warnings")
        ctx.Warnings.Push(msg)
    V17_Log("NOTE  " . msg)
    try VMB_Status("⚠ " . msg)
}

; @summary Writes a line to last-playback.log (fresh = start a new log). Does nothing when no log path is set.
; @tags macro, playback, log, v17
V17_Log(text, fresh := false) {
    path := VM_Config().LogPath
    if path = ""
        return
    line := FormatTime(, "yyyy-MM-dd HH:mm:ss") . "  " . text . "`r`n"
    try {
        if fresh
            V4_Write(path, line)
        else
            FileAppend(line, path, "UTF-8")
    }
}

; Recording: which window the last step went to, and which windows already got a Normalize step.
V17_RecWin() {
    static r := {On: false, Last: 0, Seen: Map(), MacroHwnd: 0, AutoPick: false, AutoTarget: "", AutoGeo: 0, Trial: []}
    return r
}

; @summary Recording starts: reads "Normalize new windows while recording" and treats the Macro window as already
;          set up (step #1 normalizes it).
; @tags macro, record, window, v17
V17_RecWinStart() {
    s := VMB(), r := V17_RecWin()
    r.On := s.Ctl.Has("AutoNorm") && s.Ctl["AutoNorm"].Value
    r.Seen := Map(), r.Last := 0, r.MacroHwnd := 0, r.Trial := []
    r.AutoPick := r.On && V18_CanAutoPick(), r.AutoTarget := "", r.AutoGeo := 0
    target := Trim(s.Macro["settings"].Get("defaultTarget", ""))
    if target != "" {
        try {
            if s.PinHwnd && WinExist(target . " ahk_id " . s.PinHwnd)
                r.MacroHwnd := s.PinHwnd
            else
                r.MacroHwnd := WinExist(target)
        }
    }
    if r.MacroHwnd
        r.Seen[r.MacroHwnd] := 1, r.Last := r.MacroHwnd
}

; @summary Called before each recorded click, key or typing: when it goes to a different real window, records
;          "Use Window From Here On" for it, plus "Normalize Window Geometry" (its current size and spot) the first time.
; @tags macro, record, window, normalize, v17
V17_RecNoteWindow(hwnd) {
    r := V17_RecWin()
    if !r.On || !hwnd
        return
    hwnd := DllCall("GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr")
    if !hwnd || hwnd = r.Last
        return
    info := V17_RealWindow(hwnd)
    if !info
        return
    if r.AutoPick && !r.MacroHwnd {     ; V18: the first real window used becomes the Macro window (no steps needed)
        target := V17_WindowSelector(info.Exe, info.Cls)
        try {
            if target != "" {
                r.AutoGeo := V17_WindowGeometry(hwnd)
                r.AutoTarget := target, r.MacroHwnd := hwnd, r.Seen[hwnd] := 1, r.Last := hwnd
                r.Trial.Push({Hwnd: hwnd, Node: 0})     ; V19: its Normalize step is made when recording stops
                return
            }
        }
    }
    isMacro := hwnd = r.MacroHwnd
    selector := isMacro ? "" : V17_WindowSelector(info.Exe, info.Cls)
    if !isMacro && selector = ""
        return
    geo := 0
    if !r.Seen.Has(hwnd)
        try geo := V17_WindowGeometry(hwnd)
    for node in V17_SwitchSteps(selector, geo) {
        V4_RecordAdd(node)
        if node.Get("type", "") = "det_normalize_win"      ; V19: its size is tested when recording stops
            r.Trial.Push({Hwnd: hwnd, Node: node})
    }
    r.Seen[hwnd] := 1
    r.Last := hwnd
}

; @summary Steps recorded when the task moves to another window. selector "" = back to the Macro window.
;          geo (V17_WindowGeometry) = the window is new, so a Normalize step with its size and spot is added too.
; @tags macro, record, window, normalize, v17
V17_SwitchSteps(selector, geo := 0) {
    use := V4_CreateNode("det_use_window")
    use["target"] := selector
    out := [use]
    if IsObject(geo) {
        norm := V4_CreateNode("det_normalize_win")
        for key, value in V17_GeometryFields(geo)
            norm[key] := value
        out.Push(norm)
    }
    return out
}

; @summary {Exe, Cls} for a real program window (title bar, not a tool window, not the taskbar / desktop / a menu /
;          a dropdown / this editor), else 0.
; @tags macro, record, window, v17
V17_RealWindow(hwnd) {
    id := "ahk_id " . hwnd
    try {
        if WinGetPID(id) = DllCall("GetCurrentProcessId")
            return 0
        cls := WinGetClass(id), style := WinGetStyle(id), exStyle := WinGetExStyle(id)
        exe := WinGetProcessName(id)
    } catch
        return 0
    return V17_IsRealWindow(cls, style, exStyle) ? {Exe: exe, Cls: cls} : 0
}

; @summary True for a class / style that is a real program window or dialog (has a title bar, is not a tool window,
;          and is not a shell, menu, tooltip or dropdown class).
; @tags macro, record, window, v17
V17_IsRealWindow(cls, style, exStyle) {
    static shell := "i)^(Shell_TrayWnd|Shell_SecondaryTrayWnd|Progman|WorkerW|#32768|tooltips_class32|ComboLBox"
        . "|NotifyIconOverflowWindow|TopLevelWindowForOverflowXamlIsland|Windows\.UI\.Core\.CoreWindow"
        . "|TaskListThumbnailWnd|XamlExplorerHostIslandWindow|MultitaskingViewFrame|ForegroundStaging|SysShadow"
        . "|Net UI Tool Window|DropDown)$"
    if RegExMatch(cls, shell)
        return false
    if (style & 0xC00000) != 0xC00000       ; WS_CAPTION
        return false
    return !(exStyle & 0x80)                ; WS_EX_TOOLWINDOW
}

; ============================================================================
; V18 ONE-CLICK RECORD + STEADY PLAYBACK
; Record: an empty macro picks its Macro window by itself (the first real window used), recorded steps are tidied
; (double-clicks, wheel runs) and clicks on this editor are ignored.
; Steady playback (macro setting "steady"): every step waits for its window, and every recorded click waits until
; the screen at its spot looks like the recording. Nothing here runs for a macro without the setting.
; Settings read (all optional): steady 0/1, windowWaitSec (10), verifyClicks 0/1 (1), verifyMs (1500).
; The picture check compares pixels itself (the same screen grab the recorder uses) instead of ImageSearch, and only
; ever looks at the recorded spot - it never sends a click somewhere else on the screen.
; ============================================================================

; @summary True when this run uses Steady playback.
; @tags macro, playback, steady, v18
V18_Steady(runner) {
    return IsObject(runner) && runner.HasOwnProp("Settings") && runner.Settings.Get("steady", 0) ? true : false
}

; @summary True when Record may pick the Macro window by itself: an empty macro with no Macro window yet, and
;          "Normalize new windows while recording" on.
; @tags macro, record, window, v18
V18_CanAutoPick() {
    s := VMB()
    if !(s.Macro is Map) || s.Macro["blocks"].Length || Trim(s.Macro["settings"].Get("defaultTarget", "")) != ""
        return false
    return s.Ctl.Has("AutoNorm") && s.Ctl["AutoNorm"].Value ? true : false
}

; @summary True when a window belongs to this script (editor, REC bar, run bar, HUD).
; @tags macro, record, window, v18
V18_OwnWindow(hwnd) {
    if !hwnd
        return false
    try return WinGetPID("ahk_id " . hwnd) = DllCall("GetCurrentProcessId")
    return false
}

; @summary True for a window class that is different on every run (WPF, WinForms, MFC, ATL, or a long hex number),
;          so it can't be used to find the window again.
; @tags macro, window, v18
V18_ClassChanges(cls) => RegExMatch(cls, "i)^(HwndWrapper\[|WindowsForms10\.|Afx:|ATL:)|[0-9A-F]{8,}") != 0

; @summary How long a Steady step waits for its window, in ms (setting windowWaitSec, default 10 s).
; @tags macro, playback, steady, v18
V18_WaitMs(runner) => Max(0, Number(runner.Settings.Get("windowWaitSec", 10))) * 1000

; @summary "1920x1080 @ 100%": the primary screen's size and scaling.
; @tags macro, record, v18
V18_ScreenText() => A_ScreenWidth . "x" . A_ScreenHeight . " @ " . Round(A_ScreenDPI / 96 * 100) . "%"

; @summary Steady playback start: notes when the screen size or scaling is not the one the macro was recorded on.
; @tags macro, playback, steady, v18
V18_ScreenCheck(runner) {
    if !V18_Steady(runner)
        return
    was := runner.Settings.Get("recScreen", ""), now := V18_ScreenText()
    if was != "" && was != now
        V17_Warn(runner, "Recorded on a " . was . " screen, playing on " . now
            . ". Clicks may land differently - record again on this screen if they do.")
}

; @summary Waits (up to 2.5 s) until Ctrl, Shift, Alt and Win are physically released.
; @tags macro, playback, v18
V18_WaitModsUp(timeoutMs := 2500) {
    deadline := A_TickCount + timeoutMs
    for key in ["Ctrl", "Shift", "Alt", "LWin", "RWin"]
        while GetKeyState(key, "P") && A_TickCount < deadline
            Sleep(15)
}

; @summary The open windows a recorded step could mean. Exact = the recorded window class is among them (or the
;          class changes from run to run, so any window of the program counts).
; @returns {List, Exact}
; @tags macro, playback, window, steady, v18
V18_Matches(win) {
    selector := "ahk_exe " . win["exe"]
    cls := win.Get("cls", "")
    if cls != "" && !V18_ClassChanges(cls) {
        list := WinGetList(selector . " ahk_class " . cls)
        return {List: list, Exact: list.Length > 0}
    }
    list := WinGetList(selector)
    return {List: list, Exact: list.Length > 0}
}

; @summary Picks one window from the matches: the recorded title when the step asks for it, else the active window
;          when it is one of them, else the front-most one.
; @tags macro, playback, window, steady, v18
V18_Choose(matches, node, win) {
    if node.Get("winMatch", "") != "program" && win.Get("title", "") != "" {
        wantTitle := win["title"]
        for id in matches
            if WinGetTitle("ahk_id " . id) = wantTitle
                return id
        for id in matches {
            curTitle := WinGetTitle("ahk_id " . id)
            if curTitle != "" && (InStr(curTitle, wantTitle) || InStr(wantTitle, curTitle))
                return id
        }
    }
    active := WinExist("A")
    return VM__IndexOf(matches, active) ? active : matches[1]
}

; @summary Steady playback's V4_Window: waits for the step's program and window kind to be open, brings it to the
;          front and returns it. Throws (so the run pauses / asks) when it never shows up.
; @tags macro, playback, window, steady, v18
V18_Window(node, runner) {
    if node.Get("winMatch", "") = "active"
        return WinExist("A")
    win := node.Get("win", "")
    if !(win is Map) || win.Get("exe", "") = ""
        return WinExist("A")
    waitMs := V18_WaitMs(runner), start := A_TickCount
    loop {
        found := V18_Matches(win)
        if found.Exact || A_TickCount - start >= waitMs
            break
        runner.Sleep(100)
    }
    if !found.Exact {
        secs := Round(waitMs / 1000)
        if WinGetList("ahk_exe " . win["exe"]).Length
            throw Error("The '" . win.Get("cls", "") . "' window of " . win["exe"] . " did not open within " . secs
                . " s. Get the program to that window, then retry this step.")
        throw Error(win["exe"] . " is not open (waited " . secs . " s). Open it, then retry this step.")
    }
    hwnd := V18_Choose(found.List, node, win)
    V18_Activate(hwnd, runner, RegExMatch(node.Get("type", ""), "^(click|drag|wheel)$") = 0)
    return hwnd
}

; @summary Waits for a window selector (Macro window / "Use Window" target) to exist. Throws when it never does.
; @tags macro, playback, window, steady, v18
V18_WaitTarget(target, runner) {
    waitMs := V18_WaitMs(runner), start := A_TickCount
    while !(hwnd := WinExist(target)) {
        if A_TickCount - start >= waitMs
            throw Error("'" . target . "' is not open (waited " . Round(waitMs / 1000) . " s). Open it, then retry this step.")
        runner.Sleep(100)
    }
    return hwnd
}

; @summary Brings a window to the front (restoring it when minimized), trying three times.
;          Menus, dropdowns and other windows without a title bar are left alone for mouse steps - taking the focus
;          would close them. strict = a typing step: failing to get a real window in front throws, because the keys
;          would go to some other window. For mouse steps it is only noted.
; @returns true when the window is active (or needs no activation)
; @tags macro, playback, window, steady, v18
V18_Activate(hwnd, runner, strict := true) {
    id := "ahk_id " . hwnd
    if WinActive(id)
        return true
    real := true
    try real := V17_IsRealWindow(WinGetClass(id), WinGetStyle(id), WinGetExStyle(id))
    if !real && !strict
        return true
    try {
        if WinGetMinMax(id) = -1
            WinRestore(id)
    }
    Loop 3 {
        try WinActivate(id)
        if WinWaitActive(id, , 1)
            return true
        runner.Sleep(150)
    }
    if !real
        return false
    name := "the window"
    try name := WinGetProcessName(id)
    msg := "Could not bring " . name . " to the front (another window may be in the way)."
    if strict
        throw Error(msg . " Close what is blocking it, then retry this step.")
    V17_Warn(runner, "Step #" . runner.Index . ": " . msg . " Clicked anyway.")
    return false
}

; @summary An embedded click picture, decoded once: its size, its pixels and whether it is "plain" (one colour over
;          90% of it - an empty field or blank background, which looks the same everywhere). Cached per picture.
; @returns {W, H, Plain, Buf}  Buf = the BMP bytes (32-bit pixels from byte 54, top row first), 0 when unreadable
; @tags macro, playback, picture, steady, v18
V18_PatchInfo(pattern) {
    static cache := Map()
    if cache.Has(pattern)
        return cache[pattern]
    info := {W: 0, H: 0, Plain: true, Buf: 0}
    try {
        buf := V4_Unbase64(SubStr(pattern, 7))
        if buf.Size >= 54 && NumGet(buf, 0, "UShort") = 0x4D42 && NumGet(buf, 28, "UShort") = 32
            && NumGet(buf, 22, "Int") < 0 {                 ; top-down, the way V4_CaptureBmp writes them
            w := NumGet(buf, 18, "Int"), h := -NumGet(buf, 22, "Int")
            if w > 0 && h > 0 && buf.Size >= 54 + w * h * 4 {
                info.W := w, info.H := h, info.Buf := buf
                info.Plain := V18_IsPlain(buf, w, h)
            }
        }
    }
    if cache.Count >= 400
        cache.Clear()
    cache[pattern] := info
    return info
}

; @summary True when one colour (in steps of 16 per channel) covers at least 90% of a 32-bit BMP's pixels.
; @tags macro, picture, steady, v18
V18_IsPlain(buf, w, h) {
    total := w * h
    if total < 1 || buf.Size < 54 + total * 4
        return true
    counts := Map(), best := 0
    Loop total {
        key := NumGet(buf, 54 + (A_Index - 1) * 4, "UInt") & 0xF0F0F0
        n := counts.Get(key, 0) + 1
        counts[key] := n
        if n > best
            best := n
    }
    return best >= total * 0.9
}

; @summary The screen's pixels in a box, taken the same way a click picture is taken when recording.
; @returns Buffer of w * h 32-bit pixels (top row first), or 0 when the screen can't be read
; @tags macro, playback, picture, steady, v18
V18_GrabPixels(x, y, w, h) {
    if w < 1 || h < 1
        return 0
    dc := DllCall("GetDC", "Ptr", 0, "Ptr")
    mem := 0, bmp := 0, old := 0
    try {
        mem := DllCall("gdi32\CreateCompatibleDC", "Ptr", dc, "Ptr")
        bi := Buffer(40, 0)
        NumPut("UInt", 40, "Int", w, "Int", -h, "UShort", 1, "UShort", 32, bi)
        bits := 0
        bmp := DllCall("gdi32\CreateDIBSection", "Ptr", dc, "Ptr", bi, "UInt", 0, "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
        if !mem || !bmp || !bits
            return 0
        old := DllCall("gdi32\SelectObject", "Ptr", mem, "Ptr", bmp, "Ptr")
        if !DllCall("gdi32\BitBlt", "Ptr", mem, "Int", 0, "Int", 0, "Int", w, "Int", h,
            "Ptr", dc, "Int", x, "Int", y, "UInt", 0x40CC0020)
            return 0
        out := Buffer(w * h * 4)
        DllCall("RtlMoveMemory", "Ptr", out.Ptr, "Ptr", bits, "UPtr", out.Size)
        return out
    } catch
        return 0
    finally {
        if old
            DllCall("gdi32\SelectObject", "Ptr", mem, "Ptr", old)
        if bmp
            DllCall("gdi32\DeleteObject", "Ptr", bmp)
        if mem
            DllCall("gdi32\DeleteDC", "Ptr", mem)
        if dc
            DllCall("ReleaseDC", "Ptr", 0, "Ptr", dc)
    }
}

; @summary True when a click picture matches the grabbed screen pixels with its top-left at (ox, oy) inside them.
;          A pixel matches when each colour channel is within vary; up to 2% of the pixels may differ (a blinking
;          text cursor, a focus dot).
; @tags macro, playback, picture, steady, v18
V18_PixelsMatch(info, scr, scrW, ox, oy, vary := 40) {
    w := info.W, h := info.H, budget := Floor(w * h * 0.02), bad := 0
    pat := info.Buf.Ptr + 54, base := scr.Ptr
    Loop h {
        pRow := pat + (A_Index - 1) * w * 4, sRow := base + ((oy + A_Index - 1) * scrW + ox) * 4
        Loop w {
            off := (A_Index - 1) * 4
            a := NumGet(pRow + off, "UInt") & 0xFFFFFF, b := NumGet(sRow + off, "UInt") & 0xFFFFFF
            if a = b
                continue
            if Abs((a & 255) - (b & 255)) > vary || Abs(((a >> 8) & 255) - ((b >> 8) & 255)) > vary
                || Abs((a >> 16) - (b >> 16)) > vary {
                bad += 1
                if bad > budget
                    return false
            }
        }
    }
    return true
}

; @summary Where a click picture is on the screen right now, looking only at its recorded place (left, top) and up
;          to reach px around it.
; @returns {DX, DY} (0, 0 = exactly in place), or 0 when it is not there
; @tags macro, playback, picture, steady, v18
V18_LocatePatch(info, left, top, reach, vary := 40) {
    w := info.W + 2 * reach, h := info.H + 2 * reach
    scr := V18_GrabPixels(left - reach, top - reach, w, h)
    if !scr
        return 0
    if V18_PixelsMatch(info, scr, w, reach, reach, vary)
        return {DX: 0, DY: 0}
    best := 0, bestDist := 0
    Loop 2 * reach + 1 {
        oy := A_Index - 1
        Loop 2 * reach + 1 {
            ox := A_Index - 1
            dist := Abs(ox - reach) + Abs(oy - reach)
            if dist && (!IsObject(best) || dist < bestDist) && V18_PixelsMatch(info, scr, w, ox, oy, vary)
                best := {DX: ox - reach, DY: oy - reach}, bestDist := dist
        }
    }
    return best
}

; @summary Steady click: moves the mouse to the spot (the picture was taken with the mouse resting there) and waits
;          until the screen at the spot looks like the recorded picture (setting verifyMs, default 1.5 s). A drift of
;          up to 6 px is corrected. When it never matches, the recorded spot is clicked anyway and a note is kept -
;          the run goes on.
;          Skipped for steps that vary each round, steps without a picture, and verifyClicks = 0 / noVerify = 1.
; @returns {X, Y} to click
; @tags macro, playback, picture, steady, v18
V18_VerifySpot(node, hwnd, runner, point) {
    if !runner.Settings.Get("verifyClicks", 1) || node.Get("noVerify", 0)
        return point
    pattern := node.Get("pattern", "")
    if SubStr(pattern, 1, 6) != "V4BMP:" || !node.Has("offsetX") || !node.Has("offsetY")
        return point
    spots := node.Get("varySpots", "")
    if (spots is Array && spots.Length) || Number(node.Get("varyDX", 0)) != 0 || Number(node.Get("varyDY", 0)) != 0
        return point
    info := V18_PatchInfo(pattern)
    if !IsObject(info.Buf) || info.W < 4 || info.H < 4
        return point
    left := point.X - Integer(node["offsetX"]), top := point.Y - Integer(node["offsetY"])
    reach := info.Plain ? 0 : 6         ; a plain picture matches anywhere, so it is only compared in place
    for corner in [[point.X, point.Y], [left - reach, top - reach], [left + info.W + reach, top - reach],
        [left - reach, top + info.H + reach], [left + info.W + reach, top + info.H + reach]]
        V5_HideOverlays(corner[1], corner[2])       ; the run bar must not be in the picture
    MouseMove(point.X, point.Y, 0)
    waitMs := Max(0, Number(runner.Settings.Get("verifyMs", 1500))), start := A_TickCount
    loop {
        at := V18_LocatePatch(info, left, top, reach)
        if IsObject(at)
            return {X: point.X + at.DX, Y: point.Y + at.DY}
        if A_TickCount - start >= waitMs
            break
        runner.Sleep(100)
    }
    V17_Warn(runner, "Step #" . runner.Index . ": the screen at the click spot did not look like the recording (waited "
        . Round(waitMs / 1000, 1) . " s); clicked the recorded spot anyway.")
    return point
}

; @summary Holds down the recorded click modifiers ("^" = Ctrl, "+" = Shift). Returns the keys to release.
; @tags macro, playback, v18
V18_ModsDown(mods) {
    held := []
    for pair in [["^", "Ctrl"], ["+", "Shift"]]
        if InStr(mods, pair[1]) {
            SendEvent("{" . pair[2] . " down}")
            held.Push(pair[2])
        }
    return held
}
V18_ModsUp(held) {
    for key in held
        SendEvent("{" . key . " up}")
}

; @summary A recorded wheel step. When the window under the mouse can be read it also keeps that window and the
;          spot inside it, so playback scrolls the same pane instead of whatever the mouse happens to be over.
; @tags macro, record, wheel, v18
V18_WheelStep(direction, x, y, hwnd) {
    step := Map("type", "wheel", "direction", direction, "count", 1, "win", V4_RecordWin())
    try {
        geo := V14_CaptureGeo(hwnd, x, y)
        if geo is Map {
            win := Map("exe", WinGetProcessName("ahk_id " . hwnd), "cls", WinGetClass("ahk_id " . hwnd), "title", "")
            step["win"] := win, step["geo"] := geo
        }
    }
    scroll := V19_CaptureScroll(x, y)               ; V19: the scroll position before this wheel notch
    if scroll is Map
        step["scroll"] := scroll
    return step
}

; @summary Same window (program + class) for two recorded steps.
; @tags macro, record, v18
V18_SameWin(a, b) {
    wa := a.Get("win", ""), wb := b.Get("win", "")
    if !(wa is Map) || !(wb is Map)
        return false
    return wa.Get("exe", "") = wb.Get("exe", "") && wa.Get("cls", "") = wb.Get("cls", "")
}

; @summary True when click b is the second (or third) press of a double-click that started with click a.
; @tags macro, record, v18
V18_SameClick(a, b, dblMs) {
    if a.Get("type", "") != "click" || b.Get("type", "") != "click"
        return false
    if a.Has("varyMarked") || b.Has("varyMarked") || a.Get("count", 1) >= 3
        return false
    if a.Get("button", "Left") != b.Get("button", "Left") || a.Get("mods", "") != b.Get("mods", "")
        return false
    if !a.Has("scrX") || !b.Has("scrX") || Abs(a["scrX"] - b["scrX"]) > 4 || Abs(a["scrY"] - b["scrY"]) > 4
        return false
    return b.Get("gapMs", 99999) <= dblMs && V18_SameWin(a, b)
}

; @summary True when wheel step b carries on wheel step a (same direction and window, within 0.4 s).
; @tags macro, record, v18
V18_SameWheel(a, b) {
    if a.Get("type", "") != "wheel" || b.Get("type", "") != "wheel"
        return false
    if a.Has("varyMarked") || b.Has("varyMarked")
        return false
    return a.Get("direction", "") = b.Get("direction", "") && b.Get("gapMs", 99999) <= 400 && V18_SameWin(a, b)
}

; @summary Tidies freshly recorded steps in place: a double-click becomes one click step with count 2 (two single
;          clicks replayed with their own waits are often too slow to count as a double-click), and a run of wheel
;          notches becomes one wheel step.
; @returns how many steps were joined into the one before
; @tags macro, record, v18
V18_TidySteps(steps, dblMs := unset) {
    if !(steps is Array)
        return 0
    if !IsSet(dblMs)
        dblMs := DllCall("GetDoubleClickTime", "UInt")
    joined := 0, i := 2
    while i <= steps.Length {
        a := steps[i - 1], b := steps[i]
        isClick := V18_SameClick(a, b, dblMs)
        if isClick || V18_SameWheel(a, b) {
            a["count"] := a.Get("count", 1) + (isClick ? 1 : b.Get("count", 1))
            if b.Has("_tick")
                a["_tick"] := b["_tick"]
            steps.RemoveAt(i), joined += 1
        } else
            i += 1
    }
    return joined
}

; @summary Recording stopped and its steps are in the macro: a macro that was empty gets Steady playback and the
;          screen it was recorded on, and the window Record picked by itself becomes the Macro window with a
;          Normalize step as step #1.
; @returns a short note for the status bar ("" when no window was picked)
; @tags macro, record, window, normalize, v18
V18_FinishRecording() {
    s := VMB(), r := V17_RecWin(), m := s.Macro["settings"], note := ""
    if s.RecWasEmpty {
        m["steady"] := 1
        m["recScreen"] := V18_ScreenText()
    }
    if r.AutoTarget != "" && IsObject(r.AutoGeo) && Trim(m.Get("defaultTarget", "")) = "" {
        m["defaultTarget"] := r.AutoTarget
        s.PinHwnd := r.MacroHwnd
        norm := V17_TopNormalize(s.Macro["blocks"], r.AutoTarget, true)
        for key, value in V17_GeometryFields(r.AutoGeo)
            norm[key] := value
        norm["target"] := ""
        for trial in r.Trial                    ; V19: the auto-picked window's Normalize step exists only now
            if trial.Hwnd = r.MacroHwnd && !IsObject(trial.Node)
                trial.Node := norm
        trialNote := V19_RunSizeTrials(r.Trial)    ; first, so the size in the note below is the saved one
        r.Trial := []
        note := "  Macro window: " . r.AutoTarget . " - step #1 puts it back to " . V17_NormText(norm) . "." . trialNote
    }
    note .= V19_RunSizeTrials(r.Trial)          ; V19: windows that got a Normalize step while recording
    r.Trial := []
    r.AutoTarget := "", r.AutoGeo := 0, r.AutoPick := false
    VMB_SettingsToControls()
    return note
}

; @summary The last picture taken under the resting mouse while recording.
;          V17 took a click's picture when the button went down, at the same moment the program starts redrawing
;          (pressed button, selected row, switched tab), so the picture was sometimes the "before" and sometimes the
;          "after". A timer now takes it whenever the mouse has rested for a moment, and the click uses that one.
; @tags macro, record, picture, v18
V18_PreShot() {
    static p := {X: "", Y: "", Pattern: "", Left: 0, Top: 0, Tick: 0, Used: 0}
    return p
}
V18_PreShotReset() {
    p := V18_PreShot()
    p.X := "", p.Y := "", p.Pattern := "", p.Used := 0
}

; @summary The 40x30 box a click picture covers (the same box VM_CaptureClickStep uses), kept on the screen.
; @returns {Left, Top, W, H}
; @tags macro, record, picture, v18
V18_PatchBox(x, y) {
    left := Max(SysGet(76), Round(x) - 20), top := Max(SysGet(77), Round(y) - 15)
    return {Left: left, Top: top, W: Min(40, SysGet(76) + SysGet(78) - left), H: Min(30, SysGet(77) + SysGet(79) - top)}
}

; @summary Recording timer (every 80 ms): when the mouse is where it was on the last tick, no button is down and it
;          is not over this editor, takes the picture under it.
; @tags macro, record, picture, v18
V18_PreShotTick() {
    p := V18_PreShot()
    if !V4_RecordAllowed() || GetKeyState("LButton") || GetKeyState("RButton") || GetKeyState("MButton")
        return
    CoordMode("Mouse", "Screen")
    MouseGetPos(&x, &y, &hwnd)
    if x != p.X || y != p.Y {
        p.X := x, p.Y := y, p.Pattern := ""
        return
    }
    if V18_OwnWindow(hwnd)
        return
    try {
        box := V18_PatchBox(x, y)
        p.Pattern := V4_CaptureBmp(box.Left, box.Top, box.W, box.H)
        p.Left := box.Left, p.Top := box.Top, p.Tick := A_TickCount
    } catch
        p.Pattern := ""
}

; @summary Gives a just-recorded click the resting-mouse picture when there is a fresh one (taken within 0.4 s, mouse
;          within 2 px). A fast click with no rest keeps the picture taken at the press.
; @returns true when the picture was replaced
; @tags macro, record, picture, v18
V18_UsePreShot(step, x, y, now := unset) {
    p := V18_PreShot()
    if p.Pattern = "" || p.X = "" || Abs(x - p.X) > 2 || Abs(y - p.Y) > 2 || (IsSet(now) ? now : A_TickCount) - p.Tick > 400
        return false
    step["pattern"] := p.Pattern
    step["offsetX"] := Round(x) - p.Left, step["offsetY"] := Round(y) - p.Top
    p.Used += 1
    return true
}

; ============================================================================
; V19 WINDOW SIZE + SCROLL
; A Normalize step waits until the window really has its size (no fixed pause). When recording stops, each new
; window's size is tested once (a window that snaps to its own sizes gets the size it settles at). Setting
; sizeMismatch "stop" stops the run when a window can't take its size. Each recorded click / wheel step remembers
; the scroll position of the standard Windows list or box under it ("scroll"); Steady playback puts it back first.
; ============================================================================

; @summary Decides when to stop waiting for a window size. samples = array of [tickMs, w, h], oldest first.
; @returns "ok" (within 1 px of the wanted size on the last two reads), "stuck" (the size has not changed for
;          300 ms and is not the wanted size: the program refused it), or "" (keep waiting)
; @tags macro, window, normalize, v19
V19_SizeVerdict(samples, wantW, wantH) {
    n := samples.Length
    if !n
        return ""
    last := samples[n]
    lastOk := Abs(last[2] - wantW) <= 1 && Abs(last[3] - wantH) <= 1
    if lastOk && n >= 2 && Abs(samples[n - 1][2] - wantW) <= 1 && Abs(samples[n - 1][3] - wantH) <= 1
        return "ok"
    if lastOk
        return ""
    first := n
    while first > 1 && samples[first - 1][2] = last[2] && samples[first - 1][3] = last[3]
        first -= 1
    return last[1] - samples[first][1] >= 300 ? "stuck" : ""
}

; @summary Waits until a window has the wanted size: reads it every 50 ms (Esc-stoppable when ctx is a runner,
;          a plain Sleep when ctx is 0). byPos = true compares the position (x, y) instead, for a fixed-size window.
; @returns "ok", "stuck" (the program refused the size) or "timeout" (after maxMs, or the window is gone)
; @tags macro, window, normalize, v19
V19_WaitSize(id, wantW, wantH, ctx, maxMs := 2000, byPos := false) {
    samples := [], start := A_TickCount
    loop {
        try WinGetPos(&wx, &wy, &ww, &wh, id)
        catch
            return "timeout"
        samples.Push(byPos ? [A_TickCount, wx, wy] : [A_TickCount, ww, wh])
        verdict := V19_SizeVerdict(samples, wantW, wantH)
        if verdict != ""
            return verdict
        if A_TickCount - start >= maxMs
            return "timeout"
        if IsObject(ctx)
            ctx.Sleep(50)
        else
            Sleep(50)
    }
}

; @summary Result of a size trial: does the window go back to its recorded size after being made bigger?
; @returns {Holds (back within 1 px of the recorded size), W, H (the size it went back to), CanGrow}
; @tags macro, window, normalize, record, v19
V19_TrialResult(recW, recH, grewW, grewH, backW, backH) {
    return {Holds: Abs(backW - recW) <= 1 && Abs(backH - recH) <= 1, W: backW, H: backH,
        CanGrow: grewW > recW || grewH > recH}
}

; @summary Recording stopped: makes the window 60 px bigger, then puts it back, and reads which size it takes.
;          Always ends by moving the window back to where it was. Any error = {Holds: true} (never blocks the user).
; @returns V19_TrialResult object
; @tags macro, window, normalize, record, v19
V19_SizeTrial(hwnd) {
    id := "ahk_id " . hwnd, res := {Holds: true}, read := false
    try {
        WinGetPos(&wx, &wy, &ww, &wh, id)
        read := true
        WinMove(wx, wy, ww + 60, wh + 60, id)
        V19_WaitSize(id, ww + 60, wh + 60, 0)
        WinGetPos(, , &grewW, &grewH, id)
        WinMove(wx, wy, ww, wh, id)
        V19_WaitSize(id, ww, wh, 0)
        WinGetPos(, , &backW, &backH, id)
        res := V19_TrialResult(ww, wh, grewW, grewH, backW, backH)
    }
    if read
        try WinMove(wx, wy, ww, wh, id)
    return res
}

; @summary Recording stopped: runs the size trial once for each window that got a Normalize step and is still open,
;          resizable and not maximized (not this script's windows). A window that snaps to its own sizes gets the
;          size it settles at saved in its Normalize step.
; @returns a note for the status bar, or ""
; @tags macro, window, normalize, record, v19
V19_RunSizeTrials(trials) {
    snapped := false
    for trial in trials {
        node := trial.Node
        if !IsObject(node) || node.Get("sizeChecked", 0) || V4_Bool(node.Get("maximize", 0))
            continue
        open := false
        try {
            id := "ahk_id " . trial.Hwnd
            if WinExist(id) && !V18_OwnWindow(trial.Hwnd) && WinGetMinMax(id) = 0 && V17_IsResizable(WinGetStyle(id)) {
                WinGetPos(, , &curW, &curH, id)
                open := true
            }
        }
        if !open || Abs(curW - node.Get("width", 0)) > 1 || Abs(curH - node.Get("height", 0)) > 1
            continue        ; closed, fixed-size, maximized - or resized after its step was recorded
        res := V19_SizeTrial(trial.Hwnd)
        node["sizeChecked"] := 1
        if !res.Holds {
            node["width"] := res.W, node["height"] := res.H
            snapped := true
        }
    }
    return snapped ? "  This window only takes certain sizes. Saved the size it settles at." : ""
}

; @summary The "size is off" note without its trailing " Kept going." (for the message when the run stops instead).
; @tags macro, window, normalize, v19
V19_MismatchText(msg) => SubStr(msg, -12) = " Kept going." ? SubStr(msg, 1, -12) : msg

; @summary Scroll bar numbers of a control. bar: 0 = horizontal, 1 = vertical.
; @returns {Min, Max, Page, Pos}, or 0 when the control has no such scroll bar
; @tags macro, scroll, v19
V19_ScrollInfo(hwnd, bar) {
    si := Buffer(28, 0)
    NumPut("UInt", 28, "UInt", 0x17, si)        ; cbSize, SIF_ALL
    if !DllCall("GetScrollInfo", "Ptr", hwnd, "Int", bar, "Ptr", si)
        return 0
    return {Min: NumGet(si, 8, "Int"), Max: NumGet(si, 12, "Int"),
        Page: NumGet(si, 16, "UInt"), Pos: NumGet(si, 20, "Int")}
}

; @summary True when a scroll bar (V19_ScrollInfo result, or 0) can actually scroll: the content is longer than a page.
; @tags macro, scroll, v19
V19_CanScroll(info) => IsObject(info) && info.Max > info.Min && info.Max - info.Min + 1 > info.Page

; @summary The scroll position read back from a control, or "" when it has no such scroll bar.
; @tags macro, scroll, v19
V19_ScrollPos(hwnd, bar) {
    info := V19_ScrollInfo(hwnd, bar)
    return IsObject(info) ? info.Pos : ""
}

; @summary The list / box / pane under a screen point that has a scroll bar that can scroll (the control itself or
;          up to 7 parents). Never a window of this script.
; @returns its hwnd, or 0 when nothing there scrolls
; @tags macro, scroll, v19
V19_ScrollPane(x, y) {
    x := Round(x), y := Round(y)
    h := DllCall("WindowFromPoint", "Int64", (y << 32) | (x & 0xFFFFFFFF), "Ptr")
    desk := DllCall("GetDesktopWindow", "Ptr")
    loop 8 {
        if !h || h = desk || V18_OwnWindow(h)
            return 0
        if V19_CanScroll(V19_ScrollInfo(h, 1)) || V19_CanScroll(V19_ScrollInfo(h, 0))
            return h
        h := DllCall("GetAncestor", "Ptr", h, "UInt", 1, "Ptr")     ; GA_PARENT
    }
    return 0
}

; @summary Recording: the scroll position of the pane under a click / wheel spot.
; @returns Map("cls", class, and per bar that can scroll "v" / "vMax" / "vPage" or "h" / "hMax" / "hPage"), or ""
; @tags macro, scroll, record, v19
V19_CaptureScroll(x, y) {
    try {
        pane := V19_ScrollPane(x, y)
        if !pane
            return ""
        out := Map("cls", WinGetClass("ahk_id " . pane))
        for pair in [["v", 1], ["h", 0]] {
            info := V19_ScrollInfo(pane, pair[2])
            if V19_CanScroll(info)
                out[pair[1]] := info.Pos, out[pair[1] . "Max"] := info.Max, out[pair[1] . "Page"] := info.Page
        }
        return out
    }
    return ""
}

; @summary A wanted scroll position kept inside what the bar allows: lo (Min) .. hi (Max) - page + 1 (page 0 counts as 1).
; @tags macro, scroll, v19
V19_ClampScroll(want, lo, hi, page) => VF_Clamp(want, lo, Max(lo, hi - Max(page, 1) + 1))

; @summary What to send next to step a scroll bar from pos towards want. far (a page or more away, page > 1) =
;          page up / down, else line up / down. Done after 2 flips (stepped over the target twice) or at the target.
; @returns {Code: 0 line up | 1 line down | 2 page up | 3 page down | 8 end (when Done), Done}
; @tags macro, scroll, v19
V19_ScrollStep(pos, want, page, flips) {
    delta := want - pos
    if delta = 0 || flips >= 2
        return {Code: 8, Done: true}
    far := page > 1 && Abs(delta) >= page
    return {Code: delta > 0 ? (far ? 3 : 1) : (far ? 2 : 0), Done: false}
}

; @summary Scrolls one bar of a pane to a position: first a jump (SB_THUMBPOSITION), then line / page steps, reading
;          the position back after each. Every message has a 500 ms timeout so a hung program can't hang the macro.
; @returns true when the bar ends exactly at want (after clamping)
; @tags macro, scroll, playback, v19
V19_ScrollTo(pane, bar, want, runner) {
    msg := bar = 1 ? 0x115 : 0x114            ; WM_VSCROLL / WM_HSCROLL
    info := V19_ScrollInfo(pane, bar)
    if !IsObject(info)
        return false
    want := V19_ClampScroll(want, info.Min, info.Max, info.Page)
    pos := info.Pos
    if pos = want
        return true
    if want >= 0 && want <= 65535 {           ; way 1: jump
        try SendMessage(msg, (want << 16) | 4, 0, pane, , , , , 500)     ; SB_THUMBPOSITION
        try SendMessage(msg, 8, 0, pane, , , , , 500)                    ; SB_ENDSCROLL
        pos := V19_ScrollPos(pane, bar)
        if pos = want
            return true
        if pos = ""
            return false
    }
    flips := 0, lastSign := 0                 ; way 2: step
    loop 600 {
        next := V19_ScrollStep(pos, want, info.Page, flips)
        if next.Done
            break
        try SendMessage(msg, next.Code, 0, pane, , , , , 500)
        now := V19_ScrollPos(pane, bar)
        if now = "" || now = pos
            break
        sign := now < want ? 1 : now > want ? -1 : 0
        if sign && lastSign && sign != lastSign
            flips += 1
        if sign
            lastSign := sign
        pos := now
        if Mod(A_Index, 50) = 0
            runner.Sleep(1)
    }
    try SendMessage(msg, 8, 0, pane, , , , , 500)                        ; SB_ENDSCROLL
    return pos = want                         ; way 3: give up (the caller notes it); the spot is never shifted
}

; @summary Steady playback, before a click / wheel step with a recorded "scroll": scrolls the list or box under the spot
;          back to where it was when recording. Skipped when the macro setting restoreScroll is 0.
; @returns true when the pane is where it was; false after a note (the step still clicks). Throws instead of the
;          "could not scroll" note when the macro setting sizeMismatch is "stop".
; @tags macro, scroll, playback, steady, v19
V19_RestoreScroll(node, point, runner) {
    if !runner.Settings.Get("restoreScroll", 1)
        return false
    rec := node["scroll"], isWheel := node.Get("type", "") = "wheel"
    V5_HideOverlays(point.X, point.Y)          ; the run bar must not hide the list from WindowFromPoint
    pane := V19_ScrollPane(point.X, point.Y), cls := ""
    if pane
        try cls := WinGetClass("ahk_id " . pane)
    if !pane || cls != rec.Get("cls", "") {
        V17_Warn(runner, "Step #" . runner.Index . ": the list that was scrolled when recording was not found at the "
            . (isWheel ? "mouse spot. Scrolled anyway." : "click spot. Clicked anyway."))
        return false
    }
    changed := false, missed := "", longer := false
    for pair in [["v", 1], ["h", 0]] {
        key := pair[1]
        if !rec.Has(key)
            continue
        want := rec[key], info := V19_ScrollInfo(pane, pair[2])
        if IsObject(info) && info.Pos = want
            continue
        if IsObject(info) && rec.Has(key . "Max") && info.Max != rec[key . "Max"]
            longer := true
        changed := true
        if !V19_ScrollTo(pane, pair[2], want, runner) || V19_ScrollPos(pane, pair[2]) != want {     ; V20: also when the list is now too short
            now := V19_ScrollPos(pane, pair[2])
            missed .= (missed = "" ? "" : "; ") . "now at " . (now = "" ? "?" : now) . ", recorded " . want
        }
    }
    if missed != "" {
        text := "Step #" . runner.Index . ": could not scroll the list back to where it was (" . missed . ")"
            . (longer ? " (the list is a different length than when it was recorded)" : "") . "."
        if runner.Settings.Get("sizeMismatch", "") = "stop"
            throw Error(text . " Scroll it back by hand, then retry this step.")
        V17_Warn(runner, text . (isWheel ? " Scrolled anyway." : " Clicked anyway."))
        return false
    }
    if changed
        runner.Sleep(80)                       ; let the pane re-draw before the picture check
    return true
}

; ============================================================================
; V20 STEP LINES
; Each step in the macro list reads as one plain sentence: what is done, to what, in which program, and whereabouts
; in the window - then small tags for anything unusual (a long pause, a list scrolled back first, a note).
; While recording, a click also remembers WHAT was under the mouse ("what": a button's caption, a menu item's
; text, or just the kind of control). Text inside boxes, lists and labels is never saved - only captions of
; buttons, tabs and menu items.
; ============================================================================

; @summary A length of time for a step line: "500 ms", "1.5 s", "2 s", "12 s".
; @tags macro, explain, v20
V20_Time(ms) {
    ms := IsNumber(ms) ? Number(ms) : 0
    return ms < 1000 ? Round(ms) . " ms" : RegExReplace(Format("{:.1f}", ms / 1000), "\.0$") . " s"
}

; @summary Program name for a step line: "notepad" from "notepad.exe" ("" when unknown).
; @tags macro, explain, v20
V20_AppName(exe) => RegExReplace(Trim(exe), "i)\.exe$")

; @summary Program name out of a window selector such as "ahk_class Notepad ahk_exe notepad.exe" (else the selector).
; @tags macro, explain, v20
V20_TargetName(target) {
    if RegExMatch(target, "i)ahk_exe\s+(\S+)", &m)
        return V20_AppName(m[1])
    return RegExMatch(target, "i)ahk_class\s+(\S+)", &m) ? m[1] : target
}

; @summary Rough place of a spot inside a window, in words: "top-left", "middle", "bottom-right" ... (3 x 3 grid).
; @tags macro, explain, v20
V20_Zone(cx, cy, cw, ch) {
    col := cx < cw / 3 ? "left" : cx >= cw * 2 / 3 ? "right" : ""
    row := cy < ch / 3 ? "top" : cy >= ch * 2 / 3 ? "bottom" : ""
    if row = "" && col = ""
        return "middle"
    return row = "" ? "middle-" . col : col = "" ? row . " middle" : row . "-" . col
}

; @summary Shortens text for a step line and makes line breaks visible.
; @tags macro, explain, v20
V20_Short(text, maxLen := 60) {
    text := StrReplace(StrReplace(StrReplace(String(text), "`r`n", "⏎"), "`n", "⏎"), "`t", "⇥")
    return StrLen(text) > maxLen ? SubStr(text, 1, maxLen - 1) . "…" : text
}

; @summary A caption that is safe and short enough to show: one line, "&" shortcut marks and menu shortcuts
;          ("`tCtrl+S") removed, at most 40 characters. "" when there is nothing usable.
; @tags macro, explain, record, v20
V20_CleanCaption(text) {
    text := String(text)
    if (tab := InStr(text, "`t"))
        text := SubStr(text, 1, tab - 1)
    text := Trim(RegExReplace(StrReplace(StrReplace(text, "&&", Chr(1)), "&"), "[\r\n]+.*$"))
    text := StrReplace(text, Chr(1), "&")
    return StrLen(text) > 40 ? SubStr(text, 1, 39) . "…" : text
}

; @summary Kind of control from its window class and style, in plain words. caption = true when the control's own
;          text is a caption that may be shown (buttons, tick boxes, tabs) - never for boxes, lists or labels.
; @returns {Kind, Caption}
; @tags macro, explain, record, v20
V20_KindOf(cls, style := 0) {
    if cls = "#32768"
        return {Kind: "menu item", Caption: false}
    if RegExMatch(cls, "i)^(Button|TButton|TBitBtn|TSpeedButton|TCheckBox|TRadioButton|ThunderRT6(CommandButton|CheckBox|OptionButton)|WindowsForms10\.BUTTON)") {
        kind := "button"
        if cls = "Button" {
            bs := style & 0xF
            kind := (bs = 2 || bs = 3 || bs = 5 || bs = 6) ? "tick box" : (bs = 4 || bs = 9) ? "option" : bs = 7 ? "group box" : "button"
        } else if RegExMatch(cls, "i)Check")
            kind := "tick box"
        else if RegExMatch(cls, "i)Radio|Option")
            kind := "option"
        return {Kind: kind, Caption: kind != "group box"}
    }
    static kinds := [["i)^(Edit|RichEdit|RICHEDIT|TEdit|TMemo|TRichEdit|TMaskEdit|ThunderRT6TextBox|WindowsForms10\.EDIT)", "text box"],
        ["i)ComboBox|TComboBox|ComboLBox", "drop-down list"],
        ["i)^(ListBox|TListBox|TCheckListBox|SysListView32|TListView|ThunderRT6ListBox|WindowsForms10\.LISTBOX)", "list"],
        ["i)Grid|TStringGrid|TDBGrid", "grid"],
        ["i)^(SysTreeView32|TTreeView)", "tree"],
        ["i)^(SysTabControl32|TPageControl|TTabControl)", "tab strip"],
        ["i)^(ToolbarWindow32|TToolBar|ReBarWindow32)", "toolbar"],
        ["i)^SysHeader32", "column header"],
        ["i)^msctls_statusbar32|TStatusBar", "status bar"],
        ["i)^ScrollBar", "scroll bar"],
        ["i)^(msctls_trackbar32|TTrackBar)", "slider"],
        ["i)^(SysDateTimePick32|SysMonthCal32|TDateTimePicker)", "date picker"],
        ["i)^(Shell_TrayWnd|Shell_SecondaryTrayWnd|MSTaskListWClass|MSTaskSwWClass)", "taskbar"]]
    for pair in kinds
        if RegExMatch(cls, pair[1])
            return {Kind: pair[2], Caption: false}
    return {Kind: "", Caption: false}
}

; @summary Part of a window frame from a WM_NCHITTEST result ("" for the inside of the window).
; @tags macro, explain, record, v20
V20_FramePart(hit) {
    static parts := Map(2, "title bar", 3, "window menu (top-left icon)", 5, "menu bar", 6, "scroll bar", 7, "scroll bar",
        8, "Minimize button", 9, "Maximize button", 20, "Close button (X)", 21, "Help button")
    if parts.Has(hit)
        return parts[hit]
    return hit >= 10 && hit <= 17 ? "window edge" : ""
}

; @summary Text of the menu item under a screen point in a menu (popup menu window or a window's menu bar).
; @returns the item's text, or ""
; @tags macro, explain, record, v20
V20_MenuText(owner, hMenu, x, y) {
    if !hMenu
        return ""
    pos := DllCall("MenuItemFromPoint", "Ptr", owner, "Ptr", hMenu, "Int64", (y << 32) | (x & 0xFFFFFFFF), "Int")
    if pos < 0
        return ""
    buf := Buffer(260 * 2, 0)
    if !DllCall("GetMenuStringW", "Ptr", hMenu, "UInt", pos, "Ptr", buf, "Int", 259, "UInt", 0x400, "Int")    ; MF_BYPOSITION
        return ""
    return V20_CleanCaption(StrGet(buf, "UTF-16"))
}

; @summary What is under a screen point, for the step line: the kind of control and - only for buttons, tick boxes,
;          tabs' own captions and menu items - its caption. Called when a click is recorded, before the program
;          reacts. Every read has a short timeout and any failure just means "unknown".
; @returns Map("kind", ..., "text", ...) or "" when nothing useful is known
; @tags macro, explain, record, v20
V20_CaptureWhat(x, y) {
    try {
        x := Round(x), y := Round(y)
        pt := (y << 32) | (x & 0xFFFFFFFF)
        h := DllCall("WindowFromPoint", "Int64", pt, "Ptr")
        if !h || V18_OwnWindow(h)
            return ""
        root := DllCall("GetAncestor", "Ptr", h, "UInt", 2, "Ptr")      ; GA_ROOT
        cls := WinGetClass("ahk_id " . h)
        if cls = "#32768" {
            text := ""
            try text := V20_MenuText(0, SendMessage(0x1E1, 0, 0, h, , , , , 200), x, y)      ; MN_GETHMENU
            return V20_What("menu item", text)
        }
        hit := 0
        try hit := SendMessage(0x84, 0, (y << 16) | (x & 0xFFFF), root, , , , , 200)          ; WM_NCHITTEST
        part := V20_FramePart(hit)
        if part = "menu bar" {
            text := ""
            try text := V20_MenuText(root, DllCall("GetMenu", "Ptr", root, "Ptr"), x, y)
            return V20_What(text != "" ? "menu" : "menu bar", text)
        }
        if part != "" && h = root
            return V20_What(part, "")
        style := 0
        try style := WinGetStyle("ahk_id " . h)
        info := V20_KindOf(cls, style)
        text := ""
        if info.Caption
            try text := V20_CleanCaption(ControlGetText(h))
        return info.Kind = "" && text = "" ? "" : V20_What(info.Kind, text)
    }
    return ""
}

; @summary Builds the "what" Map of a click step.
; @tags macro, explain, record, v20
V20_What(kind, text) {
    out := Map("kind", kind)
    if text != ""
        out["text"] := text
    return out
}

; @summary "the "OK" button" / "a text box" / "menu item "Save As..."" from a step's "what" ("" when it has none).
; @tags macro, explain, v20
V20_WhatText(node) {
    what := node.Get("what", "")
    if !(what is Map)
        return ""
    kind := what.Get("kind", ""), text := what.Get("text", "")
    if text != ""
        return (kind = "menu item" || kind = "menu") ? kind . ' "' . text . '"' : 'the "' . text . '"' . (kind != "" ? " " . kind : "")
    if kind = ""
        return ""
    if RegExMatch(kind, "i)^(title bar|menu bar|taskbar|status bar|toolbar|tab strip|window edge|scroll bar|Close|Minimize|Maximize|Help|window menu)")
        return "the " . kind
    return (RegExMatch(kind, "i)^[aeiou]") ? "an " : "a ") . kind
}

; @summary Keys in plain words for a step line: "Ctrl+A (select all)", "Tab ×3 (next field)". Falls back to the raw keys.
; @tags macro, explain, v20
V20_KeysText(keys) {
    meaning := V13_KeysMeaning(keys)
    if meaning = ""
        return keys
    return RegExReplace(meaning, ": ([^,]+?)(?=, then |$)", " ($1)")
}

; @summary "in notepad" for a step with a recorded window ("" when unknown). show: true = " in notepad",
;          2 = " → in notepad" (V21: the program changed here), false = "" (V21: same program as the step before).
; @tags macro, explain, v20
V20_InApp(node, show := true) {
    win := node.Get("win", "")
    if !show || !(win is Map) || win.Get("exe", "") = ""
        return ""
    return (show = 2 ? " → in " : " in ") . V20_AppName(win["exe"])
}

; @summary Whereabouts of a click for a step line: " — top-left (40, 20)" from the window-locked spot, or the
;          screen spot for old steps.
; @tags macro, explain, v20
V20_WhereText(node) {
    if node.Get("find", "") != "spot"
        return " — wherever the saved picture is found"
    geo := node.Get("geo", "")
    if geo is Map
        return " — " . V20_Zone(geo["cx"], geo["cy"], geo["cw"], geo["ch"]) . " (" . geo["cx"] . ", " . geo["cy"] . ")"
    return " — screen spot (" . node.Get("scrX", node.Get("x", 0)) . ", " . node.Get("scrY", node.Get("y", 0)) . ")"
}

; @summary The main sentence of a step line - what the step does, in plain words. V21: web blocks, basic-input blocks
;          and the measuring blocks get theirs from V21_MoreSentence; "" for kinds that keep the older form.
; @tags macro, explain, v20
V20_StepSentence(node) {
    t := node.Get("type", "")
    switch t {
        case "click", "drag":
            mods := node.Get("mods", "")
            held := (InStr(mods, "^") ? "Ctrl+" : "") . (InStr(mods, "+") ? "Shift+" : "")
            btn := node.Get("button", "Left"), count := Integer(node.Get("count", 1))
            what := V20_WhatText(node)
            if t = "drag" {
                dx := node.Get("dx", 0), dy := node.Get("dy", 0)
                move := (dx ? Abs(dx) . (dx > 0 ? " right" : " left") : "") . (dx && dy ? ", " : "") . (dy ? Abs(dy) . (dy > 0 ? " down" : " up") : "")
                return held . (btn = "Left" ? "Drag" : btn . "-drag") . (what != "" ? " " . what : "") . V20_InApp(node, V21_ShowApp(node))
                    . V20_WhereText(node) . (move != "" ? ", " . move : "")
            }
            verb := (btn = "Left" ? "" : btn . "-") . (count = 2 ? "double-click" : count >= 3 ? "triple-click" : "click")
            verb := held . (held = "" ? StrUpper(SubStr(verb, 1, 1)) . SubStr(verb, 2) : verb)
            return verb . (what != "" ? " " . what : "") . V20_InApp(node, V21_ShowApp(node)) . V20_WhereText(node)
        case "wheel":
            n := Integer(node.Get("count", 1))
            return "Scroll " . StrLower(RegExReplace(node.Get("direction", "WheelDown"), "i)^Wheel")) . " " . n
                . (n = 1 ? " notch" : " notches") . V20_InApp(node, V21_ShowApp(node))
        case "text":
            if node.Get("ask", 0)
                return "Type what you answer when asked (each run)"
            text := node.Get("text", "")
            return 'Type "' . V20_Short(text) . '"' . (InStr(text, "{{") ? "  (the {{...}} part is filled in each round)" : "") . V20_InApp(node, V21_ShowApp(node))
        case "keys":
            return "Press " . V20_KeysText(node.Get("keys", "")) . V20_InApp(node, V21_ShowApp(node))
        case "delay":
            return "Wait " . V20_Time(node.Get("ms", 0))
        case "wait":
            return "Wait " . (node.Has("timeoutMs") ? "up to " . V20_Time(node["timeoutMs"]) . " " : "") . "for the saved picture to "
                . (V4_Bool(node.Get("appear", 1)) ? "appear" : "go away")
        case "check":
            return "Check that the saved picture is " . (V4_Bool(node.Get("appear", 1)) ? "on screen" : "gone")
        case "det_normalize_win":
            who := Trim(node.Get("target", "")) = "" ? "the window" : "the " . V20_TargetName(node["target"]) . " window"
            if V4_Bool(node.Get("maximize", 0))
                return "Maximize " . who
            return "Put " . who . " back to " . node.Get("width", 693) . " × " . node.Get("height", 803) . " at ("
                . node.Get("marginX", 20) . ", " . node.Get("marginY", 20) . ")"
        case "det_use_window":
            target := Trim(node.Get("target", ""))
            return target = "" ? "Go back to the macro's main window" : "Switch to the " . V20_TargetName(target) . " window  (waits up to "
                . node.Get("waitSec", 10) . " s for it)"
        case "det_citrix_fill":
            return "Click the box at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . "), clear it, type " . '"' . V20_Short(node.Get("value", ""), 40) . '"'
                . (V4_Bool(node.Get("pressTab", 1)) ? ", press Tab" : "")
    }
    return V21_MoreSentence(node)
}

; @summary Small tags after the sentence, only for what is out of the ordinary: a fixed or long pause before the
;          step, a list scrolled back first, a step that changes each round, "whatever window is active", a note.
; @tags macro, explain, v20
V20_StepTags(node) {
    out := ""
    if node.Has("delayMs")
        out .= "   ⏱ waits " . V20_Time(node["delayMs"]) . " first"
    else if IsNumber(node.Get("gapMs", 0)) && node.Get("gapMs", 0) >= 1500
        out .= "   ⏱ after a " . V20_Time(node["gapMs"]) . " pause"
    if node.Get("scroll", "") is Map
        out .= "   ↕ list scrolled back first"
    if (vary := V8_VarySummaryBadge(node)) != ""
        out .= "   " . vary
    if node.Get("win", "") is Map && node.Get("winMatch", "") = "active"
        out .= "   ◇ whatever window is active"
    if node.Get("note", "") != ""
        out .= "   // " . node["note"]
    return out
}

; @summary The whole text of a step in the macro list (after its number): sentence + tags, or "" to use the older form.
; @tags macro, explain, gui, v20
V20_StepLine(node) {
    sentence := V20_StepSentence(node)
    return sentence = "" ? "" : sentence . V20_StepTags(node)
}

; ============================================================================
; V21 STEP LIST
; The macro list reads at a glance: the program is named only where it changes, every kind of step and block gets a
; plain sentence, and the steps that had a note in the last run are marked. Nothing here is saved to the macro file.
; ============================================================================

; @summary Which steps should name their program in the macro list. flatSteps = VMF_Flatten(blocks), in order.
; @returns Map step -> 1 (the first step with a program: show " in notepad"), 2 (the program differs from the step
;          before that had one: show " → in notepad") or 0 (same program: do not show it). Steps without a recorded
;          window (no "win" / no "exe") get no entry and do not break a run.
; @tags macro, explain, gui, v21
V21_AppRuns(flatSteps) {
    out := Map(), lastExe := ""
    for step in flatSteps {
        if !(step is Map)
            continue
        win := step.Get("win", "")
        if !(win is Map) || win.Get("exe", "") = ""
            continue
        exe := win["exe"]
        out[step] := lastExe = "" ? 1 : exe != lastExe ? 2 : 0       ; != ignores upper / lower case
        lastExe := exe
    }
    return out
}

; @summary How V20_InApp should name this step's program: the editor's AppShow entry (0, 1 or 2), or true when there
;          is no editor map or no entry (so a loose step, for example in the self-test, always names its program).
; @tags macro, explain, gui, v21
V21_ShowApp(node) {
    if VMB().Gui && VMB().Columns       ; V22: column mode in the editor (with no editor: as in V21)
        return false
    appShow := VMB().AppShow
    return appShow is Map ? appShow.Get(node, true) : true
}

; @summary A short, readable name for a web element from its CSS selector, for a step line: "#submit" -> "submit" in
;          quotes; [name="email"], [aria-label="Search"], [data-testid="save-btn"] -> the value; otherwise the last
;          simple part, plus the nearest "#id" to its left ("form#login button.primary" -> "button.primary in #login").
;          At most 40 characters (V20_Short). "" for a blank selector.
; @tags macro, explain, web, v21
V21_SelectorName(selector) {
    sel := Trim(String(selector))
    if sel = ""
        return ""
    parts := [], part := "", depth := 0, quote := ""
    Loop Parse, sel {
        ch := A_LoopField
        if quote != "" {                        ; inside a quoted attribute value: spaces and > do not split
            part .= ch
            if ch = quote
                quote := ""
            continue
        }
        if ch = '"' || ch = "'" {
            quote := ch, part .= ch
            continue
        }
        if ch = "[" || ch = "("
            depth += 1
        else if ch = "]" || ch = ")"
            depth := Max(0, depth - 1)
        if depth = 0 && (ch = " " || ch = "`t" || ch = ">" || ch = "+" || ch = "~") {
            if part != ""
                parts.Push(part)
            part := ""
            continue
        }
        part .= ch
    }
    if part != ""
        parts.Push(part)
    if !parts.Length
        return V20_Short(sel, 40)
    lastPart := parts[parts.Length]
    if RegExMatch(lastPart, "^#([\w-]+)$", &m)
        return V20_Short('"' . m[1] . '"', 40)
    if RegExMatch(lastPart, "i)^[\w-]*\[(?:name|aria-label|data-testid)\s*=\s*([`"']?)(.*?)\1\s*\]$", &m)
        name := m[2]
    else
        name := lastPart
    loop parts.Length - 1 {
        if RegExMatch(parts[parts.Length - A_Index], "#([\w-]+)", &m) {
            name .= " in #" . m[1]
            break
        }
    }
    return V20_Short(name, 40)
}

; @summary A web address for a step line: host + path only, no "https://", no query string or #part
;          ("https://example.com/orders?id=5" -> "example.com/orders").
; @tags macro, explain, web, v21
V21_UrlText(url) {
    url := RegExReplace(Trim(String(url)), "[?#].*$")
    url := RegExReplace(url, "i)^[a-z][a-z0-9+.\-]*://")
    return RegExReplace(url, "(?<=.)/$")
}

; @summary The sentence of a step that V20_StepSentence does not handle: web blocks, basic-input blocks and the
;          measuring blocks. Reads the fields named in V4_WebDefs / V4_InputDefs / V10_DetDefs. "" for any other kind
;          (the older "Name   details" form is shown then).
; @tags macro, explain, web, v21
V21_MoreSentence(node) {
    static colours := Map("DiscernYellow", "yellow (the active box)", "CernerDoorBlue", "the door-icon blue",
        "HighlightBlue", "the selection blue", "DisabledGrey", "greyed out", "WhiteReady", "white (ready)")
    static places := Map("TopLeft", "top left", "BottomCenter", "bottom centre", "TopRight", "top right",
        "BottomRight", "bottom right", "BottomLeft", "bottom left", "Center", "centre")
    t := node.Get("type", "")
    el := V21_SelectorName(node.Get("selector", ""))
    el := el = "" ? "the element" : el
    frame := Trim(node.Get("frame", ""))
    inFrame := frame = "" ? "" : "  (inside frame " . V21_SelectorName(frame) . ")"
    keep := Trim(node.Get("variable", ""))
    keepText := keep = "" ? "" : ", remember it as " . keep
    btn := node.Get("button", "Left"), count := node.Get("count", 1)
    clickVerb := (btn = "Left" ? "" : StrLower(btn) . "-") . (count = 2 ? "double-click" : "click")
    switch t {
        case "web_launch":
            browser := RegExReplace(RegExReplace(node.Get("browser", "Edge"), ".*[\\/]"), "i)\.exe$")
            return "Web: open the " . browser . " browser for the macro (port " . node.Get("port", 9222) . ")"
        case "web_connect", "web_tab":
            match := node.Get("match", "")
            if match = ""
                return t = "web_connect" ? "Web: connect to the only open tab" : "Web: switch to the other tab"
            return (t = "web_connect" ? "Web: connect to the tab" : "Web: switch to the tab") . " whose " . node.Get("by", "url")
                . (node.Get("mode", "contains") = "exact" ? " is " : " contains ") . '"' . V20_Short(match, 40) . '"'
        case "web_navigate":
            return "Web: go to " . V21_UrlText(node.Get("url", ""))
        case "web_newtab":
            url := V21_UrlText(node.Get("url", "about:blank"))
            return url = "" || url = "about:blank" ? "Web: open a new empty tab" : "Web: open a new tab at " . url
        case "web_back": return "Web: go back a page"
        case "web_forward": return "Web: go forward a page"
        case "web_reload": return "Web: reload the page"
        case "web_close": return "Web: close the tab"
        case "web_disconnect": return "Web: let go of the browser (it stays open)"
        case "web_wait":
            cond := node.Get("condition", "visible")
            how := cond = "present" ? "be on the page" : cond = "hidden" ? "be hidden" : cond = "absent" ? "go away"
                : cond = "text" ? 'show "' . V20_Short(node.Get("value", ""), 30) . '"' : "appear"
            return "Web: wait for " . el . " to " . how . " (up to " . V20_Time(node.Get("timeoutMs", 10000)) . ")" . inFrame
        case "web_click":
            return "Web: " . clickVerb . " " . el . inFrame
        case "web_fill":
            if V4_Bool(node.Get("ask", 0))              ; asked each run: never show the text
                return "Web: type what you answer when asked into " . el . inFrame
            return 'Web: type "' . V20_Short(node.Get("value", ""), 40) . '" into ' . el . inFrame
        case "web_select":
            return 'Web: pick "' . V20_Short(node.Get("value", ""), 40) . '" in ' . el . inFrame
        case "web_check":
            return "Web: " . (V4_Bool(node.Get("checked", 1)) ? "tick " : "untick ") . el . inFrame
        case "web_read":
            attr := node.Get("attribute", "textContent")
            return "Web: read " . (RegExMatch(attr, "i)^(textContent|innerText)$") ? "the text" : "the " . attr) . " of " . el
                . keepText . inFrame
        case "web_count":
            return "Web: count how many " . el . " there are" . keepText . inFrame
        case "web_exists":
            return "Web: check whether " . el . " is there" . keepText . inFrame
        case "web_focus":
            return "Web: put the cursor in " . el . inFrame
        case "web_scroll":
            return "Web: scroll " . el . " into view" . inFrame
        case "web_keys":
            return "Web: press " . node.Get("key", "Enter") . (Trim(node.Get("selector", "")) = "" ? "" : " in " . el) . inFrame
        case "web_screenshot":
            return "Web: save a picture of the page as " . RegExReplace(node.Get("path", ""), ".*[\\/]")
        case "web_eval":
            return 'Web: run the script "' . V20_Short(node.Get("expression", ""), 40) . '"' . keepText
        case "web_cdp":
            return "Web: send the browser command " . node.Get("method", "") . keepText
        case "input_send", "input_sendinput", "input_sendevent":
            if V4_Bool(node.Get("ask", 0))
                return "Send keys: what you answer when asked (each run)"
            return "Send keys: " . V20_KeysText(node.Get("value", ""))
        case "input_sendtext":
            if V4_Bool(node.Get("ask", 0))
                return "Type what you answer when asked (each run)"
            return 'Type "' . V20_Short(node.Get("value", "")) . '"'
        case "input_keydown":
            return "Hold " . node.Get("key", "Ctrl") . " down"
        case "input_keyup":
            return "Let go of " . node.Get("key", "Ctrl")
        case "det_wait_window":
            return "Wait until " . V31_WaitText(node)
        case "det_wait_settled":
            return "Wait until the area (" . node.Get("x1", 0) . ", " . node.Get("y1", 0) . ")–(" . node.Get("x2", 0) . ", "
                . node.Get("y2", 0) . ") stops changing"
        case "det_wait_pixel":
            mode := node.Get("colorMode", "DiscernYellow")
            colour := mode = "NearHex" ? "close to #" . node.Get("colorHex", "") : colours.Get(mode, mode)
            return "Wait until the dot at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") is "
                . (V4_Bool(node.Get("appear", 1)) ? "" : "no longer ") . colour
        case "det_anchor_click":
            clickVerb := StrUpper(SubStr(clickVerb, 1, 1)) . SubStr(clickVerb, 2)
            anchor := node.Get("anchor", "BottomCenter")
            if anchor = "ProportionalPct"
                return clickVerb . " at " . node.Get("pctX", 50) . "% across and " . node.Get("pctY", 50) . "% down the window"
            place := places.Get(anchor, anchor)
            dx := node.Get("dx", 0), dy := node.Get("dy", 0)
            dx := IsNumber(dx) ? Number(dx) : 0, dy := IsNumber(dy) ? Number(dy) : 0
            move := (dx ? Abs(dx) . " px " . (dx > 0 ? "right" : "left") : "") . (dx && dy ? " and " : "")
                . (dy ? Abs(dy) . " px " . (dy > 0 ? "down" : "up") : "")
            return clickVerb . " " . (move = "" ? "at the " : move . " from the ") . place . " of the window"
        case "det_human_click":
            clickVerb := StrUpper(SubStr(clickVerb, 1, 1)) . SubStr(clickVerb, 2)
            return clickVerb . " at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ")" . (node.Get("coordRel", "Window") = "Screen" ? " on the screen" : "")
                . (node.Get("profile", "MinimumJerk") = "Instant" ? "" : " with a human-like move")
        case "det_predict_row":
            item := V20_Short(node.Get("wantItem", ""), 40)
            if node.Get("selectMethod", "CheckboxClick") = "StoreRowOnly"
                return 'Work out which row "' . item . '" is in the list (no click)'
            return 'Pick "' . item . '" in the list (row is worked out)'
    }
    return ""
}

; @summary A condition in plain words for the macro list. For a variable: "amount is 250", "amount is not 250",
;          "name contains x", "name is empty", "name is not empty" ...; other conditions use VMF__CondText.
; @tags macro, explain, gui, v21
V21_CondText(node) {
    static ops := Map("=", "is", "!=", "is not", "<", "is less than", ">", "is more than", "<=", "is at most",
        ">=", "is at least", "contains", "contains")
    if node.Get("cond", "image") != "var"
        return VMF__CondText(node)
    name := node.Get("name", "?"), op := node.Get("op", "=")
    if op = "empty" || op = "notempty"
        return name . (op = "empty" ? " is empty" : " is not empty")
    return name . " " . ops.Get(op, op) . " " . node.Get("value", "")
}

; @summary The text of a container / control row in the macro list, in the same plain style as the step lines
;          ("Repeat 5 times  (4 steps inside)", "If amount is 250", "Leave the loop" ...), with the "  // note" suffix.
;          Kinds it does not know use VMF_BlockText. VMF_BlockText itself is unchanged (code view, saved text).
; @tags macro, explain, gui, v21
V21_BlockLine(node) {
    static stops := Map("break", "Leave the loop", "continue", "Go on with the next round of the loop",
        "nextrow", "Skip this data row (it counts as failed)", "endrun", "End the run here (it counts as done)",
        "stop", "Stop the run")
    t := node.Get("type", "")
    inside := ""
    if VMF_IsContainer(node) {
        n := VMF_CountSteps(VMF_Children(node)[1])
        inside := n = 0 ? "  (no steps inside yet)" : "  (" . n . (n = 1 ? " step" : " steps") . " inside)"
    }
    switch t {
        case "repeat":
            count := node.Get("count", 1)
            line := "Repeat " . count . (count = 1 ? " time" : " times") . inside
        case "foreach":
            line := "For each row of the list" . inside
        case "for":
            stepBy := node.Get("step", 1)
            line := "Count " . node.Get("name", "i") . " from " . node.Get("from", 1) . " to " . node.Get("to", 10)
                . (stepBy = 1 ? "" : " in steps of " . stepBy) . inside
        case "until":
            line := "Repeat until " . V21_CondText(node) . (node.Get("check", "") = "after" ? ", checked after each round" : "")
                . "  (at most " . node.Get("max", 100) . " times)"
        case "if":
            line := "If " . V21_CondText(node)
        case "set":
            name := node.Get("name", "?"), value := node.Get("value", "")
            line := node.Get("ask", 0) ? "Ask me for " . name . (value = "" ? "" : ' (suggests "' . V20_Short(value, 40) . '")')
                : 'Remember "' . V20_Short(value, 40) . '" as ' . name
        case "change":
            name := node.Get("name", "?"), by := node.Get("by", 1)
            line := IsNumber(by) && by < 0 ? "Take " . Abs(by) . " from " . name : "Add " . by . " to " . name
        case "ask":
            line := "Ask me: " . node.Get("prompt", "")
        case "stop":
            action := node.Get("action", "break")
            line := stops.Get(action, action)
        case "call":
            line := "Run the macro " . RegExReplace(node.Get("path", ""), ".*[\\/]")
        default:
            return VMF_BlockText(node)
    }
    return line . (node.Get("note", "") = "" ? "" : "  // " . node["note"])
}

; @summary Which steps had a note in a run: result.Warnings (note texts, each "Step #<n> ...") -> Map step number ->
;          the first note text for that step. Texts that do not start with "Step #<n>" are left out.
; @tags macro, playback, gui, v21
V21_NoteSteps(warnings) {
    out := Map()
    if !(warnings is Array)
        return out
    for text in warnings {
        if RegExMatch(String(text), "^Step #(\d+)", &m) && !out.Has(Integer(m[1]))
            out[Integer(m[1])] := String(text)
    }
    return out
}

; @summary The tag a step row gets when the step had a note in the last run: "   ⚠ last run: <note>", the note
;          without its "Step #n: " start and at most 70 characters.
; @tags macro, playback, gui, v21
V21_NoteTag(text) => "   ⚠ last run: " . V20_Short(RegExReplace(String(text), "^Step #\d+:?\s*"), 70)

; @summary True when the point (x, y) lies on one of the screens. rects = array of [left, top, right, bottom]
;          (as MonitorGet gives them; right and bottom are just outside the screen).
; @tags macro, window, monitor, normalize, v21
V21_OnAnyScreen(x, y, rects) {
    for rect in rects
        if x >= rect[1] && x < rect[3] && y >= rect[2] && y < rect[4]
            return true
    return false
}

; ============================================================================
; V22 COLUMNS
; The step list in fixed columns: number, program (on every row), waits, marks, then the sentence. The tree uses a
; monospace font and each column is padded with spaces; deeper rows give back the tree's own indent so the columns
; line up at every depth. Display only - nothing here is saved to the macro file or changes playback.
; ============================================================================

; @summary Exactly width characters: text padded with spaces, or cut to width - 1 characters plus "…".
;          Every character counts as one column (StrLen).
; @tags macro, gui, columns, v22
V22_Pad(text, width) {
    text := String(text)
    if width < 1
        return ""
    if StrLen(text) > width
        return SubStr(text, 1, width - 1) . "…"
    return Format("{:-" . width . "}", text)
}

; @summary The column layout of the step list: number, program, waits, marks (widths in characters). The gap
;          between columns is always 1 space; the sentence follows after the last column.
; @tags macro, gui, columns, v22
V22_Cols() {
    static cols := [{Key: "num", W: 5}, {Key: "app", W: 14}, {Key: "wait", W: 9}, {Key: "marks", W: 7}]
    return cols
}

; @summary The spaces in front of a row: maxDepth * indentChars for a top-level row, depth * indentChars fewer for a
;          deeper row (the tree's own indent makes up the difference), never fewer than none. V22.1: maxDepth is the
;          deepest tree level of the current macro (s.MaxDepth); the default 8 is the old fixed value.
; @tags macro, gui, columns, v22
V22_Margin(depth, indentChars, maxDepth := 8) {
    n := Max(0, (maxDepth - Max(0, depth)) * indentChars)
    return n ? Format("{:" . n . "}", "") : ""
}

; @summary The program of one step for the Program column ("" when the step itself has none): the recorded
;          window's program; for det_* / input_* steps with a "target" field the program of that target, or of the
;          Macro window (settings "defaultTarget") when it is blank; "web page" for web steps.
; @tags macro, gui, columns, v22
V22_AppOf(node, settings := 0) {
    win := node.Get("win", "")
    if win is Map && win.Get("exe", "") != ""
        return StrLower(V20_AppName(win["exe"]))        ; V22.1: lower case for the column only
    t := node.Get("type", "")
    if SubStr(t, 1, 4) = "web_"
        return "web page"
    if (SubStr(t, 1, 4) = "det_" || SubStr(t, 1, 6) = "input_") && node.Has("target") {
        target := Trim(node["target"])
        if target = "" && settings is Map
            target := Trim(settings.Get("defaultTarget", ""))
        return target = "" ? "" : StrLower(V20_TargetName(target))     ; V22.1: lower case for the column only
    }
    return ""
}

; @summary The Program column for every step: a step with no program of its own (a Delay ...) takes the program of
;          the nearest earlier step that had one. V22.1: a det_* / input_* step with a blank or missing target shows the
;          program of the last "Use Window From Here On" before it (blank = the Macro window), in list order. flatSteps = VMF_Flatten(blocks); blocks that are not steps are skipped.
; @returns {App: Map step -> program text, Starts: Map step -> true for the first step and each step whose program
;          differs (upper / lower case ignored) from the step before}
; @tags macro, gui, columns, v22
V22_FillApps(flatSteps, settings := 0) {
    apps := Map(), starts := Map(), prevApp := "", isFirst := true, useTarget := ""
    for step in flatSteps {
        if !(step is Map) || !VMF_IsStep(step)
            continue
        own := V22_AppOf(step, settings)
        t := step.Get("type", "")
        if t = "det_use_window"                          ; V22.1: later blank-target steps follow this window (display only,
            useTarget := Trim(String(step.Get("target", "")))        ; the same rule as V16_FallbackTarget at play time)
        else if (SubStr(t, 1, 4) = "det_" || SubStr(t, 1, 6) = "input_") && Trim(String(step.Get("target", ""))) = ""
            && !(step.Get("win", "") is Map && step["win"].Get("exe", "") != "") {
            follow := useTarget != "" ? useTarget : (settings is Map ? Trim(settings.Get("defaultTarget", "")) : "")
            if follow != ""
                own := StrLower(V20_TargetName(follow))
        }
        filled := own != "" ? own : prevApp
        apps[step] := filled
        if isFirst || filled != prevApp
            starts[step] := true
        isFirst := false, prevApp := filled
    }
    return {App: apps, Starts: starts}
}

; @summary The Waits column: a wait set by hand ("delayMs") as "500 ms*", else a recorded pause of 300 ms or more
;          ("2.4 s"), else "".
; @tags macro, gui, columns, v22
V22_WaitText(node) {
    if node.Has("delayMs")
        return V20_Time(node["delayMs"]) . "*"
    gap := node.Get("gapMs", 0)
    return IsNumber(gap) && gap >= 300 ? V20_Time(gap) : ""
}

; @summary The Marks column, one character each, in this order and only when it applies: list scrolled back first,
;          changes each round, whatever window is active, has a note, had a note in the last run.
; @tags macro, gui, columns, v22
V22_Marks(node, lastNote := "", shaky := false) {
    chars := V22_MarkChars(), out := ""
    if node.Get("scroll", "") is Map
        out .= chars["scroll"]
    if V8_VarySummaryBadge(node) != ""
        out .= chars["vary"]
    if node.Get("winMatch", "") = "active"
        out .= chars["active"]
    if node.Get("note", "") != ""
        out .= chars["note"]
    if lastNote != ""
        out .= chars["warn"]
    if shaky
        out .= chars["shaky"]                   ; V25: had a note in 3 or more of the last 10 runs
    return out
}

; @summary The sentence at the end of a step row: V20_StepSentence (or the older "name   details" when it has
;          none), then "   // <note>", then the last-run note tag.
; @tags macro, gui, columns, v22
V22_Sentence(node, lastNote := "") {
    text := V20_StepSentence(node)
    if text = "" {
        sum := VM_StepSummary(node)
        text := sum[1] . "   " . sum[3]
    }
    return text . (node.Get("note", "") != "" ? "   // " . node["note"] : "") . (lastNote != "" ? V21_NoteTag(lastNote) : "")
}

; @summary One whole step row in fixed columns: margin, number (with "►" in its last character when the task
;          moves to another program here, not on step 1), program, waits, marks, then the sentence.
; @tags macro, gui, columns, v22
V22_Row(num, app, startsApp, wait, marks, sentence, depth, indentChars, maxDepth := 8) {
    cols := V22_Cols()
    numCol := V22_Pad(num, cols[1].W)
    if startsApp && num != 1
        numCol := SubStr(numCol, 1, cols[1].W - 1) . V22_MarkChars()["start"]
    return V22_Margin(depth, indentChars, maxDepth) . numCol . " " . V22_Pad(app, cols[2].W) . " " . V22_Pad(wait, cols[3].W)
        . " " . V22_Pad(marks, cols[4].W) . " " . sentence
}

; @summary The column names, built with the same margin and widths as a top-level row.
; @tags macro, gui, columns, v22
V22_Header(indentChars, maxDepth := 8) {
    cols := V22_Cols()
    return V22_Margin(0, indentChars, maxDepth) . V22_Pad("#", cols[1].W) . " " . V22_Pad("Program", cols[2].W) . " "
        . V22_Pad("Waits", cols[3].W) . " " . V22_Pad("Marks", cols[4].W) . " What it does"
}

; @summary The mark characters of the Marks column and the "►" of the number column, in one place. plain = 1 gives
;          plain ASCII letters instead (for a PC where the symbols show as boxes or are too wide). With no argument the
;          ini value [V22] PlainMarks (default 0) decides; it is read once, so a change needs a restart.
; @tags macro, gui, columns, v22
V22_MarkChars(plain := "") {
    static fromIni := 0
    if plain = "" {
        if !fromIni {
            ini := VMB().Ini
            fromIni := V22_MarkChars(ini != "" && IniRead(ini, "V22", "PlainMarks", 0) = "1" ? 1 : 0)
        }
        return fromIni
    }
    return plain ? Map("scroll", "S", "vary", "V", "active", "A", "note", "N", "warn", "!", "start", ">", "shaky", "~")
        : Map("scroll", "↕", "vary", "⚡", "active", "◇", "note", "✎", "warn", "⚠", "start", "►", "shaky", "≈")
}

; @summary V22.1: the deepest TREE level that will hold a row for this block list (0 = nothing nested). Counted the way
;          VMB_AddBody adds rows: the rows of a list sit at its depth; a container's body is one level deeper; an IF adds an
;          ELSE IF row per elif and one ELSE row at depth + 1 with their bodies at depth + 2; an empty list adds one
;          "(empty ...)" placeholder row at its own depth. list = the macro's blocks, depth = the level of that list.
; @tags macro, gui, columns, v22
V22_MaxDepth(list, depth := 0) {
    deepest := depth
    for node in list {
        if !(node is Map) || !VMF_IsContainer(node)
            continue
        VMF_Children(node)                              ; makes sure body / elifs / else are lists, like VMB_AddBody
        deepest := Max(deepest, V22_MaxDepth(node["body"], depth + 1))
        if node["type"] = "if" {
            for elif in VMF_Elifs(node)
                deepest := Max(deepest, depth + 1, V22_MaxDepth(elif["body"], depth + 2))
            deepest := Max(deepest, depth + 1, V22_MaxDepth(node["else"], depth + 2))
        }
    }
    return deepest
}

; @summary How deep a tree item is: the number of tree levels above it (0 = top level). ELSE rows and "(empty)"
;          placeholders are tree items too, so this counts tree levels, not block levels.
; @tags macro, gui, columns, v22
V22_DepthOf(item) {
    s := VMB(), depth := 0
    while item && (item := s.TV.GetParent(item))
        depth += 1
    return depth
}

; @summary Sets the macro tree's font - Consolas in column mode, else Segoe UI - and, in column mode, makes the tree's
;          indent exactly s.IndentChars characters wide (raised when Windows will not take an indent that small).
;          Leaving column mode puts the tree's own indent back. refresh = rebuild the rows when IndentChars changed.
; @tags macro, gui, columns, v22
V22_ApplyTreeFont(refresh := true) {
    static defaultIndent := 0
    s := VMB()
    if !s.TV
        return
    if !defaultIndent
        defaultIndent := SendMessage(0x1106, 0, 0, s.TV)                  ; TVM_GETINDENT, before any change
    s.TV.SetFont("s" . s.FontSize, s.Columns ? "Consolas" : "MS Shell Dlg 2")     ; a font name that is missing keeps
    if !s.Columns                                                                  ; the old font, so Segoe UI comes second
        s.TV.SetFont(, "Segoe UI")
    if !s.Columns {
        SendMessage(0x1107, defaultIndent, 0, s.TV)                        ; TVM_SETINDENT
        return
    }
    hFont := SendMessage(0x31, 0, 0, s.TV)                                 ; WM_GETFONT
    hdc := DllCall("GetDC", "Ptr", s.TV.Hwnd, "Ptr")
    oldFont := DllCall("SelectObject", "Ptr", hdc, "Ptr", hFont, "Ptr")
    ext := Buffer(8, 0)
    DllCall("GetTextExtentPoint32W", "Ptr", hdc, "Str", "0000000000", "Int", 10, "Ptr", ext)
    DllCall("SelectObject", "Ptr", hdc, "Ptr", oldFont, "Ptr")
    DllCall("ReleaseDC", "Ptr", s.TV.Hwnd, "Ptr", hdc)
    charW := Max(1, NumGet(ext, 0, "Int") / 10)
    s.CharH := NumGet(ext, 4, "Int")                                       ; V22.1: text height in pixels, for the header line
    before := s.IndentChars
    want := Round(charW * s.IndentChars)
    SendMessage(0x1107, want, 0, s.TV)
    actual := SendMessage(0x1106, 0, 0, s.TV)
    if actual > want {                                                     ; Windows refused an indent this small
        s.IndentChars := Ceil(actual / charW)
        SendMessage(0x1107, Round(charW * s.IndentChars), 0, s.TV)
    }
    s.IndentSeen := "char " . charW . " px, asked " . want . " px, got " . actual . " px, " . s.IndentChars . " characters"
    if refresh && s.IndentChars != before
        VMB_Refresh()
}

; @summary V22.1: the last line of the two help texts, "`nColumn check: " + the indent values the list measured
;          (s.IndentSeen); "" when that is not a non-empty string (columns never switched on yet).
; @tags macro, gui, columns, v22
V22_ColumnCheckLine(seen) {
    return seen is String && seen != "" ? "`nColumn check: " . seen : ""
}

; @summary V22.1: height of the header line in the window's 96-dpi units: the tree font's text height in pixels
;          (s.CharH) + 2, converted from screen pixels; 16 when the height is not known (charH < 1).
; @tags macro, gui, columns, v22
V22_HeaderHeight(charH, dpi := A_ScreenDPI) {
    return charH < 1 ? 16 : Round((charH + 2) * 96 / dpi)
}

; @summary Puts the column-name line right above the macro tree, its left edge where the first row's text starts
;          (TVM_GETITEMRECT, text part), in the tree's font and size. Hidden when the macro is empty or columns are off.
; @tags macro, gui, columns, v22
V22_PlaceHeader() {
    s := VMB()
    if !s.TV || !s.Gui || !s.Ctl.Has("ColHead") || !(s.Macro is Map)
        return
    head := s.Ctl["ColHead"]
    first := s.TV.GetNext()
    show := s.Columns && first && s.Macro["blocks"].Length
    if show {
        head.SetFont("s" . s.FontSize, "Consolas")
        head.Text := V22_Header(s.IndentChars, s.MaxDepth)
        rc := Buffer(16, 0)
        NumPut("Ptr", first, rc)
        if SendMessage(0x1104, 1, rc.Ptr, s.TV) {                         ; TVM_GETITEMRECT, wParam 1 = text only
            pt := Buffer(8, 0)
            NumPut("Int", NumGet(rc, 0, "Int"), "Int", 0, pt)
            DllCall("MapWindowPoints", "Ptr", s.TV.Hwnd, "Ptr", s.Gui.Hwnd, "Ptr", pt, "UInt", 1)     ; tree -> window
            s.TV.GetPos(&tx, &ty, &tw, &th)
            head.GetPos(, &hy)
            hh := V22_HeaderHeight(s.CharH)                                ; V22.1: the header follows the font height
            if ty - hy != hh {                                             ; the tree starts hh below the header: move its top
                shift := hh - (ty - hy)                                    ; and height by the same amount (bottom stays)
                s.TV.Move(, ty + shift, , Max(80, th - shift))
                ty += shift, th -= shift
                if s.Insp
                    V13_InspLayout(tx + tw + 10, ty, s.Insp.Width, th)     ; the Step settings panel follows the tree
            }
            hx := Round(NumGet(pt, 0, "Int") * 96 / A_ScreenDPI)           ; the window's controls use 96-dpi units
            head.Move(hx, hy, Max(50, tx + tw - hx), hh)
        }
    }
    head.Visible := show && s.View != "grid"
    V27_PlaceGrid()                                                       ; V27: the grid sits where the tree is
}

; @summary "Columns" tick box / "Show columns" menu entry: step list in fixed columns on or off (remembered).
; @tags macro, gui, columns, v22
V22_ToggleColumns(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    s.Columns := s.Columns ? 0 : 1
    IniWrite(s.Columns, s.Ini, "V22", "Columns")
    if s.Insp && s.Insp.HasOwnProp("Columns")
        s.Insp.Columns.Value := s.Columns
    V22_ApplyTreeFont(false)
    VMB_Refresh()
}

; @summary The whole story of one step in one line for the status bar, only the parts that apply, joined with " · ":
;          "Step 6 · notepad · waits 3.2 s first · <sentence> · list is scrolled back first · ... · last run: <note>".
;          num = the step number ("" leaves it out), app = its Program column, lastNote = its note in the last run.
; @tags macro, gui, columns, v22
V22_Detail(node, app, lastNote, num := "") {
    parts := []
    if num != ""
        parts.Push("Step " . num)
    if app != ""
        parts.Push(app)
    if node.Has("delayMs")
        parts.Push("waits " . V20_Time(node["delayMs"]) . " first (set by hand)")
    else if IsNumber(node.Get("gapMs", 0)) && node.Get("gapMs", 0) >= 300
        parts.Push("waits " . V20_Time(node["gapMs"]) . " first")
    text := V20_StepSentence(node)
    if text = "" {
        sum := VM_StepSummary(node)
        text := Trim(sum[1] . "   " . sum[3])
    }
    parts.Push(text)
    if node.Get("scroll", "") is Map
        parts.Push("list is scrolled back first")
    if (vary := V8_VarySummaryBadge(node)) != ""
        parts.Push(RegExReplace(vary, "^⚡\[(.*)\]$", "$1"))
    if node.Get("winMatch", "") = "active"
        parts.Push("whatever window is active")
    if node.Get("note", "") != ""
        parts.Push("note: " . node["note"])
    if lastNote != ""
        parts.Push("last run: " . V20_Short(RegExReplace(String(lastNote), "^Step #\d+:?\s*"), 120))
    out := ""
    for part in parts
        out .= (A_Index > 1 ? " · " : "") . part
    return out
}

; @summary Tree ItemSelect (after what it already did): the status bar spells out the selected step with V22_Detail.
;          Not while recording or playing (the status bar is in use then), not for blocks, and not again for the
;          same step (the list re-selects it after every change, which would hide that change's own message).
; @tags macro, gui, columns, v22
V22_ShowDetail() {
    static lastNode := 0
    if VM_IsRecording() || VM_IsPlaying()
        return
    s := VMB()
    info := VMB_SelectedInfo()
    if !info || info.Kind != "node" || !VMF_IsStep(info.Node) {
        lastNode := 0
        return
    }
    node := info.Node
    if node == lastNode
        return
    lastNode := node
    num := s.FlatIndex.Get(node, "")
    app := s.ColApp is Map && s.ColApp.Has(node) ? s.ColApp[node] : V22_AppOf(node, s.Macro["settings"])
    VMB_Status(V22_Detail(node, app, s.LastNotes.Get(num, ""), num))
}

; ============================================================================
; V23 PLAIN STEP LIST
; ============================================================================

; @summary Colours for one row of the plain step list as [text, background] (COLORREF 0xBBGGRR), or 0 = system default
;          (black on white). state "off" = switched-off step (grey on white), "note" = a note in the last run
;          (dark red on white). Control rows (repeat / if / else / for ...) are never red: they stay default.
; @tags macro, gui, colors, v23
V23_RowColors(kind, state) {
    if state = "off"
        return [0x909090, 0xFFFFFF]
    if state = "note" && !V23_IsBox(kind)
        return [0x0000C0, 0xFFFFFF]
    return 0
}

; @summary True for the kinds of rows that hold other rows.
; @tags macro, gui, v23
V23_IsBox(kind) {
    static boxes := Map("repeat", 1, "if", 1, "elif", 1, "else", 1, "for", 1, "until", 1, "while", 1, "untilvar", 1,
        "dountil", 1, "foreach", 1, "ifvar", 1, "empty", 1)
    return boxes.Has(kind)
}

; @summary "Coloured rows" menu entry: switches the plain step list off / on (remembered) and redraws.
; @tags macro, gui, v23
V23_ToggleColoured(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    s.PlainList := s.PlainList ? 0 : 1
    IniWrite(s.PlainList, s.Ini, "V23", "PlainList")
    VMB_Refresh()
    if s.Pal
        DllCall("InvalidateRect", "Ptr", s.Pal.Hwnd, "Ptr", 0, "Int", 1)      ; V31: the toolbox follows the same switch
}

; ============================================================================
; V24 READY TO PLAY? CHECK
; ============================================================================

; @summary The programs a macro uses, in order of first use: an array of [lower-case exe name, step number of its first use].
;          Sources: a step's own win["exe"], and the target of Use Window / Normalize Window steps (only targets with
;          ahk_exe: a window class is not a program). Switched-off steps are skipped but still count in the numbering.
;          The macro has no Run / launch block, so there is no "started by the macro" rule.
; @tags macro, playback, preflight, v24
V24_Programs(steps) {
    out := [], seen := Map()
    for i, step in steps {
        if !(step is Map) || step.Get("disabled", 0)
            continue
        exe := ""
        win := step.Get("win", "")
        if win is Map && win.Get("exe", "") != ""
            exe := win["exe"]
        else if step.Get("type", "") = "det_use_window" || step.Get("type", "") = "det_normalize_win" {
            target := String(step.Get("target", ""))
            if RegExMatch(target, "i)ahk_exe\s+(\S+)", &m)
                exe := m[1]
        }
        exe := StrLower(Trim(exe))
        if exe != "" && !seen.Has(exe) {
            seen[exe] := 1
            out.Push([exe, i])
        }
    }
    return out
}

; @summary Problems to tell the owner about before a run starts, one plain sentence each (empty array = ready).
;          Pure: no windows are touched. steps = VMF_Flatten(blocks); openExes = Map of lower-case exe names running now;
;          screenText = V18_ScreenText() now.
; @tags macro, playback, preflight, v24
V24_Preflight(steps, settings, openExes, screenText) {
    out := []
    for use in V24_Programs(steps)
        if !openExes.Has(use[1])
            out.Push(V20_AppName(use[1]) . " is not open - step " . use[2] . " uses it.")
    was := settings is Map ? settings.Get("recScreen", "") : ""
    if was != "" && screenText != "" && was != screenText
        out.Push("The screen is " . screenText . ", recorded on " . was . " - clicks may land differently.")
    return out
}

; @summary Map of lower-case exe names of the windows that are open right now (each window asked inside a try).
; @tags macro, playback, preflight, v24
V24_OpenExes() {
    open := Map()
    try list := WinGetList()
    catch
        return open
    for hwnd in list {
        try open[StrLower(WinGetProcessName("ahk_id " . hwnd))] := 1
    }
    return open
}

; @summary Runs the Ready-to-play check for the whole macro. No problems = true at once. Otherwise ONE box (title
;          "Ready to play?", the problems as bullets): Yes = true (play anyway), No = false and the first problem goes to
;          the status bar. Editor only: exported players never come through here.
; @tags macro, playback, preflight, v24
V24_ReadyToPlay(macro, settings) {
    problems := V24_Preflight(VMF_Flatten(macro["blocks"]), settings, V24_OpenExes(), V18_ScreenText())
    if !problems.Length
        return true
    text := ""
    for line in problems
        text .= "• " . line . "`n"
    text .= "`nYes = play anyway, No = stop so I can fix it."
    if MsgBox(text, "Ready to play?", "YesNo Icon!") = "Yes"
        return true
    VMB_Status(problems[1])
    return false
}

; @summary "Check before playing" menu entry: the Ready-to-play box on / off (remembered).
; @tags macro, gui, preflight, v24
V24_ToggleCheck(*) {
    s := VMB()
    s.Preflight := s.Preflight ? 0 : 1
    IniWrite(s.Preflight, s.Ini, "V24", "Preflight")
}

; @summary The Program column text: the name, with a "?" after it when that program is not running right now.
;          known = Map of the exe names the macro uses (a window class or "web page" is never marked); 0 = mark any name.
;          openExes = 0 (not looked at yet) = never marked.
; @tags macro, gui, preflight, v24
V24_AppCell(app, openExes, known := 0) {
    if app = "" || !(openExes is Map)
        return app
    exe := app . ".exe"
    if known is Map && !known.Has(exe)
        return app
    return openExes.Has(exe) || openExes.Has(app) ? app : app . "?"
}

; @summary Puts the "?" (V24_AppCell) into the Program column texts of V22_FillApps, in place. flat = VMF_Flatten(blocks).
; @tags macro, gui, preflight, v24
V24_MarkApps(apps, openExes, flat) {
    known := Map()
    for use in V24_Programs(flat)
        known[use[1]] := 1
    steps := []
    for step in apps
        steps.Push(step)
    for step in steps
        apps[step] := V24_AppCell(apps[step], openExes, known)
}

; ============================================================================
; V25 RUN HISTORY
; ============================================================================

; @summary One line of the run history: When,Result,Seconds,Steps,Notes,NoteSteps. Result = Finished, Stopped or
;          "Failed at step N". noteSteps = Map of step number -> note text (V21_NoteSteps); NoteSteps is its step numbers
;          joined with ";" in quotes. when = "" means now.
; @tags macro, playback, history, v25
V25_RunLine(result, seconds, steps, noteSteps, when := "") {
    if when = ""
        when := FormatTime(, "yyyy-MM-dd HH:mm")
    if result.Ok
        res := "Finished"
    else if result.Failed
        res := result.Index >= 1 ? "Failed at step " . result.Index : "Failed"
    else
        res := "Stopped"
    nums := []
    if noteSteps is Map
        for n, text in noteSteps
            nums.Push(n)
    nums := V25_SortNums(nums)
    return when . "," . res . "," . Format("{:.1f}", seconds) . "," . steps . "," . nums.Length . ',"' . V4_Join(nums, ";") . '"'
}

; @summary Numbers in an array, smallest first (a new array).
; @tags macro, history, v25
V25_SortNums(nums) {
    out := []
    for n in nums
        out.Push(n)
    loop out.Length - 1 {
        i := A_Index
        loop out.Length - i {
            j := A_Index
            if out[j] > out[j + 1]
                t := out[j], out[j] := out[j + 1], out[j + 1] := t
        }
    }
    return out
}

; @summary The history text -> array of Maps (oldest first): When, Result, Seconds (number), Steps, Notes, NoteSteps (array
;          of step numbers), FailStep (0 when none). The header, empty lines, broken lines and a non-text input are skipped.
; @tags macro, playback, history, v25
V25_ParseRuns(text) {
    runs := []
    if !(text is String)
        return runs
    for line in StrSplit(text, "`n", "`r") {
        if !RegExMatch(line, '^([^,]*),([^,]*),(\d+(?:\.\d+)?),(\d+),(\d+),"?([\d;]*)"?\s*$', &m) || m[1] = "When"
            continue
        nums := []
        for part in StrSplit(m[6], ";")
            if part != ""
                nums.Push(Integer(part))
        fail := RegExMatch(m[2], "^Failed at step (\d+)$", &f) ? Integer(f[1]) : 0
        runs.Push(Map("When", m[1], "Result", m[2], "Seconds", Number(m[3]), "Steps", Integer(m[4]), "Notes", Integer(m[5]),
            "NoteSteps", nums, "FailStep", fail))
    }
    return runs
}

; @summary The history text cut to the newest `keep` run lines (the header line, if there is one, stays first).
; @tags macro, history, v25
V25_TrimRuns(text, keep := 200) {
    head := "", rows := []
    for line in StrSplit(text, "`n", "`r") {
        if line = ""
            continue
        if SubStr(line, 1, 5) = "When,"
            head := line
        else
            rows.Push(line)
    }
    out := head = "" ? "" : head . "`r`n"
    for i, line in rows
        if i > rows.Length - keep
            out .= line . "`r`n"
    return out
}

; @summary Where the run history of a macro file lives: the file name without its extension + ".runs.csv". "" for an unsaved macro.
; @tags macro, history, v25
V25_RunsPath(macroPath) => macroPath = "" ? "" : RegExReplace(macroPath, "\.[^.\\/]*$") . ".runs.csv"

; @summary The runs saved for a macro file (empty array when there is no file or it cannot be read).
; @tags macro, history, v25
V25_ReadRuns(macroPath) {
    path := V25_RunsPath(macroPath)
    if path = "" || !FileExist(path)
        return []
    try
        return V25_ParseRuns(FileRead(path, "UTF-8"))
    catch
        return []
}

; @summary Appends this run to <macro>.runs.csv (written new with its header line when missing) and keeps the last 200
;          lines. Does nothing for an unsaved macro; never raises an error (a read-only folder just means no history).
; @tags macro, playback, history, v25
V25_RecordRun(macroPath, result, seconds, steps, noteSteps) {
    path := V25_RunsPath(macroPath)
    if path = ""
        return
    try {
        if !FileExist(path)
            FileAppend("When,Result,Seconds,Steps,Notes,NoteSteps`r`n", path, "UTF-8-RAW")
        FileAppend(V25_RunLine(result, seconds, steps, noteSteps) . "`r`n", path, "UTF-8-RAW")
        text := FileRead(path, "UTF-8")
        cut := V25_TrimRuns(text)
        if StrLen(cut) != StrLen(text) {
            FileDelete(path)
            FileAppend(cut, path, "UTF-8-RAW")
        }
    }
}

; @summary One line about the newest runs (at most the last 10, runs = oldest first): how many finished / stopped / failed
;          (and at which steps), the usual time (median seconds of the finished runs) and the step with the most notes.
;          Parts that do not apply are left out.
; @tags macro, playback, history, v25
V25_Summary(runs) {
    if !(runs is Array) || !runs.Length
        return "No runs yet."
    first := Max(1, runs.Length - 9)
    n := runs.Length - first + 1
    fin := 0, stopped := 0, failed := 0, failSteps := [], secs := [], noteRuns := Map()
    loop n {
        r := runs[first + A_Index - 1]
        if r["Result"] = "Finished" {
            fin += 1
            secs.Push(r["Seconds"])
        } else if SubStr(r["Result"], 1, 6) = "Failed" {
            failed += 1
            if r["FailStep"] {
                known := false
                for st in failSteps
                    known := known || st = r["FailStep"]
                if !known
                    failSteps.Push(r["FailStep"])
            }
        } else
            stopped += 1
        seen := Map()
        for st in r["NoteSteps"] {
            if !seen.Has(st) {
                seen[st] := 1
                noteRuns[st] := noteRuns.Get(st, 0) + 1
            }
        }
    }
    parts := []
    if fin
        parts.Push(fin . " finished")
    if stopped
        parts.Push(stopped . " stopped")
    if failed {
        failSteps := V25_SortNums(failSteps)
        parts.Push(failed . " failed" . (failSteps.Length ? " (step" . (failSteps.Length > 1 ? "s " : " ") . V4_Join(failSteps, ", ") . ")" : ""))
    }
    text := (n = 1 ? "Last run: " : "Last " . n . " runs: ") . V4_Join(parts, ", ") . "."
    if secs.Length {
        secs := V25_SortNums(secs)
        mid := secs.Length // 2
        median := Mod(secs.Length, 2) ? secs[mid + 1] : (secs[mid] + secs[mid + 1]) / 2
        text .= " Usually " . Round(median) . " s."
    }
    bestStep := 0, bestCount := 0
    for st, c in noteRuns {                     ; a Map walks its keys smallest first, so a tie keeps the lower step
        if c > bestCount
            bestStep := st, bestCount := c
    }
    if bestCount
        text .= " Step " . bestStep . " had notes in " . bestCount . (bestCount = 1 ? " run." : " runs.")
    return text
}

; @summary The steps that were "often shaky": step numbers that had a note in 3 or more of the last 10 runs
;          (runs = oldest first) -> Map step number -> 1.
; @tags macro, playback, history, v25
V25_Shaky(runs) {
    shaky := Map()
    if !(runs is Array)
        return shaky
    counts := Map()
    loop Min(10, runs.Length) {
        seen := Map()
        for st in runs[runs.Length - A_Index + 1]["NoteSteps"] {
            if !seen.Has(st) {
                seen[st] := 1
                counts[st] := counts.Get(st, 0) + 1
            }
        }
    }
    for st, c in counts
        if c >= 3
            shaky[st] := 1
    return shaky
}

; @summary "Run history..." menu entry: a small window with the summary line on top and the runs below, newest first.
; @tags macro, gui, history, v25
V25_ShowHistory(*) {
    static hist := 0
    s := VMB()
    if s.Path = ""
        return VMB_Status("Save the macro first - its run history is kept next to the macro file.")
    runs := V25_ReadRuns(s.Path)
    if IsObject(hist)
        try hist.Destroy()
    hist := Gui("+Owner" . s.Gui.Hwnd, "Run history")
    hist.AddText("w600", V25_Summary(runs))
    lv := hist.AddListView("w600 r12", ["When", "Result", "Time", "Notes"])
    i := runs.Length
    while i >= 1 {
        r := runs[i]
        lv.Add("", r["When"], r["Result"], Format("{:.1f} s", r["Seconds"]),
            r["Notes"] ? r["Notes"] . " (step" . (r["NoteSteps"].Length > 1 ? "s " : " ") . V4_Join(r["NoteSteps"], ", ") . ")" : "")
        i -= 1
    }
    lv.ModifyCol(1, 130), lv.ModifyCol(2, 150), lv.ModifyCol(3, 80), lv.ModifyCol(4, 215)
    close := (*) => hist.Destroy()
    hist.AddButton("Default w80", "Close").OnEvent("Click", close)
    hist.OnEvent("Close", close), hist.OnEvent("Escape", close)
    hist.Show()
}

; ============================================================================
; V26 CHECK THIS PC
; One button runs the V19 scroll / size functions on a Notepad it opens itself, measures the mark characters in the
; tree font, and shows ONE result window of PASS / CHECK lines that can be copied. Deciding PASS / CHECK and building
; the text are plain functions (self-tested); the part that opens Notepad and reads the screen can only be proven on a PC.
; ============================================================================

; @summary One result line: "PASS | text" or "CHECK | text".
; @tags pccheck, v26
V26_Line(ok, text) => (ok ? "PASS" : "CHECK") . " | " . text

; @summary Scroll test verdict from three line positions (0-based, as the scroll bar reports): the one set (want), the
;          one read after scrolling to the top (top) and the one read after the restore (back). "" means not readable.
;          PASS only when the window really moved to the top and came back to want.
; @returns {Ok, Text}
; @tags pccheck, scroll, v26
V26_ScrollVerdict(want, top, back) {
    if want = "" || top = "" || back = ""
        return {Ok: false, Text: "Scroll: could not read the scroll position of the list or text box (set line "
            . (want = "" ? "?" : want + 1) . ", top " . (top = "" ? "?" : top + 1) . ", back " . (back = "" ? "?" : back + 1) . ")."}
    if top = want
        return {Ok: false, Text: "Scroll: Notepad did not scroll to the top, so the restore was not tested (line " . (want + 1) . ")."}
    if back != want
        return {Ok: false, Text: "Scroll: set line " . (want + 1) . ", top line " . (top + 1) . ", but the restore ended at line " . (back + 1) . "."}
    return {Ok: true, Text: "Scroll: read line " . (want + 1) . ", scrolled to the top, restored, back at line " . (back + 1) . "."}
}

; @summary Size test verdict from a V19_SizeTrial / V19_TrialResult object (or "" when there was no window).
; @returns {Ok, Text}
; @tags pccheck, window, v26
V26_SizeVerdict(res) {
    if !IsObject(res)
        return {Ok: false, Text: "Size: no Notepad window to test."}
    if !res.Holds
        return {Ok: false, Text: "Size: Notepad only takes certain sizes (it went back to " . res.W . " x " . res.H . ")."}
    return {Ok: true, Text: "Size: Notepad took a bigger size and went back to the original size."}
}

; @summary Mark characters test: widths (a Map char -> pixels) against the width of "0". A mark more than 1 px away
;          from the "0" width makes the columns drift.
; @returns {Ok, Bad (array of characters), Text}
; @tags pccheck, fonts, v26
V26_MarksVerdict(zeroW, widths) {
    bad := [], list := ""
    for ch, w in widths {
        list .= (list = "" ? "" : "  ") . ch . "=" . w
        if Abs(w - zeroW) > 1
            bad.Push(ch)
    }
    text := "Fonts: width of 0 = " . zeroW . " px; marks " . list . "."
    if bad.Length
        return {Ok: false, Bad: bad, Text: "Fonts: " . V4_Join(bad, " ") . " is not the same width as 0 (" . zeroW
            . " px) in the list font - the Marks column may not line up. Use plain marks (PlainMarks=1). " . list . "."}
    return {Ok: true, Bad: bad, Text: text}
}

; @summary Tree indent test from s.IndentSeen ("char 8 px, asked 24 px, got 24 px, 3 characters"). Nested rows line up
;          when Windows took the indent that was asked for (within 1 px). "" = columns never switched on.
; @returns {Ok, Text}
; @tags pccheck, columns, v26
V26_IndentVerdict(seen) {
    if !(seen is String) || seen = ""
        return {Ok: false, Text: "Indent: not measured yet - switch on Show columns (right-click the list), then run this check again."}
    if !RegExMatch(seen, "asked (\d+) px, got (\d+) px", &m)
        return {Ok: false, Text: "Indent: could not read '" . seen . "'."}
    if Abs(m[2] - m[1]) > 1
        return {Ok: false, Text: "Indent: nested rows may not line up (" . seen . ")."}
    return {Ok: true, Text: "Indent: " . seen . "."}
}

; @summary Screen line: resolution and scaling (100 % = 96 dpi). Other scaling is a CHECK only because the sizes above
;          are where it shows first.
; @returns {Ok, Text}
; @tags pccheck, screen, v26
V26_ScreenVerdict(w, h, dpi) {
    pct := Round(dpi * 100 / 96)
    return {Ok: pct = 100, Text: "Screen: " . w . " x " . h . ", scaling " . pct . " %" . (pct = 100 ? "." : " (not 100 % - tell us if lists or columns look off).")}
}

; @summary Write test result line for the macro folder (ok = the test file could be written, read back and deleted).
; @returns {Ok, Text}
; @tags pccheck, history, v26
V26_WriteVerdict(dir, ok) {
    return {Ok: ok, Text: ok ? "Folder: can write to " . dir . " (run history works)."
        : "Folder: could NOT write to " . dir . " - run history will not be saved there (OneDrive, network drive or read-only?)."}
}

; @summary The text of the whole result: the heading, every line, and a verdict line (how many CHECK).
; @tags pccheck, v26
V26_BuildText(lines, version := "V26") {
    checks := 0, body := ""
    for l in lines {
        if SubStr(l, 1, 5) = "CHECK"
            checks += 1
        body .= l . "`r`n"
    }
    return "Check this PC (" . version . ") - AutoHotkey " . A_AhkVersion . " - Windows " . A_OSVersion . "`r`n" . body
        . (checks ? checks . " line(s) to CHECK." : "All PASS.") . "`r`n"
}

; Stand-in for the macro runner that the V19 scroll functions need (sleep, warnings, settings).
class V26_Runner {
    Settings := Map("restoreScroll", 1)
    Index := 0
    Warnings := []
    Sleep(ms) => Sleep(ms)
}

; @summary Notepad windows that exist right now (hwnd list).
; @tags pccheck, v26
V26_NotepadList() {
    out := Map()
    for h in WinGetList("ahk_class Notepad")
        out[h] := 1
    return out
}

; @summary The size test on a Notepad this check opens itself, and closes again by its hwnd. (The scroll test does not use
;          Notepad any more: V27_ScrollTests uses a separate helper program.) Position and size are put back before closing.
; @returns array of result lines
; @tags pccheck, v26, v27
V26_NotepadTests() {
    lines := []
    before := V26_NotepadList(), hwnd := 0
    try {
        Run("notepad.exe")
        loop 40 {                                   ; up to 10 s for the new window
            Sleep(250)
            for h in WinGetList("ahk_class Notepad")
                if !before.Has(h)
                    hwnd := h
            if hwnd
                break
        }
    }
    if !hwnd {
        lines.Push(V26_Line(false, "Size: could not open Notepad."))
        return lines
    }
    id := "ahk_id " . hwnd, ox := 0, oy := 0, ow := 0, oh := 0, found := false
    try {
        WinGetPos(&ox, &oy, &ow, &oh, id)           ; where Notepad was when this check found it
        found := true
    }
    res := ""
    try res := V19_SizeTrial(hwnd)
    v := V26_SizeVerdict(res)
    lines.Push(V26_Line(v.Ok, v.Text))
    if found
        try WinMove(ox, oy, ow, oh, id)             ; put position AND size back before closing
    try WinClose(id)
    try WinWaitClose(id, , 2)
    if WinExist(id)
        lines.Push(V26_Line(false, "Close: Notepad (the one this check opened) is still open - please close it yourself."))
    else
        lines.Push(V26_Line(true, "Close: the Notepad this check opened is closed."))
    return lines
}

; @summary Width in pixels of text in the tree's font (0 when it cannot be measured).
; @tags pccheck, fonts, v26
V26_TextWidth(ctl, str) {
    hFont := SendMessage(0x31, 0, 0, ctl)                       ; WM_GETFONT
    hdc := DllCall("GetDC", "Ptr", ctl.Hwnd, "Ptr")
    old := DllCall("SelectObject", "Ptr", hdc, "Ptr", hFont, "Ptr")
    ext := Buffer(8, 0)
    DllCall("GetTextExtentPoint32W", "Ptr", hdc, "Str", str, "Int", StrLen(str), "Ptr", ext)
    DllCall("SelectObject", "Ptr", hdc, "Ptr", old, "Ptr")
    DllCall("ReleaseDC", "Ptr", ctl.Hwnd, "Ptr", hdc)
    return NumGet(ext, 0, "Int")
}

; @summary Writes a small test file into the macro folder, reads it back and deletes it.
; @returns true when all three worked
; @tags pccheck, history, v26
V26_CanWrite(dir) {
    path := dir . "\pccheck-" . A_TickCount . ".tmp"
    try {
        DirCreate(dir)
        FileAppend("ok", path, "UTF-8-RAW")
        got := FileRead(path, "UTF-8")
        FileDelete(path)
        return got = "ok"
    }
    try FileDelete(path)
    return false
}

; @summary "Check this PC" (? button and right-click menu): runs the checks by itself and shows one result window.
; @tags pccheck, gui, v26
V26_CheckPC(*) {
    static win := 0
    s := VMB()
    VMB_Status("Check this PC: running (about 20 seconds). Please do not touch the mouse or keyboard.")
    lines := [], bad := []
    for l in V27_ScrollTests()                  ; scroll: a separate helper program (V27)
        lines.Push(l)
    for l in V26_NotepadTests()                 ; size: Notepad
        lines.Push(l)
    marks := V22_MarkChars(0)
    zeroW := 0, widths := Map()
    try {
        zeroW := V26_TextWidth(s.TV, "0")
        for key, ch in marks
            widths[ch] := V26_TextWidth(s.TV, ch)
    }
    if zeroW < 1
        lines.Push(V26_Line(false, "Fonts: could not measure the list font."))
    else {
        v := V26_MarksVerdict(zeroW, widths)
        lines.Push(V26_Line(v.Ok, v.Text)), bad := v.Bad
    }
    v := V26_IndentVerdict(s.IndentSeen), lines.Push(V26_Line(v.Ok, v.Text))
    v := V26_ScreenVerdict(A_ScreenWidth, A_ScreenHeight, A_ScreenDPI), lines.Push(V26_Line(v.Ok, v.Text))
    v := V26_WriteVerdict(s.Dir, V26_CanWrite(s.Dir)), lines.Push(V26_Line(v.Ok, v.Text))
    text := V26_BuildText(lines)
    if IsObject(win)
        try win.Destroy()
    win := Gui("+Owner" . s.Gui.Hwnd, "Check this PC")
    win.SetFont("s9", "Consolas")
    win.AddEdit("w760 r" . Min(20, lines.Length + 4) . " ReadOnly -Wrap", text)
    win.SetFont()
    copyBtn := win.AddButton("w80 Default", "Copy")
    copyBtn.OnEvent("Click", (*) => (A_Clipboard := text, VMB_Status("Check this PC: result copied - paste it back to us.")))
    if bad.Length {
        plain := win.AddButton("x+8 w120", "Use plain marks")
        plain.OnEvent("Click", (*) => (IniWrite(1, s.Ini, "V22", "PlainMarks"), plain.Enabled := false,
            VMB_Status("Plain marks are on after the next start of this program.")))
    }
    close := (*) => win.Destroy()
    win.AddButton("x+8 w80", "Close").OnEvent("Click", close)
    win.OnEvent("Close", close), win.OnEvent("Escape", close)
    win.Show()
    VMB_Status("Check this PC: done. Press Copy and paste the result back to us.")
}

; @summary "?" button: a small menu - the help text, or Check this PC.
; @tags pccheck, gui, v26
V26_HelpMenu(*) {
    m := Menu()
    m.Add("Help", VMB_Help)
    m.Add("Check this PC...", V26_CheckPC)
    m.Show()
}

; ============================================================================
; V27 - Excel-style step grid (V26 review fixes, cell data)
; ============================================================================

; @summary Text of the small helper program used by the "Check this PC" scroll test: a 300-row list box (left) and
;          a 300-line text box (right), both with a scroll bar. It is a separate program, like any other window.
; @tags pccheck, scroll, v27
V27_ScrollHelperText() {
    lines := [
        "g := Gui(, `"VMB scroll test helper`")",
        "lb := g.Add(`"ListBox`", `"x10 y10 w300 h300 VScroll`")",
        "rows := []",
        "loop 300",
        "    rows.Push(`"Row `" A_Index)",
        "lb.Add(rows)",
        "ed := g.Add(`"Edit`", `"x330 y10 w300 h300 Multi VScroll`")",
        "text := `"`"",
        "loop 300",
        "    text .= `"Line `" A_Index Chr(13) Chr(10)",
        "ed.Value := text",
        "g.Show(`"x120 y120 w650 h330`")"
    ]
    out := ""
    for l in lines
        out .= l . "`r`n"
    return out
}

; @summary The scroll test on the list box and the text box of the helper program. The helper is started by this check
;          and closed again by its process id; its temporary script file is deleted.
; @returns array of result lines (one per control, plus a close line)
; @tags pccheck, scroll, v27
V27_ScrollTests() {
    lines := [], pid := 0, hwnd := 0
    path := A_Temp . "\VMB-scroll-helper-" . A_TickCount . ".ahk"
    q := Chr(34)
    try {
        FileAppend(V27_ScrollHelperText(), path)
        Run(q . A_AhkPath . q . " " . q . path . q, , , &pid)
        hwnd := WinWait("VMB scroll test helper ahk_pid " . pid, , 10)
    }
    if !hwnd {
        lines.Push(V26_Line(false, "Scroll (list box): could not open the test list window."))
        lines.Push(V26_Line(false, "Scroll (text box): could not open the test list window."))
    } else {
        id := "ahk_id " . hwnd, lbBox := 0, edBox := 0
        try WinActivate(id)
        try {
            lbBox := ControlGetHwnd("ListBox1", id)
            edBox := ControlGetHwnd("Edit1", id)
        }
        lines.Push(V27_ScrollLine("list box", V27_ScrollOne(lbBox, id, 10, false)))
        lines.Push(V27_ScrollLine("text box", V27_ScrollOne(edBox, id, 330, true)))
    }
    closed := true
    if pid {
        try ProcessClose(pid)
        try ProcessWaitClose(pid, 2)
        closed := !ProcessExist(pid)
    }
    try FileDelete(path)
    if closed
        lines.Push(V26_Line(true, "Close: the test list window this check opened is closed."))
    else
        lines.Push(V26_Line(false, "Close: the test list is still running - please close it yourself."))
    return lines
}

; @summary One control of the helper: sets it to line 150, scrolls it to the top with the V19 code, restores it the way
;          playback does, and reads the position at each step. offX = the control's left edge inside the window.
; @returns the V26_ScrollVerdict result
; @tags pccheck, scroll, v27
V27_ScrollOne(ctl, id, offX, isEdit) {
    want := "", top := "", back := ""
    try {
        if isEdit
            SendMessage(0xB6, 0, 149, ctl, , , , , 500)        ; EM_LINESCROLL: first visible line = 150
        else
            SendMessage(0x197, 149, 0, ctl, , , , , 500)       ; LB_SETTOPINDEX: first visible item = 150
        Sleep(300)
        want := V19_ScrollPos(ctl, 1)
        WinGetClientPos(&cx, &cy, , , id)
        point := {X: cx + offX + 40, Y: cy + 40}
        rec := V19_CaptureScroll(point.X, point.Y)
        runner := V26_Runner()
        V19_ScrollTo(ctl, 1, 0, runner)
        top := V19_ScrollPos(ctl, 1)
        Sleep(200)
        V19_RestoreScroll(Map("type", "click", "scroll", rec), point, runner)
        back := V19_ScrollPos(ctl, 1)
    }
    return V26_ScrollVerdict(want, top, back)
}

; @summary The scroll verdict line with the control's name in it, e.g. "Scroll (list box): read line 150 ...".
; @tags pccheck, scroll, v27
V27_ScrollLine(name, v) => V26_Line(v.Ok, "Scroll (" . name . "): " . SubStr(v.Text, 9))

; ----------------------------------------------------------------------------
; V27 item A: the cell data of the step grid (pure: no windows, no mouse)
; ----------------------------------------------------------------------------

; @summary The grid's columns in order. Key = the cell key, Title = header text, Width = start width in pixels,
;          Num = 1 when the column sorts as a number.
; @tags grid, cells, v27
V27_Columns() {
    return [
        {Key: "num", Title: "#", Width: 40, Num: 1},
        {Key: "inside", Title: "Inside", Width: 220, Num: 0},
        {Key: "app", Title: "Program", Width: 110, Num: 0},
        {Key: "window", Title: "Window", Width: 120, Num: 0},
        {Key: "winsize", Title: "Window size", Width: 110, Num: 0},
        {Key: "action", Title: "Action", Width: 100, Num: 0},
        {Key: "target", Title: "On what", Width: 200, Num: 0},
        {Key: "text", Title: "Text / keys", Width: 220, Num: 0},
        {Key: "button", Title: "Button", Width: 70, Num: 0},
        {Key: "clicks", Title: "Clicks", Width: 60, Num: 1},
        {Key: "held", Title: "Held keys", Width: 100, Num: 0},
        {Key: "x", Title: "X", Width: 60, Num: 1},
        {Key: "y", Title: "Y", Width: 60, Num: 1},
        {Key: "zone", Title: "Where", Width: 130, Num: 0},
        {Key: "anchor", Title: "Follows", Width: 150, Num: 0},
        {Key: "wait", Title: "Waits first", Width: 90, Num: 0},
        {Key: "repeats", Title: "Repeats", Width: 90, Num: 0},
        {Key: "when", Title: "Only when", Width: 190, Num: 0},
        {Key: "failstep", Title: "If it fails", Width: 150, Num: 0},
        {Key: "scroll", Title: "Scroll back", Width: 110, Num: 0},
        {Key: "check", Title: "Checks picture", Width: 90, Num: 0},
        {Key: "lastrun", Title: "Last run", Width: 160, Num: 0},
        {Key: "shaky", Title: "Often shaky", Width: 100, Num: 0},
        {Key: "onoff", Title: "On", Width: 50, Num: 0},
        {Key: "note", Title: "Note", Width: 220, Num: 0}
    ]
}

; @summary The cell texts of one step (one grid row). Every column key always has a value: "–" (en dash) when it does not
;          apply. ctx = Map with Num, App, Inside, LastNote, HasRun, Shaky, History, Size, Settings (missing keys = defaults).
;          Size is the size carried from an earlier step of the same program (used when this step has no size of its own).
; @returns Map Key -> text
; @tags grid, cells, v27
V27_Cells(node, ctx) {
    t := node.Get("type", "")
    mouse := t = "click" || t = "drag"
    geo := node.Get("geo", "")
    hasGeo := geo is Map
    own := V27_OwnSize(node)
    m := Map()
    m["num"] := ctx.Get("Num", "")
    m["inside"] := ctx.Get("Inside", "")
    m["app"] := ctx.Get("App", "")
    m["window"] := V27_WindowText(node, V27_MainClass(ctx.Get("Settings", "")))
    m["winsize"] := own != "" ? own : ctx.Get("Size", "")
    m["action"] := V27_ActionText(node)
    m["target"] := V27_TargetText(node)
    m["text"] := V27_TextText(node)
    if t = "text" && !V4_Bool(node.Get("ask", 0)) {            ; V30: =Column → "Smith" when the macro has a list (the preview row)
        st := ctx.Get("Settings", "")
        if st is Map {
            lst := V30_ListOf(st), rm := String(st.Get("runMode", "once"))
            if lst is Map || rm = "list" || rm = "times" || V31_ValuesOf(st).Length {
                pn := ctx.Get("Preview", 1)
                pc := V30_TextCell(node.Get("text", ""), V31_NamesAll(st), V31_PreviewRow(st, pn), pn)
                if pc != ""
                    m["text"] := pc
            }
        }
    }
    m["repeats"] := ctx.Get("Blocks", "") is Array ? V30_RepeatsText(ctx["Blocks"], node) : ""
    m["when"] := V31_WhenCell(node, ctx.Get("Gate", ""), ctx.Get("Info", ""), ctx.Get("Settings", ""), ctx.Get("Preview", 1))
    m["failstep"] := V31_FailText(node.Get("onFailStep", ""))
    m["button"] := mouse ? node.Get("button", "Left") : ""
    m["clicks"] := mouse ? String(Integer(node.Get("count", 1))) : ""
    m["held"] := mouse ? V27_HeldText(node.Get("mods", "")) : ""
    m["x"] := (hasGeo && geo.Has("cx")) ? geo["cx"] : (node.Has("scrX") ? node["scrX"] : "")
    m["y"] := (hasGeo && geo.Has("cy")) ? geo["cy"] : (node.Has("scrY") ? node["scrY"] : "")
    m["zone"] := (hasGeo && geo.Has("cx") && geo.Has("cy") && geo.Has("cw") && geo.Has("ch")) ? V20_Zone(geo["cx"], geo["cy"], geo["cw"], geo["ch"]) : ""
    m["anchor"] := hasGeo ? SubStr(V14_AnchorText(geo), 6) : (node.Has("scrX") ? "screen spot" : "")
    w := V22_WaitText(node)
    m["wait"] := w = "" ? "0" : w
    m["scroll"] := V27_ScrollText(node.Get("scroll", ""), t = "click" || t = "drag" || t = "wheel")
    m["check"] := mouse ? V27_CheckText(node, ctx.Get("Settings", "")) : ""
    m["lastrun"] := V27_LastRunText(ctx)
    m["shaky"] := V27_ShakyText(ctx)
    m["onoff"] := V4_Bool(node.Get("disabled", 0)) ? "off" : "on"
    m["note"] := node.Get("note", "")
    for col in V27_Columns() {
        txt := String(m.Get(col.Key, ""))
        m[col.Key] := txt = "" ? "–" : txt
    }
    return m
}

; @summary Window class of the macro's Macro-window setting (defaultTarget, e.g. "ahk_class Notepad ahk_exe notepad.exe"); "" when none.
; @tags grid, cells, v27
V27_MainClass(settings) {
    if !(settings is Map)
        return ""
    if RegExMatch(String(settings.Get("defaultTarget", "")), "i)ahk_class\s+(\S+)", &mm)
        return mm[1]
    return ""
}

; @summary Kind of window a step uses, in plain words: "main window" (this program's own class), "dialog", "menu",
;          else the class name. Use Window / Normalize steps show their target's class. "" when none.
; @tags grid, cells, v27
V27_WindowText(node, mainCls := "") {
    t := node.Get("type", "")
    cls := ""
    if t = "det_use_window" || t = "det_normalize_win" {
        if RegExMatch(String(node.Get("target", "")), "i)ahk_class\s+(\S+)", &mm)
            cls := mm[1]
    } else {
        win := node.Get("win", "")
        if win is Map
            cls := win.Get("cls", "")
    }
    if cls = ""
        return ""
    if mainCls != "" && cls = mainCls
        return "main window"
    if cls = "#32770"
        return "dialog"
    if cls = "#32768"
        return "menu"
    return cls
}

; @summary The window size a step records itself: "W × H" (or "maximized"); for Normalize its own size. "" when none.
; @tags grid, cells, v27
V27_OwnSize(node) {
    if node.Get("type", "") = "det_normalize_win" {
        if V4_Bool(node.Get("maximize", 0))
            return "maximized"
        return (node.Has("width") && node.Has("height")) ? node["width"] . " × " . node["height"] : ""
    }
    geo := node.Get("geo", "")
    if geo is Map {
        if V4_Bool(geo.Get("max", 0))
            return "maximized"
        if geo.Has("ww") && geo.Has("wh")
            return geo["ww"] . " × " . geo["wh"]
    }
    return ""
}

; @summary The Action column: one word group for what the step does.
; @tags grid, cells, v27
V27_ActionText(node) {
    t := node.Get("type", "")
    if t = "click" {
        if node.Get("button", "Left") = "Right"
            return "Right-click"
        return Integer(node.Get("count", 1)) >= 2 ? "Double-click" : "Click"
    }
    switch t {
        case "drag": return "Drag"
        case "wheel": return "Scroll"
        case "text": return "Type"
        case "keys": return "Press"
        case "delay", "wait": return "Wait"
        case "det_use_window", "det_normalize_win": return "Window"
        case "det_wait_window": return "Wait"
        case "set": return V31_IsRemember(node) ? "Remember" : "Other"
        case "stop":
            a := node.Get("action", "break")
            return a = "continue" ? "Skip this row" : a = "endrun" ? "Stop the run" : "Other"
    }
    if SubStr(t, 1, 4) = "web_"
        return "Web"
    return "Other"
}

; @summary The On what column: the clicked thing in words (clicks, drags) or the web selector name (web steps).
; @tags grid, cells, v27
V27_TargetText(node) {
    t := node.Get("type", "")
    if t = "click" || t = "drag"
        return V20_WhatText(node)
    if SubStr(t, 1, 4) = "web_"
        return V21_SelectorName(node.Get("selector", ""))
    return ""
}

; @summary The Text / keys column: typed text in quotes (never the text of an ask-each-run step), the key words of a
;          key step, "down × 3" for a wheel step. "" for other steps.
; @tags grid, cells, v27
V27_TextText(node) {
    t := node.Get("type", "")
    q := Chr(34)
    if t = "text" {
        if V4_Bool(node.Get("ask", 0))
            return "(asks each run)"
        return q . V20_Short(node.Get("text", ""), 50) . q
    }
    if t = "keys"
        return V20_KeysText(node.Get("keys", ""))
    if t = "wheel"
        return StrLower(RegExReplace(node.Get("direction", "WheelDown"), "i)^Wheel")) . " × " . Integer(node.Get("count", 1))
    if t = "det_wait_window"
        return V31_WaitText(node)
    if V31_IsRemember(node)
        return V31_RememberText(node, V31_NamesAllNow())
    return ""
}

; @summary The Held keys column for a mouse step: Ctrl, Shift, Ctrl+Shift, or "none".
; @tags grid, cells, v27
V27_HeldText(mods) {
    ctrlOn := InStr(mods, "^") > 0, shiftOn := InStr(mods, "+") > 0
    if ctrlOn && shiftOn
        return "Ctrl+Shift"
    if ctrlOn
        return "Ctrl"
    return shiftOn ? "Shift" : "none"
}

; @summary The Scroll back column: "row N" (and ", col N") from the recorded scroll position (0-based, so row = pos + 1);
;          "no" for a mouse step without one; "" for other steps.
; @tags grid, cells, v27
V27_ScrollText(sc, mouse) {
    if sc is Map {
        txt := sc.Has("v") ? "row " . (sc["v"] + 1) : ""
        if sc.Has("h")
            txt .= (txt = "" ? "" : ", ") . "col " . (sc["h"] + 1)
        return txt != "" ? txt : "yes"
    }
    return mouse ? "no" : ""
}

; @summary The Checks picture column for a click / drag: "yes" when the macro is steady, verify clicks is on, the step has a
;          picture and the picture still belongs to the spot (noVerify not set); else "no".
; @tags grid, cells, v27
V27_CheckText(node, settings) {
    if !(settings is Map)
        return "no"
    ok := V4_Bool(settings.Get("steady", 0)) && settings.Get("verifyClicks", 1) != 0 && node.Get("pattern", "") != "" && !V4_Bool(node.Get("noVerify", 0))
    return ok ? "yes" : "no"
}

; @summary The Last run column: "not run yet", "ok", or the note of the last run (step number removed, 60 characters).
; @tags grid, cells, v27
V27_LastRunText(ctx) {
    if !ctx.Get("HasRun", false)
        return "not run yet"
    note := String(ctx.Get("LastNote", ""))
    return note = "" ? "ok" : V20_Short(RegExReplace(note, "^Step #\d+:?\s*"), 60)
}

; @summary The Often shaky column from the run history: "yes" / "no", or "no history" when there is no history.
; @tags grid, cells, v27
V27_ShakyText(ctx) {
    if !ctx.Get("History", false)
        return "no history"
    return ctx.Get("Shaky", false) ? "yes" : "no"
}

; @summary The Inside column: the chain of blocks a step is in, e.g. "Repeat 5 › If amount is 250"; "–" at top level.
; @tags grid, cells, v27
V27_InsideText(chain) => chain.Length = 0 ? "–" : V4_Join(chain, " › ")

; @summary The text of a control block for the Inside chain: its line without the "(n steps inside)" part and without a note.
; @tags grid, cells, v27
V27_BlockLabel(node) {
    line := V21_BlockLine(node)
    line := RegExReplace(line, "\s+\((no steps inside yet|\d+ steps? inside)\)", "")
    p := InStr(line, "  // ")
    return Trim(p ? SubStr(line, 1, p - 1) : line)
}

; @summary The Inside label for one child list of a block: an IF has its own line for the first list, "Otherwise, if ..."
;          for each ELSE IF and "Otherwise" for the ELSE list; other blocks use their own line.
; @tags grid, cells, v27
V27_ChildLabel(node, i) {
    if node.Get("type", "") != "if"
        return V27_BlockLabel(node)
    alts := node.Get("elifs", "")
    n := alts is Array ? alts.Length : 0
    if i = 1
        return V27_BlockLabel(node)
    if i <= 1 + n
        return "Otherwise, if " . V21_CondText(alts[i - 1])
    return "Otherwise"
}

; @summary A new chain = chain + label (the chain is never changed in place).
; @tags grid, cells, v27
V27_Extend(chain, label) {
    out := []
    for x in chain
        out.Push(x)
    out.Push(label)
    return out
}

; @summary Walks the blocks in the same order as VMF_Flatten (a node, then its child lists), and records for each node
;          the chain of control blocks it is inside. items = array of nodes (containers too), chains = Map node -> chain.
; @tags grid, cells, v27
V27_Walk(list, chain, items, chains) {
    for node in list {
        if !(node is Map)
            continue
        items.Push(node)
        chains[node] := chain
        if VMF_IsContainer(node) {
            kids := VMF_Children(node)
            for i, kid in kids
                V27_Walk(kid, V27_Extend(chain, V27_ChildLabel(node, i)), items, chains)
        }
    }
}

; @summary One row per step (containers are not rows; they show in the Inside column), in step order. Each row is a Map
;          Key -> text (see V27_Columns) and also has .Node = the step's node, so the grid can find the step.
;          The "#" is the same number the tree shows. state = Map with LastNotes (number -> note), Shaky (number -> 1),
;          Open (program exe -> 1 for running programs), HasRun, History.
; @returns array of row Maps
; @tags grid, cells, v27
V27_Rows(blocks, settings, state) {
    items := [], chains := Map()
    V27_Walk(blocks, [], items, chains)
    apps := V22_FillApps(items, settings)
    openExes := state.Get("Open", Map())
    V24_MarkApps(apps.App, openExes, items)
    rows := [], carry := Map()
    v31Gates := V31_PreviewFor(blocks, settings, state.Get("Preview", 1)), v31Infos := V31_MacroInfos(blocks)
    for i, node in items {
        if VMF_IsContainer(node)
            continue
        app := apps.App.Get(node, "")
        own := V27_OwnSize(node)
        if own != ""
            carry[app] := own
        ctx := Map("Num", i, "App", app, "Inside", V27_InsideText(chains[node]),
            "LastNote", state.Get("LastNotes", Map()).Get(i, ""), "HasRun", state.Get("HasRun", false),
            "Shaky", state.Get("Shaky", Map()).Has(i), "History", state.Get("History", false),
            "Size", own != "" ? own : carry.Get(app, ""), "Settings", settings, "Preview", state.Get("Preview", 1), "Blocks", blocks,
            "Gate", v31Gates.Get(node, ""), "Info", v31Infos.Get(node, ""))
        row := V27_Cells(node, ctx)
        row.Node := node
        row.Grey := v31Gates.Has(node) && v31Gates[node].Skip, row.Chain := v31Infos.Has(node) ? v31Infos[node].Chain : 0
        rows.Push(row)
    }
    return rows
}

; ----------------------------------------------------------------------------
; V27 item B: the grid in the window (a ListView where the tree is; the tree stays the source of truth)
; ----------------------------------------------------------------------------

; @summary Builds the grid ListView and the [List] [Grid] buttons (called once at the end of VMB_BuildGui). The grid is
;          s.GridLV (not in s.Ctl); the two buttons are c["ViewList"] / c["ViewGrid"]. Placed by V27_PlaceGrid.
; @tags grid, gui, v27
V27_BuildGrid(g) {
    s := VMB(), c := s.Ctl
    s.View := IniRead(s.Ini, "V27", "View", "grid") = "list" ? "list" : "grid"
    s.Bands := IniRead(s.Ini, "V32", "Bands", "1") != "0"           ; V32: band rows for hand-made loop / If blocks (ini [V32] Bands=0 switches them off)
    c["ViewList"] := g.AddButton("x10 y10 w46 h20", "List")
    c["ViewGrid"] := g.AddButton("x+4 yp w46 h20", "Grid")
    c["ViewList"].OnEvent("Click", (*) => V27_SetView("list"))
    c["ViewGrid"].OnEvent("Click", (*) => V27_SetView("grid"))
    titles := []
    for col in V27_Columns()
        titles.Push(V32_HeadTitle(col.Title, "", false))         ; V32: every title has the filter arrow
    s.GridLV := g.AddListView("x10 y40 w600 h300 Grid -Multi +LV0x10000 +LV0x10 Hidden", titles)    ; V29: +LV0x10 = columns can be dragged to reorder
    s.GridZoom := V29_ClampZoom(IniRead(s.Ini, "V29", "GridZoom", 100))
    V29_LoadCols()
    V27_ApplyGridFont()
    V29_ApplyColWidths()
    s.GridLV.OnEvent("ColClick", V27_OnColClick)
    b := s.GridBar := Map()
    b["Filter"] := g.AddEdit("x10 y10 w200 h22 Hidden")
    SendMessage(0x1501, 1, StrPtr("Filter..."), b["Filter"])       ; EM_SETCUEBANNER
    b["Filter"].OnEvent("Change", V27_OnFilter)
    b["Prog"] := g.AddDropDownList("x+4 yp w120 Hidden", ["All programs"])
    b["Act"] := g.AddDropDownList("x+4 yp w104 Hidden", ["All actions"])
    b["Prog"].Choose(1), b["Act"].Choose(1)
    b["Prog"].OnEvent("Change", V27_OnPick)
    b["Act"].OnEvent("Change", V27_OnPick)
    b["Clear"] := g.AddButton("x+4 yp w54 h22 Hidden", "Clear")
    b["Clear"].OnEvent("Click", (*) => V27_ClearFilter())
    b["Reset"] := g.AddButton("x10 y10 w84 h22 Hidden", "Step order")
    b["Reset"].OnEvent("Click", (*) => V27_SortReset())
    b["Copy"] := g.AddButton("x+4 yp w84 h22 Hidden", "Copy table")
    b["Copy"].OnEvent("Click", (*) => V27_CopyTable())
    b["Name"] := g.AddEdit("x10 y10 w150 h22 ReadOnly Hidden")                         ; V29: name box, like Excel's
    b["ZMinus"] := g.AddButton("x10 y10 w24 h22 Hidden", "−")                          ; V29: zoom control, like Excel's status bar
    b["ZPct"] := g.AddButton("x+2 yp w50 h22 Hidden", s.GridZoom . "%")
    b["ZPlus"] := g.AddButton("x+2 yp w24 h22 Hidden", "+")
    b["ZMinus"].OnEvent("Click", (*) => V29_ZoomBy(-1))
    b["ZPlus"].OnEvent("Click", (*) => V29_ZoomBy(1))
    b["ZPct"].OnEvent("Click", (*) => V29_SetZoom(100))
    s.GridLV.OnEvent("ItemSelect", V27_OnSelect)
    s.GridLV.OnEvent("DoubleClick", V27_OnDoubleClick)
    s.GridLV.OnEvent("ContextMenu", V27_OnMenu)
    V30_Build(g)                                   ; V30: the Run line, the sheet tabs and the List sheet
}

; @summary Puts the grid exactly on the tree's place (same position and size), shows the grid or the tree for the
;          current view, hides the column header line in grid view, puts the [List] [Grid] buttons at the right end
;          of the header line and greys the button of the view that is on. Safe when there is no grid (hidden test windows).
; @tags grid, gui, v27
V27_PlaceGrid() {
    s := VMB()
    if !s.GridLV || !s.TV || !s.Gui || !s.Ctl.Has("ViewGrid")
        return
    V28_Finish()                                   ; V28: the cell editor would sit on the old place
    grid := s.View = "grid"
    if s.FindOn && (!grid || s.FindSheet != s.Sheet)
        s.FindOn := false                           ; V32: Find belongs to the sheet it was opened on
    s.TV.GetPos(&tx, &ty, &tw, &th)
    barH := Round(24 * A_ScreenDPI / 96)
    runH := grid ? barH + 4 : 0                    ; V30: the Run line is the top row, the filter row (V27 C/D/E) sits under it
    tabH := grid ? 28 : 0                          ; V30: the Steps / List tabs sit under the grid
    findH := grid && s.FindOn ? barH + 4 : 0       ; V32: the Find bar is one more row above the grid
    gy := grid ? ty + runH + barH + 4 + findH : ty
    gh := Max(40, th - (gy - ty) - tabH)
    s.GridLV.Move(tx, gy, tw, gh)
    V27_PlaceBar(tx, ty + runH, tw, barH, grid && s.Sheet = "steps")
    V30_Place(tx, ty, tw, gy, gh, barH, grid)
    V32_PlaceFind(tx, ty + runH + barH + 4, tw, grid && s.FindOn)
    hy := ty - 16
    if s.Ctl.Has("ColHead")
        s.Ctl["ColHead"].GetPos(, &hy)
    bh := Max(16, ty - hy)
    s.Ctl["ViewGrid"].Move(tx + tw - 46, hy, 46, bh)
    s.Ctl["ViewList"].Move(tx + tw - 96, hy, 46, bh)
    s.Ctl["ViewGrid"].Enabled := !grid
    s.Ctl["ViewList"].Enabled := grid
    if s.Ctl.Has("ColHead") && grid
        s.Ctl["ColHead"].Visible := false
    s.TV.Visible := !grid
    s.GridLV.Visible := grid && s.Sheet = "steps"
    V33_FreezeTick(true)                                       ; V33: the frozen pane follows the grid's place
}

; @summary Switches between the tree (list) and the grid, remembers the choice in the ini ([V27] View).
; @tags grid, gui, v27
V27_SetView(view) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    if s.View = view
        return
    V28_Cancel(false)
    V29_SaveCols()
    node := V27_SelectedNode()
    s.View := view
    IniWrite(view, s.Ini, "V27", "View")
    if view = "grid"
        V27_FillGrid()
    V22_PlaceHeader()
    V27_PlaceGrid()
    VMB_Status(view = "grid" ? "Grid view: one row per step. The steps and their order are the same as in the list."
        : "List view.")
}

; @summary The node selected in the tree (the tree is always the source of truth), or 0.
; @tags grid, gui, v27
V27_SelectedNode() {
    s := VMB()
    info := s.TV ? s.Items.Get(s.TV.GetSelection(), 0) : 0
    return info && info.HasOwnProp("Node") ? info.Node : 0
}

; @summary The state V27_Rows needs, taken from the editor (last run notes, run history, running programs).
; @tags grid, gui, v27
V27_State() {
    s := VMB()
    return Map("LastNotes", s.LastNotes, "Shaky", s.Shaky, "Open", s.OpenExes is Map ? s.OpenExes : Map(),
        "HasRun", s.HasRun, "History", s.History, "Preview", s.PreviewRow)
}

; @summary Fills the grid with rows (default: all steps in step order). A later sort / filter passes its own row array.
;          Keeps s.GridRows (the rows shown), s.GridNodes (grid row number -> step node) and s.GridRowOf (node -> row),
;          then selects the row of the tree's selected step. Column widths are fitted to the content on the first fill
;          that has rows (not below the start width of V27_Columns, capped at 320 px for the long text columns).
; @tags grid, gui, v27
V27_FillGrid(rows := "") {
    s := VMB()
    lv := s.GridLV
    if !lv || !(s.Macro is Map)
        return
    V28_Cancel(false)                   ; V28: the rows change under the editor
    V32_ClosePopup()                    ; V32: so does an open header filter list
    keep := V27_SelectedNode()
    if !IsObject(rows) {
        s.GridAll := V27_Rows(s.Macro["blocks"], s.Macro["settings"], V27_State())
        s.GridBands := V32_MakeBands(s.Macro["blocks"], s.GridAll)     ; V32: band rows for hand-made loop / If blocks (step order only)
        V27_BarLists()
        rows := V27_ViewRows()          ; sort / filter are only a view: the rows are the same, in another order or fewer
    }
    cols := V27_Columns()
    s.GridRows := rows, s.GridNodes := Map(), s.GridRowOf := Map(), s.GridMark := Map()
    s.GridSync := true
    lv.Opt("-Redraw")
    lv.Delete()
    for r in rows {
        cells := []
        for col in cols
            cells.Push(r.Get(col.Key, "–"))
        n := lv.Add("", cells*)
        s.GridNodes[n] := r.Node
        if IsObject(r.Node) && !s.GridRowOf.Has(r.Node)
            s.GridRowOf[r.Node] := n
        isBand := r.HasOwnProp("Band") && r.Band
        if (r.HasOwnProp("Grey") && r.Grey) || (r.HasOwnProp("Chain") && r.Chain) || isBand      ; V31: greyed (left out for the preview row) / chain colour bar; V32: band row
            s.GridMark[n] := {Grey: r.HasOwnProp("Grey") && r.Grey, Chain: r.HasOwnProp("Chain") ? r.Chain : 0, Band: isBand}
    }
    if rows.Length && !s.GridSized {
        s.GridSized := true
        capped := Map("text", 1, "target", 1, "inside", 1, "note", 1, "lastrun", 1, "when", 1)
        for i, col in cols {
            if s.GridHidden.Has(col.Key)                        ; V29: a hidden column stays hidden
                continue
            lv.ModifyCol(i, "AutoHdr")
            wide := SendMessage(0x101D, i - 1, 0, lv)           ; LVM_GETCOLUMNWIDTH
            if wide < col.Width                                 ; never narrower than the start width
                lv.ModifyCol(i, col.Width)
            else if capped.Has(col.Key) && wide > 320
                lv.ModifyCol(i, 320)
        }
        V29_CaptureWidths()                                     ; V29: remember the fitted widths at 100 %
    }
    lv.Opt("+Redraw")
    s.GridSync := false
    V27_SortMarks()
    V27_ShowNode(keep, false)
    s.FrzDirty := true                                         ; V33: the frozen pane copies the new rows
    V33_FreezeTick()
}

; @summary Selects (and scrolls to) the grid row of a step. propagate = false: the tree is not touched (it already
;          has the selection, or - while playing - must keep it).
; @tags grid, gui, v27
V27_ShowNode(node, propagate := false) {
    s := VMB()
    if !s.GridLV || !IsObject(node) || !s.GridRowOf.Has(node)
        return
    s.GridSync := !propagate
    try s.GridLV.Modify(s.GridRowOf[node], "Select Focus Vis")
    s.GridSync := false
    V29_CursorRedraw()
}

; @summary Grid row selected: select the same step in the (hidden) tree so every button keeps working.
; @tags grid, gui, v27
V27_OnSelect(lv, row, selected) {
    s := VMB()
    if selected
        V29_CursorRedraw()                                     ; V29: name box follows the selected row
    if !selected || s.GridSync || !row
        return
    node := s.GridNodes.Get(row, 0)
    V32_OnPick(node)                                           ; V32: Shift+click extends the row range, a plain click ends it
    if IsObject(node) && s.NodeItem.Has(node)
        s.TV.Modify(s.NodeItem[node], "Select")
}

; @summary Double-click a grid row: Edit that step.
; @tags grid, gui, v27
V27_OnDoubleClick(lv, row) {
    if !row
        return
    hit := V28_HitCell()                           ; V28: an editable cell opens the cell editor, any other cell the full Edit box
    if hit.Row = row && hit.Col >= 1 && hit.Col <= V27_Columns().Length {
        VMB().GridCol := hit.Col
        node := VMB().GridNodes.Get(row, 0)
        if IsObject(node) && V28_Editable(node, V27_Columns()[hit.Col].Key) != "" && V28_Open(row, hit.Col)
            return
    }
    VMB_EditSelected()
}

; @summary Right-click a grid row: the same menu as the tree for that step.
; @tags grid, gui, v27
V27_OnMenu(lv, row, isRight, x, y) {
    s := VMB()
    if V29_OnHeader(x, y)                          ; V29: right-click on the column heading = hide / show columns
        return V29_ColMenu(x, y)
    if row && V31_CellMenu(row, x, y)              ; V31: the Only when cell has its own menu (build a rule, otherwise, always)
        return
    if row && V30_TextMenu(row, x, y)              ; V30: the Text cell of a Type step has its own small menu
        return
    if row && V32_RowMenu(row, x, y)               ; V32: Insert / Duplicate / Delete / Move / Turn off for the row (or the row range)
        return
    node := row ? s.GridNodes.Get(row, 0) : 0
    if IsObject(node) && s.NodeItem.Has(node) {
        s.GridSync := true
        lv.Modify(row, "Select Focus")
        s.GridSync := false
        s.TV.Modify(s.NodeItem[node], "Select")
        VMB_TreeMenu(s.TV, s.NodeItem[node], isRight, x, y)
    }
}

; ----------------------------------------------------------------------------
; V27 item C: sort (a view only: the macro and the step numbers never change)
; ----------------------------------------------------------------------------

; @summary Sets the grid's font like the tree's (Segoe UI at s.FontSize; "MS Shell Dlg 2" first, so a missing
;          Segoe UI keeps a normal-size font instead of the big system font). Called when built and on A+ / A- zoom.
; @tags grid, gui, v27
V27_ApplyGridFont() {
    s := VMB()
    if !s.GridLV
        return
    s.GridLV.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2")     ; V29: the grid has its own zoom (not the list's A+ / A-)
    s.GridLV.SetFont(, "Segoe UI")
    V33_ApplyFreezeFont()                                      ; V33: the frozen pane has the same font
    V30_ApplyListFont()
}

; @summary Compares two rows for V27_SortRows: -1, 0 or 1. A cell that is "–" (or empty, or not a number in a number
;          column) always sorts last, also when descending.
; @returns Integer
; @tags grid, sort, v27
V27_CmpRows(rowA, rowB, key, desc, isNum) {
    va := String(rowA.Get(key, "–")), vb := String(rowB.Get(key, "–"))
    na := 0, nb := 0
    if isNum {
        missA := !RegExMatch(va, "^\s*(-?\d+(?:\.\d+)?)", &ma), missB := !RegExMatch(vb, "^\s*(-?\d+(?:\.\d+)?)", &mb)
        if !missA && !missB
            na := Number(ma[1]), nb := Number(mb[1])
    } else {
        missA := va = "" || va = "–", missB := vb = "" || vb = "–"
    }
    if missA && missB
        return 0
    if missA
        return 1
    if missB
        return -1
    c := isNum ? (na < nb ? -1 : na > nb ? 1 : 0) : StrCompare(va, vb, false)
    return desc ? -c : c
}

; @summary Sorts a row array by one cell key and returns a NEW array (the input is not changed). Stable (equal keys keep
;          their order), numbers as numbers when isNum, "–" always last, desc = largest / Z first.
; @returns Array of rows
; @tags grid, sort, v27
V27_SortRows(rows, key, desc, isNum) {
    src := []
    for r in rows
        src.Push(r)
    n := src.Length, width := 1
    while width < n {
        dst := []
        i := 1
        while i <= n {
            mid := Min(i + width, n + 1), hi := Min(i + 2 * width, n + 1)
            a := i, b := mid
            while a < mid || b < hi {
                if b >= hi || (a < mid && V27_CmpRows(src[a], src[b], key, desc, isNum) <= 0)
                    dst.Push(src[a]), a += 1
                else
                    dst.Push(src[b]), b += 1
            }
            i += 2 * width
        }
        src := dst, width *= 2
    }
    return src
}

; @summary The rows the grid shows now: all steps in step order, narrowed by the filter, then sorted.
; @returns Array of rows
; @tags grid, sort, filter, v27
V27_ViewRows() {
    s := VMB()
    if V32_BandsOn()
        return s.GridBands                                      ; V32: step order, no filter: loop / If blocks as band rows
    rows := s.GridAll
    if s.FilterProg != ""
        rows := V27_PickRows(rows, "app", s.FilterProg)
    if s.FilterAct != ""
        rows := V27_PickRows(rows, "action", s.FilterAct)
    if Trim(s.FilterQ) != ""
        rows := V27_FilterRows(rows, s.FilterQ, V27_Columns())
    if s.Picks.Count
        rows := V32_ApplyPicks(rows, s.Picks)                   ; V32: the picks of the header arrows (columns ANDed)
    if s.SortKey != "" {
        for col in V27_Columns()
            if col.Key = s.SortKey
                return V27_SortRows(rows, col.Key, s.SortDesc, col.Num)
    }
    return rows
}

; @summary Puts a small up / down triangle on the sorted column's title (and takes it off the others).
; @tags grid, sort, gui, v27
V27_SortMarks() {
    s := VMB()
    mark := s.SortKey . "|" . s.SortDesc . "|" . V32_PickSig(s.Picks)
    if !s.GridLV || mark = s.SortMark
        return
    s.SortMark := mark
    for i, col in V27_Columns()
        s.GridLV.ModifyCol(i, "", V32_HeadTitle(col.Title, col.Key = s.SortKey ? (s.SortDesc ? " ▼" : " ▲") : "", s.Picks.Has(col.Key)))
}

; @summary Status line for the grid view: how many rows are shown and how they are sorted (a view only).
; @tags grid, sort, v27
V27_ViewStatus() {
    s := VMB()
    parts := []
    shownSteps := 0
    for r in s.GridRows
        if !(r.HasOwnProp("Band") && r.Band)
            shownSteps += 1
    if shownSteps != s.GridAll.Length
        parts.Push("Showing " . shownSteps . " of " . s.GridAll.Length . " steps")
    if s.Picks.Count {
        titles := []
        for col in V27_Columns()
            if s.Picks.Has(col.Key)
                titles.Push(col.Title)
        parts.Push("Header filter on " . V4_Join(titles, ", ") . " (▼=)")
    }
    if s.SortKey != "" {
        for col in V27_Columns()
            if col.Key = s.SortKey
                parts.Push("Sorted by " . col.Title . " - this is only a view; steps still run in # order.")
    }
    VMB_Status(parts.Length ? V4_Join(parts, "  ") : "Grid view: all " . s.GridAll.Length . " steps, in step order.")
}

; @summary Shows the rows again after the sort or filter changed (no rebuild of the row data) and says what is shown.
; @tags grid, sort, v27
V27_Refill() {
    s := VMB()
    if !s.GridLV || !(s.Macro is Map)
        return
    V27_FillGrid(V27_ViewRows())
    V27_ViewStatus()
}

; @summary Clicked a column title: sort by it (ascending), again = descending. The "#" title = back to step order.
; @tags grid, sort, v27
V27_OnColClick(lv, col) {
    s := VMB()
    cols := V27_Columns()
    if col < 1 || col > cols.Length
        return
    key := cols[col].Key
    if V32_HeaderClick(col)                        ; V32: a click on the arrow part of the title opens the filter popup instead of sorting
        return
    if key = "num"
        return V27_SortReset()
    s.SortDesc := s.SortKey = key ? !s.SortDesc : false
    s.SortKey := key
    V27_Refill()
}

; @summary "Step order" button: back to the macro's own order (the filter stays).
; @tags grid, sort, v27
V27_SortReset() {
    s := VMB()
    s.SortKey := "", s.SortDesc := false
    V27_Refill()
}

; @summary Places the filter row (s.GridBar controls) directly above the grid and shows it only in grid view.
; @tags grid, gui, v27
V27_PlaceBar(x, y, w, h, show) {
    s := VMB()
    b := s.GridBar
    if !(b is Map) || !b.Has("Reset")
        return
    fixed := Map("Name", 150, "Prog", 120, "Act", 104, "Clear", 54, "Reset", 84, "Copy", 84, "ZMinus", 24, "ZPct", 50, "ZPlus", 24)
    order := ["Name", "Filter", "Prog", "Act", "Clear", "Reset", "Copy", "ZMinus", "ZPct", "ZPlus"]
    total := 0
    for name in order
        if b.Has(name) && name != "Filter" && name != "Name"
            total += fixed[name] + 4
    nameOn := b.Has("Name") && w - total - fixed["Name"] - 4 >= 140        ; V29: the name box gives way when the row is narrow
    cx := x
    for name in order {
        if !b.Has(name) || (name = "Name" && !nameOn)
            continue
        if name = "Filter" {
            fw := Max(80, w - total - (nameOn ? fixed["Name"] + 4 : 0))
            b["Filter"].Move(cx, y, fw, h)
            cx += fw + 4
            continue
        }
        if name = "Prog" || name = "Act"
            b[name].Move(cx, y, fixed[name])
        else
            b[name].Move(cx, y, fixed[name], h)
        cx += fixed[name] + 4
    }
    for name, ctl in b
        ctl.Visible := show && (name != "Name" || nameOn)
    if show && s.Gui {                                          ; V29: repaint the whole row, so no stale picture of a control stays where it used to be
        f := A_ScreenDPI / 96
        rc := Buffer(16, 0)
        NumPut("Int", Round(x * f), "Int", Round(y * f), "Int", Round((x + w + 8) * f), "Int", Round((y + h + 4) * f), rc)
        DllCall("RedrawWindow", "Ptr", s.Gui.Hwnd, "Ptr", rc, "Ptr", 0, "UInt", 0x185)
    }
}

; ----------------------------------------------------------------------------
; V27 item D: filter (a view only: rows that do not match are only not shown)
; ----------------------------------------------------------------------------

; @summary Keeps the rows that match the typed text. Several words = all must match; a word matches when ANY cell
;          contains it (case-insensitive). "column:word" limits that word to one column (the column's key or its title
;          without spaces, e.g. program:notepad, action:click). A "column:" with no word yet, or an unknown column, is
;          not a column filter ("abc:def" is then looked for as plain text). Returns a NEW array; empty text = all rows.
; @returns Array of rows
; @tags grid, filter, v27
V27_FilterRows(rows, query, columns) {
    terms := []
    for w in StrSplit(Trim(query, " `t`r`n"), [" ", "`t"]) {
        if w = ""
            continue
        key := "", word := w
        p := InStr(w, ":")
        if p > 1 {
            head := SubStr(w, 1, p - 1)
            for col in columns {
                if col.Key = head || StrReplace(col.Title, " ", "") = head {
                    key := col.Key, word := SubStr(w, p + 1)
                    break
                }
            }
        }
        if word != ""
            terms.Push(Map("Key", key, "Word", word))
    }
    out := []
    for r in rows {
        ok := true
        for t in terms {
            hit := false
            if t["Key"] != "" {
                hit := InStr(String(r.Get(t["Key"], "")), t["Word"]) > 0
            } else {
                for col in columns {
                    if InStr(String(r.Get(col.Key, "")), t["Word"]) {
                        hit := true
                        break
                    }
                }
            }
            if !hit {
                ok := false
                break
            }
        }
        if ok
            out.Push(r)
    }
    return out
}

; @summary Keeps the rows whose cell `key` equals `value` (case-insensitive). Used by the Program / Action drop-downs.
; @returns Array of rows
; @tags grid, filter, v27
V27_PickRows(rows, key, value) {
    out := []
    for r in rows
        if String(r.Get(key, "")) = value
            out.Push(r)
    return out
}

; @summary The distinct cell texts of one column, in order of first appearance ("–" and empty left out).
; @returns Array of text
; @tags grid, filter, v27
V27_Distinct(rows, key) {
    seen := Map(), out := []
    for r in rows {
        v := String(r.Get(key, ""))
        if v = "" || v = "–" || seen.Has(v)
            continue
        seen[v] := 1
        out.Push(v)
    }
    return out
}

; @summary True when any filter (text, Program or Action) is on.
; @tags grid, filter, v27
V27_FilterOn() {
    s := VMB()
    return Trim(s.FilterQ) != "" || s.FilterProg != "" || s.FilterAct != "" || s.Picks.Count > 0
}

; @summary Fills the Program / Action drop-downs from the current rows (All + each one). A choice that is no longer
;          in the rows goes back to All.
; @tags grid, filter, v27
V27_BarLists() {
    s := VMB()
    b := s.GridBar
    if !(b is Map) || !b.Has("Prog")
        return
    s.BarSync := true
    for it in [["Prog", "app", "All programs"], ["Act", "action", "All actions"]] {
        items := V27_Distinct(s.GridAll, it[2])
        cur := it[1] = "Prog" ? s.FilterProg : s.FilterAct
        pick := 1
        for i, v in items
            if v = cur
                pick := i + 1
        if pick = 1 && cur != "" {
            if it[1] = "Prog"
                s.FilterProg := ""
            else
                s.FilterAct := ""
        }
        b[it[1]].Delete()
        items.InsertAt(1, it[3])
        b[it[1]].Add(items)
        b[it[1]].Choose(pick)
    }
    s.BarSync := false
}

; @summary Typing in the filter box.
; @tags grid, filter, v27
V27_OnFilter(ctl, *) {
    s := VMB()
    if s.BarSync
        return
    s.FilterQ := ctl.Value
    V27_Refill()
}

; @summary A choice in the Program or Action drop-down.
; @tags grid, filter, v27
V27_OnPick(ctl, *) {
    s := VMB()
    b := s.GridBar
    if s.BarSync
        return
    s.FilterProg := b["Prog"].Value > 1 ? b["Prog"].Text : ""
    s.FilterAct := b["Act"].Value > 1 ? b["Act"].Text : ""
    V27_Refill()
}

; @summary "Clear" button: no filter text, Program and Action back to All (the sort stays).
; @tags grid, filter, v27
V27_ClearFilter(refill := true) {
    s := VMB()
    s.FilterQ := "", s.FilterProg := "", s.FilterAct := "", s.Picks := Map()     ; V32: Clear also clears the header picks
    b := s.GridBar
    if b is Map && b.Has("Filter") {
        s.BarSync := true
        b["Filter"].Value := ""
        b["Prog"].Choose(1)
        b["Act"].Choose(1)
        s.BarSync := false
    }
    if refill
        V27_Refill()
}

; @summary A run starts: the filter is cleared so the running step can never be hidden; it is put back by V27_RunEnd.
; @tags grid, filter, v27
V27_RunStart() {
    s := VMB()
    V28_Cancel()                    ; V28: no cell editing while a run starts
    s.SavedFilter := V27_FilterOn() ? Map("Q", s.FilterQ, "Prog", s.FilterProg, "Act", s.FilterAct, "Picks", s.Picks) : 0
    if !s.SavedFilter
        return
    V27_ClearFilter(false)
    if s.View = "grid"
        V27_FillGrid()
}

; @summary The run is over: put the filter back as it was before the run.
; @tags grid, filter, v27
V27_RunEnd() {
    s := VMB()
    saved := s.SavedFilter
    s.SavedFilter := 0
    if !(saved is Map) || !s.GridLV
        return
    s.FilterQ := saved["Q"], s.FilterProg := saved["Prog"], s.FilterAct := saved["Act"], s.Picks := saved["Picks"]
    b := s.GridBar
    if b is Map && b.Has("Filter") {
        s.BarSync := true
        b["Filter"].Value := saved["Q"]
        s.BarSync := false
    }
    if s.View = "grid"
        V27_FillGrid()              ; rebuilds the drop-downs and selects the Program / Action choice again
}

; ----------------------------------------------------------------------------
; V27 item E: copy to Excel
; ----------------------------------------------------------------------------

; @summary One cell as text for a tab-separated table: tabs and line breaks become a space.
; @returns Text
; @tags grid, copy, v27
V27_TsvCell(v) => RegExReplace(String(v), "[\t\r\n]+", " ")

; @summary Rows as tab-separated text (one line per row, lines joined with CR LF, no line break at the end), so it pastes
;          into Excel as cells. header = true puts the column titles first.
; @returns Text
; @tags grid, copy, v27
V27_Tsv(rows, columns, header := true) {
    lines := []
    if header {
        t := []
        for col in columns
            t.Push(V27_TsvCell(col.Title))
        lines.Push(V4_Join(t, "`t"))
    }
    for r in rows {
        t := []
        for col in columns
            t.Push(V27_TsvCell(r.Get(col.Key, "")))
        lines.Push(V4_Join(t, "`t"))
    }
    return V4_Join(lines, "`r`n")
}

; @summary "Copy table" button: the rows shown now (after sort / filter) with the header row, tab-separated, on the clipboard.
; @tags grid, copy, v27
V27_CopyTable() {
    s := VMB()
    A_Clipboard := V27_Tsv(s.GridRows, V27_Columns(), true)
    VMB_Status("Copied " . s.GridRows.Length . " rows with the header row. Paste into Excel (Ctrl+V) - each value lands in its own cell.")
}

; @summary Ctrl+C in the grid: the selected row, tab-separated (no header row), on the clipboard.
; @tags grid, copy, v27
V27_CopyRow() {
    s := VMB()
    row := s.GridLV ? s.GridLV.GetNext(0) : 0
    if !row || row > s.GridRows.Length
        return
    A_Clipboard := V27_Tsv([s.GridRows[row]], V27_Columns(), false)
    VMB_Status("Copied the selected row. Paste into Excel (Ctrl+V).")
}

; @summary True while the grid has the keyboard focus (for Ctrl+C in the grid).
; @tags grid, copy, v27
V27_GridFocused(*) {
    s := VMB()
    return s.GridLV && s.Gui && s.View = "grid" && !VM_IsPlaying() && !VM_IsRecording() && WinActive("ahk_id " . s.Gui.Hwnd)
        && DllCall("GetFocus", "Ptr") = s.GridLV.Hwnd
}

; ============================================================================
; V28: edit cells in the grid, like Excel (Item A: what a cell change means - pure, no windows)
; ============================================================================

; @summary The sentence shown when a cell cannot be edited in place.
; @tags grid, edit, v28
V28_NotEditableText() => "This cell is worked out from the step. Double-click opens the full Edit box."

; @summary Can this cell of this step be edited in the grid? Returns "" (no), "text" (type a value) or an Array of choices.
;          key = a column key of V27_Columns(). Only the columns of the V28 table are editable; the others are worked out.
; @returns "" | "text" | Array
; @tags grid, edit, v28
V28_Editable(node, key) {
    if !(node is Map) || VMF_IsContainer(node)          ; V32: a loop / If band row is not editable in the grid
        return ""
    t := node.Get("type", "")
    mouse := t = "click" || t = "drag"
    geo := node.Get("geo", "")
    switch key {
        case "text":
            return (t = "text" && !V4_Bool(node.Get("ask", 0))) || t = "keys" || t = "wheel" || t = "det_wait_window" || V31_IsRemember(node) ? "text" : ""
        case "button":
            return mouse ? ["Left", "Right", "Middle"] : ""
        case "clicks":
            return t = "click" ? ["1", "2", "3"] : ""
        case "held":
            return mouse ? ["none", "Ctrl", "Shift", "Ctrl+Shift"] : ""
        case "x":
            return mouse && ((geo is Map && geo.Has("cx")) || node.Has("scrX")) ? "text" : ""
        case "y":
            return mouse && ((geo is Map && geo.Has("cy")) || node.Has("scrY")) ? "text" : ""
        case "wait", "note":
            return "text"
        case "repeats":
            return V30_IsTop(node) ? ["yes", "once at start"] : ""
        case "when":
            return V31_HasRuleCells(node) ? "text" : ""
        case "failstep":
            return V31_HasRuleCells(node) ? V31_FailChoices() : ""
        case "scroll":
            return node.Get("scroll", "") is Map ? "text" : ""
        case "winsize":
            return t = "det_normalize_win" ? "text" : ""
        case "onoff":
            return ["on", "off"]
    }
    return ""
}

; @summary Reads a wait the way a person writes it: "2", "2s", "2.5 s", "500ms", "500"; empty or "auto" = automatic.
;          A bare number below 30 means seconds, otherwise milliseconds. Max one hour.
; @returns {Ok, Value (ms as Integer, or "auto"), Error}
; @tags grid, edit, v28
V28_ParseWait(text) {
    t := StrLower(Trim(text))
    if t = "" || t = "auto"
        return {Ok: true, Value: "auto", Error: ""}
    if !RegExMatch(t, "^(\d+(?:[.,]\d+)?)\s*(ms|msec|s|sec|secs|seconds?)?$", &m)
        return {Ok: false, Value: "", Error: "A wait looks like 2, 2s, 2.5 s or 500ms. Leave it empty for automatic."}
    amount := Number(StrReplace(m[1], ",", "."))
    unit := m[2]
    if unit = ""
        unit := amount < 30 ? "s" : "ms"
    ms := Round((unit = "ms" || unit = "msec") ? amount : amount * 1000)
    if ms > 3600000
        return {Ok: false, Value: "", Error: "That wait is longer than one hour."}
    return {Ok: true, Value: ms, Error: ""}
}

; @summary "" when the raw AutoHotkey keys are fine, else a plain sentence. Every { needs its }, no stray }; {{} and {}} are the
;          brace keys themselves.
; @tags grid, edit, v28
V28_KeysError(keys) {
    msg := "The keys have a { or } without its partner. A key with a name goes in braces, like {Enter}."
    if Trim(keys) = ""
        return "Write at least one key, for example {Enter} or ^a."
    n := StrLen(keys), i := 1
    while i <= n {
        c := SubStr(keys, i, 1)
        if c = "{" {
            three := SubStr(keys, i, 3)
            if three = "{{}" || three = "{}}" {
                i += 3
                continue
            }
            close := InStr(keys, "}", , i + 1)
            if !close
                return msg
            inner := SubStr(keys, i + 1, close - i - 1)
            if inner = "" || InStr(inner, "{")
                return msg
            i := close + 1
            continue
        }
        if c = "}"
            return msg
        i += 1
    }
    return ""
}

; @summary The text the cell editor opens with: the RAW value (raw keys, "down 3", "2 s", a row number...) or, for a drop-down
;          column, the current choice. "" when the cell is not editable.
; @tags grid, edit, v28
V28_EditText(node, key) {
    if V28_Editable(node, key) = ""
        return ""
    geo := node.Get("geo", "")
    switch key {
        case "text":
            t := node.Get("type", "")
            if t = "text"
                return V30_ShownNow(node.Get("text", ""))           ; V30: {{Name}} is shown as =Name when the macro has a list
            if t = "keys"
                return node.Get("keys", "")
            if t = "det_wait_window"
                return V31_WaitText(node)
            if V31_IsRemember(node)
                return V31_RememberText(node, V31_NamesAllNow())
            return StrLower(RegExReplace(node.Get("direction", "WheelDown"), "i)^Wheel")) . " " . Integer(node.Get("count", 1))
        case "button":
            return node.Get("button", "Left")
        case "clicks":
            return String(Integer(node.Get("count", 1)))
        case "held":
            return V27_HeldText(node.Get("mods", ""))
        case "x":
            return String((geo is Map && geo.Has("cx")) ? geo["cx"] : node["scrX"])
        case "y":
            return String((geo is Map && geo.Has("cy")) ? geo["cy"] : node["scrY"])
        case "wait":
            if !node.Has("delayMs")
                return "auto"
            ms := Integer(node["delayMs"])
            return Mod(ms, 1000) = 0 ? (ms // 1000) . " s" : ms . " ms"
        case "scroll":
            sc := node["scroll"]
            return sc.Has("v") ? String(sc["v"] + 1) : ""
        case "winsize":
            if V4_Bool(node.Get("maximize", 0))
                return "maximized"
            return node.Get("width", 693) . " x " . node.Get("height", 803)
        case "onoff":
            return V4_Bool(node.Get("disabled", 0)) ? "off" : "on"
        case "repeats":
            return V30_RepeatsText(V30_BlocksNow(), node)
        case "when":
            return Trim(String(node.Get("when", "")))
        case "failstep":
            return V31_FailText(node.Get("onFailStep", ""))
        case "note":
            return node.Get("note", "")
    }
    return ""
}

; @summary One short line telling what to type in a cell (shown in the status bar while the editor is open).
; @tags grid, edit, v28
V28_Hint(node, key) {
    switch key {
        case "wait": return "Waits first: 2, 2s, 500ms or auto. A number below 30 means seconds, otherwise milliseconds."
        case "x", "y": return StrUpper(key) . ": a whole number, 0 or more, inside the recorded window."
        case "scroll": return "Scroll back: the row number the list is scrolled to, or no."
        case "winsize": return "Window size: 800 x 600, or maximized."
        case "note": return "Note: your own words. Empty removes it."
        case "repeats": return "Repeats: yes, or once at start (only the first steps can be once at start)."
        case "when": return "Only when: a rule such as  Status = On  or  Amount > 100  or  Name is empty. otherwise = the other rows. Empty = always."
        case "text":
            t := node is Map ? node.Get("type", "") : ""
            if t = "keys"
                return "Raw keys, for example ^{a} or {Enter}{Tab}."
            if t = "wheel"
                return "Scroll: up, down, left or right, then how many, for example down 3."
            if t = "det_wait_window"
                return "Wait until: Save As is open  (or  is closed), then optionally  within 10 s."
            if V31_IsRemember(node)
                return "Remember: clipboard as total   or   " . Chr(34) . "some text" . Chr(34) . " as total. Then type =total in a Type step."
            return V30_Gate() ? "The text that is typed. =Name types the list column Name or a Value, =# the round number, '=x types a text that starts with =." : "The text that is typed."
    }
    return "Pick one."
}

; @summary Works out what a cell change would do, without touching the node. Returns {Ok, Error, Changes} where Changes is an
;          Array of {Path: [keys...], Del: true|false, Value}.
; @returns {Ok, Error, Changes}
; @tags grid, edit, v28
V28_Plan(node, key, input) {
    no(msg) => {Ok: false, Error: msg, Changes: []}
    yes(changes) => {Ok: true, Error: "", Changes: changes}
    set(path, value) => {Path: path, Del: false, Value: value}
    del(path) => {Path: path, Del: true, Value: ""}
    ed := V28_Editable(node, key)
    if ed = ""
        return no(V28_NotEditableText())
    text := Trim(String(input))
    t := node.Get("type", "")
    if ed is Array {
        for choice in ed
            if StrLower(choice) = StrLower(text) {
                text := choice
                break
            }
        if key = "failstep" && text = ""
            text := ed[1]
        found := false
        for choice in ed
            if choice = text
                found := true
        if !found
            return no("Pick one of: " . V4_Join(ed, ", ") . ".")
        switch key {
            case "button": return yes([set(["button"], text)])
            case "clicks": return yes([set(["count"], Integer(text))])
            case "held":
                mods := text = "Ctrl" ? "^" : text = "Shift" ? "+" : text = "Ctrl+Shift" ? "^+" : ""
                return yes([mods = "" ? del(["mods"]) : set(["mods"], mods)])
            case "onoff": return yes([text = "off" ? set(["disabled"], 1) : del(["disabled"])])
            case "repeats":
                so := V30_SetOnce(V30_BlocksNow(), node, text)
                return so.Ok ? yes([set(["once"], so.Value)]) : no(so.Error)
            case "failstep":
                fc := V31_FailCode(text)
                return yes([fc.Code = "" ? del(["onFailStep"]) : set(["onFailStep"], fc.Code)])
        }
    }
    switch key {
        case "text":
            if t = "text" {
                if input = ""
                    return no("Write at least one character to type.")
                st := V30_StoredNow(String(input))                  ; V30: =Name becomes {{Name}} when the macro has a list
                return st.Ok ? yes([set(["text"], st.Text)]) : no(st.Error)
            }
            if t = "keys" {
                bad := V28_KeysError(String(input))
                return bad != "" ? no(bad) : yes([set(["keys"], String(input))])
            }
            if V31_IsRemember(node) {                              ; V31.1: clipboard as name / "text" as name
                rm := V31_ParseRemember(String(input), V31_SettingsNow())
                return rm.Ok ? yes([set(["name"], rm.Name), set(["value"], rm.Value)]) : no(rm.Error)
            }
            if t = "det_wait_window" {
                ww := V31_ParseWaitWindow(String(input), node.Get("timeoutSec", 10))
                return ww.Ok ? yes([set(["target"], ww.Title), set(["closed"], ww.Closed ? 1 : 0), set(["timeoutSec"], ww.Secs)]) : no(ww.Error)
            }
            if !RegExMatch(StrLower(text), "^(up|down|left|right)(?:\s*(?:x|×)?\s*(\d+))?$", &m)
                return no("Write the scroll like: down 3 (up, down, left or right, then how many).")
            n := m[2] = "" ? 1 : Integer(m[2])
            if n < 1 || n > 100
                return no("How many scroll steps must be a whole number from 1 to 100.")
            return yes([set(["direction"], "Wheel" . StrUpper(SubStr(m[1], 1, 1)) . SubStr(m[1], 2)), set(["count"], n)])
        case "x", "y":
            geo := node.Get("geo", "")
            useGeo := geo is Map && geo.Has("c" . key)
            if !RegExMatch(text, "^\d+$")
                return no(StrUpper(key) . " must be a whole number, 0 or more.")
            v := Integer(text)
            size := useGeo ? geo.Get(key = "x" ? "cw" : "ch", "") : ""
            if IsNumber(size) && v >= size
                return no(StrUpper(key) . " must be inside the window: 0 to " . (size - 1) . ".")
            path := useGeo ? ["geo", "c" . key] : [key = "x" ? "scrX" : "scrY"]
            return yes([set(path, v), set(["noVerify"], 1)])
        case "wait":
            w := V28_ParseWait(input)
            if !w.Ok
                return no(w.Error)
            return yes([w.Value = "auto" ? del(["delayMs"]) : set(["delayMs"], w.Value)])
        case "scroll":
            low := StrLower(text)
            if low = "no" || low = "none"
                return yes([del(["scroll"])])
            if !RegExMatch(low, "^(?:row\s*)?(\d+)$", &m) || Integer(m[1]) < 1
                return no("Write the row number (1 or more), or no to take the scroll-back away.")
            return yes([set(["scroll", "v"], Integer(m[1]) - 1)])
        case "winsize":
            low := StrLower(text)
            if low = "maximized" || low = "maximize" || low = "max"
                return yes([set(["maximize"], 1)])
            if !RegExMatch(low, "^(\d+)\s*[x×*]\s*(\d+)$", &m) || Integer(m[1]) < 50 || Integer(m[2]) < 50 || Integer(m[1]) > 20000 || Integer(m[2]) > 20000
                return no("Write the size like 800 x 600, or maximized. Each number must be at least 50.")
            return yes([set(["width"], Integer(m[1])), set(["height"], Integer(m[2])), set(["maximize"], 0)])
        case "note":
            return yes([text = "" ? del(["note"]) : set(["note"], text)])
        case "when":
            bad := V31_CheckWhen(V31_SiblingsOf(V30_BlocksNow(), node), node, text, V31_NamesNow())
            if bad != ""
                return no(bad)
            return yes([text = "" || StrLower(text) = "always" ? del(["when"]) : set(["when"], RegExReplace(text, "\s+", " "))])
    }
    return no(V28_NotEditableText())
}

; @summary Writes a plan from V28_Plan into the node (Changes only; no snapshot, no refresh).
; @tags grid, edit, v28
V28_ApplyChanges(node, changes) {
    for item in changes {
        target := node
        loop item.Path.Length - 1
            target := target[item.Path[A_Index]]
        last := item.Path[item.Path.Length]
        if item.Del {
            if target.Has(last)
                target.Delete(last)
        } else
            target[last] := item.Value
    }
}

; @summary Changes one cell of a step: {Ok: true} or {Ok: false, Error: "plain sentence"}. The node changes only when Ok.
; @returns {Ok, Error}
; @tags grid, edit, v28
V28_ApplyCell(node, key, input) {
    plan := V28_Plan(node, key, input)
    if plan.Ok
        V28_ApplyChanges(node, plan.Changes)
    return {Ok: plan.Ok, Error: plan.Error}
}

; ----------------------------------------------------------------------------
; V28 item B: the editor in the window (an Edit / DropDownList placed on top of the cell)
; ----------------------------------------------------------------------------

; @summary Creates the cell editor once: a hidden Edit (s.CellEdit) and a hidden DropDownList (s.CellPick), and hooks the grid
;          (click = current cell, scroll / column resize = close the editor, key down = typing starts an edit).
;          Both controls are NOT in s.Ctl, so the Easy / Full layout code does not know them.
; @tags grid, edit, gui, v28
V28_Build(g) {
    s := VMB()
    s.GridLV.Opt("+0x4000000")                                ; WS_CLIPSIBLINGS: the grid must not paint over the editor that sits on it
    s.CellEdit := g.AddEdit("x10 y10 w100 h22 Hidden +0x4000000")
    s.CellEdit.OnEvent("LoseFocus", V28_OnLoseFocus)
    s.CellPick := g.AddDropDownList("x10 y10 w100 Hidden", ["x"])
    s.CellPick.OnEvent("LoseFocus", V28_OnLoseFocus)
    s.CellPick.OnCommand(9, V28_OnPickDone)                    ; CBN_SELENDOK: a choice was clicked in the list
    s.GridLV.OnEvent("Click", V28_OnClick)
    for code in [-181, -326, -327, -325, -321]                 ; LVN_ENDSCROLL, header: begin / end / double-click / changed
        s.GridLV.OnNotify(code, V28_OnScrollOrResize)
    OnMessage(0x100, V28_OnWmKeyDown)                          ; WM_KEYDOWN to the grid: typing a letter starts an edit (LVN_KEYDOWN is not passed on by AutoHotkey)
    OnMessage(0x20A, V28_OnWmWheel)                            ; WM_MOUSEWHEEL: the grid scrolls, so the editor closes
}

; @summary The cell rectangle of a grid cell in the grid's own client pixels: {L, T, R, B}, or 0 when the cell is not shown.
; @tags grid, edit, gui, v28
V28_CellPixels(row, col) {
    s := VMB()
    rc := Buffer(16, 0)
    NumPut("Int", 0, "Int", col - 1, rc)                       ; left = LVIR_BOUNDS, top = sub-item (column - 1)
    if !SendMessage(0x1038, row - 1, rc.Ptr, s.GridLV)         ; LVM_GETSUBITEMRECT
        return 0
    return {L: NumGet(rc, 0, "Int"), T: NumGet(rc, 4, "Int"), R: NumGet(rc, 8, "Int"), B: NumGet(rc, 12, "Int")}
}

; @summary The cell rectangle in the window's own units (the same units Move / GetPos use): {X, Y, W, H}, or 0.
;          Clipped to the grid's visible area. The window's controls use 96-dpi units, so pixels are scaled by 96 / A_ScreenDPI.
; @tags grid, edit, gui, v28
V28_CellRect(row, col) {
    s := VMB()
    p := V28_CellPixels(row, col)
    if !IsObject(p)
        return 0
    rc := Buffer(16, 0)
    DllCall("GetClientRect", "Ptr", s.GridLV.Hwnd, "Ptr", rc)
    right := Min(p.R, NumGet(rc, 8, "Int"))
    pt := Buffer(8, 0)
    NumPut("Int", p.L, "Int", p.T, pt)
    DllCall("MapWindowPoints", "Ptr", s.GridLV.Hwnd, "Ptr", s.Gui.Hwnd, "Ptr", pt, "UInt", 1)
    f := 96 / A_ScreenDPI
    return {X: Round(NumGet(pt, 0, "Int") * f), Y: Round(NumGet(pt, 4, "Int") * f),
        W: Max(8, Round((right - p.L) * f)), H: Max(8, Round((p.B - p.T) * f))}
}

; @summary Scrolls the grid sideways (and up / down) so a cell is fully visible, before the editor is placed on it.
; @tags grid, edit, gui, v28
V28_EnsureVisible(row, col) {
    s := VMB()
    try s.GridLV.Modify(row, "Vis")
    p := V28_CellPixels(row, col)
    if !IsObject(p)
        return
    rc := Buffer(16, 0)
    DllCall("GetClientRect", "Ptr", s.GridLV.Hwnd, "Ptr", rc)
    cw := NumGet(rc, 8, "Int")
    dx := 0
    if p.L < 0
        dx := p.L
    else if p.R > cw
        dx := Min(p.R - cw, p.L)
    if dx
        SendMessage(0x1014, dx, 0, s.GridLV)                   ; LVM_SCROLL
}

; @summary Which cell is under the mouse: {Row, Col} (1-based, 0 when none), by LVM_SUBITEMHITTEST.
; @tags grid, edit, gui, v28
V28_HitCell() {
    s := VMB()
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    DllCall("ScreenToClient", "Ptr", s.GridLV.Hwnd, "Ptr", pt)
    inf := Buffer(24, 0)
    NumPut("Int", NumGet(pt, 0, "Int"), "Int", NumGet(pt, 4, "Int"), inf)
    SendMessage(0x1039, 0, inf.Ptr, s.GridLV)                  ; LVM_SUBITEMHITTEST
    return {Row: NumGet(inf, 12, "Int") + 1, Col: NumGet(inf, 16, "Int") + 1}
}

; @summary True while the cell editor (the Edit or the drop-down) has the keyboard focus - for Enter / Tab / Esc.
;          False while recording or playing, and when this window is not the active one.
; @tags grid, edit, hotkey, v28
V28_EditorFocused(*) {
    s := VMB()
    if !s.CellOn || !s.Gui || VM_IsPlaying() || VM_IsRecording() || !WinActive("ahk_id " . s.Gui.Hwnd)
        return false
    focus := DllCall("GetFocus", "Ptr")
    return focus = s.CellEdit.Hwnd || focus = s.CellPick.Hwnd || DllCall("IsChild", "Ptr", s.CellPick.Hwnd, "Ptr", focus)
}

; @summary The text or choice now in the editor.
; @tags grid, edit, gui, v28
V28_EditorInput() {
    s := VMB()
    return s.CellIsPick ? s.CellPick.Text : s.CellEdit.Value
}

; @summary Opens the editor on a grid cell (row = grid row, col = column number). startText = a typed first character (or "").
;          Not editable: says so in the status bar and returns false. Never while recording or playing.
; @tags grid, edit, gui, v28
V28_Open(row, col, startText := "") {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !s.GridLV || s.View != "grid" || !s.GridNodes.Has(row)
        return false
    V28_Finish(false)                                          ; a cell that is still open is saved first
    node := s.GridNodes.Get(row, 0)
    cols := V27_Columns()
    if !IsObject(node) || col < 1 || col > cols.Length
        return false
    key := cols[col].Key
    kind := V28_Editable(node, key)
    s.GridCol := col
    V29_CursorRedraw()
    if kind = "" {
        VMB_Status(V28_NotEditableText())
        return false
    }
    V28_EnsureVisible(row, col)
    rect := V28_CellRect(row, col)
    if !IsObject(rect)
        return false
    s.CellNode := node, s.CellKey := key, s.CellRow := row, s.CellOrig := V28_EditText(node, key)
    s.CellIsPick := kind is Array
    if s.CellIsPick {
        pick := s.CellPick
        pick.Delete()
        pick.Add(kind)
        pick.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2"), pick.SetFont(, "Segoe UI")
        choice := s.CellOrig
        if startText != ""
            for item in kind
                if StrLower(SubStr(item, 1, StrLen(startText))) = StrLower(startText) {
                    choice := item
                    break
                }
        try pick.Choose(choice)
        pick.Move(rect.X, rect.Y, Max(rect.W, 96))
        shown := pick
    } else {
        ed := s.CellEdit
        ed.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2"), ed.SetFont(, "Segoe UI")
        ed.Value := startText != "" ? startText : s.CellOrig
        ed.Move(rect.X, rect.Y, rect.W, rect.H)
        shown := ed
    }
    s.CellOn := true
    shown.Visible := true
    DllCall("SetWindowPos", "Ptr", shown.Hwnd, "Ptr", 0, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x43)     ; HWND_TOP, no move / size, show
    shown.Focus()
    DllCall("RedrawWindow", "Ptr", shown.Hwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x185)     ; paint it now, on top of the grid
    if !s.CellIsPick {
        n := startText != "" ? StrLen(startText) : 0
        SendMessage(0xB1, startText != "" ? n : 0, startText != "" ? n : -1, s.CellEdit)    ; EM_SETSEL: caret at end, or select all
    } else if startText = ""
        PostMessage(0x14F, 1, 0, s.CellPick)                   ; CB_SHOWDROPDOWN: the list opens, like a double-click on a choice
    VMB_Status(V28_Hint(node, key) . "   Enter saves, Tab goes on, Esc cancels.")
    return true
}

; @summary Hides the editor. refocus = put the keyboard focus back on the grid (not when the user clicked somewhere else).
; @tags grid, edit, gui, v28
V28_Hide(refocus := true) {
    s := VMB()
    if !s.CellEdit
        return
    s.CellOn := false
    s.CellEdit.Visible := false
    s.CellPick.Visible := false
    if refocus && s.GridLV && s.View = "grid"
        try s.GridLV.Focus()
}

; @summary Esc / refresh / run start: closes the editor and throws the typed value away. Safe to call when it is not open.
; @tags grid, edit, gui, v28
V28_Cancel(refocus := true) {
    s := VMB()
    if s.CellOn
        V28_Hide(refocus)
}

; @summary Closes the editor and keeps the value when it is valid (when it is not, the value is dropped and the status bar says why).
;          Used when the user clicks elsewhere, scrolls, resizes a column or the window.
; @tags grid, edit, gui, v28
V28_Finish(refocus := true) {
    s := VMB()
    if !s.CellOn
        return
    if !V28_Commit(refocus)
        V28_Cancel(refocus)
}

; @summary True when two cell texts are exactly equal (case counts: abc -> ABC is a change; AutoHotkey's = ignores case).
; @tags grid, edit, v28
V28_SameText(a, b) => String(a) == String(b)

; @summary Changes a step by a plan: snapshot (Ctrl+Z undoes it), apply, Dirty, refresh keeping sort / filter and the selection, autosave.
; @tags grid, edit, gui, v28
V28_Do(node, plan, message) {
    s := VMB()
    VMB_Snapshot()
    V28_ApplyChanges(node, plan.Changes)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status(message)
    V31_AfterStepEdit(node)                                    ; V31.1: a Remember step makes its Values row
}

; @summary Saves the editor's value into the step. A rejected value keeps the editor open, shows the sentence in the status bar and
;          selects all the text. Returns true when the editor is closed (saved, or nothing to save), false when it stays open.
; @tags grid, edit, gui, v28
V28_Commit(refocus := true) {
    s := VMB()
    if !s.CellOn
        return true
    if VM_IsRecording() || VM_IsPlaying() {
        V28_Hide(false)
        return true
    }
    node := s.CellNode, key := s.CellKey
    input := V28_EditorInput()
    plan := V28_Plan(node, key, input)
    if !plan.Ok {
        VMB_Status(plan.Error)
        if !s.CellIsPick {
            s.CellEdit.Focus()
            SendMessage(0xB1, 0, -1, s.CellEdit)               ; EM_SETSEL: select all
        }
        return false
    }
    s.CellLast := node
    V28_Hide(refocus)
    if V28_SameText(input, s.CellOrig)
        return true
    title := ""
    for col in V27_Columns()
        if col.Key = key
            title := col.Title
    V28_Do(node, plan, "Changed " . title . ". Ctrl+Z undoes it.")
    return true
}

; @summary Enter / Tab / Shift+Tab in the editor: saves, then moves. "down" = select the cell below, "tab" = open the next editable
;          cell of the row (wraps to the next row), "back" = the one before. A rejected value keeps the editor open.
; @tags grid, edit, gui, v28
V28_Enter(where) {
    s := VMB()
    col := s.GridCol
    if !V28_Commit()
        return
    row := s.GridRowOf.Get(s.CellLast, 0)
    if !row
        return
    cols := V27_Columns()
    if where = "down" {
        if row < s.GridNodes.Count
            V28_SelectRow(row + 1)
        VMB_Status("Cell: " . cols[col].Title)
        return
    }
    step := where = "back" ? -1 : 1
    order := V29_VisibleOrder()                                  ; V29: in the order the columns are shown, hidden ones skipped
    pos := 0
    for i, oc in order
        if oc = col
            pos := i
    if !pos
        pos := step > 0 ? 0 : order.Length + 1
    r := row
    loop order.Length * 2 + 2 {                                  ; at most one full turn of the row, then the next / previous row
        pos += step
        if pos > order.Length || pos < 1 {
            r += step
            pos := step > 0 ? 1 : order.Length
            if r < 1 || r > s.GridNodes.Count
                return
        }
        c := order[pos]
        if V28_Editable(s.GridNodes[r], cols[c].Key) != "" {
            V28_SelectRow(r)
            V28_Open(r, c)
            return
        }
    }
}

; @summary Selects a grid row (and the same step in the hidden tree, so the buttons keep working).
; @tags grid, edit, gui, v28
V28_SelectRow(row) {
    s := VMB()
    node := s.GridNodes.Get(row, 0)
    if !IsObject(node)
        return
    s.GridSync := true
    try s.GridLV.Modify(row, "Select Focus Vis")
    s.GridSync := false
    if s.NodeItem.Has(node)
        s.TV.Modify(s.NodeItem[node], "Select")
}

; @summary Esc in the editor.
; @tags grid, edit, gui, v28
V28_EscKey() {
    V28_Cancel()
    VMB_Status("Not changed.")
}

; @summary F2 / Enter in the grid: edit the current cell (the current column of the selected row).
; @tags grid, edit, gui, v28
V28_OpenCurrent() {
    s := VMB()
    row := s.GridLV ? s.GridLV.GetNext(0) : 0
    if row
        V28_Open(row, s.GridCol)
}

; @summary Left / Right in the grid: moves the current column; the status bar names the cell.
; @tags grid, edit, gui, v28
V28_MoveCol(step) {
    s := VMB()
    V33_Collapse()                                             ; V33: a plain arrow ends the cell range
    cols := V27_Columns()
    s.GridCol := V29_NextCol(V29_VisibleOrder(), s.GridCol, step)      ; V29: in the order the columns are shown, hidden ones skipped
    row := s.GridLV.GetNext(0)
    if row
        V28_EnsureVisible(row, s.GridCol)
    V28_CellStatus(row)
}

; @summary Status bar: "Cell: Waits first" and whether it can be edited.
; @tags grid, edit, gui, v28
V28_CellStatus(row) {
    s := VMB()
    col := V27_Columns()[s.GridCol]
    node := row ? s.GridNodes.Get(row, 0) : 0
    can := IsObject(node) && V28_Editable(node, col.Key) != ""
    VMB_Status("Cell: " . col.Title . (can ? "   (F2 or Enter edits it)" : "   (worked out from the step, not editable here)"))
    V29_CursorRedraw()                                         ; V29: the cell frame and the name box follow
}

; @summary Click in the grid: the clicked column becomes the current column.
; @tags grid, edit, gui, v28
V28_OnClick(lv, row) {
    s := VMB()
    if !row
        return
    hit := V28_HitCell()
    if hit.Row = row && hit.Col >= 1 && hit.Col <= V27_Columns().Length {
        if GetKeyState("Shift") {                              ; V33: Shift+click grows the range to this cell (the old cell is the anchor)
            node := s.GridNodes.Get(row, 0)
            r := s.GridRange
            if !(IsObject(r) && s.GridRowOf.Has(r.A) && s.GridRowOf.Has(r.C)) && IsObject(node)
                s.GridRange := {A: node, C: node, Col: s.GridCol}
            s.GridCol := hit.Col
            V33_Repaint()
            return V33_Status()
        }
        s.GridRange := 0
        s.GridCol := hit.Col
        V33_Repaint()
        V28_CellStatus(row)
    }
}

; @summary The editor lost the keyboard focus (the user clicked elsewhere): save when valid.
; @tags grid, edit, gui, v28
V28_OnLoseFocus(ctl, *) {
    s := VMB()
    if !s.CellOn || DllCall("GetFocus", "Ptr") = ctl.Hwnd     ; a late message from an editor that has the focus again (Tab to the next cell)
        return
    V28_Finish(false)
}

; @summary A choice was clicked in the drop-down: save it.
; @tags grid, edit, gui, v28
V28_OnPickDone(*) {
    s := VMB()
    if s.CellOn
        V28_Commit()
}

; @summary The grid scrolled or a column was resized: the editor would sit on the wrong cell, so it closes (saving a valid value).
; @tags grid, edit, gui, v28
V28_OnScrollOrResize(*) {
    s := VMB()
    if s.CellOn
        V28_Finish()
}

; ----------------------------------------------------------------------------
; V28 item C: small Excel habits (Delete clears, Ctrl+D copies the cell above, typing starts an edit)
; ----------------------------------------------------------------------------

; @summary Delete in the grid: a Note cell loses its note, a Waits cell goes back to automatic. Other cells: the status bar says so.
; @tags grid, edit, gui, v28
V28_DeleteCell() {
    s := VMB()
    row := s.GridLV.GetNext(0)
    node := row ? s.GridNodes.Get(row, 0) : 0
    if !IsObject(node)
        return
    col := V27_Columns()[s.GridCol]
    if !V31_Clearable(col.Key)
        return VMB_Status("Delete clears only a Note, Waits first, Only when or If it fails cell. To delete the step, use the Delete button or the right-click menu.")
    if !node.Has(V31_ClearKey(col.Key))
        return VMB_Status(col.Title . " is already empty.")
    V28_Do(node, V28_Plan(node, col.Key, ""), col.Title . " cleared. Ctrl+Z undoes it.")
}

; @summary Ctrl+D in the grid: copies the value of the cell above (in the order shown) into the current cell, when both steps have
;          that column editable and the value is valid for this step.
; @tags grid, edit, gui, v28
V28_CopyAbove() {
    s := VMB()
    row := s.GridLV.GetNext(0)
    node := row ? s.GridNodes.Get(row, 0) : 0
    if !IsObject(node)
        return
    if row < 2
        return VMB_Status("There is no row above to copy from.")
    col := V27_Columns()[s.GridCol]
    above := s.GridNodes.Get(row - 1, 0)
    if !IsObject(above) || V28_Editable(above, col.Key) = "" || V28_Editable(node, col.Key) = ""
        return VMB_Status("Copy from above works when both cells are editable: " . col.Title . " is not for one of these two steps.")
    plan := V28_Plan(node, col.Key, V28_EditText(above, col.Key))
    if !plan.Ok
        return VMB_Status("The cell above does not fit this step: " . plan.Error)
    if V28_SameText(V28_EditText(above, col.Key), V28_EditText(node, col.Key))
        return VMB_Status("The cell is already the same as the one above.")
    V28_Do(node, plan, col.Title . " copied from the row above. Ctrl+Z undoes it.")
}

; @summary WM_KEYDOWN monitor: a key pressed while the grid has the focus. Returns nothing, so the key is handled as usual.
; @tags grid, edit, gui, v28
V28_OnWmKeyDown(wParam, lParam, msg, hwnd) {
    s := VMB()
    if s.GridLV && hwnd = s.GridLV.Hwnd
        V28_TypeKey(wParam)
}

; @summary WM_MOUSEWHEEL monitor: the grid (or the editor) is scrolled by the wheel, so the editor closes (a valid value is saved).
; @tags grid, edit, gui, v28
V28_OnWmWheel(wParam, lParam, msg, hwnd) {
    s := VMB()
    if s.CellOn && (hwnd = s.GridLV.Hwnd || hwnd = s.CellEdit.Hwnd || hwnd = s.CellPick.Hwnd)
        V28_Finish()
}

; @summary A letter or digit key (virtual key code) went down in the grid: starts editing the current cell with that character,
;          when the cell is editable. Not with Ctrl or Alt held, not while recording / playing, not when the editor is already open.
; @tags grid, edit, gui, v28
V28_TypeKey(vk) {
    s := VMB()
    if s.CellOn || !s.GridLV || s.View != "grid" || VM_IsRecording() || VM_IsPlaying() || GetKeyState("Ctrl") || GetKeyState("Alt")
        return
    shifted := GetKeyState("Shift")
    if vk >= 0x41 && vk <= 0x5A
        ch := (shifted != GetKeyState("CapsLock", "T")) ? Chr(vk) : StrLower(Chr(vk))
    else if vk >= 0x30 && vk <= 0x39 && !shifted
        ch := Chr(vk)
    else if vk >= 0x60 && vk <= 0x69
        ch := Chr(vk - 0x30)
    else
        return
    row := s.GridLV.GetNext(0)
    node := row ? s.GridNodes.Get(row, 0) : 0
    if !IsObject(node) || V28_Editable(node, V27_Columns()[s.GridCol].Key) = ""
        return                                                 ; not editable: the list keeps its own type-to-search
    V28_Open(row, s.GridCol, ch)
}

; ============================================================================
; V29: the grid looks and acts more like Excel (A zoom, B cell cursor, C cell copy / paste, D columns)
; ============================================================================

; ----------------------------------------------------------------------------
; V29 item A: zoom like Excel (the grid has its own zoom, in percent; the list keeps A+ / A-)
; ----------------------------------------------------------------------------

; @summary Excel's zoom steps, in percent.
; @tags grid, zoom, v29
V29_ZoomSteps() => [50, 60, 70, 80, 90, 100, 110, 120, 130, 150, 175, 200]

; @summary Font size in whole points for a zoom in percent (GDI cannot do half points; the percent stays the truth).
;          Never below 5 points.
; @returns Integer
; @tags grid, zoom, v29
V29_ZoomFont(basePt, pct) => Max(5, Round(basePt * pct / 100))

; @summary The next zoom step: direction 1 = the next bigger step, -1 = the next smaller step, 0 = 100. Works from any
;          percent (also one that is not a step); stays at 50 / 200 at the ends.
; @returns Integer percent
; @tags grid, zoom, v29
V29_ZoomStep(pct, direction) {
    if direction = 0
        return 100
    steps := V29_ZoomSteps()
    if direction > 0 {
        for st in steps
            if st > pct
                return st
        return steps[steps.Length]
    }
    i := steps.Length
    while i >= 1 {
        if steps[i] < pct
            return steps[i]
        i -= 1
    }
    return steps[1]
}

; @summary A zoom value from the ini (or anywhere) as a whole percent between 50 and 200; anything else = 100.
; @returns Integer percent
; @tags grid, zoom, v29
V29_ClampZoom(v) {
    if !IsNumber(v)
        return 100
    return Max(50, Min(200, Round(v)))
}

; @summary A column's width at a zoom: the width at 100 % times the zoom. A column that has a width stays at least 8 px wide.
; @returns Integer pixels
; @tags grid, zoom, v29
V29_ColWidth(w100, pct) => w100 <= 0 ? 0 : Max(8, Round(w100 * pct / 100))

; @summary Builds what V29 needs once the grid exists: the wheel monitor for Ctrl + wheel zoom, the grid's focus-lost save.
; @tags grid, gui, v29
V29_Build(g) {
    s := VMB()
    OnMessage(0x20A, V29_OnWmWheel)                            ; WM_MOUSEWHEEL: Ctrl + wheel over the grid zooms it
    s.GridLV.OnNotify(-12, V29_OnCustomDraw)                   ; NM_CUSTOMDRAW: the cell cursor
    V33_LoadIni()                                              ; V33: [V33] ExcelLook
    OnMessage(0x4E, V33_OnWmNotify)                            ; V33: the Excel-grey column headings
    s.GridLV.OnEvent("LoseFocus", (*) => V29_SaveCols())       ; widths / order are saved when the grid is left
    g.OnEvent("ContextMenu", V29_OnGuiMenu)                    ; right-click on the column heading: hide / show columns
    V29_ZoomLabel()
}

; @summary Sets the width of every grid column from its width at 100 % times the zoom (a hidden column stays 0).
; @tags grid, zoom, v29
V29_ApplyColWidths() {
    s := VMB()
    if !s.GridLV
        return
    for i, col in V27_Columns() {
        w := s.GridHidden.Has(col.Key) ? 0 : V29_ColWidth(s.GridColW.Get(col.Key, col.Width), s.GridZoom)
        s.GridLV.ModifyCol(i, w)
        s.GridColApplied[col.Key] := w
    }
}

; @summary Reads the widths the grid has now back into s.GridColW (at 100 %), but only for columns whose width was changed
;          by the user (or by the fit) since V29_ApplyColWidths set it, so zooming back and forth never drifts.
; @tags grid, zoom, v29
V29_CaptureWidths() {
    s := VMB()
    if !s.GridLV
        return
    for i, col in V27_Columns() {
        if s.GridHidden.Has(col.Key)
            continue
        w := SendMessage(0x101D, i - 1, 0, s.GridLV)            ; LVM_GETCOLUMNWIDTH
        if w != s.GridColApplied.Get(col.Key, -1) {
            s.GridColW[col.Key] := Max(8, Round(w * 100 / s.GridZoom))
            s.GridColApplied[col.Key] := w
        }
    }
}

; @summary Shows the zoom percent on the zoom control at the right end of the filter row.
; @tags grid, zoom, gui, v29
V29_ZoomLabel() {
    s := VMB()
    if s.GridBar is Map && s.GridBar.Has("ZPct")
        s.GridBar["ZPct"].Text := s.GridZoom . "%"
}

; @summary Zooms the grid to a percent (50..200): font, header, column widths, the zoom control, the ini ([V29] GridZoom).
;          An open cell editor is saved first (valid value) and the cell cursor stays where it is.
; @tags grid, zoom, gui, v29
V29_SetZoom(pct, say := true) {
    s := VMB()
    if !s.GridLV
        return
    pct := V29_ClampZoom(pct)
    V28_Finish(false)
    V29_CaptureWidths()
    s.GridZoom := pct
    s.GridLV.Opt("-Redraw")
    V27_ApplyGridFont()
    V29_ApplyColWidths()
    s.GridLV.Opt("+Redraw")
    V29_ZoomLabel()
    try IniWrite(pct, s.Ini, "V29", "GridZoom")
    V29_SaveCols()
    V29_CursorRedraw()
    if s.View = "grid" && s.GridLV.Visible
        try s.GridLV.Focus()
    if say
        VMB_Status("Grid zoom " . pct . " %.  Ctrl + mouse wheel, Ctrl + plus / minus, Ctrl + 0 for 100 %.")
}

; @summary One zoom step bigger (1) or smaller (-1).
; @tags grid, zoom, gui, v29
V29_ZoomBy(direction) {
    V29_SetZoom(V29_ZoomStep(VMB().GridZoom, direction))
}

; @summary Ctrl + plus / minus / 0 in the grid: direction 1, -1 or 0 (= 100 %).
; @tags grid, zoom, hotkey, v29
V29_ZoomKey(direction) {
    V29_ZoomBy(direction)
}

; @summary WM_MOUSEWHEEL monitor: Ctrl + wheel over the grid (or its header) zooms the grid and swallows the message.
;          Not while recording / playing, not in list view. Any other wheel use is left alone.
; @tags grid, zoom, gui, v29
V29_OnWmWheel(wParam, lParam, msg, hwnd) {
    s := VMB()
    if !s.GridLV || !s.Gui || s.View != "grid" || !(wParam & 0x8)         ; MK_CONTROL
        return
    if VM_IsPlaying() || VM_IsRecording()
        return
    if hwnd != s.GridLV.Hwnd && DllCall("GetParent", "Ptr", hwnd, "Ptr") != s.GridLV.Hwnd
        && !(s.CellEdit && (hwnd = s.CellEdit.Hwnd || hwnd = s.CellPick.Hwnd))
        return
    delta := (wParam >> 16) & 0xFFFF
    if delta >= 0x8000
        delta -= 0x10000
    if delta
        V29_ZoomBy(delta > 0 ? 1 : -1)
    return 0
}

; @summary True while the grid has the keyboard focus in this window (for the V29 grid hotkeys: same rule as V27_GridFocused).
; @tags grid, hotkey, v29
V29_GridKeys(*) => V27_GridFocused()


; ----------------------------------------------------------------------------
; V29 item B: a cell cursor, like Excel's selected cell
; ----------------------------------------------------------------------------

; @summary Next / previous column in a display order (array of column numbers, left to right, hidden ones already left out).
;          step 1 = right, -1 = left. At the edge it stays where it is (no wrap). A current column that is not in the order
;          (for example a hidden one) goes to the first (step 1) or the last (step -1) shown column.
; @returns Integer column number
; @tags grid, cursor, columns, v29
V29_NextCol(order, current, step) {
    if !order.Length
        return current
    pos := 0
    for i, c in order
        if c = current {
            pos := i
            break
        }
    if !pos
        return step > 0 ? order[1] : order[order.Length]
    return order[Max(1, Min(order.Length, pos + step))]
}

; @summary The columns as the user sees them, left to right: column numbers (1-based, the numbers of V27_Columns), hidden ones left out.
;          Read from the grid (LVM_GETCOLUMNORDERARRAY) so a dragged column is respected.
; @returns Array of Integer
; @tags grid, cursor, columns, v29
V29_VisibleOrder() {
    s := VMB()
    cols := V27_Columns()
    out := []
    for c in V29_DisplayOrder()
        if !s.GridHidden.Has(cols[c].Key)
            out.Push(c)
    return out
}

; @summary The text of the name box: the current column and the step number, like "Waits first · step 7". "-" when no row is selected.
; @tags grid, cursor, gui, v29
V29_NameText(colTitle, stepNum) => colTitle = "" || stepNum = "" ? "–" : colTitle . " · step " . stepNum

; @summary Repaints the row that holds the cell cursor and updates the name box. Safe without a grid.
; @tags grid, cursor, gui, v29
V29_CursorRedraw() {
    s := VMB()
    if !s.GridLV
        return
    row := s.GridLV.GetNext(0)
    if row
        SendMessage(0x1015, row - 1, row - 1, s.GridLV)          ; LVM_REDRAWITEMS: the old column's frame goes, the new one is drawn
    if s.GridBar is Map && s.GridBar.Has("Name") {
        cols := V27_Columns()
        num := row ? s.GridLV.GetText(row, 1) : ""
        s.GridBar["Name"].Value := V29_NameText(row && s.GridCol >= 1 && s.GridCol <= cols.Length ? cols[s.GridCol].Title : "", num)
    }
}

; @summary The pixel rectangle of the cell cursor in the grid's own client pixels: {L, T, R, B}, or 0. The first column's
;          rectangle is cut to the column's width (the list gives the whole row for the first column).
; @tags grid, cursor, gui, v29
V29_CursorRect(row, col, lv := "") {
    s := VMB()
    if !IsObject(lv)
        lv := s.GridLV                                           ; V33: the List / Values grids use it too
    rc := Buffer(16, 0)
    NumPut("Int", col = 1 ? 2 : 0, "Int", col - 1, rc)           ; LVIR_LABEL for the first column, LVIR_BOUNDS for the others
    if !SendMessage(0x1038, row - 1, rc.Ptr, lv)                 ; LVM_GETSUBITEMRECT
        return 0
    L := NumGet(rc, 0, "Int"), T := NumGet(rc, 4, "Int"), R := NumGet(rc, 8, "Int"), B := NumGet(rc, 12, "Int")
    wide := SendMessage(0x101D, col - 1, 0, lv)                  ; LVM_GETCOLUMNWIDTH
    if wide > 0 && (col = 1 || R - L > wide)
        R := L + wide
    return R > L ? {L: L, T: T, R: R, B: B} : 0
}

; @summary Draws the 2 px dark-green frame (Excel's 0x217346) inside a cell rectangle on a device context.
; @tags grid, cursor, gui, v29
V29_DrawFrame(hdc, p) {
    pen := DllCall("CreatePen", "Int", 6, "Int", 2, "UInt", 0x467321, "Ptr")          ; PS_INSIDEFRAME, 2 px, RGB 21 73 46 as BGR
    oldPen := DllCall("SelectObject", "Ptr", hdc, "Ptr", pen, "Ptr")
    oldBrush := DllCall("SelectObject", "Ptr", hdc, "Ptr", DllCall("GetStockObject", "Int", 5, "Ptr"), "Ptr")    ; NULL_BRUSH: frame only
    DllCall("Rectangle", "Ptr", hdc, "Int", p.L, "Int", p.T, "Int", p.R, "Int", p.B)
    DllCall("SelectObject", "Ptr", hdc, "Ptr", oldBrush)
    DllCall("SelectObject", "Ptr", hdc, "Ptr", oldPen)
    DllCall("DeleteObject", "Ptr", pen)
}

; @summary NM_CUSTOMDRAW of the grid: asks for the sub-item paint of the selected row only, and after the current column's
;          cell is painted draws the cell frame on it. Other rows are left to the list (no cost).
; @tags grid, cursor, gui, v29
V29_OnCustomDraw(ctl, lParam) {
    s := VMB()
    stage := NumGet(lParam, 24, "UInt")                          ; NMCUSTOMDRAW.dwDrawStage
    if stage = 1 {                                               ; CDDS_PREPAINT
        s.CurCell := s.View = "grid" ? s.GridLV.GetNext(0) : 0
        s.V33 := s.View = "grid" && s.Sheet = "steps" ? V33_Live() : 0        ; V33: the cell range (rows x columns), shaded light blue
        if !IsObject(s.V33C)
            s.V33C := V33_LookBgr()
        return s.CurCell || s.GridMark.Count || (IsObject(s.V33) && s.V33.Count > 1) || s.V33C.On ? 0x20 : 0          ; CDRF_NOTIFYITEMDRAW
    }
    row := NumGet(lParam, 56, "Ptr") + 1                         ; dwItemSpec = item index
    mark := s.GridMark.Get(row, 0)                               ; V31: a row left out for the preview row (grey) or in an if / otherwise chain (colour bar)
    live := s.V33
    rows := IsObject(live) && live.Count > 1 && row >= live.R1 && row <= live.R2
    look := s.V33C
    if stage = 0x10001                                           ; CDDS_ITEMPREPAINT
        return row = s.CurCell || mark || rows || look.On ? 0x20 : 0     ; CDRF_NOTIFYSUBITEMDRAW: only for the selected / marked / range rows (and, with the Excel look, every row)
    if row != s.CurCell && !mark && !rows && !look.On
        return 0
    sub := NumGet(lParam, 88, "Int")                             ; NMLVCUSTOMDRAW.iSubItem
    if stage = 0x30001 {                                         ; CDDS_ITEMPREPAINT | CDDS_SUBITEM
        ret := 0
        isCur := row = s.CurCell
        if isCur && sub = s.GridCol - 1
            ret |= 0x10                                          ; CDRF_NOTIFYPOSTPAINT for the current column
        if look.On || (rows && !isCur) {                         ; V33: the colours of the cell before this one would stay: start from plain white / black every time
            NumPut("UInt", 0xFFFFFF, lParam, 84)
            NumPut("UInt", 0, lParam, 80)
            ret |= 0x2
        }
        if look.On && sub = 0 && !isCur {
            NumPut("UInt", look.RowHead, lParam, 84)             ; V33: the # column is grey like Excel's row headers
            ret |= 0x2
        }
        if isCur && look.On {
            NumPut("UInt", NumGet(lParam, 64, "UInt") & ~1, lParam, 64)       ; V33: not selected-blue: a light grey-green row, the text stays black
            NumPut("UInt", mark && mark.Grey ? 0x909090 : 0, lParam, 80)
            NumPut("UInt", sub = 0 ? look.RowHead : look.Sel, lParam, 84)
            ret |= 0x2
        }
        if mark {
            if mark.Band && !isCur {
                NumPut("UInt", 0x64381F, lParam, 80)             ; V32: band row: dark blue text on a light blue-grey ground
                NumPut("UInt", 0xF0E6DD, lParam, 84)
                ret |= 0x2
            }
            if mark.Grey && !isCur {
                NumPut("UInt", 0x909090, lParam, 80)             ; clrText: grey
                ret |= 0x2                                       ; CDRF_NEWFONT
            }
            if mark.Chain && sub = V31_WhenSub()
                ret |= 0x10
        }
        if rows && live.Cols.Has(sub + 1) && (!isCur || look.On) {
            NumPut("UInt", look.Range, lParam, 84)               ; V33: clrTextBk light blue for a cell of the range (V32 look: not on the selected row, which stays blue)
            if isCur
                NumPut("UInt", 0, lParam, 80)
            ret |= 0x2
        }
        return ret
    }
    if stage = 0x30002 {                                         ; CDDS_ITEMPOSTPAINT | CDDS_SUBITEM
        if mark && mark.Chain && sub = V31_WhenSub() {
            p := V29_CursorRect(row, sub + 1)
            if IsObject(p)
                V31_DrawBar(NumGet(lParam, 32, "Ptr"), p, V31_ChainColor(mark.Chain))
        }
        if row = s.CurCell && sub = s.GridCol - 1 {
            p := V29_CursorRect(row, sub + 1)
            if IsObject(p)
                V29_DrawFrame(NumGet(lParam, 32, "Ptr"), p)
        }
    }
    return 0
}

; @summary The sub-item number (0-based) of the Only when column.
; @tags grid, v31
V31_WhenSub() {
    for i, col in V27_Columns()
        if col.Key = "when"
            return i - 1
    return -1
}

; @summary The colour (COLORREF 0xBBGGRR) of a chain's bar: the same chain id always gives the same colour; six strong colours in turn.
; @returns Integer
; @tags grid, chains, v31
V31_ChainColor(chain) {
    static pal := [0xC07020, 0x3C9A2E, 0x2060E0, 0xB03CA0, 0x1AA0D8, 0x808000]
    return pal[Mod(Max(1, chain) - 1, pal.Length) + 1]
}

; @summary Paints the chain's colour bar: a 6 px wide strip at the left edge of the cell rectangle.
; @tags grid, chains, v31
V31_DrawBar(hdc, p, color) {
    rc := Buffer(16, 0)
    NumPut("Int", p.L, "Int", p.T + 1, "Int", p.L + 6, "Int", p.B - 1, rc)
    brush := DllCall("CreateSolidBrush", "UInt", color, "Ptr")
    DllCall("FillRect", "Ptr", hdc, "Ptr", rc, "Ptr", brush)
    DllCall("DeleteObject", "Ptr", brush)
}

; @summary Moves the cell cursor to a column (and scrolls it into view); the status bar and name box say where it is.
; @tags grid, cursor, gui, v29
V29_GoCol(col) {
    s := VMB()
    V33_Collapse()                                             ; V33: Home / End / Tab end the cell range
    s.GridCol := col
    row := s.GridLV.GetNext(0)
    if row
        V28_EnsureVisible(row, col)
    V28_CellStatus(row)
}

; @summary Home / End in the grid: the first / last shown column of the row (Excel). Ctrl+Home / Ctrl+End: also the first / last row.
;          which = "first", "last", "top" (first row, first column) or "bottom" (last row, last column).
; @tags grid, cursor, hotkey, v29
V29_Jump(which) {
    s := VMB()
    order := V29_VisibleOrder()
    if !order.Length || !s.GridNodes.Count
        return
    col := (which = "first" || which = "top") ? order[1] : order[order.Length]
    if which = "top"
        V28_SelectRow(1)
    else if which = "bottom"
        V28_SelectRow(s.GridNodes.Count)
    V29_GoCol(col)
}

; @summary Tab / Shift+Tab in the grid (not editing): one cell right / left; at the end of a row on to the next row's first
;          shown cell (back: the previous row's last). Stays put on the very first / last cell.
; @tags grid, cursor, hotkey, v29
V29_TabKey(step) {
    s := VMB()
    order := V29_VisibleOrder()
    row := s.GridLV.GetNext(0)
    if !order.Length || !row
        return
    next := V29_NextCol(order, s.GridCol, step)
    if next = s.GridCol {                                        ; at the end of the row: on to the next / previous row
        if step > 0 && row < s.GridNodes.Count {
            V28_SelectRow(row + 1)
            next := order[1]
        } else if step < 0 && row > 1 {
            V28_SelectRow(row - 1)
            next := order[order.Length]
        }
    }
    V29_GoCol(next)
}

; ----------------------------------------------------------------------------
; V29 item C: copy / paste a cell, like Excel (Ctrl+C = the cell, Shift+Ctrl+C = the row, Ctrl+V pastes, Ctrl+X cuts)
; ----------------------------------------------------------------------------

; @summary The text Ctrl+C puts on the clipboard for one cell. A cell that can be edited gives the same text the editor opens with
;          (so a copied wait pastes back exactly); any other cell gives what the grid shows. Tabs and line breaks become a space.
; @returns String
; @tags grid, copy, v29
V29_CopyText(node, key, shown) {
    text := IsObject(node) && V28_Editable(node, key) != "" ? V28_EditText(node, key) : shown
    return V27_TsvCell(text)
}

; @summary The part of the clipboard that is pasted into one cell: the first line, and of that the first tab-separated field
;          (what Excel gives for a block of cells). Nothing on the clipboard gives "".
; @returns String
; @tags grid, paste, v29
V29_PasteText(clip) {
    lines := StrSplit(String(clip), ["`r", "`n"])
    fields := lines.Length ? StrSplit(lines[1], "`t") : []
    return fields.Length ? fields[1] : ""
}

; @summary The grid's current cell: {Row, Col, Node, Key, Title}, or 0 when no row is selected.
; @tags grid, cursor, v29
V29_Current() {
    s := VMB()
    row := s.GridLV ? s.GridLV.GetNext(0) : 0
    node := row ? s.GridNodes.Get(row, 0) : 0
    cols := V27_Columns()
    if !IsObject(node) || s.GridCol < 1 || s.GridCol > cols.Length
        return 0
    return {Row: row, Col: s.GridCol, Node: node, Key: cols[s.GridCol].Key, Title: cols[s.GridCol].Title}
}

; @summary Ctrl+C in the grid: copies the current cell's text.
; @tags grid, copy, hotkey, v29
V29_CopyCell() {
    cur := V29_Current()
    if !cur
        return
    text := V29_CopyText(cur.Node, cur.Key, VMB().GridLV.GetText(cur.Row, cur.Col))
    A_Clipboard := text
    VMB_Status("Copied " . cur.Title . ": " . (StrLen(text) > 60 ? SubStr(text, 1, 57) . "..." : text) . "   Ctrl+V pastes it into a cell (here or in Excel). Shift+Ctrl+C copies the whole row.")
}

; @summary Ctrl+V in the grid: pastes the first line / first tab field of the clipboard into the current cell, with the same rules
;          as typing it (V28_Plan): a value that does not fit is refused and the status bar says why. One Ctrl+Z undoes it.
; @tags grid, paste, hotkey, v29
V29_PasteCell() {
    cur := V29_Current()
    if !cur
        return
    if V28_Editable(cur.Node, cur.Key) = ""
        return VMB_Status("Cannot paste into " . cur.Title . ". " . V28_NotEditableText())
    clip := A_Clipboard
    if clip = ""
        return VMB_Status("The clipboard has no text to paste.")
    text := V29_PasteText(clip)
    plan := V28_Plan(cur.Node, cur.Key, text)
    if !plan.Ok
        return VMB_Status("Not pasted into " . cur.Title . ": " . plan.Error)
    if V28_SameText(text, V28_EditText(cur.Node, cur.Key))
        return VMB_Status(cur.Title . " already has that.")
    V28_Do(cur.Node, plan, "Pasted into " . cur.Title . ". Ctrl+Z undoes it.")
}

; @summary Ctrl+X in the grid: copies the cell, then clears it - only for the cells Delete can clear (Note, Waits first).
;          Any other cell is not touched and the status bar says so.
; @tags grid, copy, hotkey, v29
V29_CutCell() {
    cur := V29_Current()
    if !cur
        return
    if !V31_Clearable(cur.Key)
        return VMB_Status("Cut works only on a Note, Waits first, Only when or If it fails cell (the cells Delete can clear). Ctrl+C copies this one.")
    if !cur.Node.Has(V31_ClearKey(cur.Key))
        return VMB_Status(cur.Title . " is already empty, nothing to cut.")
    A_Clipboard := V29_CopyText(cur.Node, cur.Key, "")
    V28_DeleteCell()
}

; ----------------------------------------------------------------------------
; V29 item D: columns behave like Excel columns (drag a header to reorder, widths and order remembered, hide / show)
; ----------------------------------------------------------------------------

; @summary Reads "key=width,key=width" (the ini text) into a Map key -> width. Unknown keys, widths under 8 or over 3000 and
;          text that is not a number are skipped.
; @returns Map
; @tags grid, columns, v29
V29_ParseColW(text, cols) {
    known := Map()
    for col in cols
        known[col.Key] := 1
    out := Map()
    for part in StrSplit(String(text), ",") {
        kv := StrSplit(Trim(part), "=")
        if kv.Length = 2 && known.Has(Trim(kv[1])) && IsInteger(Trim(kv[2])) && Integer(Trim(kv[2])) >= 8 && Integer(Trim(kv[2])) <= 3000
            out[Trim(kv[1])] := Integer(Trim(kv[2]))
    }
    return out
}

; @summary The widths Map as ini text, in column order. Only keys that are in the Map.
; @returns String
; @tags grid, columns, v29
V29_ColWText(widths, cols) {
    parts := []
    for col in cols
        if widths.Has(col.Key)
            parts.Push(col.Key . "=" . widths[col.Key])
    return V4_Join(parts, ",")
}

; @summary Reads a saved column order (keys, comma separated) into column numbers, left to right. Unknown and repeated keys are
;          skipped; columns that are not in the text (a newer version added them) go to the end in their normal order.
;          Always returns every column once.
; @returns Array of Integer
; @tags grid, columns, v29
V29_ParseOrder(text, cols) {
    pos := Map()
    for i, col in cols
        pos[col.Key] := i
    out := [], used := Map()
    for part in StrSplit(String(text), ",") {
        key := Trim(part)
        if pos.Has(key) && !used.Has(key) {
            out.Push(pos[key])
            used[key] := 1
        }
    }
    for i, col in cols
        if !used.Has(col.Key)
            out.Push(i)
    return out
}

; @summary A column order (column numbers, left to right) as ini text (keys, comma separated).
; @returns String
; @tags grid, columns, v29
V29_OrderText(order, cols) {
    parts := []
    for c in order
        if c >= 1 && c <= cols.Length
            parts.Push(cols[c].Key)
    return V4_Join(parts, ",")
}

; @summary Reads the saved hidden columns (keys, comma separated) into a Map key -> 1. Unknown keys are skipped.
;          When the text would hide every column, nothing is hidden (the grid is never empty).
; @returns Map
; @tags grid, columns, v29
V29_ParseHidden(text, cols) {
    known := Map()
    for col in cols
        known[col.Key] := 1
    out := Map()
    for part in StrSplit(String(text), ",")
        if known.Has(Trim(part))
            out[Trim(part)] := 1
    return out.Count >= cols.Length ? Map() : out
}

; @summary The hidden columns as ini text, in column order.
; @returns String
; @tags grid, columns, v29
V29_HiddenText(hidden, cols) {
    parts := []
    for col in cols
        if hidden.Has(col.Key)
            parts.Push(col.Key)
    return V4_Join(parts, ",")
}

; @summary Every column in the order the user sees them, left to right (hidden ones included): column numbers, 1-based.
;          Read from the grid (LVM_GETCOLUMNORDERARRAY). Without a grid: the normal order.
; @returns Array of Integer
; @tags grid, columns, v29
V29_DisplayOrder() {
    s := VMB()
    n := V27_Columns().Length
    all := []
    if s.GridLV {
        buf := Buffer(4 * n, 0)
        if SendMessage(0x103B, n, buf.Ptr, s.GridLV)             ; LVM_GETCOLUMNORDERARRAY
            loop n
                all.Push(NumGet(buf, 4 * (A_Index - 1), "Int") + 1)
    }
    if all.Length != n {
        all := []
        loop n
            all.Push(A_Index)
    }
    return all
}

; @summary Puts the grid's columns in an order (array of column numbers, left to right).
; @tags grid, columns, gui, v29
V29_SetOrder(order) {
    s := VMB()
    if !s.GridLV || order.Length != V27_Columns().Length
        return
    buf := Buffer(4 * order.Length, 0)
    for i, c in order
        NumPut("Int", c - 1, buf, 4 * (i - 1))
    SendMessage(0x103A, order.Length, buf.Ptr, s.GridLV)         ; LVM_SETCOLUMNORDERARRAY
    DllCall("InvalidateRect", "Ptr", s.GridLV.Hwnd, "Ptr", 0, "Int", 1)
}

; @summary At start: widths, order and hidden columns from the ini ([V29] ColW, ColOrder, ColHidden). Saved widths mean the grid
;          is not fitted to its content again.
; @tags grid, columns, v29
V29_LoadCols() {
    s := VMB()
    cols := V27_Columns()
    s.GridColW := V29_ParseColW(IniRead(s.Ini, "V29", "ColW", ""), cols)
    s.GridHidden := V29_ParseHidden(IniRead(s.Ini, "V29", "ColHidden", ""), cols)
    saved := IniRead(s.Ini, "V29", "ColOrder", "")
    if s.GridColW.Count
        s.GridSized := true
    if saved != ""
        V29_SetOrder(V29_ParseOrder(saved, cols))
    s.ColsSaved := V29_ColWText(s.GridColW, cols) . "|" . V29_OrderText(V29_DisplayOrder(), cols) . "|" . V29_HiddenText(s.GridHidden, cols)
}

; @summary Writes widths (at 100 %), order and hidden columns to the ini, when they changed. Not before the grid was fitted
;          to its first rows. Called when the grid loses the focus, on zoom, sort, view switch, menu actions and at exit.
; @tags grid, columns, v29
V29_SaveCols() {
    s := VMB()
    if !s.GridLV || !s.GridSized
        return
    try {
        V29_CaptureWidths()
        cols := V27_Columns()
        wt := V29_ColWText(s.GridColW, cols), ot := V29_OrderText(V29_DisplayOrder(), cols), ht := V29_HiddenText(s.GridHidden, cols)
        sig := wt . "|" . ot . "|" . ht
        if sig == s.ColsSaved
            return
        IniWrite(wt, s.Ini, "V29", "ColW")
        IniWrite(ot, s.Ini, "V29", "ColOrder")
        IniWrite(ht, s.Ini, "V29", "ColHidden")
        s.ColsSaved := sig
    }
}

; @summary Shows or hides one column (by key), keeps at least one column, moves the cell cursor off a hidden column, saves.
; @tags grid, columns, gui, v29
V29_ToggleCol(key, *) {
    s := VMB()
    V28_Finish(false)
    V29_CaptureWidths()
    cols := V27_Columns()
    title := key
    for col in cols
        if col.Key = key
            title := col.Title
    near := s.GridCol
    if s.GridHidden.Has(key)
        s.GridHidden.Delete(key)
    else {
        before := V29_VisibleOrder()
        if before.Length <= 1
            return VMB_Status("At least one column has to stay.")
        s.GridHidden[key] := 1
        if s.GridCol >= 1 && s.GridCol <= cols.Length && cols[s.GridCol].Key = key {      ; the cursor was on it: move to its right neighbour (or left at the end)
            near := V29_NextCol(before, s.GridCol, 1)
            if near = s.GridCol
                near := V29_NextCol(before, s.GridCol, -1)
        }
    }
    s.GridCol := near
    if s.GridCol < 1 || s.GridCol > cols.Length || s.GridHidden.Has(cols[s.GridCol].Key)
        s.GridCol := V29_NextCol(V29_VisibleOrder(), s.GridCol, 1)
    V29_ApplyColWidths()
    V29_SaveCols()
    V29_CursorRedraw()
    VMB_Status(title . (s.GridHidden.Has(key) ? " is hidden." : " is shown.") . "  Right-click a column heading to hide or show columns.")
}

; @summary "Reset columns": the start order, the start widths, every column shown.
; @tags grid, columns, gui, v29
V29_ResetCols(*) {
    s := VMB()
    V28_Finish(false)
    s.GridColW := Map(), s.GridHidden := Map(), s.GridColApplied := Map()
    order := []
    loop V27_Columns().Length
        order.Push(A_Index)
    V29_SetOrder(order)
    V29_ApplyColWidths()
    V29_SaveCols()
    V29_CursorRedraw()
    VMB_Status("Columns are back to the start order and widths.")
}

; @summary True when a screen point is on the grid's column heading.
; @tags grid, columns, gui, v29
V29_OnHeader(x, y) {
    s := VMB()
    if !s.GridLV || s.View != "grid" || !s.GridLV.Visible
        return false
    hdr := SendMessage(0x101F, 0, 0, s.GridLV)                   ; LVM_GETHEADER
    if !hdr
        return false
    rc := Buffer(16, 0)
    DllCall("GetWindowRect", "Ptr", hdr, "Ptr", rc)
    return x >= NumGet(rc, 0, "Int") && x < NumGet(rc, 8, "Int") && y >= NumGet(rc, 4, "Int") && y < NumGet(rc, 12, "Int")
}

; @summary Right-click on the column heading: a menu with every column (ticked = shown) and "Reset columns".
; @tags grid, columns, gui, v29
V29_ColMenu(x, y) {
    static last := 0
    s := VMB()
    if A_TickCount - last < 400 || VM_IsRecording() || VM_IsPlaying()
        return
    last := A_TickCount
    V28_Finish(false)
    CoordMode("Menu", "Screen")
    V29_BuildColMenu().Show(x, y)
}

; @summary The column menu: every column (ticked = shown) and "Reset columns".
; @returns Menu
; @tags grid, columns, gui, v29
V29_BuildColMenu() {
    s := VMB()
    m := Menu()
    for col in V27_Columns() {
        m.Add(col.Title, V29_ToggleCol.Bind(col.Key))
        if !s.GridHidden.Has(col.Key)
            m.Check(col.Title)
    }
    m.Add()
    m.Add("Freeze # and Action", V33_ToggleFreeze)             ; V33: the # and Action columns stay in view when scrolling sideways
    if s.Freeze
        m.Check("Freeze # and Action")
    m.Add("Reset columns", V29_ResetCols)
    return m
}

; @summary Gui-level right-click: when it was on the grid's heading, show the column menu (the heading is a child of the list,
;          so the list's own event may not get it).
; @tags grid, columns, gui, v29
V29_OnGuiMenu(gui, ctl, item, isRight, x, y) {
    if V29_OnHeader(x, y)
        V29_ColMenu(x, y)
}

; ============================================================================
; V30: loops without loop blocks - a List sheet, "=Column" cells and a "Run for each row" switch
;   The Steps sheet is what to do once. The List sheet is the things to do it for. One switch runs the steps for each row.
;   Nothing is added to the saved macro's blocks: at Play the run macro is built in memory (V30_BuildRun) from the
;   same step nodes, wrapped in the existing foreach / repeat blocks.
;   Saved in the macro: settings["list"] = Map("headers", [..], "rows", [[..], ..]), settings["runMode"] (once | list | times),
;   settings["runTimes"], and node["once"] (1 = once at start, 0 = repeats; absent = the default rule of V30_OnceFlags).
; ============================================================================

; ----------------------------------------------------------------------------
; V30 item A: the list (pure parts)
; ----------------------------------------------------------------------------

; @summary Excel's column letters: 1 is A, 26 is Z, 27 is AA, 52 is AZ, 53 is BA. Below 1 gives "".
; @returns String
; @tags list, v30
V30_ColName(n) {
    if !IsInteger(n) || n < 1
        return ""
    out := ""
    while n > 0 {
        n -= 1
        out := Chr(65 + Mod(n, 26)) . out
        n //= 26
    }
    return out
}

; @summary Limits of a list: rows and columns.
; @tags list, v30
V30_MaxRows() => 5000
V30_MaxCols() => 30

; @summary True when a cell text is a number (so a first line made of numbers is data, not column names).
; @tags list, v30
V30_IsNumberText(text) => RegExMatch(Trim(text), "^[-+]?[\d.,]+%?$") != 0 && RegExMatch(text, "\d")

; @summary Reads text copied from Excel (tab between cells, line break between rows; a cell with a line break or tab is in
;          quotes) into a list. The first line is the column names when there are at least two lines, no cell of it is a
;          number, none is empty and all are different; otherwise the columns are called A, B, C ... Short rows are filled
;          with empty cells. More than 5000 rows / 30 columns are cut off (Cut says so). Never throws.
; @returns {Headers: Array, Rows: Array of Arrays, HasHeader: bool, Cut: String}
; @tags list, paste, v30
V30_ParsePaste(text) {
    text := LTrim(String(text), Chr(0xFEFF))
    rows := []
    try rows := V4_ParseDelimited(text, "`t")
    catch {
        rows := []
        for line in StrSplit(StrReplace(StrReplace(text, "`r`n", "`n"), "`r", "`n"), "`n") {
            rows.Push(StrSplit(line, "`t"))
        }
    }
    while rows.Length && V30_RowEmpty(rows[rows.Length])           ; Excel ends the text with a line break
        rows.Pop()
    if !rows.Length
        return {Headers: [], Rows: [], HasHeader: false, Cut: ""}
    width := 0
    for row in rows
        width := Max(width, row.Length)
    cut := ""
    if width > V30_MaxCols() {
        cut := "Only the first " . V30_MaxCols() . " columns were kept."
        width := V30_MaxCols()
    }
    hasHeader := rows.Length >= 2
    seen := Map()
    seen.CaseSense := false
    if hasHeader {
        Loop width {
            cell := A_Index <= rows[1].Length ? Trim(rows[1][A_Index]) : ""
            if cell = "" || V30_IsNumberText(cell) || seen.Has(cell) || RegExMatch(cell, "[{}]") {
                hasHeader := false
                break
            }
            seen[cell] := 1
        }
    }
    headers := []
    Loop width
        headers.Push(hasHeader ? Trim(rows[1][A_Index]) : V30_ColName(A_Index))
    if hasHeader
        rows.RemoveAt(1)
    out := []
    for row in rows {
        if out.Length >= V30_MaxRows() {
            cut := (cut != "" ? cut . " " : "") . "Only the first " . V30_MaxRows() . " rows were kept."
            break
        }
        item := []
        Loop width
            item.Push(A_Index <= row.Length ? row[A_Index] : "")
        out.Push(item)
    }
    return {Headers: headers, Rows: out, HasHeader: hasHeader, Cut: cut}
}

; @summary True when every cell of a parsed row is empty.
; @tags list, paste, v30
V30_RowEmpty(row) {
    for cell in row
        if Trim(cell) != ""
            return false
    return true
}

; @summary The list stored in a macro's settings, or "" when there is none (or it is not a list).
; @returns Map | ""
; @tags list, v30
V30_ListOf(settings) {
    if !(settings is Map)
        return ""
    list := settings.Get("list", "")
    if list is Map && list.Get("headers", "") is Array && list.Get("rows", "") is Array
        return list
    return ""
}

; @summary A new empty list value for settings["list"].
; @tags list, v30
V30_NewList(headers, rows) => Map("headers", headers, "rows", rows)

; @summary The column names of a macro's list ([] when there is no list).
; @returns Array
; @tags list, v30
V30_Headers(settings) {
    list := V30_ListOf(settings)
    return list is Map ? list["headers"] : []
}

; @summary How many rows a macro's list has.
; @tags list, v30
V30_RowCount(settings) {
    list := V30_ListOf(settings)
    return list is Map ? list["rows"].Length : 0
}

; @summary The data object the runner takes as opts.Data (the same shape VM_LoadData returns): Headers, Rows (one Map per
;          row, column name -> text, names not case sensitive) and DrugCol (the column called Drug, or 0).
; @returns {Headers, Rows, DrugCol}
; @tags list, run, v30
V30_ListData(settings) {
    list := V30_ListOf(settings)
    if !(list is Map)
        return {Headers: [], Rows: [], DrugCol: 0}
    headers := []
    for name in list["headers"]
        headers.Push(String(name))
    records := []
    for row in list["rows"] {
        record := Map()
        record.CaseSense := false
        for j, name in headers
            record[name] := row is Array && j <= row.Length ? String(row[j]) : ""
        records.Push(record)
    }
    drugCol := 0
    for j, name in headers
        if StrLower(name) = "drug"
            drugCol := j
    return {Headers: headers, Rows: records, DrugCol: drugCol}
}

; @summary Checks a new column name: not empty, no braces, not already used by another column (not case sensitive).
;          Returns "" when fine, else a plain sentence. except = the column number being renamed (its own name is fine).
; @returns String
; @tags list, v30
V30_NameError(name, headers, except := 0) {
    name := Trim(name)
    if name = ""
        return "A column name cannot be empty."
    if RegExMatch(name, "[{}]")
        return "A column name cannot contain { or }."
    if name = "#"
        return "# is kept for the round number. Pick another name."
    for i, h in headers
        if i != except && StrLower(Trim(h)) = StrLower(name)
            return "Two columns cannot have the same name (" . name . ")."
    return ""
}

; @summary Cleans a list in place before it is stored: every row has exactly as many cells as there are headers (cells are text).
; @tags list, v30
V30_Normalize(list) {
    w := list["headers"].Length
    for r, row in list["rows"] {
        item := []
        Loop w
            item.Push(A_Index <= row.Length ? String(row[A_Index]) : "")
        list["rows"][r] := item
    }
}

; ----------------------------------------------------------------------------
; V30 item B: =Column cells (pure parts)
; ----------------------------------------------------------------------------

; @summary Turns what the person typed in a Type step's Text cell into the stored text. "=Name" (a whole cell) becomes
;          the placeholder {{Name}} (the column's own spelling); "=#" becomes {{index}} (the round number); "'=x" is the
;          text "=x" typed as it is; anything else is kept. An unknown column is refused with a plain sentence.
; @returns {Ok: bool, Text: String, Error: String}
; @tags list, cells, v30
V30_ToStored(cell, headers) {
    cell := String(cell)
    t := Trim(cell)
    if SubStr(t, 1, 2) = "'="
        return {Ok: true, Text: SubStr(LTrim(cell), 2), Error: ""}
    if SubStr(t, 1, 1) != "="
        return {Ok: true, Text: cell, Error: ""}
    name := Trim(SubStr(t, 2))
    if name = "#"
        return {Ok: true, Text: "{{index}}", Error: ""}
    for h in headers
        if StrLower(Trim(h)) = StrLower(name) && name != ""
            return {Ok: true, Text: "{{" . Trim(h) . "}}", Error: ""}
    if !headers.Length
        return {Ok: false, Text: "", Error: "There is no List yet. Click the List tab and paste your items first (or write text without the = at the start)."}
    names := ""
    for h in headers
        names .= (names = "" ? "" : ", ") . h
    return {Ok: false, Text: "", Error: "There is no list column called " . name . ". The columns are: " . names . ". (To type a text that starts with =, write ' first: '=" . name . ")"}
}

; @summary The text a Type step's cell shows when the macro has a list: {{Name}} on its own is shown as =Name, {{index}} as =#;
;          a stored text that starts with = is shown with a ' in front (so it is not mistaken for a column). Anything else as stored.
; @returns String
; @tags list, cells, v30
V30_ToShown(stored, headers, hash := true) {
    stored := String(stored)
    if RegExMatch(stored, "^\{\{([^{}]+)\}\}$", &m) {
        n := Trim(m[1])
        if hash && StrLower(n) = "index"
            return "=#"
        for h in headers
            if StrLower(Trim(h)) = StrLower(n)
                return "=" . Trim(h)
    }
    if SubStr(stored, 1, 1) = "="
        return "'" . stored
    return stored
}

; @summary What a stored text would type for one list row: every {{Column}} is replaced by that row's cell and {{index}} by the
;          round number. Used says whether any list column (or the round number) was found in the text.
; @returns {Used: bool, Text: String}
; @tags list, cells, preview, v30
V30_Preview(stored, headers, row, number := 1) {
    stored := String(stored), out := "", start := 1, used := false
    while pos := RegExMatch(stored, "\{\{([^{}]+)\}\}", &m, start) {
        out .= SubStr(stored, start, pos - start)
        n := Trim(m[1]), rep := m[0]
        if StrLower(n) = "index" {
            rep := String(number), used := true
        } else
            for j, h in headers
                if StrLower(Trim(h)) = StrLower(n) {
                    rep := row is Array && j <= row.Length ? String(row[j]) : ""
                    used := true
                    break
                }
        out .= rep
        start := pos + StrLen(m[0])
    }
    return {Used: used, Text: out . SubStr(stored, start)}
}

; @summary The Text cell as the grid shows it when a list exists: "=Name → "Smith"" for a whole column cell, the text and
;          "→ "..."" for a mixed one. Returns "" when the text uses no list column (the grid then shows its usual text).
;          row = the preview row's cells (an Array) or "" when the list has no rows.
; @returns String
; @tags list, cells, preview, v30
V30_TextCell(stored, headers, row, number := 1) {
    stored := String(stored)
    pv := V30_Preview(stored, headers, row, number)
    if !pv.Used
        return ""
    shown := V30_ToShown(stored, headers)
    q := Chr(34)
    if !(row is Array)
        return shown = stored ? q . stored . q : shown
    one := RegExMatch(stored, "^\{\{[^{}]+\}\}$") ? shown : q . V20_Short(stored, 40) . q
    return one . " → " . q . V20_Short(StrReplace(StrReplace(pv.Text, "`r", " "), "`n", " "), 40) . q
}

; @summary Which Type steps type exactly what the list's first row holds in some column (so they probably should use that
;          column). steps = nodes; row1 = the first row's cells. A step that already uses {{...}}, asks, or types an empty text
;          is skipped. The first matching column wins. The text must match exactly (upper / lower case counts).
; @returns Array of {Node, Col (number), Name}
; @tags list, match, v30
V30_Match(steps, headers, row1) {
    out := []
    if !(row1 is Array)
        return out
    for node in steps {
        if !(node is Map) || node.Get("type", "") != "text" || V4_Bool(node.Get("ask", 0)) || node.Get("disabled", 0)
            continue
        txt := String(node.Get("text", ""))
        if txt = "" || InStr(txt, "{{")
            continue
        for j, cell in row1
            if j <= headers.Length && String(cell) != "" && String(cell) == txt {
                out.Push({Node: node, Col: j, Name: headers[j]})
                break
            }
    }
    return out
}

; @summary The question asked once after a list is pasted, e.g. Step 4 types "Smith", which is row 1 of column Name. Use the
;          Name column there? (same for 2 more steps). numbers = Map node -> step number (or "" when unknown).
; @returns String
; @tags list, match, v30
V30_MatchText(matches, numbers := "") {
    if !matches.Length
        return ""
    m := matches[1], q := Chr(34)
    n := numbers is Map ? numbers.Get(m.Node, "") : ""
    more := matches.Length - 1
    return (n != "" ? "Step " . n : "A Type step") . " types " . q . V20_Short(String(m.Node.Get("text", "")), 40) . q
        . ", which is row 1 of column " . m.Name . ". Use the " . m.Name . " column there?"
        . (more > 0 ? "  (The same for " . more . " more step" . (more > 1 ? "s" : "") . ".)" : "")
}

; ----------------------------------------------------------------------------
; V30 item C: the run switch (pure parts)
; ----------------------------------------------------------------------------

; @summary True when the blocks contain a loop block made by hand (Repeat, For, For each, Repeat until), anywhere.
; @tags run, v30
V30_HasLoops(blocks) {
    for node in VMF_Flatten(blocks)
        if RegExMatch(node.Get("type", ""), "^(repeat|for|foreach|until)$")
            return true
    return false
}

; @summary For each top-level step: true = "once at start", false = repeats. A step with once = 1 / 0 says it itself; a step
;          without it is "once at start" only when it is a window-setup step (Normalize / Use Window) and every step before
;          it is too. The result is always a run of trues followed by falses.
; @returns Array of bool
; @tags run, once, v30
V30_OnceFlags(blocks) {
    flags := []
    lead := true
    for node in blocks {
        v := node is Map ? node.Get("once", "") : ""
        once := false
        if lead {
            if v = 1 || v = "1"
                once := true
            else if v = 0 || v = "0"
                once := false
            else
                once := node is Map && RegExMatch(node.Get("type", ""), "^(det_normalize_win|det_use_window)$") != 0
        }
        if !once
            lead := false
        flags.Push(once)
    }
    return flags
}

; @summary How many steps at the top are "once at start".
; @tags run, once, v30
V30_LeadCount(blocks) {
    n := 0
    for f in V30_OnceFlags(blocks)
        if f
            n += 1
    return n
}

; @summary The Repeats cell text of a step: "once at start", "yes", or "–" for a step inside another block (only the top steps can be set).
; @tags run, once, v30
V30_RepeatsText(blocks, node) {
    flags := V30_OnceFlags(blocks)
    for i, b in blocks
        if b = node
            return flags[i] ? "once at start" : "yes"
    return "–"
}

; @summary Works out the change of a step's Repeats cell. want = "once at start" or "yes". Only a leading run of steps may be
;          "once at start": the step before must be too (or it is the first), and a step that is set to "yes" must not have a
;          "once at start" step after it. Returns {Ok, Error, Value (1 or 0)}.
; @returns {Ok, Error, Value}
; @tags run, once, v30
V30_SetOnce(blocks, node, want) {
    no(msg) => {Ok: false, Error: msg, Value: 0}
    idx := 0
    for i, b in blocks
        if b = node
            idx := i
    if !idx
        return no("Only the steps at the top of the macro can be set to once at start. This step is inside another block.")
    flags := V30_OnceFlags(blocks)
    w := StrLower(Trim(want))
    if w = "once at start" || w = "once" {
        if idx > 1 && !flags[idx - 1]
            return no("Only the first steps can run once at start. Set step " . (idx - 1) . " to once at start first.")
        return {Ok: true, Error: "", Value: 1}
    }
    if w = "yes" || w = "repeat" || w = "repeats" {
        if idx < flags.Length && flags[idx + 1]
            return no("A step that repeats cannot come before a once-at-start step. Set the step after it to yes first.")
        return {Ok: true, Error: "", Value: 0}
    }
    return no("Pick one of: yes, once at start.")
}

; @summary Builds the macro that is really played, in memory, WITHOUT changing the given macro (the step nodes are shared, the
;          saved macro never gets loop blocks). runMode once (or missing) = the same macro. list = the once-at-start steps,
;          then one For each row block holding the other steps (data = V30_ListData); times = those steps and a Repeat N block.
;          In list mode a failing step skips the rest of that row and the run goes on (onFail nextrow, on the built copy only;
;          a click that would fall back to coordinates still does). Returns {Ok, Error, Macro, Mode}.
; @returns {Ok, Error, Macro, Mode}
; @tags run, v30
V30_BuildRun(macro) {
    settings := macro.Get("settings", Map())
    mode := settings is Map ? String(settings.Get("runMode", "once")) : "once"
    if mode != "list" && mode != "times"
        return {Ok: true, Error: "", Macro: macro, Mode: "once"}
    blocks := macro["blocks"]
    if V30_HasLoops(blocks)
        return {Ok: false, Error: "This macro has its own loop blocks (see List view). Set Run to once, or take the loop blocks out.", Macro: macro, Mode: mode}
    lead := V30_LeadCount(blocks)
    head := [], rest := []
    for i, node in blocks
        (i <= lead ? head : rest).Push(node)
    if !rest.Length
        return {Ok: false, Error: "Every step is set to once at start, so there is nothing to repeat. Set a step's Repeats cell to yes.", Macro: macro, Mode: mode}
    newSettings := settings.Clone()
    if mode = "list" {
        if !V30_RowCount(settings)
            return {Ok: false, Error: "The List is empty. Click the List tab and paste your items first, or choose once.", Macro: macro, Mode: mode}
        wrapper := Map("type", "foreach", "body", rest, "v30", 1)
        if settings.Get("onFail", "coords") = "coords"
            newSettings["v30Coords"] := 1
        newSettings["onFail"] := "nextrow", newSettings["v30Row"] := 1
    } else {
        n := settings.Get("runTimes", 1)
        if !IsInteger(n) || n < 1 || n > 100000
            return {Ok: false, Error: "Write how many times to run, a whole number from 1 to 100000.", Macro: macro, Mode: mode}
        wrapper := Map("type", "repeat", "count", Integer(n), "body", rest)
    }
    all := []
    for node in head
        all.Push(node)
    all.Push(wrapper)
    built := Map("format", macro.Get("format", "VisualMacro"), "version", macro.Get("version", 4), "name", macro.Get("name", ""),
        "settings", newSettings, "blocks", all)
    return {Ok: true, Error: "", Macro: built, Mode: mode}
}

; @summary The sentence for the status bar after a list run, e.g. "12 rows: 11 done, 1 skipped (row 7)." total = rows run
;          through (last row - first row + 1), seen = how many rows were started, skipped = Map row number -> reason, ok = the
;          run was not stopped.
; @returns String
; @tags run, list, v30
V30_RunSummary(total, seen, skipped, ok) {
    bad := skipped.Count
    done := Max(0, seen - bad - (ok ? 0 : 1))
    rowsList := ""
    shown := 0
    for r in V30_SortedKeys(skipped) {
        shown += 1
        if shown <= 5
            rowsList .= (rowsList = "" ? "" : ", ") . r
    }
    if bad > 5
        rowsList .= ", ..."
    word := total = 1 ? "row" : "rows"
    if !ok
        return "Stopped in row " . seen . " of " . total . ": " . done . " done" . (bad ? ", " . bad . " skipped (row" . (bad > 1 ? "s " : " ") . rowsList . ")" : "") . "."
    return total . " " . word . ": " . done . " done" . (bad ? ", " . bad . " skipped (row" . (bad > 1 ? "s " : " ") . rowsList . ")" : "") . "."
}

; @summary The keys of a Map of integers, from small to big.
; @tags list, v30
V30_SortedKeys(map) {
    keys := []
    for k in map
        keys.Push(k)
    n := keys.Length
    Loop n - 1 {
        i := A_Index + 1, v := keys[i], j := i - 1
        while j >= 1 && keys[j] > v {
            keys[j + 1] := keys[j]
            j -= 1
        }
        keys[j + 1] := v
    }
    return keys
}

; @summary The Result column of the List sheet: "done" or "skipped: reason" for rows 1..seen, "" for rows not reached.
; @returns Map row number -> text
; @tags run, list, v30
V30_RowResults(seen, skipped, ok) {
    out := Map()
    Loop seen {
        r := A_Index
        out[r] := skipped.Has(r) ? "skipped: " . skipped[r] : (!ok && r = seen ? "stopped" : "done")
    }
    return out
}

; ----------------------------------------------------------------------------
; V30: the window parts (state, the Run line, the sheet tabs, the List sheet). None of these controls is in s.Ctl.
; ----------------------------------------------------------------------------

; @summary True when the open macro uses the list ideas: it has a List, or its Run switch is on "list" / "times". Only then are
;          {{Column}} texts shown as =Column and an = at the start of a Type text read as a column. Old macros are unchanged.
; @tags list, v30
V30_Gate() {
    s := VMB()
    if !(s.Macro is Map) || !(s.Macro.Get("settings", "") is Map)
        return false
    st := s.Macro["settings"]
    mode := String(st.Get("runMode", "once"))
    return V30_ListOf(st) is Map || mode = "list" || mode = "times" || V31_ValuesOf(st).Length > 0
}

; @summary The column names of the open macro's list ([] when none or no macro).
; @tags list, v30
V30_HeadersNow() {
    s := VMB()
    return s.Macro is Map ? V30_Headers(s.Macro.Get("settings", "")) : []
}

; @summary What the Text cell editor opens with: the stored text, shown as =Column when the macro uses the list ideas.
; @tags list, cells, v30
V30_ShownNow(stored) => V30_Gate() ? V30_ToShown(stored, V31_NamesAllNow()) : String(stored)

; @summary What a typed Text cell becomes: with the list ideas on, =Column is read; otherwise the text is kept as typed.
; @returns {Ok, Text, Error}
; @tags list, cells, v30
V30_StoredNow(input) => V30_Gate() ? V30_ToStored(input, V31_NamesAllNow()) : {Ok: true, Text: String(input), Error: ""}

; @summary The top-level blocks of the open macro ([] when none).
; @tags run, v30
V30_BlocksNow() {
    s := VMB()
    return s.Macro is Map && s.Macro.Get("blocks", "") is Array ? s.Macro["blocks"] : []
}

; @summary True when the step is one of the macro's top-level blocks (only those have a Repeats cell).
; @tags run, v30
V30_IsTop(node) {
    for b in V30_BlocksNow()
        if b = node
            return true
    return false
}

; @summary The list's row for the preview (an Array) or "" when the list has no such row.
; @tags list, preview, v30
V30_PreviewRowCells(settings, number) {
    list := V30_ListOf(settings)
    if list is Map && number >= 1 && number <= list["rows"].Length
        return list["rows"][number]
    return ""
}

; @summary Builds the Run line, the sheet tabs and the List sheet (called once at the end of the grid's build). Hidden until V27_PlaceGrid.
; @tags list, run, gui, v30
V30_Build(g) {
    s := VMB()
    r := s.RunBar := Map()
    r["Lbl"] := g.AddText("x10 y10 w32 h20 +0x200 Hidden", "Run:")
    r["Once"] := g.AddRadio("x+2 yp w60 h20 Group Hidden", "once")
    r["List"] := g.AddRadio("x+4 yp w250 h20 Hidden", "for each row of the List")
    r["Times"] := g.AddRadio("x+4 yp w18 h20 Hidden", "")
    r["TimesN"] := g.AddEdit("x+0 yp w46 h20 Number Hidden", "3")
    r["TimesT"] := g.AddText("x+4 yp w44 h20 +0x200 Hidden", "times")
    r["Note"] := g.AddText("x10 y10 w400 h20 +0x200 Hidden", "This macro has its own loop blocks (see List view).")
    r["PrevT"] := g.AddText("x10 y10 w74 h20 +0x200 Hidden", "Preview row:")
    r["PrevMinus"] := g.AddButton("x+2 yp w22 h20 Hidden", "◄")
    r["Prev"] := g.AddEdit("x+2 yp w42 h20 Number Hidden", "1")
    r["PrevPlus"] := g.AddButton("x+2 yp w22 h20 Hidden", "►")
    r["PrevOf"] := g.AddText("x+4 yp w64 h20 +0x200 Hidden", "of 0")
    r["Once"].OnEvent("Click", (*) => V30_SetRunMode("once"))
    r["List"].OnEvent("Click", (*) => V30_SetRunMode("list"))
    r["Times"].OnEvent("Click", (*) => V30_SetRunMode("times"))
    r["TimesN"].OnEvent("Change", V30_OnTimes)
    r["Prev"].OnEvent("Change", V30_OnPrev)
    r["PrevMinus"].OnEvent("Click", (*) => V30_StepPreview(-1))
    r["PrevPlus"].OnEvent("Click", (*) => V30_StepPreview(1))
    t := s.SheetTabs := Map()
    t["Steps"] := g.AddButton("x10 y10 w84 h22 Hidden", "Steps")
    t["List"] := g.AddButton("x+2 yp w120 h22 Hidden", "List")
    t["Values"] := g.AddButton("x+2 yp w110 h22 Hidden", "Values")
    t["Hint"] := g.AddText("x+10 yp w420 h22 +0x200 Hidden", "Steps = what to do once.   List = the things to do it for.   Values = names you can use as =name.")
    t["Steps"].OnEvent("Click", (*) => V30_SetSheet("steps"))
    t["List"].OnEvent("Click", (*) => V30_SetSheet("list"))
    t["Values"].OnEvent("Click", (*) => V30_SetSheet("values"))
    b := s.ListBar := Map()
    b["Paste"] := g.AddButton("x10 y10 w90 h22 Hidden", "Paste list")
    b["Add"] := g.AddButton("x+4 yp w80 h22 Hidden", "Add row")
    b["Del"] := g.AddButton("x+4 yp w84 h22 Hidden", "Delete row")
    b["Clear"] := g.AddButton("x+4 yp w84 h22 Hidden", "Clear list")
    b["Info"] := g.AddText("x+10 yp w400 h22 +0x200 Hidden", "")
    b["Empty"] := g.AddText("x10 y10 w400 h120 Hidden", "The List is empty.`n`nIn Excel, select your items (put the column names in the first row), press Ctrl+C, then click here and press Paste list (or Ctrl+V).")
    b["Edit"] := g.AddEdit("x10 y10 w100 h22 Hidden +0x4000000")
    b["Paste"].OnEvent("Click", (*) => V30_PasteList())
    b["Add"].OnEvent("Click", (*) => V30_AddRow())
    b["Del"].OnEvent("Click", (*) => V30_DeleteRow())
    b["Clear"].OnEvent("Click", (*) => V30_ClearList())
    b["Edit"].OnEvent("LoseFocus", V30_OnEditLose)
    s.ListLV := g.AddListView("x10 y40 w600 h300 Grid -Multi +LV0x10000 +0x4000000 Hidden", ["#", "Result", "A"])
    s.ListLV.OnEvent("DoubleClick", V30_OnListDouble)
    s.ListLV.OnEvent("Click", V30_OnListClick)
    s.ListLV.OnEvent("ColClick", V30_OnListColClick)
    s.ListLV.OnEvent("ContextMenu", V30_OnListMenu)
    s.ListLV.OnEvent("ItemSelect", V33_OnSheetSelect.Bind("list"))        ; V33: a plain pick ends the cell range
    s.ListLV.OnNotify(-12, V33_OnSheetDraw)                                ; V33: range shading and the cell frame
    OnMessage(0x100, V30_OnWmKeyDown)                          ; WM_KEYDOWN: typing in the list starts an edit
    V30_ApplyListFont()
    V31_BuildValues(g)                                         ; V31.1: the Values sheet
    V32_BuildFind(g)                                           ; V32: the Find bar (Ctrl+F)
    V33_StyleTabs()                                            ; V33: the active tab is bold
    V33_BuildFreeze(g)                                         ; V33: the frozen # and Action pane
}

; @summary The List sheet's font follows the grid zoom (same fonts as the grid).
; @tags list, gui, v30
V30_ApplyListFont() {
    s := VMB()
    if !s.ListLV
        return
    s.ListLV.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2")
    s.ListLV.SetFont(, "Segoe UI")
}

; @summary Puts the Run line, the sheet tabs and the List sheet in place (called by V27_PlaceGrid). (x, y, w) = the area of the
;          tree; gy / gh = where the grid (and the List sheet) goes; barH = height of one bar row. show = grid view is on.
; @tags list, run, gui, v30
V30_Place(x, y, w, gy, gh, barH, show) {
    s := VMB()
    r := s.RunBar, t := s.SheetTabs, b := s.ListBar
    if !(r is Map) || !r.Has("Once") || !s.ListLV || !(s.Macro is Map)
        return
    V30_ListFinish(false)
    V31_ValFinish(false)
    loops := V30_HasLoops(s.Macro["blocks"])
    onList := s.Sheet = "list"
    h := Max(18, barH - 4)
    ; the Run line
    wr := Map(), wt := Map(), wb := Map()                       ; what should be visible; applied at the end only where it differs (hiding / showing the control that has the focus would take the focus away)
    if show {
        cx := x
        r["Lbl"].Move(cx, y + 2, 32, h), cx += 34
        r["Once"].Move(cx, y + 2, 60, h), cx += 64
        wr["Lbl"] := 1, wr["Once"] := 1
        used := 34 + 64
        if loops {
            r["Note"].Move(cx, y + 2, Max(60, w - used), h)
            wr["Note"] := 1
        } else {
            r["List"].Move(cx, y + 2, 250, h), cx += 254
            r["Times"].Move(cx, y + 2, 18, h), cx += 18
            r["TimesN"].Move(cx, y + 2, 46, h), cx += 50
            r["TimesT"].Move(cx, y + 2, 44, h), cx += 48
            for name in ["List", "Times", "TimesN", "TimesT"]
                wr[name] := 1
            if w - (cx - x) >= 250 {
                px := x + w - 232
                r["PrevT"].Move(px, y + 2, 74, h)
                r["PrevMinus"].Move(px + 76, y + 2, 22, h)
                r["Prev"].Move(px + 100, y + 2, 42, h)
                r["PrevPlus"].Move(px + 144, y + 2, 22, h)
                r["PrevOf"].Move(px + 170, y + 2, 62, h)
                for name in ["PrevT", "PrevMinus", "Prev", "PrevPlus", "PrevOf"]
                    wr[name] := 1
            }
        }
    }
    V30_SyncRun()
    ; the sheet tabs under the grid
    if show {
        wt["Steps"] := 1, wt["List"] := 1, wt["Values"] := 1
        ty := gy + gh + 3
        t["Steps"].Move(x, ty, 84, 22)
        t["List"].Move(x + 86, ty, 120, 22)
        t["Values"].Move(x + 208, ty, 110, 22)
        t["Hint"].Move(x + 328, ty, Max(40, w - 328), 22)
        t["Steps"].Enabled := s.Sheet != "steps"
        t["List"].Enabled := !onList
        t["Values"].Enabled := s.Sheet != "values"
        if w >= 760
            wt["Hint"] := 1
        fct := A_ScreenDPI / 96                                 ; repaint the strip: under Wine a moved / disabled button left a blank patch
        rc := Buffer(16, 0)
        NumPut("Int", Round(x * fct), "Int", Round(ty * fct), "Int", Round((x + w + 8) * fct), "Int", Round((ty + 26) * fct), rc)
        DllCall("RedrawWindow", "Ptr", s.Gui.Hwnd, "Ptr", rc, "Ptr", 0, "UInt", 0x185)
    }
    ; the List sheet
    n := V30_RowCount(s.Macro["settings"])
    t["List"].Text := n ? "List (" . n . ")" : "List"
    wl := false
    if show && onList {
        bx := x
        for name in ["Paste", "Add", "Del", "Clear"] {
            b[name].GetPos(, , &wd)
            b[name].Move(bx, y + barH + 4, wd, 22), bx += wd + 4
            wb[name] := 1
        }
        b["Info"].Move(bx + 6, y + barH + 4, Max(40, w - (bx - x) - 6), 22)
        wb["Info"] := 1
        hasCols := V30_Headers(s.Macro["settings"]).Length > 0
        s.ListLV.Move(x, gy, w, gh)
        b["Empty"].Move(x + 10, gy + 10, Max(100, w - 20), Min(140, gh))
        wl := hasCols
        if !hasCols
            wb["Empty"] := 1
    }
    for pair in [[r, wr], [t, wt], [b, wb]]
        for name, ctl in pair[1] {
            if name = "Edit"
                continue
            if ctl.Visible != pair[2].Has(name)
                ctl.Visible := pair[2].Has(name)
        }
    if s.ListLV.Visible != wl
        s.ListLV.Visible := wl
    V31_PlaceValues(x, y, w, gy, gh, barH, show)               ; V31.1: the Values sheet
}

; @summary Syncs the Run line with the macro: which choice is on, the row count, the times number, the preview row, and whether the
;          switch is off because the macro has its own loop blocks.
; @tags list, run, gui, v30
V30_SyncRun() {
    s := VMB()
    r := s.RunBar
    if !(r is Map) || !r.Has("Once") || !(s.Macro is Map) || !(s.Macro.Get("settings", "") is Map)
        return
    st := s.Macro["settings"]
    mode := String(st.Get("runMode", "once"))
    n := V30_RowCount(st)
    loops := V30_HasLoops(s.Macro["blocks"])
    r["Once"].Value := loops || (mode != "list" && mode != "times") ? 1 : 0
    r["List"].Value := !loops && mode = "list" ? 1 : 0
    r["Times"].Value := !loops && mode = "times" ? 1 : 0
    r["List"].Text := "for each row of the List (" . n . (n = 1 ? " row)" : " rows)")
    if DllCall("GetFocus", "Ptr") != r["TimesN"].Hwnd
        r["TimesN"].Value := st.Get("runTimes", 3)
    s.PreviewRow := Max(1, Min(Max(1, n), s.PreviewRow))
    if DllCall("GetFocus", "Ptr") != r["Prev"].Hwnd
        r["Prev"].Value := s.PreviewRow
    r["PrevOf"].Text := "of " . n
    r["PrevT"].Text := mode = "times" ? "Round:" : "Preview row:"
}

; @summary Called at the end of VMB_Refresh: the Run line, the tabs and (when it is shown) the List sheet follow the macro.
; @tags list, run, gui, v30
V30_Refresh() {
    s := VMB()
    if !(s.RunBar is Map) || !s.RunBar.Has("Once") || !(s.Macro is Map)
        return
    V30_SyncRun()
    n := V30_RowCount(s.Macro["settings"])
    s.SheetTabs["List"].Text := n ? "List (" . n . ")" : "List"
    if s.Sheet = "list" && s.View = "grid"
        V30_FillList()
    V31_ValRefresh()
}

; @summary The Run switch was clicked: stores runMode in the macro (Dirty, autosave). The list mode warns when the List is empty.
; @tags list, run, gui, v30
V30_SetRunMode(mode) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !(s.Macro is Map)
        return
    st := s.Macro["settings"]
    st["runMode"] := mode
    s.Dirty := true
    V7_ScheduleAutoSave()
    VMB_UpdateTitle()
    V30_SyncRun()
    V27_FillGrid()                                         ; the Text cells show =Column only when the macro uses the list
    V27_PlaceGrid()
    if mode = "list"
        VMB_Status(V30_RowCount(st) ? "Run: for each row of the List (" . V30_RowCount(st) . " rows). Play runs the steps once for every row."
            : "Run: for each row of the List - but the List is empty. Click the List tab and paste your items.")
    else if mode = "times"
        VMB_Status("Run: " . st.Get("runTimes", 3) . " times. Use =# in a Type step to type the round number (1, 2, 3 ...).")
    else
        VMB_Status("Run: once.")
}

; @summary The "times" number was typed: stores it and switches to "times".
; @tags list, run, gui, v30
V30_OnTimes(ctl, *) {
    s := VMB()
    if !(s.Macro is Map)
        return
    v := Trim(ctl.Value)
    if !IsInteger(v) || Integer(v) < 1
        return
    st := s.Macro["settings"]
    st["runTimes"] := Min(100000, Integer(v))
    if st.Get("runMode", "once") != "times"
        return V30_SetRunMode("times")
    s.Dirty := true
    V7_ScheduleAutoSave()
}

; @summary The preview row number was typed.
; @tags list, preview, gui, v30
V30_OnPrev(ctl, *) {
    s := VMB()
    v := Trim(ctl.Value)
    if !IsInteger(v)
        return
    V30_SetPreview(Integer(v))
}

; @summary The preview row buttons.
; @tags list, preview, gui, v30
V30_StepPreview(step) {
    s := VMB()
    V30_SetPreview(s.PreviewRow + step)
    s.RunBar["Prev"].Value := s.PreviewRow
}

; @summary Sets the preview row (kept inside the list) and redraws the grid's Text cells.
; @tags list, preview, gui, v30
V30_SetPreview(n) {
    s := VMB()
    if !(s.Macro is Map)
        return
    cnt := V30_RowCount(s.Macro["settings"])
    n := Max(1, Min(Max(1, cnt), n))
    if n = s.PreviewRow && s.GridRows.Length
        return
    s.PreviewRow := n
    if s.View = "grid"
        V27_FillGrid()
}

; @summary Switches between the Steps sheet and the List sheet (the tabs under the grid).
; @tags list, gui, v30
V30_SetSheet(sheet) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || s.Sheet = sheet
        return
    V28_Cancel(false)
    V30_ListFinish(false)
    V31_ValFinish(false)
    s.Sheet := sheet
    if s.View != "grid"
        V27_SetView("grid")
    V33_StyleTabs()                                            ; V33: the active tab is bold
    if sheet = "list"
        V30_FillList()
    else if sheet = "values"
        V31_ValFill()
    else
        V27_FillGrid()                                     ; the Text cells show the preview of the (maybe changed) list
    V27_PlaceGrid()
    try (sheet = "list" ? (s.ListLV.Visible ? s.ListLV : s.ListBar["Paste"]) : sheet = "values" ? s.ValLV : s.GridLV).Focus()
    VMB_Status(sheet = "list" ? "List sheet: the things to do the steps for. Paste from Excel (Ctrl+V), double-click a cell to change it."
        : sheet = "values" ? "Values sheet: names you can use as =name in a Type step or an Only when rule. Add value, then double-click a cell."
        : "Steps sheet.")
}

; @summary True while the List sheet's grid has the keyboard focus (for its hotkeys).
; @tags list, hotkey, v30
V30_ListFocused(*) {
    s := VMB()
    return s.ListLV && s.Gui && s.View = "grid" && s.Sheet = "list" && !s.ListEditOn && !VM_IsPlaying() && !VM_IsRecording()
        && WinActive("ahk_id " . s.Gui.Hwnd) && DllCall("GetFocus", "Ptr") = s.ListLV.Hwnd
}

; @summary True while the List cell editor has the keyboard focus (for Enter / Tab / Esc).
; @tags list, hotkey, v30
V30_ListEditFocused(*) {
    s := VMB()
    return s.ListEditOn && s.Gui && !VM_IsPlaying() && !VM_IsRecording() && WinActive("ahk_id " . s.Gui.Hwnd)
        && DllCall("GetFocus", "Ptr") = s.ListBar["Edit"].Hwnd
}

; ----------------------------------------------------------------------------
; V30 item A: the List sheet (fill, paste, edit)
; ----------------------------------------------------------------------------

; @summary Fills the List sheet from the macro's list: column 1 = row number, column 2 = Result (empty until a run), then one
;          column per list column. Shows a hint instead when the list has no columns.
; @tags list, gui, v30
V30_FillList() {
    s := VMB()
    lv := s.ListLV
    if !lv || !(s.Macro is Map)
        return
    V30_ListCancel(false)
    list := V30_ListOf(s.Macro["settings"])
    heads := list is Map ? list["headers"] : []
    keep := lv.GetNext(0)
    lv.Opt("-Redraw")
    lv.Delete()
    while lv.GetCount("Col") > 0
        lv.DeleteCol(1)
    lv.InsertCol(1, 44, "#")
    lv.InsertCol(2, 0, "Result")
    for j, name in heads
        lv.InsertCol(2 + j, 110, name)
    if list is Map
        for r, row in list["rows"] {
            cells := [r, s.ListResult.Get(r, "")]
            for j, name in heads
                cells.Push(j <= row.Length ? row[j] : "")
            lv.Add("", cells*)
        }
    for j, name in heads {
        lv.ModifyCol(2 + j, "AutoHdr")
        if SendMessage(0x101D, 1 + j, 0, lv) > 300
            lv.ModifyCol(2 + j, 300)
        else if SendMessage(0x101D, 1 + j, 0, lv) < 70
            lv.ModifyCol(2 + j, 70)
    }
    lv.ModifyCol(2, s.ListResult.Count ? 220 : 0)
    lv.Opt("+Redraw")
    if keep && keep <= lv.GetCount()
        lv.Modify(keep, "Select Focus Vis")
    s.ListCol := Max(3, Min(s.ListCol, 2 + Max(1, heads.Length)))
    n := list is Map ? list["rows"].Length : 0
    s.ListBar["Info"].Text := heads.Length ? n . (n = 1 ? " row, " : " rows, ") . heads.Length . (heads.Length = 1 ? " column" : " columns")
        . ".   Click a column name to rename it." : ""
    hasCols := heads.Length > 0
    if s.Sheet = "list" && s.View = "grid" {
        lv.Visible := hasCols
        s.ListBar["Empty"].Visible := !hasCols
    }
}

; @summary Remembers the list as it is (for Ctrl+Z on the List sheet). what = "" for "no list yet".
; @tags list, undo, v30
V30_ListPush() {
    s := VMB()
    list := V30_ListOf(s.Macro["settings"])
    s.ListUndo.Push(list is Map ? JSON.Stringify(list) : "")
    if s.ListUndo.Length > 40
        s.ListUndo.RemoveAt(1)
    s.ListRedo := []
}

; @summary A change to the list is done: Dirty, autosave, the Run line, the tabs and the sheet follow; results of an older run are gone.
; @tags list, v30
V30_ListChanged(keepResults := false) {
    s := VMB()
    s.Dirty := true
    if !keepResults
        s.ListResult := Map()
    V7_ScheduleAutoSave()
    VMB_UpdateTitle()
    V30_Refresh()
    V27_PlaceGrid()
}

; @summary Replaces the macro's list (list = a V30_NewList value, or "" to remove it). One Ctrl+Z on the List sheet undoes it.
; @tags list, v30
V30_SetList(list) {
    s := VMB()
    V30_ListPush()
    if list is Map {
        V30_Normalize(list)
        s.Macro["settings"]["list"] := list
    } else if s.Macro["settings"].Has("list")
        s.Macro["settings"].Delete("list")
    s.PreviewRow := 1
    V30_ListChanged()
}

; @summary Paste list: the clipboard (tab / line separated text, like copied from Excel) becomes the List. After it, Type steps that type
;          exactly a cell of row 1 are offered the column (V30_AutoMatch). answer = "yes" / "no" answers that question without a box (tests).
; @tags list, paste, v30
V30_PasteList(text := "", answer := "") {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !(s.Macro is Map)
        return false
    if text = ""
        text := A_Clipboard
    p := V30_ParsePaste(text)
    if !p.Rows.Length {
        VMB_Status("There is nothing to paste. In Excel select your cells and press Ctrl+C, then paste here.")
        return false
    }
    V30_SetList(V30_NewList(p.Headers, p.Rows))
    VMB_Status("List pasted: " . p.Rows.Length . (p.Rows.Length = 1 ? " row, " : " rows, ") . p.Headers.Length . (p.Headers.Length = 1 ? " column" : " columns")
        . (p.HasHeader ? " (names from the first line)." : " (called A, B, C ... because the first line has no names; click a name to rename it).")
        . (p.Cut != "" ? "  " . p.Cut : ""))
    V30_AutoMatch(answer)
    return true
}

; @summary After a paste: finds Type steps that type exactly a cell of the list's first row and asks once whether they should use that
;          column (=Name). Yes changes those steps (one Ctrl+Z on the Steps sheet undoes it). Returns how many steps changed.
; @tags list, match, v30
V30_AutoMatch(answer := "") {
    s := VMB()
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map) || !list["rows"].Length
        return 0
    flat := VMF_Flatten(s.Macro["blocks"])
    matches := V30_Match(flat, list["headers"], list["rows"][1])
    if !matches.Length
        return 0
    nums := Map()
    for i, node in flat
        nums[node] := i
    if answer = ""
        answer := MsgBox(V30_MatchText(matches, nums), "Visual Macro Blocks - use the list columns?", "YesNo Iconi Owner" . s.Gui.Hwnd) = "Yes" ? "yes" : "no"
    if answer != "yes"
        return 0
    VMB_Snapshot()
    for m in matches
        m.Node["text"] := "{{" . m.Name . "}}"
    s.Dirty := true
    VMB_Refresh()
    V7_AutoSaveNow()
    VMB_Status(matches.Length . (matches.Length = 1 ? " Type step now uses" : " Type steps now use") . " a list column. Ctrl+Z on the Steps sheet puts the text back.")
    return matches.Length
}

; @summary Add row: an empty row after the selected one (or at the end). With no list yet, starts one with a column called A.
; @tags list, gui, v30
V30_AddRow() {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !(s.Macro is Map)
        return
    V30_ListFinish(false)
    list := V30_ListOf(s.Macro["settings"])
    V30_ListPush()
    if !(list is Map) {
        list := V30_NewList(["A"], [])
        s.Macro["settings"]["list"] := list
    }
    if list["rows"].Length >= V30_MaxRows() {
        VMB_Status("The List can have at most " . V30_MaxRows() . " rows.")
        return
    }
    at := s.ListLV.GetNext(0)
    pos := at ? V30_RowOf(at) + 1 : list["rows"].Length + 1
    row := []
    Loop list["headers"].Length
        row.Push("")
    list["rows"].InsertAt(Max(1, Min(pos, list["rows"].Length + 1)), row)
    V30_ListChanged()
    try s.ListLV.Modify(Min(pos, s.ListLV.GetCount()), "Select Focus Vis")
    VMB_Status("Row added. Double-click a cell to type in it.")
}

; @summary Delete row: removes the selected row.
; @tags list, gui, v30
V30_DeleteRow() {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !(s.Macro is Map)
        return
    V30_ListFinish(false)
    list := V30_ListOf(s.Macro["settings"])
    at := s.ListLV.GetNext(0)
    if !(list is Map) || !at
        return VMB_Status("Click a row first, then Delete row.")
    pos := V30_RowOf(at)
    if pos < 1 || pos > list["rows"].Length
        return
    V30_ListPush()
    list["rows"].RemoveAt(pos)
    V30_ListChanged()
    try s.ListLV.Modify(Min(pos, s.ListLV.GetCount()), "Select Focus Vis")
    VMB_Status("Row " . pos . " deleted. Ctrl+Z puts it back.")
}

; @summary Clear list: removes the whole List (asks first).
; @tags list, gui, v30
V30_ClearList(answer := "") {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !(s.Macro is Map)
        return
    V30_ListFinish(false)
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map)
        return VMB_Status("The List is already empty.")
    if answer = ""
        answer := MsgBox("Remove all " . list["rows"].Length . " rows and the column names from the List?`n`nCtrl+Z on the List sheet brings it back.",
            "Visual Macro Blocks - clear the list", "YesNo Icon? Owner" . s.Gui.Hwnd) = "Yes" ? "yes" : "no"
    if answer != "yes"
        return
    V30_SetList("")
    VMB_Status("The List is cleared.")
}

; @summary The list row number of a List sheet row (the number in the first column, so a sorted or filtered sheet still points at the right row).
; @tags list, gui, v30
V30_RowOf(lvRow) {
    s := VMB()
    t := s.ListLV.GetText(lvRow, 1)
    return IsInteger(t) ? Integer(t) : lvRow
}

; @summary Ctrl+Z / Ctrl+Y on the List sheet: puts the list back to before the last change (or forward again).
; @tags list, undo, v30
V30_ListUndo(redo := false) {
    s := VMB()
    from := redo ? s.ListRedo : s.ListUndo, to := redo ? s.ListUndo : s.ListRedo
    if !from.Length
        return VMB_Status(redo ? "Nothing to redo on the List sheet." : "Nothing to undo on the List sheet.")
    V30_ListFinish(false)
    cur := V30_ListOf(s.Macro["settings"])
    to.Push(cur is Map ? JSON.Stringify(cur) : "")
    old := from.Pop()
    if old = ""
        s.Macro["settings"].Delete("list")
    else
        s.Macro["settings"]["list"] := JSON.Parse(old)
    V30_ListChanged()
    VMB_Status(redo ? "Redone." : "Undone.")
}

; ---- the cell editor of the List sheet (an Edit placed on top of the cell, like the grid's)

; @summary Cell rectangle (client pixels of the list) of a cell of the List sheet, in the window's units: {X, Y, W, H}, or 0.
; @tags list, gui, v30
V30_CellRect(row, col, lv := "") {
    s := VMB()
    if !IsObject(lv)
        lv := s.ListLV
    rc := Buffer(16, 0)
    NumPut("Int", 0, "Int", col - 1, rc)
    if !SendMessage(0x1038, row - 1, rc.Ptr, lv)               ; LVM_GETSUBITEMRECT
        return 0
    lx := NumGet(rc, 0, "Int"), ly := NumGet(rc, 4, "Int"), rx := NumGet(rc, 8, "Int"), ry := NumGet(rc, 12, "Int")
    cl := Buffer(16, 0)
    DllCall("GetClientRect", "Ptr", lv.Hwnd, "Ptr", cl)
    rx := Min(rx, NumGet(cl, 8, "Int"))
    pt := Buffer(8, 0)
    NumPut("Int", lx, "Int", ly, pt)
    DllCall("MapWindowPoints", "Ptr", lv.Hwnd, "Ptr", s.Gui.Hwnd, "Ptr", pt, "UInt", 1)
    f := 96 / A_ScreenDPI
    return {X: Round(NumGet(pt, 0, "Int") * f), Y: Round(NumGet(pt, 4, "Int") * f), W: Max(8, Round((rx - lx) * f)), H: Max(8, Round((ry - ly) * f))}
}

; @summary Scrolls the List sheet so a cell is fully visible.
; @tags list, gui, v30
V30_EnsureVisible(row, col, lv := "") {
    s := VMB()
    if !IsObject(lv)
        lv := s.ListLV
    try lv.Modify(row, "Vis")
    rc := Buffer(16, 0)
    NumPut("Int", 0, "Int", col - 1, rc)
    if !SendMessage(0x1038, row - 1, rc.Ptr, lv)
        return
    lx := NumGet(rc, 0, "Int"), rx := NumGet(rc, 8, "Int")
    cl := Buffer(16, 0)
    DllCall("GetClientRect", "Ptr", lv.Hwnd, "Ptr", cl)
    cw := NumGet(cl, 8, "Int")
    dx := lx < 0 ? lx : rx > cw ? Min(rx - cw, lx) : 0
    if dx
        SendMessage(0x1014, dx, 0, lv)                         ; LVM_SCROLL
}

; @summary Which cell of the List sheet is under the mouse: {Row, Col} (1-based, 0 when none).
; @tags list, gui, v30
V30_HitCell(lv := "") {
    s := VMB()
    if !IsObject(lv)
        lv := s.ListLV
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    DllCall("ScreenToClient", "Ptr", lv.Hwnd, "Ptr", pt)
    inf := Buffer(24, 0)
    NumPut("Int", NumGet(pt, 0, "Int"), "Int", NumGet(pt, 4, "Int"), inf)
    SendMessage(0x1039, 0, inf.Ptr, lv)                  ; LVM_SUBITEMHITTEST
    return {Row: NumGet(inf, 12, "Int") + 1, Col: NumGet(inf, 16, "Int") + 1}
}

; @summary Opens the editor on a List cell (row = sheet row, col = sheet column; the first two columns are not editable).
;          startText = a typed first character (or "").
; @tags list, gui, v30
V30_ListOpen(row, col, startText := "") {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !s.ListLV || s.Sheet != "list" || s.View != "grid"
        return false
    V30_ListFinish(false)
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map) || row < 1 || row > s.ListLV.GetCount() || col < 3 || col > 2 + list["headers"].Length
        return false
    pos := V30_RowOf(row)
    s.ListCol := col
    V30_EnsureVisible(row, col)
    rect := V30_CellRect(row, col)
    if !IsObject(rect)
        return false
    s.ListEditRow := pos, s.ListEditLvRow := row, s.ListEditCol := col
    s.ListEditOrig := list["rows"][pos][col - 2]
    ed := s.ListBar["Edit"]
    ed.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2"), ed.SetFont(, "Segoe UI")
    ed.Value := startText != "" ? startText : s.ListEditOrig
    ed.Move(rect.X, rect.Y, rect.W, rect.H)
    s.ListEditOn := true
    ed.Visible := true
    DllCall("SetWindowPos", "Ptr", ed.Hwnd, "Ptr", 0, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x43)
    ed.Focus()
    DllCall("RedrawWindow", "Ptr", ed.Hwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x185)
    n := StrLen(startText)
    SendMessage(0xB1, startText != "" ? n : 0, startText != "" ? n : -1, ed)       ; EM_SETSEL
    VMB_Status("List cell: " . list["headers"][col - 2] . ", row " . pos . ".   Enter saves, Tab goes on, Esc cancels.")
    return true
}

; @summary Hides the List cell editor (refocus = give the keyboard back to the List sheet).
; @tags list, gui, v30
V30_ListHide(refocus := true) {
    s := VMB()
    if !(s.ListBar is Map) || !s.ListBar.Has("Edit")
        return
    s.ListEditOn := false
    s.ListBar["Edit"].Visible := false
    if refocus && s.ListLV && s.Sheet = "list" && s.View = "grid"
        try s.ListLV.Focus()
}

; @summary Closes the editor and throws the typed text away.
; @tags list, gui, v30
V30_ListCancel(refocus := true) {
    s := VMB()
    if s.ListEditOn
        V30_ListHide(refocus)
}

; @summary Closes the editor and keeps the text (clicking elsewhere, re-layout).
; @tags list, gui, v30
V30_ListFinish(refocus := true) {
    s := VMB()
    if s.ListEditOn
        V30_ListCommit(refocus)
}

; @summary Writes the editor's text into the list (one Ctrl+Z undoes it) and closes the editor.
; @tags list, gui, v30
V30_ListCommit(refocus := true) {
    s := VMB()
    if !s.ListEditOn
        return
    text := s.ListBar["Edit"].Value
    pos := s.ListEditRow, col := s.ListEditCol
    V30_ListHide(refocus)
    if VM_IsRecording() || VM_IsPlaying()
        return
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map) || pos < 1 || pos > list["rows"].Length || text == s.ListEditOrig
        return
    V30_ListPush()
    list["rows"][pos][col - 2] := text
    s.Dirty := true
    s.ListResult := Map()
    V7_ScheduleAutoSave()
    try s.ListLV.Modify(s.ListEditLvRow, "Col" . col, text)
    VMB_Status("Changed row " . pos . ", " . list["headers"][col - 2] . ". Ctrl+Z undoes it.")
}

; @summary Enter / Tab / Shift+Tab in the List editor: saves, then moves (Enter = the cell below is selected, Tab = the next cell opens).
; @tags list, gui, v30
V30_ListEnter(where) {
    s := VMB()
    lvRow := s.ListEditLvRow, col := s.ListEditCol
    V30_ListCommit()
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map)
        return
    w := list["headers"].Length
    if where = "down" {
        if lvRow < s.ListLV.GetCount()
            s.ListLV.Modify(lvRow + 1, "Select Focus Vis")
        return
    }
    step := where = "back" ? -1 : 1
    col += step
    if col > 2 + w {
        col := 3, lvRow += 1
    } else if col < 3 {
        col := 2 + w, lvRow -= 1
    }
    if lvRow < 1 || lvRow > s.ListLV.GetCount()
        return
    s.ListLV.Modify(lvRow, "Select Focus Vis")
    V30_ListOpen(lvRow, col)
}

; @summary The editor lost the keyboard focus (clicked elsewhere): the text is kept.
; @tags list, gui, v30
V30_OnEditLose(ctl, *) {
    s := VMB()
    if !s.ListEditOn || DllCall("GetFocus", "Ptr") = ctl.Hwnd
        return
    V30_ListFinish(false)
}

; @summary Double-click a List cell: edit it.
; @tags list, gui, v30
V30_OnListDouble(lv, row) {
    if !row
        return
    hit := V30_HitCell()
    if hit.Row = row && hit.Col >= 3
        V30_ListOpen(row, hit.Col)
}

; @summary Click a List cell: it becomes the current cell (F2 / Enter edits it, Ctrl+C copies it).
; @tags list, gui, v30
V30_OnListClick(lv, row) {
    s := VMB()
    if !row
        return
    hit := V30_HitCell()
    if hit.Row = row && hit.Col >= 3 {
        V33_SClick("list", row, s.ListCol)                     ; V33: Shift+click grows the range, a plain click ends it
        s.ListCol := hit.Col
        V33_SRepaint("list")
        V33_SStatus("list")
    }
}

; @summary Click a column name: rename that column (a column name is what =Name and {{Name}} use).
; @tags list, gui, v30
V30_OnListColClick(lv, col) {
    s := VMB()
    if col < 3 || VM_IsRecording() || VM_IsPlaying()
        return
    V30_RenameColumn(col - 2)
}

; @summary Renames a list column (asks for the name). Steps that use {{OldName}} are changed to the new name, so they still work.
; @tags list, gui, v30
V30_RenameColumn(j, newName := "") {
    s := VMB()
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map) || j < 1 || j > list["headers"].Length
        return false
    old := list["headers"][j]
    if newName = "" {
        reply := InputBox("New name for the column " . old . ":", "Rename column", "w320 h130", old)
        if reply.Result != "OK"
            return false
        newName := reply.Value
    }
    newName := Trim(newName)
    err := V30_NameError(newName, list["headers"], j)
    if err = "" && V31_HasValueNamed(s.Macro["settings"], newName)
        err := newName . " is already the name of a Value. Pick another name."
    if err != "" {
        VMB_Status(err)
        return false
    }
    if newName == old
        return false
    V30_ListPush()
    VMB_Snapshot()
    names := V31_NamesAll(s.Macro["settings"])                    ; V33: the names before the rename (the rules that use the old one follow below)
    list["headers"][j] := newName
    changed := 0
    for node in VMF_Flatten(s.Macro["blocks"])
        if node.Get("type", "") = "text" && InStr(node.Get("text", ""), "{{" . old . "}}") {
            node["text"] := StrReplace(node["text"], "{{" . old . "}}", "{{" . newName . "}}")
            changed += 1
        }
    changed += V33_RenameInRules(s.Macro["blocks"], names, old, newName)
    V30_ListChanged(true)
    VMB_Refresh()
    VMB_Status("Column " . old . " is now called " . newName . "." . (changed ? "  " . changed . (changed = 1 ? " step was" : " steps were") . " changed to the new name." : ""))
    return true
}

; @summary Right-click on the List sheet: the four list actions.
; @tags list, gui, v30
V30_OnListMenu(lv, row, isRight, x, y) {
    m := Menu()
    m.Add("Paste list`tCtrl+V", (*) => V30_PasteList())
    m.Add("Add row", (*) => V30_AddRow())
    m.Add("Delete row", (*) => V30_DeleteRow())
    m.Add("Clear list", (*) => V30_ClearList())
    m.Show()
}

; @summary F2 / Enter on the List sheet: edit the current cell.
; @tags list, gui, v30
V30_OpenCurrent() {
    s := VMB()
    row := s.ListLV.GetNext(0)
    if row
        V30_ListOpen(row, s.ListCol)
}

; @summary Left / Right on the List sheet: moves the current column.
; @tags list, gui, v30
V30_MoveCol(step) {
    s := VMB()
    V33_SCollapse("list")                                      ; V33: a plain arrow ends the cell range
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map)
        return
    s.ListCol := Max(3, Min(2 + list["headers"].Length, s.ListCol + step))
    row := s.ListLV.GetNext(0)
    if row
        V30_EnsureVisible(row, s.ListCol)
    VMB_Status("Column: " . list["headers"][s.ListCol - 2] . "   (F2 or Enter edits the cell)")
}

; @summary Delete on the List sheet: empties the current cell.
; @tags list, gui, v30
V30_ClearCell() {
    s := VMB()
    list := V30_ListOf(s.Macro["settings"])
    row := s.ListLV.GetNext(0)
    if !(list is Map) || !row
        return
    pos := V30_RowOf(row)
    if list["rows"][pos][s.ListCol - 2] = ""
        return
    V30_ListPush()
    list["rows"][pos][s.ListCol - 2] := ""
    s.Dirty := true
    s.ListResult := Map()
    V7_ScheduleAutoSave()
    s.ListLV.Modify(row, "Col" . s.ListCol, "")
    VMB_Status("Cell emptied. Ctrl+Z undoes it.")
}

; @summary Ctrl+C on the List sheet: the current cell's text on the clipboard.
; @tags list, gui, v30
V30_CopyCell() {
    s := VMB()
    row := s.ListLV.GetNext(0)
    if !row
        return
    A_Clipboard := s.ListLV.GetText(row, s.ListCol)
    VMB_Status("Copied the cell.")
}

; @summary WM_KEYDOWN monitor: a letter or digit typed on the List sheet starts editing the current cell with that character.
; @tags list, gui, v30
V30_OnWmKeyDown(wParam, lParam, msg, hwnd) {
    s := VMB()
    if !s.ListLV || hwnd != s.ListLV.Hwnd || s.ListEditOn || s.Sheet != "list" || VM_IsRecording() || VM_IsPlaying() || GetKeyState("Ctrl") || GetKeyState("Alt")
        return
    shifted := GetKeyState("Shift")
    if wParam >= 0x41 && wParam <= 0x5A
        ch := (shifted != GetKeyState("CapsLock", "T")) ? Chr(wParam) : StrLower(Chr(wParam))
    else if wParam >= 0x30 && wParam <= 0x39 && !shifted
        ch := Chr(wParam)
    else if wParam >= 0x60 && wParam <= 0x69
        ch := Chr(wParam - 0x30)
    else
        return
    row := s.ListLV.GetNext(0)
    if row
        V30_ListOpen(row, s.ListCol, ch)
}

; ---- right-click on a Type step's Text cell: use a list column

; @summary Right-click on the Text cell of a Type step in the Steps grid: a small menu with "Use list column" (each column name and
;          # for the round number), "Type fixed text..." and "Other step actions...". Returns true when it showed the menu.
; @tags list, cells, gui, v30
V30_TextMenu(row, x, y) {
    s := VMB()
    node := s.GridNodes.Get(row, 0)
    hit := V28_HitCell()
    cols := V27_Columns()
    if !IsObject(node) || hit.Row != row || hit.Col < 1 || hit.Col > cols.Length || cols[hit.Col].Key != "text"
        || node.Get("type", "") != "text" || V4_Bool(node.Get("ask", 0))
        return false
    s.GridSync := true
    s.GridLV.Modify(row, "Select Focus")
    s.GridSync := false
    if s.NodeItem.Has(node)
        s.TV.Modify(s.NodeItem[node], "Select")
    s.GridCol := hit.Col
    sub := Menu()
    for h in V31_NamesAllNow()
        sub.Add(h, V30_UseColumn.Bind(node, h))
    sub.Add("# (the round number)", V30_UseColumn.Bind(node, "#"))
    m := Menu()
    m.Add("Use list column", sub)
    if !V31_NamesAllNow().Length
        m.Disable("Use list column")
    m.Add("Type fixed text...", (*) => V28_Open(row, hit.Col))
    m.Add()
    item := s.NodeItem.Has(node) ? s.NodeItem[node] : 0
    m.Add("Row actions...", (*) => V32_RowMenu(row, x, y))
    m.Add("Other step actions...", (*) => item ? VMB_TreeMenu(s.TV, item, true, x, y) : 0)
    m.Show()
    return true
}

; @summary Makes a Type step type a list column ("#" = the round number): the stored text becomes {{Column}} (shown as =Column).
; @tags list, cells, v30
V30_UseColumn(node, name, *) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    VMB_Snapshot()
    node["text"] := name = "#" ? "{{index}}" : "{{" . name . "}}"
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("This step now types " . (name = "#" ? "the round number" : "the " . name . " column") . " (=" . name . "). Ctrl+Z undoes it.")
}

; ----------------------------------------------------------------------------
; V30 item C: playing with the switch
; ----------------------------------------------------------------------------

; @summary Before Play: builds the macro that is really played and sets the data of a list run. Returns {Ok, Error, Macro, Mode, Count}
;          (Count = the rows of a list run / the times of a times run). A macro with its own loop blocks plays as it is.
;          opts = the play options object (Data / FirstRow / LastRow are set for a list run).
; @returns {Ok, Error, Macro, Mode, Count}
; @tags run, list, v30
V30_PlayPlan(macro, opts) {
    st := macro.Get("settings", Map())
    mode := st is Map ? String(st.Get("runMode", "once")) : "once"
    if (mode != "list" && mode != "times") || V30_HasLoops(macro["blocks"])
        return {Ok: true, Error: "", Macro: macro, Mode: "once", Count: 0}
    b := V30_BuildRun(macro)
    if !b.Ok
        return {Ok: false, Error: b.Error, Macro: macro, Mode: mode, Count: 0}
    count := mode = "list" ? V30_RowCount(st) : Integer(st.Get("runTimes", 1))
    if mode = "list" {
        opts.Data := V30_ListData(st)
        opts.FirstRow := 1, opts.LastRow := 0
        if opts.HasOwnProp("ResultsPath")
            opts.DeleteProp("ResultsPath")
    }
    return {Ok: true, Error: "", Macro: b.Macro, Mode: mode, Count: count}
}

; @summary After a run: the sentence for the status bar (rows done / skipped, or how many times) and the List sheet's Result column.
;          Returns the new message ("" = keep the runner's).
; @returns String
; @tags run, list, v30
V30_AfterRun(plan, result) {
    s := VMB()
    s.ListResult := Map()
    if plan.Mode = "times" && result.Ok
        return "Finished: ran " . plan.Count . (plan.Count = 1 ? " time." : " times.")
    if plan.Mode != "list" || !result.HasOwnProp("RowLog")
        return ""
    seen := result.RowsSeen
    if !result.Ok && !seen
        return ""
    if !result.Ok && result.Message = V31_StreakSentence() {                   ; V31: stopped by 3 bad rows in a row: the last bad row is already in RowLog
        s.ListResult := V30_RowResults(seen, result.RowLog, true)
        return V31_StreakSummary(plan.Count, seen, result.RowLog)
    }
    s.ListResult := V30_RowResults(seen, result.RowLog, result.Ok)
    msg := V30_RunSummary(plan.Count, seen, result.RowLog, result.Ok)
    if !result.Ok && result.Message != "Stopped."
        msg .= "  " . result.Message
    return msg
}

; ============================================================================
; V31: "Only when", "otherwise", "If it fails", Skip this row / Stop the run / Wait until window (rules as columns, no blocks)
; ============================================================================

; @summary How many bad rows in a row stop a list run.
; @tags run, list, v31
V31_RowFailLimit() => 3

; @summary The new count of bad rows in a row: one more after a bad row, back to 0 after any other row.
; @returns Integer
; @tags run, list, v31
V31_BadStreak(streak, rowBad) => rowBad ? streak + 1 : 0

; @summary True when the run must stop because too many rows in a row were bad.
; @tags run, list, v31
V31_StreakStop(streak, limit := 0) => streak >= (limit > 0 ? limit : V31_RowFailLimit())

; @summary The plain sentence for the 3-bad-rows stop.
; @tags run, list, v31
V31_StreakSentence() => V31_RowFailLimit() . " rows in a row could not be done - stopped so the rest are not skipped too."

; @summary The status sentence after that stop, e.g. "Stopped after row 3 of 10: 0 done, 3 skipped (rows 1, 2, 3). 3 rows in a row ...".
; @returns String
; @tags run, list, v31
V31_StreakSummary(total, seen, skipped) {
    bad := skipped.Count
    rowsList := "", shown := 0
    for r in V30_SortedKeys(skipped) {
        shown += 1
        if shown <= 5
            rowsList .= (rowsList = "" ? "" : ", ") . r
    }
    if bad > 5
        rowsList .= ", ..."
    return "Stopped after row " . seen . " of " . total . ": " . Max(0, seen - bad) . " done, " . bad . " skipped (row" . (bad > 1 ? "s " : " ") . rowsList . "). " . V31_StreakSentence()
}

; ----------------------------------------------------------------------------
; V31: the Blocks toolbox is plain like the step list
; ----------------------------------------------------------------------------

; @summary The colours the toolbox paints for an entry: 0 (system default, black on white) while the plain list is on,
;          else the entry's own colours.
; @tags macro, gui, colors, v31
V31_PalColors(plain, colors) => plain ? 0 : colors

; ----------------------------------------------------------------------------
; V31 item A / B: "Only when" rules and "otherwise" chains (pure parts first, then the window parts)
; ----------------------------------------------------------------------------

; @summary The names a rule may use: # (the round / row number), the list columns, the given Values / variable names, and the
;          built-in ones (clipboard, date, time, row, index). No duplicates (case does not matter).
; @returns Array of names
; @tags rules, v31
V31_RuleNames(headers, extra := "") {
    out := [], seen := Map(), seen.CaseSense := false
    add(n) {
        n := Trim(String(n))
        if n != "" && !seen.Has(n) {
            seen[n] := 1
            out.Push(n)
        }
    }
    add("#")
    if headers is Array
        for h in headers
            add(h)
    if extra is Array
        for h in extra
            add(h)
    for h in ["clipboard", "date", "time", "row", "index"]
        add(h)
    return out
}

; @summary Splits the word "otherwise" off the front of an Only when text. "otherwise" alone = else; "otherwise, Amount > 50" or
;          "otherwise Amount > 50" = else-if. Returns {Other, Rest} (Rest = the rule text that is left, "" for a plain else).
; @returns {Other, Rest}
; @tags rules, chains, v31
V31_SplitOtherwise(text) {
    t := Trim(String(text))
    if !RegExMatch(t, "i)^otherwise(?![\w])[\s,:;-]*(.*)$", &m)
        return {Other: false, Rest: t}
    return {Other: true, Rest: Trim(m[1])}
}

; @summary The rule text in one comparable form (lower case, one space between words) - two steps with the same form are one branch.
; @tags rules, chains, v31
V31_Norm(text) => StrLower(RegExReplace(Trim(String(text)), "\s+", " "))

; @summary Takes one pair of matching quotes off a value ("Save As" or 'Save As').
; @tags rules, v31
V31_Unquote(text) {
    t := Trim(String(text))
    if StrLen(t) >= 2 {
        q := SubStr(t, 1, 1)
        if (q = Chr(34) || q = "'") && SubStr(t, -1) = q
            return SubStr(t, 2, StrLen(t) - 2)
    }
    return t
}

; @summary True when the text is a number (also 1,250 and 3.5); V31_ToNum gives its value.
; @tags rules, v31
V31_IsNum(text) {
    t := Trim(String(text))
    if RegExMatch(t, "^[-+]?\d{1,3}(,\d{3})+(\.\d+)?$")
        t := StrReplace(t, ",")
    return t != "" && IsNumber(t)
}

; @summary The value of a number text (see V31_IsNum).
; @tags rules, v31
V31_ToNum(text) {
    t := Trim(String(text))
    if RegExMatch(t, "^[-+]?\d{1,3}(,\d{3})+(\.\d+)?$")
        t := StrReplace(t, ",")
    return Number(t)
}

; @summary Splits a rule at " and " / " or " (outside quotes). One level only: mixing and + or is an error sentence.
;          Returns {Ok, Error, Join ("", "and" or "or"), Parts (Array of text)}.
; @returns {Ok, Error, Join, Parts}
; @tags rules, v31
V31_SplitParts(text) {
    parts := [], join := "", cur := "", quote := "", i := 1, n := StrLen(text)
    while i <= n {
        c := SubStr(text, i, 1)
        if quote != "" {
            cur .= c
            if c = quote && (i = n || RegExMatch(SubStr(text, i + 1, 1), "\s"))
                quote := ""
            i += 1
            continue
        }
        if (c = Chr(34) || c = "'") && (i = 1 || RegExMatch(SubStr(text, i - 1, 1), "[\s=<>!]")) {
            quote := c
            cur .= c
            i += 1
            continue
        }
        if RegExMatch(SubStr(text, i), "i)^\s+(and|or)(?:\s+|$)", &m) {
            word := StrLower(m[1])
            if join != "" && join != word
                return {Ok: false, Error: "Use only  and  or only  or  in one rule (no mixing). Put the other idea on its own step.", Join: "", Parts: []}
            join := word
            parts.Push(cur), cur := ""
            i += StrLen(m[0])
            continue
        }
        cur .= c
        i += 1
    }
    parts.Push(cur)
    return {Ok: true, Error: "", Join: join, Parts: parts}
}

; @summary Reads one comparison ("Status = On", "Name is empty", "window Save As is open") against the known names.
;          Returns {Ok, Error, Part} (Part = Map with kind "cmp" (name, op, value) or "win" (title, open)).
; @returns {Ok, Error, Part}
; @tags rules, v31
V31_ParsePart(text, names) {
    no(msg) => {Ok: false, Error: msg, Part: ""}
    t := Trim(text)
    if t = ""
        return no("There is a rule missing here. Write something like  Status = On  or  Amount > 100.")
    best := ""
    for nm in names {
        L := StrLen(nm)
        if L > StrLen(best) && StrLower(SubStr(t, 1, L)) = StrLower(nm) {
            nxt := SubStr(t, L + 1, 1)
            if nxt = "" || RegExMatch(nxt, "[\s=<>!]")
                best := nm
        }
    }
    if best = "" {
        if RegExMatch(t, "i)^window\s+(.+?)\s+is\s+(not\s+open|open|closed)$", &w) {
            title := V31_Unquote(w[1])
            if title = ""
                return no("Write the window title after the word window, for example  window Save As is open.")
            return {Ok: true, Error: "", Part: Map("kind", "win", "title", title, "open", StrLower(w[2]) = "open")}
        }
        word := RegExMatch(t, "^[^\s=<>!]+", &f) ? f[0] : t
        shown := ""
        for k, nm in names {
            if k > 10 {
                shown .= ", ..."
                break
            }
            shown .= (shown = "" ? "" : ", ") . nm
        }
        return no(Chr(34) . word . Chr(34) . " is not a name I know. Names you can use: " . shown . ".")
    }
    rest := SubStr(t, StrLen(best) + 1)
    op := "", raw := ""
    if RegExMatch(rest, "i)^\s*(is\s+not\s+empty|is\s+empty)\s*$", &m)
        op := InStr(StrLower(m[1]), "not") ? "notempty" : "empty"
    else if RegExMatch(rest, "i)^\s+(is\s+not|isn't|is|does\s+not\s+contain|not\s+contains|contains)\s+(.+)$", &m) {
        word := RegExReplace(StrLower(m[1]), "\s+", " ")
        op := word = "is" ? "=" : (word = "is not" || word = "isn't") ? "!=" : word = "contains" ? "contains" : "notcontains"
        raw := Trim(m[2])
    } else if RegExMatch(rest, "^\s*(>=|<=|<>|!=|==|=|>|<)\s*(.*)$", &m) {
        op := m[1] = "<>" ? "!=" : m[1] = "==" ? "=" : m[1]
        raw := Trim(m[2])
        if raw = ""
            return no("Write what to compare with after " . m[1] . ", for example  " . best . " " . m[1] . " 100.")
    } else
        return no("After " . best . " write  =  >  <  >=  <=  is not  contains  is empty  or  is not empty, then the value.")
    return {Ok: true, Error: "", Part: Map("kind", "cmp", "name", best, "op", op, "value", V31_Unquote(raw))}
}

; @summary Reads an Only when rule (without a leading "otherwise") against the known names. Returns {Ok, Error, Rule}; Rule = Map with
;          join ("", "and", "or") and parts (see V31_ParsePart). The error is a plain sentence.
; @returns {Ok, Error, Rule}
; @tags rules, v31
V31_ParseRule(text, names) {
    sp := V31_SplitParts(Trim(String(text)))
    if !sp.Ok
        return {Ok: false, Error: sp.Error, Rule: ""}
    parts := []
    for chunk in sp.Parts {
        p := V31_ParsePart(chunk, names)
        if !p.Ok
            return {Ok: false, Error: p.Error, Rule: ""}
        parts.Push(p.Part)
    }
    return {Ok: true, Error: "", Rule: Map("join", sp.Join, "parts", parts)}
}

; @summary Tests one comparison. lookupFn(name) gives the value text; winFn(title) says whether a window with that title is open.
;          Text compares ignore case; two numbers compare as numbers; < > with an empty side are false.
; @returns bool
; @tags rules, v31
V31_TestPart(part, lookupFn, winFn) {
    if part["kind"] = "win" {
        open := winFn(part["title"]) ? true : false
        return part["open"] ? open : !open
    }
    l := Trim(String(lookupFn(part["name"]))), v := part["value"], op := part["op"]
    switch op {
        case "empty": return l = ""
        case "notempty": return l != ""
        case "contains": return InStr(l, v) > 0
        case "notcontains": return InStr(l, v) = 0
    }
    both := V31_IsNum(l) && V31_IsNum(v)
    if op = "=" || op = "!=" {
        same := both ? V31_ToNum(l) = V31_ToNum(v) : StrLower(l) = StrLower(v)
        return op = "=" ? same : !same
    }
    if !both && (l = "" || v = "" || V31_IsNum(l) || V31_IsNum(v))     ; V33: a number against a text ("20 mg" > 100) is no order: false, not a text compare
        return false
    c := both ? (V31_ToNum(l) < V31_ToNum(v) ? -1 : V31_ToNum(l) > V31_ToNum(v) ? 1 : 0) : StrCompare(l, v, false)
    switch op {
        case ">": return c > 0
        case ">=": return c >= 0
        case "<": return c < 0
        case "<=": return c <= 0
    }
    return false
}

; @summary Tests a parsed rule (V31_ParseRule's Rule): all parts for "and", any part for "or", the one part otherwise.
; @returns bool
; @tags rules, v31
V31_Test(rule, lookupFn, winFn) {
    isOr := rule["join"] = "or"
    for p in rule["parts"] {
        r := V31_TestPart(p, lookupFn, winFn)
        if isOr && r
            return true
        if !isOr && !r
            return false
    }
    return !isOr
}

; @summary Parses and tests a rule text in one go; a rule that cannot be read throws its plain sentence.
; @tags rules, v31
V31_EvalText(text, names, lookupFn, winFn) {
    r := V31_ParseRule(text, names)
    if !r.Ok
        throw Error(r.Error)
    return V31_Test(r.Rule, lookupFn, winFn)
}

; @summary For each step of one list of steps (siblings): its place in an if / otherwise chain. Returns an Array (same order) of
;          {Chain (id, 0 = none), Branch, Kind ("if", "elseif", "else" or ""), First (first step of its branch), Rule (the rule text
;          without "otherwise"), Error ("" or a plain sentence)}. A step without a rule ends the chain; a switched-off step is skipped
;          over; steps with the same rule text in a row are one branch; ids start after base.
; @returns Array of {Chain, Branch, Kind, First, Rule, Error}
; @tags rules, chains, v31
V31_Chains(steps, base := 0) {
    out := []
    chain := base, branch := 0, open := false, closed := false, prev := "", lastKind := ""
    for node in steps {
        info := {Chain: 0, Branch: 0, Kind: "", First: false, Rule: "", Error: ""}
        out.Push(info)
        if !(node is Map) || V4_Bool(node.Get("disabled", 0))
            continue
        w := Trim(String(node.Get("when", "")))
        if w = "" || StrLower(w) = "always" {
            open := false, prev := ""
            continue
        }
        sp := V31_SplitOtherwise(w), norm := V31_Norm(w)
        info.Rule := sp.Rest
        if sp.Other {
            if !open {
                info.Error := "otherwise needs a step with a rule right above it. Give the step above an Only when rule first."
                continue
            }
            kind := sp.Rest = "" ? "else" : "elseif"
            if norm = prev {
                info.Chain := chain, info.Branch := branch, info.Kind := kind
                continue
            }
            if closed {
                info.Error := "The otherwise above already covers every other case, so this one could never run."
                continue
            }
            branch += 1, prev := norm
            info.Chain := chain, info.Branch := branch, info.Kind := kind, info.First := true
            if kind = "else"
                closed := true
        } else {
            if open && norm = prev {
                info.Chain := chain, info.Branch := branch, info.Kind := lastKind
                continue
            }
            chain += 1, branch := 1, open := true, closed := false, prev := norm
            info.Chain := chain, info.Branch := 1, info.Kind := "if", info.First := true
        }
        lastKind := info.Kind
    }
    return out
}

; @summary The state of a chain before any step of it: nothing ran yet.
; @tags rules, chains, v31
V31_NewState() => {Taken: false, Run: false}

; @summary True when the rule of this step must be looked at (the first step of an if, or of an otherwise-rule while no branch ran).
; @tags rules, chains, v31
V31_NeedsRule(state, info) => info.First && (info.Kind = "if" || (info.Kind = "elseif" && !state.Taken))

; @summary The decision for a step. state = {Taken, Run} of its chain so far, info = the step's V31_Chains entry, ruleResult = the
;          result of its rule (only used when V31_NeedsRule). Returns the new state; its Run says whether the step runs.
;          Later steps of the same branch (First = false) follow the branch's decision.
; @returns {Taken, Run}
; @tags rules, chains, v31
V31_Decide(state, info, ruleResult) {
    if !info.First
        return {Taken: state.Taken, Run: state.Run}
    switch info.Kind {
        case "if":
            go := ruleResult ? true : false
            return {Taken: go, Run: go}
        case "elseif":
            go := !state.Taken && ruleResult
            return {Taken: state.Taken || go, Run: go}
        case "else":
            return {Taken: true, Run: !state.Taken}
    }
    return {Taken: state.Taken, Run: true}
}

; @summary The one place that decides whether a step runs, for the runner and the grid preview. info = V31_Chains entry, states =
;          Map chain id -> state (one Map per run of a list of steps), evalFn(ruleText) -> bool (may throw). A step with no rule
;          runs. A step whose "otherwise" has nothing above throws the entry's sentence.
; @returns bool (true = run it)
; @tags rules, chains, v31
V31_Gate(info, states, evalFn) {
    if info.Error != ""
        throw Error(info.Error)
    if info.Chain = 0
        return true
    st := states.Has(info.Chain) ? states[info.Chain] : V31_NewState()
    res := false
    if V31_NeedsRule(st, info)
        res := evalFn(info.Rule)
    nst := V31_Decide(st, info, res)
    states[info.Chain] := nst
    return nst.Run
}

; @summary Chain info for EVERY step of a macro (all nested lists too), as Map node -> V31_Chains entry. Chain ids are unique in the macro.
; @returns Map
; @tags rules, chains, v31
V31_MacroInfos(blocks) {
    out := Map(), base := {N: 0}
    V31__Walk(blocks, out, base)
    return out
}

; @summary Helper of V31_MacroInfos (walks one list, then the lists inside its blocks).
; @tags rules, chains, v31
V31__Walk(list, out, base) {
    infos := V31_Chains(list, base.N)
    for i, node in list {
        if !(node is Map)
            continue
        out[node] := infos[i]
        if infos[i].Chain > base.N
            base.N := infos[i].Chain
    }
    for node in list
        if node is Map && VMF_IsContainer(node)
            for kid in VMF_Children(node)
                V31__Walk(kid, out, base)
}

; @summary The names of the variables a macro sets (Set, For, Change, NDC blocks), for the rule parser.
; @returns Array
; @tags rules, v31
V31_MacroVars(blocks) {
    out := []
    if !(blocks is Array)
        return out
    for node in VMF_Flatten(blocks)
        if RegExMatch(node.Get("type", ""), "^(set|for|change|ndc)$") && node.Get("name", "") != ""
            out.Push(node["name"])
    return out
}

; @summary What a rule would do for each step of a macro, for one preview row: Map node -> {Skip (true = the step is left out),
;          Err ("" or a sentence when the rule could not be worked out), Rule}. Only steps with a rule are in the Map.
;          names = the names rules may use, lookupFn / winFn as in V31_Test.
; @returns Map
; @tags rules, preview, v31
V31_PreviewDecisions(blocks, names, lookupFn, winFn) {
    out := Map()
    V31__Prev(blocks, names, lookupFn, winFn, out)
    return out
}

; @summary Helper of V31_PreviewDecisions (one list, then the lists inside its blocks; every list has its own chain states).
; @tags rules, preview, v31
V31__Prev(list, names, lookupFn, winFn, out) {
    infos := V31_Chains(list)
    states := Map()
    evalFn := (txt) => V31_EvalText(txt, names, lookupFn, winFn)
    for i, node in list {
        if !(node is Map) || V4_Bool(node.Get("disabled", 0))
            continue
        info := infos[i]
        if info.Chain = 0 && info.Error = ""
            continue
        d := {Skip: false, Err: "", Rule: Trim(String(node.Get("when", "")))}
        try d.Skip := !V31_Gate(info, states, evalFn)
        catch as e
            d.Err := e.Message
        out[node] := d
    }
    for node in list
        if node is Map && VMF_IsContainer(node)
            for kid in VMF_Children(node)
                V31__Prev(kid, names, lookupFn, winFn, out)
}

; @summary The value of a name for the preview row (list column of that row, # = the number, date / time / clipboard). A name with
;          no value yet throws.
; @tags rules, preview, v31
V31_PreviewValue(name, headers, row, number) {
    if name = "#" || StrLower(name) = "index" || StrLower(name) = "row"
        return number
    for i, h in headers
        if StrLower(h) = StrLower(name)
            return row is Array && i <= row.Length ? row[i] : ""
    switch StrLower(name) {
        case "date": return FormatTime(, "yyyy-MM-dd")
        case "time": return FormatTime(, "HH:mm:ss")
        case "clipboard": return A_Clipboard
    }
    throw Error(name . " has no value before the run starts.")
}

; @summary True when a window whose title contains the text is open now (any program; hidden windows do not count).
; @tags rules, window, v31
V31_WindowOpen(title) {
    t := Trim(String(title))
    if t = ""
        return false
    try return WinExist(t) != 0
    return false
}

; @summary The preview of the macro's rules for one row (or round) number: Map node -> {Skip, Err, Rule}. Empty when the macro uses no
;          list ideas (no List and Run is "once"), so old macros show nothing new.
; @returns Map
; @tags rules, preview, v31
V31_PreviewFor(blocks, settings, number) {
    if !(settings is Map) || !(blocks is Array)
        return Map()
    lst := V30_ListOf(settings), rm := String(settings.Get("runMode", "once"))
    if !(lst is Map) && rm != "list" && rm != "times" && !V31_ValuesOf(settings).Length
        return Map()
    headers := V31_NamesAll(settings), row := V31_PreviewRow(settings, number)
    names := V31_RuleNames(headers, V31_MacroVars(blocks))
    return V31_PreviewDecisions(blocks, names, (nm) => V31_PreviewValue(nm, headers, row, number), V31_WindowOpen)
}

; @summary The step list that holds a step (searches the macro's blocks and the lists inside blocks). [node] when it is not found.
; @returns Array
; @tags rules, v31
V31_SiblingsOf(blocks, node) {
    if !(blocks is Array)
        return [node]
    found := V31__Find(blocks, node)
    return found is Array ? found : [node]
}

; @summary Helper of V31_SiblingsOf.
; @tags rules, v31
V31__Find(list, node) {
    for x in list
        if x = node
            return list
    for x in list
        if x is Map && VMF_IsContainer(x)
            for kid in VMF_Children(x) {
                r := V31__Find(kid, node)
                if r is Array
                    return r
            }
    return ""
}

; @summary Checks an Only when text typed for a step: "" when it is fine, else a plain sentence. Empty / "always" are fine. An
;          "otherwise" needs a step with a rule right above it (looked at with the new text in place). siblings = the step's list.
; @returns String
; @tags rules, chains, v31
V31_CheckWhen(siblings, node, text, names) {
    t := Trim(String(text))
    if t = "" || StrLower(t) = "always"
        return ""
    sp := V31_SplitOtherwise(t)
    if sp.Rest != "" {
        r := V31_ParseRule(sp.Rest, names)
        if !r.Ok
            return r.Error
    } else if !sp.Other
        return ""
    copy := node.Clone(), copy["when"] := t
    list := []
    for x in siblings
        list.Push(x = node ? copy : x)
    if !list.Length
        list.Push(copy)
    infos := V31_Chains(list)
    for i, x in list
        if x = copy
            return infos[i].Error
    return ""
}

; @summary Puts a rule together from the builder's three choices. op is one of V31_BuilderOps(); value is quoted when it needs to be.
; @returns String
; @tags rules, builder, v31
V31_BuildRuleText(name, op, value) {
    v := Trim(String(value))
    if op = "window is open" || op = "window is not open"
        return "window " . v . (op = "window is open" ? " is open" : " is not open")
    if op = "is empty" || op = "is not empty"
        return name . " " . op
    if v != "" && (RegExMatch(v, "i)\s(and|or)\s") || RegExMatch(v, "^[`"']")) && !(SubStr(v, 1, 1) = Chr(34) && SubStr(v, -1) = Chr(34))
        v := Chr(34) . v . Chr(34)
    return name . " " . op . " " . v
}

; @summary The comparisons the rule builder offers, in order.
; @tags rules, builder, v31
V31_BuilderOps() => ["=", "is not", ">", ">=", "<", "<=", "contains", "does not contain", "is empty", "is not empty", "window is open", "window is not open"]

; ----------------------------------------------------------------------------
; V31 item C: "If it fails" (what happens when one step cannot be done)
; ----------------------------------------------------------------------------

; @summary The choices of the If it fails column, in the order shown. The first one (macro setting) means: do what the macro's
;          own On failure setting says (nothing new).
; @returns Array of text
; @tags fail, v31
V31_FailChoices() => ["macro setting", "ask me", "stop", "skip this step", "skip this row", "try 3 times, then stop", "try 3 times, then skip row"]

; @summary The stored words of the choices (same order as V31_FailChoices): "" = macro setting.
; @tags fail, v31
V31_FailCodes() => ["", "ask", "stop", "skip", "skiprow", "retry3stop", "retry3skiprow"]

; @summary The cell text for a stored choice ("" and unknown words show as "macro setting").
; @returns String
; @tags fail, v31
V31_FailText(code) {
    for i, c in V31_FailCodes()
        if c = code
            return V31_FailChoices()[i]
    return V31_FailChoices()[1]
}

; @summary The stored word for a cell text (case does not matter). Returns {Ok, Code}; a text that is not one of the choices is not Ok.
; @returns {Ok, Code}
; @tags fail, v31
V31_FailCode(text) {
    t := StrLower(Trim(String(text)))
    for i, c in V31_FailChoices()
        if StrLower(c) = t
            return {Ok: true, Code: V31_FailCodes()[i]}
    return {Ok: false, Code: ""}
}

; @summary What to do after a step failed. stepChoice = the step's stored choice ("" = none), macroPolicy = the macro's On failure
;          setting, triesDone = how many times the step has been tried so far (the failed first run counts as 1).
;          Returns "retry" (wait 1 s, run only that step again), "stop", "skip" (leave this step out), "nextrow" (skip the rest
;          of this row), "ask" (the question box), or "macro" (no choice on the step: do what the macro setting says, as before).
; @returns String
; @tags fail, v31
V31_FailPlan(stepChoice, macroPolicy, triesDone) {
    switch stepChoice {
        case "ask": return "ask"
        case "stop": return "stop"
        case "skip": return "skip"
        case "skiprow": return "nextrow"
        case "retry3stop": return triesDone < 3 ? "retry" : "stop"
        case "retry3skiprow": return triesDone < 3 ? "retry" : "nextrow"
    }
    return "macro"
}

; @summary The Only when cell text: "always" when there is no rule, else the rule; with a note when the preview row leaves the step out
;          ("→ skipped for row 2") or the rule cannot be worked out. gate = the preview decision {Skip, Err} or "", info = the chain entry or "".
; @returns String
; @tags rules, grid, v31
V31_WhenCell(node, gate, info, settings, number) {
    w := Trim(String(node.Get("when", "")))
    txt := w = "" ? "always" : w
    if IsObject(gate) && gate.Err != ""
        return txt . "  ⚠ " . gate.Err
    if IsObject(info) && info.Error != ""
        return txt . "  ⚠ " . info.Error
    if IsObject(gate) && gate.Skip {
        mode := settings is Map ? String(settings.Get("runMode", "once")) : "once"
        txt .= "  → skipped for " . (mode = "times" ? "round " : "row ") . number
    }
    return txt
}

; @summary True for steps that can have an Only when / If it fails cell (every step, not the blocks that hold steps).
; @tags rules, v31
V31_HasRuleCells(node) => node is Map && !VMF_IsContainer(node)

; @summary The names Only when may use in the open macro (list columns, variables the macro sets, built-ins, #).
; @returns Array
; @tags rules, v31
V31_NamesNow() {
    s := VMB()
    if !(s.Macro is Map)
        return V31_RuleNames([])
    return V31_RuleNames(V31_NamesAll(s.Macro.Get("settings", "")), V31_MacroVars(s.Macro.Get("blocks", [])))
}

; @summary True for the grid cells that Delete / Ctrl+X can empty.
; @tags grid, v31
V31_Clearable(key) => key = "note" || key = "wait" || key = "when" || key = "failstep"

; @summary The step key a clearable cell is stored in.
; @tags grid, v31
V31_ClearKey(key) => key = "note" ? "note" : key = "wait" ? "delayMs" : key = "when" ? "when" : "onFailStep"

; ----------------------------------------------------------------------------
; V31 item E: Skip this row / Stop the run / Wait until window, and the "Add step" menu
; ----------------------------------------------------------------------------

; @summary The text of a Wait until window step: "Save As is open (within 10 s)" / "is closed".
; @returns String
; @tags wait, window, v31
V31_WaitText(node) {
    t := Trim(String(node.Get("target", "")))
    secs := node.Get("timeoutSec", 10)
    return (t = "" ? "(a window title)" : t) . (V4_Bool(node.Get("closed", 0)) ? " is closed" : " is open") . " (within " . secs . " s)"
}

; @summary Reads what a person types into the Text cell of a Wait until window step: "Save As", "Save As is open", "Save As is closed",
;          each optionally followed by "within 10 s" / "(10 s)". Returns {Ok, Error, Title, Closed, Secs}; without a number of seconds
;          defaultSecs is kept.
; @returns {Ok, Error, Title, Closed, Secs}
; @tags wait, window, v31
V31_ParseWaitWindow(text, defaultSecs := 10) {
    t := Trim(String(text)), secs := defaultSecs, closed := false
    if RegExMatch(t, "i)\s*\(?\s*(?:within\s+)?(\d+(?:\.\d+)?)\s*s(?:ec(?:onds?)?)?\s*\)?\s*$", &m) {
        secs := Number(m[1]), t := Trim(SubStr(t, 1, m.Pos - 1))
        if secs < 1 || secs > 3600
            return {Ok: false, Error: "The seconds must be from 1 to 3600.", Title: "", Closed: false, Secs: defaultSecs}
    }
    if RegExMatch(t, "i)\s+is\s+(open|closed)$", &m2) {
        closed := StrLower(m2[1]) = "closed"
        t := Trim(SubStr(t, 1, m2.Pos - 1))
    }
    t := V31_Unquote(t)
    if t = ""
        return {Ok: false, Error: "Write part of the window title, for example  Save As is open.", Title: "", Closed: false, Secs: defaultSecs}
    return {Ok: true, Error: "", Title: t, Closed: closed, Secs: secs}
}

; @summary Runs a Wait until window step: waits until a window whose title contains the text is open (or closed). Fails after the
;          seconds given - then the step's "If it fails" choice (or the macro's setting) applies.
; @tags wait, window, play, v31
V31_WaitWindow(node, ctx) {
    title := Trim(ctx.Expand(node.Get("target", "")))
    if title = ""
        throw Error("Wait until window: write part of the window title first.")
    wantOpen := !V4_Bool(node.Get("closed", 0))
    secs := Number(node.Get("timeoutSec", 10))
    deadline := A_TickCount + Max(0, secs) * 1000
    loop {
        if (V31_WindowOpen(title) ? true : false) = wantOpen
            return
        if A_TickCount >= deadline
            throw Error("Wait until window: '" . title . "' did not " . (wantOpen ? "open" : "close") . " within " . secs . " s.")
        ctx.Sleep(100)
    }
}

; @summary The steps the "Add step" menu offers, as [menu text, kind]. They are put in below the current row.
; @returns Array
; @tags steps, menu, v31
V31_StepKinds() => [["Type text", "text"], ["Press keys", "keys"], ["Wait (seconds)", "delay"], ["Wait until window...", "waitwin"],
    ["Skip this row", "skiprow"], ["Stop the run", "stoprun"], ["Remember clipboard as...", "remember"]]

; @summary A new step of one of the kinds of V31_StepKinds, with plain starting values (nothing to answer: change it in its cells).
;          Skip this row = a Flow control step that goes on with the next row (continue); Stop the run = one that ends everything (endrun).
; @returns Map ("" for an unknown kind)
; @tags steps, menu, v31
V31_NewStep(kind) {
    switch kind {
        case "text": return Map("type", "text", "text", "text")
        case "keys": return Map("type", "keys", "keys", "{Enter}")
        case "delay": return Map("type", "delay", "ms", 1000)
        case "waitwin": return V4_CreateNode("det_wait_window")
        case "skiprow": return Map("type", "stop", "action", "continue")
        case "stoprun": return Map("type", "stop", "action", "endrun")
        case "remember": return V31_NewRemember(V31_FreeName("value"), "{{clipboard}}")
    }
    return ""
}

; @summary "Add step" menu action: puts a new step below the current row (or inside the selected block).
; @tags steps, menu, gui, v31
V31_AddStep(kind, *) {
    if VM_IsRecording() || VM_IsPlaying()
        return
    node := V31_NewStep(kind)
    if !IsObject(node)
        return
    where := VMB_InsertPoint()
    VMB_InsertNode(node, where.List, where.Index)
    VMB_Status("Step added below. Change it in its cells (double-click). Ctrl+Z undoes it.")
    V31_AfterStepEdit(node)
}

; @summary The "Add step" sub-menu (for the right-click menu of the grid and the list).
; @tags steps, menu, gui, v31
V31_AddMenu() {
    sub := Menu()
    for item in V31_StepKinds()
        sub.Add(item[1], V31_AddStep.Bind(item[2]))
    return sub
}

; @summary Sets (or clears) the Only when rule of a step through the same checks as the cell editor, with undo. Returns true when it was set.
; @tags rules, gui, v31
V31_SetWhen(node, text) {
    if VM_IsRecording() || VM_IsPlaying() || !(node is Map)
        return false
    plan := V28_Plan(node, "when", text)
    if !plan.Ok {
        VMB_Status(plan.Error)
        return false
    }
    V28_Do(node, plan, "Only when changed. Ctrl+Z undoes it.")
    return true
}

; @summary What the rule builder's OK does: puts the three choices together (with "otherwise, " in front when asked) and sets the rule.
;          Returns true when the rule was accepted.
; @tags rules, builder, gui, v31
V31_BuilderApply(node, name, op, value, other) {
    text := V31_BuildRuleText(name, op, value)
    if other
        text := "otherwise, " . text
    return V31_SetWhen(node, text)
}

; @summary The small window for people who do not want to type rules: pick the name, pick the comparison, type the value.
; @tags rules, builder, gui, v31
V31_RuleBuilder(node, other := false) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !s.Gui
        return
    g := Gui("+Owner" . s.Gui.Hwnd . " +ToolWindow", "Only when - build a rule")
    g.SetFont("s9", "Segoe UI")
    g.AddText("xm w480", "Do this step only when:")
    names := V31_NamesNow()
    nm := g.AddDropDownList("xm w170", names)
    nm.Choose(names.Length > 1 ? 2 : 1)
    op := g.AddDropDownList("x+6 w150", V31_BuilderOps())
    op.Choose(1)
    val := g.AddEdit("x+6 w140")
    oth := g.AddCheckbox("xm y+10", "otherwise: only when the step above (with a rule) did not run")
    oth.Value := other ? 1 : 0
    g.AddText("xm y+4 w480", "For a window rule pick 'window is open' and type part of the title as the value.")
    ok := g.AddButton("xm y+10 w90 Default", "OK")
    ca := g.AddButton("x+6 w90", "Cancel")
    ok.OnEvent("Click", (*) => (V31_BuilderApply(node, nm.Text, op.Text, val.Value, oth.Value) ? g.Destroy() : 0))
    ca.OnEvent("Click", (*) => g.Destroy())
    g.OnEvent("Escape", (*) => g.Destroy())
    g.Show()
    s.RuleDlg := g
}

; @summary Right-click on an Only when cell: build a rule, otherwise, always. Returns true when it handled the click.
; @tags rules, menu, gui, v31
V31_CellMenu(row, x, y) {
    s := VMB()
    node := s.GridNodes.Get(row, 0)
    hit := V28_HitCell()
    cols := V27_Columns()
    if !IsObject(node) || hit.Row != row || hit.Col < 1 || hit.Col > cols.Length || cols[hit.Col].Key != "when" || !V31_HasRuleCells(node)
        return false
    s.GridSync := true
    s.GridLV.Modify(row, "Select Focus")
    s.GridSync := false
    if s.NodeItem.Has(node)
        s.TV.Modify(s.NodeItem[node], "Select")
    s.GridCol := hit.Col
    m := Menu()
    m.Add("Build a rule...", (*) => V31_RuleBuilder(node, false))
    m.Add("otherwise, build a rule...", (*) => V31_RuleBuilder(node, true))
    m.Add("otherwise (everything else)", (*) => V31_SetWhen(node, "otherwise"))
    m.Add("always (no rule)", (*) => V31_SetWhen(node, ""))
    m.Add()
    m.Add("Type a rule...", (*) => V28_Open(row, hit.Col))
    item := s.NodeItem.Has(node) ? s.NodeItem[node] : 0
    m.Add("Row actions...", (*) => V32_RowMenu(row, x, y))
    m.Add("Other step actions...", (*) => item ? VMB_TreeMenu(s.TV, item, true, x, y) : 0)
    m.Show()
    return true
}

; ============================================================================
; V31.1: Values (names you can use as =name), ask at start, counts up, today's date, and the Remember step
;   settings["values"] = Array of Map("name", "n", "value", "10", "when", "fixed" / "ask" / "date" / "counts").
;   Run time (editor AND exported player): V4Runner.V31Init builds the values, VM_Play shows the ask-at-start form.
; ============================================================================

; @summary The stored codes of the When column of the Values sheet.
; @tags values, v31
V31_WhenCodes() => ["fixed", "ask", "date", "counts"]

; @summary The words the person sees in the When column (same order as V31_WhenCodes).
; @tags values, v31
V31_WhenTexts() => ["fixed", "ask at start", "today's date", "counts up"]

; @summary The date format used when a today's date value has no format written.
; @tags values, v31
V31_DateDefault() => "MM/dd/yyyy"

; @summary The words for a When code ("fixed" for anything unknown).
; @returns String
; @tags values, v31
V31_WhenText(code) {
    for i, c in V31_WhenCodes()
        if c = code
            return V31_WhenTexts()[i]
    return "fixed"
}

; @summary The When code for what a person typed or picked ("" when it is not one of the four). Not case sensitive; "todays date" and "today" are fine.
; @returns String
; @tags values, v31
V31_WhenCode(text) {
    t := StrLower(Trim(String(text)))
    t := StrReplace(t, "'", "")
    switch t {
        case "fixed": return "fixed"
        case "ask at start", "ask": return "ask"
        case "todays date", "today", "date": return "date"
        case "counts up", "counts", "count up": return "counts"
    }
    return ""
}

; @summary The macro's Values rows (an Array of Maps; [] when it has none - old macros).
; @returns Array
; @tags values, v31
V31_ValuesOf(settings) {
    if settings is Map {
        v := settings.Get("values", "")
        if v is Array
            return v
    }
    return []
}

; @summary The names of the macro's Values, in order (empty names left out).
; @returns Array of names
; @tags values, v31
V31_ValueNames(settings) {
    out := []
    for item in V31_ValuesOf(settings)
        if item is Map && Trim(String(item.Get("name", ""))) != ""
            out.Push(Trim(String(item.Get("name", ""))))
    return out
}

; @summary Checks a name for a Value (or a Remember step): letters, digits and _ only; not #; not a name the program uses; not a column of the
;          List; not another value (allowValue = true skips that last check, for Remember which may fill an existing value; except = the
;          row being renamed). Returns "" when fine, else a plain sentence.
; @returns String
; @tags values, v31
V31_ValueNameError(name, settings, except := 0, allowValue := false) {
    n := Trim(String(name))
    if n = ""
        return "A name cannot be empty."
    if n = "#"
        return "# is kept for the round number. Pick another name."
    if !RegExMatch(n, "^[A-Za-z0-9_]+$")
        return "A name can only have letters, digits and _ (no spaces). Try " . RegExReplace(n, "[^A-Za-z0-9_]+", "_") . "."
    for b in ["clipboard", "date", "time", "row", "index"]
        if StrLower(n) = b
            return n . " is a name the program already uses. Pick another name."
    for h in V30_Headers(settings)
        if StrLower(Trim(h)) = StrLower(n)
            return n . " is already a column of the List. Pick another name."
    if !allowValue
        for i, item in V31_ValuesOf(settings)
            if i != except && item is Map && StrLower(Trim(String(item.Get("name", "")))) = StrLower(n)
                return "There is already a value called " . n . "."
    return ""
}

; @summary What one Value is worth: fixed = the Value; ask at start = the answer (or the Value when nothing was asked); today's date = today
;          in the format written in Value (MM/dd/yyyy when empty); counts up = the Value (a whole number) plus the rounds already done.
;          round = how many rounds are done (0 in round 1 and in a once run); asked = Map name -> answer.
; @returns String / Integer
; @tags values, run, v31
V31_ValueAt(item, round, asked := "") {
    name := Trim(String(item.Get("name", ""))), v := String(item.Get("value", "")), w := item.Get("when", "fixed")
    switch w {
        case "ask":
            return asked is Map && asked.Has(name) ? String(asked[name]) : v
        case "date":
            fmt := Trim(v) = "" ? V31_DateDefault() : v
            try return FormatTime(, fmt)
            return v
        case "counts":
            return IsInteger(Trim(v)) ? Integer(Trim(v)) + Max(0, round) : v
    }
    return v
}

; @summary All Values as Map name -> text for a round (not case sensitive).
; @returns Map
; @tags values, v31
V31_ValueMap(settings, round := 0, asked := "") {
    m := Map()
    m.CaseSense := false
    for item in V31_ValuesOf(settings)
        if item is Map && Trim(String(item.Get("name", ""))) != ""
            m[Trim(String(item["name"]))] := String(V31_ValueAt(item, round, asked))
    return m
}

; @summary The Values marked "ask at start", as an Array of Map("name", .., "value", ..) (value = the current one).
; @returns Array
; @tags values, v31
V31_AskItems(settings) {
    out := []
    for item in V31_ValuesOf(settings)
        if item is Map && item.Get("when", "fixed") = "ask" && Trim(String(item.Get("name", ""))) != ""
            out.Push(Map("name", Trim(String(item["name"])), "value", String(item.Get("value", ""))))
    return out
}

; @summary The names =name and {{name}} may use in cells: the List columns first, then the Values (no duplicates).
; @returns Array of names
; @tags values, v31
V31_NamesAll(settings) {
    out := [], seen := Map()
    seen.CaseSense := false
    for h in V30_Headers(settings) {
        out.Push(h)
        seen[Trim(h)] := 1
    }
    for n in V31_ValueNames(settings)
        if !seen.Has(n) {
            seen[n] := 1
            out.Push(n)
        }
    return out
}

; @summary The row the Preview row shows: the List row's cells (padded to the number of columns), then one cell per Value (ask at start =
;          the current value; counts up = start + row - 1; today's date = now). Without Values this is the List row as before.
; @returns Array or ""
; @tags values, preview, v31
V31_PreviewRow(settings, number) {
    base := V30_PreviewRowCells(settings, number)
    vals := V31_ValueNames(settings)
    if !vals.Length
        return base
    out := []
    Loop V30_Headers(settings).Length
        out.Push(base is Array && A_Index <= base.Length ? base[A_Index] : "")
    seen := Map()
    seen.CaseSense := false
    for h in V30_Headers(settings)
        seen[Trim(h)] := 1
    for item in V31_ValuesOf(settings)
        if item is Map {
            n := Trim(String(item.Get("name", "")))
            if n != "" && !seen.Has(n) {
                seen[n] := 1
                out.Push(String(V31_ValueAt(item, Max(0, number - 1), "")))
            }
        }
    return out
}

; @summary Reads a Remember step as a person writes it: clipboard as name, or "text" as name (text may use =Column or {{...}}). A leading
;          word Remember is fine. Returns {Ok, Error, Name, Value} where Value is the stored text ({{clipboard}} or the text).
; @returns {Ok, Error, Name, Value}
; @tags values, remember, v31
V31_ParseRemember(text, settings) {
    bad(msg) => {Ok: false, Error: msg, Name: "", Value: ""}
    t := Trim(String(text))
    t := RegExReplace(t, "i)^remember\s+", "")
    if !RegExMatch(t, "is)^(.*\S)\s+as\s+(\S+)$", &m)
        return bad("Write it like  clipboard as total  or  " . Chr(34) . "some text" . Chr(34) . " as total.")
    what := Trim(m[1]), name := Trim(m[2])
    err := V31_ValueNameError(name, settings, 0, true)
    if err != ""
        return bad(err)
    if StrLower(what) = "clipboard"
        return {Ok: true, Error: "", Name: name, Value: "{{clipboard}}"}
    if StrLen(what) >= 2 && SubStr(what, 1, 1) = Chr(34) && SubStr(what, -1) = Chr(34) {
        st := V30_ToStored(SubStr(what, 2, StrLen(what) - 2), V31_NamesAll(settings))
        return st.Ok ? {Ok: true, Error: "", Name: name, Value: st.Text} : bad(st.Error)
    }
    return bad("Write it like  clipboard as total  or  " . Chr(34) . "some text" . Chr(34) . " as total  (the text goes in quotes).")
}

; @summary The Text cell of a Remember step: clipboard as name / "text" as name.
; @returns String
; @tags values, remember, v31
V31_RememberText(node, names := "") {
    v := String(node.Get("value", "")), q := Chr(34)
    return (StrLower(v) = "{{clipboard}}" ? "clipboard" : q . V30_ToShown(v, names is Array ? names : []) . q) . " as " . node.Get("name", "?")
}

; @summary True for a Remember step (a Set block with the remember mark).
; @tags values, remember, v31
V31_IsRemember(node) => node is Map && node.Get("type", "") = "set" && V4_Bool(node.Get("remember", 0)) && !V4_Bool(node.Get("ask", 0))

; @summary A new Remember step (a Set block underneath), remembering the clipboard as "name".
; @returns Map
; @tags values, remember, v31
V31_NewRemember(name := "value1", value := "{{clipboard}}") => Map("type", "set", "name", name, "value", value, "remember", 1)

; @summary Makes sure a Values row called name exists (a new row is "fixed" with an empty value). Returns true when a row was added.
; @returns Boolean
; @tags values, remember, v31
V31_EnsureValueIn(settings, name) {
    if !(settings is Map) || Trim(name) = ""
        return false
    for n in V31_ValueNames(settings)
        if StrLower(n) = StrLower(Trim(name))
            return false
    if !(settings.Get("values", "") is Array)
        settings["values"] := []
    settings["values"].Push(Map("name", Trim(name), "value", "", "when", "fixed"))
    return true
}

; @summary Works out one edited cell of the Values sheet without changing anything: col 1 = Name, 2 = Value, 3 = When. Returns
;          {Ok, Error, Item} (Item = a changed copy of the row). Counts up needs a whole number; switching to counts up with no number
;          writes 1, switching to today's date with no format writes MM/dd/yyyy.
; @returns {Ok, Error, Item}
; @tags values, edit, v31
V31_EditValue(settings, pos, col, input) {
    vals := V31_ValuesOf(settings)
    if pos < 1 || pos > vals.Length || !(vals[pos] is Map)
        return {Ok: false, Error: "There is no such row.", Item: ""}
    item := vals[pos].Clone()
    text := Trim(StrReplace(StrReplace(String(input), "`r", " "), "`n", " "))
    if col = 1 {
        err := V31_ValueNameError(text, settings, pos)
        return err != "" ? {Ok: false, Error: err, Item: ""} : {Ok: true, Error: "", Item: (item["name"] := text, item)}
    }
    if col = 2 {
        if item.Get("when", "fixed") = "counts" && !IsInteger(text)
            return {Ok: false, Error: "Counts up needs a whole number to start from, for example 1.", Item: ""}
        item["value"] := text
        return {Ok: true, Error: "", Item: item}
    }
    code := V31_WhenCode(text)
    if code = ""
        return {Ok: false, Error: "Pick one of: " . V4_Join(V31_WhenTexts(), ", ") . ".", Item: ""}
    oldWhen := item.Get("when", "fixed")
    item["when"] := code
    v := Trim(String(item.Get("value", "")))
    if code = "counts" && !IsInteger(v)
        item["value"] := "1"
    else if code = "date" && oldWhen != "date"
        item["value"] := V31_DateDefault()
    return {Ok: true, Error: "", Item: item}
}

; @summary When a Value is renamed, steps that use {{old}} (Type text) and Remember steps of that name follow. Returns how many steps changed.
; @returns Integer
; @tags values, v31
V31_RenameInSteps(blocks, old, newName) {
    changed := 0
    for node in VMF_Flatten(blocks) {
        if !(node is Map)
            continue
        hit := false
        for key in ["text", "value"]
            if node.Has(key) && InStr(String(node[key]), "{{" . old . "}}") {
                node[key] := StrReplace(String(node[key]), "{{" . old . "}}", "{{" . newName . "}}")
                hit := true
            }
        if V31_IsRemember(node) && StrLower(String(node.Get("name", ""))) = StrLower(old) {
            node["name"] := newName
            hit := true
        }
        if hit
            changed += 1
    }
    return changed
}

; @summary V33: when a List column or a Value is renamed, the Only when rules that name it follow (V30 / V31 changed only {{old}} in the steps' texts,
;          so a rule such as  Status = On  kept the old name and stopped the run at the first row). names = every name known before the rename
;          (the longest known name at the start of a part wins, as in V31_ParsePart, so "Product Description" is not mistaken for "Product").
;          Returns how many steps changed. The rule's other words, "otherwise" and and / or are kept.
; @returns Integer
; @tags rules, rename, v33
V33_RenameInRules(blocks, names, old, newName) {
    changed := 0
    for node in VMF_Flatten(blocks) {
        if !(node is Map) || Trim(String(node.Get("when", ""))) = ""
            continue
        prefix := "", rest := Trim(String(node["when"]))
        if RegExMatch(rest, "i)^(otherwise(?![\w])[\s,:;-]*)(.*)$", &m)
            prefix := m[1], rest := m[2]
        sp := V31_SplitParts(rest)
        if !sp.Ok
            continue
        hit := false, out := []
        for part in sp.Parts {
            t := Trim(part), best := ""
            for nm in names {
                L := StrLen(nm)
                if L > StrLen(best) && StrLower(SubStr(t, 1, L)) = StrLower(nm) {
                    nxt := SubStr(t, L + 1, 1)
                    if nxt = "" || RegExMatch(nxt, "[\s=<>!]")
                        best := nm
                }
            }
            if best != "" && StrLower(best) = StrLower(old) {
                t := newName . SubStr(t, StrLen(best) + 1)
                hit := true
            }
            out.Push(t)
        }
        if hit {
            node["when"] := Trim(prefix . V4_Join(out, " " . sp.Join . " "))
            changed += 1
        }
    }
    return changed
}

; @summary The one small form before step 1: a label (the name) and a box (the current value) for every "ask at start" value.
;          Enter / OK keeps or changes them; Cancel (or Esc, or closing it) stops the run before step 1.
;          Returns {Ok, Asked} (Asked = Map name -> text; Ok false = cancelled).
; @returns {Ok, Asked}
; @tags values, run, gui, v31
V31_AskForm(items) {
    g := Gui("+AlwaysOnTop +ToolWindow", "Values for this run")
    g.SetFont("s9", "Segoe UI")
    g.AddText("xm w380", "Check the values for this run. Enter keeps or changes them. Cancel stops before step 1.")
    boxes := []
    for item in items {
        g.AddText("xm y+8 w380", item["name"])
        boxes.Push(g.AddEdit("xm w380", item["value"]))
    }
    st := {Done: false, Ok: false}
    ok := g.AddButton("xm y+14 w90 Default", "OK")
    ca := g.AddButton("x+6 w90", "Cancel")
    ok.OnEvent("Click", (*) => (st.Ok := true, st.Done := true))
    ca.OnEvent("Click", (*) => (st.Done := true))
    g.OnEvent("Escape", (*) => (st.Done := true))
    g.OnEvent("Close", (*) => (st.Done := true))
    g.Show("AutoSize Center")
    try WinActivate("ahk_id " . g.Hwnd)
    asked := Map()
    asked.CaseSense := false
    while !st.Done
        Sleep(40)
    if st.Ok
        for i, item in items
            asked[item["name"]] := Trim(boxes[i].Value)
    try g.Destroy()
    return {Ok: st.Ok, Asked: asked}
}

; @summary Before a run: when the macro has "ask at start" values, shows the form (V31_AskForm) and returns its answer; with none returns an
;          empty answer and shows nothing.
; @returns {Ok, Asked}
; @tags values, run, v31
V31_AskAtStart(settings) {
    items := V31_AskItems(settings)
    if !items.Length
        return {Ok: true, Asked: Map()}
    return V31_AskForm(items)
}

; @summary The names of the open macro's List columns followed by its Values (what =name may use in a cell).
; @returns Array
; @tags values, v31
V31_NamesAllNow() {
    s := VMB()
    return s.Macro is Map ? V31_NamesAll(s.Macro.Get("settings", "")) : []
}

; @summary The open macro's settings (an empty Map when there is no macro).
; @returns Map
; @tags values, v31
V31_SettingsNow() {
    s := VMB()
    return s.Macro is Map && s.Macro.Get("settings", "") is Map ? s.Macro["settings"] : Map()
}

; @summary True when the macro already has a Value with this name (not case sensitive).
; @returns Boolean
; @tags values, v31
V31_HasValueNamed(settings, name) {
    for n in V31_ValueNames(settings)
        if StrLower(n) = StrLower(Trim(name))
            return true
    return false
}

; @summary A name not used yet by a List column or a Value: base, base2, base3 ... (the first one for "value" is value1).
; @returns String
; @tags values, v31
V31_FreeName(base := "value") {
    st := V31_SettingsNow()
    n := 1
    while V31_ValueNameError(base . n, st) != "" && n < 1000
        n += 1
    return base . n
}

; @summary After a step was changed in the grid: a Remember step creates its Values row when the name is new (editor only).
; @tags values, remember, v31
V31_AfterStepEdit(node) {
    s := VMB()
    if V31_IsRemember(node) && s.Macro is Map && s.Macro.Get("settings", "") is Map
        if V31_EnsureValueIn(s.Macro["settings"], node.Get("name", "")) {
            V31_ValRefresh()
            VMB_Status("Remembering " . node["name"] . " - a new row was added on the Values sheet.")
        }
}

; ----------------------------------------------------------------------------
; V31.1: the Values sheet (a third tab; same grid / overlay editor / own undo approach as the List sheet)
; ----------------------------------------------------------------------------

; @summary Builds the Values sheet's controls (hidden): the buttons, the info line, the grid and its two cell editors (an Edit and a
;          drop-down for the When column). None of them is in s.Ctl. Called from V30_Build.
; @tags values, gui, v31
V31_BuildValues(g) {
    s := VMB()
    b := s.ValBar := Map()
    b["Add"] := g.AddButton("x10 y10 w96 h22 Hidden", "Add value")
    b["Del"] := g.AddButton("x+4 yp w104 h22 Hidden", "Delete value")
    b["Info"] := g.AddText("x+10 yp w400 h22 +0x200 Hidden", "")
    b["Edit"] := g.AddEdit("x10 y10 w100 h22 Hidden +0x4000000")
    b["Pick"] := g.AddDropDownList("x10 y10 w100 Hidden", V31_WhenTexts())
    b["Add"].OnEvent("Click", (*) => V31_ValAdd())
    b["Del"].OnEvent("Click", (*) => V31_ValDelete())
    b["Edit"].OnEvent("LoseFocus", V31_OnValLose)
    b["Pick"].OnEvent("LoseFocus", V31_OnValLose)
    b["Pick"].OnCommand(9, V31_OnValPickDone)                  ; CBN_SELENDOK: a choice was clicked in the list
    s.ValLV := g.AddListView("x10 y40 w600 h300 Grid -Multi +LV0x10000 +0x4000000 Hidden", ["Name", "Value", "When"])
    s.ValLV.OnEvent("DoubleClick", V31_OnValDouble)
    s.ValLV.OnEvent("Click", V31_OnValClick)
    s.ValLV.OnEvent("ContextMenu", V31_OnValMenu)
    s.ValLV.OnEvent("ItemSelect", V33_OnSheetSelect.Bind("values"))
    s.ValLV.OnNotify(-12, V33_OnSheetDraw)
    OnMessage(0x100, V31_OnWmKeyDown)                          ; WM_KEYDOWN: typing on the Values sheet starts an edit
    V31_ApplyValFont()
}

; @summary The Values sheet's font follows the grid zoom (same fonts as the List sheet).
; @tags values, gui, v31
V31_ApplyValFont() {
    s := VMB()
    if !s.ValLV
        return
    s.ValLV.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2")
    s.ValLV.SetFont(, "Segoe UI")
}

; @summary The words on the Values tab: Values, or Values (3).
; @returns String
; @tags values, gui, v31
V31_TabText(count) => count ? "Values (" . count . ")" : "Values"

; @summary The sentence on the Values sheet's info line.
; @returns String
; @tags values, gui, v31
V31_InfoText(count) => count
    ? count . (count = 1 ? " value." : " values.") . "   Use one in a Type step as =name. Double-click a cell to change it."
    : "No values yet. Add value makes a name you can use in a Type step as =name."

; @summary Puts the Values sheet in place (called by V30_Place): the buttons under the Run line, the grid where the Steps grid is.
; @tags values, gui, v31
V31_PlaceValues(x, y, w, gy, gh, barH, show) {
    s := VMB()
    b := s.ValBar
    if !(b is Map) || !b.Has("Add") || !s.ValLV || !(s.Macro is Map)
        return
    V31_ValFinish(false)
    on := show && s.Sheet = "values"
    if on {
        bx := x
        for name in ["Add", "Del"] {
            b[name].GetPos(, , &wd)
            b[name].Move(bx, y + barH + 4, wd, 22), bx += wd + 4
        }
        b["Info"].Move(bx + 6, y + barH + 4, Max(40, w - (bx - x) - 6), 22)
        s.ValLV.Move(x, gy, w, gh)
    }
    for name in ["Add", "Del", "Info"]
        if b[name].Visible != on
            b[name].Visible := on
    if s.ValLV.Visible != on
        s.ValLV.Visible := on
}

; @summary Fills the Values sheet from the macro (Name | Value | When) and the info line and the tab text.
; @tags values, gui, v31
V31_ValFill() {
    s := VMB()
    lv := s.ValLV
    if !lv || !(s.Macro is Map)
        return
    V31_ValCancel(false)
    vals := V31_ValuesOf(s.Macro["settings"])
    keep := lv.GetNext(0)
    lv.Opt("-Redraw")
    lv.Delete()
    for item in vals
        if item is Map
            lv.Add("", Trim(String(item.Get("name", ""))), String(item.Get("value", "")), V31_WhenText(item.Get("when", "fixed")))
    lv.ModifyCol(1, 160)
    lv.ModifyCol(2, 280)
    lv.ModifyCol(3, 150)
    lv.Opt("+Redraw")
    if keep && keep <= lv.GetCount()
        lv.Modify(keep, "Select Focus Vis")
    s.ValBar["Info"].Text := V31_InfoText(vals.Length)
    try s.SheetTabs["Values"].Text := V31_TabText(vals.Length)
}

; @summary Brings the Values sheet and its tab up to date (when it is shown, or just the tab text).
; @tags values, gui, v31
V31_ValRefresh() {
    s := VMB()
    if !s.ValLV || !(s.Macro is Map)
        return
    if s.Sheet = "values" && s.View = "grid"
        V31_ValFill()
    else
        try s.SheetTabs["Values"].Text := V31_TabText(V31_ValuesOf(s.Macro["settings"]).Length)
}

; @summary Remembers the Values as they are (for Ctrl+Z on the Values sheet).
; @tags values, undo, v31
V31_ValPush() {
    s := VMB()
    s.ValUndo.Push(JSON.Stringify(V31_ValuesOf(s.Macro["settings"])))
    if s.ValUndo.Length > 40
        s.ValUndo.RemoveAt(1)
    s.ValRedo := []
}

; @summary A change to the Values is done: Dirty, autosave, the sheet and tab follow.
; @tags values, v31
V31_ValChanged() {
    s := VMB()
    s.Dirty := true
    V7_ScheduleAutoSave()
    VMB_UpdateTitle()
    V31_ValRefresh()
    V27_PlaceGrid()
}

; @summary Ctrl+Z / Ctrl+Y on the Values sheet: the Values as they were before the last change (or forward again).
;          Steps changed by a rename are not changed back (use Ctrl+Z on the Steps sheet for them).
; @tags values, undo, v31
V31_ValUndo(redo := false) {
    s := VMB()
    from := redo ? s.ValRedo : s.ValUndo, to := redo ? s.ValUndo : s.ValRedo
    if !from.Length
        return VMB_Status(redo ? "Nothing to redo on the Values sheet." : "Nothing to undo on the Values sheet.")
    V31_ValFinish(false)
    to.Push(JSON.Stringify(V31_ValuesOf(s.Macro["settings"])))
    s.Macro["settings"]["values"] := JSON.Parse(from.Pop())
    V31_ValChanged()
    VMB_Status(redo ? "Redone." : "Undone.")
}

; @summary Add value: a new row below the selected one (or at the end) with a free name (value1, value2 ...) and opens its Name cell.
; @tags values, gui, v31
V31_ValAdd() {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !(s.Macro is Map)
        return
    V31_ValFinish(false)
    st := s.Macro["settings"]
    if V31_ValuesOf(st).Length >= 200
        return VMB_Status("There can be at most 200 values.")
    V31_ValPush()
    if !(st.Get("values", "") is Array)
        st["values"] := []
    n := 1
    while V31_ValueNameError("value" . n, st) != "" && n < 1000
        n += 1
    at := s.ValLV.GetNext(0)
    pos := at ? at + 1 : st["values"].Length + 1
    st["values"].InsertAt(Max(1, Min(pos, st["values"].Length + 1)), Map("name", "value" . n, "value", "", "when", "fixed"))
    V31_ValChanged()
    pos := Min(pos, s.ValLV.GetCount())
    try s.ValLV.Modify(pos, "Select Focus Vis")
    V31_ValOpen(pos, 1)
}

; @summary Delete value: removes the selected row.
; @tags values, gui, v31
V31_ValDelete() {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !(s.Macro is Map)
        return
    V31_ValFinish(false)
    st := s.Macro["settings"]
    at := s.ValLV.GetNext(0)
    if !at || at > V31_ValuesOf(st).Length
        return VMB_Status("Click a row first, then Delete value.")
    name := Trim(String(st["values"][at].Get("name", "")))
    V31_ValPush()
    st["values"].RemoveAt(at)
    V31_ValChanged()
    try s.ValLV.Modify(Min(at, s.ValLV.GetCount()), "Select Focus Vis")
    VMB_Status("Value " . name . " deleted. A step that uses =" . name . " will stop the run until it is back. Ctrl+Z puts it back.")
}

; @summary Opens the editor on a Values cell (col 1 Name, 2 Value, 3 When = a drop-down). startText = a typed first character (or "").
; @tags values, gui, v31
V31_ValOpen(row, col, startText := "") {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !s.ValLV || s.Sheet != "values" || s.View != "grid"
        return false
    V31_ValFinish(false)
    vals := V31_ValuesOf(s.Macro["settings"])
    if row < 1 || row > vals.Length || row > s.ValLV.GetCount() || col < 1 || col > 3 || !(vals[row] is Map)
        return false
    s.ValCol := col
    V30_EnsureVisible(row, col, s.ValLV)
    rect := V30_CellRect(row, col, s.ValLV)
    if !IsObject(rect)
        return false
    item := vals[row]
    orig := col = 1 ? Trim(String(item.Get("name", ""))) : col = 2 ? String(item.Get("value", "")) : V31_WhenText(item.Get("when", "fixed"))
    s.ValEditRow := row, s.ValEditCol := col, s.ValEditOrig := orig, s.ValEditPick := col = 3
    b := s.ValBar
    if col = 3 {
        pick := b["Pick"]
        pick.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2"), pick.SetFont(, "Segoe UI")
        choice := orig
        if startText != ""
            for t in V31_WhenTexts()
                if StrLower(SubStr(t, 1, StrLen(startText))) = StrLower(startText) {
                    choice := t
                    break
                }
        try pick.Choose(choice)
        pick.Move(rect.X, rect.Y, Max(rect.W, 130))
        shown := pick
    } else {
        ed := b["Edit"]
        ed.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2"), ed.SetFont(, "Segoe UI")
        ed.Value := startText != "" ? startText : orig
        ed.Move(rect.X, rect.Y, rect.W, rect.H)
        shown := ed
    }
    s.ValEditOn := true
    shown.Visible := true
    DllCall("SetWindowPos", "Ptr", shown.Hwnd, "Ptr", 0, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x43)
    shown.Focus()
    DllCall("RedrawWindow", "Ptr", shown.Hwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x185)
    if col != 3 {
        n := StrLen(startText)
        SendMessage(0xB1, startText != "" ? n : 0, startText != "" ? n : -1, b["Edit"])       ; EM_SETSEL
    } else if startText = ""
        PostMessage(0x14F, 1, 0, b["Pick"])                    ; CB_SHOWDROPDOWN
    VMB_Status("Value " . ["name", "value", "When"][col] . ".   Enter saves, Tab goes on, Esc cancels.")
    return true
}

; @summary Hides the Values cell editor (refocus = give the keyboard back to the sheet).
; @tags values, gui, v31
V31_ValHide(refocus := true) {
    s := VMB()
    if !(s.ValBar is Map) || !s.ValBar.Has("Edit")
        return
    s.ValEditOn := false
    s.ValBar["Edit"].Visible := false
    s.ValBar["Pick"].Visible := false
    if refocus && s.ValLV && s.Sheet = "values" && s.View = "grid"
        try s.ValLV.Focus()
}

; @summary Closes the editor and throws the typed text away.
; @tags values, gui, v31
V31_ValCancel(refocus := true) {
    s := VMB()
    if s.ValEditOn
        V31_ValHide(refocus)
}

; @summary Closes the editor and keeps the text when it is fine (a refused text is dropped; the status bar says why).
; @tags values, gui, v31
V31_ValFinish(refocus := true) {
    s := VMB()
    if s.ValEditOn && !V31_ValCommit(refocus)
        V31_ValCancel(refocus)
}

; @summary Writes the editor's text into the Values (one Ctrl+Z undoes it). A refused text keeps the editor open and says why in the
;          status bar. A renamed Value renames {{old}} in the steps too. Returns true when the editor is closed.
; @returns Boolean
; @tags values, gui, v31
V31_ValCommit(refocus := true) {
    s := VMB()
    if !s.ValEditOn
        return true
    b := s.ValBar
    input := s.ValEditPick ? b["Pick"].Text : b["Edit"].Value
    pos := s.ValEditRow, col := s.ValEditCol
    if VM_IsRecording() || VM_IsPlaying() {
        V31_ValHide(false)
        return true
    }
    if input == s.ValEditOrig {
        V31_ValHide(refocus)
        return true
    }
    st := s.Macro["settings"]
    plan := V31_EditValue(st, pos, col, input)
    if !plan.Ok {
        VMB_Status(plan.Error)
        if !s.ValEditPick {
            b["Edit"].Focus()
            SendMessage(0xB1, 0, -1, b["Edit"])                ; EM_SETSEL: select all
        }
        return false
    }
    V31_ValHide(refocus)
    old := Trim(String(st["values"][pos].Get("name", "")))
    V31_ValPush()
    st["values"][pos] := plan.Item
    msg := "Changed. Ctrl+Z undoes it."
    if col = 1 && old != plan.Item["name"] {
        VMB_Snapshot()
        n := V31_RenameInSteps(s.Macro["blocks"], old, plan.Item["name"])
        known := V31_NamesAll(st)
        known.Push(old)
        n += V33_RenameInRules(s.Macro["blocks"], known, old, plan.Item["name"])        ; V33: Only when rules that use the old name follow too
        msg := "Value " . old . " is now called " . plan.Item["name"] . "." . (n ? "  " . n . (n = 1 ? " step was" : " steps were") . " changed to the new name." : "")
        V31_ValChanged()
        VMB_Refresh()
    } else
        V31_ValChanged()
    VMB_Status(msg)
    return true
}

; @summary Enter / Tab / Shift+Tab in the Values editor: saves, then moves (Enter = the cell below is selected, Tab = the next cell opens).
; @tags values, gui, v31
V31_ValEnter(where) {
    s := VMB()
    row := s.ValEditRow, col := s.ValEditCol
    if !V31_ValCommit()
        return
    n := s.ValLV.GetCount()
    if where = "down" {
        if row < n
            s.ValLV.Modify(row + 1, "Select Focus Vis")
        return
    }
    col += where = "back" ? -1 : 1
    if col > 3
        col := 1, row += 1
    else if col < 1
        col := 3, row -= 1
    if row < 1 || row > n
        return
    s.ValLV.Modify(row, "Select Focus Vis")
    V31_ValOpen(row, col)
}

; @summary The editor lost the keyboard focus (clicked elsewhere): the text is kept when it is fine.
; @tags values, gui, v31
V31_OnValLose(ctl, *) {
    s := VMB()
    if !s.ValEditOn || DllCall("GetFocus", "Ptr") = ctl.Hwnd
        return
    V31_ValFinish(false)
}

; @summary A choice was clicked in the When drop-down: save it.
; @tags values, gui, v31
V31_OnValPickDone(*) {
    s := VMB()
    if s.ValEditOn
        V31_ValCommit()
}

; @summary Double-click a Values cell: edit it.
; @tags values, gui, v31
V31_OnValDouble(lv, row) {
    if !row
        return
    hit := V30_HitCell(lv)
    if hit.Row = row && hit.Col >= 1
        V31_ValOpen(row, hit.Col)
}

; @summary Click a Values cell: it becomes the current cell (F2 / Enter edits it).
; @tags values, gui, v31
V31_OnValClick(lv, row) {
    s := VMB()
    if !row
        return
    hit := V30_HitCell(lv)
    if hit.Row = row && hit.Col >= 1 && hit.Col <= 3 {
        V33_SClick("values", row, s.ValCol)
        s.ValCol := hit.Col
        V33_SRepaint("values")
        V33_SStatus("values")
    }
}

; @summary Right-click on the Values sheet: Add value / Delete value.
; @tags values, gui, v31
V31_OnValMenu(lv, row, isRight, x, y) {
    m := Menu()
    m.Add("Add value", (*) => V31_ValAdd())
    m.Add("Delete value", (*) => V31_ValDelete())
    m.Show()
}

; @summary F2 / Enter on the Values sheet: edit the current cell.
; @tags values, gui, v31
V31_ValOpenCurrent() {
    s := VMB()
    row := s.ValLV.GetNext(0)
    if row
        V31_ValOpen(row, s.ValCol)
}

; @summary Left / Right on the Values sheet: moves the current column.
; @tags values, gui, v31
V31_ValMoveCol(step) {
    s := VMB()
    V33_SCollapse("values")
    s.ValCol := Max(1, Min(3, s.ValCol + step))
    VMB_Status("Column: " . ["Name", "Value", "When"][s.ValCol] . "   (F2 or Enter edits the cell)")
}

; @summary Delete on the Values sheet: empties the current Value cell (a Name or When cell cannot be empty).
; @tags values, gui, v31
V31_ValClearCell() {
    s := VMB()
    row := s.ValLV.GetNext(0)
    if !row
        return
    if s.ValCol != 2
        return VMB_Status("Only a Value can be emptied. Change a name or When by typing.")
    st := s.Macro["settings"]
    plan := V31_EditValue(st, row, 2, "")
    if !plan.Ok
        return VMB_Status(plan.Error)
    V31_ValPush()
    st["values"][row] := plan.Item
    V31_ValChanged()
    VMB_Status("Value emptied. Ctrl+Z undoes it.")
}

; @summary Ctrl+C on the Values sheet: the current cell's text on the clipboard.
; @tags values, gui, v31
V31_ValCopyCell() {
    s := VMB()
    row := s.ValLV.GetNext(0)
    if !row
        return
    A_Clipboard := s.ValLV.GetText(row, s.ValCol)
    VMB_Status("Copied the cell.")
}

; @summary True while the Values grid has the keyboard focus (for its hotkeys): this window active, Values sheet shown, no editor open,
;          not recording or playing.
; @tags values, hotkey, v31
V31_ValFocused(*) {
    s := VMB()
    return s.ValLV && s.Gui && s.View = "grid" && s.Sheet = "values" && !s.ValEditOn && !VM_IsPlaying() && !VM_IsRecording()
        && WinActive("ahk_id " . s.Gui.Hwnd) && DllCall("GetFocus", "Ptr") = s.ValLV.Hwnd
}

; @summary True while the Values cell editor (the Edit or the drop-down) has the keyboard focus (for Enter / Tab / Esc).
; @tags values, hotkey, v31
V31_ValEditFocused(*) {
    s := VMB()
    if !s.ValEditOn || !s.Gui || VM_IsPlaying() || VM_IsRecording() || !WinActive("ahk_id " . s.Gui.Hwnd)
        return false
    focus := DllCall("GetFocus", "Ptr")
    pick := s.ValBar["Pick"].Hwnd
    return focus = s.ValBar["Edit"].Hwnd || focus = pick || DllCall("IsChild", "Ptr", pick, "Ptr", focus)
}

; @summary WM_KEYDOWN monitor: a letter, digit or _ typed on the Values sheet starts editing the current cell with that character.
; @tags values, gui, v31
V31_OnWmKeyDown(wParam, lParam, msg, hwnd) {
    s := VMB()
    if !s.ValLV || hwnd != s.ValLV.Hwnd || s.ValEditOn || s.Sheet != "values" || VM_IsRecording() || VM_IsPlaying() || GetKeyState("Ctrl") || GetKeyState("Alt")
        return
    shifted := GetKeyState("Shift")
    if wParam >= 0x41 && wParam <= 0x5A
        ch := (shifted != GetKeyState("CapsLock", "T")) ? Chr(wParam) : StrLower(Chr(wParam))
    else if wParam >= 0x30 && wParam <= 0x39 && !shifted
        ch := Chr(wParam)
    else if wParam >= 0x60 && wParam <= 0x69
        ch := Chr(wParam - 0x30)
    else if wParam = 0xBD && shifted
        ch := "_"
    else
        return
    row := s.ValLV.GetNext(0)
    if row
        V31_ValOpen(row, s.ValCol, ch)
}

; ============================================================================
; V32: rows like Excel rows (insert, duplicate, delete, move, turn off, row ranges), filter arrows in the headers, Find (Ctrl+F)
;   The rows act on the same tree functions as the buttons (VMB_DeleteSelected, VMB_MoveSelected, VMB_Duplicate, VMB_ToggleDisabled,
;   VMB_InsertNode), so undo and autosave work as before. Only in the Steps grid, in step order, with no filter.
; ============================================================================

; @summary The rows between an anchor row and a current row (both 1-based grid rows), as [first, last]; clamped to 1..count.
;          A 0 (no row) for one of them uses the other one. [0, 0] when there are no rows.
; @returns Array of two Integers
; @tags rows, grid, v32
V32_Range(anchor, current, count) {
    if count < 1
        return [0, 0]
    a := anchor < 1 ? current : anchor
    c := current < 1 ? anchor : current
    if a < 1 && c < 1
        return [0, 0]
    a := Min(Max(a, 1), count), c := Min(Max(c, 1), count)
    return [Min(a, c), Max(a, c)]
}

; @summary True when the grid shows every step in step order (no sort, no filter, no header picks): the only state in which rows may be moved.
; @returns Boolean
; @tags rows, grid, v32
V32_ViewIsPlain(sortKey, prog, act, query, picks) => sortKey = "" && prog = "" && act = "" && Trim(query) = "" && picks = 0

; @summary The sentence shown when a row action is refused because the view is sorted or filtered.
; @tags rows, grid, v32
V32_PlainSentence() => "Sort and filter are on: switch to Step order to move rows."

; @summary Is the grid in plain step order now (see V32_ViewIsPlain)?
; @tags rows, grid, v32
V32_Plain() {
    s := VMB()
    return V32_ViewIsPlain(s.SortKey, s.FilterProg, s.FilterAct, s.FilterQ, s.Picks.Count)
}

; @summary Grid rows (a Map row -> 1) of the selected row range, or an empty Map when there is no range (or the view is not plain).
; @returns Map
; @tags rows, grid, v32
V32_RangeRows() {
    s := VMB()
    out := Map(), r := s.GridRange
    if !IsObject(r) || !s.GridRowOf.Has(r.A) || !s.GridRowOf.Has(r.C)
        return out
    lr := V32_Range(s.GridRowOf[r.A], s.GridRowOf[r.C], s.GridRows.Length)
    if lr[1] < 1
        return out
    Loop lr[2] - lr[1] + 1
        out[lr[1] + A_Index - 1] := 1
    return out
}

; @summary The steps a row action works on: the whole row range, else the selected row's step ([] when nothing is selected).
; @returns Array of nodes (top to bottom)
; @tags rows, grid, v32
V32_Targets() {
    s := VMB()
    nodes := []
    if !s.GridLV || s.View != "grid"
        return nodes
    rr := V32_RangeRows()
    if rr.Count {
        for row in V32_RowList(rr)
            if IsObject(nd := s.GridNodes.Get(row, 0))
                nodes.Push(nd)
        return nodes
    }
    row := s.GridLV.GetNext(0)
    if row && IsObject(node := s.GridNodes.Get(row, 0))
        nodes.Push(node)
    return nodes
}

; @summary The keys of a Map of rows, as an ascending Array.
; @returns Array
; @tags rows, v32
V32_RowList(rowMap) {
    list := []
    for row in rowMap
        list.Push(row)
    return list
}

; @summary Every node of the macro in tree order (blocks too): used to see whether an action really changed the order.
; @returns Array
; @tags rows, v32
V32_OrderNodes() {
    items := []
    V27_Walk(VMB().Macro["blocks"], [], items, Map())
    return items
}

; @summary Can a row action run now? False (with a status sentence when the reason is the view) while recording / playing, in list view,
;          or when the grid is sorted or filtered. needRow = a row must be selected.
; @returns Boolean
; @tags rows, grid, v32
V32_Guard(needRow := true) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || s.View != "grid" || !s.GridLV || !(s.Macro is Map)
        return false
    if !V32_Plain() {
        VMB_Status(V32_PlainSentence())
        return false
    }
    if needRow && !V32_Targets().Length {
        VMB_Status("Select a row first.")
        return false
    }
    return true
}

; @summary Selects a step in the grid and the tree without touching the row range (used after every row action).
; @tags rows, grid, v32
V32_SelectNode(node) {
    s := VMB()
    if !s.GridLV || !IsObject(node) || !s.GridRowOf.Has(node)
        return
    s.V32Last := node
    s.GridSync := true
    try s.GridLV.Modify(s.GridRowOf[node], "Select Focus Vis")
    s.GridSync := false
    if s.NodeItem.Has(node)
        s.TV.Modify(s.NodeItem[node], "Select")
    V29_CursorRedraw()
    DllCall("InvalidateRect", "Ptr", s.GridLV.Hwnd, "Ptr", 0, "Int", 1)
}

; @summary After an action: the same steps stay selected (range from first to last, current end = cur); the cell cursor keeps its column.
; @tags rows, grid, v32
V32_Reselect(first, cur) {
    s := VMB()
    old := s.GridRange
    col := IsObject(old) && old.HasOwnProp("Col") ? old.Col : s.GridCol
    s.GridRange := IsObject(first) && (first != cur || col != s.GridCol) && s.GridRowOf.Has(first) ? {A: first, C: cur, Col: col} : 0
    V32_SelectNode(cur)
}

; @summary Runs fn with exactly these steps ticked (the existing tree functions act on ticked lines), then removes the ticks again -
;          also when fn throws - and puts back the ticks the tree had before. One step: nothing is ticked, the tree's selection is used.
; @tags rows, v32
V32_Run(nodes, fn) {
    s := VMB()
    old := s.Checked
    s.Checked := Map()
    if nodes.Length > 1
        for n in nodes
            s.Checked[n] := 1
    try {
        fn()
    } finally {
        for n in nodes
            if nodes.Length > 1 && s.NodeItem.Has(n) && !old.Has(n)
                try s.TV.Modify(s.NodeItem[n], "-Check")
        keep := Map()
        for n in old
            if s.NodeItem.Has(n)
                keep[n] := 1
        s.Checked := keep
        for n in keep
            try s.TV.Modify(s.NodeItem[n], "Check")
    }
}

; @summary The current end and the first step of the row range (for Reselect). Returns {First, Cur}.
; @tags rows, v32
V32_Ends(nodes) {
    s := VMB()
    r := s.GridRange
    if IsObject(r) && s.GridRowOf.Has(r.A) && s.GridRowOf.Has(r.C)
        return {First: r.A, Cur: r.C}
    return {First: nodes[1], Cur: nodes[nodes.Length]}
}

; @summary Alt+Up / Alt+Down (and the menu): moves the selected row(s) up or down one place, with VMB_MoveSelected.
; @tags rows, grid, v32
V32_Move(dir, *) {
    if !V32_Guard()
        return
    s := VMB()
    nodes := V32_Targets(), e := V32_Ends(nodes)
    before := V32_OrderNodes()
    V32_Run(nodes, () => VMB_MoveSelected(dir))
    after := V32_OrderNodes()
    same := before.Length = after.Length
    if same
        for i, n in before
            if after[i] != n {
                same := false
                break
            }
    if same
        return VMB_Status("Cannot move further " . (dir < 0 ? "up." : "down."))
    V32_Reselect(e.First, e.Cur)
    VMB_Status("Moved " . (nodes.Length > 1 ? nodes.Length . " rows " : "the row ") . (dir < 0 ? "up." : "down.") . "  (Ctrl+Z undoes it.)")
}

; @summary Ctrl+Shift+D (and the menu): duplicates the selected row(s) with VMB_Duplicate; the originals stay selected.
; @tags rows, grid, v32
V32_Duplicate(*) {
    if !V32_Guard()
        return
    nodes := V32_Targets(), e := V32_Ends(nodes)
    V32_Run(nodes, VMB_Duplicate)
    V32_Reselect(e.First, e.Cur)
}

; @summary Turns the selected row(s) off / on (VMB_ToggleDisabled); the same rows stay selected.
; @tags rows, grid, v32
V32_Toggle(*) {
    if !V32_Guard()
        return
    nodes := V32_Targets(), e := V32_Ends(nodes)
    V32_Run(nodes, VMB_ToggleDisabled)
    V32_Reselect(e.First, e.Cur)
}

; @summary Shift+Delete (and the menu): deletes the selected row(s) with VMB_DeleteSelected. The first time in a session one box asks;
;          after that it does not ask (Ctrl+Z brings the rows back). The row after the deleted ones is selected.
; @tags rows, grid, v32
V32_DeleteRows(*) {
    if !V32_Guard()
        return
    s := VMB()
    nodes := V32_Targets()
    if !s.V32Asked {
        if MsgBox("Delete " . (nodes.Length > 1 ? nodes.Length . " rows" : "this row") . "?`n`nThis question is asked only once in this session. Ctrl+Z brings deleted rows back.",
            "Delete", "YesNo Icon? Owner" . s.Gui.Hwnd) != "Yes"
            return
        s.V32Asked := true
    }
    rr := V32_RangeRows()
    firstRow := rr.Count ? V32_RowList(rr)[1] : s.GridLV.GetNext(0)
    s.V32NoAsk := true
    try
        V32_Run(nodes, VMB_DeleteSelected)
    finally
        s.V32NoAsk := false
    s.GridRange := 0
    if s.GridRows.Length {
        row := Min(Max(firstRow, 1), s.GridRows.Length)
        V32_SelectNode(s.GridNodes[row])
    }
}

; @summary Inserts a new step (V31 kinds: "text", "keys", "delay", ...) above or below the selected row (the end when no row is selected).
;          Ctrl+Shift+plus inserts a Type step below. The new step is selected.
; @tags rows, grid, v32
V32_Insert(kind, above := false, *) {
    if !V32_Guard(false)
        return
    s := VMB()
    node := V31_NewStep(kind)
    if !IsObject(node)
        return
    cur := V32_Targets()
    if cur.Length {
        at := VMB_Locate(above ? cur[1] : cur[cur.Length])
        list := at.List, idx := above ? at.Index : at.Index + 1
    } else
        list := s.Macro["blocks"], idx := s.Macro["blocks"].Length + 1
    VMB_InsertNode(node, list, idx)
    s.GridRange := 0
    V32_SelectNode(node)
    VMB_Status("Step added " . (above ? "above" : "below") . ". Change it in its cells (double-click). Ctrl+Z undoes it.")
    V31_AfterStepEdit(node)
}

; @summary Shift+Up / Shift+Down: extends the row range by one row (the anchor stays where the range started).
; @tags rows, grid, v32
V32_Extend(dir, edge := false) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || s.View != "grid" || !s.GridLV || !s.GridRows.Length
        return                                       ; (also in a sorted / filtered view: the rows are shaded, the actions say why they wait)
    r := s.GridRange
    valid := IsObject(r) && s.GridRowOf.Has(r.A) && s.GridRowOf.Has(r.C)
    curRow := valid ? s.GridRowOf[r.C] : s.GridLV.GetNext(0)
    if !curRow
        return
    anchor := valid ? r.A : s.GridNodes[curRow]
    newRow := Min(Max(edge ? (dir < 0 ? 1 : s.GridRows.Length) : curRow + dir, 1), s.GridRows.Length)
    if edge
        while newRow >= 1 && newRow <= s.GridRows.Length && !IsObject(s.GridNodes.Get(newRow, 0))      ; V33: Ctrl+Shift+Up / Down: the first / last real step
            newRow -= dir
    else
        while newRow > 1 && newRow < s.GridRows.Length && !IsObject(s.GridNodes.Get(newRow, 0))      ; an Else band has no step: step over it
            newRow += dir
    if newRow < 1 || newRow > s.GridRows.Length || !IsObject(s.GridNodes.Get(newRow, 0))
        return
    s.GridRange := {A: anchor, C: s.GridNodes[newRow], Col: valid && r.HasOwnProp("Col") ? r.Col : s.GridCol}      ; V33: the anchor column is kept
    V32_SelectNode(s.GridNodes[newRow])
    V28_EnsureVisible(newRow, s.GridCol)
    V33_Repaint()
    n := V32_RangeRows().Count
    if V33_Live() && V33_Live().Count > 1
        V33_Status()
    else
        VMB_Status(n > 1 ? n . " rows selected.  Alt+Up / Alt+Down move them, Shift+Delete deletes them, Ctrl+Shift+D duplicates them." : "1 row selected.")
}

; @summary A row was picked in the grid (click or arrow key): Shift+click extends the range from the row picked before, a plain pick ends it.
; @tags rows, grid, v32
V32_OnPick(node) {
    s := VMB()
    if GetKeyState("Shift") && IsObject(node) && IsObject(s.V32Last) && s.GridRowOf.Has(node) && s.GridRowOf.Has(s.V32Last) {
        r := s.GridRange
        anchor := IsObject(r) && s.GridRowOf.Has(r.A) ? r.A : s.V32Last
        s.GridRange := {A: anchor, C: node, Col: IsObject(r) && r.HasOwnProp("Col") ? r.Col : s.GridCol}      ; V33: the anchor column
    } else
        s.GridRange := 0
    if IsObject(node)
        s.V32Last := node
    DllCall("InvalidateRect", "Ptr", s.GridLV.Hwnd, "Ptr", 0, "Int", 1)
}

; @summary Ctrl+Shift+D: duplicates the row(s) when the Steps grid has the focus; otherwise opens the Deterministic Lab (as before).
; @tags rows, hotkey, v32
V32_CtrlShiftD() {
    if V27_GridFocused()
        V32_Duplicate()
    else
        V10_ShowDeterministicLab()
}

; @summary Builds the row menu: Insert step above / below (the Add step kinds), Duplicate, Delete, Move up / down, Turn off / on.
; @returns Menu
; @tags rows, menu, v32
V32_BuildMenu(count := 1) {
    above := Menu(), below := Menu()
    for item in V31_StepKinds() {
        above.Add(item[1], V32_Insert.Bind(item[2], true))
        below.Add(item[1], V32_Insert.Bind(item[2], false))
    }
    word := count > 1 ? count . " rows" : "row"
    m := Menu()
    m.Add("Insert step above", above)
    m.Add("Insert step below`tCtrl+Shift++", below)
    m.Add("Duplicate " . word . "`tCtrl+Shift+D", V32_Duplicate)
    m.Add("Delete " . word . "`tShift+Delete", V32_DeleteRows)
    m.Add()
    m.Add("Move up`tAlt+Up", V32_Move.Bind(-1))
    m.Add("Move down`tAlt+Down", V32_Move.Bind(1))
    m.Add("Turn off / on", V32_Toggle)
    return m
}

; @summary Right-click on a grid row: selects the row (a row inside the range keeps the range), then shows the row menu. Returns true when shown.
; @tags rows, menu, gui, v32
V32_RowMenu(row, x, y) {
    s := VMB()
    node := s.GridNodes.Get(row, 0)
    if !IsObject(node) || VM_IsRecording() || VM_IsPlaying() || s.View != "grid"
        return false
    if !V32_RangeRows().Has(row) {
        s.GridRange := 0
        V32_SelectNode(node)
    }
    m := V32_BuildMenu(V32_Targets().Length)
    item := s.NodeItem.Has(node) ? s.NodeItem[node] : 0
    m.Add()
    m.Add("More step actions...", (*) => item ? VMB_TreeMenu(s.TV, item, true, x, y) : 0)
    m.Show()
    return true
}

; ----------------------------------------------------------------------------
; V32 item C: Find (Ctrl+F). Moves the cell cursor to each matching cell; it never filters.
; ----------------------------------------------------------------------------

; @summary Every cell that contains the needle (not case sensitive), in row order and then column order.
;          rows = Array of Maps (column key -> text), columns = Array of keys (or objects with .Key) in the order they are shown.
; @returns Array of [row, key] (row = position in rows, 1-based); [] for an empty needle
; @tags find, grid, v32
V32_FindAll(rows, columns, needle) {
    hits := []
    needle := String(needle)
    if needle = ""
        return hits
    for r, row in rows {
        for col in columns {
            key := IsObject(col) ? col.Key : col
            if InStr(String(row.Get(key, "")), needle, false)
                hits.Push([r, key])
        }
    }
    return hits
}

; @summary The next (dir = 1) or previous (dir = -1) match after the current one, wrapping round. current = 0 means "none yet".
; @returns Integer (0 when there are no matches)
; @tags find, v32
V32_FindStep(matches, current, dir) {
    n := matches.Length
    if !n
        return 0
    if current < 1 || current > n
        return dir < 0 ? n : 1
    return Mod(current - 1 + (dir < 0 ? -1 : 1) + n, n) + 1
}

; @summary The first match at or below a row (where the cursor is); the first match when none is below; 0 when there are none.
; @returns Integer
; @tags find, v32
V32_FindNear(matches, row) {
    for i, m in matches
        if m[1] >= row
            return i
    return matches.Length ? 1 : 0
}

; @summary The count text of the Find bar: "2 of 5", "No match" or "" (nothing typed).
; @tags find, v32
V32_FindCount(needle, matches, at) => needle = "" ? "" : matches.Length ? at . " of " . matches.Length : "No match"

; @summary Builds the Find bar's controls (hidden; not in s.Ctl). Called from V30_Build.
; @tags find, gui, v32
V32_BuildFind(g) {
    s := VMB()
    b := s.FindBar := Map()
    b["Lbl"] := g.AddText("x10 y10 w36 h22 +0x200 Hidden", "Find:")
    b["Edit"] := g.AddEdit("x+2 yp w240 h22 Hidden +0x4000000")
    b["Prev"] := g.AddButton("x+4 yp w74 h22 Hidden", "Previous")
    b["Next"] := g.AddButton("x+4 yp w56 h22 Hidden", "Next")
    b["Count"] := g.AddText("x+8 yp w110 h22 +0x200 Hidden", "")
    b["Close"] := g.AddButton("x+4 yp w26 h22 Hidden", "X")
    b["Edit"].OnEvent("Change", (*) => V32_FindRun())
    b["Prev"].OnEvent("Click", (*) => V32_FindGo(-1))
    b["Next"].OnEvent("Click", (*) => V32_FindGo(1))
    b["Close"].OnEvent("Click", (*) => V32_FindClose())
}

; @summary Puts the Find bar in its row above the grid (called by V27_PlaceGrid).
; @tags find, gui, v32
V32_PlaceFind(x, y, w, show) {
    s := VMB()
    b := s.FindBar
    if !(b is Map) || !b.Has("Edit")
        return
    if show {
        b["Lbl"].Move(x, y + 1, 36, 22)
        ew := Max(80, Min(260, w - 36 - 74 - 56 - 110 - 26 - 30))
        b["Edit"].Move(x + 38, y + 1, ew, 22)
        cx := x + 38 + ew + 4
        b["Prev"].Move(cx, y + 1, 74, 22), cx += 78
        b["Next"].Move(cx, y + 1, 56, 22), cx += 60
        b["Count"].Move(cx + 4, y + 1, 110, 22), cx += 118
        b["Close"].Move(cx, y + 1, 26, 22)
    }
    for name, ctl in b
        if ctl.Visible != show
            ctl.Visible := show
}

; @summary What Find searches on the sheet that has the focus: {Rows (Array of Maps), Cols (keys in shown order), Lv (the ListView)}.
; @tags find, v32
V32_FindData() {
    s := VMB()
    rows := [], cols := []
    if s.Sheet = "steps" {
        for c in V29_VisibleOrder()
            cols.Push(V27_Columns()[c].Key)
        return {Rows: s.GridRows, Cols: cols, Lv: s.GridLV}
    }
    lv := s.Sheet = "list" ? s.ListLV : s.ValLV
    first := s.Sheet = "list" ? 3 : 1
    Loop lv.GetCount("Col")
        if A_Index >= first
            cols.Push(A_Index)
    Loop lv.GetCount() {
        r := A_Index, cells := Map()
        for c in cols
            cells[c] := lv.GetText(r, c)
        rows.Push(cells)
    }
    return {Rows: rows, Cols: cols, Lv: lv}
}

; @summary Moves the cell cursor to a match (row, key) on the current sheet and scrolls to it. The keyboard focus stays where it is.
; @tags find, grid, v32
V32_FindShow(m) {
    s := VMB()
    if s.Sheet = "steps" {
        node := s.GridNodes.Get(m[1], 0)
        if !IsObject(node)
            return
        col := 0
        for i, c in V27_Columns()
            if c.Key = m[2]
                col := i
        s.GridRange := 0
        V32_SelectNode(node)
        if col {
            s.GridCol := col
            V28_EnsureVisible(m[1], col)
            V29_CursorRedraw()
        }
        return
    }
    lv := s.Sheet = "list" ? s.ListLV : s.ValLV
    try lv.Modify(m[1], "Select Focus Vis")
    if s.Sheet = "list"
        s.ListCol := m[2]
    else
        s.ValCol := m[2]
    V30_EnsureVisible(m[1], m[2], lv)
}

; @summary Searches again for what is in the Find box and goes to the first match at or below the cursor.
; @tags find, v32
V32_FindRun() {
    s := VMB()
    if !s.FindOn
        return
    needle := s.FindBar["Edit"].Value
    data := V32_FindData()
    s.FindHits := V32_FindAll(data.Rows, data.Cols, needle)
    cur := data.Lv.GetNext(0)
    s.FindAt := V32_FindNear(s.FindHits, cur ? cur : 1)
    V32_FindReport(needle, data)
}

; @summary Goes to the next (1) / previous (-1) match (Enter / F3, Shift+F3).
; @tags find, v32
V32_FindGo(dir) {
    s := VMB()
    if !s.FindOn
        return
    needle := s.FindBar["Edit"].Value
    data := V32_FindData()
    hits := V32_FindAll(data.Rows, data.Cols, needle)
    if hits.Length = s.FindHits.Length && s.FindAt
        s.FindAt := V32_FindStep(hits, s.FindAt, dir)
    else {
        cur := data.Lv.GetNext(0)
        s.FindAt := V32_FindNear(hits, cur ? cur : 1)
    }
    s.FindHits := hits
    V32_FindReport(needle, data)
}

; @summary Shows the count, goes to the current match and says where it is in the status bar.
; @tags find, v32
V32_FindReport(needle, data) {
    s := VMB()
    s.FindBar["Count"].Text := V32_FindCount(needle, s.FindHits, s.FindAt)
    if !s.FindAt {
        return VMB_Status(needle = "" ? "Find: type what to look for. Enter or F3 = next, Shift+F3 = previous, Esc closes." : "Find: no cell contains '" . needle . "'.")
    }
    m := s.FindHits[s.FindAt]
    V32_FindShow(m)
    title := s.Sheet = "steps" ? V32_ColTitle(m[2]) : ["Name", "Value", "When"][Min(m[2], 3)]
    if s.Sheet = "list" {
        heads := V30_Headers(s.Macro["settings"])
        title := m[2] - 2 >= 1 && m[2] - 2 <= heads.Length ? heads[m[2] - 2] : "column " . m[2]
    }
    VMB_Status("Find: match " . s.FindAt . " of " . s.FindHits.Length . " - row " . m[1] . ", " . title . ".")
}

; @summary The title of a grid column from its key.
; @tags find, v32
V32_ColTitle(key) {
    for c in V27_Columns()
        if c.Key = key
            return c.Title
    return key
}

; @summary Ctrl+F: opens the Find bar above the grid (or goes back to its box) and searches for what is in it.
; @tags find, gui, v32
V32_FindOpen() {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || s.View != "grid"
        return
    V28_Finish()
    if !s.FindOn {
        s.FindOn := true, s.FindSheet := s.Sheet, s.FindHits := [], s.FindAt := 0
        V27_PlaceGrid()
    }
    s.FindBar["Edit"].Focus()
    SendMessage(0xB1, 0, -1, s.FindBar["Edit"])            ; EM_SETSEL: the old text is selected, typing replaces it
    V32_FindRun()
}

; @summary Esc / X: closes the Find bar and gives the keyboard back to the grid.
; @tags find, gui, v32
V32_FindClose() {
    s := VMB()
    if !s.FindOn
        return
    s.FindOn := false, s.FindHits := [], s.FindAt := 0
    V27_PlaceGrid()
    try (s.Sheet = "list" ? s.ListLV : s.Sheet = "values" ? s.ValLV : s.GridLV).Focus()
    VMB_Status("Find closed.")
}

; @summary True while the Find box has the keyboard focus.
; @tags find, hotkey, v32
V32_FindEditFocused(*) {
    s := VMB()
    return s.FindOn && s.Gui && !VM_IsPlaying() && !VM_IsRecording() && WinActive("ahk_id " . s.Gui.Hwnd)
        && DllCall("GetFocus", "Ptr") = s.FindBar["Edit"].Hwnd
}

; @summary True when F3 / Shift+F3 should find: the Find bar is open and the Find box or the sheet's grid has the focus.
; @tags find, hotkey, v32
V32_FindKeys(*) => VMB().FindOn && (V32_FindEditFocused() || V27_GridFocused() || V30_ListFocused() || V31_ValFocused())

; @summary True when Ctrl+F opens Find: one of the three grids (Steps, List, Values) or the Find box has the focus.
; @tags find, hotkey, v32
V32_FindCanOpen(*) => V27_GridFocused() || V30_ListFocused() || V31_ValFocused() || V32_FindEditFocused()

; ----------------------------------------------------------------------------
; V32 item B: filter arrows in the column headers (Excel AutoFilter). A view only, like sort and the filter box.
; ----------------------------------------------------------------------------

; @summary The distinct cell texts of one column, as the cells show them: numbers first (as numbers, smallest first), then text
;          (A to Z, not case sensitive), and "–" (an empty or not applicable cell) last.
; @returns Array of Strings
; @tags filter, grid, v32
V32_Distinct(rows, key) {
    seen := Map(), nums := [], texts := [], dash := false
    for r in rows {
        v := String(r.Get(key, ""))
        if v = "" || v = "–" {
            dash := true
            continue
        }
        if seen.Has(v)
            continue
        seen[v] := 1
        if RegExMatch(v, "^-?\d+(\.\d+)?$")
            nums.Push(v)
        else
            texts.Push(v)
    }
    out := []
    for v in V32_InsertSort(nums, true)
        out.Push(v)
    for v in V32_InsertSort(texts, false)
        out.Push(v)
    if dash
        out.Push("–")
    return out
}

; @summary Sorts an array of strings (numeric = compare as numbers, else A to Z not case sensitive). Returns a new array.
; @returns Array
; @tags filter, v32
V32_InsertSort(list, numeric) {
    out := []
    for v in list {
        i := out.Length
        while i >= 1 && (numeric ? Number(out[i]) > Number(v) : StrCompare(out[i], v, false) > 0)
            i -= 1
        out.InsertAt(i + 1, v)
    }
    return out
}

; @summary The rows whose cell in every picked column is one of the picked values (columns are ANDed). picks = Map key -> Map(value -> 1).
;          An empty or "–" cell counts as "–". No picks gives all rows. The input is not changed.
; @returns Array of rows
; @tags filter, grid, v32
V32_ApplyPicks(rows, picks) {
    out := []
    for r in rows {
        ok := true
        for key, set in picks {
            v := String(r.Get(key, ""))
            if v = ""
                v := "–"
            if !set.Has(v) {
                ok := false
                break
            }
        }
        if ok
            out.Push(r)
    }
    return out
}

; @summary Is an x position (in the header's own pixels) inside the arrow part (the right arrowW pixels, at most half) of a header cell?
; @returns Boolean
; @tags filter, header, v32
V32_HitArrow(x, left, right, arrowW) => right > left && x >= right - Min(arrowW, (right - left) // 2) && x < right

; @summary The header text: title, the sort triangle when this column is sorted, and the filter arrow (a filtered column shows "▼=").
; @tags filter, header, v32
V32_HeadTitle(title, sortMark, filtered, plain := "") {
    m := V33_FilterMarks(plain = "" ? V33_PlainMarks() : plain)            ; V33: one function holds both marks
    return title . sortMark . " " . (filtered ? m["on"] : m["can"])
}

; @summary A short text that changes when the header picks change (so the header titles are rewritten).
; @tags filter, header, v32
V32_PickSig(picks) {
    sig := ""
    for key, set in picks
        sig .= key . ":" . set.Count . ","
    return sig
}

; @summary The state of the open filter popup (kept here so it is not part of the editor object): a Map, empty when closed.
; @returns Map
; @tags filter, gui, v32
V32_Pop() {
    static p := Map()
    return p
}

; @summary Is the mouse in the arrow part of this column's header cell right now (used by the header click)?
; @returns Boolean
; @tags filter, header, v32
V32_HeaderHit(col) {
    s := VMB()
    hdr := SendMessage(0x101F, 0, 0, s.GridLV)                   ; LVM_GETHEADER
    if !hdr
        return false
    rc := Buffer(16, 0)
    if !SendMessage(0x1207, col - 1, rc.Ptr, hdr)                ; HDM_GETITEMRECT
        return false
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    DllCall("ScreenToClient", "Ptr", hdr, "Ptr", pt)
    return V32_HitArrow(NumGet(pt, 0, "Int"), NumGet(rc, 0, "Int"), NumGet(rc, 8, "Int"), Round(18 * A_ScreenDPI / 96))
}

; @summary Fills the popup's list from the values, the search text and the ticks: "(Select all)" first, then each value that matches.
; @tags filter, gui, v32
V32_PopFill() {
    p := V32_Pop()
    if !p.Has("Lv")
        return
    needle := p["Search"].Value
    p["Sync"] := true
    p["Lv"].Opt("-Redraw")
    p["Lv"].Delete()
    shown := [], all := true
    for v in p["Vals"] {
        if needle != "" && !InStr(v, needle, false)
            continue
        shown.Push(v)
        if !p["On"].Has(v)
            all := false
    }
    p["Shown"] := shown
    p["Lv"].Add(all && shown.Length ? "Check" : "", "(Select all)")
    for v in shown
        p["Lv"].Add(p["On"].Has(v) ? "Check" : "", v)
    p["Lv"].Opt("+Redraw")
    p["Sync"] := false
}

; @summary A tick box in the popup was changed (row 1 = Select all, which ticks / unticks every value shown).
; @tags filter, gui, v32
V32_PopTick(lv, item, checked) {
    p := V32_Pop()
    if !p.Has("Lv") || p["Sync"]
        return
    if item = 1 {
        for v in p["Shown"]
            if checked
                p["On"][v] := 1
            else if p["On"].Has(v)
                p["On"].Delete(v)
        V32_PopFill()
        return
    }
    v := p["Shown"].Has(item - 1) ? p["Shown"][item - 1] : ""
    if v = ""
        return
    if checked
        p["On"][v] := 1
    else if p["On"].Has(v)
        p["On"].Delete(v)
    p["Sync"] := true
    try lv.Modify(1, (p["Shown"].Length && V32_AllOn(p) ? "" : "-") . "Check")
    p["Sync"] := false
}

; @summary True when every value shown in the popup is ticked.
; @tags filter, gui, v32
V32_AllOn(p) {
    for v in p["Shown"]
        if !p["On"].Has(v)
            return false
    return true
}

; @summary Sets (or clears) one column's header filter. chosen = the values to keep, allValues = every value of the column.
;          Picking every value (or none given) clears that column's filter. Refills the grid. Returns the number of rows shown.
; @tags filter, grid, v32
V32_SetPick(key, chosen, allValues) {
    s := VMB()
    if chosen.Length >= allValues.Length || !chosen.Length {
        if s.Picks.Has(key)
            s.Picks.Delete(key)
    } else {
        set := Map()
        for v in chosen
            set[v] := 1
        s.Picks[key] := set
    }
    V27_Refill()
    return s.GridRows.Length
}

; @summary OK in the popup: keeps the ticked values (at least one must be ticked) and closes it.
; @tags filter, gui, v32
V32_PopOK(*) {
    p := V32_Pop()
    if !p.Has("Lv")
        return
    chosen := []
    for v in p["Vals"]
        if p["On"].Has(v)
            chosen.Push(v)
    if !chosen.Length
        return VMB_Status("Tick at least one value (or press Cancel).")
    key := p["Key"], vals := p["Vals"]
    V32_ClosePopup()
    V32_SetPick(key, chosen, vals)
}

; @summary Closes the filter popup without changing anything.
; @tags filter, gui, v32
V32_ClosePopup(*) {
    p := V32_Pop()
    if p.Has("Gui") {
        g := p["Gui"]
        p.Clear()
        try g.Destroy()
    }
}

; @summary Opens the filter popup under a column's header: a search box, a tick list of the column's values (Select all first), OK / Cancel.
;          A small borderless window, not a Menu (menus cannot hold tick lists). Values come from all steps; already picked values are ticked.
; @tags filter, gui, v32
V32_OpenPopup(col) {
    s := VMB()
    cols := V27_Columns()
    if VM_IsRecording() || VM_IsPlaying() || s.View != "grid" || s.Sheet != "steps" || col < 1 || col > cols.Length
        return
    V28_Finish()
    V32_ClosePopup()
    key := cols[col].Key
    vals := V32_Distinct(s.GridAll, key)
    if !vals.Length
        return VMB_Status("This column has no values to pick from.")
    p := V32_Pop()
    on := Map()
    cur := s.Picks.Get(key, 0)
    for v in vals
        if !cur || cur.Has(v)
            on[v] := 1
    g := Gui("+Owner" . s.Gui.Hwnd . " +AlwaysOnTop -Caption +Border")
    g.SetFont("s9", "Segoe UI")
    p["Gui"] := g, p["Key"] := key, p["Vals"] := vals, p["On"] := on, p["Shown"] := [], p["Sync"] := false
    p["Search"] := g.AddEdit("xm ym w230 h22")
    SendMessage(0x1501, 1, StrPtr("Search..."), p["Search"])
    p["Lv"] := g.AddListView("xm y+4 w230 h210 -Hdr -Multi +Checked", ["Value"])
    p["Lv"].ModifyCol(1, 205)
    ok := g.AddButton("xm y+6 w70 h24 Default", "OK")
    ca := g.AddButton("x+6 yp w70 h24", "Cancel")
    p["Search"].OnEvent("Change", (*) => V32_PopFill())
    p["Lv"].OnEvent("ItemCheck", V32_PopTick)
    ok.OnEvent("Click", V32_PopOK)
    ca.OnEvent("Click", V32_ClosePopup)
    g.OnEvent("Escape", V32_ClosePopup)
    g.OnEvent("Close", V32_ClosePopup)
    V32_PopFill()
    x := 100, y := 100
    hdr := SendMessage(0x101F, 0, 0, s.GridLV)
    rc := Buffer(16, 0)
    if hdr && SendMessage(0x1207, col - 1, rc.Ptr, hdr) {
        pt := Buffer(8, 0)
        NumPut("Int", NumGet(rc, 0, "Int"), "Int", NumGet(rc, 12, "Int"), pt)
        DllCall("ClientToScreen", "Ptr", hdr, "Ptr", pt)
        x := NumGet(pt, 0, "Int"), y := NumGet(pt, 4, "Int")
    }
    fct := 96 / A_ScreenDPI
    x := Max(0, Min(x, A_ScreenWidth - 260 * A_ScreenDPI / 96))
    g.Show("x" . Round(x * fct) . " y" . Round(y * fct) . " AutoSize")
    p["Search"].Focus()
    VMB_Status("Filter " . cols[col].Title . ": tick the values to show, then OK. This only changes what the grid shows.")
}

; @summary A click on a column title: in the arrow part opens the filter popup (returns true); anywhere else it is a sort click (returns false).
; @returns Boolean
; @tags filter, header, v32
V32_HeaderClick(col) {
    V32_ClosePopup()
    if V32_HeaderHit(col) {
        V32_OpenPopup(col)
        return true
    }
    return false
}

; ----------------------------------------------------------------------------
; V32 item D: hand-made loop / If blocks as shaded band rows in the Steps grid (shown in step order only, no sort, no filter)
; ----------------------------------------------------------------------------

; @summary Does the macro have loop / If blocks at the top level (and so, maybe nested ones)?
; @returns Boolean
; @tags bands, grid, v32
V32_HasBlocks(blocks) {
    if blocks is Array
        for node in blocks
            if node is Map && VMF_IsContainer(node)
                return true
    return false
}

; @summary Two spaces per level (the indent of a step in the Action column).
; @returns String
; @tags bands, grid, v32
V32_Pad(depth) {
    pad := ""
    Loop Max(0, depth) * 2
        pad .= " "
    return pad
}

; @summary The text of a band row: the block's own line for its first list ("Repeat 5 times", "If ..."), "Else if ..." and "Else" for the others of an If.
; @returns String
; @tags bands, grid, v32
V32_BandText(node, i) {
    if node.Get("type", "") != "if" || i = 1
        return V27_BlockLabel(node)
    alts := node.Get("elifs", "")
    n := alts is Array ? alts.Length : 0
    return i <= 1 + n ? "Else if " . V21_CondText(alts[i - 1]) : "Else"
}

; @summary One band row: every cell empty except Action (indented). node = the block for its first band row, 0 for an Else / Else if band.
; @returns Map (with .Node, .Band, .Grey, .Chain)
; @tags bands, grid, v32
V32_BandRow(text, depth, node) {
    row := Map()
    for col in V27_Columns()
        row[col.Key] := ""
    row["action"] := V32_Pad(depth) . text
    row.Node := node, row.Band := true, row.Grey := false, row.Chain := 0
    return row
}

; @summary Walks the blocks and puts a band row before each block's steps (an Else / Else if list gets its own band when it has steps).
;          Step rows are copies of the real rows with the Action indented two spaces per level.
; @tags bands, grid, v32
V32_BandWalk(list, depth, byNode, out) {
    for node in list {
        if !(node is Map)
            continue
        if VMF_IsContainer(node) {
            for i, kid in VMF_Children(node) {
                if i > 1 && !kid.Length
                    continue
                out.Push(V32_BandRow(V32_BandText(node, i), depth, i = 1 ? node : 0))
                V32_BandWalk(kid, depth + 1, byNode, out)
            }
        } else if byNode.Has(node) {
            r := byNode[node]
            c := r.Clone()
            c.Node := r.Node
            c.Grey := r.HasOwnProp("Grey") && r.Grey, c.Chain := r.HasOwnProp("Chain") ? r.Chain : 0, c.Band := false
            c["action"] := V32_Pad(depth) . String(r.Get("action", ""))
            out.Push(c)
        }
    }
}

; @summary The rows the grid shows in step order when the macro has loop / If blocks: band rows and indented step rows. [] when it has none.
; @returns Array of rows
; @tags bands, grid, v32
V32_MakeBands(blocks, stepRows) {
    if !V32_HasBlocks(blocks)
        return []
    byNode := Map()
    for r in stepRows
        byNode[r.Node] := r
    out := []
    V32_BandWalk(blocks, 0, byNode, out)
    return out
}

; @summary Are band rows shown now? Only in step order (no sort) and with no filter or header pick.
; @returns Boolean
; @tags bands, grid, v32
V32_BandsOn() {
    s := VMB()
    return s.Bands && s.GridBands.Length > 0 && s.SortKey = "" && !V27_FilterOn()
}

; ==== V32 END (new V32 functions are added above this line)

; ============================================================================
; V33: cell ranges (Shift+arrows, Shift+click), a summary like Excel's status bar, block copy / paste / fill / clear,
;   the Excel look (colours in V33_Look) and a frozen "# and Action" pane. Rows are still the V32 row range; V33 adds the
;   anchor COLUMN to it: s.GridRange = {A: node, C: node, Col: anchor column number}. The cursor column s.GridCol is the other end.
; ============================================================================

; ----------------------------------------------------------------------------
; V33 item 0: header marks in one place, undo keeps the row
; ----------------------------------------------------------------------------

; @summary The two header marks in one place: "can" = this column can be filtered, "on" = it is filtered. plain = 1 gives ASCII
;          (for a PC where the arrow shows as a box). Pure.
; @returns Map with "can" and "on"
; @tags header, filter, v33
V33_FilterMarks(plain := 0) => plain ? Map("can", "v", "on", "v=") : Map("can", "▼", "on", "▼=")

; @summary True when the ini says [V22] PlainMarks=1 (read once).
; @returns 0 or 1
; @tags header, v33
V33_PlainMarks() {
    static v := ""
    if v = ""
        try v := VMB().Ini != "" && IniRead(VMB().Ini, "V22", "PlainMarks", 0) = "1" ? 1 : 0
        catch
            v := 0
    return v
}

; @summary Row number to select after an undo / redo: the same position as before, clamped to 1..count; 0 when there are no rows
;          (or no row was selected). Pure.
; @returns Integer
; @tags undo, grid, v33
V33_ClampRow(row, count) => count < 1 || row < 1 ? 0 : Min(row, count)

; @summary After Undo / Redo the steps are new objects: selects the grid row at the old position again (same column). Safe without a grid.
; @tags undo, grid, v33
V33_UndoRestore(row) {
    s := VMB()
    if s.View != "grid" || !s.GridLV || !s.GridRows.Length
        return
    s.GridRange := 0
    n := V33_ClampRow(row, s.GridRows.Length)
    if !n
        return
    r := n
    while r <= s.GridRows.Length && !IsObject(s.GridNodes.Get(r, 0))
        r += 1
    if r > s.GridRows.Length {
        r := n
        while r >= 1 && !IsObject(s.GridNodes.Get(r, 0))
            r -= 1
    }
    if r >= 1 && IsObject(s.GridNodes.Get(r, 0))
        V32_SelectNode(s.GridNodes[r])
}

; ----------------------------------------------------------------------------
; V33 item A: a rectangle of cells
; ----------------------------------------------------------------------------

; @summary The rectangle between an anchor cell and the current cell: {rows: [first, last], keys: [...]}. Rows are 1-based grid rows
;          (a 0 for one of them uses the other; both 0 gives [0, 0]). keys are the entries of order (the columns in the order they are
;          SHOWN, hidden ones already left out) from the anchor's to the current one. A column that is not in order (hidden) falls back
;          to the other end; neither in order gives no keys. Pure.
; @returns {rows, keys}
; @tags range, cells, v33
V33_Rect(anchorRow, anchorCol, curRow, curCol, order) {
    a := anchorRow < 1 ? curRow : anchorRow
    c := curRow < 1 ? anchorRow : curRow
    rows := a < 1 && c < 1 ? [0, 0] : [Min(a, c), Max(a, c)]
    ia := 0, ic := 0
    for i, k in order {
        if !ia && k = anchorCol
            ia := i
        if !ic && k = curCol
            ic := i
    }
    keys := []
    if ia || ic {
        ia := ia ? ia : ic
        ic := ic ? ic : ia
        Loop Max(ia, ic) - Min(ia, ic) + 1
            keys.Push(order[Min(ia, ic) + A_Index - 1])
    }
    return {rows: rows, keys: keys}
}

; @summary A number as short text: up to 3 decimals, no trailing zeros ("12.5", "12", "0.25").
; @returns String
; @tags range, v33
V33_NumText(x) {
    t := Format("{:.3f}", Round(x, 3))
    t := RTrim(RTrim(t, "0"), ".")
    return t = "-0" || t = "" ? "0" : t
}

; @summary The text for the status bar when a block of cells is selected, like Excel's: "6 cells" always (nothing for fewer than
;          one); on top of it, when key = "wait" and EVERY cell is a time ("2 s", "500 ms", "1.5"): "Waits first: total 12.5 s";
;          when key = "list" / "values" and every cell is a number: "Sum: 125". cells = Array of texts (what the cells hold),
;          key = the column key when all cells are in the same column, else "". Pure.
; @returns String
; @tags range, summary, v33
V33_Summary(cells, key) {
    n := cells.Length
    if n < 1
        return ""
    head := n . (n = 1 ? " cell" : " cells")
    if key = "wait" {
        total := 0
        for t in cells {
            w := V28_ParseWait(t)
            if !w.Ok || w.Value = "auto"
                return head
            total += w.Value
        }
        return head . " · Waits first: total " . V33_NumText(total / 1000) . " s"
    }
    if key = "list" || key = "values" {
        sum := 0
        for t in cells {
            x := Trim(String(t))
            if !RegExMatch(x, "^[-+]?\d+(?:[.,]\d+)?$") && !RegExMatch(x, "^[-+]?\d{1,3}(?:,\d{3})+(?:\.\d+)?$")
                return head
            sum += Number(RegExMatch(x, "^[-+]?\d+,\d{1,2}$") ? StrReplace(x, ",", ".") : StrReplace(x, ",", ""))
        }
        return head . " · Sum: " . V33_NumText(sum)
    }
    return head
}

; @summary The live rectangle of the Steps grid: {R1, R2, Cols (Map column number -> 1), Keys (column numbers, shown order), Count,
;          ARow, ACol, Cur (current row), Order}, or 0 when no row is selected / not the Steps grid.
;          Count is rows x columns (1 = just the current cell).
; @returns Object or 0
; @tags range, grid, v33
V33_Live() {
    s := VMB()
    if s.View != "grid" || !s.GridLV || s.Sheet != "steps"
        return 0
    cur := s.GridLV.GetNext(0)
    if !cur
        return 0
    order := V29_VisibleOrder()
    ar := cur, ac := s.GridCol
    r := s.GridRange
    if IsObject(r) && s.GridRowOf.Has(r.A) && s.GridRowOf.Has(r.C) {
        ar := s.GridRowOf[r.A], cur := s.GridRowOf[r.C]
        ac := r.HasOwnProp("Col") ? r.Col : s.GridCol
    }
    rc := V33_Rect(ar, ac, cur, s.GridCol, order)
    if !rc.keys.Length
        rc.keys := [s.GridCol]
    cols := Map()
    for k in rc.keys
        cols[k] := 1
    return {R1: rc.rows[1], R2: rc.rows[2], Cols: cols, Keys: rc.keys, Count: (rc.rows[2] - rc.rows[1] + 1) * rc.keys.Length,
        ARow: ar, ACol: ac, Cur: cur, Order: order}
}

; @summary The text a cell of the Steps grid gives to the clipboard / summary (the editor's raw text, or what is shown). Row = grid row.
; @returns String
; @tags range, grid, v33
V33_CellText(row, col) {
    s := VMB()
    return V29_CopyText(s.GridNodes.Get(row, 0), V27_Columns()[col].Key, s.GridLV.GetText(row, col))
}

; @summary Repaints the whole grid (the range shading changed) and the name box.
; @tags range, grid, v33
V33_Repaint() {
    s := VMB()
    if !s.GridLV
        return
    DllCall("InvalidateRect", "Ptr", s.GridLV.Hwnd, "Ptr", 0, "Int", 1)
    V29_CursorRedraw()
}

; @summary A plain arrow / Home / End / Tab / click: the range ends and one cell is current again.
; @tags range, grid, v33
V33_Collapse() {
    s := VMB()
    if IsObject(s.GridRange) {
        s.GridRange := 0
        V33_Repaint()
    }
}

; @summary The status bar text for the current range: the summary (V33_Summary) and a hint. One cell: the normal cell sentence.
; @tags range, summary, grid, v33
V33_Status() {
    s := VMB()
    live := V33_Live()
    if !live
        return
    if live.Count < 2
        return V28_CellStatus(live.Cur)
    cols := V27_Columns()
    cells := []
    Loop live.R2 - live.R1 + 1 {
        row := live.R1 + A_Index - 1
        for c in live.Keys
            cells.Push(V33_CellText(row, c))
    }
    key := live.Keys.Length = 1 ? cols[live.Keys[1]].Key : ""
    VMB_Status(V33_Summary(cells, key) . "   Ctrl+C copies, Ctrl+V pastes, Ctrl+D fills down, Delete clears.")
}

; @summary Shift+Left / Shift+Right (edge = true: Ctrl+Shift+Left / Right, to the first / last shown column): grows the range sideways.
;          The anchor cell stays where the range started.
; @tags range, grid, hotkey, v33
V33_ExtendCol(dir, edge := false) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || s.View != "grid" || !s.GridLV || !s.GridRows.Length
        return
    row := s.GridLV.GetNext(0)
    node := row ? s.GridNodes.Get(row, 0) : 0
    order := V29_VisibleOrder()
    if !IsObject(node) || !order.Length
        return
    r := s.GridRange
    valid := IsObject(r) && s.GridRowOf.Has(r.A) && s.GridRowOf.Has(r.C)
    acol := valid && r.HasOwnProp("Col") ? r.Col : s.GridCol
    anchor := valid ? r.A : node
    cnode := valid ? r.C : node
    s.GridCol := edge ? (dir < 0 ? order[1] : order[order.Length]) : V29_NextCol(order, s.GridCol, dir)
    s.GridRange := {A: anchor, C: cnode, Col: acol}
    V28_EnsureVisible(s.GridRowOf.Get(cnode, row), s.GridCol)
    V33_Repaint()
    V33_Status()
}

; @summary Ctrl+A in the grid: every cell of the sheet (shown columns, all rows). The current cell is the top left one.
; @tags range, grid, hotkey, v33
V33_SelectAll() {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || s.View != "grid" || !s.GridLV || !s.GridRows.Length
        return
    order := V29_VisibleOrder()
    first := 0, last := 0
    for row in s.GridRows.Length ? V33_Seq(s.GridRows.Length) : []
        if IsObject(s.GridNodes.Get(row, 0)) {
            if !first
                first := row
            last := row
        }
    if !first || !order.Length
        return
    s.GridRange := {A: s.GridNodes[last], C: s.GridNodes[first], Col: order[order.Length]}
    s.GridCol := order[1]
    V32_SelectNode(s.GridNodes[first])
    V28_EnsureVisible(first, s.GridCol)
    V33_Repaint()
    V33_Status()
}

; @summary [1, 2, ... n] (small helper so a for loop can walk rows).
; @returns Array
; @tags v33
V33_Seq(n) {
    out := []
    Loop n
        out.Push(A_Index)
    return out
}

; ----------------------------------------------------------------------------
; V33 item B: copy / paste / fill / clear a block (pure planning first)
; ----------------------------------------------------------------------------

; @summary Reads clipboard text the way Excel writes it: tab between cells, line break between rows, a cell that holds a tab, a line
;          break or a quote is in quotes ("" inside is one quote). One empty line at the very end is dropped. "" gives no rows.
;          Never throws. Pure.
; @returns Array of rows, each an Array of texts
; @tags paste, v33
V33_ParseBlock(text) {
    text := String(text)
    q := Chr(34)
    rows := [], row := [], field := "", quoted := false, inQ := false
    i := 1, n := StrLen(text)
    while i <= n {
        ch := SubStr(text, i, 1)
        if inQ {
            if ch = q {
                if SubStr(text, i + 1, 1) = q {
                    field .= q
                    i += 2
                    continue
                }
                inQ := false
                i += 1
                continue
            }
            field .= ch
            i += 1
            continue
        }
        if ch = q && field = "" && !quoted {
            inQ := true, quoted := true
            i += 1
            continue
        }
        if ch = "`t" {
            row.Push(field)
            field := "", quoted := false
            i += 1
            continue
        }
        if ch = "`r" || ch = "`n" {
            if ch = "`r" && SubStr(text, i + 1, 1) = "`n"
                i += 1
            row.Push(field)
            rows.Push(row)
            row := [], field := "", quoted := false
            i += 1
            continue
        }
        field .= ch
        i += 1
    }
    if field != "" || row.Length || quoted {
        row.Push(field)
        rows.Push(row)
    }
    return rows
}

; @summary Where a pasted block lands. block = V33_ParseBlock result, rect = {rows: [first, last], keys: [...]} (the selection or the
;          current cell), order = every shown column key left to right, rowCount = rows in the sheet, grow = true when the sheet may get
;          new rows (the List sheet). Rules: one value onto a range fills the whole range (Excel); a block goes to the top left cell of
;          the selection and keeps its size; a selection that is a whole multiple of the block's size is tiled with it. Cells below the
;          last row are dropped (or, with grow, counted in NewRows); cells right of the last column are dropped.
;          Returns {Cells: [{Row, Key, Text}], Dropped, NewRows}. Pure.
; @returns Object
; @tags paste, v33
V33_PlanPaste(block, rect, order := "", rowCount := 0, grow := false) {
    out := {Cells: [], Dropped: 0, NewRows: 0}
    h := block.Length, w := 0
    for r in block
        w := Max(w, r.Length)
    if !h || !w || rect.rows[1] < 1 || !rect.keys.Length
        return out
    if !IsObject(order) || !order.Length
        order := rect.keys
    selR := rect.rows[2] - rect.rows[1] + 1, selC := rect.keys.Length
    at(i, j) => j <= block[i].Length ? block[i][j] : ""
    c0 := 0
    for i, k in order
        if k = rect.keys[1] {
            c0 := i
            break
        }
    if !c0
        c0 := 1
    rows := h, cols := w, tile := false
    if selR * selC > 1 {
        if h = 1 && w = 1 {
            rows := selR, cols := selC, tile := true
        } else if Mod(selR, h) = 0 && Mod(selC, w) = 0 {
            rows := selR, cols := selC, tile := true
        }
    }
    maxRow := 0
    Loop rows {
        i := A_Index
        row := rect.rows[1] + i - 1
        Loop cols {
            j := A_Index
            col := c0 + j - 1
            if col > order.Length {
                out.Dropped += 1
                continue
            }
            if row > rowCount && !grow {
                out.Dropped += 1
                continue
            }
            maxRow := Max(maxRow, row)
            txt := tile ? at(Mod(i - 1, h) + 1, Mod(j - 1, w) + 1) : at(i, j)
            out.Cells.Push({Row: row, Key: order[col], Text: txt})
        }
    }
    if grow && maxRow > rowCount
        out.NewRows := maxRow - rowCount
    return out
}

; @summary Fill down (dir "down": the top cell of each column goes into the rest of the range) or fill right ("right": the left cell of
;          each row goes into the rest). Returns {Cells: [{Row, Key, SrcRow, SrcKey}]}. Pure.
; @returns Object
; @tags fill, v33
V33_PlanFill(rect, dir) {
    cells := []
    r1 := rect.rows[1], r2 := rect.rows[2], keys := rect.keys
    if r1 < 1 || !keys.Length
        return {Cells: cells}
    if dir = "right" {
        Loop r2 - r1 + 1 {
            row := r1 + A_Index - 1
            Loop keys.Length - 1
                cells.Push({Row: row, Key: keys[A_Index + 1], SrcRow: row, SrcKey: keys[1]})
        }
    } else {
        for k in keys
            Loop r2 - r1
                cells.Push({Row: r1 + A_Index, Key: k, SrcRow: r1, SrcKey: k})
    }
    return {Cells: cells}
}

; @summary The sentence after a block action: "Pasted 9 cells, 2 could not take the value." (done = cells that took it, refused = cells
;          that did not, dropped = cells that fell outside the sheet). verb is the first word ("Pasted", "Filled down", "Cleared"). Pure.
; @returns String
; @tags paste, v33
V33_DoneText(verb, done, refused, dropped := 0) {
    t := verb . " " . done . (done = 1 ? " cell" : " cells")
    parts := []
    if refused
        parts.Push(refused . (refused = 1 ? " could not take the value" : " could not take the value"))
    if dropped
        parts.Push(dropped . (dropped = 1 ? " fell outside the sheet" : " fell outside the sheet"))
    return t . (parts.Length ? ", " . V4_Join(parts, ", ") : "") . "."
}

; @summary Changes many cells of the Steps grid as ONE undo step: one VMB_Snapshot before the first change, no snapshot per cell, one
;          refresh and one autosave at the end. cells = [{Row, Key, Text}] (grid rows, column KEYS). A cell that refuses the value is
;          skipped and counted. Returns {Done, Refused, Nodes (Array of changed nodes in order), First, Last}.
; @returns Object
; @tags paste, fill, grid, v33
V33_Apply(cells) {
    s := VMB()
    res := {Done: 0, Refused: 0, Changed: 0, Nodes: [], Error: ""}
    snap := false
    seen := Map()
    for c in cells {
        node := s.GridNodes.Get(c.Row, 0)
        if !IsObject(node) || V28_Editable(node, c.Key) = "" {
            res.Refused += 1
            continue
        }
        plan := V28_Plan(node, c.Key, c.Text)
        if !plan.Ok {
            res.Refused += 1
            if res.Error = ""
                res.Error := plan.Error
            continue
        }
        res.Done += 1
        if V28_SameText(c.Text, V28_EditText(node, c.Key))
            continue
        if !snap {
            VMB_Snapshot()
            snap := true
        }
        V28_ApplyChanges(node, plan.Changes)
        res.Changed += 1
        if !seen.Has(node) {
            seen[node] := 1
            res.Nodes.Push(node)
        }
    }
    if snap {
        s.Dirty := true
        VMB_Refresh()
        V7_AutoSaveNow()
        for n in res.Nodes
            V31_AfterStepEdit(n)
    }
    return res
}

; @summary True when a block action may start now (Steps grid, nothing recording / playing, the editor closed).
; @tags paste, grid, v33
V33_CanAct() {
    s := VMB()
    return !(VM_IsRecording() || VM_IsPlaying() || s.View != "grid" || !s.GridLV || s.Sheet != "steps" || s.CellOn || !(s.Macro is Map))
}

; @summary The grid's rectangle as a {rows, keys} object with column KEYS (not numbers), as V33_PlanPaste / V33_PlanFill want it.
; @tags paste, grid, v33
V33_KeyRect(live) {
    cols := V27_Columns()
    keys := []
    for c in live.Keys
        keys.Push(cols[c].Key)
    return {rows: [live.R1, live.R2], keys: keys}
}

; @summary Column number of a column key (0 when unknown).
; @returns Integer
; @tags grid, v33
V33_ColOf(key) {
    for i, c in V27_Columns()
        if c.Key = key
            return i
    return 0
}

; @summary Ctrl+C: a block as tab / line separated text (what Excel puts on the clipboard); one cell as before (V29_CopyCell).
; @tags copy, grid, hotkey, v33
V33_Copy() {
    s := VMB()
    live := V33_Live()
    if !live || live.Count < 2
        return V29_CopyCell()
    lines := []
    Loop live.R2 - live.R1 + 1 {
        row := live.R1 + A_Index - 1
        parts := []
        for c in live.Keys
            parts.Push(V33_CellText(row, c))
        lines.Push(V4_Join(parts, "`t"))
    }
    A_Clipboard := V4_Join(lines, "`r`n")
    VMB_Status("Copied " . live.Count . " cells (" . lines.Length . (lines.Length = 1 ? " row" : " rows") . " x " . live.Keys.Length . (live.Keys.Length = 1 ? " column" : " columns")
        . ").   Ctrl+V pastes them here or in Excel.")
}

; @summary Ctrl+V: the clipboard block goes in from the current cell (or onto the whole range when it is one value), cell by cell
;          through the same rules as typing (V28_Plan); one undo step; refused cells are skipped and counted.
; @tags paste, grid, hotkey, v33
V33_Paste() {
    s := VMB()
    live := V33_Live()
    if !live || !V33_CanAct()
        return
    clip := A_Clipboard
    if clip = ""
        return VMB_Status("The clipboard has no text to paste.")
    block := V33_ParseBlock(clip)
    if !block.Length
        return VMB_Status("The clipboard has no text to paste.")
    one := block.Length = 1 && block[1].Length <= 1
    if one && live.Count = 1
        return V29_PasteCell()
    cols := V27_Columns()
    order := []
    for c in live.Order
        order.Push(cols[c].Key)
    plan := V33_PlanPaste(block, V33_KeyRect(live), order, s.GridRows.Length, false)
    if !plan.Cells.Length
        return VMB_Status("Nothing to paste here: the block does not fit inside the sheet from this cell.")
    firstNode := s.GridNodes.Get(plan.Cells[1].Row, 0)
    lastCell := plan.Cells[plan.Cells.Length]
    lastNode := s.GridNodes.Get(lastCell.Row, 0)
    firstKey := plan.Cells[1].Key
    res := V33_Apply(plan.Cells)
    VMB_Status(V33_DoneText("Pasted", res.Done, res.Refused, plan.Dropped) . (res.Done ? "  Ctrl+Z undoes it all." : "")
        . (res.Error != "" && res.Done = 0 ? "  " . res.Error : ""))
    if res.Done && plan.Cells.Length > 1 && IsObject(firstNode) && IsObject(lastNode) && s.GridRowOf.Has(firstNode) && s.GridRowOf.Has(lastNode) {
        s.GridRange := {A: firstNode, C: lastNode, Col: V33_ColOf(firstKey)}
        s.GridCol := V33_ColOf(lastCell.Key)
        V32_SelectNode(lastNode)
        V33_Repaint()
    }
}

; @summary Ctrl+D (fill down) and Ctrl+R (fill right) in the grid: the top / left cell goes into the rest of the range, one undo step.
;          One cell selected: Ctrl+D copies the cell above (V28_CopyAbove, as before); Ctrl+R copies the cell to the left.
; @tags fill, grid, hotkey, v33
V33_Fill(dir) {
    s := VMB()
    live := V33_Live()
    if !live || !V33_CanAct()
        return
    if live.Count = 1 {
        if dir = "down"
            return V28_CopyAbove()
        return V33_FillLeft(live)
    }
    krect := V33_KeyRect(live)
    if dir = "down" && live.R1 = live.R2
        return VMB_Status("Fill down needs two or more rows: select the cell to copy and the cells below it.")
    if dir = "right" && krect.keys.Length < 2
        return VMB_Status("Fill right needs two or more columns: select the cell to copy and the cells to its right.")
    plan := V33_PlanFill(krect, dir)
    cells := []
    bad := 0
    for c in plan.Cells {
        src := s.GridNodes.Get(c.SrcRow, 0)
        if !IsObject(src) || V28_Editable(src, c.SrcKey) = "" {
            bad += 1
            continue
        }
        cells.Push({Row: c.Row, Key: c.Key, Text: V28_EditText(src, c.SrcKey)})
    }
    res := V33_Apply(cells)
    VMB_Status(V33_DoneText(dir = "down" ? "Filled down" : "Filled right", res.Done, res.Refused + bad) . (res.Done ? "  Ctrl+Z undoes it all." : "")
        . (res.Error != "" && res.Done = 0 ? "  " . res.Error : ""))
}

; @summary Ctrl+R on one cell: copies the value of the cell to its left (in the order shown) into it.
; @tags fill, grid, v33
V33_FillLeft(live) {
    s := VMB()
    pos := 0
    for i, c in live.Order
        if c = s.GridCol
            pos := i
    if pos < 2
        return VMB_Status("There is no cell to the left to copy from.")
    cols := V27_Columns()
    src := s.GridNodes.Get(live.Cur, 0)
    lk := cols[live.Order[pos - 1]].Key
    if !IsObject(src) || V28_Editable(src, lk) = ""
        return VMB_Status("Copy from the left works when that cell can be edited: " . cols[live.Order[pos - 1]].Title . " cannot.")
    res := V33_Apply([{Row: live.Cur, Key: cols[s.GridCol].Key, Text: V28_EditText(src, lk)}])
    VMB_Status(res.Done ? "Copied from the cell on the left. Ctrl+Z undoes it." : "The cell on the left does not fit here: " . res.Error)
}

; @summary Delete in the grid: one cell as before (V28_DeleteCell); a range: every clearable cell in it (Note, Waits first, Only when,
;          If it fails) is cleared as ONE undo step; the others are left and counted.
; @tags clear, grid, hotkey, v33
V33_Delete() {
    s := VMB()
    live := V33_Live()
    if !live || live.Count < 2
        return V28_DeleteCell()
    if !V33_CanAct()
        return
    cols := V27_Columns()
    cells := []
    skipped := 0
    Loop live.R2 - live.R1 + 1 {
        row := live.R1 + A_Index - 1
        node := s.GridNodes.Get(row, 0)
        for c in live.Keys {
            key := cols[c].Key
            if !IsObject(node) || !V31_Clearable(key) {
                skipped += 1
                continue
            }
            if node.Has(V31_ClearKey(key))
                cells.Push({Row: row, Key: key, Text: ""})
        }
    }
    res := V33_Apply(cells)
    VMB_Status(V33_DoneText("Cleared", res.Done, res.Refused) . (skipped ? " " . skipped . " cells are worked out from the step and cannot be cleared." : "") . (res.Done ? "  Ctrl+Z undoes it all." : ""))
}

; @summary Ctrl+X: a range is copied (V33_Copy) and then cleared where it can be (V33_Delete); one cell as before (V29_CutCell).
; @tags clear, copy, grid, hotkey, v33
V33_Cut() {
    live := V33_Live()
    if !live || live.Count < 2
        return V29_CutCell()
    V33_Copy()
    V33_Delete()
}

; ----------------------------------------------------------------------------
; V33 item D: the Excel look (every colour is in V33_Look, so they can be tuned in one place)
; ----------------------------------------------------------------------------

; @summary Every colour of the Excel look, as RGB numbers (0xRRGGBB). on = 0 gives V32's look (light blue range, normal blue
;          selected row, no grey row numbers). Pure.
; @returns Map
; @tags look, colours, v33
V33_Look(on := 1) => on
    ? Map("On", 1, "HeadBg", 0xF3F3F3, "HeadLine", 0xBFBFBF, "HeadText", 0x262626, "RowHead", 0xF3F3F3, "Sel", 0xE3EFE6, "Range", 0xD5E6F7,
          "TabOn", 0xFFFFFF, "TabOff", 0xE6E6E6)
    : Map("On", 0, "HeadBg", 0xF3F3F3, "HeadLine", 0xBFBFBF, "HeadText", 0x000000, "RowHead", 0xFFFFFF, "Sel", 0xFFFFFF, "Range", 0xCCE2F5,
          "TabOn", 0xFFFFFF, "TabOff", 0xE6E6E6)

; @summary RGB (0xRRGGBB) to the COLORREF (0xBBGGRR) that the Windows drawing calls want. Pure.
; @returns Integer
; @tags look, colours, v33
V33_Bgr(rgb) => ((rgb & 0xFF) << 16) | (rgb & 0xFF00) | ((rgb >> 16) & 0xFF)

; @summary The look in COLORREF form, as an object ({On, HeadBg, HeadLine, HeadText, RowHead, Sel, Range, TabOn, TabOff}) for the drawing code.
; @returns Object
; @tags look, colours, v33
V33_LookBgr() {
    m := V33_Look(VMB().ExcelLook ? 1 : 0)
    return {On: m["On"], HeadBg: V33_Bgr(m["HeadBg"]), HeadLine: V33_Bgr(m["HeadLine"]), HeadText: V33_Bgr(m["HeadText"]), RowHead: V33_Bgr(m["RowHead"]),
        Sel: V33_Bgr(m["Sel"]), Range: V33_Bgr(m["Range"]), TabOn: V33_Bgr(m["TabOn"]), TabOff: V33_Bgr(m["TabOff"])}
}

; @summary Reads the V33 ini settings once ([V33] ExcelLook, default 1; 0 gives V32's look).
; @tags look, v33
V33_LoadIni() {
    s := VMB()
    try s.ExcelLook := IniRead(s.Ini, "V33", "ExcelLook", 1) != "0"
    catch
        s.ExcelLook := true
    try s.Freeze := IniRead(s.Ini, "V33", "Freeze", 1) != "0"
    catch
        s.Freeze := true
    s.V33C := V33_LookBgr()
}

; ----------------------------------------------------------------------------
; V33: the same cell ranges on the List sheet and the Values sheet (kind = "list" or "values")
; ----------------------------------------------------------------------------

; @summary Which sheet's grid has the cell ranges now: "list", "values" or "" (the Steps sheet or list view).
; @returns String
; @tags range, sheet, v33
V33_Kind() {
    s := VMB()
    return s.View = "grid" ? (s.Sheet = "list" ? "list" : s.Sheet = "values" ? "values" : "") : ""
}

; @summary The pieces of one sheet: {Kind, LV, Col (current column), Lo, Hi (first / last data column), Range (the stored anchor or 0)}.
; @returns Object
; @tags range, sheet, v33
V33_Sh(kind) {
    s := VMB()
    if kind = "list" {
        list := s.Macro is Map ? V30_ListOf(s.Macro["settings"]) : ""
        return {Kind: kind, LV: s.ListLV, Col: s.ListCol, Lo: 3, Hi: list is Map ? 2 + list["headers"].Length : 2, Range: s.ListRange}
    }
    return {Kind: kind, LV: s.ValLV, Col: s.ValCol, Lo: 1, Hi: 3, Range: s.ValRange}
}

; @summary Stores the anchor of a sheet's range ({AR: row, AC: column}) or 0 for none.
; @tags range, sheet, v33
V33_SetRange(kind, r) {
    s := VMB()
    if kind = "list"
        s.ListRange := r
    else
        s.ValRange := r
}

; @summary Sets the current column of a sheet.
; @tags range, sheet, v33
V33_SetCol(kind, col) {
    s := VMB()
    if kind = "list"
        s.ListCol := col
    else
        s.ValCol := col
}

; @summary The live rectangle of a sheet, like V33_Live: {R1, R2, C1, C2, Keys (column numbers), Cols (Map), Count, Cur, Col, Order, LV, Kind} or 0.
; @returns Object or 0
; @tags range, sheet, v33
V33_SLive(kind) {
    sh := V33_Sh(kind)
    if !sh.LV || sh.Hi < sh.Lo
        return 0
    cur := sh.LV.GetNext(0)
    n := sh.LV.GetCount()
    if !cur || !n
        return 0
    order := []
    Loop sh.Hi - sh.Lo + 1
        order.Push(sh.Lo + A_Index - 1)
    ar := cur, ac := sh.Col
    if IsObject(sh.Range) {
        ar := Min(Max(sh.Range.AR, 1), n)
        ac := sh.Range.AC
    }
    rc := V33_Rect(ar, ac, cur, sh.Col, order)
    if !rc.keys.Length
        rc.keys := [sh.Col]
    cols := Map()
    for k in rc.keys
        cols[k] := 1
    return {Kind: kind, LV: sh.LV, R1: rc.rows[1], R2: rc.rows[2], Keys: rc.keys, Cols: cols, Count: (rc.rows[2] - rc.rows[1] + 1) * rc.keys.Length,
        Cur: cur, Col: sh.Col, Order: order}
}

; @summary The text of one cell of a sheet for the clipboard / summary (tabs and line breaks become a space).
; @returns String
; @tags range, sheet, v33
V33_SText(live, row, col) => V27_TsvCell(live.LV.GetText(row, col))

; @summary Repaints a sheet's grid.
; @tags range, sheet, v33
V33_SRepaint(kind) {
    s := VMB()
    lv := kind = "list" ? s.ListLV : s.ValLV
    if lv
        DllCall("InvalidateRect", "Ptr", lv.Hwnd, "Ptr", 0, "Int", 1)
}

; @summary Can a range action run on this sheet now (editor closed, not recording / playing, a macro loaded)?
; @tags range, sheet, v33
V33_SCan(kind) {
    s := VMB()
    return kind != "" && !VM_IsRecording() && !VM_IsPlaying() && s.Macro is Map && !(kind = "list" ? s.ListEditOn : s.ValEditOn)
}

; @summary The status bar text for a sheet's range (summary + hint). One cell: nothing.
; @tags range, sheet, v33
V33_SStatus(kind) {
    live := V33_SLive(kind)
    if !live || live.Count < 2
        return
    cells := []
    Loop live.R2 - live.R1 + 1 {
        row := live.R1 + A_Index - 1
        for c in live.Keys
            cells.Push(V33_SText(live, row, c))
    }
    VMB_Status(V33_Summary(cells, kind) . "   Ctrl+C copies, Ctrl+V pastes, Ctrl+D fills down, Delete clears.")
}

; @summary Shift+arrows / Ctrl+Shift+arrows on the List or Values sheet: grows the range. dRow / dCol = -1, 0 or 1; edge = go to the sheet's edge.
; @tags range, sheet, hotkey, v33
V33_SExtend(dRow, dCol, edge := false) {
    s := VMB()
    kind := V33_Kind()
    if !V33_SCan(kind)
        return
    sh := V33_Sh(kind), lv := sh.LV
    cur := lv.GetNext(0), n := lv.GetCount()
    if !cur || !n || sh.Hi < sh.Lo
        return
    if !IsObject(sh.Range)
        V33_SetRange(kind, {AR: cur, AC: sh.Col})
    col := sh.Col, row := cur
    if dCol
        col := edge ? (dCol < 0 ? sh.Lo : sh.Hi) : Min(Max(col + dCol, sh.Lo), sh.Hi)
    if dRow
        row := edge ? (dRow < 0 ? 1 : n) : Min(Max(cur + dRow, 1), n)
    V33_SetCol(kind, col)
    if row != cur {
        s.ShSync := true
        try lv.Modify(row, "Select Focus Vis")
        s.ShSync := false
        s.ShLast[kind] := row
    }
    V30_EnsureVisible(row, col, lv)
    V33_SRepaint(kind)
    V33_SStatus(kind)
}

; @summary Ctrl+A on the List or Values sheet: every cell.
; @tags range, sheet, hotkey, v33
V33_SSelectAll() {
    s := VMB()
    kind := V33_Kind()
    if !V33_SCan(kind)
        return
    sh := V33_Sh(kind), lv := sh.LV
    n := lv.GetCount()
    if !n || sh.Hi < sh.Lo
        return
    V33_SetRange(kind, {AR: n, AC: sh.Hi})
    V33_SetCol(kind, sh.Lo)
    s.ShSync := true
    try lv.Modify(1, "Select Focus Vis")
    s.ShSync := false
    s.ShLast[kind] := 1
    V30_EnsureVisible(1, sh.Lo, lv)
    V33_SRepaint(kind)
    V33_SStatus(kind)
}

; @summary A plain arrow (Left / Right) on a sheet: the range ends.
; @tags range, sheet, v33
V33_SCollapse(kind) {
    sh := V33_Sh(kind)
    if IsObject(sh.Range) {
        V33_SetRange(kind, 0)
        V33_SRepaint(kind)
    }
}

; @summary ItemSelect on a sheet's grid: a plain pick ends the range, a Shift pick starts / grows it from the row picked before.
; @tags range, sheet, v33
V33_OnSheetSelect(kind, lv, item, selected) {
    s := VMB()
    if !selected || !item
        return
    prev := s.ShLast.Get(kind, 0)
    s.ShLast[kind] := item
    if s.ShSync
        return
    sh := V33_Sh(kind)
    if GetKeyState("Shift") && prev && !IsObject(sh.Range)
        V33_SetRange(kind, {AR: prev, AC: sh.Col})
    else if !GetKeyState("Shift")
        V33_SetRange(kind, 0)
    V33_SRepaint(kind)
}

; @summary A click on a sheet's cell: Shift+click grows the range to it (the cell that was current is the anchor), a plain click ends it.
;          Call BEFORE the current column is changed (oldCol = the column that was current).
; @tags range, sheet, v33
V33_SClick(kind, row, oldCol) {
    sh := V33_Sh(kind)
    if GetKeyState("Shift") {
        if !IsObject(sh.Range)
            V33_SetRange(kind, {AR: row, AC: oldCol})
    } else
        V33_SetRange(kind, 0)
}

; @summary NM_CUSTOMDRAW of the List / Values grid: shades the cells of the range (light blue), draws the green frame on the current
;          cell and, with the Excel look, keeps the text of the current row black (a light grey-green row instead of dark blue).
; @tags range, sheet, gui, v33
V33_OnSheetDraw(ctl, lParam) {
    s := VMB()
    kind := s.ListLV && ctl.Hwnd = s.ListLV.Hwnd ? "list" : "values"
    stage := NumGet(lParam, 24, "UInt")
    if stage = 1 {
        s.V33S := V33_Kind() = kind ? V33_SLive(kind) : 0
        if !IsObject(s.V33C)
            s.V33C := V33_LookBgr()
        return IsObject(s.V33S) ? 0x20 : 0
    }
    live := s.V33S
    if !IsObject(live)
        return 0
    row := NumGet(lParam, 56, "Ptr") + 1
    isCur := row = live.Cur
    rows := live.Count > 1 && row >= live.R1 && row <= live.R2
    look := s.V33C
    if stage = 0x10001
        return isCur || rows || (look.On && kind = "list") ? 0x20 : 0
    sub := NumGet(lParam, 88, "Int")
    if stage = 0x30001 {
        ret := 0
        if isCur && sub = live.Col - 1
            ret |= 0x10
        if look.On {
            NumPut("UInt", 0xFFFFFF, lParam, 84)
            NumPut("UInt", 0, lParam, 80)
            ret |= 0x2
        }
        if look.On && kind = "list" && sub = 0 {
            NumPut("UInt", look.RowHead, lParam, 84)
            ret |= 0x2
        }
        if isCur && look.On {
            NumPut("UInt", NumGet(lParam, 64, "UInt") & ~1, lParam, 64)       ; not selected-blue: a light grey-green row with black text
            NumPut("UInt", 0, lParam, 80)
            NumPut("UInt", kind = "list" && sub = 0 ? look.RowHead : look.Sel, lParam, 84)
            ret |= 0x2
        }
        if rows && live.Cols.Has(sub + 1) && (!isCur || look.On) {
            NumPut("UInt", look.Range, lParam, 84)
            if isCur {
                NumPut("UInt", NumGet(lParam, 64, "UInt") & ~1, lParam, 64)
                NumPut("UInt", 0, lParam, 80)
            }
            ret |= 0x2
        }
        return ret
    }
    if stage = 0x30002 && isCur && sub = live.Col - 1 {
        p := V29_CursorRect(row, sub + 1, live.LV)
        if IsObject(p)
            V29_DrawFrame(NumGet(lParam, 32, "Ptr"), p)
    }
    return 0
}

; @summary Ctrl+C on a sheet: the range as tab / line separated text; one cell as before.
; @tags range, sheet, copy, hotkey, v33
V33_SCopy(kind) {
    live := V33_SLive(kind)
    if !live || live.Count < 2
        return kind = "list" ? V30_CopyCell() : V31_ValCopyCell()
    lines := []
    Loop live.R2 - live.R1 + 1 {
        row := live.R1 + A_Index - 1
        parts := []
        for c in live.Keys
            parts.Push(V33_SText(live, row, c))
        lines.Push(V4_Join(parts, "`t"))
    }
    A_Clipboard := V4_Join(lines, "`r`n")
    VMB_Status("Copied " . live.Count . " cells.   Ctrl+V pastes them here or in Excel.")
}

; @summary Writes cells into the List as ONE undo step (Ctrl+Z on the List sheet): cells = [{Row, Col, Text}] (sheet row = list row, Col = sheet
;          column), newRows = rows to add first (blank, up to the list's limit). Returns {Done, Refused, Grown}. Nothing changes (and no undo step
;          is made) when every cell already holds its text.
; @returns Object
; @tags paste, list, v33
V33_ListApply(cells, newRows := 0) {
    s := VMB()
    res := {Done: 0, Refused: 0, Grown: 0}
    list := V30_ListOf(s.Macro["settings"])
    if !(list is Map)
        return res
    w := list["headers"].Length
    rows := list["rows"]
    todo := []
    maxPos := rows.Length
    for c in cells {
        if c.Col < 3 || c.Col - 2 > w || c.Row < 1 || c.Row > V30_MaxRows() {
            res.Refused += 1
            continue
        }
        maxPos := Max(maxPos, c.Row)
        todo.Push(c)
    }
    if !todo.Length
        return res
    changed := maxPos > rows.Length
    for c in todo
        if c.Row <= rows.Length && rows[c.Row][c.Col - 2] !== c.Text
            changed := true
    if changed
        V30_ListPush()
    while rows.Length < maxPos {
        blank := []
        Loop w
            blank.Push("")
        rows.Push(blank)
        res.Grown += 1
    }
    for c in todo {
        rows[c.Row][c.Col - 2] := c.Text
        res.Done += 1
    }
    if changed {
        s.Dirty := true
        V30_ListChanged()
    }
    return res
}

; @summary Writes cells into the Values as ONE undo step (Ctrl+Z on the Values sheet). Only the Value and When columns take part (a name is
;          never renamed by a paste). cells = [{Row, Col, Text}]. A text that does not fit is skipped and counted. Returns {Done, Refused, Error}.
; @returns Object
; @tags paste, values, v33
V33_ValApply(cells) {
    s := VMB()
    res := {Done: 0, Refused: 0, Error: ""}
    st := s.Macro["settings"]
    pushed := false
    for c in cells {
        if c.Col < 2 {
            res.Refused += 1
            if res.Error = ""
                res.Error := "A name is not changed by a paste. Type it in the cell."
            continue
        }
        plan := V31_EditValue(st, c.Row, c.Col, c.Text)
        if !plan.Ok {
            res.Refused += 1
            if res.Error = ""
                res.Error := plan.Error
            continue
        }
        res.Done += 1
        old := V31_ValuesOf(st)[c.Row]
        if old["name"] == plan.Item["name"] && old["value"] == plan.Item["value"] && old.Get("when", "fixed") == plan.Item.Get("when", "fixed")
            continue
        if !pushed {
            V31_ValPush()
            pushed := true
        }
        st["values"][c.Row] := plan.Item
    }
    if pushed
        V31_ValChanged()
    return res
}

; @summary Puts the range back after a refill: anchor row / column and the current cell.
; @tags range, sheet, v33
V33_SRestore(kind, r1, c1, r2, c2) {
    s := VMB()
    sh := V33_Sh(kind), lv := sh.LV
    n := lv.GetCount()
    if !n
        return
    r1 := Min(r1, n), r2 := Min(r2, n)
    V33_SetRange(kind, r1 = r2 && c1 = c2 ? 0 : {AR: r1, AC: c1})
    V33_SetCol(kind, c2)
    s.ShSync := true
    try lv.Modify(r2, "Select Focus Vis")
    s.ShSync := false
    s.ShLast[kind] := r2
    V33_SRepaint(kind)
}

; @summary Ctrl+V on a sheet. An empty List: the old "paste the whole list" (V30_PasteList). Otherwise the clipboard block goes in from the
;          current cell (a single value onto the whole range), cell by cell, one undo step; on the List sheet it adds rows below the last one.
; @tags paste, sheet, hotkey, v33
V33_SPaste(kind) {
    s := VMB()
    if !V33_SCan(kind)
        return
    if kind = "list" {
        list := V30_ListOf(s.Macro["settings"])
        if !(list is Map) || !list["rows"].Length
            return V30_PasteList()
    }
    live := V33_SLive(kind)
    if !live {
        VMB_Status(kind = "list" ? "Select a cell first, or use Paste list." : "Select a cell first.")
        return
    }
    block := V33_ParseBlock(A_Clipboard)
    if !block.Length
        return VMB_Status("The clipboard has no text to paste.")
    n := live.LV.GetCount()
    plan := V33_PlanPaste(block, {rows: [live.R1, live.R2], keys: live.Keys}, live.Order, n, kind = "list")
    if !plan.Cells.Length
        return VMB_Status("Nothing to paste here: the block does not fit from this cell.")
    cells := []
    for c in plan.Cells
        cells.Push({Row: c.Row, Col: c.Key, Text: c.Text})
    first := cells[1], last := cells[cells.Length]
    res := kind = "list" ? V33_ListApply(cells, plan.NewRows) : V33_ValApply(cells)
    extra := kind = "list" && res.Grown ? " " . res.Grown . (res.Grown = 1 ? " row was" : " rows were") . " added." : ""
    VMB_Status(V33_DoneText("Pasted", res.Done, res.Refused, plan.Dropped) . extra . (res.Done ? "  Ctrl+Z undoes it all." : "")
        . (kind = "values" && res.Done = 0 && res.Error != "" ? "  " . res.Error : ""))
    if res.Done
        V33_SRestore(kind, first.Row, first.Col, last.Row, last.Col)
}

; @summary Delete on a sheet: one cell as before; a range: every cell is emptied (Values: only the Value column), one undo step.
; @tags range, sheet, clear, hotkey, v33
V33_SDelete(kind) {
    live := V33_SLive(kind)
    if !live || live.Count < 2
        return kind = "list" ? V30_ClearCell() : V31_ValClearCell()
    if !V33_SCan(kind)
        return
    cells := []
    skipped := 0
    Loop live.R2 - live.R1 + 1 {
        row := live.R1 + A_Index - 1
        for c in live.Keys {
            if kind = "values" && c != 2 {
                skipped += 1
                continue
            }
            cells.Push({Row: row, Col: c, Text: ""})
        }
    }
    res := kind = "list" ? V33_ListApply(cells) : V33_ValApply(cells)
    VMB_Status(V33_DoneText("Cleared", res.Done, res.Refused) . (skipped ? " Only a Value can be emptied on this sheet." : "") . (res.Done ? "  Ctrl+Z undoes it all." : ""))
    V33_SRestore(kind, live.R1, live.Keys[1], live.R2, live.Keys[live.Keys.Length])
}

; @summary Ctrl+X on a sheet: copy the range, then empty it.
; @tags range, sheet, clear, hotkey, v33
V33_SCut(kind) {
    live := V33_SLive(kind)
    if !live || live.Count < 2
        return
    V33_SCopy(kind)
    V33_SDelete(kind)
}

; @summary Ctrl+D / Ctrl+R on a sheet: the top / left cell of the range goes into the rest of it, one undo step. One cell selected: nothing
;          (select the cell to copy and the cells to fill).
; @tags range, sheet, fill, hotkey, v33
V33_SFill(kind, dir) {
    live := V33_SLive(kind)
    if !live || !V33_SCan(kind)
        return
    if live.Count < 2 || (dir = "down" && live.R1 = live.R2) || (dir = "right" && live.Keys.Length < 2)
        return VMB_Status(dir = "down" ? "Fill down needs two or more rows: select the cell to copy and the cells below it."
            : "Fill right needs two or more columns: select the cell to copy and the cells to its right.")
    plan := V33_PlanFill({rows: [live.R1, live.R2], keys: live.Keys}, dir)
    cells := []
    for c in plan.Cells
        cells.Push({Row: c.Row, Col: c.Key, Text: live.LV.GetText(c.SrcRow, c.SrcKey)})
    res := kind = "list" ? V33_ListApply(cells) : V33_ValApply(cells)
    VMB_Status(V33_DoneText(dir = "down" ? "Filled down" : "Filled right", res.Done, res.Refused) . (res.Done ? "  Ctrl+Z undoes it all." : ""))
    V33_SRestore(kind, live.R1, live.Keys[1], live.R2, live.Keys[live.Keys.Length])
}

; @summary The sheet tabs (Steps / List / Values): the active one is bold, the others normal (native buttons cannot be coloured white / grey,
;          so the weight is what shows which sheet is on). Safe before the tabs exist. Only with the Excel look.
; @tags look, tabs, v33
V33_StyleTabs() {
    s := VMB()
    if !(s.SheetTabs is Map) || !s.ExcelLook
        return
    for name, sheet in Map("Steps", "steps", "List", "list", "Values", "values")
        if s.SheetTabs.Has(name)
            try s.SheetTabs[name].SetFont(s.Sheet = sheet ? "bold" : "norm")
}

; @summary WM_NOTIFY monitor: the column headings of the Steps / List / Values grids are painted light grey with a thin bottom line
;          (header NM_CUSTOMDRAW, which the list forwards to its window). Only with the Excel look. Returns nothing for any other
;          notification, so everything else is handled as before.
; @tags look, header, gui, v33
V33_OnWmNotify(wParam, lParam, msg, hwnd) {
    static hdrs := 0
    if NumGet(lParam, 2 * A_PtrSize, "Int") != -12
        return
    s := VMB()
    if !s.ExcelLook || !s.GridLV
        return
    if !IsObject(hdrs) {
        hdrs := Map()
        for lv in [s.GridLV, s.ListLV, s.ValLV, s.GridFreeze]
            if lv
                try hdrs[SendMessage(0x101F, 0, 0, lv)] := lv                  ; LVM_GETHEADER
    }
    from := NumGet(lParam, 0, "Ptr")
    if !hdrs.Has(from) {
        if DllCall("GetClassNameW", "Ptr", from, "Ptr", cls := Buffer(80, 0), "Int", 40) && StrGet(cls) = "SysHeader32" {      ; a heading list made after the map (the frozen pane's)
            for lv in [s.GridLV, s.ListLV, s.ValLV, s.GridFreeze]
                if lv
                    try hdrs[SendMessage(0x101F, 0, 0, lv)] := lv
        }
        if !hdrs.Has(from)
            return
    }
    stage := NumGet(lParam, 24, "UInt")
    if stage = 1
        return 0x20                                                            ; CDRF_NOTIFYITEMDRAW
    if stage != 0x10001
        return
    look := IsObject(s.V33C) ? s.V33C : V33_LookBgr()
    hdc := NumGet(lParam, 32, "Ptr")
    L := NumGet(lParam, 40, "Int"), T := NumGet(lParam, 44, "Int"), R := NumGet(lParam, 48, "Int"), B := NumGet(lParam, 52, "Int")
    idx := NumGet(lParam, 56, "Ptr")
    rc := Buffer(16, 0)
    NumPut("Int", L, "Int", T, "Int", R, "Int", B, rc)
    brush := DllCall("CreateSolidBrush", "UInt", look.HeadBg, "Ptr")
    DllCall("FillRect", "Ptr", hdc, "Ptr", rc, "Ptr", brush)
    DllCall("DeleteObject", "Ptr", brush)
    line := DllCall("CreateSolidBrush", "UInt", look.HeadLine, "Ptr")
    NumPut("Int", L, "Int", B - 1, "Int", R, "Int", B, rc)
    DllCall("FillRect", "Ptr", hdc, "Ptr", rc, "Ptr", line)                    ; the thin bottom line
    sep := DllCall("CreateSolidBrush", "UInt", 0xD9D9D9, "Ptr")
    NumPut("Int", R - 1, "Int", T + 2, "Int", R, "Int", B - 2, rc)
    DllCall("FillRect", "Ptr", hdc, "Ptr", rc, "Ptr", sep)                     ; a faint divider between two headings
    DllCall("DeleteObject", "Ptr", line)
    DllCall("DeleteObject", "Ptr", sep)
    buf := Buffer(1024, 0)
    hdi := Buffer(72, 0)
    NumPut("UInt", 0x2, hdi, 0)                                                ; HDI_TEXT
    NumPut("Ptr", buf.Ptr, hdi, 8)
    NumPut("Int", 500, hdi, 24)
    SendMessage(0x120B, idx, hdi.Ptr, from)                                    ; HDM_GETITEMW
    font := SendMessage(0x31, 0, 0, from)                                      ; WM_GETFONT
    old := font ? DllCall("SelectObject", "Ptr", hdc, "Ptr", font, "Ptr") : 0
    DllCall("SetBkMode", "Ptr", hdc, "Int", 1)
    DllCall("SetTextColor", "Ptr", hdc, "UInt", look.HeadText)
    NumPut("Int", L + 6, "Int", T, "Int", R - 4, "Int", B - 1, rc)
    DllCall("DrawTextW", "Ptr", hdc, "Ptr", buf.Ptr, "Int", -1, "Ptr", rc, "UInt", 0x8824)     ; left, vcentre, one line, ellipsis, no & underline
    if old
        DllCall("SelectObject", "Ptr", hdc, "Ptr", old)
    return 0x4                                                                 ; CDRF_SKIPDEFAULT
}

; ----------------------------------------------------------------------------
; V33 item C: frozen first columns. When the grid is scrolled right so that the # column is off screen, a narrow second list
;   (s.GridFreeze, a mirror: # and Action, same rows) sits at the grid's left edge and follows the grid's vertical scroll and selection.
;   A timer (120 ms) keeps it in step; it is not in s.Ctl.
; ----------------------------------------------------------------------------

; @summary Builds the frozen pane (hidden) and starts its timer. Called from V30_Build.
; @tags freeze, grid, gui, v33
V33_BuildFreeze(g) {
    s := VMB()
    s.GridFreeze := g.AddListView("x10 y40 w200 h300 Grid -Multi -E0x200 +LV0x10000 Hidden", ["#", "Action"])
    s.GridFreeze.OnEvent("Click", V33_OnFreezeClick)
    s.GridFreeze.OnNotify(-12, V33_OnFreezeDraw)
    V33_ApplyFreezeFont()
    OnMessage(0x20A, V33_OnWmWheel)                            ; the wheel over the pane scrolls the grid
    SetTimer(V33_FreezeTick, 120)
}

; @summary The pane uses the grid's font (same row height, so the rows line up).
; @tags freeze, grid, gui, v33
V33_ApplyFreezeFont() {
    s := VMB()
    if !s.GridFreeze
        return
    s.GridFreeze.SetFont("s" . V29_ZoomFont(9, s.GridZoom), "MS Shell Dlg 2")
    s.GridFreeze.SetFont(, "Segoe UI")
}

; @summary The right-click menu entry "Freeze # and Action": turns the pane on / off (kept in the ini).
; @tags freeze, grid, v33
V33_ToggleFreeze(*) {
    s := VMB()
    s.Freeze := !s.Freeze
    try IniWrite(s.Freeze ? 1 : 0, s.Ini, "V33", "Freeze")
    V33_FreezeTick(true)
    VMB_Status(s.Freeze ? "# and Action stay in view when the grid is scrolled sideways." : "The # and Action columns scroll with the rest.")
}

; @summary Is the # column completely scrolled out of view on the left? (False with no rows, or a hidden # column.)
; @returns Boolean
; @tags freeze, grid, v33
V33_HashOff() {
    s := VMB()
    if !s.GridLV || s.GridLV.GetCount() < 1
        return false
    p := V29_CursorRect(1, V33_ColOf("num"))
    return IsObject(p) && p.R <= 0
}

; @summary Should the pane show now? Pure rule: on in the ini, Steps grid, rows, the # column scrolled off, the cell editor closed.
; @returns Boolean
; @tags freeze, v33
V33_FreezeWanted(on, gridView, steps, rows, hashOff, editing, width) => on && gridView && steps && rows > 0 && hashOff && !editing && width > 0

; @summary Called by the timer (and after a refill / layout): shows, places, fills and syncs the pane, or hides it.
; @tags freeze, grid, gui, v33
V33_FreezeTick(force := false) {
    s := VMB()
    fz := s.GridFreeze
    if !fz || !s.GridLV || !s.Gui
        return
    try {
        iNum := V33_ColOf("num"), iAct := V33_ColOf("action")
        wNum := SendMessage(0x101D, iNum - 1, 0, s.GridLV), wAct := SendMessage(0x101D, iAct - 1, 0, s.GridLV)
        vis := DllCall("IsWindowVisible", "Ptr", s.GridLV.Hwnd) && s.View = "grid" && s.Sheet = "steps"
        want := vis && V33_FreezeWanted(s.Freeze, true, true, s.GridLV.GetCount(), V33_HashOff(), s.CellOn, wNum + wAct)
        if !want {
            if s.FrzShown {
                fz.Visible := false
                s.FrzShown := false
            }
            return
        }
        f := 96 / A_ScreenDPI
        cl := Buffer(16, 0)
        DllCall("GetClientRect", "Ptr", s.GridLV.Hwnd, "Ptr", cl)
        pt := Buffer(8, 0)
        DllCall("MapWindowPoints", "Ptr", s.GridLV.Hwnd, "Ptr", s.Gui.Hwnd, "Ptr", pt, "UInt", 1)
        x := Round(NumGet(pt, 0, "Int") * f), y := Round(NumGet(pt, 4, "Int") * f)
        w := Max(10, Round((wNum + wAct) * f)), h := Max(20, Round(NumGet(cl, 12, "Int") * f))
        sig := x . "," . y . "," . w . "," . h . "," . wNum . "," . wAct
        if sig != s.FrzSig || force || !s.FrzShown {
            s.FrzSig := sig
            fz.Move(x, y, w, h)
            if SendMessage(0x101D, 0, 0, fz) != wNum
                fz.ModifyCol(1, wNum)
            if SendMessage(0x101D, 1, 0, fz) != wAct
                fz.ModifyCol(2, wAct)
        }
        if s.FrzDirty || fz.GetCount() != s.GridLV.GetCount() {
            V33_FreezeFill(iNum, iAct, wNum, wAct)
            s.FrzDirty := false
        }
        if !s.FrzShown {
            fz.Visible := true
            DllCall("SetWindowPos", "Ptr", fz.Hwnd, "Ptr", 0, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x13)      ; on top of the grid, no move / size / activate
            s.FrzShown := true
        }
        DllCall("ShowScrollBar", "Ptr", fz.Hwnd, "Int", 3, "Int", 0)                     ; the pane has no scroll bars: the grid scrolls it
        V33_FreezeSync()
    } catch as e {
        s.FrzErr := e.Message
    }
}

; @summary Fills the pane with the grid's # and Action texts (the same rows, the same order) and sets its two column widths.
; @tags freeze, grid, gui, v33
V33_FreezeFill(iNum, iAct, wNum, wAct) {
    s := VMB()
    fz := s.GridFreeze
    fz.Opt("-Redraw")
    fz.Delete()
    Loop s.GridLV.GetCount()
        fz.Add("", s.GridLV.GetText(A_Index, iNum), s.GridLV.GetText(A_Index, iAct))
    fz.ModifyCol(1, wNum)
    fz.ModifyCol(2, wAct)
    fz.Opt("+Redraw")
    s.FrzSel := 0
}

; @summary Puts the pane's first visible row and selected row where the grid's are (same top index; the row height is read from the list).
; @tags freeze, grid, v33
V33_FreezeSync() {
    s := VMB()
    fz := s.GridFreeze
    sel := s.GridLV.GetNext(0)
    if sel != s.FrzSel || fz.GetNext(0) != sel {
        s.FrzSync := true
        try {
            if sel
                fz.Modify(sel, "Select")
            else
                fz.Modify(0, "-Select")
        }
        s.FrzSync := false
        s.FrzSel := sel
    }
    top := SendMessage(0x1027, 0, 0, s.GridLV)                   ; LVM_GETTOPINDEX
    ftop := SendMessage(0x1027, 0, 0, fz)
    if top != ftop {
        rc := Buffer(16, 0)
        NumPut("Int", 0, rc)                                       ; LVIR_BOUNDS
        if SendMessage(0x100E, 0, rc.Ptr, fz)                      ; LVM_GETITEMRECT of item 0: its height is the row height
            SendMessage(0x1014, 0, (top - ftop) * (NumGet(rc, 12, "Int") - NumGet(rc, 4, "Int")), fz)      ; LVM_SCROLL
    }
}

; @summary A click on a row of the pane: the same row is selected in the grid (and the clicked column becomes the current cell); the grid gets the keyboard.
; @tags freeze, grid, gui, v33
V33_OnFreezeClick(lv, row) {
    s := VMB()
    if !row || row > s.GridLV.GetCount()
        return
    hit := V30_HitCell(lv)
    if hit.Row = row && hit.Col >= 1 && hit.Col <= 2
        s.GridCol := hit.Col = 1 ? V33_ColOf("num") : V33_ColOf("action")
    s.GridRange := 0
    try s.GridLV.Modify(row, "Select Focus Vis")
    V27_OnSelect(s.GridLV, row, true)
    s.GridLV.Focus()
    V33_Repaint()
    V28_CellStatus(row)
}

; @summary WM_MOUSEWHEEL over the pane: forwarded to the grid (the pane has no scroll bars).
; @tags freeze, grid, v33
V33_OnWmWheel(wParam, lParam, msg, hwnd) {
    s := VMB()
    if s.GridFreeze && s.GridLV && hwnd = s.GridFreeze.Hwnd {
        PostMessage(0x20A, wParam, lParam, , "ahk_id " . s.GridLV.Hwnd)
        return 0
    }
}

; @summary NM_CUSTOMDRAW of the pane: with the Excel look the # column is grey and the selected row light grey-green, like the grid.
; @tags freeze, grid, gui, v33
V33_OnFreezeDraw(ctl, lParam) {
    s := VMB()
    look := IsObject(s.V33C) ? s.V33C : V33_LookBgr()
    if !look.On
        return 0
    stage := NumGet(lParam, 24, "UInt")
    if stage = 1 || stage = 0x10001
        return 0x20
    if stage = 0x30001 {
        row := NumGet(lParam, 56, "Ptr") + 1
        sub := NumGet(lParam, 88, "Int")
        NumPut("UInt", 0, lParam, 80)
        NumPut("UInt", sub = 0 ? look.RowHead : 0xFFFFFF, lParam, 84)
        if row = s.GridLV.GetNext(0) {
            NumPut("UInt", NumGet(lParam, 64, "UInt") & ~1, lParam, 64)
            NumPut("UInt", sub = 0 ? look.RowHead : look.Sel, lParam, 84)
        }
        return 0x2
    }
    return 0
}

; ==== V33 END (new V33 functions are added above this line)


; ============================================================================
; V4 STARTUP / SINGLE-FILE PLAYER EXPORT
; ============================================================================
; <V4_EMBEDDED_MACRO>
V4_Embedded() {
    return ""
}
; </V4_EMBEDDED_MACRO>
V4_Start(*) {
    if A_Args.Length && A_Args[1] = "--qa"
        return
    if A_Args.Length && A_Args[1] = "--self-test" {
        V4_SelfTest(A_Args.Length > 1 ? A_Args[2] : A_ScriptDir . "\V10-self-test.txt")
        return
    }
    encoded := V4_Embedded()
    if encoded != "" {
        OnExit(VMB_OnExit)
        try {
            raw := V4_Unbase64(encoded)
            macro := JSON.Parse(StrGet(raw, raw.Size, "UTF-8"))
            if MsgBox("Run the exported macro '" . macro.Get("name", "Untitled") . "'?"
                . "`n`nOnly run macros you trust. Esc requests stop; Ctrl+Shift+X exits immediately.",
                "Visual Macro Blocks V10 player", "YesNo Icon?") != "Yes"
                ExitApp()
            options := {}
            data := macro["settings"].Get("data", "")
            if data is Map && data.Get("path", "") != "" && !VMF_DataPickBlock(macro["blocks"]) {
                options.Data := VM_LoadData(data["path"], data.Get("header", "auto"))
                options.FirstRow := Max(1, data.Get("firstRow", 1))
                options.LastRow := data.Get("lastRow", 0)
            }
            built := V30_BuildRun(macro)                    ; V30: a macro saved with Run = for each row / times plays the same way here
            if !built.Ok
                throw Error(built.Error)
            if built.Mode = "list" {
                options.Data := V30_ListData(macro["settings"])
                options.FirstRow := 1, options.LastRow := 0
            }
            macro := built.Macro
            result := VM_Play(macro, options)
            MsgBox(result.Message . (result.Warnings.Length ? "`n`nNotes:`n" . V4_Join(result.Warnings, "`n") : ""),
                "V10 player", result.Ok ? "Iconi" : "Icon!")
            ExitApp(result.Ok ? 0 : 1)
        } catch as err {
            MsgBox(err.Message, "V10 player error", "Iconx")
            ExitApp(1)
        }
    }
    VMB_Main()
}
V4_PlayerSource(source, macro) {
    text := JSON.Stringify(macro)
    raw := V4_Utf8(text)
    raw.Size -= 1
    encoded := V4_Base64(raw)
    replacement := "; <V4_EMBEDDED_MACRO>`nV4_Embedded() {`n    text := `"`"`n"
    pos := 1
    while pos <= StrLen(encoded) {
        replacement .= "    text .= `"" . SubStr(encoded, pos, 960) . "`"`n"
        pos += 960
    }
    replacement .= "    return text`n}`n; </V4_EMBEDDED_MACRO>"
    ; Match only the marker at the beginning of a line, not the string above.
    source := RegExReplace(source, "ms)^; <V4_EMBEDDED_MACRO>.*?^; </V4_EMBEDDED_MACRO>", replacement, &count, 1)
    if count != 1
        throw Error("The source's V4 embedded-macro marker was not found.")
    return source
}
V4_ExportPlayer(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    VMB_ControlsToSettings()
    if !s.Macro["blocks"].Length
        return VMB_Status("Add some blocks first.")
    errors := VM_Validate(s.Macro)
    if errors.Length {
        MsgBox(V4_Join(errors, "`n"), "Fix these blocks before exporting", "Icon!")
        return
    }
    if !VMB_PrivacyCheck()
        return
    if VMB__CountCalls(s.Macro["blocks"]) && MsgBox("Run another macro blocks still reference external macro files."
        . "`nThose files are not bundled. Continue?", "Export player", "YesNo Icon!") != "Yes"
        return
    safe := RegExReplace(s.Macro.Get("name", "") = "" ? "macro" : s.Macro["name"], '[\\/:*?"<>|\r\n]', "_")
    out := FileSelect("S16", s.Dir . "\export\" . safe . "-player-V10.ahk", "Export V10 player and identical TXT", "AutoHotkey (*.ahk)")
    if out = ""
        return
    base := RegExReplace(out, "i)\.(ahk|txt)$")
    if !RegExMatch(base, "i)V10$")
        base .= "-V10"
    try {
        text := V4_PlayerSource(FileRead(A_ScriptFullPath, "UTF-8"), s.Macro)
        if FileExist(base . ".txt") && MsgBox("Replace the existing matching TXT file?"
            . "`n" . base . ".txt", "Export", "YesNo Icon?") != "Yes"
            return
        V4_Write(base . ".ahk", text)
        V4_Write(base . ".txt", text)
        VMB_Status("Exported one-file player and identical TXT: " . base)
        MsgBox("Exported:`n" . base . ".ahk`n" . base . ".txt"
            . "`n`nBoth contain the same source. AutoHotkey v2 and the target applications must be installed.",
            "V10 export complete", "Iconi")
    } catch as err
        MsgBox(err.Message, "V10 export failed", "Iconx")
}
V4_Help(*) {
    MsgBox("NEW IN V33 (more Excel: blocks of cells):"
        . "`n• Select several cells: Shift+arrows or Shift+click; Ctrl+Shift+arrow goes to the edge, Ctrl+A selects every cell. A plain arrow or click goes back to one cell."
        . " The status bar says how many cells, and for Waits first the total time (on the List sheet the sum of numbers)."
        . "`n• Ctrl+C copies the block as text (Excel can paste it). Ctrl+V pastes a block from the current cell, or one value onto the whole selection, cell by cell;"
        . " cells that cannot take a value are skipped and counted. Ctrl+D fills down, Ctrl+R fills right, Delete clears the cells that can be cleared. One Ctrl+Z undoes it all."
        . " On the List sheet a paste below the last row adds rows (an empty List still pastes the whole list as before)."
        . "`n• The # and Action columns stay at the left when you scroll sideways (right-click a column title: Freeze # and Action). Grey headings and row numbers like Excel"
        . " (ini [V33] ExcelLook=0 brings the old look back). After Ctrl+Z the same row is selected again."
        . "`n`n"
        . "NEW IN V32 (rows like Excel):"
        . "`n• Click a row, then Alt+Up / Alt+Down moves it, Shift+Delete deletes it (asked once), Ctrl+Shift+plus adds a Type step below, Ctrl+Shift+D duplicates it."
        . " Shift+Up / Shift+Down (or Shift+click) pick several rows; the keys then work on all of them. Right-click a row for the same things. Ctrl+Z undoes each one."
        . " Rows only move in step order: with a sort or filter on, press Step order / Clear first."
        . "`n• Click the small arrow at the right of a column title to tick the values to show (Excel's filter arrow). Several columns work together. Clear removes them all."
        . "`n• Ctrl+F finds text in the Steps, List or Values sheet: Enter / F3 next, Shift+F3 previous, Esc closes. It moves the cell cursor and never hides rows."
        . "`n• A loop or If block made in List view shows as a shaded band row, its steps indented under it."
        . "`n`n"
        . "NEW IN V31.1 (Values): the Values tab (next to Steps and List) holds names you can use as =name in a Type step or in an Only when rule."
        . " When = fixed / ask at start (one small form before step 1; Cancel stops the run) / today's date (Value = the format, MM/dd/yyyy) / counts up (starts at Value, +1 each round)."
        . " Right-click a row -> Add step -> Remember clipboard as...: Remember clipboard as total, or Remember " . Chr(34) . "text" . Chr(34) . " as total."
        . "`n`nNEW IN V31 (rules as columns):"
        . "`n• Only when: a rule such as  Status = On  or  Amount > 100  does a step only for some rows. otherwise (or otherwise, Amount > 50) on the next"
        . " steps = the other rows. Right-click the cell to build a rule by picking. If it fails: stop / skip this step / skip this row / try 3 times."
        . "`n• Right-click a row -> Add step: Type text, Press keys, Wait, Wait until window, Skip this row, Stop the run. A list run stops after 3 bad rows in a row."
        . "`n• The Blocks toolbox is plain like the step list (right-click the list -> Coloured rows for colours)."
        . "`n`nNEW IN V30 (a List sheet and a Run switch instead of loop blocks):"
        . "`n• Steps sheet = what to do once. List sheet = the things to do it for. Paste your items from Excel (Ctrl+V on the List sheet),"
        . "  say Yes to use the list columns (a Type step then types =Name), choose 'for each row of the List' above the grid and press Play."
        . "`n• A Type text cell can be =Name (a list column) or =# (the round number). Right-click it -> Use list column. Inside longer text write {{Name}}."
        . "`n• Run: once / for each row of the List / N times. The Repeats column: 'once at start' steps (the first window steps) run once, the rest repeat."
        . "  Preview row shows what each =Column cell types. The saved macro never gets loop blocks."
        . "`n`nNEW IN V29 (the grid feels like Excel):"
        . "`n• Zoom: Ctrl + mouse wheel over the grid, Ctrl + plus / minus, Ctrl + 0 (back to 100 %), or the - 100 % + at the right end of"
        . "  the filter row (click the percent to reset). The list keeps its own A+ / A- size."
        . "`n• A green frame marks the current cell. Click a cell or use the arrow keys; Home / End go to the first / last column,"
        . "  Ctrl+Home / Ctrl+End to the first / last cell, Tab / Shift+Tab one cell right / left. The box left of the filter names the cell."
        . "`n• Ctrl+C copies the current cell, Ctrl+V pastes the clipboard text into it (same rules as typing it; Ctrl+Z undoes it),"
        . "  Ctrl+X cuts a Note or Waits cell. Shift+Ctrl+C copies the whole row. Copy table is unchanged."
        . "`n• Drag a column title to move the column. Right-click a title to tick / untick columns (hide / show) or Reset columns."
        . "  Widths, order, hidden columns and zoom are remembered."
        . "`n`nNEW IN V28 (edit cells in the grid):"
        . "`n• Double-click a cell, or press F2 / Enter on it, or just start typing: a small box opens on the cell. Enter saves and moves"
        . "  down, Tab saves and goes to the next cell you can change (Shift+Tab goes back), Esc cancels, clicking elsewhere saves."
        . "  Left / Right choose the column when you use the keyboard. Every change can be undone with Ctrl+Z."
        . "`n• You can edit: Text / keys (a Press step shows its raw keys, like ^{a}), Button, Clicks, Held keys, X, Y, Waits first"
        . "  (2, 2s, 500ms or auto; a number below 30 means seconds), Scroll back (a row number, or no), Window size (800 x 600 or maximized),"
        . "  On and Note. The other cells are worked out from the step: F2 says so, and double-click opens the full Edit box."
        . "`n• Delete clears a Note or Waits cell. Ctrl+D copies the cell above into this one."
        . "`n`nNEW IN V27 (the step grid):"
        . "`n• The [List] [Grid] buttons above the steps switch between the tree and a table: one row per step, every detail in"
        . "  its own cell. A dash (–) means the column does not apply to that step. The grid is only a view: select a row and use"
        . "  Edit, Delete, Move up / down as usual; double-click a row edits it; right-click shows the same menu as the list."
        . "`n• Click a column title to sort (a view only: the steps still run in # order). The filter box and the Program / Action"
        . "  lists above the grid show fewer rows (try  program:notepad ). Copy table puts the table on the clipboard for Excel;"
        . "  Shift+Ctrl+C copies the selected row (Ctrl+C copies the current cell)."
        . "`n`nNEW IN V22 (step list in columns):"
        . "`n• Every step row has fixed columns:  #   Program   Waits   Marks   What it does. The Program column is filled on"
        . "  every row (a Wait step shows the program of the step before it)."
        . "`n• Waits = the pause before the step. A * after the time (500 ms*) = a wait you set by hand."
        . "`n• Marks: ► the task moves to another program here, ↕ the list is scrolled back first, ⚡ changes each round,"
        . "  ◇ uses whatever window is active, ✎ has your note, ⚠ had a note in the last run, ≈ often shaky (a note in 3 or more of"
        . "  the last 10 runs - check this step)."
        . "`n• Right-click the list -> Show columns (or the Columns tick box in the Step settings panel) for the V21 lines."
        . "`n`nNEW IN V21 (a step list you can read at a glance):"
        . "`n• The program is named only where the task moves to another one:  Type `"5`" → in calc."
        . "`n• Web, basic-input and measuring steps read as sentences too (Web: click `"submit`"), and so do REPEAT, FOR, IF,"
        . "  SET and the other blocks (Repeat 5 times  (4 steps inside), If amount is 250)."
        . "`n• After a run, the steps that had a note are marked ⚠ with the note at the end of the line, so you do not have to"
        . "  open the log. The marks go away when you change the macro."
        . "`n• Steady playback: if a window's saved spot is off every screen (another monitor layout), it is put on the main"
        . "  screen instead, with a note."
        . "`n`nNEW IN V20 (step lines you can read at a glance):"
        . "`n• Each step is one plain sentence: Click the `"OK`" button in notepad — bottom-right (410, 300). Tags show a long pause,"
        . "  a list that is scrolled back first, or your note. Untick 'Explain steps' in the Step settings panel for the old lines."
        . "`n• New recordings remember what was clicked: a button's caption, a menu item's text, or just 'a text box' / 'a list'."
        . "  Text inside boxes, lists and labels is never saved."
        . "`n`nNEW IN V19 (window size + scroll):"
        . "`n• Lists and pages are scrolled back to where they were when you recorded, before each click (standard Windows lists"
        . "  and boxes only - not web pages, Citrix or Remote Desktop). For those, start each run from the same screen and scroll"
        . "  with the keyboard (Ctrl+Home, PgDn) while recording, because key presses replay the same way every time."
        . "`n`nNEW IN V18 (one-click Record + Steady playback):"
        . "`n• Record on an empty macro needs no window pick: the first program you use becomes the Macro window (step #1 normalizes it)."
        . "`n• Click the red REC bar to stop. The recording notice appears the first time only. Clicks on the editor are never recorded."
        . "`n• Fixed: every Normalize Window step also cleared the focused field and pressed Tab (and Citrix fill did nothing)."
        . "`n• Fixed: Enter, Tab and Esc were recorded twice (key + typed character) and so played twice."
        . "`n• Double-clicks, wheel notches (with their spot) and Ctrl / Shift+clicks are recorded as what they were."
        . "`n• 'Steady playback' (on for new macros): steps wait for their window, a window that can't come to the front stops the step,"
        . "  and each click waits up to 1.5 s for the screen at the spot to look like the recording (small drift is corrected)."
        . "`n`nNEW IN V17 (Easy mode):"
        . "`n• '◂ Easy mode' (Ctrl+Shift+E) hides everything except Record, Play, Pick window, Save and 9 blocks."
        . "`n• '📐 Pick window': click the app's title bar once. It becomes the Macro window and step #1 normalizes its size and spot."
        . "`n• While recording, switching to another window adds 'Use Window From Here On' + 'Normalize Window Geometry' for it"
        . "  (untick 'Normalize new windows while recording' to stop that). Fixed-size dialogs are only moved."
        . "`n• A window that can't reach its saved size no longer stops the run: it is noted in the status bar and last-playback.log."
        . "`n`nNEW IN V16 (record the web side via CDP):"
        . "`n• Connect a tab in Web / CDP first, then press Record. Clicks, typing, dropdowns, checkboxes and"
        . "  Enter / Tab / Escape inside that tab are saved as web blocks with CSS selectors (no screen coordinates)."
        . "`n• Desktop clicks / typing that duplicate a web action are dropped; the address bar, other apps and"
        . "  cross-origin frames stay desktop steps. Password fields become 'ask each time' fills."
        . "`n`nNEW IN V15 (steadier playback):"
        . "`n• Each click / drag finds and resizes its window once, so there is less window flicker between steps."
        . "`n• 'Lock window size' now waits until the window really reaches its size (Esc stops the wait)."
        . "`n• 'Auto' speed watches the active window on whichever monitor it is on, not just the main screen."
        . "`n• New Variables block 'NDC from barcode scan': the tech scans a drug barcode and the 11-digit NDC (no dashes)"
        . "  goes into {{ndc}}, padded the right way using the FDA NDC list (downloaded once, then works offline)."
        . "`n`nNEW IN V14 (window-locked coordinates):"
        . "`n• Recorded clicks are saved relative to the window, not the screen, so moving the window never breaks them."
        . "`n• 'Lock window size' (on by default) puts each resizable window back to its recorded size / maximized state"
        . "  before clicking. If it can't (fixed dialogs, other monitor), spots follow the nearest window edge instead."
        . "`n• Clicks recorded in V13 or earlier keep their old coordinates - re-record or 'New picture' to upgrade them."
        . "`n`nNEW IN V10 (Classical Non-OCR / Non-Image Deterministic Engine):"
        . "`n• ZERO-OCR, ZERO-IMAGE DETERMINISTIC BLOCKS (in the left toolbox under 'V10 Deterministic (No OCR)'):"
        . "`n   1. Wait for Region CRC32 Change & Settle: hashes rectangle pixels via GDI BitBlt + ntdll\RtlComputeCrc32 in <0.3 ms."
        . "      Waits for the region to start changing, then until it stays unchanged for N ms (plus detects end-of-list!)."
        . "`n   2. Wait for / If Pixel Sentinel: 1-pixel state check (DiscernYellow, CernerDoorBlue, HighlightBlue, DisabledGrey, or NearHex)."
        . "`n   3. Anchor-Relative Click: clicks by dialog geometry (BottomCenter, TopRight, Proportional %) so resized windows never break."
        . "`n   4. Predict & Select List/Dropdown Row (Layout Physics): computes exact 1-based row and pixel Y from the app's sort/partition"
        . "      rules (e.g. Ticked A-Z first, then Unticked A-Z, plus conditional item shifts)."
        . "`n   5. Human-Physics Click (Minimum-Jerk / WindMouse + hover dwell) & Citrix-Safe Field Clear."
        . "`n   6. Press Ctrl+Shift+D (or click '🧭 Lab...') to open the live Deterministic Inspector & Layout Physics Lab!"
        . "`n`nV8 FEATURES (Smart Vary & 1-Click Auto-Loop):"
        . "`n• Hold Alt while clicking during recording (or press F7 / Ctrl+L) to turn any step into a loop with pixel stride, multi-spot,"
        . "  dynamic key repetition, or counter/column variables." . V22_ColumnCheckLine(VMB().IndentSeen),
        "Visual Macro Blocks V18 - help", "Iconi")
}


; Built-in non-destructive tests: --self-test "C:\path\report.txt"
V4_SelfTest(path) {
    rows := [], failures := 0
    check(name, actual, expected := true) {
        ok := actual = expected
        rows.Push((ok ? "PASS" : "FAIL") . " | " . name)
        if !ok
            failures += 1
    }
    rejects(name, callback) {
        caught := false
        try callback.Call()
        catch
            caught := true
        check(name, caught)
    }
    try {
        check("AutoHotkey major version", SubStr(A_AhkVersion, 1, 2), "2.")
        check("JSON quote/unicode roundtrip", JSON.Parse(JSON.Stringify(Map("x", "Hello `"world`" \ ä 😀")))["x"], "Hello `"world`" \ ä 😀")
        check("JSON booleans", V4_Bool(JSON.Parse("true")) && !V4_Bool(JSON.Parse("false")))
        check("JSON null roundtrip", JSON.Stringify(JSON.Parse("null")), "null")
        check("JSON arrays", JSON.Parse("[1,2,3]")[3], 3)
        rejects("Malformed JSON rejected", () => JSON.Parse('{"a":1,}'))
        rejects("Duplicate JSON keys rejected", () => JSON.Parse('{"a":1,"a":2}'))
        check("CSV quoted comma", V4_ParseDelimited('a,"b,c"`n1,2')[1][2], "b,c")
        check("CSV escaped quotes", V4_ParseDelimited('"a""b",c')[1][1], 'a"b')
        check("Variable validation", VMF_ValidVarName("input_value"))
        check("Reserved variable rejected", !VMF_ValidVarName("clipboard"))
        ctx := V4Runner(VMF_NewMacro(), {})
        ctx.Vars["name"] := "A&B"
        check("Placeholder expansion", ctx.Expand("Hello {{name}}"), "Hello A&B")
        node := V4_CreateNode("input_sendinput")
        check("SendInput is a leaf step", VMF_IsStep(node))
        check("SendInput validation", VM_Validate(Map("blocks", [node])).Length, 0)
        check("Basic input definitions", V4_InputDefs().Count, 8)
        rejects("Negative key delay rejected", () => V4_InputValidate(Map("type","input_keydelay","delay",-2,"duration",10)))
        rejects("External WebSocket endpoint rejected", () => V4Socket("ws://example.com:9222/devtools/page/test"))
        rejects("Invalid port rejected", () => V4_Port(80))
        webif := V4_CreateNode("web_if")
        check("Web IF is a container", VMF_IsContainer(webif) && webif["cond"] = "web")
        macro := VMF_NewMacro()
        macro["settings"]["onFail"] := "stop"
        macro["blocks"] := [Map("type","set","name","total","value",0),
            Map("type","repeat","count",3,"body",[Map("type","change","name","total","by",2)])]
        runner := V4Runner(macro, {})
        runner.Run(macro["blocks"])
        check("Repeat and variable execution", runner.Vars["total"], 6)
        ndcList := Map("0002322730", "0002-3227-30", "5024204062", "50242-040-62", "6050525191", "60505-2519-1")
        check("NDC 4-4-2 from 10 digits", NDC_Normalize("0002322730", ndcList).Ndc11, "00002322730")
        check("NDC 5-3-2 from UPC-A", NDC_Normalize("350242040620", ndcList).Ndc11, "50242004062")
        check("NDC 5-4-1 from GS1 DataMatrix", NDC_Normalize("]d2010036050525191717261231" . Chr(29) . "10AB12", ndcList).Ndc11,
            "60505251901")
        check("NDC 5-4-1 from (01) GTIN-14", NDC_Normalize("(01)00360505251917", ndcList).Ndc11, "60505251901")
        check("NDC typed with dashes", NDC_Normalize("0002-3227-30", Map()).Ndc11, "00002322730")
        check("NDC 11 digits passes through", NDC_Normalize("00002322730", Map()).Ndc11, "00002322730")
        unknown := NDC_Normalize("1234567890", ndcList)
        check("NDC not in list gives 3 readings", unknown.Ndc11 = "" && unknown.Choices.Length = 3
            && NDC_DashedTo11(unknown.Choices[2]) = "12345067890")
        rejects("Non-drug UPC rejected", () => NDC_Normalize("012345678905", ndcList))
        check("NDC block validates", VM_Validate(Map("blocks", [Map("type", "ndc", "name", "ndc", "source", "")])).Length, 0)
        ndcRun := V4Runner(VMF_NewMacro(), {})
        ndcRun.Vars["scan"] := "0002322730"
        NDC_List(false, ndcList)
        ndcRun.Run([Map("type", "ndc", "name", "ndc", "source", "{{scan}}")])
        NDC_List(true)
        check("NDC block sets variable", ndcRun.Vars.Get("ndc", ""), "00002322730")
        ; V5 step debugger: scripted keys instead of the keyboard; Log = the step numbers it paused at ("!" = failed).
        sample() => [Map("type","set","name","total","value",0),
            Map("type","repeat","count",2,"body",[Map("type","change","name","total","by",2)]),
            Map("type","set","name","done","value",1)]
        dbgRun(blocks, script, startMode := "step", runTo := 0) {
            m := VMF_NewMacro()
            m["blocks"] := blocks
            opts := {Debug: true, StartMode: startMode}
            if runTo
                opts.RunTo := runTo
            d := V5_Dbg()
            d.Script := script, d.Log := []
            r := V4Runner(m, opts)
            V5_DbgBegin(opts)
            try r.Run(m["blocks"])
            finally {
                missed := V5_DbgEnd()
                d.Script := 0
            }
            return {Runner: r, Log: V4_Join(d.Log, ","), Missed: missed}
        }
        res := dbgRun(sample(), ["step", "step", "step", "run"])
        check("Step into pauses before every block, each loop round", res.Log, "1,2,3,3")
        check("Stepping still runs every block", res.Runner.Vars["total"], 4)
        res := dbgRun(sample(), ["step", "over", "step"])
        check("Step over runs a whole loop without pausing", res.Log, "1,2,4")
        check("Step over still runs the loop", res.Runner.Vars["total"], 4)
        res := dbgRun(sample(), ["step", "step", "out", "step"])
        check("Finish block pauses after the loop", res.Log, "1,2,3,4")
        res := dbgRun(sample(), ["step", "step", "skip", "run"])
        check("Skip leaves that block out", res.Log . "|" . res.Runner.Vars["total"], "1,2,3,3|2")
        blocks := sample(), blocks[2]["body"][1]["breakpoint"] := 1
        res := dbgRun(blocks, ["run", "run"], "run")
        check("Breakpoint pauses every time it is reached", res.Log, "3,3")
        blocks := sample()
        res := dbgRun(blocks, ["run"], "run", blocks[3])
        check("Run to here pauses only at the chosen line", res.Log . "|" . res.Missed, "4|0")
        blocks := sample()
        res := dbgRun(blocks, [], "run", Map("type", "delay", "ms", 0))
        check("Run to an unreached line is reported", res.Log . "|" . res.Missed, "|1")
        res := dbgRun([Map("type","change","name","n","by","abc")], ["run", "skip"], "run")
        check("Failure waits in the bar: retry, then skip", res.Log . "|" . res.Runner.Skipped, "1!,1!|1")
        check("Plain runs never consult the debugger", V4Runner(VMF_NewMacro(), {}).Dbg, false)
        ; V6 element tree: the browser-free parts (selector builder, verdicts, wiring)
        built := [Map("group","attr","css",'[name="q"]'), Map("group","tag","css","input"),
            Map("group","class","css",".big"), Map("group","parent","css","form#f > ")]
        check("Element tree builder keeps CSS order", V6_ComposeSelector(built), 'form#f > input.big[name="q"]')
        check("Element tree builder adds the shadow prefix",
            V6_ComposeSelector([Map("group","class","css",".x")], "my-app >>> "), "my-app >>> .x")
        check("Element tree builder never yields an empty selector",
            V6_ComposeSelector([Map("group","inside","css","#main ")]), "#main *")
        verdict := V6_MatchText(Map("count",3,"pos",2,"error",""), true, 0, true)
        check("Several matches: the index follows the chosen element", verdict.Index, 2)
        verdict := V6_MatchText(Map("count",1,"pos",1,"error",""), true, 4, true)
        check("A unique match resets the index to 0", verdict.Index . "|" . verdict.Color, "0|107C10")
        verdict := V6_MatchText(Map("count",0,"pos",0,"error",""), true, 0, true)
        check("No match is reported in red", verdict.Color, "C00000")
        verdict := V6_MatchText(Map("count",2,"pos",0,"error",""), true, 1, true)
        check("Matches that miss the chosen element leave the index alone", verdict.Index, "")
        verdict := V6_MatchText(Map("count",2,"pos",0,"error",""), false, 0)
        check("Ambiguous without a chosen element is a warning", verdict.Color, "B25E00")
        verdict := V6_MatchText(Map("count",2,"pos",0,"error",""), false, 3)
        check("An index past the matches is an error", verdict.Color, "C00000")
        check("Element tree JS is embedded", InStr(V6_TreeJS(), "__VMB_V6_TREE") > 0 && InStr(V6_TreeJS(), "`"use strict`"") > 0)
        rejects("Element tree needs a connected tab", () => V6_ElementTree(Map("selector", "#x")))
        dbg := V5_Dbg(), dbg.Editing := true
        check("Step keys stand down while the element tree is open", !V5_DbgKeys() && !V5_DbgArrowKeys())
        dbg.Editing := false
        res := dbgRun([Map("type","set","name","n","value",1)], ["run"])
        check("Corrections flag starts clear", res.Runner.Changed, false)
