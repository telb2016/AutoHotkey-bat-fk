        check("V25 shaky: two runs with a note is not enough", V25_Shaky([v25R("w", "Finished", 1, [4]), v25R("w", "Finished", 1, [4])]).Count, 0)
        check("V25 shaky: no runs, not a list", V25_Shaky([]).Count . V25_Shaky(0).Count, "00")
        check("V25 shaky: a note twice in one run counts once", V25_Shaky([v25R("w", "Finished", 1, [4, 4]), v25R("w", "Finished", 1, [4])]).Count, 0)
