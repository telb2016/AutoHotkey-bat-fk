            "winMatch", "active", "note", "check it"), "notepad", "Step #6: slow", 6),
            "Step 6 · notepad · waits 400 ms first (set by hand) · Press Enter (OK / submit / new line) · list is scrolled back first · varies: +5px X / round · whatever window is active · note: check it · last run: slow")
        check("V23 plain list: normal step is default", V23_RowColors("click", "") = 0 ? "default" : "coloured", "default")
        check("V23 plain list: control row is default", V23_RowColors("repeat", "") = 0 ? "default" : "coloured", "default")
        check("V23 plain list: switched-off step is grey on white", V23_RowColors("click", "off")[1] . "|" . V23_RowColors("click", "off")[2], 0x909090 . "|" . 0xFFFFFF)
        check("V23 plain list: switched-off control row is grey on white", V23_RowColors("if", "off")[1], 0x909090)
        check("V23 note step is dark red on white", V23_RowColors("click", "note")[1] . "|" . V23_RowColors("click", "note")[2], 0x0000C0 . "|" . 0xFFFFFF)
        check("V23 note on a control row stays default", V23_RowColors("repeat", "note") = 0 ? "default" : "coloured", "default")
        check("V23 off wins over note", V23_RowColors("click", "off")[1], 0x909090)
        v24Np := Map("exe", "notepad.exe"), v24Ed := Map("exe", "msedge.exe")
        v24S := [Map("type", "click", "win", v24Np), Map("type", "keys", "win", v24Np), Map("type", "click", "win", v24Ed)]
        v24All := Map("notepad.exe", 1, "msedge.exe", 1)
        v24Rec := Map("recScreen", "1920x1080 @ 100%")
        check("V24 preflight: everything open is ready", V24_Preflight(v24S, Map(), v24All, "1920x1080 @ 100%").Length, 0)
        v24R := V24_Preflight(v24S, Map(), Map("msedge.exe", 1), "")
        check("V24 preflight: one program missing", v24R.Length . "|" . v24R[1], "1|notepad is not open - step 1 uses it.")
        v24R := V24_Preflight([Map("type", "click", "win", v24Ed), Map("type", "click", "win", v24Np)], Map(), Map(), "")
        check("V24 preflight: two missing, in order of first use", v24R.Length . "|" . v24R[1] . "|" . v24R[2],
            "2|msedge is not open - step 1 uses it.|notepad is not open - step 2 uses it.")
        v24R := V24_Preflight([Map("type", "click", "win", v24Np), Map("type", "click", "win", v24Ed)], Map(), Map(), "")
        check("V24 preflight: order is the order of first use, not alphabetical", v24R[1] . "|" . v24R[2],
            "notepad is not open - step 1 uses it.|msedge is not open - step 2 uses it.")
        v24R := V24_Preflight(v24S, v24Rec, v24All, "1920x1080 @ 125%")
        check("V24 preflight: screen differs", v24R.Length . "|" . v24R[1],
            "1|The screen is 1920x1080 @ 125%, recorded on 1920x1080 @ 100% - clicks may land differently.")
        check("V24 preflight: same screen is fine", V24_Preflight(v24S, v24Rec, v24All, "1920x1080 @ 100%").Length, 0)
        check("V24 preflight: screen not recorded is fine", V24_Preflight(v24S, Map(), v24All, "1920x1080 @ 125%").Length, 0)
        v24Off := Map("type", "click", "win", v24Ed, "disabled", 1)
        v24R := V24_Preflight([Map("type", "click", "win", v24Np), v24Off], Map(), Map("notepad.exe", 1), "")
        check("V24 preflight: a switched-off step is ignored", v24R.Length, 0)
        v24R := V24_Preflight([Map("type", "det_use_window", "target", "ahk_class Notepad ahk_exe notepad.exe"), Map("type", "det_normalize_win", "target", "ahk_exe msedge.exe")], Map(), Map(), "")
        check("V24 preflight: Use Window and Normalize targets count", v24R.Length . "|" . v24R[2], "2|msedge is not open - step 2 uses it.")
        check("V24 preflight: a window class alone is not a program", V24_Preflight([Map("type", "det_use_window", "target", "ahk_class Notepad")], Map(), Map(), "").Length, 0)
        check("V24 preflight: ask-each-run text is not a problem", V24_Preflight([Map("type", "text", "ask", 1, "win", v24Np)], Map(), v24All, "").Length, 0)
        v24Run := Map("notepad.exe", 1)
        check("V24 app cell: a running program has no mark", V24_AppCell("notepad", v24Run), "notepad")
        check("V24 app cell: a program that is not running gets ?", V24_AppCell("msedge", v24Run), "msedge?")
        check("V24 app cell: an empty cell stays empty", V24_AppCell("", v24Run), "")
        check("V24 app cell: not looked at yet = no mark", V24_AppCell("msedge", 0), "msedge")
        check("V24 app cell: a name the macro does not use as a program is not marked", V24_AppCell("web page", v24Run, Map("msedge.exe", 1)), "web page")
        v24Apps := Map(v24S[1], "notepad", v24S[3], "msedge")
        V24_MarkApps(v24Apps, v24Run, v24S)
        check("V24 mark apps: only the closed program gets ?", v24Apps[v24S[1]] . "|" . v24Apps[v24S[3]], "notepad|msedge?")
        v25Ok := {Ok: true, Index: 17, Message: "Finished.", Failed: 0}
        v25Notes := Map(12, "Step #12 x", 6, "Step #6 y")
        check("V25 run line: finished with two notes", V25_RunLine(v25Ok, 41.26, 17, v25Notes, "2026-11-15 09:12"), '2026-11-15 09:12,Finished,41.3,17,2,"6;12"')
        check("V25 run line: no notes", V25_RunLine(v25Ok, 3, 4, Map(), "2026-11-15 09:12"), '2026-11-15 09:12,Finished,3.0,4,0,""')
        check("V25 run line: failed at a step", V25_RunLine({Ok: false, Index: 6, Message: "Step #6: x", Failed: 1}, 9.04, 17, Map(), "w"), 'w,Failed at step 6,9.0,17,0,""')
        check("V25 run line: stopped", V25_RunLine({Ok: false, Index: 3, Message: "Stopped.", Failed: 0}, 2.5, 17, Map(), "w"), 'w,Stopped,2.5,17,0,""')
        check("V25 run line: time of day is filled in", RegExMatch(V25_RunLine(v25Ok, 1, 1, Map()), "^\d{4}-\d\d-\d\d \d\d:\d\d,Finished,"), 1)
        v25Txt := "When,Result,Seconds,Steps,Notes,NoteSteps`r`n2026-11-15 09:12,Finished,41.3,17,2,`"6;12`"`r`nthis is broken`r`n2026-11-15 09:20,Failed at step 6,9.0,17,0,`"`"`r`n`r`n"
        v25P := V25_ParseRuns(v25Txt)
        check("V25 parse: header and broken lines skipped", v25P.Length, 2)
        check("V25 parse: fields", v25P[1]["When"] . "|" . v25P[1]["Result"] . "|" . Format("{:.1f}", v25P[1]["Seconds"]) . "|" . v25P[1]["Steps"] . "|" . v25P[1]["Notes"] . "|" . V4_Join(v25P[1]["NoteSteps"], ";") . "|" . v25P[1]["FailStep"], "2026-11-15 09:12|Finished|41.3|17|2|6;12|0")
        check("V25 parse: failed step number", v25P[2]["FailStep"] . "|" . v25P[2]["NoteSteps"].Length, "6|0")
        check("V25 parse: empty, missing and not text", V25_ParseRuns("").Length . V25_ParseRuns(0).Length . V25_ParseRuns("garbage,,,").Length, "000")
        check("V25 parse: round trip of a run line", V25_ParseRuns(V25_RunLine(v25Ok, 41.26, 17, v25Notes, "2026-11-15 09:12"))[1]["NoteSteps"].Length, 2)
        v25Many := "When,Result,Seconds,Steps,Notes,NoteSteps`r`n"
        loop 205
            v25Many .= "t" . A_Index . ",Finished,1.0,1,0,`"`"`r`n"
