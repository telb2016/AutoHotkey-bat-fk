        check("V27 click: action", v27C["action"], "Click")
        check("V27 click: on what", v27C["target"], "the " . v27Q . "OK" . v27Q . " button")
        check("V27 click: button, clicks, held", v27C["button"] . " " . v27C["clicks"] . " " . v27C["held"], "Left 1 none")
        check("V27 click: spot without a window size", v27C["x"] . "," . v27C["y"] . " " . v27C["anchor"], "300,200 screen spot")
        check("V27 click: no wait, no scroll, no picture check", v27C["wait"] . " " . v27C["scroll"] . " " . v27C["check"], "0 no no")
        check("V27 click: last run ok, history says no, on", v27C["lastrun"] . " " . v27C["shaky"] . " " . v27C["onoff"], "ok no on")
        check("V27 click: every cell filled in", v27C["inside"] . v27C["zone"] . v27C["note"], "–––")
        v27Geo := Map("cx", 150, "cy", 100, "cw", 400, "ch", 300, "ww", 700, "wh", 500, "ax", "R", "ay", "B", "max", 0)
        v27D := V27_Cells(Map("type", "click", "button", "Left", "count", 2, "mods", "^+", "geo", v27Geo), v27Ctx)
        check("V27 double-click: action", v27D["action"], "Double-click")
        check("V27 double-click: held keys", v27D["held"], "Ctrl+Shift")
        check("V27 double-click: window size from the spot", v27D["winsize"], "700 × 500")
        check("V27 double-click: where and follows", v27D["zone"] . " / " . v27D["anchor"], "middle / bottom-right")
        check("V27 right-click: action", V27_Cells(Map("type", "click", "button", "Right", "count", 1), v27Ctx)["action"], "Right-click")
        v27T := V27_Cells(Map("type", "text", "text", "hello"), v27Ctx)
