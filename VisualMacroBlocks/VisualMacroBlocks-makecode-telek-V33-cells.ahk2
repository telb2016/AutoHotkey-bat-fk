        check("V22.1 margin = (maxDepth - depth) * indent, never negative", StrLen(V22_Margin(0, 3, 2)) . "," . StrLen(V22_Margin(1, 3, 2)) . "," . StrLen(V22_Margin(2, 3, 2)) . "," . StrLen(V22_Margin(5, 3, 2)), "6,3,0,0")
