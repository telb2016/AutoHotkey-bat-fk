; VisualMacroBlocks-makecode-telek-V22
; V22.1 = answers round: see GROK-PLAN-V22-answers.md
; V22 = V21 + a step list in fixed columns: every row shows its program, and the columns #, Program, Waits, Marks
;       and What it does line up, with a header line above the list naming them. A switch ("Columns" next to
;       Explain steps, or right-click the list > Show columns) turns the columns off and gives the V21 list back.
; V21 = V20 + a step list you can read at a glance: the program is named only where it changes, web / input /
;       measuring steps and REPEAT / IF / FOR rows get plain sentences too, steps that had a note in the last run
;       are marked ⚠, and in Steady playback a window whose saved spot is off every screen is put on the main screen.
; V20 = V19 + step lines you can read at a glance. Each step in the macro list is one plain sentence - what is
;       done, to what, in which program, whereabouts in the window - plus small tags for a long pause, a list that
;       is scrolled back first, or a note. Recording a click also remembers what was under the mouse (a button's
;       caption, a menu item's text, or just "a text box" / "a list"); text inside boxes and lists is never saved.
;       FIX: a list that has become shorter than the recorded scroll position is now reported instead of silently
;       scrolled to its end.
; V19 = V18 + window size is waited for and tested at recording, optional stop when a window
;       can't take its size, and standard lists / boxes are scrolled back before each click.
; V18 = V17 + one-click Record and Steady playback.
;       RECORD: in Easy mode just press Record - no window to pick first. The first program you click or type in
;       becomes the Macro window and step #1 becomes its Normalize step. The "are you sure" box is shown the first
;       time only. The red REC bar can be clicked to stop. Clicks on this editor / the REC bar are never recorded.
;       FIX: every "Normalize Window Geometry" step (step #1 of every Easy-mode macro, and each window switch) also
;       ran the Citrix field clear - End, Shift+Home, Delete twice, 40 Backspaces, then Tab - into the window, and
;       the "Citrix-safe fill" block itself did nothing (its case line had been lost in V17).
;       FIX: Enter, Tab and Esc were recorded twice (as a key press and again as a typed character), so playback
;       pressed them twice. They are now recorded once.
;       Click pictures are taken while the mouse rests on the target, just before the press (V17 took them just
;       after it, racing the program's own redraw of the pressed button / selected row).
;       Double-clicks are saved as one double-click step, wheel notches as one wheel step (with the spot the mouse
;       was over), and Ctrl / Shift held during a click is saved and held again on playback.
;       STEADY PLAYBACK (macro setting, on for new macros; Full mode checkbox "Steady playback"):
;       - every step waits for its window (program not open yet, dialog / menu still opening) instead of acting on
;         whatever window happens to be active, and stops with a clear message when it never shows up;
;       - a window that can't be brought to the front stops the step instead of typing into the wrong window;
;       - before each recorded click the mouse moves to the spot and waits (up to 1.5 s) until the screen there
;         looks like it did when recorded; a few pixels of drift are corrected. If it never matches, the recorded
;         spot is clicked anyway and a note is logged (status bar + last-playback.log);
;       - playback waits for Ctrl / Shift / Alt / Win to be released, and notes a changed screen size / scaling.
;       Macros saved by V17 or earlier play exactly as before until "Steady playback" is ticked.
; V17 = V16 + Easy mode (on by default; "More features ▸" / Ctrl+Shift+E shows every V16 control again).
;       Easy mode shows only Record / Stop / Play / Step by step, New / Open / Save, a 9-block toolbox and short
;       block popups ("More options..." shows the rest). "📐 Pick window": click the app's title bar once - it becomes
;       the Macro window and step #1 becomes a Normalize Window Geometry step with its current size and spot.
;       Easy-mode Record asks for that window first when none is set. While recording, switching to another window adds
;       "Use Window From Here On" + "Normalize Window Geometry" for it, so later clicks land on a standard-size window.
;       Normalize can keep a window maximized, restores a minimized / maximized window before resizing, only moves
;       fixed-size dialogs, and a window that can't reach its size (min / max size, display scaling) is noted in the
;       status bar and last-playback.log instead of stopping the run.
; V16 = V15 + web (CDP) recording. When a Web / CDP tab is connected, Record also captures what you do inside that
;       tab as web blocks (click, fill, select, checkbox, Enter/Tab/Escape) with CSS selectors, merged in time order
;       with the desktop steps. Desktop clicks/typing that duplicate a captured web action are dropped; anything the
;       web recorder could not see (address bar, cross-origin frames, other apps) stays a desktop step.
;       Password fields are recorded as "ask each time" fills - the typed password is never saved.
; V15 = V14 + playback polish: each click/drag finds and locks its window once (was twice), the window-size lock
;       waits until the window really reaches its recorded size and can be stopped with Esc, and "Auto" speed
;       watches the active window (on any monitor) instead of only the primary screen. V14 drafts carry over.
; V14 = V13 + window-locked coordinates (default). Each recorded click saves its spot relative to the window's
;       client area plus the edge it sits near (left/right/proportional, top/bottom), and the window's size.
;       On playback the window is first put back to its recorded size ("Lock window size", on by default),
;       then the spot is worked out from the window's current position - so moved or resized windows still line up.
;       Steps recorded in V13 or earlier keep their old screen / window-offset coordinates.
; V13 = V12 + a "Step settings" panel beside the macro tree (see and change the selected step's settings without
;       opening it; Enter / Tab / click away applies, Ctrl+Z undoes) and plain-English tree labels
;       (e.g. "^{a} -> Ctrl+A: select all", wait-before / window badges, step notes). Toggle: "Settings panel" button.
; V12 = V10 + looser defaults: missing/unactivatable windows fall back to the active window, pictures match
;       with more variation (60, retries up to 125) and click/drag fall back to the recorded spot.
; SINGLE FILE: native AutoHotkey v2 editor + desktop/basic-input blocks + CDP web blocks + Apple UX + ADHD Memory Hub + Prototyping HUD + Smart Vary & Auto-Loop + V10 Classical Non-OCR/Non-Image Deterministic Engine.
; Version: V10 | 2026-10-25  (V10 adds CLASSICAL NON-OCR / NON-IMAGE DETERMINISTIC AUTOMATION ENGINE:
;          1. Region CRC32 State-Machine Waits ("Wait until region changes, then settles") via native GDI BitBlt + ntdll\RtlComputeCrc32
;             — zero fixed Sleeps, zero OCR, zero template matching; detects exact listbox scroll end, portal load, or end-of-list!
;          2. Semantic Single-Pixel & Color-Family Sentinels (Wait for pixel color / yellow / disabled grey / highlight blue / door icon).
;          3. Geometry-Anchored & Edge-Relative Coordinates (Top-Left, Top-Right, Bottom-Center, Center, Proportional %, plus
;             1-click Window Size Normalizer so coordinates never drift across monitors or resized prompts).
;          4. Layout Physics & Deterministic List/Dropdown Row Predictor (calculates exact row index and pixel Y `y0 + (row-1)*rowH`
;             or `{Home}{Down N}{Space}` from Partitioned Sort order [e.g. Ticked A-Z then Unticked A-Z] and dynamic conditional item shifts).
;          5. Human-Physics Mouse & Citrix-Safe Field Entry (WindMouse / Minimum-Jerk trajectory, hover-dwell before click so
;             menus don't close, and 3-stage Citrix field clear).
;          6. Interactive "🧭 Deterministic Inspector & Layout Physics Lab" (Ctrl+Shift+D or toolbar "🧭 Lab...") to measure
;             window anchors, pixel colors, region CRC32s, and row strides live on screen!)
;          V8: SMART VARY & AUTO-LOOP for zero-friction rapid prototyping:
;          1. Record your sequence once as normal (click, click, type, click).
;          2. EITHER during recording (hold Alt when clicking, or press F7 to mark the step that changes each round,
;             or click "⚡ Mark Vary" on the HUD) OR after recording (Right-click any step -> "⚡ Make this step vary (Auto-Loop)...",
;             or press Ctrl+L / the "⚡ Vary + Loop..." button).
;          3. Pick a 1-click preset:
;             • Move click down/across by N pixels each round (includes "📏 Measure Row 1 -> Row 2" where you just
;               point at Row 1 and Row 2 with F6 and V10 calculates the exact pixel stride automatically!)
;             • Cycle through a list of clicked spots (click spot 1, 2, 3...)
;             • Press a key (Down arrow, Tab, Right, PageDown) 1x on round 1, 2x on round 2, 3x on round 3...
;             • Increment a number / counter or insert a data column ({{index}}, {{i}}, {{Column}})
;          4. V10 automatically wraps your recorded sequence into a Repeat N times, For i = 1..N, or For Each Data Row
;             loop in the same step — zero manual loop plumbing!)
;          V7: Close (X) stays in tray, Spotlight Command Palette (Ctrl+K), Quick Look (Space), Auto-Save, ADHD "Where Was I?" Hub (F1), Prototyping HUD (Ctrl+Shift+H).
;          V6: web ELEMENT TREE (browse DOM, build selectors, fix broken targets from the run bar).
;          V5: step-by-step debugging (breakpoints, step / over / skip / run to here, a quiet run bar).
; Internal function prefixes (V4_, V5_, V6_, V7_, V8_, V10_, VM_, VMB_) and the V4BMP picture format are unchanged, so V4..V8 macros open as-is.
; The .ahk and .txt distribution copies are byte-identical UTF-8 source.
; Requires Windows 10/11, AutoHotkey v2.0.19+, and Edge/Chrome for web automation.
; No #Include, extension, WebDriver, Node.js, Chrome.ahk, or downloaded helper is used.
; The supplied editor's missing libraries were replaced by this embedded runtime.
; Legacy VisualFind picture strings must be recaptured as V4 embedded bitmaps.
; Legacy fuzzy corrections / PHI-safe title matching / per-row results are not reproduced.
; Privacy checks are heuristic. Do not record or save credentials or private data.
; Research references (official API documentation, consulted 2026-10-19):
; https://developer.chrome.com/blog/remote-debugging-port?hl=en
; https://chromedevtools.github.io/devtools-protocol/tot/Runtime/
; https://chromedevtools.github.io/devtools-protocol/tot/Input/
; https://chromedevtools.github.io/devtools-protocol/tot/Page/
; https://learn.microsoft.com/en-us/windows/win32/api/winsock2/nf-winsock2-select
; https://www.rfc-editor.org/rfc/rfc6455
; https://www.autohotkey.com/docs/v2/lib/Send.htm
; https://www.autohotkey.com/docs/v2/lib/SendMode.htm
; Native APIs and protocol descriptions are referenced; no third-party AHK library is vendored.
; ----------------------------------------------------------------------------

#Requires AutoHotkey v2.0.19+
#SingleInstance Force
#Warn All, StdOut

; Hotkeys
;   Ctrl+Shift+R   start / stop recording (new steps go after the selected block, or inside a selected loop/if)
;                  While recording, clicking the red REC bar (bottom-left) also stops.
;   Ctrl+Shift+P   play the macro
;   Ctrl+Shift+M   show / bring back the main editor window (or open the Memory Hub when already active)
;   Ctrl+Shift+H   show / hide the floating Prototyping HUD
;   Ctrl+Shift+K   open the Spotlight Command Palette from anywhere
;   Ctrl+Shift+D   open the V10 Deterministic Inspector & Layout Physics Lab
;   Ctrl+Shift+E   (in the editor) switch between Easy mode and Full mode (V17)
;   Esc            stop playback (only while playing)
;   Ctrl+Shift+X   emergency exit (always works)
;   In the editor: Ctrl+L = Make step vary & Auto-Loop, Ctrl+D (or Ctrl+Shift+D) = Deterministic Lab, Ctrl+K = Command Palette,
;                  F1 = Memory & Files Hub ("Where Was I?"), Space (in tree) = Quick Look, F5 = play, F10 = step by step,
;                  Ctrl+F10 = run to the selected line, F9 = breakpoint on/off, Ctrl+Shift+F9 = clear all breakpoints
;   While recording: Hold Alt while clicking (or press F7 right after a step) to mark that step as a "Variable Step"
;                    — when you stop recording, V10 automatically opens the 1-click Vary & Auto-Loop wizard for it!
;   While playing: F10 = pause before the next step.  While paused (the run bar turns amber):
;                  Down or F10 = run the next step, Shift+Down or Shift+F10 = run the whole block (step over),
;                  Right = skip this step, Shift+F11 = finish this block, F5 = continue, Esc = stop
;                  (the arrow keys are only borrowed while paused; untick "Use the arrow keys" on the bar to keep them)
;   In the macro tree: Ctrl+L = Make step vary (Auto-Loop), Space = Quick Look preview, Del = delete, Ctrl+Up/Down = move,
;                      Ctrl+Right = into the block above, Ctrl+Left = out, F2 = edit, Ctrl+C / Ctrl+V = copy / paste,
;                      Ctrl+D = duplicate, Ctrl+E = disable / enable
;   Anywhere in the window: Ctrl+Z / Ctrl+Y = undo / redo, Ctrl+Plus / Ctrl+Minus / Ctrl+0 = zoom the tree
; Do not run another macro recorder (or V4..V8 of this editor) with the same hotkeys at the same time.
; Export player writes the embedded runtime as matching V10 .ahk and .txt files.
; Captured text and pictures may be sensitive. Review before saving or sharing.

SetTimer(V4_Start, -1)

#SuspendExempt
^+x::VMB_PanicExit()
#SuspendExempt False

^+r::VMB_ToggleRecord()
^+p::VMB_Play()
^+m::V7_ShowOrHub()
^+h::V7_ToggleIdleHud()
^+k::V7_CommandPalette()
^+d::V10_ShowDeterministicLab()

#HotIf VM_IsRecording()
F7::V8_MarkLastRecordedStepVary()
#HotIf V5_DbgArrowKeys()
Down::V5_DbgCommand("step")
+Down::V5_DbgCommand("over")
Right::V5_DbgCommand("skip")
Up::V5_DbgNoGoingBack()
Left::V5_DbgNoGoingBack()
#HotIf V5_DbgKeys()
F10::V5_DbgCommand("step")
+F10::V5_DbgCommand("over")
+F11::V5_DbgCommand("out")
F5::V5_DbgCommand("run")
Pause::V5_DbgCommand("pause")
#HotIf VM_IsPlaying() && !V5_Dbg().Editing
Esc::VM_RequestStop()
#HotIf V13_InspFocused()
Enter::V13_InspCommit()
NumpadEnter::V13_InspCommit()
Esc::V13_InspLoad(false)
#HotIf VMB_TreeFocused()
Space::V7_QuickLook()
^l::V8_VarySelectedDialog()
Delete::VMB_DeleteSelected()
^Up::VMB_MoveSelected(-1)
^Down::VMB_MoveSelected(1)
^Right::VMB_Indent()
^Left::VMB_Outdent()
F2::VMB_EditSelected()
^c::VMB_Copy()
^v::VMB_Paste()
^d::VMB_Duplicate()
^e::VMB_ToggleDisabled()
^a::VMB_CheckAll()
#HotIf VMB_EditorActive()
^+e::V17_ToggleEasy()
^l::V8_VarySelectedDialog()
^k::V7_CommandPalette()
F1::V7_MemoryHub()
F5::VMB_Play()
F10::VMB_Play(false, "step")
^F10::VMB_RunToHere()
F9::VMB_ToggleBreakpoint()
^+F9::VMB_ClearBreakpoints()
^z::VMB_Undo()
^y::VMB_Redo()
^=::VMB_Zoom(1)
^NumpadAdd::VMB_Zoom(1)
^-::VMB_Zoom(-1)
^NumpadSub::VMB_Zoom(-1)
^0::VMB_Zoom(0)
#HotIf

; @summary Returns the editor's state object (macro, file, tree item map, drag state, GUI controls).
; @tags macro, gui, blocks
VMB() {
    static s := {Macro: 0, Path: "", Dirty: false, ConvertedFrom: "", Gui: 0, TV: 0, Pal: 0, SB: 0, Ctl: Map(),
        Bottom: [], Panel: 0, Banner: 0, BannerText: 0, Dir: "", Ini: "", Items: Map(), NodeItem: Map(),
        FlatIndex: Map(), PalItems: Map(), Drag: 0, RecSteps: 0, RecTarget: 0, DataCache: Map(),
        ItemColor: Map(), PalColor: Map(), PalDesc: Map(), Undo: [], Redo: [], Clip: "", PlayFlat: [], HiItem: 0,
        FontSize: 9, Checked: Map(), AnchorNode: 0, CloseNotified: false, AutoSavePath: "", LastSavedAt: "",
        LastEditedStep: "", IdleHud: 0, QuickLookGui: 0, Insp: 0, InspShown: 1, ShowMeaning: 1,
        Easy: 1, FullPos: 0, PinHwnd: 0, Lbl: Map(), RecWasEmpty: false, AppShow: 0, LastNotes: Map(),
        Columns: 1, ColApp: 0, ColStarts: 0, IndentChars: 3, IndentSeen: ""}
    return s
}

; @summary Startup: VisualFind's own hotkeys off, window + tray, reopen the last macro.
; @tags macro, gui, blocks
VMB_Main() {
    s := VMB()
    OnExit(VMB_OnExit)
    s.Dir := A_MyDocuments . "\VisualMacros"
    s.Ini := s.Dir . "\VisualMacroBlocksV10.ini"
    s.AutoSavePath := s.Dir . "\autosave-session-V18.vmacro.json"
    if !DirExist(s.Dir)
        DirCreate(s.Dir)
    for older in ["V17", "V16", "V15"]
        if !FileExist(s.AutoSavePath) && FileExist(s.Dir . "\autosave-session-" . older . ".vmacro.json")
            try FileCopy(s.Dir . "\autosave-session-" . older . ".vmacro.json", s.AutoSavePath)
    for older in ["V9", "V8", "V7", "V6", "V5", "V4"]
        if !FileExist(s.Ini) && FileExist(s.Dir . "\VisualMacroBlocks" . older . ".ini")
            try FileCopy(s.Dir . "\VisualMacroBlocks" . older . ".ini", s.Ini)     ; carry older settings over once
    VM_Config().LogPath := s.Dir . "\last-playback.log"
    s.Macro := VMF_NewMacro()
    VMB_BuildGui()
    VMB_BuildTray()
    last := IniRead(s.Ini, "Blocks", "LastFile", "")
    if A_Args.Length && FileExist(A_Args[1])
        last := A_Args[1]
    if last != "" && FileExist(last) {
        try VMB_LoadFile(last)
        catch as err
            VMB_Status("Could not reopen " . last . ": " . err.Message)
    } else if FileExist(s.AutoSavePath) {
        try {
            s.Macro := VM_Load(s.AutoSavePath)
            VMB_Status("Restored your unsaved draft from the last session (" . s.AutoSavePath . ").")
        }
    }
    VMB_SettingsToControls()
    V7_LoadMemoryBar()
    VMB_Refresh()
    V17_ApplyMode()
    s.Gui.Show("w" . Min(1640, A_ScreenWidth - 60) . " h" . (A_ScreenHeight >= 1000 ? 840 : 755))
    if !s.Easy && IniRead(s.Ini, "V7", "ShowHud", 1)
        V7_EnsureIdleHud()
    if !s.Macro["blocks"].Length
        VMB_Status(s.Easy ? "Easy mode: 1) Record   2) do the task   3) click the red REC bar to stop   4) Play.    'More features ▸' shows everything."
            : "Drag a block (left) into the macro, press Record (Ctrl+Shift+R), or press Ctrl+K to search any action."
            . "  Close (X) keeps running in the tray.")
}

; @summary Builds the window: toolbar, file row, ADHD memory bar, data row, block palette, macro tree and step tools.
; @tags macro, gui, blocks
VMB_BuildGui() {
    s := VMB()
    s.Easy := Integer(IniRead(s.Ini, "V17", "EasyMode", 1)) ? 1 : 0
    g := Gui("+Resize +MinSize1270x630", "Visual Macro Blocks V22")
    g.SetFont("s9", "Segoe UI")
    c := s.Ctl, lbl := s.Lbl
    c["Record"] := g.AddButton("xm ym w105 h30", "&Record")
    c["Stop"] := g.AddButton("x+6 w65 h30", "&Stop")
    c["Play"] := g.AddButton("x+6 w65 h30", "&Play")
    c["Step"] := g.AddButton("x+6 w96 h30", "Step &by step")
    c["PlaySel"] := g.AddButton("x+6 w96 h30", "Play se&lected")
    c["Pause"] := g.AddButton("x+6 w110 h30 Disabled", "Pause recording")
    c["HudBtn"] := g.AddButton("x+8 w86 h30", "Float &HUD")
    c["CmdBtn"] := g.AddButton("x+6 w110 h30", "⌘ &Command...")
    lbl["Speed"] := g.AddText("x+10 yp+8", "Speed")
    c["Speed"] := g.AddDropDownList("x+4 yp-4 w175", ["Auto (waits for the screen to settle)", "Max (no pauses)",
        "Fast (25% of recorded pauses)", "Normal (recorded pauses)", "Slow (2x pauses, at least 0.75 s)",
        "Very slow (3x pauses, at least 2 s)"])
    lbl["OnFail"] := g.AddText("x+10 yp+4", "If not found")
    c["OnFail"] := g.AddDropDownList("x+4 yp-4 w145", ["Ask me", "Click recorded spot", "Skip step",
        "Skip the row (data runs)", "Stop"])
    c["Help"] := g.AddButton("x+8 yp-1 w28", "?")
    c["Grid"] := g.AddButton("x+6 w82", "Step &grid...")
    c["DetLab"] := g.AddButton("x+6 w82", "🧭 &Lab...")
    c["EasyToggle"] := g.AddButton("x+6 w96", "◂ Easy mode")

    c["New"] := g.AddButton("xm y+12 w56", "&New")
    c["Open"] := g.AddButton("x+6 w66", "&Open...")
    c["Recent"] := g.AddButton("x+4 w74", "Re&cent ▾")
    c["Save"] := g.AddButton("x+6 w56", "Sa&ve")
    c["SaveAs"] := g.AddButton("x+6 w76", "Save &as...")
    c["Export"] := g.AddButton("x+6 w100", "E&xport player...")
    c["Folders"] := g.AddButton("x+6 w86", "&Folders ▾")
    c["MemHub"] := g.AddButton("x+6 w122", "🧠 &Where Was I?")
    c["PauseInput"] := g.AddCheckbox("x+12 yp+5", "Pause if I touch mouse/keys")
    c["Hide"] := g.AddCheckbox("x+12", "Hide while busy")
    c["Hide"].Value := IniRead(s.Ini, "Blocks", "HideWhileBusy", 1)
    c["AutoSave"] := g.AddCheckbox("x+12", "Auto-save")
    c["AutoSave"].Value := IniRead(s.Ini, "V7", "AutoSave", 1)
    c["LockSize"] := g.AddCheckbox("x+12", "Lock window size")
    lbl["Target"] := g.AddText("x+12", "Macro window")
    c["DefaultTarget"] := g.AddEdit("x+4 yp-4 w170", "")
    DllCall("SendMessage", "Ptr", c["DefaultTarget"].Hwnd, "UInt", 0x1501, "Ptr", 1, "WStr", "e.g. ahk_exe notepad.exe")
    c["PickTarget"] := g.AddButton("x+4 yp-1 w44", "Pick")

    ; V7 ADHD Working-Memory Bar: always visible at a glance so you never forget what you were doing or which files you used.
    g.SetFont("s9 bold", "Segoe UI")
    lbl["Goal"] := g.AddText("xm y+12 w95 c0A84FF", "Where Was I:")
    g.SetFont("s9 norm", "Segoe UI")
    c["GoalNote"] := g.AddEdit("x+4 yp-3 w470", "")
    DllCall("SendMessage", "Ptr", c["GoalNote"].Hwnd, "UInt", 0x1501, "Ptr", 1,
        "WStr", "Jot what you are doing or next step (auto-saved with macro & remembered tomorrow)...")
    c["PinWin"] := g.AddButton("x+6 yp-1 w120", "📌 Pin active app")
    c["JumpPin"] := g.AddButton("x+4 w110", "↗ Open pinned")
    c["PickWin"] := g.AddButton("x+10 w120", "📐 Pick window")
    c["AutoNorm"] := g.AddCheckbox("x+10 yp+5", "Normalize new windows while recording")
    c["AutoNorm"].Value := IniRead(s.Ini, "V17", "NormalizeOnSwitch", 1)
    c["Steady"] := g.AddCheckbox("x+10 yp", "Steady playback")
    c["SizeStop"] := g.AddCheckbox("x+10 yp", "Stop if a window can't take its size")
    c["WhereInfo"] := g.AddText("x+10 yp w430 c606060 +0x4000", "")

    lbl["Data"] := g.AddText("xm y+14", "Data rows:")
    c["DataPath"] := g.AddEdit("x+6 yp-3 w400 ReadOnly", "")
    c["DataPick"] := g.AddButton("x+6 yp-1 w95", "Choose &file...")
    c["DataPaste"] := g.AddButton("x+6 w85", "Paste list...")
    c["DataClear"] := g.AddButton("x+6 w55", "Clear")
    lbl["Header"] := g.AddText("x+14 yp+5", "Header:")
    c["Header"] := g.AddDropDownList("x+6 yp-4 w180", ["Detect automatically", "First row = column names",
        "No header row (a plain list)"])
    lbl["Rows"] := g.AddText("x+12 yp+4", "Rows")
    c["RowFrom"] := g.AddEdit("x+4 yp-3 w50 Number")
    lbl["RowsTo"] := g.AddText("x+4 yp+3", "to")
    c["RowTo"] := g.AddEdit("x+4 yp-3 w50 Number")
    c["DataInfo"] := g.AddText("xm y+10 w1140", "")

    g.SetFont("s9 bold")
    lbl["HdrBlocks"] := g.AddText("xm y+8 w200", "Blocks")
    lbl["HdrMacro"] := g.AddText("x+10 w90", "Your macro")
    g.SetFont("s9 norm")
    c["Undo"] := g.AddButton("x+6 yp-4 w60 h24", "Undo")
    c["Redo"] := g.AddButton("x+4 w60 h24", "Redo")
    c["Code"] := g.AddButton("x+14 w100 h24", "&Code view...")
    c["ZoomOut"] := g.AddButton("x+14 w30 h24", "A-")
    c["ZoomIn"] := g.AddButton("x+4 w30 h24", "A+")
    lbl["Find"] := g.AddText("x+20 yp+4", "New clicks find by:")
    c["DefaultFind"] := g.AddDropDownList("x+6 yp-4 w190", ["Picture (follows moved windows)",
        "Coordinates (recorded spot)"])
    c["Web"] := g.AddButton("x+10 w100 h24", "Web / CDP...")
    c["Web"].OnEvent("Click", V4_WebPanel)
    s.InspShown := Integer(IniRead(s.Ini, "V13", "ShowSettingsPanel", 1))
    s.ShowMeaning := Integer(IniRead(s.Ini, "V13", "ExplainSteps", 1))
    s.Columns := Integer(IniRead(s.Ini, "V22", "Columns", 1)) ? 1 : 0          ; V22: step list in fixed columns
    c["InspToggle"] := g.AddButton("x+6 w120 h24", s.InspShown ? "Settings panel ◂" : "Settings panel ▸")
    c["InspToggle"].OnEvent("Click", V13_ToggleInspector)
    c["Search"] := g.AddEdit("xm y+6 w230")
    DllCall("SendMessage", "Ptr", c["Search"].Hwnd, "UInt", 0x1501, "Ptr", 1, "WStr", "Search blocks...")  ; EM_SETCUEBANNER
    c["Search"].GetPos(&sx, &sy)
    s.Pal := g.AddTreeView("xm y+4 w230 h372")
    c["ColHead"] := g.AddText("x" . (sx + 240) . " y" . sy . " w940 h16 c606060", "")     ; V22: column names above the tree
    s.TV := g.AddTreeView("x" . (sx + 240) . " y" . (sy + 16) . " w940 h384 Checked")
    s.FontSize := Integer(IniRead(s.Ini, "Blocks", "FontSize", 9))
    V22_ApplyTreeFont(false)            ; V22: Consolas + exact indent in column mode
    V13_BuildInspector(g)
    c["Edit"] := g.AddButton("xm w62", "&Edit...")
    c["Vary"] := g.AddButton("x+5 w118", "⚡ &Vary + Loop...")
    c["QuickLook"] := g.AddButton("x+5 w80", "&Quick Look")
    c["Test"] := g.AddButton("x+5 w78", "&Test target")
    c["Picture"] := g.AddButton("x+5 w92", "New pict&ure...")
    c["Delete"] := g.AddButton("x+5 w56", "&Delete")
    c["Dup"] := g.AddButton("x+5 w68", "Duplicate")
    c["Disable"] := g.AddButton("x+5 w96", "Disable / enable")
    c["Up"] := g.AddButton("x+10 w64", "&Move up")
    c["Down"] := g.AddButton("x+5 w74", "Move do&wn")
    c["In"] := g.AddButton("x+5 w104", "&Into block above")
    c["Out"] := g.AddButton("x+5 w86", "Out of bloc&k")
    c["WinMatch"] := g.AddDropDownList("x+10 w195", ["Window: exact (title must match)",
        "Window: any window of the program", "Window: whatever is active"])
    for name in ["Edit", "Vary", "QuickLook", "Test", "Picture", "Delete", "Dup", "Disable", "Up", "Down", "In", "Out", "WinMatch"]
        s.Bottom.Push(c[name])
    c["WinInfo"] := g.AddText("x0 y0 w700 h20 Hidden c404040", "")     ; Easy mode only; V17_ApplyMode places it
    s.SB := g.AddStatusBar(, "Ready.")

    VMB_FillPalette()
    c["Record"].OnEvent("Click", VMB_ToggleRecord)
    c["Stop"].OnEvent("Click", VMB_StopAny)
    c["Play"].OnEvent("Click", (*) => VMB_Play())
    c["Step"].OnEvent("Click", (*) => VMB_Play(false, "step"))
    c["PlaySel"].OnEvent("Click", (*) => VMB_Play(true))
    c["Pause"].OnEvent("Click", VMB_TogglePause)
    c["HudBtn"].OnEvent("Click", V7_ToggleIdleHud)
    c["CmdBtn"].OnEvent("Click", V7_CommandPalette)
    c["Help"].OnEvent("Click", VMB_Help)
    c["Grid"].OnEvent("Click", VMB_StepGrid)
    c["DetLab"].OnEvent("Click", V10_ShowDeterministicLab)
    c["EasyToggle"].OnEvent("Click", V17_ToggleEasy)
    c["PickWin"].OnEvent("Click", V17_PickWindow)
    c["AutoNorm"].OnEvent("Click", (ctl, *) => IniWrite(ctl.Value, s.Ini, "V17", "NormalizeOnSwitch"))
    for name in ["Speed", "OnFail"]
        c[name].OnEvent("Change", VMB_OnSettingChanged)
    c["DefaultFind"].OnEvent("Change", VMB_OnDefaultFindChanged)
    c["PauseInput"].OnEvent("Click", VMB_OnSettingChanged)
    c["LockSize"].OnEvent("Click", VMB_OnSettingChanged)
    c["Steady"].OnEvent("Click", VMB_OnSettingChanged)
    c["SizeStop"].OnEvent("Click", VMB_OnSettingChanged)
    c["DefaultTarget"].OnEvent("Change", VMB_OnSettingChanged)
    c["PickTarget"].OnEvent("Click", V16_PickDefaultTarget)
    c["RowFrom"].OnEvent("Change", VMB_OnSettingChanged)
    c["RowTo"].OnEvent("Change", VMB_OnSettingChanged)
    c["Hide"].OnEvent("Click", (ctl, *) => IniWrite(ctl.Value, s.Ini, "Blocks", "HideWhileBusy"))
    c["AutoSave"].OnEvent("Click", (ctl, *) => IniWrite(ctl.Value, s.Ini, "V7", "AutoSave"))
    c["GoalNote"].OnEvent("Change", V7_OnGoalChanged)
    c["PinWin"].OnEvent("Click", V7_PinActiveContext)
    c["JumpPin"].OnEvent("Click", V7_OpenPinnedMenu)
    c["New"].OnEvent("Click", VMB_New)
    c["Open"].OnEvent("Click", VMB_Open)
    c["Recent"].OnEvent("Click", V7_ShowRecentMenu)
    c["Save"].OnEvent("Click", (*) => VMB_SaveTo(s.Path))
    c["SaveAs"].OnEvent("Click", (*) => VMB_SaveAs())
    c["Export"].OnEvent("Click", VMB_ExportPlayer)
    c["Folders"].OnEvent("Click", V7_ShowFoldersMenu)
    c["MemHub"].OnEvent("Click", V7_MemoryHub)
    c["DataPick"].OnEvent("Click", VMB_ChooseData)
    c["DataPaste"].OnEvent("Click", VMB_PasteData)
    c["DataClear"].OnEvent("Click", VMB_ClearData)
    c["Header"].OnEvent("Change", VMB_OnHeaderChanged)
    c["Edit"].OnEvent("Click", VMB_EditSelected)
    c["Vary"].OnEvent("Click", V8_VarySelectedDialog)
    c["QuickLook"].OnEvent("Click", V7_QuickLook)
    c["Test"].OnEvent("Click", VMB_TestSelected)
    c["Picture"].OnEvent("Click", VMB_NewPicture)
    c["Delete"].OnEvent("Click", VMB_DeleteSelected)
    c["Up"].OnEvent("Click", (*) => VMB_MoveSelected(-1))
    c["Down"].OnEvent("Click", (*) => VMB_MoveSelected(1))
    c["In"].OnEvent("Click", VMB_Indent)
    c["Out"].OnEvent("Click", VMB_Outdent)
    c["Dup"].OnEvent("Click", VMB_Duplicate)
    c["Disable"].OnEvent("Click", VMB_ToggleDisabled)
    c["Undo"].OnEvent("Click", VMB_Undo)
    c["Redo"].OnEvent("Click", VMB_Redo)
    c["Code"].OnEvent("Click", VMB_CodeView)
    c["ZoomOut"].OnEvent("Click", (*) => VMB_Zoom(-1))
    c["ZoomIn"].OnEvent("Click", (*) => VMB_Zoom(1))
    c["Search"].OnEvent("Change", (ctl, *) => VMB_FillPalette(ctl.Value))
    s.TV.OnEvent("DoubleClick", VMB_EditSelected)
    s.TV.OnEvent("ContextMenu", VMB_TreeMenu)
    s.TV.OnEvent("ItemSelect", (*) => (VMB_SyncWinMatch(), V7_RefreshQuickLookIfOpen(), V13_InspLoad(), V22_ShowDetail()))
    s.TV.OnEvent("ItemCheck", VMB_OnItemCheck)
    s.TV.OnEvent("Click", VMB_OnTreeClick)
    c["WinMatch"].OnEvent("Change", (ctl, *) => ctl.Value ? VMB_SetWinMatch(["", "program", "active"][ctl.Value]) : 0)
    s.Pal.OnEvent("DoubleClick", VMB_PaletteDoubleClick)
    s.Pal.OnEvent("ItemSelect", (ctl, item) => VMB_Status(s.PalDesc.Get(item, "")))
    s.TV.OnNotify(-456, VMB_OnBeginDrag)     ; TVN_BEGINDRAGW
    s.Pal.OnNotify(-456, VMB_OnBeginDrag)
    s.TV.OnNotify(-12, VMB_OnCustomDraw)     ; NM_CUSTOMDRAW: category colours
    s.Pal.OnNotify(-12, VMB_OnCustomDraw)
    g.OnEvent("Size", VMB_OnSize)
    g.OnEvent("Close", VMB_OnClose)
    s.Gui := g
}

; @summary Fills the block palette (toolbox) by category like MakeCode - Loops, Logic, Control, Actions, Waits. filter
;          (the search box) keeps only blocks whose name, description or category contains the text.
; @tags macro, gui, blocks, makecode
VMB_FillPalette(filter := "") {
    s := VMB()
    pal := s.Pal
    pal.Opt("-Redraw")
    pal.Delete()
    s.PalItems := Map(), s.PalColor := Map(), s.PalDesc := Map()
    for group in (s.Easy ? V17_EasyPaletteGroups() : VMB_PaletteGroups()) {
        parent := 0
        for item in group[2] {
            if filter != "" && !InStr(item[1], filter) && !InStr(item[3], filter) && !InStr(group[1], filter)
                continue
            if !parent {
                parent := pal.Add(group[1], 0, "Bold Expand")
                s.PalColor[parent] := VMB_KindColor(item[2])
            }
            id := pal.Add(item[1], parent)
            s.PalItems[id] := item[2]
            s.PalColor[id] := VMB_KindColor(item[2])
            s.PalDesc[id] := item[3]
        }
    }
    pal.Opt("+Redraw")
}

; @summary Palette contents: [category, [[label, kind, description], ...]].
; @tags macro, gui, blocks, makecode
VMB_PaletteGroups() {
    static groups := [
        ["Loops", [
            ["Repeat N times", "repeat", "Runs the blocks inside a set number of times. Type steps can use {{index}} (the round)."],
            ["For i from 1 to N...", "for", "Counts a variable from one number to another (step 1, 2, -1...); use it as {{i}}."],
            ["Repeat until an image appears...", "until", "While-loop: checks first, runs the blocks inside until a picture shows up."],
            ["Repeat while an image is there...", "while", "While-loop: runs the blocks inside while a picture is still on screen."],
            ["Repeat until a variable...", "untilvar", "While-loop on a variable, e.g. until count >= 10."],
            ["Do ... until (runs at least once)...", "dountil", "Do-while: runs the blocks first, then checks an image or a variable."],
            ["For each data row", "foreach", "Runs the blocks inside once per row of the data file; Type steps use {{Column}}."]]],
        ["Logic", [
            ["If an image is there / Else...", "if", "Runs the IF blocks when a picture is on screen, otherwise the ELSE blocks."],
            ["If a variable... / Else", "ifvar", "Runs the IF blocks when a variable matches, e.g. count = 3 or name is empty."],
            ["Else if... (add to the selected If)", "elif", "Adds an ELSE IF part to the selected If block (image or variable)."]]],
        ["Variables", [
            ["Set variable...", "set", "Stores a value (number, text, {{clipboard}}, {{Column}}...) to use later as {{name}};"
                . " can ask you for the value when the macro starts."],
            ["Change variable by...", "change", "Adds a number to a variable (use -1 to count down)."],
            ["NDC from barcode scan...", "ndc", "Asks the tech to scan a drug barcode (or uses {{clipboard}} / a column),"
                . " pads it to the 11-digit NDC using the FDA NDC list and stores it (no dashes) as {{name}}."]]],
        ["Control", [
            ["Ask me (checkpoint)", "ask", "Pauses and asks: Continue, Skip this row or Stop."],
            ["Exit loop / next round / skip row / end / stop", "stop", "Leaves the loop, jumps to the next round,"
                . " skips the data row, ends the run or stops."],
            ["Run another macro...", "call", "Runs a saved macro here, like a function; it uses the current data row."],
            ["Ask for the data file (CSV)...", "pickdata", "When the macro starts, asks which data file to use - only the"
                . " file type you pick, with the columns it needs. Use it so an exported player works on any PC."]]],
        ["Actions", [
            ["Click a spot (point + F6)", "click", "Clicks a spot you point at; it is found again by its picture."],
            ["Type text...", "text", "Types text; can use {{Column}}, {{variable}}, {{index}}, {{row}}, {{date}}."],
            ["Press keys...", "keys", "Presses keys such as {Enter}, {Tab} or ^s."]]],
        ["Waits", [
            ["Wait for an image...", "wait", "Waits until a picture appears (or goes away)."],
            ["Delay...", "delay", "Waits a fixed number of milliseconds."]]]]
    out := [], extras := V4_PaletteExtra()
    for group in extras
        if InStr(group[1], "V10") || InStr(group[1], "Deterministic") || InStr(group[1], "input") || InStr(group[1], "Input")
            out.Push(group)
    for group in groups
        out.Push(group)
    for group in extras
        if SubStr(group[1], 1, 3) = "Web"
            out.Push(group)
    return out
}

; @summary MakeCode-style category colours [text, background] (COLORREF 0xBBGGRR) for a block kind; disabled = grey.
; @tags macro, gui, blocks, makecode
VMB_KindColor(kind, disabled := false) {
    if !disabled && SubStr(kind, 1, 4) = "det_"
        return [0xFFFFFF, 0x7A4B00]
    if !disabled && SubStr(kind, 1, 6) = "input_"
        return [0xFFFFFF, 0xA46C28]
    if !disabled && SubStr(kind, 1, 4) = "web_"
        return [0xFFFFFF, 0x84602B]
    static cats := Map("repeat", "loops", "for", "loops", "until", "loops", "while", "loops", "untilvar", "loops",
        "dountil", "loops", "foreach", "loops", "if", "logic", "ifvar", "logic", "elif", "logic", "else", "logic",
        "check", "logic", "set", "variables", "change", "variables", "ndc", "variables", "ask", "control", "stop", "control", "call", "control",
        "pickdata", "control",
        "click", "actions", "drag", "actions", "wheel", "actions", "text", "actions", "keys", "actions", "wait", "waits",
        "delay", "waits")
    static back := Map("loops", 0x00AA00, "logic", 0xA6A400, "variables", 0x3C14DC, "control", 0x227EE6,
        "actions", 0xFF901E, "waits", 0xD30094)
    if disabled
        return [0x707070, 0xE6E6E6]
    return [0xFFFFFF, back.Get(cats.Get(kind, "actions"), 0x808080)]
}

; @summary NM_CUSTOMDRAW for the palette and macro tree: paints each line in its category colour. The selected line
;          and the drop target keep the normal highlight; the step running right now is yellow.
; @tags macro, gui, blocks, makecode
VMB_OnCustomDraw(ctl, lParam) {
    s := VMB()
    x64 := A_PtrSize = 8
    stage := NumGet(lParam, x64 ? 24 : 12, "UInt")
    if stage = 1                                ; CDDS_PREPAINT
        return 0x20                             ; CDRF_NOTIFYITEMDRAW
    if stage != 0x10001                         ; CDDS_ITEMPREPAINT
        return 0
    item := NumGet(lParam, x64 ? 56 : 36, "UPtr")
    state := NumGet(lParam, x64 ? 64 : 40, "UInt")
    off := x64 ? 80 : 48                        ; NMTVCUSTOMDRAW.clrText, clrTextBk
    if ctl = s.TV && item = s.HiItem {
        NumPut("UInt", 0x000000, "UInt", 0x00FFFF, lParam, off)
        return 0x2                              ; CDRF_NEWFONT
    }
    if state & 0x1000                           ; CDIS_DROPHILITED
        return 0
    if ctl = s.TV && state & 0x1 {              ; CDIS_SELECTED: black, so it stands out from the blue step lines
        NumPut("UInt", 0xFFFFFF, "UInt", 0x000000, lParam, off)
        return 0x2
    }
    if state & 0x1
        return 0
    colors := (ctl = s.Pal ? s.PalColor : s.ItemColor).Get(item, 0)
    if !colors
        return 0
    NumPut("UInt", colors[1], "UInt", colors[2], lParam, off)
    return 0x2
}

; @summary Keeps the palette, tree and bottom buttons sized to the window.
; @tags macro, gui
VMB_OnSize(g, minMax, w, h) {
    if minMax = -1
        return
    s := VMB()
    s.TV.GetPos(&tx, &ty)
    s.Pal.GetPos(&px, &py)
    bottomY := h - 62
    height := Max(80, bottomY - ty - 8)
    s.Pal.Move(, , , Max(60, bottomY - py - 8))
    inspW := s.Insp && s.InspShown ? s.Insp.Width : 0
    treeW := Max(200, w - tx - px - (inspW ? inspW + 10 : 0))
    s.TV.Move(, , treeW, height)
    if s.Insp
        V13_InspLayout(tx + treeW + 10, ty, s.Insp.Width, height)
    s.Ctl["DataInfo"].Move(, , Max(100, w - 2 * px))
    if s.Ctl.Has("WhereInfo") {
        s.Ctl["WhereInfo"].GetPos(&wx)
        s.Ctl["WhereInfo"].Move(, , Max(80, w - wx - px))
    }
    if s.Easy && s.Ctl.Has("WinInfo") {
        s.Ctl["WinInfo"].GetPos(&ix)
        s.Ctl["WinInfo"].Move(, , Max(80, w - ix - px))
    }
    for ctl in s.Bottom {
        ctl.GetPos(&cx)
        ctl.Move(cx, bottomY)
    }
    V22_PlaceHeader()
}

; @summary Short usage tips.
; @tags macro, gui
VMB_Help(*) {
    if VMB().Easy
        return V17_EasyHelp()
    V4_Help()
}

; ============================================================================
; Macro tree
; ============================================================================

; @summary Rebuilds the macro tree from the block model and reselects a node (default: the selected one).
; @tags macro, gui, blocks
VMB_Refresh(selectNode := "") {
    s := VMB()
    tv := s.TV
    if !IsObject(selectNode) {
        info := VMB_SelectedInfo()
        selectNode := info && info.HasOwnProp("Node") ? info.Node : ""
    }
    s.FlatIndex := Map()
    for i, step in VMF_Flatten(s.Macro["blocks"])
        s.FlatIndex[step] := i
    s.AppShow := V21_AppRuns(VMF_Flatten(s.Macro["blocks"]))     ; V21: say the program only when it changes
    r := V22_FillApps(VMF_Flatten(s.Macro["blocks"]), s.Macro["settings"])     ; V22: the Program column, every row
    s.ColApp := r.App, s.ColStarts := r.Starts
    tv.Opt("-Redraw")
    tv.Delete()
    s.Items := Map(), s.NodeItem := Map(), s.ItemColor := Map(), s.HiItem := 0
    VMB_AddBody(s.Macro["blocks"], 0, 0, "(empty - drag blocks here, or press Record)")
    tv.Opt("+Redraw")
    if IsObject(selectNode) && s.NodeItem.Has(selectNode)
        tv.Modify(s.NodeItem[selectNode], "Select Vis")
    VMB_UpdateTitle()
    V13_InspLoad()
    V17_UpdateWinInfo()
    V22_PlaceHeader()
}

VMB_AddBody(list, parentId, owner, emptyText := "(empty - drag steps here)", off := false, depth := 0) {
    s := VMB()
    cols := s.Columns && s.ShowMeaning              ; V22: depth = tree level of the rows added here
    if !list.Length {
        id := s.TV.Add(emptyText, parentId)
        s.Items[id] := {Kind: "empty", List: list, Owner: owner}
        s.ItemColor[id] := [0x909090, 0xFFFFFF]
        return
    }
    for i, node in list {
        isBox := VMF_IsContainer(node)
        nodeOff := off || node.Get("disabled", 0)
        id := s.TV.Add(VMB_NodeLabel(node, depth), parentId, isBox ? "Bold Expand" : "")
        s.Items[id] := {Kind: "node", Node: node, List: list, Index: i, Owner: owner}
        s.NodeItem[node] := id
        if s.Checked.Has(node)
            s.TV.Modify(id, "Check")
        s.ItemColor[id] := VMB_KindColor(node.Get("type", ""), nodeOff)
        if isBox {
            VMB_AddBody(node["body"], id, node, , nodeOff, depth + 1)
            if node["type"] = "if" {
                VMF_Children(node)
                prev := node["body"]
                for k, elif in VMF_Elifs(node) {
                    label := (cols ? V22_Margin(depth + 1, s.IndentChars) : " ") . "ELSE IF " . VMF__CondText(elif)
                        . (elif.Get("cond", "image") = "image" ? "      [image " . VM__TargetText(elif) . "]" : "") . " "
                    elifId := s.TV.Add(label, id, "Bold Expand")
                    s.Items[elifId] := {Kind: "elif", Node: node, Elif: elif, Index: k, List: elif["body"], Prev: prev,
                        Owner: node}
                    s.ItemColor[elifId] := VMB_KindColor("elif", nodeOff)
                    VMB_AddBody(elif["body"], elifId, node, , nodeOff, depth + 2)
                    prev := elif["body"]
                }
                elseId := s.TV.Add((cols ? V22_Margin(depth + 1, s.IndentChars) : " ") . "ELSE (when none of the above is true) ", id, "Bold Expand")
                s.Items[elseId] := {Kind: "else", Node: node, List: node["else"], Prev: prev, Owner: node}
                s.ItemColor[elseId] := VMB_KindColor("else", nodeOff)
                VMB_AddBody(node["else"], elseId, node, , nodeOff, depth + 2)
            }
        }
    }
}

; @summary Tree label: "#3   Click  ...   [exe - title]" for steps, the block text for control blocks; "(off)" when disabled.
; @tags macro, gui, blocks
VMB_NodeLabel(node, depth := unset) {
    s := VMB()
    off := (node.Get("breakpoint", 0) ? "●  " : "") . (node.Get("disabled", 0) ? "(off)  " : "")
    cols := s.Columns && s.ShowMeaning              ; V22: fixed columns
    if cols && !IsSet(depth)
        depth := s.NodeItem.Has(node) ? V22_DepthOf(s.NodeItem[node]) : 0
    if VMF_IsStep(node) {
        num := s.FlatIndex.Get(node, "?"), lastNote := s.LastNotes.Get(num, "")      ; V21: a note in the last run
        if cols
            return V22_Row(num, s.ColApp is Map ? s.ColApp.Get(node, "") : "", s.ColStarts is Map && s.ColStarts.Has(node),
                V22_WaitText(node), V22_Marks(node, lastNote), off . V22_Sentence(node, lastNote), depth, s.IndentChars) . " "
        mark := lastNote = "" ? "" : " ⚠", noteTag := lastNote = "" ? "" : V21_NoteTag(lastNote)
        line := s.ShowMeaning ? V20_StepLine(node) : ""        ; V20: one plain sentence per step
        if line != ""
            return " " . off . "#" . num . mark . "    " . line . noteTag . " "
        sum := VM_StepSummary(node)
        meaning := s.ShowMeaning ? V13_StepMeaning(node) : ""
        return " " . off . "#" . num . mark . "    " . sum[1] . (sum[3] != "" ? "   " . sum[3] : "")
            . (meaning != "" ? "   → " . meaning : "")
            . (sum[2] != "" ? "      [" . sum[2] . "]" : "") . (s.ShowMeaning ? V13_StepBadges(node) : "") . noteTag . " "
    }
    text := s.ShowMeaning ? V21_BlockLine(node) : VMF_BlockText(node)      ; V21: same plain style as the step lines
    t := node.Get("type", "")
    if t = "foreach" && !VMB_HasData()
        text .= "      (choose a data file above!)"
    if (t = "until" || t = "if") && node.Get("cond", "image") = "image"
        text .= "      [image " . VM__TargetText(node) . "]"
    if cols
        return V22_Margin(depth, s.IndentChars) . off . text . " "
    return " " . off . text . " "
}

; @summary Info for the selected tree item ({Kind "node"|"else"|"empty", Node, List, Index, Owner}) or 0.
; @tags macro, gui, blocks
VMB_SelectedInfo() {
    s := VMB()
    return s.TV ? s.Items.Get(s.TV.GetSelection(), 0) : 0
}

; @summary Selected node (a step or block), or 0 with a status message.
; @tags macro, gui, blocks
VMB_SelectedNode(what := "a step or block") {
    info := VMB_SelectedInfo()
    if !info || info.Kind != "node" {
        VMB_Status("Select " . what . " first.")
        return 0
    }
    return info
}

; @summary Where new blocks go: inside a selected loop/if (at its end), after a selected step, or at the end.
; @returns {List, Index}
; @tags macro, gui, blocks
VMB_InsertPoint() {
    s := VMB()
    info := VMB_SelectedInfo()
    blocks := s.Macro["blocks"]
    if !info
        return {List: blocks, Index: blocks.Length + 1}
    switch info.Kind {
        case "empty":
            return {List: info.List, Index: 1}
        case "else", "elif":
            return {List: info.List, Index: info.List.Length + 1}
    }
    if VMF_IsContainer(info.Node) {
        body := VMF_Children(info.Node)[1]
        return {List: body, Index: body.Length + 1}
    }
    return {List: info.List, Index: info.Index + 1}
}

; @summary Inserts a node into a list at index, marks the macro changed and selects it.
; @tags macro, gui, blocks
VMB_InsertNode(node, list, index) {
    s := VMB()
    if node.Get("type", "") = "pickdata" {
        if VMF_DataPickBlock(s.Macro["blocks"])
            return VMB_Status("This macro already has an 'Ask for the data file' block.")
        list := s.Macro["blocks"], index := 1      ; runs when the macro starts, so it always goes first
    }
    VMB_Snapshot()
    list.InsertAt(VF_Clamp(index, 1, list.Length + 1), node)
    s.Dirty := true
    VMB_Refresh(node)
}

; @summary Moves a node (tree info) to list/index; refuses to move a block inside itself.
; @tags macro, gui, blocks
VMB_MoveNode(info, list, index) {
    s := VMB()
    node := info.Node
    if VMB_ListInside(node, list)
        return VMB_Status("A block cannot go inside itself.")
    from := info.List, fromIdx := info.Index
    if fromIdx > from.Length || from[fromIdx] != node
        return VMB_Refresh()
    if from = list && (index = fromIdx || index = fromIdx + 1)
        return
    VMB_Snapshot()
    from.RemoveAt(fromIdx)
    if from = list && fromIdx < index
        index -= 1
    list.InsertAt(VF_Clamp(index, 1, list.Length + 1), node)
    s.Dirty := true
    VMB_Refresh(node)
}

; @summary Moves several nodes (in order) to list/index; skips any block the target is inside (e.g. the ticked loop
;          they are being dropped into).
; @tags macro, gui, blocks, drag-drop
VMB_MoveNodes(nodes, list, index) {
    s := VMB()
    moving := [], skipped := 0
    for node in nodes {
        if VMB_ListInside(node, list)
            skipped += 1
        else if s.NodeItem.Has(node)
            moving.Push(node)
    }
    if !moving.Length
        return VMB_Status("A block cannot go inside itself.")
    VMB_Snapshot()
    for node in moving {
        from := s.Items[s.NodeItem[node]].List
        for idx, item in from {
            if item = node {
                from.RemoveAt(idx)
                if from = list && idx < index
                    index -= 1
                break
            }
        }
    }
    index := VF_Clamp(index, 1, list.Length + 1)
    for i, node in moving
        list.InsertAt(index + i - 1, node)
    s.Dirty := true
    VMB_Refresh(moving[1])
    VMB_Status("Moved " . moving.Length . " ticked line(s)." . (skipped ? " (Skipped " . skipped
        . " block(s) the drop spot is inside.)" : "") . "  (Ctrl+Z undoes it.)")
}

; @summary Ticked lines that are not inside another ticked block, in tree order.
; @tags macro, gui, blocks
VMB_TopTicked() {
    s := VMB()
    top := []
    for node in VMB_CheckedNodes() {
        cur := s.Items[s.NodeItem[node]].Owner, insideTicked := false
        while cur {
            if s.Checked.Has(cur) {
                insideTicked := true
                break
            }
            cur := s.NodeItem.Has(cur) ? s.Items[s.NodeItem[cur]].Owner : 0
        }
        if !insideTicked
            top.Push(node)
    }
    return top
}

; @summary True when list is one of node's child lists (at any depth).
; @tags macro, blocks
VMB_ListInside(node, list) {
    for child in VMF_Children(node) {
        if child = list
            return true
        for n in child {
            if VMB_ListInside(n, list)
                return true
        }
    }
    return false
}

; ============================================================================
; Drag and drop (palette -> macro, and moving lines inside the macro)
; ============================================================================

; @summary TVN_BEGINDRAG from the palette or the macro tree: starts polling the mouse until the button is released.
; @tags macro, gui, blocks, drag-drop
VMB_OnBeginDrag(tvCtl, lParam) {
    s := VMB()
    if VM_IsPlaying() || VM_IsRecording() || s.Drag
        return
    item := NumGet(lParam, A_PtrSize = 8 ? 96 : 60, "Ptr")     ; NMTREEVIEWW.itemNew.hItem
    if tvCtl = s.Pal {
        kind := s.PalItems.Get(item, "")
        if kind = ""
            return
        s.Drag := {Source: "palette", Kind: kind, Label: "Add: " . tvCtl.GetText(item), Target: 0, Key: ""}
    } else {
        info := s.Items.Get(item, 0)
        if !info || info.Kind != "node"
            return
        tvCtl.Modify(item, "Select")
        group := s.Checked.Has(info.Node) ? VMB_TopTicked() : []
        label := group.Length > 1 ? "Move " . group.Length . " ticked lines" : "Move: " . SubStr(tvCtl.GetText(item), 1, 60)
        s.Drag := {Source: "tree", Info: info, Group: group, Label: label, Target: 0, Key: ""}
    }
    SetTimer(VMB_DragTick, 30)
}

; @summary Drag polling: shows where the block would land (insert line or highlighted block) and drops on release.
; @tags macro, gui, blocks, drag-drop
VMB_DragTick() {
    s := VMB()
    d := s.Drag
    if !d {
        SetTimer(VMB_DragTick, 0)
        return
    }
    if GetKeyState("Esc", "P")
        return VMB_DragEnd(false)
    target := VMB_DropTarget()
    key := target ? target.Item . "|" . target.Mode : ""
    if key != d.Key {
        d.Key := key
        VMB_ShowDropMark(target)
    }
    d.Target := target
    CoordMode("Mouse", "Screen")
    CoordMode("ToolTip", "Screen")
    MouseGetPos(&mx, &my)
    ToolTip(d.Label . "`n" . (target ? target.Text : "(drop it on the macro tree - Esc cancels)"), mx + 20, my + 20)
    if !GetKeyState("LButton", "P")
        VMB_DragEnd(true)
}

; @summary Where a drop at the mouse would go: {List, Index, Item, Mode "before"|"after"|"inside"|"end", Text} or false.
; @tags macro, gui, blocks, drag-drop
VMB_DropTarget() {
    s := VMB()
    tv := s.TV
    MouseGetPos(, , , &ctlHwnd, 2)
    if ctlHwnd != tv.Hwnd
        return false
    pt := Buffer(8, 0)
    DllCall("GetCursorPos", "Ptr", pt)
    DllCall("ScreenToClient", "Ptr", tv.Hwnd, "Ptr", pt)
    cx := NumGet(pt, 0, "Int"), cy := NumGet(pt, 4, "Int")
    rc := Buffer(16, 0)
    DllCall("GetClientRect", "Ptr", tv.Hwnd, "Ptr", rc)
    if cy < 14
        SendMessage(0x115, 0, 0, tv)        ; WM_VSCROLL SB_LINEUP
    else if cy > NumGet(rc, 12, "Int") - 14
        SendMessage(0x115, 1, 0, tv)        ; SB_LINEDOWN
    hit := Buffer(A_PtrSize = 8 ? 24 : 16, 0)
    NumPut("Int", cx, "Int", cy, hit)
    item := SendMessage(0x1111, 0, hit.Ptr, tv)     ; TVM_HITTEST
    blocks := s.Macro["blocks"]
    if !item
        return {List: blocks, Index: blocks.Length + 1, Item: 0, Mode: "end", Text: "Put at the end of the macro"}
    info := s.Items.Get(item, 0)
    if !info
        return false
    rect := Buffer(16, 0)
    NumPut("Ptr", item, rect)
    SendMessage(0x1104, 0, rect.Ptr, tv)            ; TVM_GETITEMRECT (whole line)
    upper := cy < (NumGet(rect, 4, "Int") + NumGet(rect, 12, "Int")) / 2
    label := SubStr(tv.GetText(item), 1, 50)
    switch info.Kind {
        case "empty":
            return {List: info.List, Index: 1, Item: item, Mode: "inside", Text: "Put it here"}
        case "else", "elif":
            part := info.Kind = "else" ? "ELSE" : "ELSE IF"
            if upper
                return {List: info.Prev, Index: info.Prev.Length + 1, Item: item, Mode: "before", Text: "Put at the end of the part above",
                    IfNode: info.Node}
            return {List: info.List, Index: 1, Item: item, Mode: "inside", Text: "Put first in this " . part . " part",
                IfNode: info.Node}
    }
    if upper
        return {List: info.List, Index: info.Index, Item: item, Mode: "before", Text: "Put before: " . label,
            IfNode: info.Node.Get("type", "") = "if" ? info.Node : 0}
    if VMF_IsContainer(info.Node) {
        body := VMF_Children(info.Node)[1]
        return {List: body, Index: 1, Item: item, Mode: "inside", Text: "Put first inside: " . label,
            IfNode: info.Node.Get("type", "") = "if" ? info.Node : 0}
    }
    return {List: info.List, Index: info.Index + 1, Item: item, Mode: "after", Text: "Put after: " . label, IfNode: 0}
}

; @summary Shows the drop spot: an insert line (before/after) or a highlighted block (inside); false clears it.
; @tags macro, gui, blocks, drag-drop
VMB_ShowDropMark(target) {
    tv := VMB().TV
    SendMessage(0x110B, 8, 0, tv)           ; TVM_SELECTITEM TVGN_DROPHILITE (clear)
    SendMessage(0x111A, 0, 0, tv)           ; TVM_SETINSERTMARK (clear)
    if !target || !target.Item
        return
    if target.Mode = "inside"
        SendMessage(0x110B, 8, target.Item, tv)
    else
        SendMessage(0x111A, target.Mode = "after" ? 1 : 0, target.Item, tv)
}

; @summary Ends a drag: drops (adds a new block from the palette or moves a line) or cancels.
; @tags macro, gui, blocks, drag-drop
VMB_DragEnd(drop) {
    s := VMB()
    SetTimer(VMB_DragTick, 0)
    ToolTip()
    d := s.Drag
    s.Drag := 0
    VMB_ShowDropMark(false)
    if !drop || !d || !d.Target
        return
    t := d.Target
    if d.Source = "palette" && d.Kind = "elif" {
        if t.HasOwnProp("IfNode") && t.IfNode
            VMB_AddElif(t.IfNode)
        else
            VMB_Status("Drop 'Else if' onto an If block (or one of its ELSE IF / ELSE lines).")
    } else if d.Source = "palette" {
        node := VMB_MakeNode(d.Kind)
        if node
            VMB_InsertNode(node, t.List, t.Index)
    } else if d.Group.Length > 1 {
        VMB_MoveNodes(d.Group, t.List, t.Index)
    } else {
        VMB_MoveNode(d.Info, t.List, t.Index)
    }
}

; @summary Double-click in the palette: adds that block at the selected spot of the macro ('Else if' goes onto the
;          selected If block).
; @tags macro, gui, blocks
VMB_PaletteDoubleClick(ctl, item) {
    s := VMB()
    kind := s.PalItems.Get(item, "")
    if kind = "" || VM_IsPlaying() || VM_IsRecording()
        return
    if kind = "elif"
        return VMB_AddElifToSelection()
    where := VMB_InsertPoint()
    node := VMB_MakeNode(kind)
    if node
        VMB_InsertNode(node, where.List, where.Index)
}

; @summary Adds an ELSE IF to the selected If block (or the If of a selected ELSE IF / ELSE line).
; @tags macro, gui, blocks
VMB_AddElifToSelection(*) {
    if VM_IsRecording() || VM_IsPlaying()
        return
    info := VMB_SelectedInfo()
    ifNode := !info ? 0 : info.Kind = "else" || info.Kind = "elif" ? info.Node
        : info.Kind = "node" && info.Node.Get("type", "") = "if" ? info.Node : 0
    if ifNode
        VMB_AddElif(ifNode)
    else
        VMB_Status("Select an If block first, then add 'Else if'.")
}

; @summary Adds an ELSE IF part to an If block: asks for its condition (image or variable), then selects it.
; @tags macro, gui, blocks
VMB_AddElif(ifNode) {
    s := VMB()
    elif := Map("type", "elif", "cond", "var", "name", "", "op", "=", "value", "", "body", [])
    if !VMB_EditBlock(elif, true)
        return
    VMB_Snapshot()
    if !(ifNode.Get("elifs", "") is Array)
        ifNode["elifs"] := []
    ifNode["elifs"].Push(elif)
    s.Dirty := true
    VMB_Refresh(ifNode)
    VMB_Status("Added ELSE IF " . VMF__CondText(elif) . ". Drag steps under it.")
}

; @summary Creates a new block or step of a palette kind, asking for what it needs (count, image, spot, text...).
; @returns node Map, or false when cancelled
; @tags macro, gui, blocks
VMB_MakeNode(kind) {
    s := VMB()
    if V4_WebDefs().Has(kind) || V4_InputDefs().Has(kind) || V10_DetDefs().Has(kind) {
        node := V4_CreateNode(kind)
        return V4_BlockEdit(node) ? node : false
    }
    switch kind {
        case "for":
            node := Map("type", "for", "name", "i", "from", 1, "to", 10, "step", 1, "body", [])
            return VMB_EditBlock(node, true) ? node : false
        case "untilvar", "dountil":
            node := Map("type", "until", "cond", "var", "name", "", "op", ">=", "value", "", "max", 100, "body", [])
            if kind = "dountil"
                node["check"] := "after"
            return VMB_EditBlock(node, true) ? node : false
        case "ifvar":
            node := Map("type", "if", "cond", "var", "name", "", "op", "=", "value", "", "body", [], "else", [])
            return VMB_EditBlock(node, true) ? node : false
        case "set":
            node := Map("type", "set", "name", "", "value", "")
            return VMB_EditBlock(node, true) ? node : false
        case "change":
            node := Map("type", "change", "name", "", "by", 1)
            return VMB_EditBlock(node, true) ? node : false
        case "ndc":
            node := Map("type", "ndc", "name", "ndc", "source", "")
            return VMB_EditBlock(node, true) ? node : false
        case "repeat":
            n := VMB_AskNumber("Repeat how many times?", "Repeat", 3, 1)
            return n = "" ? false : Map("type", "repeat", "count", n, "body", [])
        case "foreach":
            if !VMB_HasData()
                MsgBox("Choose a data file (Data rows, above) so this block has rows to go through.", "For each data row",
                    "Iconi Owner" . s.Gui.Hwnd)
            return Map("type", "foreach", "body", [])
        case "until", "if", "while":
            isWhile := kind = "while"
            kind := isWhile ? "until" : kind
            patternText := VM_UiDragImage(kind = "if" ? "Add 'If an image is there'"
                : isWhile ? "Add 'Repeat while an image is there'" : "Add 'Repeat until an image appears'",
                "Show the image to check for (for example a message, button or icon). After OK this window hides;"
                . " drag a rectangle around the image. Esc cancels.", s.Gui)
            if patternText = "" {
                VMB_Status("No image captured.")
                return false
            }
            try {
                node := VM_NewWaitStep(patternText)
            } catch as err {
                VMB_Status(err.Message)
                return false
            }
            node["type"] := kind
            for key in ["timeoutMs", "gapMs"]
                node.Delete(key)
            node["body"] := []
            if kind = "until"
                node["max"] := 100
            else
                node["else"] := []
            if isWhile
                node["appear"] := 0
            return VMB_EditBlock(node, true) ? node : false
        case "ask":
            answer := InputBox("What should the checkpoint ask you?", "Ask me", "w420 h130", "Check the screen. Continue?")
            return answer.Result = "OK" ? Map("type", "ask", "prompt", Trim(answer.Value)) : false
        case "stop":
            node := Map("type", "stop", "action", "break")
            return VMB_EditBlock(node, true) ? node : false
        case "call":
            path := FileSelect(3, s.Dir, "Choose the macro to run", "Visual macros (*.vmacro.json)")
            if path = ""
                return false
            if s.Path != "" && path = s.Path {
                VMB_Status("A macro cannot run itself.")
                return false
            }
            return Map("type", "call", "path", path)
        case "pickdata":
            node := Map("type", "pickdata", "format", "csv", "header", "auto")
            return VMB_EditBlock(node, true) ? node : false
        case "click":
            s.Gui.Hide()
            point := VM_UiPickPoint("Point at the spot to click, then press F6.   Esc cancels.")
            step := false, message := "Cancelled."
            if point {
                try step := VM_CaptureClickStep(point.X, point.Y)
                catch as err
                    message := "Could not capture: " . err.Message
            }
            s.Gui.Show()
            if !step
                VMB_Status(message)
            else
                VMB_ApplyDefaultFind([step])
            return step
        case "text", "keys":
            win := VMB_InheritWindow()
            step := kind = "text" ? Map("type", "text", "text", "", "win", win, "gapMs", 0)
                : Map("type", "keys", "keys", "{Enter}", "win", win, "gapMs", 0)
            return VM_UiEditStep(step, kind = "text" ? "New Type step" : "New Keys step", s.Gui.Hwnd, VMB_ColumnChoices())
                ? step : false
        case "wait":
            patternText := VM_UiDragImage("Add wait-for-image", "After OK this window hides. Drag a rectangle around"
                . " something that shows the screen is ready (a heading, icon or button that is always the same). Esc cancels.", s.Gui)
            if patternText = "" {
                VMB_Status("No image captured.")
                return false
            }
            try {
                return VM_NewWaitStep(patternText)
            } catch as err {
                VMB_Status(err.Message)
                return false
            }
        case "delay":
            n := VMB_AskNumber("Delay in milliseconds:", "Delay", 1000, 0)
            return n = "" ? false : Map("type", "delay", "ms", n, "gapMs", 0)
    }
    return false
}

; @summary InputBox for a whole number >= minValue; returns the number or "" (cancelled / not a number).
; @tags macro, gui
VMB_AskNumber(prompt, title, default, minValue := 1) {
    answer := InputBox(prompt, title, "w320 h120", default)
    if answer.Result != "OK"
        return ""
    value := Trim(answer.Value)
    if !RegExMatch(value, "^\d+$") || Integer(value) < minValue {
        VMB_Status("Please enter a whole number" . (minValue ? " of " . minValue . " or more." : "."))
        return ""
    }
    return Integer(value)
}

; @summary Window of the selected step or the nearest earlier step that has one (empty = the active window).
; @tags macro, window, blocks
VMB_InheritWindow() {
    s := VMB()
    flat := VMF_Flatten(s.Macro["blocks"])
    info := VMB_SelectedInfo()
    i := info && info.Kind = "node" && s.FlatIndex.Has(info.Node) ? s.FlatIndex[info.Node] : flat.Length
    while i >= 1 {
        win := flat[i].Get("win", "")
        if win is Map && win.Get("exe", "") != ""
            return win.Clone()
        i -= 1
    }
    return Map("exe", "", "cls", "", "title", "")
}

; ============================================================================
; Editing
; ============================================================================

; @summary Edit the selected step (VM_UiEditStep) or block (VMB_EditBlock).
; @tags macro, gui, blocks
VMB_EditSelected(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    if VMB_TopTicked().Length > 1
        return VMB_StepGrid()      ; several ticked: edit them together in the grid
    sel := VMB_SelectedInfo()
    if sel && sel.Kind = "elif" {
        VMB_Snapshot()
        if VMB_EditBlock(sel.Elif) {
            s.Dirty := true
            VMB_Refresh(sel.Node)
        } else {
            VMB_DropSnapshot()
        }
        return
    }
    info := VMB_SelectedNode()
    if !info
        return
    node := info.Node
    VMB_Snapshot()
    if VMF_IsStep(node)
        saved := VM_UiEditStep(node, "Edit step " . s.FlatIndex.Get(node, ""), s.Gui.Hwnd, VMB_ColumnChoices())
    else
        saved := VMB_EditBlock(node)
    if saved {
        s.Dirty := true
        VMB_Refresh(node)
    } else {
        VMB_DropSnapshot()
    }
}

; @summary Edit dialog for a control block: count, For range, condition (image or variable), do/while check, at most,
;          variable name/value, prompt, action, macro file, note. Also edits an ELSE IF part (type "elif").
; @returns true when saved
; @tags macro, gui, blocks
VMB_EditBlock(node, isNew := false) {
    if node.Get("cond", "") = "web" || node.Get("cond", "") = "pixel"
        return V4_BlockEdit(node)
    s := VMB()
    t := node["type"]
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", (isNew ? "New " : "Edit ") . (t = "elif" ? "Else if" : VMF_BlockName(t)) . " block")
    dlg.SetFont("s9", "Segoe UI")
    ctl := Map()
    varNames := []
    for , name in VMF_VarNames(s.Macro["blocks"])
        varNames.Push(name)
    ops := ["=", "!=", "<", ">", "<=", ">=", "contains", "empty", "notempty"]
    opText := ["equals (=)", "is not (!=)", "less than (<)", "more than (>)", "at most (<=)", "at least (>=)",
        "contains", "is empty", "is not empty"]
    switch t {
        case "repeat":
            dlg.AddText("w440", "Repeat the blocks inside this many times (Type steps can use {{index}} = the round):")
            ctl["count"] := dlg.AddEdit("w100 Number", node.Get("count", 3))
        case "for":
            dlg.AddText("w440", "Count a variable from one number to another. Use it in Type steps as {{name}}.")
            dlg.AddText("xm y+10 w70", "Variable")
            ctl["name"] := dlg.AddEdit("x+4 yp-3 w100", node.Get("name", "i"))
            dlg.AddText("xm y+12 w70", "From")
            ctl["from"] := dlg.AddEdit("x+4 yp-3 w100", node.Get("from", 1))
            dlg.AddText("x+14 yp+3", "To")
            ctl["to"] := dlg.AddEdit("x+4 yp-3 w100", node.Get("to", 10))
            dlg.AddText("x+14 yp+3", "Step")
            ctl["step"] := dlg.AddEdit("x+4 yp-3 w60", node.Get("step", 1))
            dlg.AddText("xm y+8 w440 cGray", "From / To / Step can be numbers or {{variables}} (e.g. To = {{count}}). Step -1 counts down.")
        case "foreach":
            dlg.AddText("w440", "Runs the blocks inside once for each row of the data file chosen in the main window"
                . " (Rows from/to there). Type steps can use {{Column}}.")
        case "until", "if", "elif":
            if t = "until" {
                ctl["check"] := dlg.AddDropDownList("w440", ["While-loop: check BEFORE each round (may run 0 times)",
                    "Do ... until: check AFTER each round (runs at least once)"])
                ctl["check"].Value := node.Get("check", "before") = "after" ? 2 : 1
                dlg.AddText("xm y+10 w440", "Repeat the blocks inside until this is true:")
            } else {
                dlg.AddText("w440", t = "if" ? "Run the blocks inside when this is true (otherwise ELSE IF / ELSE):"
                    : "Run the blocks of this ELSE IF when this is true:")
            }
            isVar := node.Get("cond", "image") = "var"
            ctl["useImage"] := dlg.AddRadio("xm y+8" . (isVar ? "" : " Checked"), "An image:")
            ctl["appear"] := dlg.AddDropDownList("x+8 yp-3 w250", ["is on screen", "is NOT on screen"])
            ctl["appear"].Value := node.Get("appear", 1) ? 1 : 2
            ctl["imageNote"] := dlg.AddText("xm+20 y+4 w420 cGray", VM__Pattern(node)
                ? "Image: " . VM__TargetText(node) . " (New picture... changes it)" : "You drag around the image after OK.")
            dlg.AddText("xm+20 y+4", "Look for it for (ms, blank = " . VM_Config().CheckTimeoutMs . "):")
            ctl["timeoutMs"] := dlg.AddEdit("x+6 yp-3 w80 Number", node.Get("timeoutMs", ""))
            ctl["useVar"] := dlg.AddRadio("xm y+12" . (isVar ? " Checked" : ""), "A variable:")
            ctl["name"] := dlg.AddComboBox("x+8 yp-3 w120", varNames)
            ctl["name"].Text := node.Get("name", "")
            ctl["op"] := dlg.AddDropDownList("x+6 w120", opText)
            ctl["op"].Value := Max(1, VM__IndexOf(ops, node.Get("op", "=")))
            ctl["value"] := dlg.AddEdit("x+6 w150", node.Get("value", ""))
            dlg.AddText("xm+20 y+4 w420 cGray", "Value: a number, text or {{another variable / column}}.")
            if t = "until" {
                dlg.AddText("xm y+12", "At most this many rounds (then the run stops):")
                ctl["max"] := dlg.AddEdit("x+6 yp-3 w80 Number", node.Get("max", 100))
            }
            ctl["useImage"].OnEvent("Click", (*) => (ctl["useVar"].Value := 0, syncCond()))     ; separate radio groups
            ctl["useVar"].OnEvent("Click", (*) => (ctl["useImage"].Value := 0, syncCond()))
        case "set":
            dlg.AddText("w440", "Variable name (letters, digits, _):")
            ctl["name"] := dlg.AddComboBox("w200", varNames)
            ctl["name"].Text := node.Get("name", "")
            dlg.AddText("xm y+10 w440", "Value (number or text; can use {{clipboard}}, {{Column}}, {{index}}, {{other variable}}):")
            ctl["value"] := dlg.AddEdit("xm w440", node.Get("value", ""))
            names := VMB_ColumnChoices()
            ctl["column"] := dlg.AddDropDownList("xm w250", names)
            if names.Length
                ctl["column"].Value := 1
            btnInsert := dlg.AddButton("x+6 w140", "Insert {{...}}")
            btnInsert.OnEvent("Click", (*) => ctl["column"].Text != "" ? EditPaste("{{" . ctl["column"].Text . "}}", ctl["value"]) : 0)
            ctl["ask"] := dlg.AddCheckbox("xm y+12" . (node.Get("ask", 0) ? " Checked" : ""),
                "Ask me for the value when this block runs (the value above is the default)")
            dlg.AddText("xm y+6 w440", "Question to show (blank = 'Value for <name>:'):")
            ctl["prompt"] := dlg.AddEdit("xm w440", node.Get("prompt", ""))
            dlg.AddText("xm y+8 w440 cGray", "Variables only exist while the macro plays; they are not saved with values.")
        case "change":
            dlg.AddText("w440", "Variable:")
            ctl["name"] := dlg.AddComboBox("w200", varNames)
            ctl["name"].Text := node.Get("name", "")
            dlg.AddText("xm y+10", "Change by (use -1 to count down):")
            ctl["by"] := dlg.AddEdit("x+6 yp-3 w80", node.Get("by", 1))
        case "ndc":
            dlg.AddText("w440", "Variable that gets the 11-digit NDC (no dashes), used later as {{name}}:")
            ctl["name"] := dlg.AddComboBox("w200", varNames)
            ctl["name"].Text := node.Get("name", "ndc")
            dlg.AddText("xm y+10 w440", "Barcode text to convert (blank = ask the tech to scan when this block runs;"
                . " or {{clipboard}}, {{Column}}, {{other variable}}):")
            ctl["source"] := dlg.AddEdit("xm w440", node.Get("source", ""))
            names := VMB_ColumnChoices()
            ctl["column"] := dlg.AddDropDownList("xm w250", names)
            if names.Length
                ctl["column"].Value := 1
            btnInsert := dlg.AddButton("x+6 w140", "Insert {{...}}")
            btnInsert.OnEvent("Click", (*) => ctl["column"].Text != "" ? EditPaste("{{" . ctl["column"].Text . "}}", ctl["source"]) : 0)
            dlg.AddText("xm y+10 w440", "Scan prompt (blank = 'Scan the NDC barcode now'):")
            ctl["prompt"] := dlg.AddEdit("xm w440", node.Get("prompt", ""))
            ndcStatus := dlg.AddText("xm y+12 w440 cGray", NDC_ListStatus())
            btnNdc := dlg.AddButton("xm w220", "Download / update FDA NDC list")
            btnNdc.OnEvent("Click", ndcDownload)
            dlg.AddText("xm y+6 w440 cGray", "Reads 10-digit NDCs, UPC-A (3 + NDC + check), GTIN-14 and GS1 DataMatrix"
                . " scans. If the NDC is not in the FDA list, the tech picks from the three possible readings.")
        case "ask":
            dlg.AddText("w440", "Question to show (the run waits for Continue / Skip this row / Stop):")
            ctl["prompt"] := dlg.AddEdit("w440", node.Get("prompt", ""))
        case "stop":
            dlg.AddText("w440", "What should this block do?")
            actions := ["break", "continue", "nextrow", "endrun", "stop"]
            ctl["action"] := dlg.AddDropDownList("w440", ["Exit the loop it is in (carry on after the loop)",
                "Next round of the loop (skip the rest of this round, like 'continue')",
                "Skip this data row (mark it failed, go to the next row)", "End the run (counts as done)", "Stop the run"])
            ctl["action"].Value := Max(1, VM__IndexOf(actions, node.Get("action", "break")))
        case "call":
            dlg.AddText("w440", "Macro file to run (it uses the current data row and variables):")
            ctl["path"] := dlg.AddEdit("w440", node.Get("path", ""))
            btnBrowse := dlg.AddButton("w90", "Browse...")
            btnBrowse.OnEvent("Click", browse)
        case "pickdata":
            fmtKeys := ["csv", "text", "excel", "any"]
            dlg.AddText("w440", "When the macro starts (here or in an exported player), ask for a data file of this type:")
            fmtNames := []
            for key in fmtKeys
                fmtNames.Push(VMF_DataFormats()[key][1] . "  (" . VMF_DataFormats()[key][2] . ")")
            ctl["format"] := dlg.AddDropDownList("w440", fmtNames)
            ctl["format"].Value := Max(1, VM__IndexOf(fmtKeys, node.Get("format", "csv")))
            dlg.AddText("xm y+10", "Header row:")
            ctl["header"] := dlg.AddDropDownList("x+6 yp-3 w220", ["Detect automatically", "First row = column names",
                "No header row (a plain list)"])
            ctl["header"].Value := Max(1, VM__IndexOf(["auto", "yes", "no"], node.Get("header", "auto")))
            dlg.AddText("xm y+10 w440", "Columns the file must have (comma-separated; {{Column}}s used by steps are"
                . " always checked):")
            ctl["columns"] := dlg.AddEdit("xm w440", node.Get("columns", ""))
            dlg.AddText("xm y+10 w440", "Title of the file picker (blank = default):")
            ctl["askTitle"] := dlg.AddEdit("xm w440", node.Get("prompt", ""))
            dlg.AddText("xm y+8 w440 cGray", "Put the steps that use a row inside a 'For each data row' block. This"
                . " block is always the first line of the macro.")
    }
    if t != "elif" {
        dlg.AddText("xm w440 y+12", "Note (shown in the tree):")
        ctl["note"] := dlg.AddEdit("xm w440", node.Get("note", ""))
    }
    btnOk := dlg.AddButton("xm y+14 w90 Default", "OK")
    btnCancel := dlg.AddButton("x+8 w90", "Cancel")
    state := {Saved: false}
    hwnd := dlg.Hwnd
    syncCond() {
        if !ctl.Has("useVar")
            return
        v := ctl["useVar"].Value
        for name in ["appear", "timeoutMs", "imageNote"]
            ctl[name].Enabled := !v
        for name in ["name", "op", "value"]
            ctl[name].Enabled := v
    }
    browse(*) {
        picked := FileSelect(3, s.Dir, "Choose the macro to run", "Visual macros (*.vmacro.json)")
        if picked != ""
            ctl["path"].Value := picked
    }
    ndcDownload(btn, *) {
        btn.Enabled := false
        ndcStatus.Value := "Downloading the FDA NDC list..."
        try {
            NDC_DownloadList()
        } catch as err {
            MsgBox(err.Message, "FDA NDC list", "Icon! Owner" . hwnd)
        }
        ndcStatus.Value := NDC_ListStatus()
        btn.Enabled := true
    }
    complain(text) => MsgBox(text, "Edit block", "Icon! Owner" . hwnd)
    apply(*) {
        for name in ["count", "max"] {
            if ctl.Has(name) && (!RegExMatch(ctl[name].Value, "^\d+$") || Integer(ctl[name].Value) < 1)
                return complain("Enter a whole number of 1 or more.")
        }
        if ctl.Has("path") && !FileExist(ctl["path"].Value)
            return complain("That macro file does not exist.")
        useVar := ctl.Has("useVar") && ctl["useVar"].Value
        needsName := t = "for" || t = "set" || t = "change" || t = "ndc" || useVar
        if needsName && !VMF_ValidVarName(Trim(ctl["name"].Text))
            return complain("Variable names use letters, digits and _ (start with a letter), and cannot be a built-in"
                . " name like row, index, date, time or clipboard.")
        if t = "for" {
            for key in ["from", "to", "step"] {
                v := Trim(ctl[key].Value)
                if !IsNumber(v) && !InStr(v, "{{")
                    return complain("'" . key . "' must be a number or a {{variable}}.")
            }
            if IsNumber(Trim(ctl["step"].Value)) && Number(Trim(ctl["step"].Value)) = 0
                return complain("Step cannot be 0.")
        }
        if t = "change" && !IsNumber(Trim(ctl["by"].Value))
            return complain("'Change by' must be a number, for example 1 or -1.")
        if ctl.Has("useImage") && ctl["useImage"].Value && !VM__Pattern(node) {
            patternText := VM_UiDragImage("Image for this condition", "After OK this window hides. Drag a rectangle"
                . " around the image to check for. Esc cancels.", dlg)
            if patternText = ""
                return
            try {
                fresh := VM_NewWaitStep(patternText)
            } catch as err {
                return complain(err.Message)
            }
            node["pattern"] := fresh["pattern"], node["q"] := fresh["q"]
            for key in ["scrX", "scrY"]
                VM__SetOrDelete(node, key, fresh.Get(key, ""))
        }
        if ctl.Has("count")
            node["count"] := Integer(ctl["count"].Value)
        if ctl.Has("max")
            node["max"] := Integer(ctl["max"].Value)
        if ctl.Has("check")
            VM__SetOrDelete(node, "check", ctl["check"].Value = 2 ? "after" : "")
        if ctl.Has("useVar") {
            if useVar {
                node["cond"] := "var"
                node["op"] := ops[Max(1, ctl["op"].Value)]
                node["value"] := ctl["value"].Value
            } else {
                VM__SetOrDelete(node, "cond", "")
                node["appear"] := ctl["appear"].Value = 1 ? 1 : 0
                ms := Trim(ctl["timeoutMs"].Value)
                VM__SetOrDelete(node, "timeoutMs", ms = "" ? "" : Max(200, Integer(ms)))
            }
        }
        if needsName
            node["name"] := Trim(ctl["name"].Text)
        if t = "for" {
            for key in ["from", "to", "step"] {
                v := Trim(ctl[key].Value)
                node[key] := IsNumber(v) ? Number(v) : v
            }
        }
        if t = "set" {
            node["value"] := ctl["value"].Value
            VM__SetOrDelete(node, "ask", ctl["ask"].Value ? 1 : "")
        }
        if t = "change"
            node["by"] := Number(Trim(ctl["by"].Value))
        if t = "ndc"
            node["source"] := Trim(ctl["source"].Value)
        if ctl.Has("prompt")
            node["prompt"] := Trim(ctl["prompt"].Value)
        if ctl.Has("action")
            node["action"] := ["break", "continue", "nextrow", "endrun", "stop"][Max(1, ctl["action"].Value)]
        if ctl.Has("path")
            node["path"] := ctl["path"].Value
        if t = "pickdata" {
            node["format"] := ["csv", "text", "excel", "any"][Max(1, ctl["format"].Value)]
            VM__SetOrDelete(node, "header", ["", "yes", "no"][Max(1, ctl["header"].Value)])
            cols := ""
            for name in StrSplit(ctl["columns"].Value, ",", " `t")
                cols .= name = "" ? "" : (cols = "" ? "" : ", ") . name
            VM__SetOrDelete(node, "columns", cols)
            VM__SetOrDelete(node, "prompt", Trim(ctl["askTitle"].Value))
        }
        if ctl.Has("note")
            VM__SetOrDelete(node, "note", Trim(ctl["note"].Value))
        state.Saved := true
        dlg.Destroy()
    }
    syncCond()
    btnOk.OnEvent("Click", apply)
    btnCancel.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    dlg.Show()
    WinWaitClose("ahk_id " . hwnd)
    return state.Saved
}

; @summary Test target: finds the selected step's (or If/Repeat-until block's) image without clicking and outlines it.
; @tags macro, visualfind, testing, blocks
VMB_TestSelected(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    node := VMB_SelectedTarget()
    if !node
        return
    t := node.Get("type", "")
    if node.Has("selector") {
        result := VM_TestStep(node)
        return VMB_Status(result.Message)
    }
    if RegExMatch(t, "^(if|until|elif)$") {
        if node.Get("cond", "image") = "var"
            return VMB_Status("This block checks a variable, not an image - there is nothing on screen to test.")
        step := node.Clone()
        step["type"] := "wait"
    } else if RegExMatch(t, "^(click|drag|wait|check)$") {
        step := node
    } else {
        return VMB_Status("Only click, drag, wait, check, If and Repeat-until have a target image.")
    }
    s.Gui.Hide()
    result := VM_TestStep(step, 4000)
    Sleep(result.Found ? 900 : 100)
    s.Gui.Show()
    VMB_Status(result.Message)
}

; @summary The selected step/block, or the selected ELSE IF part (for Test target / New picture); 0 = none.
; @tags macro, gui, blocks
VMB_SelectedTarget() {
    sel := VMB_SelectedInfo()
    if sel && sel.Kind = "elif"
        return sel.Elif
    info := VMB_SelectedNode()
    return info ? info.Node : 0
}

; @summary New picture: click/drag steps - point at the target + F6 (keeps finding by picture); image checks - drag
;          a rectangle around the new image.
; @tags macro, visualfind, record, blocks
VMB_NewPicture(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    sel := VMB_SelectedInfo()
    node := VMB_SelectedTarget()
    if !node
        return
    refreshTo := sel && sel.Kind = "elif" ? sel.Node : node
    t := node.Get("type", "")
    if RegExMatch(t, "^(if|until|elif)$") && node.Get("cond", "image") = "web"
        return VMB_Status("This block uses a web selector. Use Edit or the Web / CDP picker.")
    if RegExMatch(t, "^(if|until|elif)$") && node.Get("cond", "image") = "var"
        return VMB_Status("This block checks a variable - Edit it to switch it to an image check first.")
    if t = "click" || t = "drag" {
        s.Gui.Hide()
        point := VM_UiPickPoint("Show the target, point at the exact spot to click and press F6.   Esc cancels.")
        fresh := false, message := "Cancelled."
        if point {
            try fresh := VM_CaptureClickStep(point.X, point.Y, node["button"], node.Get("count", 1))
            catch as err
                message := "Could not capture: " . err.Message
        }
        s.Gui.Show()
        if !fresh
            return VMB_Status(message)
        VMB_Snapshot()
        for key in ["x", "y", "scrX", "scrY", "rx", "ry", "offsetX", "offsetY", "q", "pattern"]
            node[key] := fresh[key]
        VM__SetOrDelete(node, "geo", fresh.Get("geo", ""))
        if !(node.Get("win", "") is Map) || StrLower(node["win"].Get("exe", "")) != StrLower(fresh["win"]["exe"])
            node["win"] := fresh["win"]
        VM__SetOrDelete(node, "find", "")
    } else if RegExMatch(t, "^(wait|check|if|until|elif)$") {
        patternText := VM_UiDragImage("New image", "After OK this window hides. Drag a rectangle around the image."
            . " Esc cancels.", s.Gui)
        if patternText = ""
            return VMB_Status("No image captured.")
        try fresh := VM_NewWaitStep(patternText)
        catch as err
            return VMB_Status(err.Message)
        VMB_Snapshot()
        node["pattern"] := fresh["pattern"]
        node["q"] := fresh["q"]
        for key in ["scrX", "scrY"]
            VM__SetOrDelete(node, key, fresh.Get(key, ""))
    } else {
        return VMB_Status("Only click, drag, wait, check, If, Else if and Repeat-until have a picture.")
    }
    s.Dirty := true
    VMB_Refresh(refreshTo)
    VMB_Status("New picture saved.")
}

; @summary Deletes the ticked lines (when any are ticked) or the selected step/block after confirming exactly what goes.
; @tags macro, gui, blocks
VMB_DeleteSelected(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    topTicked := VMB_TopTicked()
    if topTicked.Length > 1 {
        lines := "", inner := 0
        for i, node in topTicked {
            if !VMF_IsStep(node)
                inner += VMF_CountSteps(node)
            if i <= 10
                lines .= "`n  " . Trim(s.TV.GetText(s.NodeItem[node]))
        }
        if topTicked.Length > 10
            lines .= "`n  ...and " . (topTicked.Length - 10) . " more"
        extra := inner ? " (and " . inner . " step(s) inside ticked block(s))" : ""
        if MsgBox("Delete " . topTicked.Length . " ticked lines" . extra . "?`n" . lines,
            "Delete", "YesNo Icon! Owner" . s.Gui.Hwnd) != "Yes"
            return
        VMB_Snapshot()
        for node in topTicked {
            info := s.Items[s.NodeItem[node]]
            for idx, item in info.List {
                if item = node {
                    info.List.RemoveAt(idx)
                    break
                }
            }
        }
        s.Checked := Map()
        s.Dirty := true
        VMB_Refresh()
        VMB_SyncWinMatch()
        return VMB_Status("Deleted " . topTicked.Length . " ticked lines.  (Ctrl+Z brings them back.)")
    }
    sel := topTicked.Length = 1 ? s.Items[s.NodeItem[topTicked[1]]] : VMB_SelectedInfo()
    if sel && sel.Kind = "elif" {
        inner := VMF_Flatten(sel.Elif["body"]).Length
        if MsgBox("Delete this ELSE IF part" . (inner ? " and the " . inner . " step(s) inside it" : "") . "?`n`n  ELSE IF "
            . VMF__CondText(sel.Elif), "Delete", "YesNo Icon! Owner" . s.Gui.Hwnd) != "Yes"
            return
        VMB_Snapshot()
        sel.Node["elifs"].RemoveAt(sel.Index)
        s.Dirty := true
        VMB_Refresh(sel.Node)
        return VMB_Status("Deleted the ELSE IF part.  (Ctrl+Z brings it back.)")
    }
    info := topTicked.Length = 1 ? sel : VMB_SelectedNode()
    if !info
        return
    node := info.Node
    inner := VMF_IsStep(node) ? 0 : VMF_CountSteps(node)
    what := VMF_IsStep(node) ? "this step" : "this block" . (inner ? " and the " . inner . " step(s) inside it" : "")
    if MsgBox("Delete " . what . "?`n`n  " . s.TV.GetText(s.NodeItem[node]), "Delete", "YesNo Icon! Owner" . s.Gui.Hwnd) != "Yes"
        return
    list := info.List, idx := info.Index
    VMB_Snapshot()
    list.RemoveAt(idx)
    if topTicked.Length = 1
        s.Checked := Map()
    else if s.Checked.Has(node)
        s.Checked.Delete(node)
    s.Dirty := true
    VMB_Refresh(list.Length >= idx ? list[idx] : idx > 1 ? list[idx - 1] : info.Owner)
    VMB_SyncWinMatch()
    VMB_Status("Deleted " . what . ".  (Ctrl+Z brings it back.)")
}

; @summary Moves the ticked lines (or the selected line) up (-1) or down (+1) within their blocks; ticked runs move together.
; @tags macro, gui, blocks
VMB_MoveSelected(direction) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    nodes := VMB_TargetNodes()
    if !nodes.Length
        return
    picked := Map(), lists := []
    for node in nodes {
        picked[node] := 1
        list := s.Items[s.NodeItem[node]].List
        if !VM__IndexOf(lists, list)
            lists.Push(list)
    }
    moved := 0
    for list in lists {
        i := direction < 0 ? 2 : list.Length - 1
        while (direction < 0 ? i <= list.Length : i >= 1) {
            j := i + direction
            if picked.Has(list[i]) && !picked.Has(list[j]) {
                if !moved
                    VMB_Snapshot()
                tmp := list[i], list[i] := list[j], list[j] := tmp
                moved += 1
            }
            i -= direction
        }
    }
    if !moved
        return
    s.Dirty := true
    VMB_Refresh(nodes[1])
}

; @summary Moves the ticked lines (or the selected line) into the loop/if just above them (at its end).
; @tags macro, gui, blocks
VMB_Indent(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    nodes := VMB_TargetNodes()
    if !nodes.Length
        return
    moved := [], skipped := 0
    for node in nodes {
        at := VMB_Locate(node)
        above := at && at.Index > 1 ? at.List[at.Index - 1] : 0
        if !above || !VMF_IsContainer(above) {
            skipped += 1
            continue
        }
        if !moved.Length
            VMB_Snapshot()
        at.List.RemoveAt(at.Index)
        VMF_Children(above)[1].Push(node)
        moved.Push(node)
    }
    if !moved.Length
        return VMB_Status("The line above is not a loop or If block.")
    s.Dirty := true
    VMB_Refresh(moved[1])
    if nodes.Length > 1
        VMB_Status("Moved " . moved.Length . " line(s) into the block above." . (skipped ? " (" . skipped
            . " had no loop/If directly above.)" : ""))
}

; @summary Moves the ticked lines (or the selected line) out of their loop/if, to just after that block (order kept).
; @tags macro, gui, blocks
VMB_Outdent(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    nodes := VMB_TargetNodes()
    if !nodes.Length
        return
    moved := [], skipped := 0, after := Map()
    for node in nodes {
        owner := s.Items[s.NodeItem[node]].Owner
        if !owner || !s.NodeItem.Has(owner) {
            skipped += 1
            continue
        }
        if !moved.Length
            VMB_Snapshot()
        at := VMB_Locate(node)
        at.List.RemoveAt(at.Index)
        ownerAt := VMB_Locate(owner)
        n := after.Get(owner, 0)
        ownerAt.List.InsertAt(ownerAt.Index + 1 + n, node)
        after[owner] := n + 1
        moved.Push(node)
    }
    if !moved.Length
        return VMB_Status("This line is not inside a block.")
    s.Dirty := true
    VMB_Refresh(moved[1])
    if nodes.Length > 1
        VMB_Status("Moved " . moved.Length . " line(s) out of their block." . (skipped ? " (" . skipped
            . " were not inside a block.)" : ""))
}

; @summary Lines a command applies to: the top-level ticked lines, else the selected line ([] + status when none).
; @tags macro, gui, blocks
VMB_TargetNodes(what := "a step or block") {
    ticked := VMB_TopTicked()
    if ticked.Length
        return ticked
    info := VMB_SelectedNode(what)
    return info ? [info.Node] : []
}

; @summary Current {List, Index} of a node shown in the tree (searched, so it stays right while lists change).
; @tags macro, gui, blocks
VMB_Locate(node) {
    s := VMB()
    list := s.Items[s.NodeItem[node]].List
    for i, n in list
        if n = node
            return {List: list, Index: i}
    return 0
}

; @summary Sets how the selected step - or every step inside the selected block - finds its window: "" = the exact
;          recorded window, "program" = any window of that program, "active" = whatever window is active.
;          When scope = "all", applies to every window step in the entire macro.
; @tags macro, gui, blocks, window
VMB_SetWinMatch(mode, scope := "selection") {
    s := VMB()
    steps := scope = "all" ? VMF_Flatten(s.Macro["blocks"]) : VMB_WinTargets()
    if !steps.Length
        return VMB_Status("Select a step, or tick the steps to change.")
    targets := []
    for step in steps {
        if step.Get("win", "") is Map && step.Get("winMatch", "") != mode
            targets.Push(step)
    }
    if !targets.Length
        return VMB_Status("Nothing to change.")
    VMB_Snapshot()
    for step in targets
        VM__SetOrDelete(step, "winMatch", mode)
    s.Dirty := true
    VMB_Refresh()
    VMB_SyncWinMatch()
    modeLabel := mode = "program" ? "any window of the same program" : mode = "active" ? "whatever window is active" : "exact window"
    VMB_Status("Changed the window setting of " . targets.Length . " step(s) to " . modeLabel . ".")
}

; @summary Click/drag steps that Find-by changes apply to: every ticked line (blocks = all steps inside), or
;          the selected line when nothing is ticked.
; @tags macro, gui, blocks
VMB_FindTargets() {
    nodes := VMB_CheckedNodes()
    if !nodes.Length {
        info := VMB_SelectedInfo()
        if info && info.Kind = "node"
            nodes := [info.Node]
    }
    steps := [], seen := Map()
    for node in nodes {
        for step in (VMF_IsStep(node) ? [node] : VMF_Flatten([node])) {
            if !seen.Has(step) && (step["type"] = "click" || step["type"] = "drag") {
                seen[step] := 1
                steps.Push(step)
            }
        }
    }
    return steps
}

; @summary Sets how ticked/selected click & drag steps find their target: "spot" = coordinates, "" = picture.
;          When scope = "all", applies to every click/drag step in the entire macro.
; @tags macro, gui, blocks
VMB_SetFindMode(mode, scope := "selection") {
    s := VMB()
    steps := scope = "all" ? VMF_Flatten(s.Macro["blocks"]) : VMB_FindTargets()
    if !steps.Length
        return VMB_Status("Select a click/drag step, or tick the steps to change.")
    targets := []
    for step in steps {
        if (step["type"] = "click" || step["type"] = "drag") && step.Get("find", "") != mode
            targets.Push(step)
    }
    if !targets.Length
        return VMB_Status("All targeted click/drag steps already use " . (mode = "spot" ? "coordinates." : "picture."))
    VMB_Snapshot()
    for step in targets
        VM__SetOrDelete(step, "find", mode)
    s.Dirty := true
    VMB_Refresh()
    VMB_Status("Switched " . targets.Length . " click/drag step(s) to " . (mode = "spot" ? "coordinates (recorded spot)." : "picture."))
}

; @summary One-click fix for macros that fail due to slight screen/window variations: converts all ticked steps
;          (or all steps when scope = "all") to Coordinates + Any window of the same program.
; @tags macro, gui, blocks, window
VMB_MakeFlexible(scope := "selection", winMode := "program") {
    s := VMB()
    if scope = "all" {
        steps := VMF_Flatten(s.Macro["blocks"])
    } else {
        nodes := VMB_CheckedNodes()
        if !nodes.Length {
            info := VMB_SelectedInfo()
            if info && info.Kind = "node"
                nodes := [info.Node]
        }
        steps := [], seen := Map()
        for node in nodes {
            for step in (VMF_IsStep(node) ? [node] : VMF_Flatten([node])) {
                if !seen.Has(step) {
                    seen[step] := 1
                    steps.Push(step)
                }
            }
        }
    }
    if !steps.Length
        return VMB_Status("Select or tick steps first (or choose the whole-macro option).")
    VMB_Snapshot()
    changedFind := 0, changedWin := 0
    for step in steps {
        if (step["type"] = "click" || step["type"] = "drag") && step.Get("find", "") != "spot" {
            step["find"] := "spot"
            changedFind += 1
        }
        if step.Get("win", "") is Map && step.Get("winMatch", "") != winMode {
            VM__SetOrDelete(step, "winMatch", winMode)
            changedWin += 1
        }
    }
    s.Macro["settings"]["defaultFind"] := "spot"
    s.Macro["settings"]["onFail"] := "coords"
    VMB_SettingsToControls()
    s.Dirty := true
    VMB_Refresh()
    VMB_SyncWinMatch()
    VMB_Status("Converted " . changedFind . " click/drag step(s) to coordinates and " . changedWin
        . " step(s) to " . (winMode = "active" ? "active window" : "any window of program") . ".")
}

; @summary Ticks every top-level step/block in the macro tree.
; @tags macro, gui, blocks
VMB_CheckAll(*) {
    s := VMB()
    s.Checked := Map()
    for id, info in s.Items {
        if info.Kind = "node" {
            s.Checked[info.Node] := 1
            s.TV.Modify(id, "Check")
        }
    }
    VMB_TickStatus()
}

; @summary Shows the selected step's (or block's) window setting in the Window dropdown; blank when the steps differ.
; @tags macro, gui, blocks, window
VMB_SyncWinMatch() {
    s := VMB()
    modes := Map()
    for step in VMB_WinTargets()
        modes[step.Get("winMatch", "")] := 1
    ddl := s.Ctl["WinMatch"]
    if modes.Count = 1 {
        for mode in modes
            ddl.Value := Max(1, VM__IndexOf(["", "program", "active"], mode))
    } else
        ddl.Value := 0
}

; @summary Ticked lines (tick boxes in the macro tree) that are still in the macro, in top-to-bottom tree order.
; @tags macro, gui, blocks
VMB_CheckedNodes() {
    s := VMB()
    nodes := [], id := 0
    while id := (s.TV ? s.TV.GetNext(id, "Full") : 0) {
        if (info := s.Items.Get(id, 0)) && info.Kind = "node" && s.Checked.Has(info.Node)
            nodes.Push(info.Node)
    }
    return nodes
}

; @summary Steps (with a window) the Window setting applies to: every ticked line (blocks = all steps inside), or
;          the selected line when nothing is ticked.
; @tags macro, gui, blocks, window
VMB_WinTargets() {
    nodes := VMB_CheckedNodes()
    if !nodes.Length {
        info := VMB_SelectedInfo()
        if info && info.Kind = "node"
            nodes := [info.Node]
    }
    steps := [], seen := Map()
    for node in nodes {
        for step in (VMF_IsStep(node) ? [node] : VMF_Flatten([node])) {
            if !seen.Has(step) && step.Get("win", "") is Map {
                seen[step] := 1
                steps.Push(step)
            }
        }
    }
    return steps
}

; @summary Tick box clicked in the macro tree: remembers ticked steps/blocks (only real lines can be ticked).
; @tags macro, gui, blocks
VMB_OnItemCheck(ctl, item, checked) {
    s := VMB()
    info := s.Items.Get(item, 0)
    if !info || info.Kind != "node" {
        if checked
            ctl.Modify(item, "-Check")
        return
    }
    if checked
        s.Checked[info.Node] := 1
    else if s.Checked.Has(info.Node)
        s.Checked.Delete(info.Node)
    VMB_TickStatus()
}

; @summary Clears every tick box in the macro tree.
; @tags macro, gui, blocks
VMB_UncheckAll(*) {
    s := VMB()
    s.Checked := Map()
    VMB_Refresh()
    VMB_SyncWinMatch()
    VMB_Status("Nothing ticked.")
}

; @summary Tree click: Ctrl+click ticks/unticks the line, Shift+click ticks every visible line from the last clicked
;          line to this one (like multi-select in a list).
; @tags macro, gui, blocks
VMB_OnTreeClick(ctl, item) {
    s := VMB()
    info := s.Items.Get(item, 0)
    if !info || info.Kind != "node"
        return
    if GetKeyState("Ctrl") {
        VMB_SetTick(item, !s.Checked.Has(info.Node))
    } else if GetKeyState("Shift") && s.AnchorNode && s.NodeItem.Has(s.AnchorNode) {
        anchor := s.NodeItem[s.AnchorNode], inRange := false
        id := SendMessage(0x110A, 0, 0, ctl)                ; TVM_GETNEXTITEM, TVGN_ROOT
        while id {
            edge := id = anchor || id = item
            if edge || inRange
                VMB_SetTick(id, true)
            if edge && anchor != item
                inRange := !inRange
            id := SendMessage(0x110A, 6, id, ctl)            ; TVGN_NEXTVISIBLE
        }
        return VMB_TickStatus()
    }
    s.AnchorNode := info.Node
    if GetKeyState("Ctrl")
        VMB_TickStatus()
}

; @summary Ticks or unticks one tree line (real lines only) and remembers it.
; @tags macro, gui, blocks
VMB_SetTick(id, on) {
    s := VMB()
    info := s.Items.Get(id, 0)
    if !info || info.Kind != "node"
        return
    s.TV.Modify(id, on ? "Check" : "-Check")
    if on
        s.Checked[info.Node] := 1
    else if s.Checked.Has(info.Node)
        s.Checked.Delete(info.Node)
}

; @summary Status line + Window dropdown after ticks change.
; @tags macro, gui, blocks
VMB_TickStatus() {
    VMB_SyncWinMatch()
    n := VMB_CheckedNodes().Length
    VMB_Status(n ? n . " line(s) ticked - drag, Move, In/Out, Copy, Duplicate, Delete, Disable, Breakpoint, Play only,"
        . " Window and Find by apply to all ticked lines (Edit opens the Step grid)." : "Nothing ticked.")
}

; @summary Step grid: every step in a list with Window, Find by and Wait columns. Shift/Ctrl+click selects many rows;
;          double-click a Window / Find by / Wait cell to change it for all selected rows.
; @tags macro, gui, blocks, window
VMB_StepGrid(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    steps := VMF_Flatten(s.Macro["blocks"])
    if !steps.Length
        return VMB_Status("No steps yet - record or add some first.")
    winVals := ["", "program", "active"]
    winText := ["exact window", "any window of program", "whatever is active"]
    dlg := Gui("+Owner" . s.Gui.Hwnd . " +Resize +MinSize700x300",
        "Step grid - select rows (Shift/Ctrl+click or Select all), then use the boxes above or right-click")
    dlg.SetFont("s9", "Segoe UI")
    dlg.AddText("xm", "For ALL selected rows:")
    ddWin := dlg.AddDropDownList("x+8 yp-4 w230", ["Window: exact window", "Window: any window of program",
        "Window: whatever is active"])
    ddFind := dlg.AddDropDownList("x+8 w240", ["Find by: picture", "Find by: coordinates (recorded spot)"])
    dlg.AddText("x+14 yp+4", "Wait before (ms):")
    edWait := dlg.AddEdit("x+4 yp-4 w70 Number")
    btnWait := dlg.AddButton("x+4 yp-1 w50", "Set")
    lv := dlg.AddListView("xm y+10 w1060 h480 Grid NoSortHdr", ["#", "Step", "Window", "Find by", "Wait before (ms)",
        "Recorded window"])
    btnAll := dlg.AddButton("xm w90", "Select all")
    btnClose := dlg.AddButton("x+8 w90 Default", "Close")
    state := {Changed: false}

    cells(st) {
        hasWin := st.Get("win", "") is Map
        isClick := st["type"] = "click" || st["type"] = "drag"
        sum := VM_StepSummary(st)
        return [(st.Get("disabled", 0) ? "(off) " : "") . sum[1] . (sum[3] != "" ? "   " . sum[3] : ""),
            hasWin ? winText[Max(1, VM__IndexOf(winVals, st.Get("winMatch", "")))] : "-",
            isClick ? (st.Get("find", "") = "spot" ? "coordinates" : "picture") : "-",
            st.Get("delayMs", ""), hasWin ? VM_WindowLabel(st["win"]) : ""]
    }
    showRow(r) {
        c := cells(steps[r])
        lv.Modify(r, , r, c[1], c[2], c[3], c[4], c[5])
    }
    selectedRows(clicked) {
        rows := [], r := 0, hasClicked := false
        while r := lv.GetNext(r) {
            rows.Push(r)
            hasClicked := hasClicked || r = clicked
        }
        return hasClicked ? rows : [clicked]
    }
    allSelected() {
        rows := [], r := 0
        while r := lv.GetNext(r)
            rows.Push(r)
        if !rows.Length
            MsgBox("Select one or more rows first (Shift/Ctrl+click or Select all).", "Step grid", "Icon! Owner" . dlg.Hwnd)
        return rows
    }
    fromBox(ctl, key, values, onlyClicks, *) {
        if ctl.Value && (rows := allSelected()).Length
            apply(rows, key, values[ctl.Value], onlyClicks)
        ctl.Value := 0
        lv.Focus()
    }
    setWait(*) {
        if !(rows := allSelected()).Length
            return
        text := Trim(edWait.Value)
        apply(rows, "delayMs", text = "" ? "" : Integer(text))
        lv.Focus()
    }
    rowMenu(ctl, item, isRightClick, x, y) {
        if !(rows := allSelected()).Length
            return
        m := Menu()
        for i, text in winText
            m.Add("Window: " . text, ((v, *) => apply(rows, "winMatch", v)).Bind(winVals[i]))
        m.Add()
        m.Add("Find by: picture", (*) => apply(rows, "find", "", true))
        m.Add("Find by: coordinates (recorded spot)", (*) => apply(rows, "find", "spot", true))
        m.Add()
        m.Add("Wait before...", (*) => onDoubleWait(rows))
        m.Show()
    }
    onDoubleWait(rows) {
        dlg.Opt("+OwnDialogs")
        r := InputBox("Wait before " . rows.Length . " step(s), in ms (blank = automatic from Speed):",
            "Wait before", "w320 h130", steps[rows[1]].Get("delayMs", ""))
        if r.Result = "OK" && RegExMatch(Trim(r.Value), "^\d*$")
            apply(rows, "delayMs", Trim(r.Value) = "" ? "" : Integer(Trim(r.Value)))
    }
    apply(rows, key, value, onlyClicks := false) {
        VMB_Snapshot()
        for r in rows {
            st := steps[r]
            if key = "winMatch" && !(st.Get("win", "") is Map)
                continue
            if onlyClicks && !(st["type"] = "click" || st["type"] = "drag")
                continue
            VM__SetOrDelete(st, key, value)
            showRow(r)
        }
        s.Dirty := true
        state.Changed := true
    }
    onDouble(ctl, row) {
        DllCall("GetCursorPos", "Ptr", pt := Buffer(8))
        DllCall("ScreenToClient", "Ptr", lv.Hwnd, "Ptr", pt)
        hit := Buffer(24, 0)
        NumPut("Int", NumGet(pt, 0, "Int"), "Int", NumGet(pt, 4, "Int"), hit)
        SendMessage(0x1039, 0, hit, lv)                     ; LVM_SUBITEMHITTEST
        row := NumGet(hit, 12, "Int") + 1, col := NumGet(hit, 16, "Int") + 1
        if row < 1 || row > steps.Length
            return
        rows := selectedRows(row)
        m := Menu()
        switch col {
            case 3:
                for i, text in winText
                    m.Add("Window: " . text, ((v, *) => apply(rows, "winMatch", v)).Bind(winVals[i]))
            case 4:
                m.Add("Find by: picture", (*) => apply(rows, "find", "", true))
                m.Add("Find by: coordinates (recorded spot)", (*) => apply(rows, "find", "spot", true))
            case 5:
                onDoubleWait(rows)
                return
            default:
                return VMB_Status("Double-click the Window, Find by or Wait before column.")
        }
        m.Show()
    }
    finish(*) {
        dlg.Destroy()
        if state.Changed {
            VMB_Refresh()
            VMB_SyncWinMatch()
            VMB_Status("Step grid changes applied - Save to keep them (Ctrl+Z undoes).")
        }
    }

    for i, st in steps {
        c := cells(st)
        lv.Add(, i, c[1], c[2], c[3], c[4], c[5])
    }
    ticked := Map()
    for node in VMB_CheckedNodes()
        for st in (VMF_IsStep(node) ? [node] : VMF_Flatten([node]))
            ticked[st] := 1
    for i, st in steps
        if ticked.Has(st)
            lv.Modify(i, "Select")
    for col, w in [40, 470, 150, 100, 110, 190]
        lv.ModifyCol(col, w)
    lv.OnEvent("DoubleClick", onDouble)
    lv.OnEvent("ContextMenu", rowMenu)
    ddWin.OnEvent("Change", fromBox.Bind(ddWin, "winMatch", winVals, false))
    ddFind.OnEvent("Change", fromBox.Bind(ddFind, "find", ["", "spot"], true))
    btnWait.OnEvent("Click", setWait)
    btnAll.OnEvent("Click", (*) => (lv.Modify(0, "Select"), lv.Focus()))
    btnClose.OnEvent("Click", finish)
    dlg.OnEvent("Close", finish)
    dlg.OnEvent("Escape", finish)
    dlg.OnEvent("Size", (g, minMax, w, h) => minMax = -1 ? 0 : (lv.Move(, , w - 20, h - 86), btnAll.Move(, h - 36),
        btnClose.Move(, h - 36)))
    dlg.Show()
}

; @summary Right-click menu on the macro tree.
; @tags macro, gui, blocks
VMB_TreeMenu(ctl, item, isRightClick, x, y) {
    if VM_IsRecording() || VM_IsPlaying()
        return
    if item
        ctl.Modify(item, "Select")
    m := Menu()
    m.Add("⚡ Make this step vary (Auto-Loop)...`tCtrl+L", V8_VarySelectedDialog)
    m.Add("🧭 Deterministic Inspector & Layout Physics Lab...`tCtrl+Shift+D", V10_ShowDeterministicLab)
    varyQuick := Menu()
    varyQuick.Add("📏 Measure Row 1 -> Row 2 stride on screen (F6 twice) + Auto-Loop...", (*) => V8_QuickMeasureStrideForSelected())
    varyQuick.Add("↓ Move click DOWN 24 px each round + Repeat 10x", (*) => V8_ApplyQuickPreset(0, 24, "repeat", 10))
    varyQuick.Add("↓ Move click DOWN 30 px each round + Repeat 10x", (*) => V8_ApplyQuickPreset(0, 30, "repeat", 10))
    varyQuick.Add("→ Move click RIGHT 100 px each round + Repeat 5x", (*) => V8_ApplyQuickPreset(100, 0, "repeat", 5))
    varyQuick.Add("🎯 Pick multiple spots on screen (spot 1, 2, 3...) + Auto-Loop...", (*) => V8_QuickPickSpotsForSelected())
    varyQuick.Add("⌨ Press {Down} 1x on round 1, 2x on round 2... + Repeat 10x", (*) => V8_ApplyQuickKeyPreset("Down", 1, 1, "repeat", 10))
    varyQuick.Add("⌨ Press {Down} (0x on round 1, 1x on round 2...) + Repeat 10x", (*) => V8_ApplyQuickKeyPreset("Down", 0, 1, "repeat", 10))
    varyQuick.Add("🔢 Type incrementing number (1, 2, 3...) + Repeat 10x", (*) => V8_ApplyQuickTextPreset("{{index}}", "repeat", 10))
    varyQuick.Add()
    varyQuick.Add("Clear variation on this step (make fixed again)", (*) => V8_ClearVaryOnSelected())
    m.Add("⚡ Quick Vary Presets (1-click)", varyQuick)
    m.Add()
    m.Add("Edit...`tF2", VMB_EditSelected)
    m.Add("Quick Look preview`tSpace", V7_QuickLook)
    m.Add("Test target", VMB_TestSelected)
    m.Add("New picture...", VMB_NewPicture)
    m.Add("Play only this / ticked", (*) => VMB_Play(true))
    m.Add("Step through only this / ticked", (*) => VMB_Play(true, "step"))
    m.Add("Run to here, then step`tCtrl+F10", VMB_RunToHere)
    m.Add("Breakpoint here (pause before this line)`tF9", VMB_ToggleBreakpoint)
    if item && (bpInfo := VMB().Items.Get(item, 0)) && bpInfo.Kind = "node" && bpInfo.Node.Get("breakpoint", 0)
        m.Check("Breakpoint here (pause before this line)`tF9")
    m.Add("Clear all breakpoints`tCtrl+Shift+F9", VMB_ClearBreakpoints)
    m.Add()
    m.Add("Copy`tCtrl+C", VMB_Copy)
    m.Add("Paste`tCtrl+V", VMB_Paste)
    m.Add("Duplicate`tCtrl+D", VMB_Duplicate)
    m.Add("Disable / enable`tCtrl+E", VMB_ToggleDisabled)
    m.Add("Add Else if (to this If)...", VMB_AddElifToSelection)
    m.Add()
    m.Add("🎯 Convert ticked / selected to Coordinates + Any window of program (1-click fix)", (*) => VMB_MakeFlexible("selection", "program"))
    m.Add("🌐 Convert ENTIRE macro to Coordinates + Any window of program", (*) => VMB_MakeFlexible("all", "program"))
    findMenu := Menu()
    findMenu.Add("Coordinates (recorded spot) — ticked / selected", (*) => VMB_SetFindMode("spot", "selection"))
    findMenu.Add("Picture (image match) — ticked / selected", (*) => VMB_SetFindMode("", "selection"))
    findMenu.Add()
    findMenu.Add("ALL clicks in macro -> Coordinates (recorded spot)", (*) => VMB_SetFindMode("spot", "all"))
    findMenu.Add("ALL clicks in macro -> Picture (image match)", (*) => VMB_SetFindMode("", "all"))
    m.Add("Find target by (ticked / selected / all clicks)", findMenu)
    winMenu := Menu()
    winMenu.Add("This exact window (title)", (*) => VMB_SetWinMatch(""))
    winMenu.Add("Any window of the same program", (*) => VMB_SetWinMatch("program"))
    winMenu.Add("Whatever window is active (no switching)", (*) => VMB_SetWinMatch("active"))
    winMenu.Add()
    winMenu.Add("ALL steps in macro -> This exact window (title)", (*) => VMB_SetWinMatch("", "all"))
    winMenu.Add("ALL steps in macro -> Any window of the same program", (*) => VMB_SetWinMatch("program", "all"))
    winMenu.Add("ALL steps in macro -> Whatever window is active (no switching)", (*) => VMB_SetWinMatch("active", "all"))
    m.Add("Which window (ticked / selected / all in block)", winMenu)
    m.Add("Tick all`tCtrl+A", VMB_CheckAll)
    m.Add("Untick all", VMB_UncheckAll)
    m.Add("Step grid (edit Window / Find by / Wait for many steps)...", VMB_StepGrid)
    m.Add("Show columns", V22_ToggleColumns)        ; V22: step list in fixed columns on / off
    if VMB().Columns
        m.Check("Show columns")
    m.Add()
    m.Add("Move up`tCtrl+Up", (*) => VMB_MoveSelected(-1))
    m.Add("Move down`tCtrl+Down", (*) => VMB_MoveSelected(1))
    m.Add("Move into block above`tCtrl+Right", VMB_Indent)
    m.Add("Move out of block`tCtrl+Left", VMB_Outdent)
    m.Add()
    m.Add("Expand all", (*) => VMB_ExpandAll(true))
    m.Add("Collapse all", (*) => VMB_ExpandAll(false))
    m.Add("Code view...", VMB_CodeView)
    m.Add()
    m.Add("Delete`tDel", VMB_DeleteSelected)
    m.Show()
}

; ============================================================================
; MakeCode-style editing: undo/redo, copy/paste/duplicate, disable, code view, zoom
; ============================================================================

; @summary Saves the block tree for Undo (call before a change); clears Redo. Keeps the last 60 states.
;          In V7, also schedules an automatic background save so no work is ever lost.
; @tags macro, gui, blocks, makecode
VMB_Snapshot() {
    s := VMB()
    s.Undo.Push(JSON.Stringify(s.Macro["blocks"]))
    if s.Undo.Length > 60
        s.Undo.RemoveAt(1)
    s.Redo := []
    s.LastNotes := Map()            ; V21: step numbers may shift, so the last run's notes no longer fit
    V7_ScheduleAutoSave()
}

; @summary Forgets the last Undo snapshot (the change it was taken for was cancelled).
; @tags macro, gui, blocks
VMB_DropSnapshot() {
    s := VMB()
    if s.Undo.Length
        s.Undo.Pop()
}

; @summary Ctrl+Z: puts the block tree back to before the last change.
; @tags macro, gui, blocks, makecode
VMB_Undo(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    if !s.Undo.Length
        return VMB_Status("Nothing to undo.")
    s.Redo.Push(JSON.Stringify(s.Macro["blocks"]))
    s.Macro["blocks"] := JSON.Parse(s.Undo.Pop())
    s.Dirty := true
    VMB_Refresh()
    VMB_Status("Undone." . (s.Undo.Length ? "" : "  (nothing more to undo)"))
}

; @summary Ctrl+Y: re-does the last undone change.
; @tags macro, gui, blocks, makecode
VMB_Redo(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    if !s.Redo.Length
        return VMB_Status("Nothing to redo.")
    s.Undo.Push(JSON.Stringify(s.Macro["blocks"]))
    s.Macro["blocks"] := JSON.Parse(s.Redo.Pop())
    s.Dirty := true
    VMB_Refresh()
    VMB_Status("Redone.")
}

; @summary Ctrl+C: copies the ticked lines (or the selected step/block, with everything inside) inside this program.
; @tags macro, gui, blocks, makecode
VMB_Copy(*) {
    s := VMB()
    nodes := VMB_TargetNodes("the step or block to copy")
    if !nodes.Length
        return
    s.Clip := JSON.Stringify(nodes)
    VMB_Status("Copied" . (nodes.Length > 1 ? " " . nodes.Length . " lines" : "") . ". Select where it should go and press Ctrl+V.")
}

; @summary Ctrl+V: pastes the copied line(s) at the selected spot (inside a selected loop/if).
; @tags macro, gui, blocks, makecode
VMB_Paste(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    if s.Clip = ""
        return VMB_Status("Nothing copied yet - select a line and press Ctrl+V.")
    clip := JSON.Parse(s.Clip)
    nodes := clip is Array ? clip : [clip]
    where := VMB_InsertPoint()
    if nodes.Length = 1 {
        VMB_InsertNode(nodes[1], where.List, where.Index)
        return VMB_Status("Pasted.")
    }
    if VMF_DataPickBlock(s.Macro["blocks"]) {
        kept := []
        for node in nodes
            if node.Get("type", "") != "pickdata"
                kept.Push(node)
        nodes := kept
    }
    if !nodes.Length
        return
    VMB_Snapshot()
    idx := VF_Clamp(where.Index, 1, where.List.Length + 1)
    for i, node in nodes
        where.List.InsertAt(idx + i - 1, node)
    s.Dirty := true
    VMB_Refresh(nodes[1])
    VMB_Status("Pasted " . nodes.Length . " lines.")
}

; @summary Ctrl+D: copies the ticked lines (or the selected step/block) and puts the copies right after them.
; @tags macro, gui, blocks, makecode
VMB_Duplicate(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    nodes := VMB_TargetNodes("the step or block to duplicate")
    if !nodes.Length
        return
    groups := Map(), order := []
    for node in nodes {
        list := s.Items[s.NodeItem[node]].List
        if !groups.Has(list) {
            groups[list] := []
            order.Push(list)
        }
        groups[list].Push(node)
    }
    VMB_Snapshot()
    copies := []
    for list in order {
        last := VMB_Locate(groups[list][groups[list].Length]).Index
        for i, node in groups[list] {
            copy := JSON.Parse(JSON.Stringify(node))
            list.InsertAt(last + i, copy)
            copies.Push(copy)
        }
    }
    s.Dirty := true
    VMB_Refresh(copies[1])
    VMB_Status("Duplicated" . (copies.Length > 1 ? " " . copies.Length . " lines" : "") . ".")
}

; @summary Ctrl+E: disables (greys out - skipped when played) or re-enables the selected step or block.
; @tags macro, gui, blocks, makecode
VMB_ToggleDisabled(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    ticked := VMB_CheckedNodes()
    if ticked.Length {
        VMB_Snapshot()
        off := !ticked[1].Get("disabled", 0)
        for node in ticked
            VM__SetOrDelete(node, "disabled", off ? 1 : "")
        s.Dirty := true
        VMB_Refresh()
        return VMB_Status((off ? "Disabled " : "Enabled ") . ticked.Length . " ticked line(s).")
    }
    info := VMB_SelectedNode("the step or block to disable")
    if !info
        return
    VMB_Snapshot()
    node := info.Node
    off := !node.Get("disabled", 0)
    VM__SetOrDelete(node, "disabled", off ? 1 : "")
    s.Dirty := true
    VMB_Refresh(node)
    VMB_Status(off ? "Disabled - it is skipped when the macro plays (Ctrl+E turns it back on)." : "Enabled again.")
}

; @summary Expands or collapses every loop/if in the macro tree.
; @tags macro, gui, blocks
VMB_ExpandAll(expand) {
    s := VMB()
    for id, info in s.Items {
        if info.Kind = "else" || info.Kind = "elif" || (info.Kind = "node" && VMF_IsContainer(info.Node))
            s.TV.Modify(id, expand ? "Expand" : "-Expand")
    }
}

; @summary Code view (like MakeCode's JavaScript tab): the macro as indented text, read-only, with Copy.
; @tags macro, gui, blocks, makecode
VMB_CodeView(*) {
    s := VMB()
    text := VMF_ToText(s.Macro["blocks"])
    if text = ""
        text := "// (the macro is empty)"
    name := "Untitled"
    if s.Path != ""
        SplitPath(s.Path, &name)
    dlg := Gui("+Owner" . s.Gui.Hwnd . " +Resize +MinSize400x200", "Code view - " . name)
    dlg.SetFont("s10", "Consolas")
    box := dlg.AddEdit("w820 h480 ReadOnly -Wrap +HScroll", text)
    dlg.SetFont("s9", "Segoe UI")
    btnCopy := dlg.AddButton("w130", "Copy to clipboard")
    btnClose := dlg.AddButton("x+8 w90 Default", "Close")
    btnCopy.OnEvent("Click", (*) => (A_Clipboard := text, VMB_Status("Code view copied to the clipboard.")))
    btnClose.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    dlg.OnEvent("Size", (g, minMax, w, h) => minMax = -1 ? 0 : (box.Move(, , w - 20, h - 56), btnCopy.Move(, h - 38),
        btnClose.Move(, h - 38)))
    dlg.Show()
}

; @summary Ctrl+Plus / Ctrl+Minus / Ctrl+0: bigger, smaller or normal text in the macro tree (remembered).
; @tags macro, gui, blocks, makecode
VMB_Zoom(delta) {
    s := VMB()
    s.FontSize := delta = 0 ? 9 : VF_Clamp(s.FontSize + delta, 7, 20)
    V22_ApplyTreeFont()                 ; V22: Consolas + exact indent in column mode
    V22_PlaceHeader()
    IniWrite(s.FontSize, s.Ini, "Blocks", "FontSize")
    VMB_Status("Tree text size " . s.FontSize . ".")
}

; @summary True when the editor window is active, idle, and the focus is not in a text box (for undo/redo/zoom keys).
; @tags macro, gui, hotkey
VMB_EditorActive(*) {
    s := VMB()
    if !s.Gui || VM_IsPlaying() || VM_IsRecording() || !WinActive("ahk_id " . s.Gui.Hwnd)
        return false
    try return !RegExMatch(ControlGetClassNN(ControlGetFocus("ahk_id " . s.Gui.Hwnd)), "^Edit")
    return true
}

; @summary True while the macro tree has the keyboard focus (for the tree hotkeys).
; @tags macro, gui, hotkey
VMB_TreeFocused(*) {
    s := VMB()
    return s.TV && !VM_IsPlaying() && !VM_IsRecording() && WinActive("ahk_id " . s.Gui.Hwnd)
        && DllCall("GetFocus", "Ptr") = s.TV.Hwnd
}

; ============================================================================
; Recording
; ============================================================================

; @summary Record button / Ctrl+Shift+R: starts recording, or stops it when already recording.
; @tags macro, record
VMB_ToggleRecord(*) {
    if !VMB().Gui
        return
    if VM_IsPlaying()
        return
    if VM_IsRecording()
        VMB_StopRecording()
    else {
        s := VMB()
        ; V18: an empty macro needs no window pick - the first program used becomes the Macro window.
        if s.Easy && Trim(s.Macro["settings"].Get("defaultTarget", "")) = "" && !V18_CanAutoPick() && !V17_PickWindow()
            return
        VMB_StartRecording()
    }
}

; @summary Starts recording into a fresh list; the steps are inserted at the selected spot when recording stops.
; @tags macro, record, blocks
VMB_StartRecording() {
    s := VMB()
    s.RecTarget := VMB_InsertPoint()
    s.RecSteps := []
    s.RecWasEmpty := !s.Macro["blocks"].Length
    noticeSeen := Integer(IniRead(s.Ini, "V18", "RecordNoticeSeen", 0)) ? true : false
    if !VM_RecordStart(s.RecSteps, {OnChange: VMB_UpdateBanner, Quiet: noticeSeen,
        IgnoreChords: ["^+r", "^+p", "^+x", "^+m", "^+h", "^+k", "f7"]})
        return
    if !noticeSeen
        IniWrite(1, s.Ini, "V18", "RecordNoticeSeen")
    V17_RecWinStart()
    webOn := V16_CdpRecStart()
    s.Ctl["Pause"].Text := "Pause recording"
    VMB_SetBusyUi(true)
    if s.Ctl["Hide"].Value
        s.Gui.Hide()
    VMB_ShowBanner()
    V7_SyncIdleHud()
    VMB_Status("Recording" . (webOn ? " (desktop + web tab via CDP)" : "")
        . " - do the task now. Click the red REC bar (or Ctrl+Shift+R) to stop. Alt+Click / F7 marks a step that varies.")
}

; @summary Stops recording, finishes the target pictures and inserts the new steps where recording started.
;          In V8, if any step was marked with Alt+Click or F7 as a varying step, automatically opens the Vary + Auto-Loop wizard!
; @tags macro, record, blocks
VMB_StopRecording() {
    s := VMB()
    VMB_Status("Finishing target pictures...")
    VM_RecordStop()
    webEvents := V16_CdpRecStop()
    VMB_HideBanner()
    VMB_SetBusyUi(false)
    tidy := V18_TidySteps(s.RecSteps)
    steps := V16_MergeWebSteps(s.RecSteps, webEvents), where := s.RecTarget
    s.RecSteps := 0
    s.LastNotes := Map()                ; V21: forget the last run's notes
    markedStep := 0, autoNote := ""
    if steps.Length {
        VMB_Snapshot()
        steps[1]["gapMs"] := Min(steps[1].Get("gapMs", 0), 300)      ; not the time it took to get started
        VMB_ApplyDefaultFind(steps)
        idx := VF_Clamp(where.Index, 1, where.List.Length + 1)
        for step in steps {
            if !markedStep && step.Get("varyMarked", 0) {
                step.Delete("varyMarked")
                markedStep := step
            }
            where.List.InsertAt(idx, step)
            idx += 1
        }
        autoNote := V18_FinishRecording()
        s.Dirty := true
        s.LastEditedStep := "#" . steps.Length . " recorded (" . FormatTime(, "HH:mm") . ")"
        VMB_Refresh(markedStep ? markedStep : steps[steps.Length])
        V17_UpdateWinInfo()
        V7_AutoSaveNow()
    }
    s.Gui.Show()
    V7_SyncIdleHud()
    if markedStep {
        VMB_Status("Opening Smart Vary & Auto-Loop for the step you marked during recording...")
        V8_VaryDialog(markedStep, steps)
    } else {
        VMB_Status("Recorded " . steps.Length . " steps" . (tidy ? " (" . tidy . " double-click / wheel repeats joined)" : "")
            . "." . autoNote . "  Press Play (F5) to repeat it"
            . (s.Easy ? "." : ", or right-click a step -> '⚡ Make this step vary (Auto-Loop)...' (Ctrl+L)."))
    }
}

; @summary Pause/resume recording.
; @tags macro, record
VMB_TogglePause(*) {
    s := VMB()
    if !VM_IsRecording()
        return
    paused := !VM_Rec().Paused
    VM_RecordPause(paused)
    s.Ctl["Pause"].Text := paused ? "Resume recording" : "Pause recording"
    VMB_UpdateBanner()
    V7_SyncIdleHud()
}

; @summary Stop button: stops recording or playback.
; @tags macro
VMB_StopAny(*) {
    if VM_IsRecording()
        VMB_StopRecording()
    else if VM_IsPlaying()
        VM_RequestStop()
}

; @summary Shows the small click-through REC banner (bottom-left of the primary screen).
; @tags macro, gui
VMB_ShowBanner() {
    s := VMB()
    if !s.Banner {
        ; V18: no longer click-through - a click on the bar stops recording. It never takes the focus (E0x08000000).
        b := Gui("-Caption +AlwaysOnTop +ToolWindow +E0x08000000", "Visual Macro Blocks REC")
        b.BackColor := "B00020"
        b.SetFont("s9 bold cWhite", "Segoe UI")
        s.BannerText := b.AddText("x0 y0 w496 h26 +0x200", "  REC")       ; SS_CENTERIMAGE: one line, centred vertically
        s.BannerText.OnEvent("Click", VMB_StopAny)
        s.Banner := b
    }
    MonitorGetWorkArea(MonitorGetPrimary(), &left, , , &bottom)
    s.Banner.Show("NA x" . (left + 8) . " y" . (bottom - 34) . " w496 h26")
    WinSetTransparent(215, "ahk_id " . s.Banner.Hwnd)
    VMB_UpdateBanner()
}

; @summary Updates the banner with the new-step count and paused state.
; @tags macro, gui
VMB_UpdateBanner(*) {
    s := VMB()
    V7_SyncIdleHud()
    if !s.Banner || !VM_IsRecording() || !IsObject(s.RecSteps)
        return
    s.BannerText.Text := "  " . (VM_Rec().Paused ? "PAUSED" : "● REC") . "   " . s.RecSteps.Length
        . " steps   •   CLICK HERE (or Ctrl+Shift+R) to stop   •   Alt+Click / F7 = varying step"
}

; @summary Hides the REC banner.
; @tags macro, gui
VMB_HideBanner() {
    s := VMB()
    if s.Banner
        s.Banner.Hide()
}

; ============================================================================
; Playback
; ============================================================================

; @summary Plays the macro (or only the selected block) with the run bar. startMode "step" pauses before the first
;          step (step by step); runTo (a node) runs until that line and then pauses. Breakpoints (●) always pause, and
;          F10 pauses a normal run. Corrections made during the run are saved to the file right away (or marked unsaved
;          when the macro has other unsaved edits / no file).
; @tags macro, playback, blocks, debug
VMB_Play(onlySelected := false, startMode := "run", runTo := 0) {
    if !VMB().Gui
        return
    s := VMB()
    if VM_IsPlaying()
        return
    if VM_IsRecording()
        VMB_StopRecording()
    VMB_ControlsToSettings()
    macro := s.Macro
    if onlySelected {
        nodes := VMB_TargetNodes("the block to play")
        if !nodes.Length
            return
        macro := Map("format", "VisualMacro", "version", 2, "name", s.Macro["name"], "settings", s.Macro["settings"],
            "blocks", nodes)
    }
    if !macro["blocks"].Length
        return VMB_Status("Nothing to play yet - drag in some blocks or record first.")
    opts := {}
    settings := s.Macro["settings"]
    dataSet := settings.Get("data", "")
    if dataSet is Map && dataSet.Get("path", "") != "" && FileExist(dataSet["path"]) {
        try {
            opts.Data := VMB_GetData(dataSet["path"], dataSet.Get("header", "auto"))
        } catch as err {
            if !VMF_DataPickBlock(macro["blocks"])
                return VMB_Status("Could not read the data file: " . err.Message)
        }
        opts.FirstRow := Max(1, dataSet.Get("firstRow", 1))
        opts.LastRow := dataSet.Get("lastRow", 0)
        name := s.Macro.Get("name", "") != "" ? s.Macro["name"] : "macro"
        opts.ResultsPath := s.Dir . "\results\" . RegExReplace(name, "[\\/:*?`"<>|]", "_") . "-"
            . FormatTime(, "yyyyMMdd-HHmmss") . ".csv"
    }
    d := V5_Dbg()
    d.Arrows := IniRead(s.Ini, "Blocks", "StepArrows", 1) ? true : false
    bx := IniRead(s.Ini, "Blocks", "RunBarX", ""), by := IniRead(s.Ini, "Blocks", "RunBarY", "")
    d.BarX := IsInteger(bx) ? Integer(bx) : "", d.BarY := IsInteger(by) ? Integer(by) : ""
    if s.IdleHud
        s.IdleHud.SuspendForRun(true)
    bar := V5RunBar("Visual Macro Blocks V16", VMB_ToggleEditorFromBar)
    s.Panel := bar
    opts.OnStatus := VMB_PlayStatus
    opts.Debug := true, opts.Bar := bar, opts.StartMode := startMode
    if IsObject(runTo)
        opts.RunTo := runTo
    wasVisible := DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int")
    if wasVisible && s.Ctl["Hide"].Value
        s.Gui.Hide()
    wasDirty := s.Dirty
    keptNotes := s.LastNotes        ; V21: VMB_Snapshot clears them; a run of only the selected steps leaves them as they were
    VMB_Snapshot()                  ; corrections made while it plays can be undone
    s.PlayFlat := VMF_Flatten(macro["blocks"])
    VMB_SetBusyUi(true)
    VMB_Status(startMode = "step" ? "Step by step: Down (or F10) runs the next step, F5 runs on, Esc stops."
        : "Playing...  F10 pauses, Esc stops.")
    V18_WaitModsUp()                ; Ctrl+Shift+P still held down would turn the first clicks into Ctrl+Shift+clicks
    try {
        result := VM_Play(macro, opts)
    } catch as err {
        result := {Ok: false, Index: 0, Message: err.Message, Changed: false, Failed: 0, Skipped: 0}
    }
    bar.Close()
    if d.BarX != "" {
        IniWrite(d.BarX, s.Ini, "Blocks", "RunBarX")
        IniWrite(d.BarY, s.Ini, "Blocks", "RunBarY")
    }
    if s.IdleHud
        s.IdleHud.SuspendForRun(false)
    if result.HasOwnProp("RunToMissed") && result.RunToMissed
        result.Message .= "  (The line you chose to run to was never reached.)"
    s.Panel := 0
    s.PlayFlat := []
    VMB_SetBusyUi(false)
    note := ""
    if !result.Changed
        VMB_DropSnapshot()
    if result.Changed {
        if s.Path != "" && !wasDirty {
            try {
                VM_Save(s.Macro, s.Path)
                note := "   Your corrections were saved to the file."
            } catch as err {
                s.Dirty := true
                note := "   Could not save your corrections: " . err.Message
            }
        } else {
            s.Dirty := true
            note := "   Corrections were made - Save to keep them."
        }
    }
    s.LastNotes := onlySelected ? keptNotes : V21_NoteSteps(result.HasOwnProp("Warnings") ? result.Warnings : [])
    played := VMF_Flatten(macro["blocks"])
    VMB_Refresh(result.Index && result.Index <= played.Length ? played[result.Index] : "")
    if wasVisible
        s.Gui.Show()
    resultsNote := opts.HasOwnProp("ResultsPath") && FileExist(opts.ResultsPath) ? "   Results: " . opts.ResultsPath : ""
    sizeNote := ""
    if result.HasOwnProp("Warnings") && result.Warnings.Length
        sizeNote := "   ⚠ " . result.Warnings[1] . (result.Warnings.Length > 1 ? "  (+" . (result.Warnings.Length - 1) . " more)" : "")
            . "  - see last-playback.log (F1)"
    VMB_Status(result.Message . note . resultsNote . sizeNote)
    if !result.Ok && !wasVisible
        TrayTip(result.Message, "Visual Macro Blocks", "Iconx")
    if resultsNote != "" && wasVisible && (result.Failed || result.Skipped || !result.Ok)
        && MsgBox(result.Message . "`n`nOpen the results file (which rows were done, failed or skipped)?",
            "Visual Macro Blocks - data run", "YesNo Iconi Owner" . s.Gui.Hwnd) = "Yes"
        try Run('"' . opts.ResultsPath . '"')
}

; @summary Playback status callback: lights up the running (or paused-at) step in the tree (yellow, like MakeCode's
;          simulator) when the window is visible. The run bar is updated by the runner itself.
; @tags macro, playback, gui, makecode
VMB_PlayStatus(i, n, pass, text, row := 0, lastRow := 0) {
    s := VMB()
    if i >= 1 && i <= s.PlayFlat.Length && s.NodeItem.Has(s.PlayFlat[i])
        && DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int") {
        s.HiItem := s.NodeItem[s.PlayFlat[i]]
        SendMessage(0x1114, 0, s.HiItem, s.TV)      ; TVM_ENSUREVISIBLE
        DllCall("InvalidateRect", "Ptr", s.TV.Hwnd, "Ptr", 0, "Int", 1)
    }
}

; @summary Run bar "Show my macro" button: shows the editor without taking the focus (so the yellow line can be
;          followed) or hides it again. Returns true when the editor is now visible.
; @tags macro, playback, gui, debug
VMB_ToggleEditorFromBar() {
    s := VMB()
    if DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int") {
        s.Gui.Hide()
        return false
    }
    s.Gui.Show("NA")
    if (runner := V4_RunState().Runner)
        VMB_PlayStatus(runner.Index, runner.Flat.Length, 0, "")
    return true
}

; @summary F9: turns the breakpoint (●) on the selected line on or off. Playback pauses before a breakpoint line
;          every time it reaches it (also inside loops). Saved with the macro; exported players ignore breakpoints.
; @tags macro, blocks, debug
VMB_ToggleBreakpoint(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    nodes := VMB_TargetNodes("the line to pause at")
    if !nodes.Length
        return
    VMB_Snapshot()
    on := !nodes[1].Get("breakpoint", 0)
    for node in nodes
        VM__SetOrDelete(node, "breakpoint", on ? 1 : "")
    s.Dirty := true
    VMB_Refresh(nodes[1])
    if nodes.Length > 1
        return VMB_Status((on ? "Breakpoint set on " : "Breakpoint removed from ") . nodes.Length . " ticked line(s).")
    VMB_Status(on ? "Breakpoint set (●). Playback will pause before this line - then Down steps, F5 runs on."
        . "  F9 again removes it." : "Breakpoint removed.")
}

; @summary Ctrl+Shift+F9: removes every breakpoint in the macro.
; @tags macro, blocks, debug
VMB_ClearBreakpoints(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    marked := []
    for node in VMF_Flatten(s.Macro["blocks"])
        if node.Get("breakpoint", 0)
            marked.Push(node)
    if !marked.Length
        return VMB_Status("There are no breakpoints.")
    VMB_Snapshot()
    for node in marked
        node.Delete("breakpoint")
    s.Dirty := true
    VMB_Refresh()
    VMB_Status("Removed " . marked.Length . " breakpoint(s).  Ctrl+Z brings them back.")
}

; @summary Ctrl+F10 / "Run to here": plays from the start at normal speed and pauses just before the selected line.
; @tags macro, playback, debug
VMB_RunToHere(*) {
    if VM_IsRecording() || VM_IsPlaying()
        return
    info := VMB_SelectedNode("the line to run to")
    if !info
        return
    if info.Node.Get("disabled", 0)
        return VMB_Status("That line is disabled (it never runs). Enable it first with Ctrl+E.")
    VMB_Play(false, "run", info.Node)
}

; ============================================================================
; Data file
; ============================================================================

; @summary True when the macro has a data file (or asks for one when it starts).
; @tags macro, data
VMB_HasData() {
    dataSet := VMB().Macro["settings"].Get("data", "")
    return dataSet is Map && dataSet.Get("path", "") != "" || VMF_DataPickBlock(VMB().Macro["blocks"])
}

; @summary Choose a data file: CSV/TSV/TXT, Excel, Word, PDF or HTML (any list or table).
; @tags macro, csv, excel
VMB_ChooseData(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    path := FileSelect(1, s.Dir, "Choose a data file (a table or any list)",
        "Data and lists (*.csv; *.tsv; *.txt; *.xlsx; *.xlsm; *.xls; *.ods; *.docx; *.doc; *.rtf; *.pdf; *.htm; *.html)")
    if path != ""
        VMB_SetDataFile(path)
}

; @summary Uses a data file after reading it once to check it.
; @tags macro, csv
VMB_SetDataFile(path) {
    s := VMB()
    try {
        data := VMB_GetData(path, "auto")
    } catch as err {
        MsgBox("Could not read that data file:`n`n" . err.Message, "Data file", "Iconx Owner" . s.Gui.Hwnd)
        return
    }
    s.Macro["settings"]["data"] := Map("path", path)
    s.Dirty := true
    V7_AddRecent("DataFiles", path)
    VMB_SettingsToControls()
    VMB_Refresh()
    V7_ScheduleAutoSave()
    VMB_Status("Data set: " . data.Rows.Length . " rows. Put the steps that use a row inside a 'For each data row' block.")
}

; @summary Paste a list; it is saved under VisualMacros\data and used as the data file.
; @tags macro, csv
VMB_PasteData(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "Paste a list")
    dlg.SetFont("s9", "Segoe UI")
    dlg.AddText("w460", "Paste the list (one item per line, or a table copied from Excel/Word/email):")
    box := dlg.AddEdit("xm w460 r16 WantTab")
    btnOk := dlg.AddButton("xm w90 Default", "OK")
    btnCancel := dlg.AddButton("x+8 w90", "Cancel")
    state := {Text: ""}
    hwnd := dlg.Hwnd
    btnOk.OnEvent("Click", (*) => (state.Text := box.Value, dlg.Destroy()))
    btnCancel.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    dlg.Show()
    WinWaitClose("ahk_id " . hwnd)
    if Trim(state.Text, " `t`r`n") = ""
        return
    path := s.Dir . "\data\list-" . FormatTime(, "yyyyMMdd-HHmmss") . ".txt"
    try {
        DirCreate(s.Dir . "\data")
        FileAppend(state.Text, path, "UTF-8")
    } catch as err {
        return VMB_Status("Could not save the list: " . err.Message)
    }
    VMB_SetDataFile(path)
}

; @summary Header choice changed: store it and re-read the data.
; @tags macro, csv
VMB_OnHeaderChanged(*) {
    s := VMB()
    dataSet := s.Macro["settings"].Get("data", "")
    if !(dataSet is Map)
        return
    VM__SetOrDelete(dataSet, "header", ["", "yes", "no"][Max(1, s.Ctl["Header"].Value)])
    s.Dirty := true
    VMB_SettingsToControls()
    VMB_UpdateTitle()
}

; @summary Remove the data file.
; @tags macro, csv
VMB_ClearData(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !s.Macro["settings"].Has("data")
        return
    s.Macro["settings"].Delete("data")
    s.Dirty := true
    VMB_SettingsToControls()
    VMB_Refresh()
    VMB_Status("Data file cleared.")
}

; @summary Loads a data file (with a header choice), cached until the file changes.
; @tags macro, csv, excel
VMB_GetData(path, header := "auto") {
    s := VMB()
    key := path . "|" . header
    stamp := FileExist(path) ? FileGetTime(path, "M") . "|" . FileGetSize(path) : ""
    if s.DataCache.Has(key) && s.DataCache[key].Stamp = stamp
        return s.DataCache[key].Data
    data := VM_LoadData(path, header)
    s.DataCache[key] := {Stamp: stamp, Data: data}
    return data
}

; @summary Names offered by Insert {{column}}: drug-list helpers, the data file's headers, then the built-ins.
; @tags macro, csv, drug-search
VMB_ColumnChoices() {
    s := VMB()
    names := []
    dataSet := s.Macro["settings"].Get("data", "")
    if dataSet is Map && dataSet.Get("path", "") != "" {
        try {
            data := VMB_GetData(dataSet["path"], dataSet.Get("header", "auto"))
            if data.DrugCol {
                for name in ["search", "drug", "search::4:3", "search::3:0"]
                    names.Push(name)
            }
            for name in data.Headers {
                if name != ""
                    names.Push(name)
            }
        }
    }
    for name in ["row", "index", "date", "date:yyyy-MM-dd", "time", "clipboard"]
        names.Push(name)
    for , name in VMF_VarNames(s.Macro["blocks"])
        names.Push(name)
    return names
}

; ============================================================================
; Files
; ============================================================================

; @summary New macro (after offering to save changes).
; @tags macro, file
VMB_New(*) {
    if VM_IsRecording() || VM_IsPlaying()
        return
    if VMB_ConfirmDiscard()
        VMB_SetMacro(VMF_NewMacro(), "")
}

; @summary Open a .vmacro.json file (Recorder macros are converted to blocks).
; @tags macro, file
VMB_Open(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying() || !VMB_ConfirmDiscard()
        return
    path := FileSelect(3, s.Dir, "Open a visual macro", "Visual macros (*.vmacro.json; *.json)")
    if path = ""
        return
    try VMB_LoadFile(path)
    catch as err
        MsgBox(err.Message, "Open macro", "Iconx Owner" . s.Gui.Hwnd)
}

; @summary Loads a macro file. A Recorder (flat) macro becomes a block macro that is saved as a new file.
; @tags macro, file, blocks
VMB_LoadFile(path) {
    s := VMB()
    macro := VM_Load(path)
    if !macro.Has("blocks") {
        VMB_SetMacro(VMF_FromSteps(macro), "")
        s.ConvertedFrom := path
        s.Dirty := true
        VMB_UpdateTitle()
        VMB_Status("Opened a Recorder macro as blocks. Save it as a new file - the original stays as it is.")
        return
    }
    VMB_SetMacro(macro, path)
    IniWrite(path, s.Ini, "Blocks", "LastFile")
    V7_AddRecent("Macros", path)
    VMB_Status("Opened " . path)
}

; @summary Save As: asks for a file name ending in .vmacro.json.
; @tags macro, file
VMB_SaveAs() {
    s := VMB()
    if s.Path != ""
        suggested := s.Path
    else if s.ConvertedFrom != ""
        suggested := RegExReplace(s.ConvertedFrom, "i)\.vmacro\.json$") . "-blocks.vmacro.json"
    else
        suggested := s.Dir . "\" . (s.Macro["name"] != "" ? s.Macro["name"] : "macro") . ".vmacro.json"
    path := FileSelect("S16", suggested, "Save visual macro", "Visual macros (*.vmacro.json)")
    if path = ""
        return false
    if !RegExMatch(path, "i)\.vmacro\.json$")
        path := RegExReplace(path, "i)\.json$") . ".vmacro.json"
    return VMB_SaveTo(path)
}

; @summary Saves to path (Save As when there is none) after checking the blocks and the privacy check.
; @tags macro, file, privacy
VMB_SaveTo(path) {
    s := VMB()
    if path = ""
        return VMB_SaveAs()
    if VM_IsRecording()
        VMB_StopRecording()
    VMB_ControlsToSettings()
    errs := VM_Validate(s.Macro)
    if errs.Length {
        list := ""
        for e in errs
            list .= A_Index <= 12 ? "`n  " . e : ""
        MsgBox("Fix these first (the file would not open again):" . list, "Save macro", "Icon! Owner" . s.Gui.Hwnd)
        return false
    }
    if !VMB_PrivacyCheck()
        return false
    SplitPath(path, , , , &baseName)
    s.Macro["name"] := RegExReplace(baseName, "i)\.vmacro$")
    try {
        VM_Save(s.Macro, path)
    } catch as err {
        MsgBox("Could not save:`n" . path . "`n`n" . err.Message, "Save macro", "Iconx Owner" . s.Gui.Hwnd)
        return false
    }
    s.Path := path
    s.ConvertedFrom := ""
    s.Dirty := false
    s.LastSavedAt := FormatTime(, "HH:mm:ss")
    IniWrite(path, s.Ini, "Blocks", "LastFile")
    V7_AddRecent("Macros", path)
    VMB_UpdateTitle()
    V7_RefreshMemoryBar()
    VMB_Status("Saved " . path)
    return true
}

; @summary Before saving: warns about Type steps that look like PHI and offers to make them "ask each time".
; @returns false if the user cancels the save
; @tags macro, privacy
VMB_PrivacyCheck() {
    s := VMB()
    setText := []
    VMB__CollectSetValues(s.Macro["blocks"], setText)
    if setText.Length && VM_PrivacyScan(Map("steps", setText)).Length
        && MsgBox("A 'Set variable' block has a value that looks like patient or personal information (an SSN, date,"
            . " long number or name). Use {{Column}} or {{clipboard}} instead of typing it in.`n`nSave anyway?",
            "Privacy check", "YesNo Icon! Owner" . s.Gui.Hwnd) != "Yes"
        return false
    flat := VMF_Flatten(s.Macro["blocks"])
    findings := VM_PrivacyScan(Map("steps", flat))
    if !findings.Length
        return true
    list := ""
    for f in findings {
        if A_Index > 10 {
            list .= "`n  ... and " . (findings.Length - 10) . " more"
            break
        }
        list .= "`n  Step #" . f.Index . ": " . f.Reason
    }
    answer := MsgBox("Some literal input fields may contain personal information (heuristic check, not a guarantee):" . list
        . "`n`nYes = change them to 'Ask for this text each time' (the typed text is removed from the file)"
        . "`nNo = save them as they are`nCancel = do not save", "Privacy check", "YesNoCancel Icon! Owner" . s.Gui.Hwnd)
    if answer = "Cancel"
        return false
    if answer = "Yes" {
        VMB_Snapshot()
        for f in findings {
            step := flat[f.Index]
            step["ask"] := 1
            step["text"] := ""
            if step.Has("value")
                step["value"] := ""
            if step.Get("prompt", "") = ""
                step["prompt"] := "Text for step " . f.Index . ":"
        }
        VMB_Refresh()
    }
    return true
}

; Set-variable values as pseudo Type steps, so the PHI scan can check them.
VMB__CollectSetValues(list, out) {
    for node in list {
        if !(node is Map)
            continue
        if node.Get("type", "") = "set"
            out.Push(Map("type", "text", "text", node.Get("value", "")))
        for child in VMF_Children(node)
            VMB__CollectSetValues(child, out)
    }
}

; @summary Export player: writes ONE stand-alone .ahk that plays this macro (macro embedded, player + engine inlined),
;          then opens the Daisy obfuscator window (ahk_daisy_ob.ahk2) with it loaded so you pick the options and build.
; @tags macro, file, export, bundle
VMB_ExportPlayer(*) {
    V4_ExportPlayer()
}

; @summary Number of enabled "Run another macro" blocks in a block list (any depth).
; @tags macro, blocks
VMB__CountCalls(list) {
    n := 0
    for node in list {
        if !(node is Map)
            continue
        if node.Get("type", "") = "call" && !node.Get("disabled", 0)
            n += 1
        for child in VMF_Children(node)
            n += VMB__CountCalls(child)
    }
    return n
}

; @summary Offers to save unsaved changes; returns false if the user cancels.
; @tags macro, file
VMB_ConfirmDiscard() {
    s := VMB()
    if !s.Dirty || !s.Macro["blocks"].Length
        return true
    answer := MsgBox("Save changes to the current macro first?", "Visual Macro Blocks", "YesNoCancel Icon? Owner" . s.Gui.Hwnd)
    if answer = "Cancel"
        return false
    if answer = "Yes"
        return VMB_SaveTo(s.Path)
    return true
}

; @summary Replaces the current macro and refreshes the window.
; @tags macro, gui
VMB_SetMacro(macro, path) {
    s := VMB()
    s.Macro := macro
    s.Path := path
    s.ConvertedFrom := ""
    s.Dirty := false
    s.Undo := [], s.Redo := []
    s.LastNotes := Map()            ; V21: a new or opened macro has no notes from a run
    s.Checked := Map()
    VMB_SettingsToControls()
    V7_LoadMemoryBar()
    VMB_Refresh()
}

; ============================================================================
; Window helpers
; ============================================================================

; @summary Tray menu: show, HUD, Memory Hub, Command Palette, record, play, exit.
; @tags macro, gui
VMB_BuildTray() {
    tray := A_TrayMenu
    tray.Delete()
    tray.Add("Show Visual Macro Blocks`tCtrl+Shift+M", (*) => V7_ShowMainGui())
    tray.Add("Toggle Floating HUD`tCtrl+Shift+H", (*) => V7_ToggleIdleHud())
    tray.Add("Deterministic Inspector & Physics Lab`tCtrl+Shift+D", (*) => V10_ShowDeterministicLab())
    tray.Add("Where Was I? (Memory & Files Hub)`tF1", (*) => V7_MemoryHub())
    tray.Add("Command Palette`tCtrl+Shift+K", (*) => V7_CommandPalette())
    tray.Add("Easy mode on / off", (*) => V17_ToggleEasy())
    tray.Add()
    tray.Add("Record / stop recording`tCtrl+Shift+R", (*) => VMB_ToggleRecord())
    tray.Add("Play`tCtrl+Shift+P", (*) => VMB_Play())
    tray.Add("Step by step", (*) => VMB_Play(false, "step"))
    tray.Add()
    tray.Add("Open Macros Folder", (*) => V7_OpenFolder(VMB().Dir))
    tray.Add("Open Script Folder", (*) => V7_OpenScriptFolder())
    tray.Add()
    tray.Add("Quit Completely`tCtrl+Shift+X", (*) => VMB_ExitApp())
    tray.Default := "Show Visual Macro Blocks`tCtrl+Shift+M"
    tray.ClickCount := 1
    A_IconTip := "Visual Macro Blocks V18 (click to show)"
}

; @summary Window title: file name, unsaved/auto-saved marker and step count.
; @tags macro, gui
VMB_UpdateTitle() {
    s := VMB()
    name := s.ConvertedFrom != "" ? "(converted - not saved yet)" : "Untitled"
    if s.Path != ""
        SplitPath(s.Path, &name)
    savedTag := s.Dirty ? " *" : (s.LastSavedAt != "" ? " (saved " . s.LastSavedAt . ")" : "")
    s.Gui.Title := "Visual Macro Blocks V22" . (s.Easy ? " Easy" : "") . " - " . name . savedTag . " - " . s.FlatIndex.Count . " steps"
    V7_SyncIdleHud()
}

; @summary Copies the macro's playback and data settings into the controls.
; @tags macro, gui
VMB_SettingsToControls() {
    s := VMB()
    m := s.Macro["settings"]
    s.Ctl["Speed"].Value := Max(1, VM__IndexOf(["auto", "max", "fast", "normal", "slow", "veryslow"], m.Get("speed", "auto")))
    s.Ctl["DefaultFind"].Value := m.Get("defaultFind", "spot") = "spot" ? 2 : 1
    s.Ctl["OnFail"].Value := Max(1, VM__IndexOf(["ask", "coords", "skip", "nextrow", "stop"], m.Get("onFail", "coords")))
    s.Ctl["PauseInput"].Value := m.Get("pauseOnUserInput", 1) ? 1 : 0
    s.Ctl["LockSize"].Value := m.Get("lockWindowSize", 1) ? 1 : 0
    s.Ctl["Steady"].Value := m.Get("steady", 0) ? 1 : 0
    s.Ctl["SizeStop"].Value := m.Get("sizeMismatch", "") = "stop" ? 1 : 0
    s.Ctl["DefaultTarget"].Value := m.Get("defaultTarget", "")
    dataSet := m.Get("data", "")
    hasData := dataSet is Map && dataSet.Get("path", "") != ""
    s.Ctl["DataPath"].Value := hasData ? dataSet["path"] : "(none - add one to use a 'For each data row' block)"
    s.Ctl["RowFrom"].Value := hasData && dataSet.Get("firstRow", "") != "" ? dataSet["firstRow"] : ""
    s.Ctl["RowTo"].Value := hasData && dataSet.Get("lastRow", "") != "" ? dataSet["lastRow"] : ""
    header := hasData ? dataSet.Get("header", "auto") : "auto"
    s.Ctl["Header"].Value := Max(1, VM__IndexOf(["auto", "yes", "no"], header))
    for name in ["RowFrom", "RowTo", "DataClear", "Header"]
        s.Ctl[name].Enabled := hasData
    info := ""
    if hasData {
        try {
            data := VMB_GetData(dataSet["path"], header)
            cols := ""
            for h in data.Headers
                cols .= (cols = "" ? "" : ", ") . h
            info := data.Rows.Length . " rows  |  columns: " . (StrLen(cols) > 90 ? SubStr(cols, 1, 87) . "..." : cols)
                . (data.DrugCol ? "  |  drug column: " . data.Headers[data.DrugCol] . " ({{search}} / {{drug}})" : "")
        } catch as err {
            info := "(cannot read: " . err.Message . ")"
        }
    }
    s.Ctl["DataInfo"].Value := info
}

; @summary Copies the controls into the macro's playback and data settings.
; @tags macro, gui
VMB_ControlsToSettings() {
    s := VMB()
    m := s.Macro["settings"]
    m["speed"] := ["auto", "max", "fast", "normal", "slow", "veryslow"][Max(1, s.Ctl["Speed"].Value)]
    m["defaultFind"] := s.Ctl["DefaultFind"].Value = 2 ? "spot" : "picture"
    m["onFail"] := ["ask", "coords", "skip", "nextrow", "stop"][Max(1, s.Ctl["OnFail"].Value)]
    m["pauseOnUserInput"] := s.Ctl["PauseInput"].Value ? 1 : 0
    m["lockWindowSize"] := s.Ctl["LockSize"].Value ? 1 : 0
    VM__SetOrDelete(m, "steady", s.Ctl["Steady"].Value ? 1 : "")
    VM__SetOrDelete(m, "sizeMismatch", s.Ctl["SizeStop"].Value ? "stop" : "")
    VM__SetOrDelete(m, "defaultTarget", Trim(s.Ctl["DefaultTarget"].Value))
    dataSet := m.Get("data", "")
    if dataSet is Map {
        from := Trim(s.Ctl["RowFrom"].Value), to := Trim(s.Ctl["RowTo"].Value)
        VM__SetOrDelete(dataSet, "firstRow", RegExMatch(from, "^\d+$") && Integer(from) > 1 ? Integer(from) : "")
        VM__SetOrDelete(dataSet, "lastRow", RegExMatch(to, "^\d+$") && Integer(to) > 0 ? Integer(to) : "")
    }
}

; @summary A setting control changed: store it in the macro and mark it unsaved (only when a value really changed -
;          Edit controls also report programmatic changes).
; @tags macro, gui
VMB_OnSettingChanged(*) {
    s := VMB()
    before := JSON.Stringify(s.Macro["settings"])
    VMB_ControlsToSettings()
    if JSON.Stringify(s.Macro["settings"]) == before
        return
    s.Dirty := true
    VMB_UpdateTitle()
    V17_UpdateWinInfo()
}

; @summary "Pick" next to Macro window: click any window to make it the default for steps with a blank Window selector.
; @tags macro, gui, window, v16
V16_PickDefaultTarget(*) {
    s := VMB()
    picked := ""
    hwnd := V17_ClickWindow("Click the window this macro should use (Esc = cancel)")
    try picked := hwnd ? "ahk_exe " . WinGetProcessName("ahk_id " . hwnd) : ""
    if picked = "" {
        VMB_Status("Window pick cancelled (or you clicked the editor).")
        return
    }
    s.Ctl["DefaultTarget"].Value := picked
    VMB_OnSettingChanged()
    VMB_Status("Macro window set to " . picked . ". Steps with a blank Window selector now use it.")
}

; @summary "New clicks find by" changed: saves it, then offers to switch the existing click/drag steps to match.
; @tags macro, gui, blocks
VMB_OnDefaultFindChanged(*) {
    s := VMB()
    VMB_OnSettingChanged()
    toSpot := s.Macro["settings"]["defaultFind"] = "spot"
    targets := []
    for step in VMF_Flatten(s.Macro["blocks"]) {
        if (step["type"] = "click" || step["type"] = "drag") && (step.Get("find", "") = "spot") != toSpot
            targets.Push(step)
    }
    if !targets.Length
        return
    how := toSpot ? "coordinates (recorded spot)" : "picture"
    if MsgBox("New clicks will find their target by " . how . ".`n`nAlso switch the " . targets.Length
        . " existing click/drag steps to " . how . "?`n(No = only new clicks; each step can still be changed with Edit.)",
        "New clicks find by", "YesNo Icon? Owner" . s.Gui.Hwnd) != "Yes"
        return
    VMB_Snapshot()
    for step in targets
        VM__SetOrDelete(step, "find", toSpot ? "spot" : "")
    s.Dirty := true
    VMB_Refresh()
    VMB_Status("Switched " . targets.Length . " click/drag steps to " . how . ".")
}

; @summary Sets new steps to the macro's "New clicks find by" choice (picture or recorded spot) and defaults
;          recorded windows to "program" (any window of that program) so changing document/tab titles never break playback.
; @tags macro, blocks, record
VMB_ApplyDefaultFind(steps) {
    spot := VMB().Macro["settings"].Get("defaultFind", "spot") = "spot"
    for step in steps {
        if spot && (step["type"] = "click" || step["type"] = "drag")
            step["find"] := "spot"
        if step.Get("win", "") is Map && !step.Has("winMatch")
            step["winMatch"] := "program"
    }
}

; @summary Disables editing controls while recording or playing (Stop and Pause stay enabled).
; @tags macro, gui
VMB_SetBusyUi(busy) {
    s := VMB()
    for name, ctl in s.Ctl {
        if name != "Stop" && name != "Pause" && name != "DataPath" && name != "DataInfo"
            ctl.Enabled := !busy
    }
    s.Ctl["Pause"].Enabled := VM_IsRecording()      ; it only pauses recording, so it is greyed out otherwise
    s.Pal.Enabled := !busy          ; the tree stays enabled so the running step can be seen
    if !busy
        VMB_SettingsToControls()
}

; @summary Sets the status bar text.
; @tags macro, gui
VMB_Status(text) {
    s := VMB()
    if s.SB
        s.SB.SetText(" " . StrReplace(text, "`n", " "))
}

; @summary Window close (top-right X): keeps Visual Macro Blocks alive in the background (system tray + HUD)
;          instead of quitting, and auto-saves your draft so you never lose your place.
; @tags macro, gui
VMB_OnClose(*) {
    s := VMB()
    if VM_IsPlaying() {
        VM_RequestStop()
        return true
    }
    V7_AutoSaveNow()
    if s.QuickLookGui
        try s.QuickLookGui.Hide()
    s.Gui.Hide()
    if IniRead(s.Ini, "V7", "ShowHud", 1)
        V7_EnsureIdleHud()
    if !s.CloseNotified {
        s.CloseNotified := true
        TrayTip("Still running in the background!`nPress Ctrl+Shift+M or click the tray icon to reopen. Use Tray -> Quit Completely to exit.",
            "Visual Macro Blocks V8", "Iconi")
    }
    return true
}

; @summary Exit (offers to save first, and saves session state).
; @tags macro, gui
VMB_ExitApp() {
    if VM_IsPlaying()
        VM_RequestStop()
    if VM_IsRecording()
        VMB_StopRecording()
    V7_AutoSaveNow()
    if !VMB_ConfirmDiscard()
        return
    ExitApp()
}

; @summary Ctrl+Shift+X: stop everything and exit immediately.
; @tags macro, hotkey, safety
VMB_PanicExit() {
    VM_RequestStop()
    try VM_RecordStop()
    ExitApp(2)
}

; @summary OnExit: removes hooks and releases any modifier keys left logically down.
; @tags macro, safety
VMB_OnExit(*) {
    try VM_RecordStop()
    VM_ReleaseStuckModifiers()
    try V4_Disconnect()
    cache := A_Temp . "\VisualMacroBlocks-V4-" . DllCall("GetCurrentProcessId")
    if DirExist(cache)
        try DirDelete(cache, true)
}


; ============================================================================
; V4 EMBEDDED RUNTIME
; Replaces the unavailable Lib\Macro, progress-panel and bundler dependencies.
; Unknown legacy VisualFind picture encodings fail validation; recapture them.
; No automatic downgrade from an unsupported image to a coordinate click.
; ============================================================================

class V4JsonAtom {
    __New(text) {
        this.Text := text
    }
}
class JSON {
    static True := V4JsonAtom("true")
    static False := V4JsonAtom("false")
    static Null := V4JsonAtom("null")

    static Stringify(value, indent := 0) {
        if value is V4JsonAtom
            return value.Text
        if value is Map {
            out := "{", sep := ""
            for key, item in value {
                out .= sep . this.Quote(String(key)) . ":" . this.Stringify(item)
                sep := ","
            }
            return out . "}"
        }
        if value is Array {
            out := "[", sep := ""
            for item in value {
                out .= sep . this.Stringify(item)
                sep := ","
            }
            return out . "]"
        }
        if Type(value) = "Integer" || Type(value) = "Float"
            return String(value)
        if IsObject(value)
            throw TypeError("Only Maps, Arrays and JSON atoms can be serialized.")
        return this.Quote(value)
    }
    static Quote(text) {
        out := '"'
        Loop Parse, String(text) {
            ch := A_LoopField
            switch ch {
                case '"': out .= '\"'
                case '\': out .= '\\'
                case "`n": out .= '\n'
                case "`r": out .= '\r'
                case "`t": out .= '\t'
                case Chr(8): out .= '\b'
                case Chr(12): out .= '\f'
                default: out .= Ord(ch) < 32 ? Format("\u{:04x}", Ord(ch)) : ch
            }
        }
        return out . '"'
    }
    static Parse(text) {
        pos := 1
        result := this.Read(text, &pos, 0)
        this.Space(text, &pos)
        if pos <= StrLen(text)
            throw ValueError("Unexpected JSON text at character " . pos)
        return result
    }
    static Space(text, &pos) {
        while pos <= StrLen(text) && InStr(" `t`r`n", SubStr(text, pos, 1))
            pos += 1
    }
    static Read(text, &pos, depth) {
        if depth > 128
            throw ValueError("JSON is nested too deeply.")
        this.Space(text, &pos)
        ch := SubStr(text, pos, 1)
        if ch = '"' {
            pos += 1
            out := ""
            while pos <= StrLen(text) {
                ch := SubStr(text, pos++, 1)
                if ch = '"'
                    return out
                if Ord(ch) < 32
                    throw ValueError("Unescaped control character in JSON.")
                if ch != "\" {
                    out .= ch
                    continue
                }
                esc := SubStr(text, pos++, 1)
                switch esc {
                    case '"', "\", "/": out .= esc
                    case "n": out .= "`n"
                    case "r": out .= "`r"
                    case "t": out .= "`t"
                    case "b": out .= Chr(8)
                    case "f": out .= Chr(12)
                    case "u":
                        hex := SubStr(text, pos, 4)
                        if !RegExMatch(hex, "i)^[0-9a-f]{4}$")
                            throw ValueError("Invalid JSON Unicode escape.")
                        unit := Integer("0x" . hex), pos += 4
                        if unit >= 0xD800 && unit <= 0xDBFF {
                            if SubStr(text, pos, 2) != "\u"
                                throw ValueError("Missing low surrogate in JSON.")
                            lowHex := SubStr(text, pos + 2, 4)
                            if !RegExMatch(lowHex, "i)^[0-9a-f]{4}$")
                                throw ValueError("Invalid low surrogate in JSON.")
                            low := Integer("0x" . lowHex)
                            if low < 0xDC00 || low > 0xDFFF
                                throw ValueError("Invalid low surrogate in JSON.")
                            unit := 0x10000 + (unit - 0xD800) * 1024 + low - 0xDC00
                            pos += 6
                        } else if unit >= 0xDC00 && unit <= 0xDFFF
                            throw ValueError("Unpaired low surrogate in JSON.")
                        if unit = 0
                            throw ValueError("Embedded NUL is not supported in AHK strings.")
                        out .= Chr(unit)
                    default: throw ValueError("Invalid JSON escape at character " . pos)
                }
            }
            throw ValueError("Unterminated JSON string.")
        }
        if ch = "{" || ch = "[" {
            isMap := ch = "{", endCh := isMap ? "}" : "]"
            out := isMap ? Map() : []
            if isMap
                out.CaseSense := true
            pos += 1
            this.Space(text, &pos)
            if SubStr(text, pos, 1) = endCh {
                pos += 1
                return out
            }
            loop {
                if isMap {
                    this.Space(text, &pos)
                    if SubStr(text, pos, 1) != '"'
                        throw ValueError("JSON object keys must be strings.")
                    key := this.Read(text, &pos, depth + 1)
                    this.Space(text, &pos)
                    if SubStr(text, pos++, 1) != ":"
                        throw ValueError("Expected a colon in JSON.")
                    if out.Has(key)
                        throw ValueError("Duplicate JSON key: " . key)
                    out[key] := this.Read(text, &pos, depth + 1)
                } else
                    out.Push(this.Read(text, &pos, depth + 1))
                this.Space(text, &pos)
                delim := SubStr(text, pos++, 1)
                if delim = endCh
                    return out
                if delim != ","
                    throw ValueError("Expected a comma in JSON at character " . pos)
            }
        }
        rest := SubStr(text, pos)
        for literal in ["true", "false", "null"] {
            if SubStr(rest, 1, StrLen(literal)) == literal {
                pos += StrLen(literal)
                return literal = "true" ? this.True : literal = "false" ? this.False : this.Null
            }
        }
        if RegExMatch(rest, "^-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?", &m) {
            pos += StrLen(m[0])
            return Number(m[0])
        }
        throw ValueError("Invalid JSON value at character " . pos)
    }
}

V4_Text(value) {
    if value is V4JsonAtom
        return value = JSON.Null ? "" : value.Text
    return IsObject(value) ? JSON.Stringify(value) : String(value)
}
V4_Bool(value) {
    if value is V4JsonAtom
        return value.Text = "true"
    return value != "" && value != 0 && StrLower(String(value)) != "false"
}
V4_Clone(value) => JSON.Parse(JSON.Stringify(value))
V4_Join(items, sep := ", ") {
    out := ""
    for i, item in items
        out .= (i = 1 ? "" : sep) . V4_Text(item)
    return out
}
V4_ReplaceMap(target, fresh) {
    target.Clear()
    for key, value in fresh
        target[key] := value
}
V4_Write(path, contents) {
    SplitPath(path, , &dir)
    if dir != "" && !DirExist(dir)
        DirCreate(dir)
    f := FileOpen(path, "w", "UTF-8")
    if !IsObject(f)
        throw OSError("Cannot write: " . path)
    try f.Write(contents)
    finally f.Close()
}
V4_Base64(binaryData) {
    chars := 0
    if !DllCall("Crypt32\CryptBinaryToStringW", "Ptr", binaryData, "UInt", binaryData.Size,
        "UInt", 0x40000001, "Ptr", 0, "UInt*", &chars)
        throw OSError()
    out := Buffer(chars * 2)
    if !DllCall("Crypt32\CryptBinaryToStringW", "Ptr", binaryData, "UInt", binaryData.Size,
        "UInt", 0x40000001, "Ptr", out, "UInt*", &chars)
        throw OSError()
    return StrGet(out)
}
V4_Unbase64(text) {
    size := 0
    if !DllCall("Crypt32\CryptStringToBinaryW", "Str", text, "UInt", 0, "UInt", 1,
        "Ptr", 0, "UInt*", &size, "Ptr", 0, "Ptr", 0)
        throw ValueError("Invalid base64 data.")
    if size > 64 * 1024 * 1024
        throw ValueError("Embedded data exceeds the 64 MB limit.")
    out := Buffer(size)
    if !DllCall("Crypt32\CryptStringToBinaryW", "Str", text, "UInt", 0, "UInt", 1,
        "Ptr", out, "UInt*", &size, "Ptr", 0, "Ptr", 0)
        throw OSError()
    return out
}
V4_Utf8(text) {
    buf := Buffer(StrPut(text, "UTF-8"))
    StrPut(text, buf, "UTF-8")
    return buf
}
VF_Clamp(n, lo, hi) => Min(hi, Max(lo, n))
VM__IndexOf(items, value) {
    for i, item in items
        if item = value
            return i
    return 0
}
VM__SetOrDelete(node, key, value) {
    if value = "" {
        if node.Has(key)
            node.Delete(key)
    } else
        node[key] := value
}
VM_Config() {
    static cfg := {LogPath: "", CheckTimeoutMs: 5000, KeyDelay: 30, PressDuration: 30, MouseDelay: 40}
    return cfg
}
V4_RunState() {
    static s := {Playing: false, Stop: false, Runner: 0}
    return s
}
VM_IsPlaying() => V4_RunState().Playing
VM_IsRecording() => VM_Rec().Active
VM_RequestStop() {
    V4_RunState().Stop := true
}
VM_ReleaseStuckModifiers() {
    for key in ["Ctrl", "Alt", "Shift", "LWin", "RWin", "LButton", "RButton", "MButton"]
        if GetKeyState(key) && !GetKeyState(key, "P")
            try SendEvent("{" . key . " up}")
}
VMF_NewMacro() {
    return Map("format", "VisualMacro", "version", 4, "name", "", "settings",
        Map("speed", "normal", "onFail", "ask", "pauseOnUserInput", 0, "nearMiss", 0,
            "defaultFind", "spot", "lockWindowSize", 1, "steady", 1, "restoreScroll", 1), "blocks", [])
}
VMF_FromSteps(macro) {
    out := VMF_NewMacro()
    out["settings"].Delete("steady")        ; V18: an old step list keeps playing the way it always did
    for key in ["name", "settings"]
        if macro.Has(key)
            out[key] := macro[key]
    out["blocks"] := macro.Get("steps", [])
    return out
}
VMF_IsContainer(node) => RegExMatch(node.Get("type", ""), "^(repeat|for|foreach|until|if)$") != 0
VMF_IsStep(node) {
    t := node.Get("type", "")
    return RegExMatch(t, "^(click|drag|wheel|text|keys|wait|check|delay|web_|input_|det_)") != 0
}
VMF_Elifs(node) {
    if !(node.Get("elifs", "") is Array)
        node["elifs"] := []
    return node["elifs"]
}
VMF_Children(node) {
    children := []
    if VMF_IsContainer(node) || node.Get("type", "") = "elif" {
        if !(node.Get("body", "") is Array)
            node["body"] := []
        children.Push(node["body"])
    }
    if node.Get("type", "") = "if" {
        for alt in VMF_Elifs(node) {
            if !(alt.Get("body", "") is Array)
                alt["body"] := []
            children.Push(alt["body"])
        }
        if !(node.Get("else", "") is Array)
            node["else"] := []
        children.Push(node["else"])
    }
    return children
}
VMF_Flatten(list) {
    out := []
    for node in list {
        if !(node is Map)
            continue
        out.Push(node)
        for child in VMF_Children(node)
            for item in VMF_Flatten(child)
                out.Push(item)
    }
    return out
}
VMF_CountSteps(list) => VMF_Flatten(list).Length
VMF_ValidVarName(name) {
    return RegExMatch(name, "i)^[a-z][a-z0-9_]*$")
        && !RegExMatch(name, "i)^(row|index|date|time|clipboard)$")
}
VMF_VarNames(list) {
    names := Map()
    for node in VMF_Flatten(list) {
        name := node.Get("name", node.Get("variable", ""))
        if name != ""
            names[name] := name
    }
    return names
}
VMF_DataFormats() {
    return Map("csv", ["CSV / TSV", "*.csv;*.tsv"], "text", ["Text list", "*.txt"],
        "excel", ["Excel (requires Excel)", "*.xlsx;*.xls"], "any", ["Supported data", "*.csv;*.tsv;*.txt;*.xlsx;*.xls"])
}
VMF_DataPickBlock(list) {
    for node in VMF_Flatten(list)
        if node.Get("type", "") = "pickdata" && !node.Get("disabled", 0)
            return node
    return 0
}
VMF_BlockName(t) {
    static labels := Map("repeat", "Repeat", "for", "For", "foreach", "For each data row",
        "until", "Repeat until", "if", "If", "set", "Set variable", "change", "Change variable", "ndc", "NDC from scan",
        "ask", "Checkpoint", "stop", "Flow control", "call", "Run macro", "pickdata", "Choose data",
        "click", "Click", "drag", "Drag", "wheel", "Wheel", "text", "Type text", "keys", "Press keys",
        "wait", "Wait for image", "check", "Check image", "delay", "Delay")
    if V10_DetDefs().Has(t)
        return V10_DetDefs()[t].Label
    if V4_InputDefs().Has(t)
        return V4_InputDefs()[t].Label
    if V4_WebDefs().Has(t)
        return V4_WebDefs()[t].Label
    return labels.Get(t, t)
}
VMF__CondText(node) {
    if node.Get("cond", "image") = "var"
        return node.Get("name", "?") . " " . node.Get("op", "=") . " " . node.Get("value", "")
    if node.Get("cond", "image") = "web"
        return "web element " . node.Get("selector", "?") . (node.Get("appear", 1) ? " exists" : " is absent")
    if node.Get("cond", "image") = "pixel"
        return "pixel (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") matches " . node.Get("colorMode", "hex")
            . (node.Get("colorHex", "") != "" ? " " . node["colorHex"] : "") . (node.Get("appear", 1) ? "" : " (NOT)")
    return "image " . (node.Get("appear", 1) ? "appears" : "is absent")
}
VMF_BlockText(node) {
    t := node["type"]
    switch t {
        case "repeat": label := "REPEAT " . node.Get("count", 1) . " times"
        case "for": label := "FOR " . node.Get("name", "i") . " = " . node.Get("from", 1) . " to " . node.Get("to", 10)
                . " step " . node.Get("step", 1)
        case "if": label := "IF " . VMF__CondText(node)
        case "until": label := (node.Get("check", "") = "after" ? "DO ... UNTIL " : "REPEAT UNTIL ")
                . VMF__CondText(node) . " (max " . node.Get("max", 100) . ")"
        case "set": label := "SET " . node.Get("name", "?") . " = " . (node.Get("ask", 0)
                ? "ASK ME (default " . node.Get("value", "") . ")" : node.Get("value", ""))
        case "change": label := "CHANGE " . node.Get("name", "?") . " BY " . node.Get("by", 1)
        case "ndc": label := "NDC " . node.Get("name", "?") . " = " . (node.Get("source", "") = "" ? "SCAN BARCODE"
                : "11-digit NDC of " . node["source"])
        case "ask": label := "ASK: " . node.Get("prompt", "")
        case "stop": label := "CONTROL: " . node.Get("action", "break")
        case "call": label := "RUN " . node.Get("path", "")
        default: label := VMF_BlockName(t)
    }
    return label . (node.Get("note", "") = "" ? "" : "  // " . node["note"])
}
VMF_ToText(list, indent := "") {
    out := ""
    for node in list {
        sum := VM_StepSummary(node)
        label := VMF_IsStep(node) ? sum[1] . " " . sum[3] : VMF_BlockText(node)
        out .= indent . (node.Get("disabled", 0) ? "[disabled] " : "") . label . "`r`n"
        if VMF_IsContainer(node) {
            out .= VMF_ToText(node["body"], indent . "    ")
            if node["type"] = "if" {
                for alt in VMF_Elifs(node)
                    out .= indent . "ELSE IF " . VMF__CondText(alt) . "`r`n" . VMF_ToText(alt["body"], indent . "    ")
                if node["else"].Length
                    out .= indent . "ELSE`r`n" . VMF_ToText(node["else"], indent . "    ")
            }
            out .= indent . "END`r`n"
        }
    }
    return out
}
VM_StepSummary(node) {
    t := node.Get("type", "?")
    info := ""
    switch t {
        case "text": info := node.Get("ask", 0) ? "(ask each run)" : SubStr(node.Get("text", ""), 1, 90)
        case "keys": info := node.Get("keys", "")
        case "delay": info := node.Get("ms", 0) . " ms"
        case "click", "drag": info := node.Get("find", "") = "spot" ? "coordinates" : "picture"
        default:
            if SubStr(t, 1, 4) = "det_"
                info := V10_DetStepInfo(node)
            if SubStr(t, 1, 6) = "input_"
                info := node.Get("ask", 0) ? "(ask each run)" : SubStr(node.Get("value", node.Get("key", node.Get("mode", ""))), 1, 90)
            if SubStr(t, 1, 4) = "web_"
                info := node.Get("selector", node.Get("url", node.Get("method", node.Get("match", ""))))
    }
    varyBadge := V8_VarySummaryBadge(node)
    if varyBadge != ""
        info .= (info != "" ? "   " : "") . varyBadge
    win := node.Get("win", "")
    return [VMF_BlockName(t), win is Map ? VM_WindowLabel(win) : "", StrReplace(info, "`n", " ")]
}
VM_WindowLabel(win) => win.Get("exe", "") . (win.Get("title", "") = "" ? "" : " | " . win["title"])
VM__Pattern(node) => node.Get("pattern", "")
VM__TargetText(node) => SubStr(String(node.Get("pattern", "")), 1, 12) . "..."
VM_Save(macro, path) {
    macro["version"] := 4
    V4_Write(path, JSON.Stringify(macro))
}
VM_Load(path) {
    macro := JSON.Parse(FileRead(path, "UTF-8"))
    if !(macro is Map) || (!macro.Has("blocks") && !macro.Has("steps"))
        throw ValueError("Not a supported VisualMacro JSON file.")
    if !(macro.Get("settings", "") is Map)
        macro["settings"] := VMF_NewMacro()["settings"]
    if !macro.Has("name")
        macro["name"] := ""
    if macro.Has("blocks") && !(macro["blocks"] is Array)
        throw ValueError("The blocks field must be an array.")
    return macro
}

VM_Validate(macro) {
    errors := []
    if !(macro is Map) || !(macro.Get("blocks", "") is Array) {
        errors.Push("The macro must contain a blocks array.")
        return errors
    }
    for i, node in VMF_Flatten(macro["blocks"]) {
        if node.Get("disabled", 0)
            continue
        t := node.Get("type", "")
        prefix := "#" . i . ": "
        if !RegExMatch(t, "^(click|drag|wheel|text|keys|wait|check|delay|repeat|for|foreach|until|if|set|change|ndc|ask|stop|call|pickdata)$")
            && !V4_WebDefs().Has(t) && !V4_InputDefs().Has(t) && !V10_DetDefs().Has(t) {
            errors.Push(prefix . "Unknown block type '" . t . "'.")
            continue
        }
        if t = "set" || t = "change" || t = "ndc" || t = "for" || node.Get("cond", "") = "var"
            if !VMF_ValidVarName(node.Get("name", ""))
                errors.Push(prefix . "Invalid variable name.")
        if node.Has("variable") && node["variable"] != "" && !VMF_ValidVarName(node["variable"])
            errors.Push(prefix . "Invalid result variable name.")
        if t = "repeat" && (!IsInteger(node.Get("count", "")) || node["count"] < 1)
            errors.Push(prefix . "Repeat count must be a positive integer.")
        if t = "for" && IsNumber(node.Get("step", 1)) && Number(node.Get("step", 1)) = 0
            errors.Push(prefix . "For step cannot be zero.")
        if (t = "until" || t = "if") && node.Get("cond", "image") = "web" {
            if Trim(node.Get("selector", "")) = ""
                errors.Push(prefix . "A web selector is required.")
        } else if (t = "until" || t = "if") && node.Get("cond", "image") = "pixel" {
            try V10_DetValidate(node)
            catch as err
                errors.Push(prefix . err.Message)
        } else if t = "wait" || t = "check" || ((t = "until" || t = "if") && node.Get("cond", "image") != "var")
            || ((t = "click" || t = "drag") && node.Get("find", "") != "spot") {
            if SubStr(node.Get("pattern", ""), 1, 6) != "V4BMP:"
                errors.Push(prefix . "Legacy/missing image: use New picture to recapture as a V4 embedded bitmap.")
        }
        if SubStr(t, 1, 4) = "det_" {
            try V10_DetValidate(node)
            catch as err
                errors.Push(prefix . err.Message)
        }
        if SubStr(t, 1, 4) = "web_" {
            try V4_WebValidate(node)
            catch as err
                errors.Push(prefix . err.Message)
        }
        if SubStr(t, 1, 6) = "input_" {
            try V4_InputValidate(node)
            catch as err
                errors.Push(prefix . err.Message)
        }
        if t = "call" && Trim(node.Get("path", "")) = ""
            errors.Push(prefix . "A macro path is required.")
    }
    return errors
}


; ============================================================================
; V4 DATA, FLOW, PLAYBACK AND DESKTOP SUPPORT
; ============================================================================

V4_ParseDelimited(text, sep := ",") {
    text := LTrim(text, Chr(0xFEFF))
    rows := [], row := [], field := "", quoted := false, i := 1
    while i <= StrLen(text) {
        ch := SubStr(text, i++, 1)
        if quoted {
            if ch = '"' {
                if SubStr(text, i, 1) = '"' {
                    field .= '"', i += 1
                } else
                    quoted := false
            } else
                field .= ch
        } else if ch = '"' && field = ""
            quoted := true
        else if ch = sep {
            row.Push(field), field := ""
        } else if ch = "`n" || ch = "`r" {
            if ch = "`r" && SubStr(text, i, 1) = "`n"
                i += 1
            row.Push(field), rows.Push(row), row := [], field := ""
        } else
            field .= ch
    }
    if quoted
        throw ValueError("The data file has an unterminated quoted field.")
    if field != "" || row.Length {
        row.Push(field), rows.Push(row)
    }
    return rows
}
VM_LoadData(path, header := "auto", *) {
    if !FileExist(path)
        throw Error("Data file not found: " . path)
    SplitPath(path, , , &ext)
    ext := StrLower(ext)
    rows := []
    if ext = "xlsx" || ext = "xls" {
        xl := ComObject("Excel.Application")
        xl.Visible := false
        xl.DisplayAlerts := false
        try {
            xl.AutomationSecurity := 3 ; do not run macros in workbooks opened as data
            book := xl.Workbooks.Open(path, 0, true)
            range := book.Worksheets(1).UsedRange
            nr := range.Rows.Count, nc := range.Columns.Count
            if nr > 100000 || nc > 512
                throw Error("The Excel data range is too large (100,000 rows / 512 columns maximum).")
            values := range.Value2
            Loop nr {
                r := A_Index, row := []
                Loop nc
                    row.Push(nr = 1 && nc = 1 ? V4_Text(values) : V4_Text(values[r, A_Index]))
                rows.Push(row)
            }
            book.Close(false)
        } finally {
            xl.Quit()
        }
    } else {
        raw := FileRead(path, "UTF-8")
        if ext = "txt" {
            for line in StrSplit(StrReplace(raw, "`r", ""), "`n")
                if Trim(line) != ""
                    rows.Push([line])
        } else
            rows := V4_ParseDelimited(raw, ext = "tsv" ? "`t" : ",")
    }
    if !rows.Length
        return {Headers: [], Rows: [], DrugCol: 0}
    width := 0
    for row in rows
        width := Max(width, row.Length)
    useHeader := header = "yes"
    if header = "auto" || header = "" {
        hits := 0
        for item in rows[1]
            if RegExMatch(Trim(item), "i)^(name|email|url|id|drug|drugs|search|firstname|lastname|address|city|phone|value|text|username|product|product description|expected|expected flex|flex|facility|facility code|location|pharmacy|pharmacy selection|floorstock|floorstock locations|item|itemname|item name|itemid|item id|medication|med|description|action|status|code|ndc|vuid|qty|quantity|dose|strength|route|form|notes|comments)$")
                hits += 1
        useHeader := hits > 0
    }
    headers := [], seen := Map()
    seen.CaseSense := false
    Loop width {
        name := useHeader && A_Index <= rows[1].Length ? Trim(rows[1][A_Index]) : "Column" . A_Index
        if name = ""
            name := "Column" . A_Index
        if seen.Has(name)
            throw Error("Duplicate data column: " . name)
        seen[name] := true
        headers.Push(name)
    }
    if useHeader
        rows.RemoveAt(1)
    records := []
    for row in rows {
        record := Map()
        record.CaseSense := false
        for j, name in headers
            record[name] := j <= row.Length ? row[j] : ""
        records.Push(record)
    }
    drugCol := 0
    for j, name in headers
        if StrLower(name) = "drug"
            drugCol := j
    return {Headers: headers, Rows: records, DrugCol: drugCol}
}
VM_PrivacyScan(steps) {
    if steps is Map
        steps := steps.Get("steps", [])
    results := []
    for i, node in steps {
        t := node.Get("type", "")
        value := t = "text" ? node.Get("text", "") : (t = "web_fill" || V4_InputDefs().Has(t)) ? node.Get("value", "") : ""
        if value != "" && !node.Get("ask", 0) && RegExMatch(value, "(\b\d{6,}\b|\b[\w.+-]+@[\w.-]+\.[a-zA-Z]{2,}\b|\b\d{1,2}[/-]\d{1,2}[/-]\d{2,4}\b)")
            results.Push({Index: i, Reason: "literal text contains an email, date or long number; review it"})
    }
    return results
}

; ============================================================================
; V5 STEP-BY-STEP DEBUGGER + RUN BAR
; The runner calls V5_DbgGate before every block. While paused it simply waits (no dialog box), so the step keys and
; the run bar's buttons decide what happens next. Nothing here takes the keyboard focus from the target window.
; ============================================================================

; @summary Debugger state for the current run. Mode: "run" (pause only at breakpoints / the run-to line), "step"
;          (pause before every block), "over" (pause at the next block at this depth or shallower), "out" (pause once
;          the current block list is finished). Script (an array of commands) replaces the keyboard in self-tests.
; @tags macro, playback, debug
V5_Dbg() {
    static d := {On: false, Mode: "run", Depth: 0, RunTo: 0, Waiting: false, Cmd: "", Bar: 0, Last: "",
        Arrows: true, BarX: "", BarY: "", Script: 0, Log: [], Editing: false}
    return d
}
V5_DbgArmed() => V4_RunState().Playing && V5_Dbg().On
V5_DbgWaiting() => V5_DbgArmed() && V5_Dbg().Waiting
; While the V6 element tree is open over a paused run, the step keys (and arrows / Esc) belong to that window.
V5_DbgKeys() => V5_DbgArmed() && !V5_Dbg().Editing
V5_DbgArrowKeys() => V5_DbgWaiting() && V5_Dbg().Arrows && !V5_Dbg().Editing

; @summary Arms the debugger for a run (opts.StartMode "run"|"step", opts.RunTo node, opts.Bar run bar).
; @tags macro, playback, debug
V5_DbgBegin(opts) {
    d := V5_Dbg()
    d.On := true, d.Waiting := false, d.Cmd := "", d.Depth := 0, d.Last := ""
    d.Mode := opts.HasOwnProp("StartMode") && opts.StartMode = "step" ? "step" : "run"
    d.RunTo := opts.HasOwnProp("RunTo") ? opts.RunTo : 0
    d.Bar := opts.HasOwnProp("Bar") ? opts.Bar : 0
}

; @summary Disarms the debugger after a run. Returns true when a run-to line was set but never reached.
; @tags macro, playback, debug
V5_DbgEnd() {
    d := V5_Dbg()
    missed := IsObject(d.RunTo)
    d.On := false, d.Waiting := false, d.Cmd := "", d.RunTo := 0, d.Bar := 0
    V5_Marker()
    V5_RestoreOverlays()
    return missed
}

; @summary A step key or run-bar button: "step", "over", "out", "skip", "run" or "pause". While paused it answers the
;          pause; while running, step/over/out/pause ask for a pause before the next block.
; @tags macro, playback, debug, hotkey
V5_DbgCommand(cmd) {
    d := V5_Dbg()
    if !V5_DbgArmed() || d.Editing
        return
    if d.Waiting {
        d.Cmd := cmd = "pause" ? "step" : cmd
        return
    }
    if cmd = "run" || cmd = "skip"
        return
    d.Mode := "step"
    if d.Bar
        d.Bar.Note("Pausing before the next step...")
}

; @summary Up / Left while paused: explains (in the bar, no pop-up) that finished steps cannot be undone.
; @tags macro, playback, debug, hotkey
V5_DbgNoGoingBack() {
    d := V5_Dbg()
    if d.Bar
        d.Bar.Note("There is no going back - steps that already ran cannot be undone.`n"
            . "Down = next step,  Right = skip it,  F5 = continue,  Esc = stop.", true)
}

; @summary Run bar checkbox: whether the arrow keys drive stepping while paused (remembered by the editor).
; @tags macro, playback, debug
V5_SetArrows(on) {
    V5_Dbg().Arrows := on ? true : false
    ini := VMB().Ini
    if ini != ""
        try IniWrite(on ? 1 : 0, ini, "Blocks", "StepArrows")
}

; @summary Called by the runner before every block. Pauses (and waits for a command) at a breakpoint, at the run-to
;          line, or because of the step mode; forced = a reason that always pauses (e.g. the user touched the mouse).
; @returns "" (run it, no pause), "paused" (run it, the user just stepped), "skip" or "stop"
; @tags macro, playback, debug
V5_DbgGate(runner, node, forced := "") {
    d := V5_Dbg()
    reason := forced
    if IsObject(d.RunTo) && d.RunTo = node {
        d.RunTo := 0
        if reason = ""
            reason := "You are at the line you chose (Run to here)."
    }
    if reason = "" {
        if node.Get("breakpoint", 0)
            reason := "Breakpoint (●) - paused here as you asked."
        else if d.Mode = "step" || (d.Mode = "over" && runner.Depth <= d.Depth) || (d.Mode = "out" && runner.Depth < d.Depth)
            reason := " "
    }
    if reason = ""
        return ""
    cmd := V5_DbgWait(runner, node, Trim(reason))
    if cmd = "stop"
        return "stop"
    if cmd = "skip" {
        d.Mode := "step"
        V5_DbgDone(runner, node, "skipped")
        return "skip"
    }
    V5_DbgApply(runner, cmd)
    return "paused"
}

; @summary Turns a resume command into the next pause rule.
; @tags macro, playback, debug
V5_DbgApply(runner, cmd) {
    d := V5_Dbg()
    switch cmd {
        case "over", "out": d.Mode := cmd, d.Depth := runner.Depth
        case "run": d.Mode := "run"
        default: d.Mode := "step"
    }
}

; @summary Shows the paused state (bar + target ring) and waits for a command without blocking hotkeys.
;          failMsg = the step failed (the bar turns red and offers try again / skip / stop).
; @tags macro, playback, debug
V5_DbgWait(runner, node, reason, failMsg := "") {
    d := V5_Dbg()
    if d.Script is Array {
        d.Log.Push(runner.Indices.Get(node, 0) . (failMsg != "" ? "!" : ""))
        return d.Script.Length ? d.Script.RemoveAt(1) : "stop"
    }
    if failMsg != ""
        try SoundPlay("*48")
    preview := failMsg = "" ? V5_DbgPreview(runner, node) : {Text: "", Ok: false}
    if d.Bar
        d.Bar.ShowPaused(runner, node, reason, failMsg, preview)
    d.Cmd := "", d.Waiting := true
    cmd := "stop"
    try {
        loop {
            if V4_RunState().Stop
                break
            if d.Cmd != "" {
                cmd := d.Cmd
                break
            }
            Sleep(30)
        }
        if cmd != "stop"
            V5_WaitKeysUp()         ; still "waiting", so held-key repeats stay caught instead of reaching the app
    } finally {
        d.Waiting := false, d.Cmd := ""
        V5_Marker()
        if d.Bar
            d.Bar.ShowRunning()
    }
    runner.LastCheck := A_TickCount + 1500      ; your own key press / click is not "touching the mouse"
    return cmd
}

; @summary Waits (up to 3 s) until the step keys and modifiers are released, so a held Shift never leaks into the
;          keys the next step types. One press = one step, even when a key is held down.
; @tags macro, playback, debug
V5_WaitKeysUp() {
    deadline := A_TickCount + 3000
    for key in ["Down", "Right", "Up", "Left", "F5", "F10", "F11", "Pause", "Shift", "Ctrl", "Alt", "LWin", "RWin"]
        while GetKeyState(key, "P") && A_TickCount < deadline
            Sleep(15)
}

; @summary Remembers the result of a block for the bar's "Last" line (how: "", "skipped").
; @tags macro, playback, debug
V5_DbgDone(runner, node, how := "", ms := 0) {
    if !runner.Dbg
        return
    V5_Dbg().Last := (how = "skipped" ? "Skipped:   " : "Done:   ") . V5_NodeTitle(runner, node)
        . (how = "" ? "     (" . Format("{:.1f}", ms / 1000) . " s)" : "")
}

; @summary Runner Notify hook: keeps the run bar's "Running step n" line current.
; @tags macro, playback, debug
V5_DbgNotify(runner, node) {
    d := V5_Dbg()
    if d.Bar && !d.Waiting
        d.Bar.SetStep(runner, node)
}

; @summary One-line description of a block, numbered like the tree ("#5   Click   picture   [exe | title]").
; @tags macro, playback, debug
V5_NodeTitle(runner, node) {
    idx := runner.Indices.Get(node, 0)
    if VMF_IsStep(node) {
        sum := VM_StepSummary(node)
        text := sum[1] . (sum[3] != "" ? "   " . sum[3] : "") . (sum[2] != "" ? "   [" . sum[2] . "]" : "")
    } else
        text := VMF_BlockText(node)
    return (idx ? "#" . idx . "   " : "") . text
}
V5_Short(value, maxLen := 60) {
    text := StrReplace(StrReplace(V4_Text(value), "`r"), "`n", " ")
    return StrLen(text) > maxLen ? SubStr(text, 1, maxLen - 3) . "..." : text
}
V5_VarsText(runner) {
    out := ""
    for name, value in runner.Vars
        out .= (out = "" ? "" : "      ") . name . " = " . V5_Short(value, 24)
    return out = "" ? "(no variables yet)" : out
}
V5_WhereText(runner) {
    text := "step " . runner.Index . " of " . runner.Flat.Length
    if runner.RowNumber
        text .= "   •   row " . runner.RowNumber . " of " . runner.Data.Rows.Length
    if runner.LoopIndex
        text .= "   •   round " . runner.LoopIndex
    return text
}

; @summary Before a paused block runs, says in plain words what it will do and checks it against the screen right
;          now (picture found? condition true? which value?), and rings the spot a click will hit. Never clicks/types.
; @returns {Text, Ok}  Ok = false when the step looks like it would fail
; @tags macro, playback, debug
V5_DbgPreview(runner, node) {
    t := node.Get("type", ""), text := "", ok := true, x := "", y := "", color := "34C759"
    inside := "`nDown goes inside it one step at a time;  Shift+Down runs the whole block."
    try {
        switch t {
            case "click", "drag":
                verb := t = "drag" ? "drag from" : "click"
                if node.Get("find", "") = "spot" {
                    point := V4_Spot(node, runner), x := point.X, y := point.Y, color := "FF9500"
                    text := "Will " . verb . " the spot (" . x . ", " . y . ")" . V8_VaryPreviewNote(node, runner) . " - see the orange ring."
                } else {
                    point := V4_FindImage(node, runner)
                    if point.Found
                        x := point.X, y := point.Y, text := "Picture found - will " . verb . " inside the green ring" . V8_VaryPreviewNote(node, runner) . "."
                    else
                        ok := false, text := "The picture is not on screen right now, so this step would fail."
                            . "  Get the screen ready, then press Down."
                }
            case "wait", "check":
                point := V4_FindImage(node)
                if point.Found
                    x := point.X, y := point.Y
                appear := node.Get("appear", 1)
                ready := appear ? point.Found : !point.Found
                text := (point.Found ? "The picture is on screen now - " : "The picture is not on screen now - ")
                    . (ready ? "this will pass right away." : "this will wait up to "
                    . Round(Number(node.Get("timeoutMs", 10000)) / 1000, 1) . " s for it to " . (appear ? "appear." : "go away."))
            case "if", "until":
                if node.Get("cond", "image") != "web" {
                    isTrue := runner.Condition(node)
                    text := "Right now the condition is " . (isTrue ? "TRUE" : "FALSE")
                        . (t = "if" ? (isTrue ? " - the IF part would run." : " - the IF part would be skipped.") : ".")
                }
                text .= inside
            case "repeat": text := "Repeats " . runner.Expand(node.Get("count", 1)) . " times." . inside
            case "for": text := "Counts " . node.Get("name", "i") . " from " . runner.Expand(node.Get("from", 1))
                . " to " . runner.Expand(node.Get("to", 10)) . "." . inside
            case "foreach": text := "Runs once for each data row (" . runner.Data.Rows.Length . " loaded)." . inside
            case "call": text := "Runs the macro " . runner.Expand(node.Get("path", "")) . "." . inside
            case "text": text := node.Get("ask", 0) ? "Will ask you what to type."
                : "Will type:   " . V5_Short(runner.Expand(node.Get("text", "")), 90)
            case "keys": text := "Will press:   " . V8_ResolveKeys(node, runner)
            case "delay": text := "Will wait " . runner.Expand(node.Get("ms", 0)) . " ms."
            case "set": text := node.Get("ask", 0) ? "Will ask you for " . node.Get("name", "?") . "."
                : "Will set   " . node.Get("name", "?") . " = " . V5_Short(runner.Expand(node.Get("value", "")))
            case "change":
                name := node.Get("name", "?"), now := runner.Vars.Get(name, 0)
                text := name . " will go from " . now . " to " . (Number(now) + Number(runner.Expand(node.Get("by", 1)))) . "."
            case "ndc": text := node.Get("source", "") = "" ? "Will ask you to scan an NDC into " . node.Get("name", "?") . "."
                : "Will turn " . V5_Short(runner.Expand(node["source"])) . " into an 11-digit NDC in " . node.Get("name", "?") . "."
            case "ask": text := "Will ask you:   " . V5_Short(runner.Expand(node.Get("prompt", "Continue?")), 90)
            case "stop": text := "Flow control: " . node.Get("action", "break") . "."
            case "pickdata": text := "Will ask you for the data file."
            default:
                if SubStr(t, 1, 4) = "det_" {
                    pt := V10_DetPreview(node, runner)
                    text := pt.Text, ok := pt.Ok
                    if pt.HasOwnProp("X") && pt.X != ""
                        x := pt.X, y := pt.Y, color := "0A84FF"
                }
        }
    } catch as err {
        ok := false, text := err.Message
    }
    V5_RestoreOverlays()
    if x != ""
        V5_Marker(x, y, color)
    return {Text: text, Ok: ok}
}

; @summary Shows a click-through ring (RRGGBB colour) centred on a screen point; no arguments hides it.
; @tags macro, playback, debug, gui
V5_Marker(x := "", y := "", color := "34C759") {
    static ring := 0, size := 44
    if x = "" {
        if ring
            ring.Hide()
        return
    }
    if !ring {
        ring := Gui("-Caption +AlwaysOnTop +ToolWindow -DPIScale +E0x20 +E0x08000000")   ; click-through, no focus
        outer := DllCall("CreateEllipticRgn", "Int", 0, "Int", 0, "Int", size + 1, "Int", size + 1, "Ptr")
        inner := DllCall("CreateEllipticRgn", "Int", 7, "Int", 7, "Int", size - 6, "Int", size - 6, "Ptr")
        DllCall("CombineRgn", "Ptr", outer, "Ptr", outer, "Ptr", inner, "Int", 4)        ; RGN_DIFF: a ring
        DllCall("DeleteObject", "Ptr", inner)
        DllCall("SetWindowRgn", "Ptr", ring.Hwnd, "Ptr", outer, "Int", 1)                ; the window owns it now
    }
    ring.BackColor := color
    ring.Show("NA x" . (Round(x) - size // 2) . " y" . (Round(y) - size // 2) . " w" . size . " h" . size)
    WinSetTransparent(235, "ahk_id " . ring.Hwnd)
}

; @summary Registry of on-screen helper windows (the run bar) that playback must never click on or photograph.
; @tags macro, playback, gui
V5_Overlays() {
    static o := {Windows: Map(), Hidden: []}
    return o
}

; @summary Hides the visible helper windows (only those covering x, y when given) until V5_RestoreOverlays.
; @returns the number hidden now
; @tags macro, playback, gui
V5_HideOverlays(x := "", y := "") {
    o := V5_Overlays(), count := 0
    for hwnd in o.Windows {
        if !DllCall("IsWindowVisible", "Ptr", hwnd, "Int")
            continue
        if x != "" {
            V5_WindowRect(hwnd, &wx, &wy, &ww, &wh)
            if x < wx || x >= wx + ww || y < wy || y >= wy + wh
                continue
        }
        DllCall("ShowWindow", "Ptr", hwnd, "Int", 0)
        o.Hidden.Push(hwnd), count += 1
    }
    return count
}
V5_RestoreOverlays() {
    o := V5_Overlays()
    for hwnd in o.Hidden
        if DllCall("IsWindow", "Ptr", hwnd, "Int")
            DllCall("ShowWindow", "Ptr", hwnd, "Int", 8)       ; SW_SHOWNA
    o.Hidden := []
}
V5_WindowRect(hwnd, &x := 0, &y := 0, &w := 0, &h := 0) {
    rect := Buffer(16, 0)
    DllCall("GetWindowRect", "Ptr", hwnd, "Ptr", rect)
    x := NumGet(rect, 0, "Int"), y := NumGet(rect, 4, "Int")
    w := NumGet(rect, 8, "Int") - x, h := NumGet(rect, 12, "Int") - y
}
V5_OnScreen(x, y, w) {
    Loop MonitorGetCount() {
        MonitorGetWorkArea(A_Index, &left, &top, &right, &bottom)
        if x >= left - 20 && x + Min(w, 120) <= right && y >= top && y + 40 <= bottom
            return true
    }
    return false
}

; @summary The run bar: one small always-on-top window in the bottom-right corner that NEVER takes the keyboard focus
;          (WS_EX_NOACTIVATE), so clicking its buttons leaves the target window active. Blue = running, amber =
;          paused (with what the next step will do), red = a step failed. Drag it by its title to move it (remembered).
; @tags macro, playback, debug, gui
class V5RunBar {
    __New(title, toggleEditor := 0) {
        d := V5_Dbg()
        this.ToggleEditor := toggleEditor, this.HeadBack := "", this.BShow := 0
        g := Gui("+AlwaysOnTop +ToolWindow -MinimizeBox +E0x08000000", title . "  -  run bar")
        g.MarginX := 12, g.MarginY := 10
        g.BackColor := "FFFFFF"
        g.SetFont("s10 bold", "Segoe UI")
        this.Head := g.AddText("xm ym w470 h28 +0x200 Background0A84FF cFFFFFF", "   Starting...")
        g.SetFont("s9 norm", "Segoe UI")
        g.AddText("xm y+10 w52 c808080", "Next")
        this.Next := g.AddText("x+4 yp w414 +0x4000", "")             ; SS_ENDELLIPSIS
        g.AddText("xm y+6 w52 c808080", "Note")
        this.Info := g.AddText("x+4 yp w414 h46", "")
        g.AddText("xm y+4 w52 c808080", "Last")
        this.Last := g.AddText("x+4 yp w414 +0x4000", "")
        g.AddText("xm y+6 w52 c808080", "Values")
        this.Vars := g.AddText("x+4 yp w414 +0x4000", "")
        this.BNext := g.AddButton("xm y+12 w104 h32", "↓    Next step")
        this.BOver := g.AddButton("x+4 w104 h32", "Shift+↓   Over")
        this.BSkip := g.AddButton("x+4 w76 h32", "→    Skip")
        this.BRun := g.AddButton("x+4 w100 h32", "»    Continue")
        this.BStop := g.AddButton("x+4 w70 h32", "■    Stop")
        this.Keys := g.AddCheckbox("xm y+10 h24", "Use the arrow keys while paused")
        this.Keys.Value := d.Arrows
        if toggleEditor {
            this.BShow := g.AddButton("x+16 yp w130 h24", "Show my macro")
            this.BShow.OnEvent("Click", (*) => this.OnShow())
        }
        this.Node := 0, this.Runner := 0
        this.BPic := g.AddButton("xm y+8 w148 h26", "📷 Re-capture target...")
        this.BEdit := g.AddButton("x+4 yp w118 h26", "✎ Edit step...")
        this.BTree := g.AddButton("x+4 yp w196 h26", "🌐 Web element tree...")
        this.BPic.OnEvent("Click", (*) => V7_FixDesktopTargetFromBar(this))
        this.BEdit.OnEvent("Click", (*) => V7_EditStepFromBar(this))
        this.BTree.OnEvent("Click", (*) => V6_FixTargetFromBar(this))
        g.SetFont("s8", "Segoe UI")
        g.AddText("xm y+6 w470 c808080", "F10 next  •  Shift+F10 over  •  Shift+F11 finish block  •  F5 continue  •  Esc stop")
        this.BNext.OnEvent("Click", (*) => V5_DbgCommand(V5_Dbg().Waiting ? "step" : "pause"))
        this.BOver.OnEvent("Click", (*) => V5_DbgCommand("over"))
        this.BSkip.OnEvent("Click", (*) => V5_DbgCommand("skip"))
        this.BRun.OnEvent("Click", (*) => V5_DbgCommand("run"))
        this.BStop.OnEvent("Click", (*) => VM_RequestStop())
        this.Keys.OnEvent("Click", (ctl, *) => V5_SetArrows(ctl.Value))
        g.OnEvent("Close", (*) => (VM_RequestStop(), true))
        this.G := g
        V5_Overlays().Windows[g.Hwnd] := 1
        this.ShowRunning()
        g.Show("Hide AutoSize")
        V5_WindowRect(g.Hwnd, , , &w, &h)
        x := d.BarX, y := d.BarY
        if x = "" || y = "" || !V5_OnScreen(x, y, w) {
            MonitorGetWorkArea(MonitorGetPrimary(), , , &right, &bottom)
            x := right - w - 16, y := bottom - h - 16
        }
        g.Show("NA x" . x . " y" . y)
    }
    SetHead(text, back, fore) {
        if back != this.HeadBack {
            this.Head.Opt("+Background" . back)
            this.Head.SetFont("c" . fore)
            this.HeadBack := back
        }
        this.Head.Text := text
    }
    SetEditorVisible(visible) {
        if this.BShow
            this.BShow.Text := visible ? "Hide my macro" : "Show my macro"
    }
    OnShow() {
        if this.ToggleEditor
            this.SetEditorVisible(this.ToggleEditor.Call())
    }
    Note(text, warn := false) {
        this.Info.SetFont(warn ? "cD70015" : "c000000")
        this.Info.Text := text
    }
    ShowRunning() {
        this.SetHead("   »   Running", "0A84FF", "FFFFFF")
        this.Note("F10 pauses before the next step.     Esc stops.")
        this.BNext.Text := "||    Pause"
        this.BRun.Text := "»    Continue"
        this.BNext.Enabled := true
        this.BOver.Enabled := false, this.BSkip.Enabled := false, this.BRun.Enabled := false
        this.BPic.Enabled := false, this.BEdit.Enabled := false, this.BTree.Enabled := false
    }
    SetStep(runner, node) {
        this.SetHead("   »   Running   •   " . V5_WhereText(runner), "0A84FF", "FFFFFF")
        this.Next.Text := V5_NodeTitle(runner, node)
        this.Last.Text := V5_Dbg().Last
        this.Vars.Text := V5_VarsText(runner)
    }
    ShowPaused(runner, node, reason, failMsg, preview) {
        failed := failMsg != ""
        if failed
            this.SetHead("   ■   This step did not work   •   " . V5_WhereText(runner), "D70015", "FFFFFF")
        else
            this.SetHead("   ||   Paused   •   next is " . V5_WhereText(runner), "FF9F0A", "000000")
        this.Next.Text := V5_NodeTitle(runner, node)
        if failed
            note := failMsg . "`nFix the problem (or Re-capture / Edit below), then:  Down = try again,  Right = skip,  F5 = continue."
        else {
            note := Trim(reason . "  " . preview.Text)
            if note = ""
                note := "Ready.  Down (or F10) runs this step;  F5 runs on from here."
        }
        this.Note(note, failed || !preview.Ok)
        this.Last.Text := V5_Dbg().Last
        this.Vars.Text := V5_VarsText(runner)
        this.BNext.Text := failed ? "↓    Try again" : "↓    Next step"
        this.BRun.Text := failed ? "»    Retry, go on" : "»    Continue"
        for ctl in [this.BNext, this.BOver, this.BSkip, this.BRun]
            ctl.Enabled := true
        this.Node := node, this.Runner := runner
        t := node is Map ? node.Get("type", "") : ""
        this.BPic.Enabled := node is Map && RegExMatch(t, "^(click|drag|wait|check|if|until)$") && node.Get("cond", "image") != "web" && node.Get("cond", "image") != "var"
        this.BEdit.Enabled := node is Map
        this.BTree.Enabled := node is Map && node.Has("selector")
        DllCall("ShowWindow", "Ptr", this.G.Hwnd, "Int", 8)       ; SW_SHOWNA (it may have been hidden for a click)
    }
    Close() {
        d := V5_Dbg()
        if DllCall("IsWindow", "Ptr", this.G.Hwnd, "Int") {
            V5_WindowRect(this.G.Hwnd, &x, &y)
            d.BarX := x, d.BarY := y
            V5_Overlays().Windows.Delete(this.G.Hwnd)
            this.G.Destroy()
        }
        this.ToggleEditor := 0, this.Node := 0, this.Runner := 0
    }
}

VM_Play(macro, opts := 0) {
    state := V4_RunState()
    if state.Playing
        throw Error("A macro is already playing.")
    errs := VM_Validate(macro)
    if errs.Length
        throw Error(V4_Join(errs, "`n"))
    state.Stop := false, state.Playing := true
    runner := V4Runner(macro, IsObject(opts) ? opts : {})
    state.Runner := runner
    if runner.Dbg
        V5_DbgBegin(runner.Opts)
    SendMode("Event")
    SetKeyDelay(VM_Config().KeyDelay, VM_Config().PressDuration)
    SetMouseDelay(VM_Config().MouseDelay)
    CoordMode("Mouse", "Screen")
    CoordMode("Pixel", "Screen")
    result := {Ok: true, Index: 0, Message: "Finished.", Changed: false, Failed: 0, Skipped: 0, RunToMissed: false, Warnings: []}
    V17_Log("Playback started: " . macro.Get("name", "Untitled"), true)
    V18_ScreenCheck(runner)
    try {
        signal := runner.Run(macro["blocks"])
        result.Ok := signal != "stop"
        result.Message := signal = "stop" ? "Stopped." : signal = "endrun" ? "Ended by macro." : "Finished."
    } catch as err {
        result.Ok := false
        result.Message := "Step #" . runner.Index . ": " . err.Message
        result.Failed := 1
    } finally {
        result.Index := runner.Index
        result.Skipped := runner.Skipped
        result.Changed := runner.Changed
        result.Warnings := runner.Warnings
        V17_Log("Playback ended: " . result.Message . "  (" . runner.Warnings.Length . " note(s), " . runner.Skipped . " skipped)")
        if runner.Dbg
            result.RunToMissed := V5_DbgEnd() && result.Ok
        state.Playing := false, state.Runner := 0
        for key in runner.HeldKeys
            if !GetKeyState(key, "P")
                try SendEvent("{" . key . " up}")
        VM_ReleaseStuckModifiers()
    }
    return result
}

class V4Runner {
    __New(macro, opts) {
        this.Macro := macro
        this.Settings := macro.Get("settings", Map())
        this.Opts := opts
        this.Vars := Map(), this.Vars.CaseSense := false
        this.Row := Map(), this.Row.CaseSense := false
        this.RowNumber := 0, this.LoopIndex := 0, this.Index := 0, this.Skipped := 0
        this.HeldKeys := Map()
        this.Depth := 0, this.Iterations := 0, this.LastCheck := A_TickCount + 800
        this.Data := opts.HasOwnProp("Data") ? opts.Data : {Headers: [], Rows: [], DrugCol: 0}
        this.Flat := VMF_Flatten(macro["blocks"]), this.Indices := Map()
        for i, node in this.Flat
            this.Indices[node] := i
        this.CallStack := []
        this.Asked := Map()
        this.Dbg := opts.HasOwnProp("Debug") && opts.Debug      ; step debugger + breakpoints (editor runs only)
        this.Paused := false                                    ; true while running a block the user just stepped to
        this.Changed := false                                   ; a block was corrected while paused (V6 element tree)
        this.UseTarget := ""                                    ; set by "Use Window From Here On"
        this.Warnings := []                                     ; V17: notes that did not stop the run (window size)
    }
    Expand(value) {
        if IsObject(value)
            return value
        value := String(value), start := 1, out := ""
        while pos := RegExMatch(value, "\{\{([^{}]+)\}\}", &m, start) {
            out .= SubStr(value, start, pos - start) . V4_Text(this.Lookup(Trim(m[1])))
            start := pos + StrLen(m[0])
        }
        return out . SubStr(value, start)
    }
    Lookup(name) {
        switch StrLower(name) {
            case "row": return this.RowNumber
            case "index": return this.LoopIndex
            case "date": return FormatTime(, "yyyy-MM-dd")
            case "time": return FormatTime(, "HH:mm:ss")
            case "clipboard": return A_Clipboard
        }
        if SubStr(name, 1, 5) = "date:"
            return FormatTime(, SubStr(name, 6))
        if SubStr(name, 1, 6) = "search" && this.Data.DrugCol {
            drug := this.Row.Get(this.Data.Headers[this.Data.DrugCol], "")
            if name = "search"
                return drug
            throw Error("Legacy {{search::...}} transformations are not implemented in V4. Use a data column instead.")
        }
        if this.Vars.Has(name)
            return this.Vars[name]
        if StrLower(name) = "productsearch" {
            rawProd := ""
            for alt in ["Product", "Product Description", "Drug", "Medication", "ItemName", "Item Name", "Description", "Column1"]
                if this.Row.Has(alt) {
                    rawProd := this.Row[alt]
                    break
                }
            return RegExReplace(Trim(rawProd), "i)^OFF\s*-\s*", "")
        }
        if this.Row.Has(name)
            return this.Row[name]
        if RegExMatch(name, "i)^(product|drug|medication|itemname)$") {
            for alt in ["Product", "Product Description", "Drug", "Medication", "ItemName", "Item Name", "Description", "Column1"]
                if this.Row.Has(alt)
                    return this.Row[alt]
        }
        if RegExMatch(name, "i)^(expected|flex|action|status)$") {
            for alt in ["Expected", "Expected Flex", "Flex", "Action", "Status", "Column2"]
                if this.Row.Has(alt)
                    return this.Row[alt]
            return "On"
        }
        throw Error("No value for {{" . name . "}}. Check the variable and data column names.")
    }
    ExpandTree(value) {
        if value is Map {
            out := Map()
            for key, item in value
                out[key] := this.ExpandTree(item)
            return out
        }
        if value is Array {
            out := []
            for item in value
                out.Push(this.ExpandTree(item))
            return out
        }
        if Type(value) = "String"
            return this.Expand(value)
        return value
    }
    Sleep(ms) {
        stopAt := A_TickCount + Max(0, Number(ms))
        while A_TickCount < stopAt {
            if V4_RunState().Stop
                throw Error("Stopped by user.")
            Sleep(Min(40, stopAt - A_TickCount))
        }
    }
    Notify(node) {
        this.Index := this.Indices.Get(node, this.Index)
        if this.Opts.HasOwnProp("OnStatus")
            this.Opts.OnStatus.Call(this.Index, this.Flat.Length, this.LoopIndex, VMF_BlockName(node["type"]),
                this.RowNumber, this.Data.Rows.Length)
        if this.Dbg
            V5_DbgNotify(this, node)
    }
    Run(list) {
        this.Depth += 1
        if this.Depth > 64 {
            this.Depth -= 1
            throw Error("Maximum nested block/macro depth reached.")
        }
        try {
            for node in list {
                if V4_RunState().Stop
                    return "stop"
                if node.Get("disabled", 0)
                    continue
                this.Iterations += 1
                if this.Iterations > 1000000
                    throw Error("Safety limit: more than 1,000,000 block executions.")
                this.Notify(node)
                touched := A_TickCount > this.LastCheck && this.Settings.Get("pauseOnUserInput", 0)
                    && A_TimeIdlePhysical < A_TickCount - this.LastCheck
                this.Paused := false
                if this.Dbg {
                    gate := V5_DbgGate(this, node, touched ? "You used the mouse or keyboard, so the macro paused." : "")
                    if gate = "stop"
                        return "stop"
                    if gate = "skip"
                        continue
                    this.Paused := gate = "paused"
                } else if touched {
                    if MsgBox("Physical mouse/keyboard input detected. Continue the macro?",
                        "Visual Macro Blocks - paused", "YesNo Icon? 4096") != "Yes"
                        return "stop"
                }
                this.LastCheck := Max(this.LastCheck, A_TickCount)
                started := A_TickCount
                try {
                    signal := this.Node(node)
                    V5_DbgDone(this, node, "", A_TickCount - started)
                } catch as err {
                    if V4_RunState().Stop
                        return "stop"
                    signal := this.OnFailure(node, err)
                } finally V5_RestoreOverlays()
                this.LastCheck := Max(this.LastCheck, A_TickCount)
                if signal != ""
                    return signal
            }
            return ""
        } finally {
            this.Depth -= 1
        }
    }
    OnFailure(node, err) {
        policy := this.Settings.Get("onFail", "ask")
        if policy = "coords" && RegExMatch(node["type"], "^(click|drag)$") && node.Get("find", "") != "spot" {
            copy := node.Clone(), copy["find"] := "spot"
            V4_DesktopStep(copy, this)
            return ""
        }
        if this.Dbg && (policy = "ask" || V5_Dbg().Mode != "run")
            return this.DbgFailure(node, err)
        if policy = "skip" {
            this.Skipped += 1
            return ""
        }
        if policy = "nextrow"
            return "nextrow"
        if policy = "ask" {
            answer := MsgBox("Step #" . this.Index . " - " . VMF_BlockName(node["type"]) . "`n`n" . err.Message
                . "`n`nYes = retry this step (an earlier action may already have happened)."
                . "`nNo = skip this step. Cancel = stop.", "Visual Macro Blocks - step failed", "YesNoCancel Icon! 4096")
            if answer = "Yes"
                return this.Node(node) ; only explicit user retry; no automatic replay of clicks or typing
            if answer = "No" {
                this.Skipped += 1
                return ""
            }
            return "stop"
        }
        throw err
    }
    ; Step-debugger failure: the run bar turns red (no dialog box) and waits. Down / Shift+Down / F5 = try the step
    ; again (then pause / then run on), Right = skip it, Esc = stop. Retries happen only when the user asks.
    DbgFailure(node, err) {
        loop {
            cmd := V5_DbgWait(this, node, "", err.Message)
            if cmd = "stop"
                return "stop"
            if cmd = "skip" {
                this.Skipped += 1
                V5_DbgDone(this, node, "skipped")
                return ""
            }
            V5_DbgApply(this, cmd)
            this.Paused := true
            started := A_TickCount
            try {
                signal := this.Node(node)
                V5_DbgDone(this, node, "", A_TickCount - started)
                return signal
            } catch as again {
                if V4_RunState().Stop
                    return "stop"
                err := again
            } finally V5_RestoreOverlays()
        }
    }
    Condition(node) {
        cond := node.Get("cond", "image")
        if cond = "web" {
            count := V4_WebElement("count", node, this)
            return node.Get("appear", 1) ? count > 0 : count = 0
        }
        if cond = "pixel" {
            matched := V10_CheckPixelSentinel(node, this)
            return node.Get("appear", 1) ? matched : !matched
        }
        if cond != "var" {
            found := V4_FindImage(node).Found
            return node.Get("appear", 1) ? found : !found
        }
        left := this.Lookup(node.Get("name", ""))
        right := this.Expand(node.Get("value", ""))
        op := node.Get("op", "=")
        if IsNumber(left) && IsNumber(right)
            left := Number(left), right := Number(right)
        switch op {
            case "=": return left = right
            case "!=": return left != right
            case "<": return left < right
            case ">": return left > right
            case "<=": return left <= right
            case ">=": return left >= right
            case "contains": return InStr(V4_Text(left), V4_Text(right)) > 0
            case "empty": return V4_Text(left) = ""
            case "notempty": return V4_Text(left) != ""
            default: throw Error("Unsupported comparison: " . op)
        }
    }
    Node(node) {
        t := node["type"], signal := ""
        if t = "pickdata" {
            if !this.Data.Rows.Length {
                fmt := VMF_DataFormats().Get(node.Get("format", "csv"), VMF_DataFormats()["csv"])
                path := FileSelect(3, , node.Get("prompt", "Choose data for this run"), fmt[1] . " (" . fmt[2] . ")")
                this.LastCheck := A_TickCount + 1200
                if path = ""
                    return "stop"
                this.Data := VM_LoadData(path, node.Get("header", "auto"))
            }
            for column in StrSplit(node.Get("columns", ""), ",", " `t")
                if column != "" && !VM__IndexOf(this.Data.Headers, column)
                    throw Error("Required data column missing: " . column)
            return ""
        }
        switch t {
            case "repeat":
                previous := this.LoopIndex
                try {
                    Loop Integer(this.Expand(node.Get("count", 1))) {
                        this.LoopIndex := A_Index
                        signal := this.Run(node["body"])
                        if signal = "continue"
                            continue
                        if signal = "break"
                            break
                        if signal != ""
                            return signal
                    }
                } finally this.LoopIndex := previous
            case "for":
                n := Number(this.Expand(node.Get("from", 1)))
                endN := Number(this.Expand(node.Get("to", 10)))
                step := Number(this.Expand(node.Get("step", 1)))
                if step = 0
                    throw Error("For step cannot be zero.")
                while step > 0 ? n <= endN : n >= endN {
                    this.Vars[node["name"]] := n
                    signal := this.Run(node["body"])
                    if signal = "continue"
                        signal := ""
                    if signal = "break"
                        break
                    if signal != ""
                        return signal
                    n += step
                }
            case "until":
                finished := false
                Loop Integer(node.Get("max", 100)) {
                    if node.Get("check", "") != "after" && this.Condition(node) {
                        finished := true
                        break
                    }
                    signal := this.Run(node["body"])
                    if signal = "continue"
                        signal := ""
                    if signal = "break" {
                        finished := true
                        break
                    }
                    if signal != ""
                        return signal
                    if this.Condition(node) {
                        finished := true
                        break
                    }
                    this.Sleep(50)
                }
                if !finished
                    throw Error("Repeat-until reached its maximum iterations without meeting the condition.")
            case "foreach":
                if !this.Data.Rows.Length
                    throw Error("No data rows loaded.")
                oldRow := this.Row, oldNumber := this.RowNumber
                first := this.Opts.HasOwnProp("FirstRow") ? this.Opts.FirstRow : 1
                last := this.Opts.HasOwnProp("LastRow") && this.Opts.LastRow > 0
                    ? Min(this.Data.Rows.Length, this.Opts.LastRow) : this.Data.Rows.Length
                try {
                    for i, record in this.Data.Rows {
                        if i < first || i > last
                            continue
                        this.Row := record, this.RowNumber := i
                        signal := this.Run(node["body"])
                        if signal = "continue"
                            continue
                        if signal = "break"
                            break
                        if signal = "nextrow" {
                            this.Skipped += 1
                            continue
                        }
                        if signal != ""
                            return signal
                    }
                } finally {
                    this.Row := oldRow, this.RowNumber := oldNumber
                }
            case "if":
                branch := node["else"]
                if this.Condition(node)
                    branch := node["body"]
                else
                    for alt in VMF_Elifs(node)
                        if this.Condition(alt) {
                            branch := alt["body"]
                            break
                        }
                return this.Run(branch)
            case "set":
                value := this.Expand(node.Get("value", ""))
                if node.Get("ask", 0) {
                    question := node.Get("prompt", "") != "" ? this.Expand(node["prompt"]) : "Value for " . node["name"] . ":"
                    reply := InputBox(question, "Macro input", "w360 h130", value)
                    this.LastCheck := A_TickCount + 1200
                    if reply.Result != "OK"
                        return "stop"
                    value := Trim(reply.Value)
                }
                this.Vars[node["name"]] := value
            case "change": this.Vars[node["name"]] := Number(this.Vars.Get(node["name"], 0)) + Number(this.Expand(node.Get("by", 1)))
            case "ndc":
                raw := this.Expand(node.Get("source", ""))
                if Trim(raw) = "" {
                    question := node.Get("prompt", "") != "" ? this.Expand(node["prompt"])
                        : "Scan the NDC barcode now (or type the NDC):"
                    reply := InputBox(question, "Scan NDC", "w380 h130")
                    this.LastCheck := A_TickCount + 1200
                    if reply.Result != "OK"
                        return "stop"
                    raw := reply.Value
                }
                ndc := NDC_FromScan(raw)
                this.LastCheck := A_TickCount + 1200
                if ndc = ""
                    return "stop"
                this.Vars[node["name"]] := ndc
            case "stop": return node.Get("action", "break")
            case "ask":
                answer := MsgBox(this.Expand(node.Get("prompt", "Continue?"))
                    . "`n`nYes = continue. No = skip data row. Cancel = stop.", "Checkpoint", "YesNoCancel Icon? 4096")
                this.LastCheck := A_TickCount + 1200
                return answer = "Yes" ? "" : answer = "No" ? "nextrow" : "stop"
            case "call":
                path := this.Expand(node.Get("path", ""))
                if VM__IndexOf(this.CallStack, path)
                    throw Error("Recursive macro call blocked.")
                child := VM_Load(path)
                if !child.Has("blocks")
                    child := VMF_FromSteps(child)
                errs := VM_Validate(child)
                if errs.Length
                    throw Error(V4_Join(errs, "`n"))
                this.CallStack.Push(path)
                try return this.Run(child["blocks"])
                finally this.CallStack.Pop()
            default:
                this.DelayBefore(node)
                if SubStr(t, 1, 4) = "web_"
                    V4_WebExecute(node, this)
                else if SubStr(t, 1, 6) = "input_"
                    V4_InputExecute(node, this)
                else if SubStr(t, 1, 4) = "det_"
                    V10_DetExecute(node, this)
                else
                    V4_DesktopStep(node, this)
        }
        return ""
    }
    DelayBefore(node) {
        if this.Paused {            ; you stepped here yourself, so the recorded pause is not needed
            if this.Settings.Get("speed", "normal") = "auto" && SubStr(node["type"], 1, 4) != "web_"
                V4_ScreenSettle(this)
            return
        }
        if node.Has("delayMs") {
            this.Sleep(Max(0, node["delayMs"]))
            return
        }
        speed := this.Settings.Get("speed", "normal")
        gap := node.Get("gapMs", 0)
        switch speed {
            case "max": gap := 0
            case "fast": gap *= 0.25
            case "slow": gap := Max(750, gap * 2)
            case "veryslow": gap := Max(2000, gap * 3)
            case "auto":
                ; Sampled settling only, not a guarantee of application readiness.
                if SubStr(node["type"], 1, 4) != "web_"
                    V4_ScreenSettle(this)
                gap := 0
        }
        this.Sleep(Max(0, gap))
    }
    Value(node, key := "value") {
        if !node.Get("ask", 0)
            return this.Expand(node.Get(key, ""))
        ; Do not cache secrets in saved blocks; answer lives only for this action.
        answer := InputBox(node.Get("prompt", "Enter text for this step:"), "Visual Macro Blocks - type this", "Password w430 h150")
        if answer.Result != "OK"
            throw Error("Text entry cancelled.")
        return answer.Value
    }
}

V4_ScreenSettle(runner) {
    ; Watch the active window wherever it is; the primary screen is only the fallback.
    left := 0, top := 0, w := A_ScreenWidth, h := A_ScreenHeight
    try {
        WinGetPos(&wx, &wy, &ww, &wh, "A")
        if ww >= 40 && wh >= 40
            left := wx, top := wy, w := ww, h := wh
    }
    previous := "", stable := 0, start := A_TickCount
    while A_TickCount - start < 3000 {
        sample := ""
        Loop 12 {
            x := left + Round(w * (Mod(A_Index - 1, 4) + 1) / 5)
            y := top + Round(h * (Floor((A_Index - 1) / 4) + 1) / 4)
            try sample .= PixelGetColor(x, y) . ","
        }
        stable := sample = previous ? stable + 1 : 0
        if stable >= 2
            return
        previous := sample
        runner.Sleep(100)
    }
}
V4_Window(node, runner := 0) {
    if V18_Steady(runner)           ; V18: wait for the step's window instead of falling back to the active one
        return V18_Window(node, runner)
    if node.Get("winMatch", "") = "active"
        return WinExist("A")
    win := node.Get("win", "")
    if !(win is Map) || win.Get("exe", "") = ""
        return WinExist("A")
    selector := "ahk_exe " . win["exe"]
    matches := WinGetList(selector)
    if win.Get("cls", "") != "" {
        clsMatches := WinGetList(selector . " ahk_class " . win["cls"])
        if clsMatches.Length
            matches := clsMatches
    }
    if !matches.Length
        return WinExist("A")          ; V12: program not open -> use whatever is active instead of failing
    hwnd := 0
    if node.Get("winMatch", "") != "program" && win.Get("title", "") != "" {
        wantTitle := win["title"]
        for id in matches {
            if WinGetTitle("ahk_id " . id) = wantTitle {
                hwnd := id
                break
            }
        }
        if !hwnd {
            for id in matches {
                curTitle := WinGetTitle("ahk_id " . id)
                if curTitle != "" && (InStr(curTitle, wantTitle) || InStr(wantTitle, curTitle)) {
                    hwnd := id
                    break
                }
            }
        }
    }
    if !hwnd {
        active := WinExist("A")
        hwnd := VM__IndexOf(matches, active) ? active : matches[1]
    }
    if !WinActive("ahk_id " . hwnd) {
        try WinActivate("ahk_id " . hwnd)
        WinWaitActive("ahk_id " . hwnd, , 2)     ; V12: keep going even if activation is slow/blocked
    }
    return hwnd
}
V4_Spot(node, runner := 0, hwnd := "") {
    if hwnd = "" {            ; callers that already found and locked the window pass it in
        hwnd := V4_Window(node)
        V14_LockWindow(node, hwnd, runner)
    }
    spots := node.Get("varySpots", "")
    if spots is Array && spots.Length {
        rIdx := V8_RoundNumber(node, runner)
        pick := spots[Mod(Max(1, rIdx) - 1, spots.Length) + 1]
        if pick is Map {
            pt := V14_ResolvePoint(pick, hwnd)
            if IsObject(pt)
                return pt
            x := pick.Get("scrX", pick.Get("x", 0)), y := pick.Get("scrY", pick.Get("y", 0))
            if pick.Has("rx") && hwnd {
                WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
                x := wx + pick["rx"], y := wy + pick["ry"]
            }
            return {X: x, Y: y}
        }
    }
    shift := V8_CalcPixelShift(node, runner)
    pt := V14_ResolvePoint(node, hwnd)
    if IsObject(pt)
        return {X: pt.X + shift.DX, Y: pt.Y + shift.DY}
    x := node.Get("scrX", node.Get("x", 0)), y := node.Get("scrY", node.Get("y", 0))
    if node.Has("rx") && hwnd {
        WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
        x := wx + node["rx"], y := wy + node["ry"]
    }
    return {X: x + shift.DX, Y: y + shift.DY}
}
V4_ImageCache(pattern) {
    static paths := Map()
    if paths.Has(pattern) && FileExist(paths[pattern])
        return paths[pattern]
    if SubStr(pattern, 1, 6) != "V4BMP:"
        throw Error("Unsupported legacy picture. Recapture with New picture.")
    data := V4_Unbase64(SubStr(pattern, 7))
    if data.Size < 54 || NumGet(data, 0, "UShort") != 0x4D42
        throw Error("Invalid embedded BMP.")
    dir := A_Temp . "\VisualMacroBlocks-V4-" . DllCall("GetCurrentProcessId")
    DirCreate(dir)
    imageFile := dir . "\target-" . (paths.Count + 1) . ".bmp"
    f := FileOpen(imageFile, "w")
    try f.RawWrite(data)
    finally f.Close()
    paths[pattern] := imageFile
    return imageFile
}
V4_FindImage(node, runner := 0) {
    pattern := node.Get("pattern", "")
    imageFile := V4_ImageCache(pattern)
    x1 := SysGet(76), y1 := SysGet(77)
    x2 := x1 + SysGet(78) - 1, y2 := y1 + SysGet(79) - 1
    baseVar := Integer(VF_Clamp(node.Get("variation", 60), 0, 255))
    found := ImageSearch(&x, &y, x1, y1, x2, y2, "*" . baseVar . " " . imageFile)
    if !found && V5_HideOverlays()          ; the run bar may be covering it: look again without it
        found := ImageSearch(&x, &y, x1, y1, x2, y2, "*" . baseVar . " " . imageFile)
    if !found {
        for tryVar in [80, 100, 125] {
            if tryVar > baseVar {
                found := ImageSearch(&x, &y, x1, y1, x2, y2, "*" . tryVar . " " . imageFile)
                if found
                    break
            }
        }
    }
    shift := V8_CalcPixelShift(node, runner)
    return {Found: found, X: found ? x + node.Get("offsetX", 16) + shift.DX : 0,
        Y: found ? y + node.Get("offsetY", 12) + shift.DY : 0}
}
V4_DesktopStep(node, runner) {
    t := node["type"]
    switch t {
        case "delay": runner.Sleep(Max(0, Number(runner.Expand(node.Get("ms", 0)))))
        case "text":
            V4_Window(node, runner)
            SendText(runner.Value(node, "text"))
        case "keys":
            V4_Window(node, runner)
            keysToSend := V8_ResolveKeys(node, runner)
            if keysToSend != ""
                SendEvent(keysToSend)
        case "click", "drag":
            hwnd := V4_Window(node, runner)
            V14_LockWindow(node, hwnd, runner)
            steady := V18_Steady(runner)
            if node.Get("find", "") = "spot" {
                point := V4_Spot(node, runner, hwnd)
                if steady && node.Get("scroll", "") is Map      ; V19: scroll the list back first, then check the picture
                    V19_RestoreScroll(node, point, runner)
                if steady               ; V18: wait until the screen at the spot looks like the recording
                    point := V18_VerifySpot(node, hwnd, runner, point)
            } else {
                point := V4_FindImage(node, runner)
                if !point.Found {
                    if !(node.Has("scrX") || node.Has("x") || node.Has("rx"))
                        throw Error("The target picture was not found.")
                    point := V4_Spot(node, runner, hwnd)     ; V12: fall back to the recorded spot
                }
            }
            button := node.Get("button", "Left")
            if !RegExMatch(button, "i)^(Left|Right|Middle)$")
                throw Error("Unsupported mouse button.")
            V5_HideOverlays(point.X, point.Y)       ; never click the run bar by accident
            held := V18_ModsDown(node.Get("mods", ""))      ; V18: Ctrl / Shift that was held while recording
            try {
                if steady {             ; arrive first, then press: apps that ignore a click sent mid-move still get it
                    MouseMove(point.X, point.Y, 0)
                    runner.Sleep(40)
                }
                if t = "click"
                    Click(point.X, point.Y, button, Integer(node.Get("count", 1)))
                else {
                    d := V14_DragDelta(node, hwnd)
                    V5_HideOverlays(point.X + d.DX, point.Y + d.DY)
                    MouseClickDrag(button, point.X, point.Y, point.X + d.DX, point.Y + d.DY, 10)
                }
            } finally V18_ModsUp(held)
        case "wheel":
            hwnd := V4_Window(node, runner)
            if node.Get("geo", "") is Map {         ; V18: scroll where the mouse was when it was recorded
                V14_LockWindow(node, hwnd, runner)
                point := V14_ResolvePoint(node, hwnd)
                if IsObject(point) {
                    V5_HideOverlays(point.X, point.Y)
                    MouseMove(point.X, point.Y, 0)
                    if V18_Steady(runner) && node.Get("scroll", "") is Map     ; V19: same scroll start as recorded
                        V19_RestoreScroll(node, point, runner)
                    runner.Sleep(30)
                }
            }
            direction := node.Get("direction", "WheelDown")
            if !RegExMatch(direction, "^Wheel(Up|Down|Left|Right)$")
                throw Error("Invalid wheel direction.")
            SendEvent("{" . direction . " " . Integer(node.Get("count", 1)) . "}")
        case "wait", "check":
            deadline := A_TickCount + Max(1, Number(node.Get("timeoutMs", 10000)))
            loop {
                found := V4_FindImage(node).Found
                if (node.Get("appear", 1) ? found : !found)
                    break
                if A_TickCount >= deadline
                    throw Error("Timed out waiting for the image condition.")
                runner.Sleep(150)
            }
        default: throw Error("Unsupported desktop step: " . t)
    }
}
VM_TestStep(step, timeout := 4000) {
    try {
        if SubStr(step.Get("type", ""), 1, 4) = "web_" || step.Get("cond", "") = "web" {
            ctx := V4Runner(VMF_NewMacro(), {})
            count := V4_WebElement("count", step, ctx)
            return {Found: count > 0, Message: count . " matching web element(s); no click or typing was performed."}
        }
        result := step.Get("find", "") = "spot" ? V4_Spot(step) : V4_FindImage(step)
        found := result.HasOwnProp("Found") ? result.Found : true
        if found {
            ToolTip("Target at " . result.X . ", " . result.Y, result.X, result.Y)
            SetTimer(() => ToolTip(), -900)
        }
        return {Found: found, Message: found ? "Target found; no click was performed." : "Target picture not found."}
    } catch as err
        return {Found: false, Message: err.Message}
}


; ============================================================================
; V14 WINDOW-LOCKED COORDINATES
; A recorded click keeps a "geo" map: its spot inside the window's client area, the client/outer size at
; recording, the maximized flag and the edge each axis sticks to. Playback first puts a resizable window back to
; its recorded size (setting lockWindowSize, default on), then works the spot out from the window's current
; client position - moved windows always line up, and resized ones still land on edge-anchored controls.
; ============================================================================

; @summary Window geometry for a recorded screen point ("" when the window can't be read).
; @tags macro, record, coordinates, window, v14
V14_CaptureGeo(hwnd, x, y) {
    if !hwnd
        return ""
    try {
        WinGetClientPos(&cx0, &cy0, &cw, &ch, "ahk_id " . hwnd)
        WinGetPos(, , &ww, &wh, "ahk_id " . hwnd)
        mm := WinGetMinMax("ahk_id " . hwnd)
    } catch
        return ""
    if cw < 1 || ch < 1
        return ""
    cx := Round(x) - cx0, cy := Round(y) - cy0
    return Map("cx", cx, "cy", cy, "cw", cw, "ch", ch, "ww", ww, "wh", wh, "max", mm = 1 ? 1 : 0,
        "ax", V14_PickAnchor(cx, cw, "x"), "ay", V14_PickAnchor(cy, ch, "y"))
}

; @summary Which edge a spot follows when its window is resized: x -> L / R / P (proportional), y -> T / B.
;          Rows and fields flow from the top, so only spots near the bottom (OK / status bars) follow the bottom.
; @tags macro, coordinates, window, v14
V14_PickAnchor(pos, size, axis) {
    if axis = "y"
        return size - pos <= Min(120, size * 0.25) ? "B" : "T"
    if size - pos <= Min(250, size * 0.3)
        return "R"
    return pos <= size * 0.4 ? "L" : "P"
}

; @summary Moves one recorded client coordinate onto the current client size using its anchor.
; @tags macro, coordinates, window, v14
V14_Axis(pos, recSize, curSize, anchor) {
    switch anchor {
        case "R", "B": return curSize - (recSize - pos)
        case "P": return Round(pos * curSize / Max(1, recSize))
    }
    return pos
}

; @summary Screen point for a step or vary-spot that has a geo map, or "" so the caller uses the old coordinates.
; @tags macro, coordinates, window, v14
V14_ResolvePoint(src, hwnd) {
    geo := src.Get("geo", "")
    if !(geo is Map) || !hwnd
        return ""
    try WinGetClientPos(&cx0, &cy0, &cw, &ch, "ahk_id " . hwnd)
    catch
        return ""
    if cw < 1 || ch < 1
        return ""
    return {X: cx0 + V14_Axis(geo["cx"], geo["cw"], cw, geo.Get("ax", "L")),
        Y: cy0 + V14_Axis(geo["cy"], geo["ch"], ch, geo.Get("ay", "T"))}
}

; @summary During a run, puts a resizable window back to the size (or maximized state) it had when the step was
;          recorded, keeping it on its monitor. Fixed-size dialogs and menus are left alone. True when it changed.
; @tags macro, play, window, v14
V14_LockWindow(node, hwnd, runner) {
    if !hwnd || !IsObject(runner) || !runner.HasOwnProp("Settings") || !runner.Settings.Get("lockWindowSize", 1)
        return false
    geo := node.Get("geo", "")
    if !(geo is Map) {
        spots := node.Get("varySpots", "")
        geo := spots is Array && spots.Length && spots[1] is Map ? spots[1].Get("geo", "") : ""
    }
    if !(geo is Map) || !geo.Has("ww")
        return false
    id := "ahk_id " . hwnd
    try {
        if !(WinGetStyle(id) & 0x40000)          ; WS_THICKFRAME: only windows a user could resize
            return false
        mm := WinGetMinMax(id)
        if geo.Get("max", 0) {
            if mm = 1
                return false
            WinMaximize(id)
        } else {
            WinGetPos(&x, &y, &w, &h, id)
            if mm = 0 && w = geo["ww"] && h = geo["wh"]
                return false
            if mm != 0 {
                WinRestore(id)
                WinGetPos(&x, &y, , , id)
            }
            V14_FitOnMonitor(&x, &y, geo["ww"], geo["wh"])
            WinMove(x, y, geo["ww"], geo["wh"], id)
        }
    } catch
        return false
    ; Esc-stoppable wait until the window reaches its size, or stops changing (apps can clamp to a minimum size).
    prev := ""
    Loop 25 {
        try {
            if geo.Get("max", 0)
                cur := WinGetMinMax(id) = 1 ? "ok" : "restored"
            else {
                WinGetPos(, , &w, &h, id)
                cur := w = geo["ww"] && h = geo["wh"] ? "ok" : w . "x" . h
            }
        } catch
            return false
        if cur = "ok" || cur = prev
            break
        prev := cur
        runner.Sleep(40)
    }
    runner.Sleep(120)   ; no event says the app has finished re-laying out its controls
    return true
}

; @summary Shifts a window's top-left so a w x h window fits the work area of the monitor it is on.
; @tags macro, window, monitor, v14
V14_FitOnMonitor(&x, &y, w, h) {
    mon := MonitorGetPrimary()
    Loop MonitorGetCount() {
        MonitorGet(A_Index, &l, &t, &r, &b)
        if x + 8 >= l && x + 8 < r && y + 8 >= t && y + 8 < b {
            mon := A_Index
            break
        }
    }
    MonitorGetWorkArea(mon, &l, &t, &r, &b)
    x := Max(l, Min(x, r - w)), y := Max(t, Min(y, b - h))
}

; @summary Drag distance, scaled on any axis that follows the window proportionally.
; @tags macro, play, coordinates, v14
V14_DragDelta(node, hwnd) {
    dx := node.Get("dx", 0), dy := node.Get("dy", 0)
    geo := node.Get("geo", "")
    if geo is Map && hwnd {
        try {
            WinGetClientPos(, , &cw, &ch, "ahk_id " . hwnd)
            if geo.Get("ax", "") = "P" && cw > 0
                dx := Round(dx * cw / Max(1, geo["cw"]))
            if geo.Get("ay", "") = "P" && ch > 0
                dy := Round(dy * ch / Max(1, geo["ch"]))
        }
    }
    return {DX: dx, DY: dy}
}


; ============================================================================
; V4 BITMAP CAPTURE, STEP EDITING AND EXPLICIT DESKTOP RECORDING
; Captured pictures are embedded BMP data. Runtime cache files are removed on exit.
; No global recording occurs until Record is pressed.
; ============================================================================

V4_CaptureBmp(x, y, width, height) {
    width := Integer(width), height := Integer(height)
    if width < 1 || height < 1 || width > 4096 || height > 4096
        throw Error("Capture size must be between 1 and 4096 pixels in each direction.")
    dc := DllCall("GetDC", "Ptr", 0, "Ptr")
    mem := 0, bmp := 0, old := 0
    try {
        mem := DllCall("gdi32\CreateCompatibleDC", "Ptr", dc, "Ptr")
        bi := Buffer(40, 0)
        NumPut("UInt", 40, "Int", width, "Int", -height, "UShort", 1, "UShort", 32, bi)
        bits := 0
        bmp := DllCall("gdi32\CreateDIBSection", "Ptr", dc, "Ptr", bi, "UInt", 0,
            "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
        if !mem || !bmp || !bits
            throw OSError()
        old := DllCall("gdi32\SelectObject", "Ptr", mem, "Ptr", bmp, "Ptr")
        if !DllCall("gdi32\BitBlt", "Ptr", mem, "Int", 0, "Int", 0, "Int", width, "Int", height,
            "Ptr", dc, "Int", x, "Int", y, "UInt", 0x40CC0020)
            throw OSError()
        pixels := width * height * 4
        out := Buffer(54 + pixels, 0)
        NumPut("UShort", 0x4D42, "UInt", out.Size, out)
        NumPut("UInt", 54, out, 10)
        DllCall("RtlMoveMemory", "Ptr", out.Ptr + 14, "Ptr", bi, "UPtr", 40)
        DllCall("RtlMoveMemory", "Ptr", out.Ptr + 54, "Ptr", bits, "UPtr", pixels)
        return "V4BMP:" . V4_Base64(out)
    } finally {
        if old
            DllCall("gdi32\SelectObject", "Ptr", mem, "Ptr", old)
        if bmp
            DllCall("gdi32\DeleteObject", "Ptr", bmp)
        if mem
            DllCall("gdi32\DeleteDC", "Ptr", mem)
        if dc
            DllCall("ReleaseDC", "Ptr", 0, "Ptr", dc)
    }
}
VM_CaptureClickStep(x, y, button := "Left", count := 1) {
    CoordMode("Mouse", "Screen")
    MouseGetPos(, , &hwnd)
    win := Map("exe", "", "cls", "", "title", "")
    wx := 0, wy := 0
    if hwnd {
        try {
            win["exe"] := WinGetProcessName("ahk_id " . hwnd)
            win["cls"] := WinGetClass("ahk_id " . hwnd)
            WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
        }
    }
    left := Max(SysGet(76), Round(x) - 20), top := Max(SysGet(77), Round(y) - 15)
    width := Min(40, SysGet(76) + SysGet(78) - left)
    height := Min(30, SysGet(77) + SysGet(79) - top)
    step := Map("type", "click", "button", button, "count", count, "x", Round(x), "y", Round(y),
        "scrX", Round(x), "scrY", Round(y), "rx", Round(x) - wx, "ry", Round(y) - wy,
        "offsetX", Round(x) - left, "offsetY", Round(y) - top, "win", win, "gapMs", 0,
        "pattern", V4_CaptureBmp(left, top, width, height), "q", 1)
    geo := V14_CaptureGeo(hwnd, x, y)
    if geo is Map
        step["geo"] := geo
    return step
}
VM_NewWaitStep(patternText) {
    if SubStr(patternText, 1, 6) != "V4BMP:"
        throw Error("Use V4's capture tool to create an embedded bitmap.")
    buf := V4_Unbase64(SubStr(patternText, 7))
    return Map("type", "wait", "pattern", patternText, "q", 1, "appear", 1,
        "timeoutMs", 10000, "gapMs", 0, "offsetX", Abs(NumGet(buf, 18, "Int")) // 2,
        "offsetY", Abs(NumGet(buf, 22, "Int")) // 2)
}
VM_UiPickPoint(prompt) {
    CoordMode("Mouse", "Screen")
    ToolTip(prompt)
    try {
        while GetKeyState("F6", "P") || GetKeyState("Escape", "P")
            Sleep(30)
        loop {
            if GetKeyState("Escape", "P")
                return false
            if GetKeyState("F6", "P") {
                MouseGetPos(&x, &y)
                return {X: x, Y: y}
            }
            Sleep(25)
        }
    } finally ToolTip()
}
VM_UiDragImage(title, prompt, owner) {
    if MsgBox(prompt, title, "OKCancel Iconi") != "OK"
        return ""
    owner.Hide()
    CoordMode("Mouse", "Screen")
    ToolTip("Drag a rectangle around the image. Esc cancels.")
    try {
        while GetKeyState("LButton", "P")
            Sleep(25)
        while !GetKeyState("LButton", "P") {
            if GetKeyState("Escape", "P")
                return ""
            Sleep(20)
        }
        MouseGetPos(&x1, &y1)
        while GetKeyState("LButton", "P") {
            if GetKeyState("Escape", "P")
                return ""
            MouseGetPos(&x2, &y2)
            ToolTip("Capture: " . Abs(x2-x1) . " x " . Abs(y2-y1) . " pixels")
            Sleep(20)
        }
        MouseGetPos(&x2, &y2)
        ToolTip()
        Sleep(100)
        if Abs(x2 - x1) < 2 || Abs(y2 - y1) < 2
            return ""
        return V4_CaptureBmp(Min(x1, x2), Min(y1, y2), Abs(x2 - x1), Abs(y2 - y1))
    } finally {
        ToolTip()
        owner.Show()
    }
}
VM_UiEditStep(node, title := "Edit step", owner := 0, columns := 0, showAll := false) {
    if SubStr(node.Get("type", ""), 1, 4) = "web_" || SubStr(node.Get("type", ""), 1, 6) = "input_" || SubStr(node.Get("type", ""), 1, 4) = "det_"
        return V4_BlockEdit(node, showAll)
    dlg := Gui((owner ? "+Owner" . owner : "") . " -MinimizeBox", title)
    dlg.SetFont("s9", "Segoe UI")
    controls := Map(), fresh := V4_Clone(node), t := node["type"]
    easyFields := showAll ? "" : V17_EasyFields(t)      ; V17 Easy mode: only the main boxes
    easy := easyFields is Map
    shown(key) => !easy || easyFields.Has(key)
    add(key, label, multi := false) {
        if !shown(key)
            return
        dlg.AddText("xm w540 y+9", label)
        controls[key] := dlg.AddEdit("xm w540" . (multi ? " h110 +WantReturn" : ""), V4_Text(node.Get(key, "")))
    }
    if t = "text" {
        add("text", "Literal text, with optional {{Column}} / {{variable}} placeholders:", true)
        if shown("ask") {
            controls["ask"] := dlg.AddCheckbox("xm y+8", "Ask for this text at runtime instead of saving it")
            controls["ask"].Value := node.Get("ask", 0)
        }
        add("prompt", "Runtime input prompt:")
        if columns is Array
            dlg.AddText("xm w540 cGray", "Available: " . V4_Join(columns))
    } else if t = "keys"
        add("keys", "AutoHotkey Send keys (for example {Enter}, {Tab}, ^s):")
    else if t = "delay"
        add("ms", "Delay in milliseconds:")
    else if t = "click" || t = "drag" {
        if shown("spot") {
            controls["spot"] := dlg.AddCheckbox("xm w540", "Use coordinates instead of the embedded picture")
            controls["spot"].Value := node.Get("find", "") = "spot"
        }
        add("scrX", "Recorded screen X:")
        add("scrY", "Recorded screen Y:")
        add("button", "Mouse button: Left, Right or Middle")
        if t = "click"
            add("count", "Click count: 1 or 2")
        else {
            add("dx", "Drag distance X (pixels):")
            add("dy", "Drag distance Y (pixels):")
        }
    } else if t = "wait" || t = "check" {
        add("timeoutMs", "Timeout in milliseconds:")
        if shown("appear") {
            controls["appear"] := dlg.AddCheckbox("xm y+8", "Wait for appearance (unchecked = disappearance)")
            controls["appear"].Value := node.Get("appear", 1)
        }
    } else if t = "wheel" {
        add("direction", "WheelUp, WheelDown, WheelLeft or WheelRight:")
        add("count", "Number of wheel notches:")
    }
    if RegExMatch(t, "^(click|drag|wait|check)$")
        add("variation", "Picture variation 0-255 (blank = 60):")
    add("gapMs", "Recorded gap before step (milliseconds):")
    add("note", "Note:")
    state := {Saved: false, More: false, Tmp: 0}
    more(*) {
        tmp := V4_Clone(node)
        for key, ctl in controls {
            if key = "spot"
                tmp["find"] := ctl.Value ? "spot" : ""
            else
                tmp[key] := ctl.Value
        }
        state.More := true, state.Tmp := tmp
        dlg.Destroy()
    }
    apply(*) {
        try {
            for key, ctl in controls {
                if key = "spot"
                    continue
                value := ctl.Value
                if RegExMatch(key, "^(ms|timeoutMs|gapMs|scrX|scrY|count|dx|dy|variation)$") {
                    if value = ""
                        value := key = "variation" ? 60 : 0
                    if !IsInteger(value)
                        throw Error(key . " must be a whole number.")
                    value := Integer(value)
                    if RegExMatch(key, "^(ms|timeoutMs|gapMs|count)$") && value < 0
                        throw Error(key . " cannot be negative.")
                }
                fresh[key] := value
            }
            if controls.Has("spot")
                fresh["find"] := controls["spot"].Value ? "spot" : ""
            if t = "text" && fresh.Get("ask", 0)
                fresh["text"] := ""
            if t = "click" && !VM__IndexOf([1, 2], fresh.Get("count", 1))
                throw Error("Click count must be 1 or 2.")
            ; Explicitly edited absolute coordinates no longer use a stale relative offset.
            if controls.Has("scrX") && (fresh.Get("scrX", 0) != node.Get("scrX", 0)
                || fresh.Get("scrY", 0) != node.Get("scrY", 0))
                for key in ["rx", "ry", "geo"]
                    if fresh.Has(key)
                        fresh.Delete(key)
            V4_ReplaceMap(node, fresh)
            state.Saved := true
            dlg.Destroy()
        } catch as err
            MsgBox(err.Message, "Edit step", "Icon!")
    }
    dlg.AddButton("xm y+14 w100 Default", "OK").OnEvent("Click", apply)
    dlg.AddButton("x+8 w100", "Cancel").OnEvent("Click", (*) => dlg.Destroy())
    if easy
        dlg.AddButton("x+16 w110", "More options...").OnEvent("Click", more)
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    hwnd := dlg.Hwnd
    dlg.Show()
    WinWaitClose("ahk_id " . hwnd)
    if state.More {
        if !VM_UiEditStep(state.Tmp, title, owner, columns, true)
            return false
        V4_ReplaceMap(node, state.Tmp)
        return true
    }
    return state.Saved
}

VM_Rec() {
    static state := {Active: false, Paused: false, Steps: [], Hook: 0, Opts: {}, Last: 0,
        Down: Map(), Hotkeys: []}
    return state
}
VM_RecordStart(steps, opts := 0) {
    state := VM_Rec()
    if state.Active || VM_IsPlaying()
        return false
    quiet := IsObject(opts) && opts.HasOwnProp("Quiet") && opts.Quiet       ; V18: the editor shows this the first time only
    if !quiet && MsgBox("Record desktop clicks, drags, wheel actions and typing?"
        . "`n`nTyped text and small target pictures may be saved in the macro."
        . " Do not type passwords or private data while recording. Use runtime-input blocks instead."
        . "`n`nIf a Web / CDP tab is connected, actions inside that tab are also recorded as web blocks"
        . " (CSS selectors). Password fields are saved as 'ask each time' - never the typed password."
        . "`n`n(The editor shows this reminder the first time only.)",
        "Visual Macro Blocks recording", "OKCancel Icon!") != "OK"
        return false
    state.Steps := steps, state.Opts := IsObject(opts) ? opts : {}
    state.Active := true, state.Paused := false, state.Last := A_TickCount
    state.Down := Map(), state.Hotkeys := []
    try {
        hook := InputHook("V")
        hook.KeyOpt("{All}", "N")
        hook.OnChar := V4_RecordChar
        hook.OnKeyDown := V4_RecordKey
        state.Hook := hook
        for button in ["Left", "Right", "Middle"] {
            key := button = "Left" ? "LButton" : button = "Right" ? "RButton" : "MButton"
            for suffix in ["", " Up"] {
                chord := "~*" . key . suffix
                Hotkey(chord, V4_RecordMouse.Bind(button, suffix = ""), "On")
                state.Hotkeys.Push(chord)
            }
        }
        for direction in ["WheelUp", "WheelDown", "WheelLeft", "WheelRight"] {
            chord := "~*" . direction
            Hotkey(chord, V4_RecordWheel.Bind(direction), "On")
            state.Hotkeys.Push(chord)
        }
        hook.Start()
        V18_PreShotReset()
        SetTimer(V18_PreShotTick, 80)       ; V18: keeps a picture of what is under the resting mouse (see V18_PreShot)
        return true
    } catch as err {
        VM_RecordStop()
        MsgBox(err.Message, "Recording could not start", "Iconx")
        return false
    }
}
VM_RecordPause(paused := unset) {
    state := VM_Rec()
    state.Paused := IsSet(paused) ? paused : !state.Paused
    state.Last := A_TickCount
    return state.Paused
}
VM_RecordStop() {
    state := VM_Rec()
    state.Active := false
    SetTimer(V18_PreShotTick, 0)
    if IsObject(state.Hook)
        state.Hook.Stop()
    state.Hook := 0
    for chord in state.Hotkeys
        try Hotkey(chord, "Off")
    state.Hotkeys := [], state.Down := Map()
    return state.Steps
}
V4_RecordAllowed() {
    s := VM_Rec()
    if !s.Active || s.Paused
        return false
    try {
        if WinGetPID("A") = DllCall("GetCurrentProcessId")
            return false
    }
    return true
}
V4_RecordWin() {
    win := Map("exe", "", "cls", "", "title", "")
    try {
        win["exe"] := WinGetProcessName("A")
        win["cls"] := WinGetClass("A")
    }
    return win
}
V4_RecordAdd(node) {
    s := VM_Rec()
    node["gapMs"] := Max(0, A_TickCount - s.Last)
    node["_tick"] := A_TickCount
    s.Last := A_TickCount
    s.Steps.Push(node)
    if s.Opts.HasOwnProp("OnChange")
        s.Opts.OnChange.Call()
}
V4_RecordChar(hook, chars) {
    if !V4_RecordAllowed() || GetKeyState("Ctrl", "P") || GetKeyState("Alt", "P")
        || GetKeyState("LWin", "P") || GetKeyState("RWin", "P")
        return
    ; V18: Enter, Tab and Esc also arrive here as the characters `n, `t and Chr(27). V4_RecordKey already records
    ; them as key presses, so keeping the character too made every Enter / Tab happen twice on playback.
    chars := RegExReplace(chars, "[\x00-\x1F\x7F]")
    if chars = ""
        return
    s := VM_Rec()
    V17_RecNoteWindow(WinExist("A"))
    if s.Steps.Length && s.Steps[-1]["type"] = "text" && A_TickCount - s.Last < 1000 {
        s.Steps[-1]["text"] .= chars
        s.Last := A_TickCount
    } else
        V4_RecordAdd(Map("type", "text", "text", chars, "win", V4_RecordWin()))
}
V4_RecordKey(hook, vk, sc) {
    if !V4_RecordAllowed()
        return
    key := GetKeyName(Format("vk{:02X}sc{:03X}", vk, sc))
    if RegExMatch(key, "i)^(LControl|RControl|LShift|RShift|LAlt|RAlt|LWin|RWin|CapsLock|NumLock|ScrollLock)$")
        return
    ctrl := GetKeyState("Ctrl", "P"), alt := GetKeyState("Alt", "P")
    shift := GetKeyState("Shift", "P"), win := GetKeyState("LWin", "P") || GetKeyState("RWin", "P")
    if ctrl && shift && RegExMatch(key, "i)^[rpxw]$")
        return
    if !ctrl && !alt && !win && !RegExMatch(key, "i)^(Enter|Tab|Escape|Backspace|Delete|Insert|Home|End|PgUp|PgDn|Up|Down|Left|Right|F\d+)$")
        return
    chord := (ctrl ? "^" : "") . (alt ? "!" : "") . (shift ? "+" : "") . (win ? "#" : "") . "{" . key . "}"
    V17_RecNoteWindow(WinExist("A"))
    V4_RecordAdd(Map("type", "keys", "keys", chord, "win", V4_RecordWin()))
}
V4_RecordMouse(button, isDown, *) {
    state := VM_Rec()
    if !V4_RecordAllowed()
        return
    CoordMode("Mouse", "Screen")
    MouseGetPos(&x, &y, &underHwnd)
    if V18_OwnWindow(underHwnd) {       ; V18: the editor, its Stop button and the REC bar are never part of the macro
        if !isDown && state.Down.Has(button)
            state.Down.Delete(button)
        return
    }
    if isDown {
        altHeld := GetKeyState("Alt", "P")
        V17_RecNoteWindow(underHwnd)
        try {
            step := VM_CaptureClickStep(x, y, button)
            what := V20_CaptureWhat(x, y)           ; V20: what is under the mouse, for the step line
            if what is Map
                step["what"] := what
            scroll := V19_CaptureScroll(x, y)       ; V19: where the list under the click was scrolled to
            if scroll is Map
                step["scroll"] := scroll
            V18_UsePreShot(step, x, y)      ; V18: the picture from just before the press, not one racing the app's redraw
            mods := (GetKeyState("Ctrl", "P") ? "^" : "") . (GetKeyState("Shift", "P") ? "+" : "")
            if mods != ""               ; V18: Ctrl+click / Shift+click (multi-select) is played back the same way
                step["mods"] := mods
            if altHeld {
                step["varyMarked"] := 1
                step["find"] := "spot"
                ToolTip("⚡ Marked click as Variable Step! (Wizard opens when you stop recording)")
                SetTimer(() => ToolTip(), -1500)
            }
            state.Down[button] := step
        } catch as err {
            VM_RecordPause(true)
            TrayTip("Recording paused: " . err.Message, "V8")
        }
    } else if state.Down.Has(button) {
        node := state.Down.Delete(button)
        dx := x - node["scrX"], dy := y - node["scrY"]
        if Abs(dx) + Abs(dy) > 6
            node["type"] := "drag", node["dx"] := dx, node["dy"] := dy
        V4_RecordAdd(node)
    }
}
V4_RecordWheel(direction, *) {
    if V4_RecordAllowed() {
        CoordMode("Mouse", "Screen")
        MouseGetPos(&x, &y, &underHwnd)
        if V18_OwnWindow(underHwnd)
            return
        V17_RecNoteWindow(underHwnd)
        V4_RecordAdd(V18_WheelStep(direction, x, y, underHwnd))
    }
}


; ============================================================================
; V16 WEB (CDP) RECORDING
; While Record is on and a Web / CDP tab is connected, a passive listener in that tab (never blocks or changes
; the page) queues click / fill / select / check / key events with CSS selectors. A 250 ms timer drains the queue.
; The queue is mirrored to sessionStorage and the listener is re-installed on each new document, so same-origin
; navigations keep their events. On stop, desktop steps in the browser that duplicate a web event are dropped.
; ============================================================================

V16_CdpRec() {
    static s := {Active: false, Events: [], ScriptId: "", Exe: "", Busy: false, Fails: 0, StartTick: 0}
    return s
}
; @summary Starts web recording on the connected CDP tab; returns false (desktop-only recording) when none is connected.
; @tags macro, record, web, cdp
V16_CdpRecStart() {
    r := V16_CdpRec()
    r.Active := false, r.Events := [], r.ScriptId := "", r.Fails := 0, r.Busy := false
    r.StartTick := A_TickCount
    try socket := V4_Connected()
    catch
        return false
    try {
        src := "(" . V16_RecorderJS() . ")()"
        res := socket.Call("Page.addScriptToEvaluateOnNewDocument", Map("source", src))
        r.ScriptId := res.Get("identifier", "")
        socket.Eval("(()=>{const r=window.__VMB_V16_REC;if(r&&r.cleanup)r.cleanup();"
            . "try{sessionStorage.removeItem('__vmb_v16_rec_q')}catch(_){}return true})()")
        socket.Eval(src)
    } catch as err {
        TrayTip("Web recording is off (desktop only): " . err.Message, "V16")
        return false
    }
    r.Exe := ""
    try r.Exe := V4_Web().BrowserPid ? WinGetProcessName("ahk_pid " . V4_Web().BrowserPid) : ""
    r.Active := true
    SetTimer(V16_CdpRecPoll, 250)
    return true
}
V16_CdpRecPoll() {
    Critical("On")
    r := V16_CdpRec()
    if !r.Active || r.Busy
        return
    r.Busy := true
    try V16_CdpRecDrain(false)
    finally r.Busy := false
}
V16_CdpRecSocket() {
    w := V4_Web()
    if IsObject(w.Socket) && w.Socket.Socket
        return w.Socket
    if w.Target is Map && w.Target.Has("webSocketDebuggerUrl") {
        V4_Attach(w.Target)
        return w.Socket
    }
    throw Error("The web tab is disconnected.")
}
V16_CdpRecDrain(final) {
    r := V16_CdpRec()
    try {
        socket := V16_CdpRecSocket()
        if socket.Busy
            return
        res := socket.Eval("(()=>{const r=window.__VMB_V16_REC;if(!r||!r.alive)return {missing:true,now:Date.now()};"
            . "return {ev:r.drain(" . (final ? "true" : "false") . "),now:Date.now()}})()", 2000)
        tick := A_TickCount
        if !(res is Map)
            return
        if res.Has("missing") {
            if !final
                socket.Eval("(" . V16_RecorderJS() . ")()", 2000)
            return
        }
        now := res.Get("now", 0), paused := VM_Rec().Paused
        events := res.Get("ev", [])
        if events is Array
            for ev in events
                if !paused && ev is Map {
                    ev["_tick"] := tick - Max(0, now - ev.Get("t", now))
                    r.Events.Push(ev)
                }
        r.Fails := 0
    } catch as err {
        r.Fails += 1
        if r.Fails = 20
            TrayTip("Web recording cannot reach the tab: " . err.Message, "V16")
    }
}
; @summary Stops web recording, removes the listener from the tab and returns the captured web events.
; @tags macro, record, web, cdp
V16_CdpRecStop() {
    r := V16_CdpRec()
    if !r.Active
        return []
    SetTimer(V16_CdpRecPoll, 0)
    V16_CdpRecDrain(true)
    r.Active := false
    try {
        socket := V16_CdpRecSocket()
        if r.ScriptId != ""
            try socket.Call("Page.removeScriptToEvaluateOnNewDocument", Map("identifier", r.ScriptId))
        try socket.Eval("(()=>{const r=window.__VMB_V16_REC;if(r&&r.cleanup)r.cleanup();return true})()")
    }
    events := r.Events, r.Events := []
    return events
}
; @summary Turns one captured browser event into a web block (or 0 when it can't be replayed).
; @tags macro, record, web
V16_EventToNode(ev) {
    k := ev.Get("k", ""), sel := ev.Get("selector", "")
    if sel = ""
        return 0
    switch k {
        case "click":
            node := V4_CreateNode("web_click")
            button := ev.Get("button", "left")
            node["button"] := VM__IndexOf(["left", "right", "middle"], button) ? button : "left"
            node["count"] := ev.Get("count", 1) = 2 ? 2 : 1
        case "fill":
            node := V4_CreateNode("web_fill")
            if V4_Bool(ev.Get("pw", JSON.False))
                node["ask"] := 1, node["value"] := "", node["prompt"] := "Enter the password for this field:"
            else
                node["value"] := String(ev.Get("value", ""))
        case "select":
            node := V4_CreateNode("web_select")
            node["selectBy"] := "value", node["value"] := String(ev.Get("value", ""))
        case "check":
            node := V4_CreateNode("web_check")
            node["checked"] := V4_Bool(ev.Get("checked", JSON.True)) ? 1 : 0
        case "keys":
            node := V4_CreateNode("web_keys")
            node["key"] := ev.Get("key", "Enter")
        default:
            return 0
    }
    node["selector"] := sel, node["frame"] := ev.Get("frame", ""), node["index"] := 0
    node["_tick"] := ev.Get("_tick", 0)
    return node
}
V16_IsBrowserStep(step, browserExe := "") {
    win := step.Get("win", "")
    if !(win is Map)
        return false
    exe := win.Get("exe", "")
    return exe != "" && (RegExMatch(exe, "i)^(msedge|chrome|chromium|brave|vivaldi|opera)\.exe$")
        || (browserExe != "" && exe = browserExe))
}
; @summary True when a web block of the same kind (click-like, typing or key) happened within windowMs of this desktop step.
; @tags macro, record, web
V16_HasNearWeb(step, webNodes, windowMs := 2000) {
    t := step.Get("type", "")
    kinds := (t = "click" || t = "drag" || t = "wheel") ? ["web_click", "web_check", "web_select"]
        : t = "text" ? ["web_fill"]
        : t = "keys" ? ["web_keys", "web_fill"] : []
    if !kinds.Length
        return false
    tick := step.Get("_tick", 0)
    for node in webNodes
        if VM__IndexOf(kinds, node["type"]) && Abs(node["_tick"] - tick) <= windowMs
            return true
    return false
}
; @summary Merges recorded desktop steps with web events in time order, dropping desktop duplicates in the browser.
; @tags macro, record, web, blocks
V16_MergeWebSteps(desk, events, browserExe := unset, startTick := unset) {
    r := V16_CdpRec()
    browserExe := IsSet(browserExe) ? browserExe : r.Exe
    prev := IsSet(startTick) ? startTick : r.StartTick
    web := []
    if events is Array
        for ev in events
            if ev is Map && (node := V16_EventToNode(ev))
                web.Push(node)
    all := []
    for step in desk
        if step.Has("varyMarked") || !(web.Length && V16_IsBrowserStep(step, browserExe) && V16_HasNearWeb(step, web))
            all.Push(step)
    for node in web {
        i := all.Length
        while i >= 1 && all[i].Get("_tick", 0) > node["_tick"]
            i -= 1
        all.InsertAt(i + 1, node)
    }
    for node in all {
        tick := node.Get("_tick", prev)
        gap := Max(0, tick - prev)
        node["gapMs"] := node.Has("gapMs") ? Min(node["gapMs"], gap) : Min(gap, 5000)
        prev := tick
        if node.Has("_tick")
            node.Delete("_tick")
    }
    return all
}
V16_RecorderJS() {
    return "
(
function () {
"use strict";
const KEY = "__VMB_V16_REC", STORE = "__vmb_v16_rec_q";
if (window[KEY] && window[KEY].alive) return true;
const st = window[KEY] = {alive:true, q:[], pend:null, bound:new WeakSet(), listeners:[]};
try { const old = sessionStorage.getItem(STORE); if (old) st.q = JSON.parse(old) || []; } catch (_) {}
function save() { try { sessionStorage.setItem(STORE, JSON.stringify(st.q)); } catch (_) {} }
function push(ev, t) {
    ev.t = t || Date.now(); st.q.push(ev);
    if (st.q.length > 500) st.q.shift();
    save();
}
function unique(rootNode, selector) {
    try { return rootNode.querySelectorAll(selector).length === 1; } catch (_) { return false; }
}
function localSelector(el) {
    const rt = el.getRootNode(), esc = el.ownerDocument.defaultView.CSS.escape;
    if (el.id && unique(rt, "#" + esc(el.id))) return "#" + esc(el.id);
    for (const attr of ["data-testid", "data-test", "name", "aria-label"]) {
        const value = el.getAttribute(attr);
        if (value && value.length < 120) {
            const sel = el.localName + "[" + attr + '="' + esc(value) + '"]';
            if (unique(rt, sel)) return sel;
        }
    }
    const parts = [];
    for (let cur = el; cur && cur.nodeType === 1; cur = cur.parentElement) {
        if (cur.id && unique(rt, "#" + esc(cur.id))) { parts.unshift("#" + esc(cur.id)); break; }
        let sel = cur.localName;
        const parent = cur.parentElement;
        if (parent) {
            const peers = Array.from(parent.children).filter(e => e.localName === cur.localName);
            if (peers.length > 1) sel += ":nth-of-type(" + (peers.indexOf(cur) + 1) + ")";
        }
        parts.unshift(sel);
        if (unique(rt, parts.join(" > "))) break;
    }
    return parts.join(" > ");
}
function selectorFor(el) {
    const rt = el.getRootNode(), local = localSelector(el);
    return rt.host ? selectorFor(rt.host) + " >>> " + local : local;
}
const CLICKABLE = "a,button,input,select,textarea,label,summary,option,[role=button],[role=link],[role=menuitem]," +
    "[role=tab],[role=checkbox],[role=radio],[role=option],[role=switch],[onclick]";
const TEXT_TYPES = ["", "text", "search", "email", "url", "tel", "number", "password", "date", "time",
    "datetime-local", "month", "week"];
function first(e) { return e.composedPath().find(n => n && n.nodeType === 1) || null; }
function isText(el) {
    if (!el || el.readOnly || el.disabled) return false;
    if (el.localName === "textarea") return true;
    return el.localName === "input" && TEXT_TYPES.includes((el.getAttribute("type") || "").toLowerCase());
}
function isToggle(el) {
    return el && el.localName === "input" && ["checkbox", "radio"].includes((el.type || "").toLowerCase());
}
function flush() {
    const p = st.pend;
    st.pend = null;
    if (p) push({k:"fill", selector:p.selector, frame:p.frame, pw:p.pw, value:p.pw ? "" : p.value}, p.t0);
}
function listen(doc, type, fn) { doc.addEventListener(type, fn, true); st.listeners.push([doc, type, fn]); }
function allFrames(node) {
    const found = Array.from(node.querySelectorAll("iframe,frame"));
    for (const el of node.querySelectorAll("*")) if (el.shadowRoot) found.push(...allFrames(el.shadowRoot));
    return found;
}
function bind(doc, frames, depth) {
    if (depth > 12 || !doc) return;
    if (!st.bound.has(doc)) {
        st.bound.add(doc);
        const frame = frames.join(" >> ");
        listen(doc, "input", e => {
            if (!e.isTrusted) return;
            const el = first(e);
            if (!isText(el)) return;
            if (st.pend && st.pend.el !== el) flush();
            if (!st.pend) st.pend = {el, selector:selectorFor(el), frame, t0:Date.now(),
                pw:(el.getAttribute("type") || "").toLowerCase() === "password"};
            st.pend.value = el.value;
        });
        listen(doc, "focusout", e => { if (st.pend && st.pend.el === first(e)) flush(); });
        listen(doc, "change", e => {
            if (!e.isTrusted) return;
            const el = first(e);
            if (!el) return;
            if (el.localName === "select") {
                flush();
                push({k:"select", selector:selectorFor(el), frame, value:el.value});
            } else if (isToggle(el)) {
                flush();
                push({k:"check", selector:selectorFor(el), frame, checked:!!el.checked});
            } else if (isText(el)) {
                if (st.pend && st.pend.el === el) { st.pend.value = el.value; flush(); }
                else {
                    const pw = (el.getAttribute("type") || "").toLowerCase() === "password";
                    push({k:"fill", selector:selectorFor(el), frame, pw, value:pw ? "" : el.value});
                }
            }
        });
        const onClick = (e, button) => {
            if (!e.isTrusted) return;
            const raw = first(e);
            if (!raw) return;
            const el = (raw.closest && raw.closest(CLICKABLE)) || raw;
            if (el.localName === "select" || el.localName === "option" || isToggle(el)) return;
            if (el.localName === "label" && el.control && (isToggle(el.control) || el.control.localName === "select")) return;
            const selector = selectorFor(el), last = st.q[st.q.length - 1];
            if (button === "left" && e.detail === 2 && last && last.k === "click" && last.selector === selector
                && Date.now() - last.t < 800) { last.count = 2; save(); return; }
            flush();
            push({k:"click", selector, frame, button, count:1});
        };
        listen(doc, "click", e => onClick(e, "left"));
        listen(doc, "contextmenu", e => onClick(e, "right"));
        listen(doc, "keydown", e => {
            if (!e.isTrusted || e.isComposing || e.ctrlKey || e.altKey || e.metaKey) return;
            if (!["Enter", "Tab", "Escape"].includes(e.key)) return;
            const el = first(e);
            if (!el || (e.key === "Enter" && el.localName === "textarea")) return;
            flush();
            push({k:"keys", selector:selectorFor(el), frame, key:e.key === "Tab" && e.shiftKey ? "Shift+Tab" : e.key});
        });
    }
    for (const f of allFrames(doc)) {
        try { if (f.contentDocument) bind(f.contentDocument, frames.concat(selectorFor(f)), depth + 1); } catch (_) {}
    }
}
st.drain = function (final) {
    if (final) flush();
    const out = st.q;
    st.q = [];
    save();
    try { bind(document, [], 0); } catch (_) {}
    return out;
};
st.cleanup = function () {
    st.listeners.forEach(([doc, type, fn]) => { try { doc.removeEventListener(type, fn, true); } catch (_) {} });
    st.listeners = []; st.alive = false; st.pend = null;
    try { sessionStorage.removeItem(STORE); } catch (_) {}
    delete window[KEY];
};
const start = () => { try { bind(document, [], 0); } catch (_) {} };
if (document.documentElement) start(); else document.addEventListener("DOMContentLoaded", start, {once:true});
return true;
}
)"
}

; ============================================================================
; V4 CDP TRANSPORT: LOCAL WINHTTP DISCOVERY + NON-BLOCKING WINSOCK WEBSOCKETS
; No Chrome.ahk, browser extension, Node.js, WebDriver or separate DLL is required.
; RFC 6455 handshake/masking/fragmentation/ping-pong; native Windows APIs only.
; No foreign-thread AHK callbacks or downloaded helper DLLs. V4 targets Windows 10/11.
; Each command has a finite timeout; no side-effecting command is auto-retried.
; ============================================================================

V4_Web() {
    static s := {Port: 9222, Socket: 0, Target: Map(), Gui: 0, Busy: false, PickerBusy: false,
        LastPick: Map(), LastResult: "", Profile: "", BrowserPid: 0}
    return s
}
V4_Port(value) {
    if !IsInteger(value) || Integer(value) < 1024 || Integer(value) > 65535
        throw Error("Use a local debugging port from 1024 to 65535.")
    return Integer(value)
}
V4_HTTP(port, path) {
    port := V4_Port(port)
    if !VM__IndexOf(["/json/list", "/json/version"], path)
        throw Error("Only local CDP discovery endpoints are allowed.")
    req := ComObject("WinHttp.WinHttpRequest.5.1")
    req.SetProxy(1) ; direct: never send a local debugging request through a proxy
    req.SetTimeouts(1000, 1500, 1500, 1500)
    req.Option[6] := false ; do not follow redirects from a debugging endpoint
    req.Open("GET", "http://127.0.0.1:" . port . path, false)
    req.Send()
    if req.Status != 200
        throw Error("CDP discovery returned HTTP " . req.Status . ".")
    if StrLen(req.ResponseText) > 4 * 1024 * 1024
        throw Error("CDP discovery response is too large.")
    return JSON.Parse(req.ResponseText)
}
V4_SocketInit() {
    static initialized := false
    if initialized
        return
    info := Buffer(512)
    code := DllCall("Ws2_32\WSAStartup", "UShort", 0x202, "Ptr", info, "Int")
    if code
        throw Error("Windows Sockets initialization failed: " . code)
    initialized := true
}
V4_RandomBytes(size) {
    out := Buffer(size)
    if DllCall("Bcrypt\BCryptGenRandom", "Ptr", 0, "Ptr", out, "UInt", size, "UInt", 2, "Int")
        throw Error("Windows secure random generation failed.")
    return out
}
V4_SHA1(text) {
    provider := 0, hashHandle := 0
    try {
        if !DllCall("Advapi32\CryptAcquireContextW", "Ptr*", &provider, "Ptr", 0, "Ptr", 0,
            "UInt", 24, "UInt", 0xF0000000)
            throw OSError()
        if !DllCall("Advapi32\CryptCreateHash", "Ptr", provider, "UInt", 0x8004,
            "Ptr", 0, "UInt", 0, "Ptr*", &hashHandle)
            throw OSError()
        data := V4_Utf8(text)
        if !DllCall("Advapi32\CryptHashData", "Ptr", hashHandle, "Ptr", data,
            "UInt", data.Size - 1, "UInt", 0)
            throw OSError()
        out := Buffer(20), size := 20
        if !DllCall("Advapi32\CryptGetHashParam", "Ptr", hashHandle, "UInt", 2,
            "Ptr", out, "UInt*", &size, "UInt", 0)
            throw OSError()
        return out
    } finally {
        if hashHandle
            DllCall("Advapi32\CryptDestroyHash", "Ptr", hashHandle)
        if provider
            DllCall("Advapi32\CryptReleaseContext", "Ptr", provider, "UInt", 0)
    }
}
class V4Socket {
    __New(url) {
        this.Socket := 0, this.Seq := 0, this.Busy := false, this.Events := []
        if !RegExMatch(url, "i)^ws://(?:127\.0\.0\.1|localhost):(\d+)(/devtools/(?:page|browser)/[a-z0-9_-]+)$", &m)
            throw Error("Only local ws://127.0.0.1 or ws://localhost CDP endpoints are accepted.")
        port := V4_Port(m[1]), path := m[2]
        V4_SocketInit()
