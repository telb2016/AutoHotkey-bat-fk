        check("V16 merge drops browser duplicates, keeps others in time order", v16Types,
            "web_click,click,web_fill,click,")
        check("V16 password fill is ask-each-time with no saved value", v16Out[3]["ask"] . "|" . v16Out[3]["value"], "1|")
        check("V16 merge removes internal tick stamps", v16Out[1].Has("_tick") || v16Out[4].Has("_tick"), false)
        check("V16 web gap comes from timing", v16Out[1]["gapMs"], 1100)
        check("V16 no web events leaves desktop steps alone",
