                throw Error("Unsupported or invalid WebSocket framing.")
            if opcode >= 8 && (!fin || size > 125)
                throw Error("Invalid WebSocket control frame.")
            if size >= 126 {
                ext := this.Read(size = 126 ? 2 : 8, deadline), length := 0
                Loop ext.Size {
                    length := length * 256 + NumGet(ext, A_Index - 1, "UChar")
                    if length > 16 * 1024 * 1024
                        throw Error("CDP frame exceeds the 16 MB receive limit.")
                }
                if length < (size = 126 ? 126 : 65536)
                    throw Error("Non-canonical WebSocket length.")
                size := length
            }
            if size > 16 * 1024 * 1024 || used + size > 16 * 1024 * 1024
                throw Error("CDP response exceeds the 16 MB receive limit.")
            payload := this.Read(size, deadline)
            if opcode = 8 {
                try this.SendFrame(8, payload, deadline)
                throw Error("The browser closed the WebSocket.")
            }
            if opcode = 9 {
                this.SendFrame(10, payload, deadline)
                continue
            }
            if opcode = 10
                continue
            if opcode != 0 && opcode != 1
                throw Error("Only text CDP messages are supported.")
            if (opcode = 0 && !started) || (opcode = 1 && started)
                throw Error("Invalid WebSocket continuation sequence.")
            started := true
            message.Size := used + size
            if size
                DllCall("RtlMoveMemory", "Ptr", message.Ptr + used, "Ptr", payload, "UPtr", size)
            used += size
            if fin {
                if used && !DllCall("MultiByteToWideChar", "UInt", 65001, "UInt", 8,
                    "Ptr", message, "Int", used, "Ptr", 0, "Int", 0)
                    throw Error("The CDP response contains invalid UTF-8.")
                return used ? StrGet(message, used, "UTF-8") : ""
            }
        }
    }
    Call(method, params := unset, timeout := 3000) {
        if !this.Socket
            throw Error("CDP is disconnected. Reconnect explicitly in Web / CDP.")
        if this.Busy
            throw Error("A CDP request is already running.")
        if !RegExMatch(method, "^[A-Za-z][A-Za-z0-9]*\.[A-Za-z][A-Za-z0-9]*$")
            throw Error("CDP method must have the form Domain.command.")
        params := IsSet(params) ? params : Map()
        if !(params is Map)
            throw Error("CDP params must be a JSON object.")
        this.Busy := true
        timeout := Integer(VF_Clamp(timeout, 100, 30000))
        requestId := ++this.Seq
        payload := V4_Utf8(JSON.Stringify(Map("id", requestId, "method", method, "params", params)))
        deadline := A_TickCount + timeout
        try {
            payload.Size -= 1
            this.SendFrame(1, payload, deadline)
            loop {
                if V4_RunState().Stop && VM_IsPlaying()
                    throw Error("Stopped by user.")
                remaining := deadline - A_TickCount
                if remaining <= 0
                    throw Error("CDP command timed out: " . method . ". Its side effects, if any, are unknown.")
                response := JSON.Parse(this.Receive(remaining, deadline))
                if response.Has("method") {
                    this.Events.Push(response["method"])
                    if this.Events.Length > 20
                        this.Events.RemoveAt(1)
                    continue
                }
                if response.Get("id", -1) != requestId
                    continue
                if response.Has("error")
                    throw Error("CDP " . method . ": " . response["error"].Get("message", "Protocol error")
                        . " (code " . response["error"].Get("code", "") . ")")
                return response.Get("result", Map())
            }
        } catch as err {
            ; A timeout or error never silently reconnects/replays an action.
            this.Close()
            throw err
        } finally this.Busy := false
    }
    Eval(expression, timeout := 3000) {
        result := this.Call("Runtime.evaluate", Map("expression", expression, "returnByValue", JSON.True,
            "awaitPromise", JSON.True, "userGesture", JSON.True, "timeout", Max(50, timeout - 100)), timeout)
        if result.Has("exceptionDetails") {
            details := result["exceptionDetails"]
            exception := details.Get("exception", Map())
            throw Error("Browser JavaScript: " . exception.Get("description", details.Get("text", "Evaluation failed.")))
        }
        remote := result.Get("result", Map())
        return remote.Has("value") ? remote["value"] : remote.Get("unserializableValue", JSON.Null)
    }
}

V4_Targets(port := unset) {
    s := V4_Web()
    all := V4_HTTP(IsSet(port) ? port : s.Port, "/json/list")
    if !(all is Array)
        throw Error("The local port did not return a CDP target list.")
    out := []
    for target in all
        if target is Map && target.Get("type", "") = "page" && target.Has("webSocketDebuggerUrl")
            && !RegExMatch(target.Get("url", ""), "i)^(devtools|chrome-devtools)://")
            out.Push(target)
    return out
}
V4_Attach(target, port := unset) {
    s := V4_Web()
    if IsSet(port)
        s.Port := V4_Port(port)
    fresh := V4Socket(target["webSocketDebuggerUrl"])
    if IsObject(s.Socket)
        s.Socket.Close()
    s.Socket := fresh, s.Target := target
    return target
}
V4_Disconnect(*) {
    s := V4_Web()
    if IsObject(s.Socket)
        s.Socket.Close()
    s.Socket := 0, s.Target := Map()
}
V4_Connected() {
    s := V4_Web()
    if !IsObject(s.Socket) || !s.Socket.Socket
        throw Error("No browser tab connected. Open Web / CDP, launch a browser and connect a tab; or add Launch/Connect blocks.")
    return s.Socket
}
V4_ChooseTarget(port, match := "", by := "url", mode := "contains") {
    matches := []
    for target in V4_Targets(port) {
        value := target.Get(by, "")
        if match = "" || (mode = "exact" ? value = match : InStr(value, match))
            matches.Push(target)
    }
    if matches.Length != 1
        throw Error(matches.Length ? "More than one tab matches. Use a more specific URL/title or connect a tab explicitly."
            : "No browser tab matches '" . match . "'.")
    return V4_Attach(matches[1], port)
}
V4_BrowserCall(method, params := unset, timeout := 3000) {
    version := V4_HTTP(V4_Web().Port, "/json/version")
    socket := V4Socket(version["webSocketDebuggerUrl"])
    try return socket.Call(method, IsSet(params) ? params : Map(), timeout)
    finally socket.Close()
}
V4_BrowserPath(name := "Edge") {
    if FileExist(name)
        return name
    exe := StrLower(name) = "chrome" ? "chrome.exe" : StrLower(name) = "edge" ? "msedge.exe" : ""
    if exe = ""
        throw Error("Browser must be Edge, Chrome, or a full path to a Chromium browser executable.")
    for root in ["HKCU", "HKLM"] {
        try {
            candidate := RegRead(root . "\SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\" . exe)
            if FileExist(candidate)
                return candidate
        }
    }
    rel := exe = "chrome.exe" ? "\Google\Chrome\Application\" . exe : "\Microsoft\Edge\Application\" . exe
    for root in [EnvGet("ProgramFiles"), EnvGet("ProgramFiles(x86)"), EnvGet("LOCALAPPDATA")]
        if root != "" && FileExist(root . rel)
            return root . rel
    throw Error(name . " was not found. Enter the full browser .exe path in the Launch block.")
}
V4_Arg(value) {
    if InStr(value, '"') || InStr(value, "`n") || InStr(value, "`r")
        throw Error("Unexpected quote or line break in a command-line argument.")
    return '"' . value . '"'
}
V4_Launch(browser := "Edge", port := 9222) {
    s := V4_Web(), port := V4_Port(port)
    active := false
    try {
        V4_HTTP(port, "/json/version")
        active := true
    }
    if active
        throw Error("Port " . port . " is already in use by a CDP browser. Use Connect, or choose another port."
            . " V4 will not replace an existing browser.")
    exe := V4_BrowserPath(browser)
    root := EnvGet("LOCALAPPDATA")
    if root = ""
        root := A_AppData
    profile := root . "\VisualMacroBlocksV4\Profiles\CDP-" . port
    DirCreate(profile)
    Run(V4_Arg(exe) . " --remote-debugging-port=" . port . " --remote-debugging-address=127.0.0.1"
        . " --user-data-dir=" . V4_Arg(profile) . " --no-first-run --no-default-browser-check about:blank",
        , , &pid)
    s.Port := port, s.Profile := profile, s.BrowserPid := pid
    deadline := A_TickCount + 12000
    loop {
        if V4_RunState().Stop && VM_IsPlaying()
            throw Error("Launch stopped. The browser may still be open.")
        try {
            targets := V4_Targets(port)
            for target in targets
                if target.Get("url", "") = "about:blank"
                    return V4_Attach(target, port)
        }
        if A_TickCount >= deadline
            throw Error("Browser did not expose CDP on the requested local port. Check the profile, port and organization policy."
                . " V4 does not change browser policies or close existing browsers.")
        Sleep(150)
    }
}


; Embedded browser-side selector helpers. No separate .js file is loaded.
V4_ElementJS() {
    return "
(
function (a) {
"use strict";
function query(root, selector) {
    if (!selector || !selector.trim()) throw new Error("A CSS selector is required.");
    let roots = [root], nodes = [];
    const parts = selector.split(/\s+>>>\s+/);
    parts.forEach((part, i) => {
        nodes = roots.flatMap(r => Array.from(r.querySelectorAll(part)));
        if (i + 1 < parts.length) {
            roots = nodes.map(n => n.shadowRoot).filter(Boolean);
            if (nodes.length && !roots.length) throw new Error("No open shadow root at: " + part);
        }
    });
    return nodes;
}
let doc = document;
const frames = [];
if (a.frame && a.frame.trim()) {
    for (const selector of a.frame.split(/\s+>>\s+/)) {
        const found = query(doc, selector);
        if (found.length !== 1) throw new Error("Each frame selector must match exactly one iframe: " + selector);
        const frame = found[0];
        if (!/^(IFRAME|FRAME)$/.test(frame.tagName)) throw new Error("Frame selector did not select an iframe.");
        let child;
        try { child = frame.contentDocument; } catch (_) {}
        if (!child) throw new Error("Cross-origin or unavailable iframe. V4's visual selector blocks support same-origin frames only.");
        frames.push(frame); doc = child;
    }
}
const nodes = query(doc, a.selector);
if (a.action === "count") return nodes.length;
if (a.action === "exists") return nodes.length > 0;
function visible(el) {
    const r = el.getBoundingClientRect(), st = el.ownerDocument.defaultView.getComputedStyle(el);
    return r.width > 0 && r.height > 0 && el.getClientRects().length > 0 &&
        st.display !== "none" && st.visibility !== "hidden" && st.visibility !== "collapse" && Number(st.opacity) !== 0;
}
if (a.action === "wait") {
    const picked = Number(a.index) > 0 ? nodes.slice(Number(a.index) - 1, Number(a.index)) : nodes;
    const condition = a.condition || "visible";
    if (Number(a.index) === 0 && nodes.length > 1 && !["absent","hidden"].includes(condition))
        throw new Error("Ambiguous selector: " + nodes.length + " matches. Refine it or set a 1-based match index.");
    switch (condition) {
        case "present": return picked.length > 0;
        case "absent": return picked.length === 0;
        case "hidden": return picked.length === 0 || picked.every(el => !visible(el));
        case "visible": return picked.some(visible);
        case "text": return picked.some(el => String(el.textContent || "").includes(String(a.value || "")));
        default: throw new Error("Unknown wait condition.");
    }
}
let el;
if (Number(a.index) > 0) el = nodes[Number(a.index) - 1];
else {
    if (nodes.length > 1) throw new Error("Ambiguous selector: " + nodes.length + " matches. Refine it or set a 1-based match index.");
    el = nodes[0];
}
if (!el) throw new Error("No element matched the requested selector/index.");
const win = el.ownerDocument.defaultView;
if (a.action === "read") {
    const property = a.attribute || "textContent";
    if (el.type === "password" && property === "value") throw new Error("Read blocks do not return password values.");
    if (["textContent", "innerText", "value", "outerHTML"].includes(property))
        return el[property] == null ? "" : String(el[property]);
    return el.getAttribute(property);
}
if (["click", "prepareClick", "fill", "prepareType", "select", "check", "focus"].includes(a.action)) {
    if (el.matches(":disabled") || el.getAttribute("aria-disabled") === "true")
        throw new Error("The element is disabled.");
    if (!visible(el)) throw new Error("The element is not visible.");
}
if (a.action === "scroll") { el.scrollIntoView({block:"center", inline:"center", behavior:"instant"}); return true; }
if (a.action === "focus") { el.focus(); return true; }
if (a.action === "click") {
    if (typeof el.click !== "function") throw new Error("This element does not expose click(). Use CDP click.");
    el.scrollIntoView({block:"center", inline:"center", behavior:"instant"});
    el.click(); return true;
}
function at(root, x, y) {
    let hit = root.elementFromPoint(x, y);
    for (let i = 0; hit && hit.shadowRoot && i < 20; i++) {
        const deeper = hit.shadowRoot.elementFromPoint(x, y);
        if (!deeper || deeper === hit) break;
        hit = deeper;
    }
    return hit;
}
if (a.action === "prepareClick") {
    frames.forEach(f => f.scrollIntoView({block:"center", inline:"center", behavior:"instant"}));
    el.scrollIntoView({block:"center", inline:"center", behavior:"instant"});
    const r = el.getBoundingClientRect();
    let x = (Math.max(0, r.left) + Math.min(win.innerWidth, r.right)) / 2;
    let y = (Math.max(0, r.top) + Math.min(win.innerHeight, r.bottom)) / 2;
    if (x < 0 || y < 0 || x >= win.innerWidth || y >= win.innerHeight) throw new Error("Target is outside the viewport.");
    const hit = at(doc, x, y);
    if (!hit || !(el === hit || el.contains(hit))) throw new Error("Another element covers the click target.");
    for (let i = frames.length - 1; i >= 0; i--) {
        const f = frames[i], fr = f.getBoundingClientRect(), fw = f.ownerDocument.defaultView;
        if (fw.getComputedStyle(f).transform !== "none" || Math.abs(fr.width - f.offsetWidth) > 1 ||
            Math.abs(fr.height - f.offsetHeight) > 1)
            throw new Error("Transformed or scaled iframe: use DOM click or a frame-specific raw CDP command.");
        x += fr.left + f.clientLeft; y += fr.top + f.clientTop;
        const parentHit = at(f.ownerDocument, x, y);
        if (parentHit !== f) throw new Error("The iframe is covered or outside the viewport.");
    }
    return {x:x, y:y};
}
function editable() {
    if (el.readOnly) throw new Error("The field is read-only.");
    if (el.tagName === "TEXTAREA" || el.isContentEditable) return;
    if (el.tagName !== "INPUT" || /^(file|checkbox|radio|range|color|button|submit|reset|image|hidden)$/.test(el.type))
        throw new Error("Select a text input, textarea, or contenteditable element.");
}
function changed() {
    el.dispatchEvent(new win.Event("input", {bubbles:true, composed:true}));
    el.dispatchEvent(new win.Event("change", {bubbles:true, composed:true}));
}
if (a.action === "fill" || a.action === "prepareType") {
    editable(); el.focus();
    if (a.action === "prepareType") {
        if (el.isContentEditable) {
            const range = doc.createRange(); range.selectNodeContents(el);
            const sel = win.getSelection(); sel.removeAllRanges(); sel.addRange(range);
        } else {
            if (typeof el.select !== "function") throw new Error("This input does not support select(). Use DOM fill.");
            el.select();
        }
        let active = doc.activeElement;
        while (active && active.shadowRoot && active.shadowRoot.activeElement) active = active.shadowRoot.activeElement;
        if (active !== el && !el.contains(active)) throw new Error("The field could not be focused.");
        return true;
    }
    const value = String(a.value == null ? "" : a.value);
    if (el.isContentEditable) el.textContent = value;
    else {
        const proto = el.tagName === "TEXTAREA" ? win.HTMLTextAreaElement.prototype : win.HTMLInputElement.prototype;
        const setter = Object.getOwnPropertyDescriptor(proto, "value").set;
        setter.call(el, value);
        if (el.value !== value) throw new Error("The input rejected or normalized the value. Check its type and format.");
    }
    changed(); return true;
}
if (a.action === "select") {
    if (el.tagName !== "SELECT") throw new Error("Select-option blocks require a native HTML select element.");
    const opts = Array.from(el.options).filter(o =>
        (a.selectBy === "label" ? o.label.trim() : o.value) === String(a.value));
    if (opts.length !== 1) throw new Error("The option must match exactly once by value or label.");
    if (opts[0].disabled || (opts[0].parentElement.tagName === "OPTGROUP" && opts[0].parentElement.disabled))
        throw new Error("The option is disabled.");
    Array.from(el.options).forEach(o => {o.selected = o === opts[0];});
    changed(); return true;
}
if (a.action === "check") {
    if (el.tagName !== "INPUT" || !/^(checkbox|radio)$/.test(el.type))
        throw new Error("Check/uncheck blocks require a native checkbox or radio button.");
    const desired = a.checked === true;
    if (el.type === "radio" && !desired) throw new Error("Select another radio option instead of unchecking one.");
    if (el.checked !== desired) el.click();
    if (el.checked !== desired) throw new Error("The requested checked state did not take effect.");
    return true;
}
throw new Error("Unknown element action: " + a.action);
}
)"
}
V4_PickerJS() {
    return "
(
function () {
"use strict";
const root = window, key = "__VMB_V4_PICK";
if (root[key] && root[key].cleanup) root[key].cleanup();
const state = root[key] = {result:null, cancelled:false, cleanup:null};
const listeners = [];
let outlined = null, outline = "", offset = "";
const banner = document.createElement("div");
banner.id = "__vmb_v4_picker_banner";
banner.textContent = "V4: click an element to select it; Escape cancels. The click is intercepted.";
banner.style.cssText = "position:fixed;top:0;left:0;right:0;z-index:2147483647;background:#17324d;color:white;padding:10px;font:14px sans-serif;pointer-events:none";
document.documentElement.appendChild(banner);
function restore() {
    if (outlined) { outlined.style.outline = outline; outlined.style.outlineOffset = offset; }
    outlined = null;
}
state.cleanup = function () {
    listeners.forEach(([doc, type, fn]) => doc.removeEventListener(type, fn, true));
    restore(); banner.remove();
};
function unique(rootNode, selector) {
    try { return rootNode.querySelectorAll(selector).length === 1; } catch (_) { return false; }
}
function localSelector(el) {
    const rt = el.getRootNode(), esc = el.ownerDocument.defaultView.CSS.escape;
    if (el.id && unique(rt, "#" + esc(el.id))) return "#" + esc(el.id);
    for (const attr of ["data-testid", "data-test", "name", "aria-label"]) {
        const value = el.getAttribute(attr);
        if (value && value.length < 120) {
            const sel = el.localName + "[" + attr + '="' + esc(value) + '"]';
            if (unique(rt, sel)) return sel;
        }
    }
    const parts = [];
    for (let cur = el; cur && cur.nodeType === 1; cur = cur.parentElement) {
        if (cur.id && unique(rt, "#" + esc(cur.id))) { parts.unshift("#" + esc(cur.id)); break; }
        let sel = cur.localName;
        const parent = cur.parentElement;
        if (parent) {
            const peers = Array.from(parent.children).filter(e => e.localName === cur.localName);
            if (peers.length > 1) sel += ":nth-of-type(" + (peers.indexOf(cur) + 1) + ")";
        }
        parts.unshift(sel);
        if (unique(rt, parts.join(" > "))) break;
    }
    return parts.join(" > ");
}
function selectorFor(el) {
    const rt = el.getRootNode(), local = localSelector(el);
    return rt.host ? selectorFor(rt.host) + " >>> " + local : local;
}
function allFrames(node) {
    const found = Array.from(node.querySelectorAll("iframe,frame"));
    for (const el of node.querySelectorAll("*")) if (el.shadowRoot) found.push(...allFrames(el.shadowRoot));
    return found;
}
function listen(doc, type, fn) { doc.addEventListener(type, fn, true); listeners.push([doc,type,fn]); }
function bind(doc, frames, depth) {
    if (depth > 12) return;
    const stop = e => { e.preventDefault(); e.stopImmediatePropagation(); };
    for (const type of ["pointerdown","pointerup","mousedown","mouseup"]) listen(doc, type, stop);
    listen(doc, "mousemove", e => {
        const el = e.composedPath().find(n => n && n.nodeType === 1);
        if (!el || el === outlined || el === banner) return;
        restore(); outlined = el; outline = el.style.outline; offset = el.style.outlineOffset;
        el.style.outline = "3px solid #ff8800"; el.style.outlineOffset = "2px";
    });
    listen(doc, "click", e => {
        stop(e);
        const el = e.composedPath().find(n => n && n.nodeType === 1);
        if (!el || el === banner) return;
        state.result = {selector:selectorFor(el), frame:frames.join(" >> "), tag:el.localName,
            type:el.getAttribute("type") || "", url:root.location.href};
        state.cleanup();
    });
    listen(doc, "keydown", e => {
        if (e.key === "Escape") { stop(e); state.cancelled = true; state.cleanup(); }
    });
    for (const frame of allFrames(doc)) {
        try {
            if (frame.contentDocument)
                bind(frame.contentDocument, frames.concat(selectorFor(frame)), depth + 1);
        } catch (_) {}
    }
}
bind(document, [], 0);
return true;
}
)"
}


; ============================================================================
; V4 WEB BLOCK DEFINITIONS AND EXECUTION
; index=0 means "must be unique"; index>=1 explicitly picks that matching element.
; CSS shadow traversal: host >>> child
; Same-origin frame traversal: iframe#outer >> iframe#inner
; ============================================================================

V4_WebDefs() {
    static defs := 0
    if defs
        return defs
    defs := Map()
    add(kind, label, group, defaults, fields, desc := "") {
        defs[kind] := {Label: label, Group: group, Defaults: defaults, Fields: fields,
            Desc: desc = "" ? label : desc}
    }
    selector := [["selector", "CSS selector (host >>> child for open shadow roots)", "text"],
        ["frame", "Same-origin iframe selector (blank = top page; nested frames use >>)", "text"],
        ["index", "Match index: 0 = require a unique match; 1 = first match", "number"]]
    target := Map("selector", "", "frame", "", "index", 0, "timeoutMs", 10000)
    fields(extra*) {
        out := selector.Clone()
        for item in extra
            out.Push(item)
        return out
    }
    defaults(extra*) {
        out := target.Clone()
        loop extra.Length // 2
            out[extra[A_Index * 2 - 1]] := extra[A_Index * 2]
        return out
    }
    timeout := ["timeoutMs", "Timeout in milliseconds", "number"]
    result := ["variable", "Store result in variable (without {{ }}; blank = discard)", "text"]
    add("web_launch", "Launch browser for CDP", "Web - browser",
        Map("browser", "Edge", "port", 9222),
        [["browser", "Edge, Chrome, or a full browser .exe path", "text"],
         ["port", "Local CDP port (1024-65535); uses a separate V4 profile", "number"]],
        "Opens a dedicated local automation browser. Does not expose your normal browser profile.")
    add("web_connect", "Connect / select browser tab", "Web - browser",
        Map("port", 9222, "match", "", "by", "url", "mode", "contains"),
        [["port", "Local CDP port", "number"], ["by", "Match tab by", "choice", ["url", "title", "id"]],
         ["mode", "Match mode", "choice", ["contains", "exact"]], ["match", "URL/title/ID to match (blank only works when there is one page)", "text"]],
        "Connects to exactly one tab on the local debugging port. Ambiguous matches stop.")
    add("web_tab", "Switch to another tab", "Web - browser",
        Map("match", "", "by", "url", "mode", "contains"),
        [["by", "Match tab by", "choice", ["url", "title", "id"]],
         ["mode", "Match mode", "choice", ["contains", "exact"]], ["match", "Tab URL/title/ID to match", "text"]])
    add("web_navigate", "Navigate to URL", "Web - browser",
        Map("url", "https://example.com", "timeoutMs", 15000),
        [["url", "http(s) URL, file:/// URL, or about:blank; supports {{variables}}", "text"], timeout])
    add("web_newtab", "Open a new tab", "Web - browser",
        Map("url", "about:blank", "timeoutMs", 15000),
        [["url", "URL for the new tab", "text"], timeout])
    for pair in [["web_back","Browser Back"], ["web_forward","Browser Forward"], ["web_reload","Reload page"]]
        add(pair[1], pair[2], "Web - browser", Map("timeoutMs",15000), [timeout])
    add("web_close", "Close connected tab", "Web - browser", Map(), [],
        "Closes only the selected tab, not all browser windows.")
    add("web_disconnect", "Disconnect CDP", "Web - browser", Map(), [],
        "Disconnects V4 without closing your browser.")
    add("web_wait", "Wait for web element / text", "Web - elements",
        defaults("condition", "visible", "value", ""),
        fields(["condition","Wait condition","choice",["visible","present","hidden","absent","text"]],
            ["value","Text to contain (only for the text condition)","text"], timeout))
    add("web_click", "Click web element", "Web - elements",
        defaults("mode","cdp","button","left","count",1),
        fields(["mode","Click method: CDP input or JavaScript DOM click","choice",["cdp","dom"]],
            ["button","Button (DOM click supports left only)","choice",["left","right","middle"]],
            ["count","Click count (1 or 2; DOM click supports 1 only)","number"],timeout))
    add("web_fill", "Fill web field", "Web - elements",
        defaults("value","","mode","dom","ask",0,"prompt","Enter text for the web field:"),
        fields(["value","Text / {{Column}} / {{variable}} (never put secrets in saved blocks)","multiline"],
            ["mode","Fill method","choice",["dom","insertText"]],
            ["ask","Ask for this text each time; remove saved literal value","check"],
            ["prompt","Runtime prompt","text"],timeout),
        "Sets a native field and fires input/change, or uses CDP insertText. Runtime-input mode avoids saving the text.")
    add("web_select", "Select dropdown option", "Web - elements",
        defaults("value","","selectBy","value"),
        fields(["selectBy","Match native select option by","choice",["value","label"]],
            ["value","Option value / label","text"],timeout))
    add("web_check", "Set checkbox / radio", "Web - elements", defaults("checked",1),
        fields(["checked","Desired checked state","check"],timeout))
    add("web_read", "Read text / value / attribute", "Web - elements",
        defaults("attribute","textContent","variable","result"),
        fields(["attribute","textContent, innerText, value, outerHTML, or an attribute such as href","text"],result,timeout))
    add("web_count", "Count matching elements", "Web - elements", defaults("variable","count"),
        fields(result))
    add("web_exists", "Check element exists", "Web - elements", defaults("variable","exists"),
        fields(result))
    for pair in [["web_focus","Focus web element"],["web_scroll","Scroll element into view"]]
        add(pair[1], pair[2], "Web - elements", defaults(), fields(timeout))
    add("web_keys","Press browser key / shortcut","Web - elements", defaults("key","Enter"),
        fields(["key","Enter, Tab, Shift+Tab, Escape, Ctrl+A, ArrowDown, etc.","text"],timeout))
    add("web_if","If web element exists / Else","Web - logic", defaults("appear",1),
        fields(["appear","Condition is exists (unchecked = absent)","check"]),
        "A real IF/ELSE container: drag desktop or web blocks into either branch.")
    add("web_screenshot","Save browser screenshot","Web - advanced",
        Map("path",A_MyDocuments . "\VisualMacros\browser-V4.png","variable","","timeoutMs",10000),
        [["path","PNG output path; supports {{variables}}","text"],result,timeout],
        "Saves the current viewport as PNG. Existing file at this explicit path is replaced.")
    add("web_eval","Evaluate JavaScript expression","Web - advanced",
        Map("expression","document.title","variable","result","timeoutMs",3000),
        [["expression","JavaScript expression. vmb.vars and vmb.row contain current data; no text-template injection.","multiline"],
         result,timeout],
        "Runs an explicit expression. Use an IIFE for statements. Only run code you understand.")
    add("web_cdp","Raw CDP command","Web - advanced",
        Map("method","Runtime.evaluate","params",'{"expression":"document.title","returnByValue":true}',
            "scope","page","variable","cdp","timeoutMs",3000),
        [["scope","Command target","choice",["page","browser"]],["method","Domain.command","text"],
         ["params","JSON object. {{variables}} expand inside parsed string values, not into JSON syntax.","multiline"],result,timeout],
        "Direct access to CDP commands and their JSON results, with no separate helper file.")
    return defs
}
V4_WebValidate(node) {
    t := node.Get("cond", "") = "web" ? "web_if" : node.Get("type", "")
    if !V4_WebDefs().Has(t)
        throw Error("Unknown web block: " . t)
    for field in V4_WebDefs()[t].Fields {
        key := field[1], kind := field[3], value := node.Get(key, "")
        if kind = "number" {
            if !IsInteger(value)
                throw Error(key . " must be a whole number.")
            value := Integer(value)
            if key = "port"
                V4_Port(value)
            else if key = "timeoutMs" && (value < 100 || value > 120000)
                throw Error("Block timeouts must be 100-120000 ms (individual CDP commands are capped at 30000 ms).")
            else if key = "index" && value < 0
                throw Error("Match index cannot be negative.")
        }
        if kind = "choice" && !VM__IndexOf(field[4], value)
            throw Error("Invalid " . key . " choice.")
    }
    if node.Has("selector") && Trim(node["selector"]) = ""
        throw Error("A CSS selector is required.")
    if node.Has("variable") && node["variable"] != "" && !VMF_ValidVarName(node["variable"])
        throw Error("Invalid result variable name.")
    if t = "web_click" {
        if !VM__IndexOf([1,2], node.Get("count",1))
            throw Error("Click count must be 1 or 2.")
        if node.Get("mode","cdp") = "dom" && (node.Get("button","left") != "left" || node.Get("count",1) != 1)
            throw Error("DOM click supports a single left click. Choose CDP for other clicks.")
    }
    if t = "web_cdp" {
        if !(JSON.Parse(node.Get("params","{}")) is Map)
            throw Error("Raw CDP parameters must be a JSON object.")
        if !RegExMatch(node.Get("method",""), "^[A-Za-z][A-Za-z0-9]*\.[A-Za-z][A-Za-z0-9]*$")
            throw Error("Use Domain.command for the CDP method.")
    }
}
V4_WebElement(action, node, ctx) {
    args := Map("action",action,"selector",ctx.Expand(node.Get("selector","")),
        "frame",ctx.Expand(node.Get("frame","")),"index",node.Get("index",0),
        "condition",node.Get("condition","visible"),"value",ctx.Expand(node.Get("value","")),
        "attribute",node.Get("attribute","textContent"),"selectBy",node.Get("selectBy","value"),
        "checked",node.Get("checked",1) ? JSON.True : JSON.False)
    if action = "fill"
        args["value"] := ctx.Value(node)
    return V4_Connected().Eval("(" . V4_ElementJS() . ")(" . JSON.Stringify(args) . ")")
}
V4_WaitElement(node, ctx, condition := "") {
    copy := node.Clone()
    if condition != ""
        copy["condition"] := condition
    deadline := A_TickCount + node.Get("timeoutMs",10000)
    loop {
        if V4_Bool(V4_WebElement("wait",copy,ctx))
            return true
        if A_TickCount >= deadline
            throw Error("Timed out waiting for web element: " . ctx.Expand(node.Get("selector","")))
        ctx.Sleep(Min(150,Max(1,deadline - A_TickCount)))
    }
}
V4_ValidateURL(url) {
    if !RegExMatch(url,"i)^(https?://|file:///|about:blank$)")
        throw Error("Use an http(s) URL, a file:/// URL, or about:blank.")
    return url
}
V4_WebReady(ctx, timeout := 15000, loader := "", url := "", oldLoader := "") {
    deadline := A_TickCount + timeout
    loop {
        socket := V4_Connected()
        frame := socket.Call("Page.getFrameTree")["frameTree"]["frame"]
        match := (loader = "" || frame.Get("loaderId","") = loader)
            && (oldLoader = "" || frame.Get("loaderId","") != oldLoader)
            && (url = "" || frame.Get("url","") = url)
        if match {
            try {
                if socket.Eval("document.readyState") = "complete"
                    return
            } catch as err {
                if !RegExMatch(err.Message,"i)(context|navigat)")
                    throw err
            }
        }
        if A_TickCount >= deadline
            throw Error("Page load timed out. Use a selector wait for single-page apps or pages that never reach complete.")
        ctx.Sleep(100)
    }
}
V4_PressBrowserKey(keyText) {
    tokens := StrSplit(keyText,"+"), key := tokens.Pop(), modifiers := 0
    for token in tokens {
        switch StrLower(Trim(token)) {
            case "alt": modifiers |= 1
            case "ctrl","control": modifiers |= 2
            case "meta","win": modifiers |= 4
            case "shift": modifiers |= 8
            default: throw Error("Unsupported browser-key modifier: " . token)
        }
    }
    static keys := Map("Enter",[13,"Enter"],"Tab",[9,"Tab"],"Escape",[27,"Escape"],
        "Backspace",[8,"Backspace"],"Delete",[46,"Delete"],"Home",[36,"Home"],"End",[35,"End"],
        "PageUp",[33,"PageUp"],"PageDown",[34,"PageDown"],"ArrowLeft",[37,"ArrowLeft"],
        "ArrowUp",[38,"ArrowUp"],"ArrowRight",[39,"ArrowRight"],"ArrowDown",[40,"ArrowDown"],
        "Space",[32,"Space"])
    text := ""
    if keys.Has(key) {
        vk := keys[key][1], code := keys[key][2]
        if key = "Enter" && !modifiers
            text := "`r"
        if key = "Space"
            key := " ", text := " "
    } else if RegExMatch(key,"i)^F([1-9]|1[0-2])$",&m)
        vk := 111 + Integer(m[1]), code := "F" . m[1]
    else if RegExMatch(key,"i)^[a-z0-9]$") {
        vk := Ord(StrUpper(key)), code := (RegExMatch(key,"^\d$") ? "Digit" : "Key") . StrUpper(key)
        if !(modifiers & 7)
            text := modifiers & 8 ? StrUpper(key) : StrLower(key)
    } else
        throw Error("Unsupported browser key. Use Fill for text, or the raw CDP Input domain for advanced keys.")
    args := Map("type",text != "" ? "keyDown" : "rawKeyDown","key",key,"code",code,
        "windowsVirtualKeyCode",vk,"modifiers",modifiers)
    if text != ""
        args["text"] := text, args["unmodifiedText"] := text
    socket := V4_Connected()
    try socket.Call("Input.dispatchKeyEvent",args)
    finally {
        args["type"] := "keyUp"
        for prop in ["text","unmodifiedText"]
            if args.Has(prop)
                args.Delete(prop)
        if socket.Socket
            socket.Call("Input.dispatchKeyEvent",args)
    }
}
V4_WebExecute(node, ctx) {
    t := node["type"], value := JSON.Null
    switch t {
        case "web_launch": V4_Launch(node.Get("browser","Edge"),node.Get("port",9222))
        case "web_connect": V4_ChooseTarget(node.Get("port",9222),ctx.Expand(node.Get("match","")),
                node.Get("by","url"),node.Get("mode","contains"))
        case "web_tab": V4_ChooseTarget(V4_Web().Port,ctx.Expand(node.Get("match","")),
                node.Get("by","url"),node.Get("mode","contains"))
        case "web_disconnect": V4_Disconnect()
        case "web_navigate":
            url := V4_ValidateURL(ctx.Expand(node["url"]))
            reply := V4_Connected().Call("Page.navigate",Map("url",url))
            if reply.Get("errorText","") != ""
                throw Error("Navigation failed: " . reply["errorText"])
            if V4_Bool(reply.Get("isDownload",JSON.False))
                throw Error("Navigation started a download, not a page.")
            V4_WebReady(ctx,node.Get("timeoutMs",15000),reply.Get("loaderId",""))
        case "web_newtab":
            url := V4_ValidateURL(ctx.Expand(node["url"]))
            id := V4_BrowserCall("Target.createTarget",Map("url",url))["targetId"]
            deadline := A_TickCount + node.Get("timeoutMs",15000)
            loop {
                found := false
                for target in V4_Targets()
                    if target.Get("id","") = id {
                        V4_Attach(target), found := true
                        break
                    }
                if found
                    break
                if A_TickCount >= deadline
                    throw Error("New tab was created but did not become attachable.")
                ctx.Sleep(100)
            }
            V4_WebReady(ctx,node.Get("timeoutMs",15000))
        case "web_reload":
            old := V4_Connected().Call("Page.getFrameTree")["frameTree"]["frame"].Get("loaderId","")
            V4_Connected().Call("Page.reload",Map("ignoreCache",JSON.False))
            V4_WebReady(ctx,node.Get("timeoutMs",15000),, ,old)
        case "web_back","web_forward":
            history := V4_Connected().Call("Page.getNavigationHistory")
            index := history["currentIndex"] + (t = "web_back" ? -1 : 1)
            if index < 0 || index >= history["entries"].Length
                throw Error("There is no " . (t = "web_back" ? "previous" : "next") . " history entry.")
            entry := history["entries"][index+1]
            V4_Connected().Call("Page.navigateToHistoryEntry",Map("entryId",entry["id"]))
            V4_WebReady(ctx,node.Get("timeoutMs",15000),,entry["url"])
        case "web_close":
            V4_Connected()
            V4_BrowserCall("Target.closeTarget",Map("targetId",V4_Web().Target["id"]))
            V4_Disconnect()
        case "web_wait": value := V4_WaitElement(node,ctx)
        case "web_count","web_exists":
            value := V4_WebElement(t = "web_count" ? "count" : "exists",node,ctx)
        case "web_click":
            V4_WaitElement(node,ctx,"visible")
            if node.Get("mode","cdp") = "dom"
                value := V4_WebElement("click",node,ctx)
            else {
                point := V4_WebElement("prepareClick",node,ctx)
                socket := V4_Connected(), button := node.Get("button","left")
                flags := button = "left" ? 1 : button = "right" ? 2 : 4
                count := Integer(node.Get("count",1))
                Loop count {
                    args := Map("type","mousePressed","x",point["x"],"y",point["y"],"button",button,
                        "buttons",flags,"clickCount",A_Index)
                    try socket.Call("Input.dispatchMouseEvent",args)
                    finally {
                        args["type"] := "mouseReleased", args["buttons"] := 0
                        if socket.Socket
                            socket.Call("Input.dispatchMouseEvent",args)
                    }
                }
                value := true
            }
        case "web_fill":
            V4_WaitElement(node,ctx,"visible")
            if node.Get("mode","dom") = "dom"
                value := V4_WebElement("fill",node,ctx)
            else {
                text := ctx.Value(node)
                V4_WebElement("prepareType",node,ctx)
                V4_Connected().Call("Input.insertText",Map("text",text))
                value := true
            }
        case "web_select","web_check","web_focus","web_scroll","web_read","web_keys":
            V4_WaitElement(node,ctx,t = "web_read" || t = "web_scroll" ? "present" : "visible")
            action := Map("web_select","select","web_check","check","web_focus","focus",
                "web_scroll","scroll","web_read","read","web_keys","focus")[t]
            value := V4_WebElement(action,node,ctx)
            if t = "web_keys"
                V4_PressBrowserKey(node.Get("key","Enter"))
        case "web_screenshot":
            path := ctx.Expand(node.Get("path",""))
            if !RegExMatch(path,"i)\.png$")
                throw Error("Screenshot output must have a .png extension.")
            shot := V4_Connected().Call("Page.captureScreenshot",Map("format","png",
                "captureBeyondViewport",JSON.False),node.Get("timeoutMs",10000))
            data := V4_Unbase64(shot["data"])
            SplitPath(path,,&dir)
            if dir != "" && !DirExist(dir)
                DirCreate(dir)
            f := FileOpen(path,"w")
            try f.RawWrite(data)
            finally f.Close()
            value := path
        case "web_eval":
            env := Map("vars",ctx.Vars,"row",ctx.Row,"rowNumber",ctx.RowNumber,"index",ctx.LoopIndex)
            expression := "(async function(vmb){return (" . node.Get("expression","undefined") . ");})("
                . JSON.Stringify(env) . ")"
            value := V4_Connected().Eval(expression,node.Get("timeoutMs",3000))
        case "web_cdp":
            args := ctx.ExpandTree(JSON.Parse(node.Get("params","{}")))
            value := node.Get("scope","page") = "browser"
                ? V4_BrowserCall(node["method"],args,node.Get("timeoutMs",3000))
                : V4_Connected().Call(node["method"],args,node.Get("timeoutMs",3000))
        default: throw Error("Web block is not executable: " . t)
    }
    if node.Get("variable","") != ""
        ctx.Vars[node["variable"]] := value
    return value
}


; ============================================================================
; V4 BASIC INPUT BLOCKS - draggable from the left toolbox.
; Send/SendText follow the run's SendMode (Event at the start of every run).
; SendInput and SendEvent call their named AHK v2 functions explicitly.
; ============================================================================
V4_InputDefs() {
    static defs := 0
    if defs
        return defs
    defs := Map()
    target := ["target", "Window selector (blank = Macro window, else active; e.g. ahk_exe notepad.exe)", "text"]
    for spec in [
        ["input_send", "Send", "{Enter}", "Sends AHK key syntax using the selected Send mode; V4 starts each run in Event mode."],
        ["input_sendinput", "SendInput", "{Enter}", "Explicit SendInput. Uses AHK key syntax. SetKeyDelay does not pace this method."],
        ["input_sendevent", "SendEvent", "{Enter}", "Explicit SendEvent. Uses the run's key delay and press duration."],
        ["input_sendtext", "SendText (literal text)", "Hello", "Literal text: ^ + ! # and {Enter} are not shortcut notation. Use a key block for Enter."]] {
        defs[spec[1]] := {Label: spec[2], Group: "Basic input",
            Defaults: Map("value", spec[3], "target", "", "ask", 0, "prompt", "Enter input for this step:"),
            Fields: [["value", spec[1] = "input_sendtext" ? "Literal text / {{variable}} / {{Column}}"
                : "Text or AHK keys: {Enter}, {Tab}, ^s, !{F4}, {Tab 3}; {{variables}} supported", "multiline"],
                target, ["ask", "Ask for this input at runtime (do not save literal value)", "check"],
                ["prompt", "Runtime input prompt", "text"]],
            Desc: spec[4]}
    }
    for pair in [["input_keydown", "Hold key down"], ["input_keyup", "Release key"]] {
        defs[pair[1]] := {Label: pair[2], Group: "Basic input",
            Defaults: Map("key", "Ctrl", "target", ""),
            Fields: [["key", "One AHK key name, without braces (Ctrl, Shift, F5, a...)", "text"], target],
            Desc: "Sends one explicit key-down/key-up event. Pair held keys with Release key; V4 cleans up tracked keys after playback."}
    }
    defs["input_keydelay"] := {Label: "Set key delay", Group: "Input settings",
        Defaults: Map("delay", 30, "duration", 30),
        Fields: [["delay", "Delay between keys, ms (-1 = none; 0 = yield)", "number"],
            ["duration", "Key press duration, ms (-1 = none; 0 = yield)", "number"]],
        Desc: "Sets SetKeyDelay for later Event-mode sends in this run; does not slow SendInput."}
    defs["input_sendmode"] := {Label: "Set Send mode", Group: "Input settings",
        Defaults: Map("mode", "Event"), Fields: [["mode", "Mode for later Send / SendText and mouse actions", "choice", ["Event", "Input"]]],
        Desc: "Changes SendMode within this run. Explicit SendInput and SendEvent blocks keep their own method."}
    return defs
}
V4_InputValidate(node) {
    t := node.Get("type", "")
    if !V4_InputDefs().Has(t)
        throw Error("Unknown input block.")
    if t = "input_keydelay" {
        for key in ["delay", "duration"]
            if !IsInteger(node.Get(key, "")) || node[key] < -1 || node[key] > 10000
                throw Error(key . " must be -1 to 10000 milliseconds.")
    }
    if t = "input_sendmode" && !VM__IndexOf(["Event", "Input"], node.Get("mode", ""))
        throw Error("Send mode must be Event or Input.")
    if t = "input_keydown" || t = "input_keyup" {
        key := Trim(node.Get("key", ""))
        if !RegExMatch(key, "^[A-Za-z0-9_]+$") || !GetKeyVK(key)
            throw Error("Enter one valid AHK key name, without braces or modifiers.")
    }
}
V4_InputTarget(node) {
    target := Trim(node.Get("target", ""))
    if target != "" {
        hwnd := WinExist(target)
        if !hwnd
            throw Error("Input target not found: " . target)
        WinActivate("ahk_id " . hwnd)
        if !WinWaitActive("ahk_id " . hwnd, , 2)
            throw Error("Input target did not become active.")
        return hwnd
    }
    hwnd := V4_Window(node)
    if !hwnd
        throw Error("No active window for this input.")
    if WinGetPID("ahk_id " . hwnd) = DllCall("GetCurrentProcessId")
        throw Error("The macro editor has focus. Specify an input target or hide the editor before playing.")
    return hwnd
}
V4_InputExecute(node, ctx) {
    t := node["type"]
    if t = "input_keydelay" {
        SetKeyDelay(Integer(node["delay"]), Integer(node["duration"]))
        return
    }
    if t = "input_sendmode" {
        SendMode(node["mode"])
        return
    }
    ; Prompt before focusing the target, since a prompt temporarily changes focus.
    value := RegExMatch(t, "^input_send") ? ctx.Value(node) : ""
    copy := node.Clone()
    copy["target"] := ctx.Expand(node.Get("target", ""))
    if Trim(copy["target"]) = ""
        copy["target"] := V16_FallbackTarget(ctx)
    V4_InputTarget(copy)
    switch t {
        case "input_send": Send(value)
        case "input_sendinput":
            if StrLen(value) > 4000
                throw Error("SendInput text is over V4's 4000-character limit. Split it into smaller blocks or use SendEvent.")
            SendInput(value)
        case "input_sendevent": SendEvent(value)
        case "input_sendtext": SendText(value)
        case "input_keydown":
            key := node["key"]
            SendEvent("{" . key . " down}")
            ctx.HeldKeys[key] := true
        case "input_keyup":
            key := node["key"]
            SendEvent("{" . key . " up}")
            if ctx.HeldKeys.Has(key)
                ctx.HeldKeys.Delete(key)
    }
}


; ============================================================================
; V4 BLOCK FIELD EDITOR AND WEB / CDP WORKBENCH
; ============================================================================
V4_CreateNode(kind) {
    defs := V10_DetDefs().Has(kind) ? V10_DetDefs() : V4_InputDefs().Has(kind) ? V4_InputDefs() : V4_WebDefs()
    if !defs.Has(kind)
        throw Error("Unknown block: " . kind)
    node := V4_Clone(defs[kind].Defaults)
    node["type"] := kind
    if kind = "web_if" {
        node["type"] := "if", node["cond"] := "web", node["body"] := [], node["else"] := []
    }
    if kind = "det_if_pixel" {
        node["type"] := "if", node["cond"] := "pixel", node["body"] := [], node["else"] := []
    }
    return node
}
V4_PaletteExtra() {
    groups := [], lookup := Map()
    add(kind, spec) {
        if !lookup.Has(spec.Group) {
            group := [spec.Group, []]
            lookup[spec.Group] := group
            groups.Push(group)
        }
        lookup[spec.Group][2].Push([spec.Label, kind, spec.Desc])
    }
    detDefs := V10_DetDefs()
    for kind in ["det_anchor_click", "det_human_click", "det_predict_row", "det_wait_settled",
        "det_wait_pixel", "det_if_pixel", "det_normalize_win", "det_citrix_fill", "det_use_window"]
        add(kind, detDefs[kind])
    inputDefs := V4_InputDefs()
    for kind in ["input_send", "input_sendinput", "input_sendevent", "input_sendtext",
        "input_keydown", "input_keyup", "input_keydelay", "input_sendmode"]
        add(kind, inputDefs[kind])
    for kind, spec in V4_WebDefs()
        add(kind, spec)
    return groups
}
V4_BlockEdit(node, showAll := false) {
    kind := node.Get("cond", "") = "web" ? "web_if" : node.Get("cond", "") = "pixel" ? "det_if_pixel" : node["type"]
    defs := V10_DetDefs().Has(kind) ? V10_DetDefs() : V4_InputDefs().Has(kind) ? V4_InputDefs() : V4_WebDefs()
    spec := defs[kind], controls := Map(), fresh := V4_Clone(node)
    easyFields := showAll ? "" : V17_EasyFields(kind)      ; V17 Easy mode: only the main boxes (Map key -> label)
    easy := easyFields is Map
    extra := Map()                                          ; values set by "Pick window" that have no box in Easy mode
    fieldOf := Map()
    owner := VMB().Gui
    dlg := Gui((owner ? "+Owner" . owner.Hwnd : "") . " -MinimizeBox", spec.Label . (easy ? "" : " - V10"))
    dlg.SetFont("s9", "Segoe UI")
    dlgW := easy ? 540 : 825, fieldW := easy ? 510 : 388
    dlg.AddText("x14 y12 w" . (dlgW - 35) . " h42", easy ? V17_EasyDesc(kind, spec.Desc) : spec.Desc)
    x := 14, y := 58, bottom := y, col := 0
    for field in spec.Fields {
        key := field[1], label := field[2], fieldType := field[3]
        if easy {
            if !easyFields.Has(key)
                continue
            label := easyFields[key] != "" ? easyFields[key] : label
        }
        h := fieldType = "multiline" ? 100 : 26
        used := fieldType = "check" ? 42 : h + 42
        if y + used > 525 && col = 0 {
            col := 1, x := 420, y := 58
        }
        value := node.Get(key, spec.Defaults.Get(key, ""))
        if fieldType = "check" {
            ctl := dlg.AddCheckbox("x" . x . " y" . y . " w" . fieldW . " h34", label)
            ctl.Value := V4_Bool(value)
        } else {
            dlg.AddText("x" . x . " y" . y . " w" . fieldW . " h30", label)
            opts := "x" . x . " y" . (y + 30) . " w" . fieldW
            if fieldType = "choice" {
                ctl := dlg.AddDropDownList(opts, field[4])
                ctl.Value := Max(1, VM__IndexOf(field[4], value))
            } else
                ctl := dlg.AddEdit(opts . " h" . h . (fieldType = "multiline" ? " +WantReturn" : ""), V4_Text(value))
        }
        controls[key] := ctl
        fieldOf[key] := field
        y += used
        bottom := Max(bottom, y)
    }
    bottom += 8
    note := 0
    if !easy {
        dlg.AddText("x14 y" . bottom . " w790", "Note (optional)")
        note := dlg.AddEdit("x14 y" . (bottom + 22) . " w790", node.Get("note", ""))
        bottom += 58
    }
    state := {Saved: false, More: false, Tmp: 0}
    readFields() {
        out := V4_Clone(node)
        for field in spec.Fields {
            key := field[1], fieldType := field[3]
            if !controls.Has(key)
                continue
            ctl := controls[key]
            value := fieldType = "choice" ? field[4][Max(1, ctl.Value)] : ctl.Value
            if fieldType = "number" {
                if !IsInteger(value)
                    throw Error(key . " must be a whole number.")
                value := Integer(value)
            }
            out[key] := value
        }
        for key, value in extra
            out[key] := value
        if IsObject(note)
            out["note"] := note.Value
        if out.Get("ask", 0)
            out["value"] := ""
        return out
    }
    apply(*) {
        try {
            out := readFields()
            if SubStr(kind, 1, 4) = "det_"
                V10_DetValidate(out)
            else if SubStr(kind, 1, 6) = "input_"
                V4_InputValidate(out)
            else
                V4_WebValidate(out)
            V4_ReplaceMap(node, out)
            state.Saved := true
            dlg.Destroy()
        } catch as err
            MsgBox(err.Message, "Check block fields", "Icon! Owner" . dlg.Hwnd)
    }
    pick(*) {
        found := false
        try {
            dlg.Hide()
            found := V4_Pick()
            if found is Map && found.Has("selector") {
                controls["selector"].Value := found["selector"]
                controls["frame"].Value := found.Get("frame", "")
                controls["index"].Value := 0
            }
        } catch as err
            MsgBox(err.Message, "Pick web element", "Icon!")
        finally dlg.Show()
        if found is Map && found.Has("selector") && afterPick.Value
            tree()
    }
    tree(*) {
        try {
            init := Map("selector", controls["selector"].Value, "frame", controls["frame"].Value,
                "index", controls["index"].Value)
            picked := V6_ElementTree(init, {Owner: dlg, Title: spec.Label})
            if picked is Map {
                controls["selector"].Value := picked["selector"]
                controls["frame"].Value := picked["frame"]
                controls["index"].Value := picked["index"]
            }
        } catch as err
            MsgBox(err.Message, "Element tree", "Icon! Owner" . dlg.Hwnd)
    }
    test(*) {
        try {
            out := readFields()
            ctx := V4Runner(VMF_NewMacro(), {})
            count := V4_WebElement("count", out, ctx)
            MsgBox(count . " element(s) match. No click or typing was performed."
                . "`n`nVariables are not available in this editor-only test.", "Selector test", "Iconi Owner" . dlg.Hwnd)
        } catch as err
            MsgBox(err.Message, "Selector test", "Icon! Owner" . dlg.Hwnd)
    }
    pickWin(*) {
        dlg.Hide()
        picked := 0
        try picked := V17_ClickWindow("Click the TITLE BAR of the window   (Esc = cancel)")
        finally dlg.Show()
        if !picked
            return
        try geo := V17_WindowGeometry(picked)
        catch as err {
            MsgBox("Could not read that window: " . err.Message, "Pick window", "Icon! Owner" . dlg.Hwnd)
            return
        }
        vals := kind = "det_normalize_win" ? V17_GeometryFields(geo) : Map()
        vals["target"] := V17_WindowSelector(geo.Exe, geo.Cls)
        for key, value in vals {
            if controls.Has(key)
                controls[key].Value := value
            else
                extra[key] := value
        }
    }
    more(*) {
        tmp := V4_Clone(node)
        for key, ctl in controls {
            field := fieldOf[key]
            tmp[key] := field[3] = "choice" ? field[4][Max(1, ctl.Value)] : ctl.Value
        }
        for key, value in extra
            tmp[key] := value
        state.More := true, state.Tmp := tmp
        dlg.Destroy()
    }
    dlg.AddButton("x14 y" . bottom . " w105 Default", "Save block").OnEvent("Click", apply)
    dlg.AddButton("x+8 w90", "Cancel").OnEvent("Click", (*) => dlg.Destroy())
    canPickWin := kind = "det_normalize_win" || kind = "det_use_window"
    if easy {
        if canPickWin
            dlg.AddButton("x+16 w130", "📐 Pick window").OnEvent("Click", pickWin)
        else if SubStr(kind, 1, 4) = "det_"
            dlg.AddButton("x+16 w170", "🧭 Measure on screen (F6)").OnEvent("Click", (*) => V10_MeasureIntoDialog(kind, controls, dlg))
        dlg.AddButton("x+8 w110", "More options...").OnEvent("Click", more)
    } else if SubStr(kind, 1, 4) = "det_" {
        dlg.AddButton("x+20 w210", "🧭 Measure on Screen (F6)...").OnEvent("Click", (*) => V10_MeasureIntoDialog(kind, controls, dlg))
        dlg.AddButton("x+8 w140", "🔬 Open Physics Lab...").OnEvent("Click", (*) => V10_ShowDeterministicLab())
        if canPickWin
            dlg.AddButton("x+8 w130", "📐 Pick window").OnEvent("Click", pickWin)
    }
    if controls.Has("selector") {
        dlg.AddButton("x+24 w115", "Pick on page...").OnEvent("Click", pick)
        dlg.AddButton("x+8 w100", "Test selector").OnEvent("Click", test)
        dlg.AddButton("x+8 w110", "Element tree...").OnEvent("Click", tree)
        afterPick := dlg.AddCheckbox("x+10 yp+5 w180", "Show the tree after picking")
        afterPick.Value := V6_TreeAfterPick()
        afterPick.OnEvent("Click", (ctl, *) => V6_TreeAfterPick(ctl.Value))
    }
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    hwnd := dlg.Hwnd
    if owner
        owner.Opt("+Disabled")
    try {
        dlg.Show("w" . dlgW)
        WinWaitClose("ahk_id " . hwnd)
    } finally {
        if owner
            owner.Opt("-Disabled")
    }
    if state.More {
        if !V4_BlockEdit(state.Tmp, true)
            return false
        V4_ReplaceMap(node, state.Tmp)
        return true
    }
    return state.Saved
}
V4_WebEdit(node) => V4_BlockEdit(node)
V4_Pick() {
    s := V4_Web()
    if s.PickerBusy || (VM_IsPlaying() && !V5_Dbg().Editing)
        throw Error("The picker cannot run during another pick or playback.")
    socket := V4_Connected(), s.PickerBusy := true
    try {
        socket.Call("Page.bringToFront")
        socket.Eval("(" . V4_PickerJS() . ")()")
        deadline := A_TickCount + 45000
        loop {
            if GetKeyState("Escape", "P")
                return false
            result := socket.Eval("(()=>{const s=window.__VMB_V4_PICK;return s?{result:s.result,cancelled:s.cancelled}:null})()")
            if result is Map {
                if result.Get("result", JSON.Null) is Map {
                    s.LastPick := result["result"]
                    return s.LastPick
                }
                if V4_Bool(result.Get("cancelled", JSON.False))
                    return false
            }
            if A_TickCount >= deadline
                throw Error("Picker timed out after 45 seconds. Retry on a loaded page.")
            Sleep(120)
        }
    } finally {
        if socket.Socket
            try socket.Eval("(()=>{const s=window.__VMB_V4_PICK;if(s&&s.cleanup)s.cleanup();delete window.__VMB_V4_PICK;})()")
        s.PickerBusy := false
    }
}
V4_AddFromWeb(kind, selector := "", frame := "", index := 0) {
    if VM_IsPlaying() || VM_IsRecording()
        return
    node := V4_CreateNode(kind)
    if node.Has("selector") {
        node["selector"] := selector, node["frame"] := frame
        node["index"] := IsInteger(index) ? Max(0, Integer(index)) : 0
    }
    if V4_BlockEdit(node) {
        at := VMB_InsertPoint()
        VMB_InsertNode(node, at.List, at.Index)
    }
}
V4_WebPanel(*) {
    if VM_IsPlaying() || VM_IsRecording()
        return
    s := V4_Web()
    if s.Gui {
        s.Gui.Show()
        return
    }
    g := Gui("+Owner" . VMB().Gui.Hwnd . " +Resize +MinSize900x650", "Web / CDP - Visual Macro Blocks V4")
    s.Gui := g
    g.SetFont("s9", "Segoe UI")
    g.AddText("xm w900 h34", "Use a separate automation browser profile. CDP grants control of that browser. "
        . "Connect only to a local browser you trust. Organization policies are not bypassed.")
    browser := g.AddComboBox("xm y+8 w205", ["Edge", "Chrome"])
    browser.Text := "Edge"
    g.AddText("x+10 yp+4", "Port")
    port := g.AddEdit("x+5 yp-4 w65", s.Port)
    launchBtn := g.AddButton("x+10 yp-1 w100", "Launch")
    refreshBtn := g.AddButton("x+8 w100", "Refresh tabs")
    connectBtn := g.AddButton("x+8 w135", "Connect selected")
    disconnectBtn := g.AddButton("x+8 w100", "Disconnect")
    lv := g.AddListView("xm y+10 w900 h150 NoSortHdr -Multi", ["Title", "URL", "Target ID"])
    lv.ModifyCol(1, 230), lv.ModifyCol(2, 450), lv.ModifyCol(3, 205)
    status := g.AddText("xm y+8 w900 h32", "Not connected.")
    g.AddText("xm", "CSS selector")
    selector := g.AddEdit("x+12 yp-3 w450")
    pickBtn := g.AddButton("x+10 yp-1 w110", "Pick element")
    testBtn := g.AddButton("x+8 w100", "Test selector")
    treeBtn := g.AddButton("x+8 w110", "Element tree...")
    g.AddText("xm y+10", "Iframe path")
    frame := g.AddEdit("x+16 yp-3 w450")
    g.AddText("x+12 yp+3", "Match index")
    index := g.AddEdit("x+6 yp-3 w60 Number", 0)
    g.AddText("xm y+7 w900 cGray", "Blank iframe path = top page. Same-origin frames use >>; open shadow roots use >>>. "
        . "Cross-origin frame traversal and closed shadow roots are not supported by the visual picker.")
    labels := [], kinds := []
    for kind, spec in V4_WebDefs() {
        labels.Push(spec.Label), kinds.Push(kind)
    }
    choose := g.AddDropDownList("xm y+8 w290", labels)
    choose.Value := Max(1, VM__IndexOf(kinds, "web_click"))
    addBtn := g.AddButton("x+10 w145", "Add editable block")
    g.AddText("xm y+12 w900", "Advanced: send a CDP command now. This executes immediately; it does not add a block.")
    scope := g.AddDropDownList("xm y+5 w100", ["page", "browser"]), scope.Value := 1
    method := g.AddEdit("x+8 w300", "Runtime.evaluate")
    runBtn := g.AddButton("x+8 w120", "Send command")
    copyBtn := g.AddButton("x+8 w110", "Copy result")
    params := g.AddEdit("xm y+6 w900 h65 +WantReturn", '{"expression":"document.title","returnByValue":true}')
    output := g.AddEdit("xm y+7 w900 h95 ReadOnly +HScroll -Wrap")
    g.AddText("xm y+5 w900 cGray", "Results may contain page data. They are displayed here and are not saved to a log.")
    targets := []
    report(text) {
        status.Text := text
        VMB_Status(text)
    }
    refresh(*) {
        try {
            targets := V4_Targets(port.Value)
            lv.Delete()
            for tab in targets
                lv.Add(, tab.Get("title", ""), tab.Get("url", ""), tab.Get("id", ""))
            if targets.Length
                lv.Modify(1, "Select Focus")
            report(targets.Length . " page tab(s) found. Select the intended tab and Connect.")
        } catch as err
            report(err.Message)
    }
    launch(*) {
        try {
            report("Launching a dedicated automation browser...")
            V4_Launch(browser.Text, port.Value)
            refresh()
            report("Connected: " . s.Target.Get("title", "") . "  " . s.Target.Get("url", ""))
        } catch as err
            report(err.Message)
    }
    connect(*) {
        try {
            row := lv.GetNext()
            if !row
                throw Error("Select a tab first.")
            V4_Attach(targets[row], port.Value)
            report("Connected: " . targets[row].Get("title", "") . "  " . targets[row].Get("url", ""))
        } catch as err
            report(err.Message)
    }
    disconnect(*) {
        V4_Disconnect()
        report("Disconnected; the browser remains open.")
    }
    pick(*) {
        try {
            g.Hide()
            VMB().Gui.Hide()
            found := V4_Pick()
            if found is Map && found.Has("selector") {
                selector.Value := found["selector"], frame.Value := found.Get("frame", ""), index.Value := 0
                report("Selected " . found.Get("tag", "element") . ": " . selector.Value)
            }
        } catch as err
            report(err.Message)
        finally {
            VMB().Gui.Show()
            g.Show()
        }
    }
    tree(*) {
        try {
            picked := V6_ElementTree(Map("selector", selector.Value, "frame", frame.Value, "index", index.Value),
                {Owner: g})
            if picked is Map {
                selector.Value := picked["selector"], frame.Value := picked["frame"], index.Value := picked["index"]
                report("Target from the element tree: " . selector.Value
                    . (picked["index"] ? "   (match #" . picked["index"] . ")" : ""))
            }
        } catch as err
            report(err.Message)
    }
    test(*) {
        try {
            node := V4_CreateNode("web_count"), node["selector"] := selector.Value, node["frame"] := frame.Value
            count := V4_WebElement("count", node, V4Runner(VMF_NewMacro(), {}))
            report(count . " matching element(s). No page action was performed.")
        } catch as err
            report(err.Message)
    }
    run(*) {
        try {
            args := JSON.Parse(params.Value)
            result := scope.Text = "browser" ? V4_BrowserCall(method.Value, args)
                : V4_Connected().Call(method.Value, args)
            output.Value := JSON.Stringify(result)
            report("CDP command completed: " . method.Value)
        } catch as err {
            output.Value := err.Message
            report("CDP command failed; check the result pane.")
        }
    }
    close(*) {
        g.Destroy()
        s.Gui := 0
    }
    launchBtn.OnEvent("Click", launch)
    refreshBtn.OnEvent("Click", refresh)
    connectBtn.OnEvent("Click", connect)
    disconnectBtn.OnEvent("Click", disconnect)
    lv.OnEvent("DoubleClick", connect)
    pickBtn.OnEvent("Click", pick)
    testBtn.OnEvent("Click", test)
    treeBtn.OnEvent("Click", tree)
    addBtn.OnEvent("Click", (*) => V4_AddFromWeb(kinds[Max(1, choose.Value)], selector.Value, frame.Value, index.Value))
    runBtn.OnEvent("Click", run)
    copyBtn.OnEvent("Click", (*) => (A_Clipboard := output.Value))
    g.OnEvent("Close", close), g.OnEvent("Escape", close)
    g.Show("w930")
    if s.Target.Count
        report("Connected: " . s.Target.Get("title", "") . "  " . s.Target.Get("url", ""))
}


; ============================================================================
; V6 ELEMENT TREE
; A Power Automate Desktop style UI-element browser over CDP: the page's DOM as a lazily loaded tree (same-origin
; iframes and open shadow roots included), every candidate selector for the chosen element with its match count,
; a tick-the-attributes selector builder, and a live test that sets the match index when several elements match.
; It opens on the element the current selector finds; a broken selector opens at the deepest part that still works.
; The page is only read and outlined - nothing is clicked or typed. Element references live in the page
; (window.__VMB_V6_TREE) until the window closes; a reload/navigation is detected and asks for Reload tree.
; ============================================================================

; @summary Remembered choice: open the element tree right after "Pick on page" in a web block. Pass 0/1 to set it.
; @tags web, cdp, gui
V6_TreeAfterPick(value := "") {
    static on := ""
    ini := VMB().Ini
    if value != "" {
        on := value ? 1 : 0
        if ini != ""
            try IniWrite(on, ini, "Blocks", "TreeAfterPick")
        return on
    }
    if on = ""
        on := ini != "" ? (IniRead(ini, "Blocks", "TreeAfterPick", 1) ? 1 : 0) : 1
    return on
}

; @summary Sends one element-tree command (open, children, chain, detail, test, find, highlight, clear, dispose) to the
;          connected tab. gen = the tree generation returned by "open"; a mismatch means the page changed.
; @tags web, cdp
V6_TreeCall(cmd, args := 0, gen := "") {
    args := IsObject(args) ? args : Map()
    args["cmd"] := cmd, args["gen"] := gen
    return V4_Connected().Eval("(" . V6_TreeJS() . ")(" . JSON.Stringify(args) . ")", 10000)
}

; @summary Builds a selector from ticked builder parts (Maps with "group" and "css"), always in valid CSS order:
;          [inside ][parent > ]tag#id.class[attr]:nth-of-type(k), after the shadow-root prefix (host >>> ).
; @tags web, selector
V6_ComposeSelector(parts, prefix := "") {
    b := Map("inside", "", "parent", "", "tag", "", "id", "", "class", "", "attr", "", "position", "")
    for part in parts {
        grp := part["group"]
        if b.Has(grp)
            b[grp] .= part["css"]
    }
    core := b["tag"] . b["id"] . b["class"] . b["attr"] . b["position"]
    return prefix . b["inside"] . b["parent"] . (core = "" ? "*" : core)
}

; @summary Plain-language verdict for a selector test. res = Map(count, pos, error) from the page; hasTarget = an
;          element is chosen in the tree; autoIndex = move the match index to the chosen element.
; @returns {Text, Color, Index} - Index is the match index to set, or "" to leave it alone
; @tags web, selector
V6_MatchText(res, hasTarget, index, autoIndex := false) {
    count := res.Get("count", 0), pos := res.Get("pos", 0), err := res.Get("error", "")
    if err != ""
        return {Text: "Problem: " . err, Color: "C00000", Index: ""}
    if count = 0
        return {Text: "Matches nothing on the page right now.", Color: "C00000", Index: ""}
    if hasTarget && !pos
        return {Text: "Matches " . count . " element(s), but not the one selected in the tree.", Color: "B25E00", Index: ""}
    newIndex := hasTarget && autoIndex ? (count = 1 ? 0 : pos) : ""
    idx := newIndex != "" ? newIndex : index
    if idx > count
        return {Text: "Only " . count . " element(s) match, but the match index is " . idx . ".", Color: "C00000",
            Index: newIndex}
    if count = 1
        return {Text: "✓  Matches exactly 1 element" . (hasTarget ? " - the one selected in the tree." : ".")
            . (idx = 1 ? "  (Match index 1 is fine; 0 would also work.)" : ""), Color: "107C10", Index: newIndex}
    if idx = 0
        return {Text: "Matches " . count . " elements, so the step would stop as ambiguous. Set a match index or refine"
            . " the selector." . (hasTarget ? "  (The selected element is match #" . pos . ".)" : ""), Color: "B25E00",
            Index: newIndex}
    if hasTarget && idx != pos
        return {Text: "Matches " . count . " elements; match index " . idx . " is a different one than the selected"
            . " element (#" . pos . ").", Color: "B25E00", Index: newIndex}
    return {Text: "Matches " . count . " elements; match index " . idx . " picks " . (hasTarget ? "the selected one" : "it")
        . ".  A unique selector is sturdier - positions on a page can change.", Color: "B25E00", Index: newIndex}
}

; @summary The element tree window. init = Map(selector, frame, index); opts: Owner (Gui, disabled while open),
;          OnTop, Title. Blocks until closed.
; @returns Map(selector, frame, index) when "Use this target" is pressed, otherwise false
; @tags web, cdp, gui, selector
V6_ElementTree(init, opts := 0) {
    opts := IsObject(opts) ? opts : {}
    V4_Connected()                                  ; fail early with the usual "connect a tab first" message
    owner := opts.HasOwnProp("Owner") ? opts.Owner : 0
    onTop := opts.HasOwnProp("OnTop") && opts.OnTop
    title := "Element tree" . (opts.HasOwnProp("Title") && opts.Title != "" ? "  -  " . opts.Title : "")
        . "  -  Visual Macro Blocks V6"
    st := {Gen: "", Items: Map(), Regs: Map(), Dummies: Map(), Target: -1, Detail: 0, Busy: false, Result: false,
        Bold: [], Found: [], FoundPos: 0, FindText: "", Shown: 0, LastIds: [], LastKey: ""}
    dlg := Gui((owner ? "+Owner" . owner.Hwnd : "") . (onTop ? " +AlwaysOnTop" : "") . " -MinimizeBox", title)
    dlg.SetFont("s9", "Segoe UI")
    head := dlg.AddText("x10 y8 w1160 h18 +0x4000", "")             ; SS_ENDELLIPSIS
    dlg.AddText("x10 y34", "Find")
    findBox := dlg.AddEdit("x44 y30 w200")
    findBtn := dlg.AddButton("x250 y29 w54 h24", "Find")
    nextBtn := dlg.AddButton("x308 y29 w54 h24", "Next")
    findInfo := dlg.AddText("x368 y34 w84 c808080", "")
    tv := dlg.AddTreeView("x10 y60 w442 h560")
    reloadBtn := dlg.AddButton("x10 y628 w100 h26", "Reload tree")
    pickBtn := dlg.AddButton("x116 y628 w120 h26", "Pick on page...")
    lightBox := dlg.AddCheckbox("x246 y632 w206", "Outline the selection on the page")
    lightBox.Value := 1
    dlg.SetFont("s9 bold")
    dlg.AddText("x464 y34 w700", "Selected element")
    dlg.SetFont("s9 norm")
    props := dlg.AddListView("x464 y54 w706 h120 -Multi +NoSortHdr", ["Attribute", "Value"])
    props.ModifyCol(1, 150), props.ModifyCol(2, 530)
    dlg.SetFont("s9 bold")
    dlg.AddText("x464 y182 w700", "Ways to target it  (click one to use it)")
    dlg.SetFont("s9 norm")
    cands := dlg.AddListView("x464 y202 w706 h120 -Multi +NoSortHdr", ["Selector", "Matches", "It is match #"])
    cands.ModifyCol(1, 520), cands.ModifyCol(2, "70 Integer"), cands.ModifyCol(3, "90 Integer")
    dlg.SetFont("s9 bold")
    dlg.AddText("x464 y330 w700", "Or build your own  (tick what identifies it)")
    dlg.SetFont("s9 norm")
    parts := dlg.AddListView("x464 y350 w706 h120 -Multi -Hdr +Checked", ["Part"])
    parts.ModifyCol(1, 680)
    dlg.AddText("x464 y484", "CSS selector")
    selBox := dlg.AddEdit("x560 y480 w530")
    testBtn := dlg.AddButton("x1096 y479 w74 h24", "Test")
    dlg.AddText("x464 y514", "Iframe path")
    frameBox := dlg.AddEdit("x560 y510 w380")
    dlg.AddText("x952 y514", "Match index")
    idxBox := dlg.AddEdit("x1030 y510 w60 Number")
    dlg.AddUpDown("Range0-9999", 0)
    result := dlg.AddText("x464 y542 w706 h42", "")
    showBtn := dlg.AddButton("x464 y588 w190 h26", "Outline all matches on the page")
    dlg.AddText("x464 y622 w450 h34 c808080", "Page text appears here only to help you choose; it is not saved."
        . " Nothing on the page is clicked or typed into.")
    useBtn := dlg.AddButton("x930 y628 w140 h26", "Use this target")
    cancelBtn := dlg.AddButton("x1076 y628 w94 h26", "Cancel")
    enterBtn := dlg.AddButton("x0 y0 w0 h0 Default Hidden", "Enter")
    hwnd := dlg.Hwnd

    say(text, color := "000000") {
        result.SetFont("c" . color)
        result.Text := text
    }
    ; One page conversation at a time: GUI events that arrive mid-call are dropped instead of nesting CDP requests.
    guard(fn, *) {
        if st.Busy
            return
        st.Busy := true
        try fn()
        catch as err
            say(err.Message, "C00000")
        finally st.Busy := false
    }
    call(cmd, args := 0) => V6_TreeCall(cmd, args, st.Gen)
    addItem(info, parent) {
        item := tv.Add(info["label"], parent)
        st.Items[info["id"]] := item, st.Regs[item] := info["id"]
        if info["kids"] > 0
            st.Dummies[item] := tv.Add("loading...", item)
        return item
    }
    loadKids(item) {
        if !st.Dummies.Has(item)
            return
        res := call("children", Map("id", st.Regs[item]))
        tv.Delete(st.Dummies[item]), st.Dummies.Delete(item)
        for info in res["items"]
            if !st.Items.Has(info["id"])
                addItem(info, item)
        if res["more"] > 0
            tv.Add("(" . res["more"] . " more children are not listed - use Find)", item)
    }
    ; chain = registry ids from <html> down to the element; loads and expands each level, returns the deepest item.
    reveal(chain) {
        if !(chain is Array) || !chain.Length || !st.Items.Has(chain[1])
            return 0
        item := st.Items[chain[1]]
        loop chain.Length - 1 {
            loadKids(item)
            tv.Modify(item, "Expand")
            childId := chain[A_Index + 1]
            if !st.Items.Has(childId)
                break
            item := st.Items[childId]
        }
        return item
    }
    mark(ids) {
        for item in st.Bold
            try tv.Modify(item, "-Bold")
        st.Bold := []
        for id in ids
            if st.Items.Has(id) {
                tv.Modify(st.Items[id], "Bold")
                st.Bold.Push(st.Items[id])
            }
    }
    testNow(autoIndex := false) {
        idx := IsInteger(idxBox.Value) ? Integer(idxBox.Value) : 0
        res := call("test", Map("selector", selBox.Value, "frame", frameBox.Value, "target", st.Target))
        verdict := V6_MatchText(res, st.Target >= 0, idx, autoIndex)
        if verdict.Index != ""
            idxBox.Value := verdict.Index
        say(verdict.Text, verdict.Color)
        st.LastIds := res.Get("ids", [])
        mark(st.LastIds)
        st.LastKey := selBox.Value . "`n" . frameBox.Value . "`n" . idxBox.Value
        return res
    }
    showNode(item, autoSet) {
        st.Shown := item
        props.Delete(), cands.Delete(), parts.Delete()
        st.Detail := 0, st.Target := -1
        regId := st.Regs.Get(item, -1)
        if regId < 0
            return
        d := call("detail", Map("id", regId))
        for row in d["props"]
            props.Add(, row[1], row[2])
        if !V4_Bool(d["element"])
            return say("Choose an element - a frame document or a shadow root cannot be a target by itself.", "808080")
        st.Detail := d, st.Target := regId
        for c in d["cands"]
            cands.Add(, c["selector"], c["count"], c["pos"])
        for p in d["parts"]
            parts.Add(, p["label"])
        if lightBox.Value
            call("highlight", Map("ids", [regId], "scroll", JSON.True))
        if autoSet && d["cands"].Length
            useCand(1)
        else
            testNow(false)
    }
    useCand(row) {
        if !st.Detail || row < 1 || row > st.Detail["cands"].Length
            return
        selBox.Value := st.Detail["cands"][row]["selector"]
        frameBox.Value := st.Detail["frame"]
        testNow(true)
    }
    fromParts() {
        if !st.Detail
            return
        picked := [], row := 0
        while row := parts.GetNext(row, "Checked")
            picked.Push(st.Detail["parts"][row])
        if !picked.Length
            return
        selBox.Value := V6_ComposeSelector(picked, st.Detail["prefix"])
        frameBox.Value := st.Detail["frame"]
        testNow(true)
    }
    openTree(sel, frame, idx) {
        tv.Delete(), props.Delete(), cands.Delete(), parts.Delete()
        st.Items := Map(), st.Regs := Map(), st.Dummies := Map(), st.Bold := [], st.Found := [], st.FoundPos := 0
        st.Target := -1, st.Detail := 0, st.Shown := 0, st.Gen := "", findInfo.Text := ""
        selBox.Value := sel, frameBox.Value := frame, idxBox.Value := idx
        res := V6_TreeCall("open", Map("selector", sel, "frame", frame, "index", idx))
        st.Gen := res["gen"]
        head.Text := "Page:   " . res.Get("title", "") . "      " . res.Get("url", "")
        root := addItem(res["root"], 0)
        loadKids(root)
        tv.Modify(root, "Expand")
        item := res["target"] >= 0 ? reveal(res["chain"]) : 0
        if item {
            tv.Modify(item, "Select Vis")
            showNode(item, false)
        } else {
            child := tv.GetChild(root)                  ; nothing to show yet: open <body> for browsing
            while child {
                if SubStr(tv.GetText(child), 1, 4) = "body" {
                    loadKids(child)
                    tv.Modify(child, "Expand")
                    break
                }
                child := tv.GetNext(child)
            }
        }
        if Trim(sel) = ""
            say("No selector yet. Browse the tree or use Find, then click the element you want.", "808080")
        else if res["partial"] != "" {
            say((res["error"] != "" ? "Problem: " . res["error"] . "`n" : "The selector matches nothing on the page now. ")
                . "Its first part still works (" . res["partial"] . ") - that element is selected; look below it for"
                . " the target.", "C00000")
        } else if res["error"] != "" || res["count"] = 0
            say(res["error"] != "" ? "Problem: " . res["error"]
                : "The selector matches nothing on this page. Browse the tree or use Find to choose the element.", "C00000")
        else if !item
            testNow(false)
        st.LastKey := selBox.Value . "`n" . frameBox.Value . "`n" . idxBox.Value
    }
    doFind() {
        st.FindText := findBox.Value
        res := call("find", Map("text", findBox.Value))
        st.Found := res["ids"], st.FoundPos := 0
        findInfo.Text := res["total"] ? res["total"] . " found" : "none found"
        if st.Found.Length
            doNext()
    }
    doNext() {
        if !st.Found.Length || findBox.Value != st.FindText
            return doFind()
        st.FoundPos := Mod(st.FoundPos, st.Found.Length) + 1
        findInfo.Text := st.FoundPos . " of " . st.Found.Length
        item := reveal(call("chain", Map("id", st.Found[st.FoundPos])))
        if item {
            tv.Modify(item, "Select Vis")
            showNode(item, true)
        }
    }
    doPick() {
        hidden := []
        for w in [dlg, owner, VMB().Gui]
            if IsObject(w) && DllCall("IsWindowVisible", "Ptr", w.Hwnd, "Int") {
                w.Hide()
                hidden.Push(w)
            }
        found := false
        try found := V4_Pick()
        finally {
            loop hidden.Length
                hidden[hidden.Length - A_Index + 1].Show()
        }
        if found is Map && found.Has("selector")
            openTree(found["selector"], found.Get("frame", ""), 0)
    }
    doUse() {
        sel := Trim(selBox.Value)
        if sel = ""
            return say("Enter or choose a CSS selector first.", "C00000")
        idx := IsInteger(idxBox.Value) ? Integer(idxBox.Value) : 0
        res := testNow(false)
        count := res.Get("count", 0)
        problem := res.Get("error", "") != "" ? res["error"]
            : count = 0 ? "It matches nothing on the page right now."
            : idx = 0 && count > 1 ? "It matches " . count . " elements and the match index is 0, so the step would stop as ambiguous."
            : idx > count ? "The match index is higher than the number of matches."
            : ""
        if problem != "" && MsgBox(problem . "`n`nUse this target anyway?", "Element tree", "YesNo Icon! Owner" . hwnd) != "Yes"
            return
        st.Result := Map("selector", sel, "frame", Trim(frameBox.Value), "index", idx)
        dlg.Destroy()
    }
    onEnter() {
        try focused := dlg.FocusedCtrl
        catch
            focused := 0
        if focused = findBox
            return doNext()
        testNow(false)
    }
    onExpand(ctl, item, expanded) {
        if expanded && st.Dummies.Has(item)
            guard(() => loadKids(item))
    }
    onSelect(ctl, item) {
        if item && item != st.Shown
            guard(() => showNode(item, true))
    }
    onCand(ctl, row) {
        if row
            guard(() => useCand(row))
    }
    onCheck(ctl, item, checked) => guard(fromParts)
    onLight(ctl, *) {
        if !ctl.Value
            guard(() => call("clear"))
        else if st.Target >= 0
            guard(() => call("highlight", Map("ids", [st.Target], "scroll", JSON.True)))
    }
    ; Typing in the selector / frame / index boxes re-tests shortly after the last key.
    retest() {
        if !DllCall("IsWindow", "Ptr", hwnd, "Int")
            return
        if st.Busy
            return SetTimer(retest, -400)
        if selBox.Value . "`n" . frameBox.Value . "`n" . idxBox.Value != st.LastKey
            guard(() => testNow(false))
    }
    later(*) => SetTimer(retest, -600)
    findBtn.OnEvent("Click", guard.Bind(doFind))
    nextBtn.OnEvent("Click", guard.Bind(doNext))
    reloadBtn.OnEvent("Click", guard.Bind(() => openTree(Trim(selBox.Value), Trim(frameBox.Value),
        IsInteger(idxBox.Value) ? Integer(idxBox.Value) : 0)))
    pickBtn.OnEvent("Click", guard.Bind(doPick))
    lightBox.OnEvent("Click", onLight)
    tv.OnEvent("ItemExpand", onExpand)
    tv.OnEvent("ItemSelect", onSelect)
    cands.OnEvent("Click", onCand)
    parts.OnEvent("ItemCheck", onCheck)
    testBtn.OnEvent("Click", guard.Bind(() => testNow(false)))
    showBtn.OnEvent("Click", guard.Bind(() => call("highlight", Map("ids", st.LastIds, "scroll", JSON.True))))
    useBtn.OnEvent("Click", guard.Bind(doUse))
    enterBtn.OnEvent("Click", guard.Bind(onEnter))
    for ctl in [selBox, frameBox, idxBox]
        ctl.OnEvent("Change", later)
    cancelBtn.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    dlg.OnEvent("Close", (*) => dlg.Destroy())

    startIdx := init.Get("index", 0)
    if owner
        owner.Opt("+Disabled")
    try {
        dlg.Show("w1180 h664")
        guard(() => openTree(Trim(init.Get("selector", "")), Trim(init.Get("frame", "")),
            IsInteger(startIdx) ? Max(0, Integer(startIdx)) : 0))
        WinWaitClose("ahk_id " . hwnd)
    } finally {
        SetTimer(retest, 0)
        if owner
            owner.Opt("-Disabled")
        try V6_TreeCall("dispose")
    }
    return st.Result
}

; @summary Run bar "Element tree" button: while paused (or failed) at a web step, opens the tree on that step's target
;          and writes the chosen selector / iframe path / match index back into the step. The step keys belong to the
;          tree window until it closes; Down then runs the step again with the new target.
; @tags web, cdp, debug, gui
V6_FixTargetFromBar(bar) {
    d := V5_Dbg()
    node := bar.Node, runner := bar.Runner
    if d.Editing || !d.Waiting || !(node is Map) || !node.Has("selector") || !IsObject(runner)
        return
    d.Editing := true
    try {
        init := Map("selector", runner.Expand(node.Get("selector", "")), "frame", runner.Expand(node.Get("frame", "")),
            "index", node.Get("index", 0))
        picked := V6_ElementTree(init, {OnTop: true, Title: V5_NodeTitle(runner, node)})
        if picked is Map {
            hadVars := InStr(node.Get("selector", "") . node.Get("frame", ""), "{{")
            node["selector"] := picked["selector"], node["frame"] := picked["frame"], node["index"] := picked["index"]
            runner.Changed := true
            bar.Next.Text := V5_NodeTitle(runner, node)
            bar.Note("New target saved in this step" . (hadVars ? " (it replaced a selector that used {{variables}})" : "")
                . ".`nDown = run it with the new target,  Right = skip it,  F5 = run on.")
        }
    } catch as err
        bar.Note(err.Message, true)
    finally d.Editing := false
}

