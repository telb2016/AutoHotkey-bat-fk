        check("V21 web new tab line", V20_StepLine(V4_CreateNode("web_newtab")), "Web: open a new empty tab")
        check("V21 web back / forward / reload / close / disconnect lines", V20_StepLine(V4_CreateNode("web_back")) . "|" . V20_StepLine(V4_CreateNode("web_forward"))
            . "|" . V20_StepLine(V4_CreateNode("web_reload")) . "|" . V20_StepLine(V4_CreateNode("web_close")) . "|" . V20_StepLine(V4_CreateNode("web_disconnect")),
            "Web: go back a page|Web: go forward a page|Web: reload the page|Web: close the tab|Web: let go of the browser (it stays open)")
        v21N := V4_CreateNode("web_select"), v21N["selector"] := "#state", v21N["value"] := "Ohio"
        check("V21 web select line", V20_StepLine(v21N), 'Web: pick "Ohio" in "state"')
        v21N := V4_CreateNode("web_check"), v21N["selector"] := '[name="agree"]'
        check("V21 web tick line", V20_StepLine(v21N), "Web: tick agree")
        v21N := V4_CreateNode("web_read"), v21N["selector"] := "#total"
        check("V21 web read line", V20_StepLine(v21N), 'Web: read the text of "total", remember it as result')
        v21N := V4_CreateNode("web_count"), v21N["selector"] := "tr.row"
        check("V21 web count line", V20_StepLine(v21N), "Web: count how many tr.row there are, remember it as count")
        v21N := V4_CreateNode("web_exists"), v21N["selector"] := "#error"
        check("V21 web exists line", V20_StepLine(v21N), 'Web: check whether "error" is there, remember it as exists')
        v21N := V4_CreateNode("web_focus"), v21N["selector"] := "#q"
        check("V21 web focus line", V20_StepLine(v21N), 'Web: put the cursor in "q"')
        v21N := V4_CreateNode("web_scroll"), v21N["selector"] := "#footer", v21N["frame"] := "iframe#main"
        check("V21 web scroll line inside a frame", V20_StepLine(v21N), 'Web: scroll "footer" into view  (inside frame iframe#main)')
        check("V21 web keys line", V20_StepLine(V4_CreateNode("web_keys")), "Web: press Enter")
        check("V21 web screenshot line", V20_StepLine(V4_CreateNode("web_screenshot")), "Web: save a picture of the page as browser-V4.png")
        check("V21 web script line", V20_StepLine(V4_CreateNode("web_eval")), 'Web: run the script "document.title", remember it as result')
        check("V21 web command line", V20_StepLine(V4_CreateNode("web_cdp")), "Web: send the browser command Runtime.evaluate, remember it as cdp")
        v21N := V4_CreateNode("input_send"), v21N["value"] := "^a"
        check("V21 send keys line", V20_StepLine(v21N), "Send keys: Ctrl+A (select all)")
        v21N["ask"] := 1
        check("V21 asked send keys never shows the keys", V20_StepLine(v21N), "Send keys: what you answer when asked (each run)")
        check("V21 SendInput / SendEvent lines", V20_StepLine(V4_CreateNode("input_sendinput")) . "|" . V20_StepLine(V4_CreateNode("input_sendevent")),
            "Send keys: Enter (OK / submit / new line)|Send keys: Enter (OK / submit / new line)")
        check("V21 SendText line", V20_StepLine(V4_CreateNode("input_sendtext")), 'Type "Hello"')
        v21N := V4_CreateNode("input_keydown"), v21N["key"] := "Shift"
        check("V21 hold key line", V20_StepLine(v21N), "Hold Shift down")
        v21N := V4_CreateNode("input_keyup"), v21N["key"] := "Shift"
        check("V21 let go of key line", V20_StepLine(v21N), "Let go of Shift")
        check("V21 settings blocks keep their older line", V20_StepLine(V4_CreateNode("input_keydelay")) . V20_StepLine(V4_CreateNode("input_sendmode")), "")
        check("V21 wait settled line", V20_StepLine(V4_CreateNode("det_wait_settled")), "Wait until the area (165, 95)–(660, 190) stops changing")
        check("V21 wait pixel line", V20_StepLine(V4_CreateNode("det_wait_pixel")), "Wait until the dot at (300, 76) is yellow (the active box)")
        v21N := V4_CreateNode("det_wait_pixel"), v21N["colorMode"] := "NearHex", v21N["appear"] := 0
        check("V21 wait pixel gone line", V20_StepLine(v21N), "Wait until the dot at (300, 76) is no longer close to #FFFF80")
        check("V21 anchor click line", V20_StepLine(V4_CreateNode("det_anchor_click")), "Click 41 px left and 60 px up from the bottom centre of the window")
        v21N := V4_CreateNode("det_anchor_click"), v21N["anchor"] := "ProportionalPct", v21N["button"] := "Right"
        check("V21 anchor click by percent line", V20_StepLine(v21N), "Right-click at 50% across and 50% down the window")
        check("V21 human click line", V20_StepLine(V4_CreateNode("det_human_click")), "Click at (300, 200) with a human-like move")
        check("V21 predict row line", V20_StepLine(V4_CreateNode("det_predict_row")), 'Pick "{{Product}}" in the list (row is worked out)')
        check("V21 unknown kind keeps the older line", V20_StepLine(Map("type", "mystery")), "")
        v21Body := [Map("type", "delay", "ms", 1), Map("type", "delay", "ms", 2), Map("type", "repeat", "count", 2,
            "body", [Map("type", "delay", "ms", 3)])]
        check("V21 repeat row", V21_BlockLine(Map("type", "repeat", "count", 5, "body", v21Body)), "Repeat 5 times  (4 steps inside)")
        check("V21 empty repeat row", V21_BlockLine(Map("type", "repeat", "count", 1, "body", [])), "Repeat 1 time  (no steps inside yet)")
        check("V21 for each row", V21_BlockLine(Map("type", "foreach", "body", v21Body)), "For each row of the list  (4 steps inside)")
        check("V21 count row", V21_BlockLine(Map("type", "for", "name", "i", "from", 1, "to", 10, "step", 1, "body", v21Body)),
            "Count i from 1 to 10  (4 steps inside)")
        check("V21 count row in steps of 2", V21_BlockLine(Map("type", "for", "name", "i", "from", 1, "to", 10, "step", 2, "body", [v21Body[1]])),
            "Count i from 1 to 10 in steps of 2  (1 step inside)")
        check("V21 repeat until row", V21_BlockLine(Map("type", "until", "cond", "var", "name", "count", "op", ">=", "value", 3, "max", 100, "body", [])),
            "Repeat until count is at least 3  (at most 100 times)")
        check("V21 do ... until row", V21_BlockLine(Map("type", "until", "cond", "image", "appear", 1, "check", "after", "max", 20, "body", [])),
            "Repeat until image appears, checked after each round  (at most 20 times)")
        check("V21 if rows", V21_BlockLine(Map("type", "if", "cond", "var", "name", "amount", "op", "=", "value", 250, "body", [], "else", []))
            . "|" . V21_BlockLine(Map("type", "if", "cond", "image", "appear", 0, "body", [], "else", [])),
            "If amount is 250|If image is absent")
        check("V21 conditions in words", V21_CondText(Map("cond", "var", "name", "a", "op", "!=", "value", 1)) . "|"
            . V21_CondText(Map("cond", "var", "name", "a", "op", "contains", "value", "x")) . "|" . V21_CondText(Map("cond", "var", "name", "a", "op", "empty"))
            . "|" . V21_CondText(Map("cond", "var", "name", "a", "op", "notempty")) . "|" . V21_CondText(Map("cond", "var", "name", "a", "op", "<", "value", 2)),
            "a is not 1|a contains x|a is empty|a is not empty|a is less than 2")
        check("V21 web condition reuses the old text", V21_CondText(V4_CreateNode("web_if")), VMF__CondText(V4_CreateNode("web_if")))
        check("V21 set rows", V21_BlockLine(Map("type", "set", "name", "amount", "value", "250")) . "|"
            . V21_BlockLine(Map("type", "set", "name", "amount", "value", "250", "ask", 1)), 'Remember "250" as amount|Ask me for amount (suggests "250")')
        check("V21 change rows", V21_BlockLine(Map("type", "change", "name", "count", "by", 1)) . "|" . V21_BlockLine(Map("type", "change", "name", "count", "by", -2)),
            "Add 1 to count|Take 2 from count")
        check("V21 ask row", V21_BlockLine(Map("type", "ask", "prompt", "Check the screen. Continue?")), "Ask me: Check the screen. Continue?")
        check("V21 stop rows", V21_BlockLine(Map("type", "stop", "action", "break")) . "|" . V21_BlockLine(Map("type", "stop", "action", "continue"))
            . "|" . V21_BlockLine(Map("type", "stop", "action", "nextrow")) . "|" . V21_BlockLine(Map("type", "stop", "action", "endrun"))
            . "|" . V21_BlockLine(Map("type", "stop", "action", "stop")),
            "Leave the loop|Go on with the next round of the loop|Skip this data row (it counts as failed)|End the run here (it counts as done)|Stop the run")
        check("V21 run macro row", V21_BlockLine(Map("type", "call", "path", "C:\macros\orders.vmacro.json")), "Run the macro orders.vmacro.json")
        check("V21 note kept on block rows", V21_BlockLine(Map("type", "repeat", "count", 2, "body", [], "note", "twice")), "Repeat 2 times  (no steps inside yet)  // twice")
        check("V21 other blocks keep the older text", V21_BlockLine(Map("type", "ndc", "name", "ndc", "source", "")), VMF_BlockText(Map("type", "ndc", "name", "ndc", "source", "")))
        v21Notes := V21_NoteSteps(["Step #7 (notepad.exe) stayed 900x600 instead of 950x712 (it has a size limit). Kept going.",
            "Step #3: could not scroll the list back to where it was (Edit). Clicked anyway.", "Step #7: a second note",
            "Playback was slow", "step #2 written in lower case", "Step #12: last one"])
        check("V21 notes by step number", v21Notes.Count . "|" . v21Notes.Has(7) . v21Notes.Has(3) . v21Notes.Has(12) . v21Notes.Has(2)
            . "|" . SubStr(v21Notes[7], 1, 23), "3|1110|Step #7 (notepad.exe) s")
        check("V21 no notes", V21_NoteSteps([]).Count . V21_NoteSteps("").Count, "00")
        check("V21 note tag drops the step number", V21_NoteTag("Step #3: could not scroll the list back.") . "|"
            . V21_NoteTag("Step #7 (notepad.exe) stayed small."), "   ⚠ last run: could not scroll the list back.|   ⚠ last run: (notepad.exe) stayed small.")
        check("V21 note tag shortened to 70", StrLen(V21_NoteTag("Step #1: " . StrReplace(Format("{:100}", ""), " ", "x"))), StrLen("   ⚠ last run: ") + 70)
        v21Screens := [[0, 0, 1920, 1080], [-1280, 0, 0, 1024]]
        check("V21 a spot on the main screen", V21_OnAnyScreen(8, 8, v21Screens), true)
        check("V21 a spot on a second screen to the left", V21_OnAnyScreen(-500, 100, v21Screens), true)
        check("V21 a spot off every screen", V21_OnAnyScreen(3008, 8, v21Screens) . V21_OnAnyScreen(100, 1100, v21Screens) . V21_OnAnyScreen(-1300, 8, v21Screens), "000")
        check("V21 right and bottom edges are off the screen", V21_OnAnyScreen(1920, 5, [[0, 0, 1920, 1080]]) . V21_OnAnyScreen(5, 1080, [[0, 0, 1920, 1080]]), "00")
        check("V21 no screens", V21_OnAnyScreen(8, 8, []), false)
        check("V22 pad short / exact / too long / empty", V22_Pad("ab", 5) . "|" . V22_Pad("abcde", 5) . "|" . V22_Pad("abcdefgh", 5) . "|" . V22_Pad("", 3) . "|",
            "ab   |abcde|abcd…|   |")
        v22Set := Map("defaultTarget", "ahk_class Notepad ahk_exe notepad.exe")
        check("V22 program of a recorded step", V22_AppOf(Map("type", "click", "win", Map("exe", "msedge.exe"))), "msedge")
        check("V22 program of Use Window", V22_AppOf(Map("type", "det_use_window", "target", "ahk_exe calc.exe"), v22Set) . "|"
            . V22_AppOf(Map("type", "det_use_window", "target", ""), v22Set), "calc|notepad")
        check("V22 program of Normalize / input steps", V22_AppOf(Map("type", "det_normalize_win", "target", ""), v22Set) . "|"
            . V22_AppOf(Map("type", "input_send", "target", "ahk_exe wfica32.exe"), v22Set) . "|" . V22_AppOf(Map("type", "det_normalize_win", "target", "")), "notepad|wfica32|")
        check("V22 program of web and delay steps", V22_AppOf(Map("type", "web_click", "selector", "#a")) . "|" . V22_AppOf(Map("type", "delay", "ms", 5), v22Set), "web page|")
        v22A := Map("exe", "notepad.exe"), v22B := Map("exe", "calc.exe")
        v22S := [Map("type", "click", "win", v22A), Map("type", "keys", "win", v22A), Map("type", "click", "win", v22B),
            Map("type", "text", "win", v22B), Map("type", "keys", "win", Map("exe", "NOTEPAD.EXE"))]
        v22R := V22_FillApps(v22S)
        check("V22 fill A A B B A", v22R.App[v22S[1]] . "," . v22R.App[v22S[2]] . "," . v22R.App[v22S[3]] . "," . v22R.App[v22S[4]] . "," . v22R.App[v22S[5]],
            "notepad,notepad,calc,calc,notepad")
        check("V22.1 program names in lower case, web page unchanged", V22_AppOf(Map("type", "click", "win", Map("exe", "NOTEPAD.EXE"))) . "|"
            . V22_AppOf(Map("type", "det_use_window", "target", "ahk_exe CALC.EXE")) . "|" . V22_AppOf(Map("type", "web_click", "selector", "#a")), "notepad|calc|web page")
        check("V22 starts A A B B A", v22R.Starts.Has(v22S[1]) . v22R.Starts.Has(v22S[2]) . v22R.Starts.Has(v22S[3]) . v22R.Starts.Has(v22S[4]) . v22R.Starts.Has(v22S[5]), "10101")
        v22S := [Map("type", "click", "win", v22A), Map("type", "delay", "ms", 500), Map("type", "repeat", "count", 2, "body", []), Map("type", "keys", "win", v22A)]
        v22R := V22_FillApps(v22S)
        check("V22 a Delay takes the program before it", v22R.App[v22S[2]] . "|" . v22R.Starts.Has(v22S[2]) . v22R.Starts.Has(v22S[4]) . "|" . v22R.App.Has(v22S[3]) . "|" . v22R.App.Count,
            "notepad|00|0|3")
        v22S := [Map("type", "delay", "ms", 1), Map("type", "delay", "ms", 2)]
        v22R := V22_FillApps(v22S)
        check("V22 no program at all", v22R.App[v22S[1]] . v22R.App[v22S[2]] . "|" . v22R.Starts.Count, "|1")
        check("V22 waits: fixed / recorded / small gap", V22_WaitText(Map("delayMs", 500, "gapMs", 3000)) . "|" . V22_WaitText(Map("gapMs", 2440)) . "|"
            . V22_WaitText(Map("gapMs", 120)) . "|" . V22_WaitText(Map()), "500 ms*|2.4 s||")
        check("V22 marks: none", V22_Marks(Map("type", "click")), "")
        check("V22 marks: all five in order", V22_Marks(Map("type", "click", "note", "x", "winMatch", "active", "varyDX", 5, "scroll", Map("v", 1)), "Step #1: x"), "↕⚡◇✎⚠")
        check("V22 marks: order kept with some", V22_Marks(Map("type", "click", "note", "x", "scroll", Map("v", 1))), "↕✎")
        v22R0 := V22_Row(1, "notepad", true, "", "", "Click", 0, 3), v22R1 := V22_Row(12, "notepad", true, "2.4 s", "↕", "Type", 1, 3)
        v22R2 := V22_Row(7, "calc", false, "", "", "Press", 2, 3)
        check("V22 Program column lines up at depth 0, 1 and 2", (InStr(v22R0, "notepad") + 0 * 3) . "," . (InStr(v22R1, "notepad") + 1 * 3) . "," . (InStr(v22R2, "calc") + 2 * 3), "31,31,31")
        check("V22 row text", v22R0 . "|" . SubStr(v22R1, 22), Format("{:24}", "") . "1     notepad                          Click|12  ► notepad        2.4 s     ↕       Type")
        check("V22 header starts Program at the same place", InStr(V22_Header(3), "Program") . "|" . SubStr(V22_Header(3), 25),
            "31|#     Program        Waits     Marks   What it does")
        check("V22 rows deeper than 8 levels keep no margin", InStr(V22_Row(3, "x", false, "", "", "", 9, 3), "3"), 1)
        check("V22 sentence: no older form needed / older form / note and last run", V22_Sentence(Map("type", "delay", "ms", 500)) . "|"
            . V22_Sentence(Map("type", "input_keydelay", "delay", 30, "duration", 30)) . "|"
            . V22_Sentence(Map("type", "delay", "ms", 500, "note", "wait"), "Step #3: slow"),
            "Wait 500 ms|" . VM_StepSummary(Map("type", "input_keydelay", "delay", 30, "duration", 30))[1] . "   " . VM_StepSummary(Map("type", "input_keydelay", "delay", 30, "duration", 30))[3]
            . "|Wait 500 ms   // wait   ⚠ last run: slow")
        v22M := V22_MarkChars(0), v22P := V22_MarkChars(1)
        check("V22 mark characters: symbols and plain", v22M["scroll"] . v22M["vary"] . v22M["active"] . v22M["note"] . v22M["warn"] . v22M["start"] . "|"
            . v22P["scroll"] . v22P["vary"] . v22P["active"] . v22P["note"] . v22P["warn"] . v22P["start"], "↕⚡◇✎⚠►|SVAN!>")
        check("V22 marks come from the mark characters", V22_Marks(Map("type", "click", "note", "x"), "Step #1: y"), V22_MarkChars()["note"] . V22_MarkChars()["warn"])
        check("V22 no editor: the program stays in the sentence", V20_StepSentence(Map("type", "keys", "keys", "{Enter}", "win", Map("exe", "notepad.exe"))),
            "Press Enter (OK / submit / new line) in notepad")
        check("V22 detail: plain step (no number, no program)", V22_Detail(Map("type", "delay", "ms", 500), "", ""), "Wait 500 ms")
        check("V22 detail: number and program", V22_Detail(Map("type", "keys", "keys", "{Enter}"), "notepad", "", 4),
            "Step 4 · notepad · Press Enter (OK / submit / new line)")
        check("V22 detail: recorded pause", V22_Detail(Map("type", "keys", "keys", "{Enter}", "gapMs", 3200), "notepad", "", 6),
            "Step 6 · notepad · waits 3.2 s first · Press Enter (OK / submit / new line)")
        check("V22 detail: every part", V22_Detail(Map("type", "keys", "keys", "{Enter}", "delayMs", 400, "scroll", Map("v", 1), "varyDX", 5,
            "winMatch", "active", "note", "check it"), "notepad", "Step #6: slow", 6),
            "Step 6 · notepad · waits 400 ms first (set by hand) · Press Enter (OK / submit / new line) · list is scrolled back first · varies: +5px X / round · whatever window is active · note: check it · last run: slow")
        player := V4_PlayerSource(source, macro)
        check("One-file player contains embedded macro", InStr(player, 'text .= "') > 0)
        check("No active #Include directives", !RegExMatch(player, "m)^#Include"))
    } catch as err {
        failures += 1
        rows.Push("FAIL | Unexpected exception: " . err.Message . " | " . err.What . " | line " . err.Line)
    }
    report := "Visual Macro Blocks V18 self-test`r`nAutoHotkey " . A_AhkVersion . " | pointer size " . A_PtrSize
        . "`r`n" . V4_Join(rows, "`r`n") . "`r`nFailures: " . failures . "`r`n"
    V4_Write(path, report)
    try FileAppend(report, "*", "UTF-8")
    ExitApp(failures ? 1 : 0)
}
