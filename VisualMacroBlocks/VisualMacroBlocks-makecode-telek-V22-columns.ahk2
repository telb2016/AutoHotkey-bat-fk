        check("V20 plain click line", V20_StepLine(v20C), "Click in notepad — top-left (40, 20)")
        v20C["what"] := Map("kind", "button", "text", "OK")
        check("V20 click on a button names it", V20_StepLine(v20C), 'Click the "OK" button in notepad — top-left (40, 20)')
        v20C["what"] := Map("kind", "text box"), v20C["count"] := 2, v20C["mods"] := "^"
        check("V20 Ctrl+double-click in a text box", V20_StepLine(v20C), "Ctrl+double-click a text box in notepad — top-left (40, 20)")
        v20C["what"] := Map("kind", "menu item", "text", "Save As..."), v20C["count"] := 1, v20C["mods"] := "", v20C["button"] := "Right"
        check("V20 right-click a menu item", V20_StepLine(v20C), 'Right-click menu item "Save As..." in notepad — top-left (40, 20)')
        v20C["what"] := Map("kind", "Close button (X)"), v20C["button"] := "Left"
        check("V20 click on the Close button", V20_StepLine(v20C), "Click the Close button (X) in notepad — top-left (40, 20)")
        v20C.Delete("what"), v20C["scroll"] := Map("cls", "Edit", "v", 150), v20C["gapMs"] := 2440, v20C["note"] := "pick the patient"
        check("V20 tags: long pause, scroll, note", V20_StepLine(v20C),
            "Click in notepad — top-left (40, 20)   ⏱ after a 2.4 s pause   ↕ list scrolled back first   // pick the patient")
        v20C["delayMs"] := 500
        check("V20 a fixed wait wins over the recorded pause", InStr(V20_StepLine(v20C), "⏱ waits 500 ms first") > 0 && !InStr(V20_StepLine(v20C), "pause"))
        check("V20 old click without window spot", V20_StepLine(Map("type", "click", "find", "spot", "scrX", 5, "scrY", 6)), "Click — screen spot (5, 6)")
        check("V20 picture click", V20_StepLine(Map("type", "click", "win", v20Win)), "Click in notepad — wherever the saved picture is found")
        check("V20 drag line", V20_StepLine(Map("type", "drag", "find", "spot", "win", v20Win, "geo", v20Geo, "dx", 50, "dy", -10)),
            "Drag in notepad — top-left (40, 20), 50 right, 10 up")
