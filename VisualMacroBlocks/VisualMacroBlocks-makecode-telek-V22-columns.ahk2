    if (cl.length) props.push(["class", cl.join(" ")]);
    for (const at of Array.from(el.attributes))
        if (!["id", "class", "style", "value"].includes(at.name) && !/^on/i.test(at.name)) props.push([at.name, short(at.value, 200)]);
    if (!/^(HTML|HEAD|BODY)$/i.test(el.tagName) && !/^(SCRIPT|STYLE)$/i.test(el.tagName)) {
        const txt = short(el.textContent, 200);
        if (txt) props.push(["text", txt]);
    }
    const r = el.getBoundingClientRect();
    props.push(["visible", visible(el) ? "yes" : "no"]);
    props.push(["size / position", Math.round(r.width) + " x " + Math.round(r.height) + "   at   " + Math.round(r.left) + ", " + Math.round(r.top)]);
    if (frame) props.push(["iframe path", frame]);
    if (prefix) props.push(["inside the shadow root of", prefix.replace(/ >>> $/, "")]);
    if (!el.isConnected) props.push(["note", "this element was removed from the page"]);
    const locals = [], seen = new Set();
    const add = s => { if (s && !seen.has(s)) { seen.add(s); locals.push(s); } };
    if (el.id) add("#" + E(el.id));
    for (const at of ["data-testid", "data-test", "data-qa", "data-cy", "name", "aria-label", "placeholder", "title", "alt", "for", "href", "role", "type"]) {
        const v = el.getAttribute(at);
        if (v && v.length < 150) add(tag + "[" + at + '="' + E(v) + '"]');
    }
    const ec = cl.map(E);
    if (ec.length) { add(tag + "." + ec[0]); if (ec.length > 1) add(tag + "." + ec.slice(0, 2).join(".")); add(tag + "." + ec.join(".")); }
    add(localSelector(el));
    const base = el.id ? "#" + E(el.id) : ec.length ? tag + "." + ec[0] : tag;
    for (let p = el.parentElement; p; p = p.parentElement)
        if (p.id && unique(rt, "#" + E(p.id))) { add("#" + E(p.id) + " " + base); break; }
    if (el.parentElement) add(compact(el.parentElement) + " > " + base);
    add(tag);
    const cands = [];
    for (const l of locals) {
        let found;
        try { found = query(doc, prefix + l); } catch (_) { continue; }
        const pos = found.indexOf(el) + 1;
        if (pos) cands.push({selector: prefix + l, count: found.length, pos: pos});
    }
    cands.sort((x, y) => (x.count === 1 ? 0 : x.count) - (y.count === 1 ? 0 : y.count));
    const parts = [{group: "tag", label: "tag     " + tag, css: tag}];
    if (el.id) parts.push({group: "id", label: "id     #" + el.id, css: "#" + E(el.id)});
    for (const c of cl) parts.push({group: "class", label: "class     ." + c, css: "." + E(c)});
    for (const at of Array.from(el.attributes)) {
        if (["id", "class", "style", "value"].includes(at.name) || /^on/i.test(at.name) || at.value.length > 150) continue;
        parts.push({group: "attr", label: at.name + (at.value === "" ? "     (present)" : '     = "' + short(at.value, 70) + '"'),
            css: "[" + E(at.name) + (at.value === "" ? "" : '="' + E(at.value) + '"') + "]"});
    }
    const par = el.parentElement;
    if (par) {
        const peers = Array.from(par.children).filter(e => e.localName === tag);
        if (peers.length > 1) {
            const k = peers.indexOf(el) + 1;
            parts.push({group: "position", label: "position     :nth-of-type(" + k + ")     (" + tag + " number " + k + " of " + peers.length + " here)",
                css: ":nth-of-type(" + k + ")"});
        }
        parts.push({group: "parent", label: "directly inside     " + compact(par) + "  >", css: compact(par) + " > "});
        for (let p = par.parentElement; p; p = p.parentElement) {
            if (p.id && unique(rt, "#" + E(p.id))) {
                parts.push({group: "inside", label: "somewhere inside     #" + p.id, css: "#" + E(p.id) + " "});
                break;
            }
            const tid = p.getAttribute("data-testid");
            if (tid && unique(rt, '[data-testid="' + E(tid) + '"]')) {
                parts.push({group: "inside", label: 'somewhere inside     [data-testid="' + tid + '"]', css: '[data-testid="' + E(tid) + '"] '});
                break;
            }
        }
    }
    return {element: true, label: info(el).label, props: props, cands: cands, parts: parts, prefix: prefix, frame: frame, tag: tag};
}
if (a.cmd === "find") {
    const needle = String(a.text || "").toLowerCase().trim(), ids = [];
    let total = 0;
    if (!needle) return {ids: ids, total: 0};
    const walk = root => {
        for (const el of Array.from(root.querySelectorAll("*"))) {
            const hay = [el.localName, el.id, el.getAttribute("class"), el.getAttribute("name"), el.getAttribute("aria-label"),
                el.getAttribute("placeholder"), el.getAttribute("title"), el.getAttribute("data-testid"), el.getAttribute("href"),
                el.getAttribute("role"), ownText(el)].join(" ").toLowerCase();
            if (hay.includes(needle)) { total++; if (ids.length < 300) ids.push(reg(el)); }
            if (el.shadowRoot) walk(el.shadowRoot);
            const fd = frameDoc(el);
            if (fd) walk(fd);
        }
    };
    walk(document);
    return {ids: ids, total: total};
}
if (a.cmd === "highlight") {
    api.clear();
    let first = null;
    const done = new Set();
    for (const id of (a.ids || []).slice(0, 60)) {
        const el = api.nodes[Number(id)];
        if (!isEl(el) || !el.style || done.has(el)) continue;
        done.add(el);
        api.lit.push([el, el.style.outline, el.style.outlineOffset]);
        el.style.outline = first ? "2px dashed #ff00aa" : "3px solid #ff00aa";
        el.style.outlineOffset = "2px";
        if (!first) first = el;
    }
    if (first && a.scroll) {
        try {
            for (let d = first.ownerDocument; d && d !== document; ) {
                const fe = d.defaultView.frameElement;
                if (!fe) break;
                fe.scrollIntoView({block: "nearest", inline: "nearest"});
                d = fe.ownerDocument;
            }
            first.scrollIntoView({block: "nearest", inline: "nearest"});
        } catch (_) {}
    }
    return api.lit.length;
}
if (a.cmd === "clear") { api.clear(); return true; }
throw new Error("Unknown element tree command: " + a.cmd);
}
)"
}


; ============================================================================
; V7 APPLE-INSPIRED UX, ADHD WORKING-MEMORY HUB & PROTOTYPING HUD
; ============================================================================

; @summary Shows and activates the main Visual Macro Blocks editor window.
; @tags macro, gui, v7
V7_ShowMainGui(*) {
    s := VMB()
    if !s.Gui
        return
    s.Gui.Show()
    WinActivate("ahk_id " . s.Gui.Hwnd)
    V7_RefreshMemoryBar()
    V7_SyncIdleHud()
}

; @summary Ctrl+Shift+M: brings back the main window when hidden/inactive, or opens the "Where Was I?" Memory Hub when already active.
; @tags macro, gui, hotkey, v7
V7_ShowOrHub(*) {
    s := VMB()
    if !s.Gui
        return
    if !DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int") || !WinActive("ahk_id " . s.Gui.Hwnd)
        V7_ShowMainGui()
    else
        V7_MemoryHub()
}

; @summary Schedules a debounced background auto-save (1.5 s after the last edit) so work is never lost.
; @tags macro, file, autosave, v7
V7_ScheduleAutoSave() {
    SetTimer(V7_AutoSaveNow, -1500)
}

; @summary Saves a draft copy silently (and saves to the current file if Auto-save is checked and no privacy warning triggers).
; @tags macro, file, autosave, v7
V7_AutoSaveNow(*) {
    s := VMB()
    if !s.Gui || !(s.Macro is Map) || VM_IsRecording() || VM_IsPlaying()
        return
    try VMB_ControlsToSettings()
    try {
        if s.AutoSavePath != "" && s.Macro["blocks"].Length
            VM_Save(s.Macro, s.AutoSavePath)
    }
    if s.Ctl.Has("AutoSave") && s.Ctl["AutoSave"].Value && s.Path != "" && s.Dirty {
        if !VM_Validate(s.Macro).Length && !V7_HasPrivacyFindings(s.Macro) {
            try {
                VM_Save(s.Macro, s.Path)
                s.Dirty := false
                s.LastSavedAt := FormatTime(, "HH:mm:ss")
                VMB_UpdateTitle()
            }
        }
    }
    V7_RefreshMemoryBar()
}

; @summary Non-interactive check for whether the macro has potential PHI findings (so auto-save never pops a modal).
; @tags macro, privacy, v7
V7_HasPrivacyFindings(macro) {
    setText := []
    VMB__CollectSetValues(macro["blocks"], setText)
    if setText.Length && VM_PrivacyScan(Map("steps", setText)).Length
        return true
    return VM_PrivacyScan(Map("steps", VMF_Flatten(macro["blocks"]))).Length > 0
}

; @summary Loads the macro's saved Goal / Next-Step note into the top "Where Was I:" bar.
; @tags macro, adhd, memory, v7
V7_LoadMemoryBar() {
    s := VMB()
    if !s.Ctl.Has("GoalNote")
        return
    note := ""
    if s.Macro is Map && s.Macro.Get("settings", "") is Map
        note := s.Macro["settings"].Get("goalNote", "")
    if note = "" && s.Ini != ""
        note := IniRead(s.Ini, "V7", "LastGoalNote", "")
    s.Ctl["GoalNote"].Value := note
    V7_RefreshMemoryBar()
}

; @summary Updates the Goal / Next-Step note when typed in the "Where Was I:" bar.
; @tags macro, adhd, memory, v7
V7_OnGoalChanged(ctl, *) {
    s := VMB()
    if !(s.Macro is Map) || !(s.Macro.Get("settings", "") is Map)
        return
    val := Trim(ctl.Value)
    if s.Macro["settings"].Get("goalNote", "") == val
        return
    VM__SetOrDelete(s.Macro["settings"], "goalNote", val)
    if s.Ini != ""
        try IniWrite(StrReplace(val, "`n", " "), s.Ini, "V7", "LastGoalNote")
    s.Dirty := true
    V7_ScheduleAutoSave()
    V7_SyncIdleHud()
}

; @summary Updates the right-hand summary in the "Where Was I:" bar with script name, pinned app, and last save time.
; @tags macro, adhd, memory, v7
V7_RefreshMemoryBar() {
    s := VMB()
    if !s.Ctl.Has("WhereInfo")
        return
    pins := V7_GetRecent("PinnedContext")
    pinLabel := pins.Length ? pins[1] : "(no app pinned)"
    if InStr(pinLabel, "|") {
        parts := StrSplit(pinLabel, "|")
        pinLabel := parts[1] . (parts.Length >= 2 && parts[2] != "" ? " (" . SubStr(parts[2], 1, 26) . ")" : "")
    }
    savedInfo := s.LastSavedAt != "" ? "Saved " . s.LastSavedAt : (s.Path != "" ? "File ready" : "Draft auto-saved")
    s.Ctl["WhereInfo"].Value := savedInfo . "  •  Pinned: " . pinLabel . "  •  Script: " . A_ScriptName
}

; @summary Stores a recent item (up to 10 unique entries, newest first) in the V7 INI under key.
; @tags macro, adhd, memory, v7
V7_AddRecent(key, value) {
    s := VMB()
    value := Trim(String(value))
    if value = "" || s.Ini = ""
        return
    items := V7_GetRecent(key)
    out := [value]
    for item in items {
        if StrLower(item) != StrLower(value) && out.Length < 10
            out.Push(item)
    }
    joined := ""
    for i, item in out
        joined .= (i > 1 ? "||" : "") . StrReplace(StrReplace(item, "`r"), "`n", " ")
    try IniWrite(joined, s.Ini, "V7Recent", key)
    V7_RefreshMemoryBar()
}

; @summary Reads a recent list from the V7 INI under key.
; @tags macro, adhd, memory, v7
V7_GetRecent(key) {
    s := VMB()
    if s.Ini = ""
        return []
    raw := IniRead(s.Ini, "V7Recent", key, "")
    if raw = ""
        return []
    out := []
    for item in StrSplit(raw, "||") {
        if Trim(item) != ""
            out.Push(Trim(item))
    }
    return out
}

; @summary Pins the last active external window (process, title, executable path) so you can remember and reopen it tomorrow.
; @tags macro, adhd, memory, v7
V7_PinActiveContext(*) {
    s := VMB()
    targetHwnd := 0
    for hwnd in WinGetList() {
        try {
            if WinGetPID("ahk_id " . hwnd) = DllCall("GetCurrentProcessId")
                continue
            title := WinGetTitle("ahk_id " . hwnd)
            cls := WinGetClass("ahk_id " . hwnd)
            if title = "" || cls = "Progman" || cls = "WorkerW" || cls = "Shell_TrayWnd"
                continue
            targetHwnd := hwnd
            break
        }
    }
    if !targetHwnd
        return VMB_Status("Could not find an active external window to pin.")
    exe := "", title := "", fullPath := ""
    try exe := WinGetProcessName("ahk_id " . targetHwnd)
    try title := WinGetTitle("ahk_id " . targetHwnd)
    try fullPath := ProcessGetPath(WinGetPID("ahk_id " . targetHwnd))
    entry := exe . "|" . StrReplace(title, "|", "-") . "|" . fullPath . "|" . FormatTime(, "yyyy-MM-dd HH:mm")
    V7_AddRecent("PinnedContext", entry)
    VMB_Status("📌 Pinned: " . exe . " - " . SubStr(title, 1, 60) . " (use 'Open pinned' or F1 Memory Hub tomorrow).")
}

; @summary Shows a menu of pinned apps/windows and pinned files to jump back to or relaunch.
; @tags macro, adhd, memory, v7
V7_OpenPinnedMenu(*) {
    m := Menu()
    pins := V7_GetRecent("PinnedContext")
    if pins.Length {
        for entry in pins {
            parts := StrSplit(entry, "|")
            exe := parts.Length >= 1 ? parts[1] : entry
            title := parts.Length >= 2 ? parts[2] : ""
            path := parts.Length >= 3 ? parts[3] : ""
            when := parts.Length >= 4 ? parts[4] : ""
            label := "📌 " . exe . (title != "" ? "  —  " . SubStr(title, 1, 45) : "") . (when != "" ? "  [" . when . "]" : "")
            m.Add(label, ((e, t, p, *) => V7_ActivateOrLaunchPin(e, t, p)).Bind(exe, title, path))
        }
        m.Add()
    }
    files := V7_GetRecent("PinnedFiles")
    if files.Length {
        for f in files
            m.Add("📄 " . f, ((fp, *) => V7_OpenPathOrReveal(fp)).Bind(f))
        m.Add()
    }
    m.Add("Pin current external window now", V7_PinActiveContext)
    m.Add("Pin a reference file or document...", V7_PinFileDialog)
    m.Add("Open full 'Where Was I?' Memory Hub...`tF1", V7_MemoryHub)
    m.Show()
}

; @summary Activates a pinned window if open, or launches its executable / file path if closed.
; @tags macro, adhd, memory, v7
V7_ActivateOrLaunchPin(exe, title, path) {
    if exe != "" && WinExist("ahk_exe " . exe) {
        WinActivate("ahk_exe " . exe)
        VMB_Status("Switched to " . exe . ".")
        return
    }
    if path != "" && FileExist(path) {
        try {
            Run('"' . path . '"')
            VMB_Status("Launched " . path)
            return
        }
    }
    VMB_Status("Window '" . exe . "' is not currently open.")
}

; @summary Lets the user pin any reference file, spreadsheet, or script so it stays on their Memory Hub list.
; @tags macro, adhd, memory, v7
V7_PinFileDialog(*) {
    s := VMB()
    path := FileSelect(1, s.Dir, "Pin a file or script to remember for this project")
    if path = ""
        return
    V7_AddRecent("PinnedFiles", path)
    VMB_Status("Pinned file: " . path)
}

; @summary Shows a quick menu of recent macros and recent data files.
; @tags macro, file, adhd, v7
V7_ShowRecentMenu(*) {
    m := Menu()
    macros := V7_GetRecent("Macros")
    if macros.Length {
        for path in macros
            m.Add("Macro: " . path, ((p, *) => V7_OpenRecentMacro(p)).Bind(path))
    } else {
        m.Add("(No recent macros yet)", (*) => 0)
        m.Disable("(No recent macros yet)")
    }
    m.Add()
    datas := V7_GetRecent("DataFiles")
    if datas.Length {
        for path in datas
            m.Add("Data: " . path, ((p, *) => VMB_SetDataFile(p)).Bind(path))
    }
    if FileExist(VMB().AutoSavePath) {
        m.Add()
        m.Add("Restore last auto-saved session draft", (*) => VMB_LoadFile(VMB().AutoSavePath))
    }
    m.Show()
}

V7_OpenRecentMacro(path) {
    if VM_IsRecording() || VM_IsPlaying() || !VMB_ConfirmDiscard()
        return
    if !FileExist(path)
        return VMB_Status("File no longer exists: " . path)
    try VMB_LoadFile(path)
    catch as err
        VMB_Status(err.Message)
}

; @summary Shows a one-click Folders & Files menu so you never forget where your script, macros, data, or logs live.
; @tags macro, file, adhd, v7
V7_ShowFoldersMenu(*) {
    s := VMB()
    m := Menu()
    m.Add("📂 Open Macros folder (" . s.Dir . ")", (*) => V7_OpenFolder(s.Dir))
    if s.Path != ""
        m.Add("📄 Reveal current macro file in Explorer", (*) => V7_RevealInExplorer(s.Path))
    m.Add("📜 Reveal this running AHK script (" . A_ScriptName . ")", (*) => V7_OpenScriptFolder())
    m.Add("📋 Copy this script's full path to clipboard", (*) => (A_Clipboard := A_ScriptFullPath, VMB_Status("Copied: " . A_ScriptFullPath)))
    m.Add()
    m.Add("📊 Open Data files folder", (*) => V7_OpenFolder(s.Dir . "\data"))
    m.Add("📈 Open Results CSV folder", (*) => V7_OpenFolder(s.Dir . "\results"))
    m.Add("📦 Open Exported players folder", (*) => V7_OpenFolder(s.Dir . "\export"))
    if FileExist(VM_Config().LogPath)
        m.Add("📝 Open last playback log", (*) => V7_OpenPathOrReveal(VM_Config().LogPath))
    m.Show()
}

V7_OpenFolder(dir) {
    try {
        if !DirExist(dir)
            DirCreate(dir)
        Run('explorer.exe "' . dir . '"')
    } catch as err
        VMB_Status("Could not open folder: " . err.Message)
}

V7_RevealInExplorer(path) {
    if FileExist(path) {
        try Run('explorer.exe /select,"' . path . '"')
    } else
        V7_OpenFolder(VMB().Dir)
}

V7_OpenScriptFolder(*) {
    V7_RevealInExplorer(A_ScriptFullPath)
}

V7_OpenPathOrReveal(path) {
    if FileExist(path) {
        try Run('"' . path . '"')
    } else
        VMB_Status("File not found: " . path)
}

; @summary F1 / "Where Was I?" button: opens the ADHD Working-Memory & Context Hub showing everything about what you
;          were doing, which script/macro/data files were in use, pinned windows, and project scratchpad notes.
; @tags macro, adhd, memory, gui, v7
V7_MemoryHub(*) {
    s := VMB()
    V7_ShowMainGui()
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "Where Was I? — Working Memory & File Hub (Visual Macro Blocks V8)")
    dlg.SetFont("s10 bold", "Segoe UI")
    dlg.AddText("xm ym w760 c0A84FF", "🧠 Welcome back! Here is everything you were working on:")
    dlg.SetFont("s9 norm", "Segoe UI")

    curMacro := s.Path != "" ? s.Path : "(Unsaved draft — auto-saved to " . s.AutoSavePath . ")"
    dataSet := s.Macro["settings"].Get("data", "")
    curData := dataSet is Map && dataSet.Get("path", "") != "" ? dataSet["path"] : "(No data file attached)"
    targetApps := V7_CollectMacroApps(s.Macro["blocks"])

    infoText := "Running Script:   " . A_ScriptFullPath
        . "`r`nCurrent Macro:    " . curMacro . "   (" . s.FlatIndex.Count . " steps)"
        . "`r`nCurrent Data:     " . curData
        . "`r`nTarget Programs:  " . (targetApps != "" ? targetApps : "(none recorded yet)")
    dlg.AddEdit("xm y+8 w760 r4 ReadOnly BackgroundF5F7FA", infoText)

    btnScript := dlg.AddButton("xm y+6 w180 h26", "Reveal Running Script")
    btnMacroDir := dlg.AddButton("x+6 yp w170 h26", "Open Macros Folder")
    btnDataDir := dlg.AddButton("x+6 yp w160 h26", "Open Data Folder")
    btnResDir := dlg.AddButton("x+6 yp w160 h26", "Open Results Folder")
    btnCopyAll := dlg.AddButton("x+6 yp w66 h26", "Copy")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+14 w760", "1. What I was doing / Next step to build or test (saved with macro & remembered tomorrow):")
    dlg.SetFont("s9 norm", "Segoe UI")
    edGoal := dlg.AddEdit("xm y+4 w760", s.Ctl["GoalNote"].Value)

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+10 w760", "2. Project Scratchpad & Checklist (jot file paths, test accounts, or reminders):")
    dlg.SetFont("s9 norm", "Segoe UI")
    scratch := s.Macro["settings"].Get("scratchpad", "")
    if scratch = "" && s.Ini != ""
        scratch := StrReplace(IniRead(s.Ini, "V7", "Scratchpad", ""), "\n", "`r`n")
    edScratch := dlg.AddEdit("xm y+4 w760 r5 +WantReturn", scratch)

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+10 w375", "3. Recent Macros & Data Files (double-click to open):")
    dlg.AddText("x+10 yp w375", "4. Pinned Windows & Reference Files (double-click to open):")
    dlg.SetFont("s9 norm", "Segoe UI")
    lvRecent := dlg.AddListView("xm y+4 w375 h150 -Multi +NoSortHdr", ["Type", "Path"])
    lvRecent.ModifyCol(1, 65), lvRecent.ModifyCol(2, 290)
    for mPath in V7_GetRecent("Macros")
        lvRecent.Add(, "Macro", mPath)
    for dPath in V7_GetRecent("DataFiles")
        lvRecent.Add(, "Data", dPath)
    if FileExist(s.AutoSavePath)
        lvRecent.Add(, "Draft", s.AutoSavePath)

    lvPins := dlg.AddListView("x+10 yp w375 h150 -Multi +NoSortHdr", ["Kind", "Target / File"])
    lvPins.ModifyCol(1, 75), lvPins.ModifyCol(2, 280)
    for pEntry in V7_GetRecent("PinnedContext") {
        parts := StrSplit(pEntry, "|")
        lvPins.Add(, "App", (parts.Length >= 1 ? parts[1] : "") . " — " . (parts.Length >= 2 ? parts[2] : ""))
    }
    for fEntry in V7_GetRecent("PinnedFiles")
        lvPins.Add(, "File", fEntry)

    btnPinWin := dlg.AddButton("xm y+8 w170 h28", "📌 Pin Active Window")
    btnPinFile := dlg.AddButton("x+6 yp w170 h28", "📎 Pin a File...")
    btnSave := dlg.AddButton("x+230 yp w110 h28 Default", "Save & Close")
    btnCancel := dlg.AddButton("x+6 yp w80 h28", "Close")

    btnScript.OnEvent("Click", V7_OpenScriptFolder)
    btnMacroDir.OnEvent("Click", (*) => V7_OpenFolder(s.Dir))
    btnDataDir.OnEvent("Click", (*) => V7_OpenFolder(s.Dir . "\data"))
    btnResDir.OnEvent("Click", (*) => V7_OpenFolder(s.Dir . "\results"))
    btnCopyAll.OnEvent("Click", (*) => (A_Clipboard := infoText . "`r`nGoal: " . edGoal.Value . "`r`nNotes:`r`n" . edScratch.Value,
        VMB_Status("Copied project summary to clipboard.")))
    btnPinWin.OnEvent("Click", (*) => (V7_PinActiveContext(), dlg.Destroy(), V7_MemoryHub()))
    btnPinFile.OnEvent("Click", (*) => (V7_PinFileDialog(), dlg.Destroy(), V7_MemoryHub()))

    lvRecent.OnEvent("DoubleClick", (ctl, row) => row ? (
        kind := ctl.GetText(row, 1), p := ctl.GetText(row, 2),
        saveHub(),
        kind = "Data" ? VMB_SetDataFile(p) : V7_OpenRecentMacro(p)
    ) : 0)

    lvPins.OnEvent("DoubleClick", (ctl, row) => row ? (
        kind := ctl.GetText(row, 1), val := ctl.GetText(row, 2),
        kind = "File" ? V7_OpenPathOrReveal(val) : V7_OpenPinnedRow(row)
    ) : 0)

    saveHub(*) {
        s.Ctl["GoalNote"].Value := Trim(edGoal.Value)
        V7_OnGoalChanged(s.Ctl["GoalNote"])
        VM__SetOrDelete(s.Macro["settings"], "scratchpad", edScratch.Value)
        if s.Ini != ""
            try IniWrite(StrReplace(StrReplace(edScratch.Value, "`r"), "`n", "\n"), s.Ini, "V7", "Scratchpad")
        V7_AutoSaveNow()
        dlg.Destroy()
    }
    btnSave.OnEvent("Click", saveHub)
    btnCancel.OnEvent("Click", saveHub)
    dlg.OnEvent("Escape", saveHub)
    dlg.OnEvent("Close", saveHub)
    dlg.Show()
}

V7_OpenPinnedRow(row) {
    pins := V7_GetRecent("PinnedContext")
    if row >= 1 && row <= pins.Length {
        parts := StrSplit(pins[row], "|")
        V7_ActivateOrLaunchPin(parts.Length >= 1 ? parts[1] : "", parts.Length >= 2 ? parts[2] : "", parts.Length >= 3 ? parts[3] : "")
    }
}

; @summary Lists the unique target executables referenced across the macro's blocks.
; @tags macro, adhd, memory, v7
V7_CollectMacroApps(blocks) {
    seen := Map(), out := ""
    for step in VMF_Flatten(blocks) {
        win := step.Get("win", "")
        if win is Map && win.Get("exe", "") != "" {
            exe := win["exe"]
            if !seen.Has(StrLower(exe)) {
                seen[StrLower(exe)] := 1
                out .= (out = "" ? "" : ", ") . exe
            }
        }
    }
    return out
}

; @summary Apple Spotlight-style Command Palette (Ctrl+K or Ctrl+Shift+K): fuzzy-search every editor action,
;          every block in the palette, recent macros, or steps in your current macro, and press Enter to run/jump.
; @tags macro, gui, apple, command-palette, v7
V7_CommandPalette(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    V7_ShowMainGui()
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "⌘ Command Palette — Type what you want to do or add (Enter runs, Esc closes)")
    dlg.SetFont("s10", "Segoe UI")
    ed := dlg.AddEdit("xm ym w680")
    DllCall("SendMessage", "Ptr", ed.Hwnd, "UInt", 0x1501, "Ptr", 1,
        "WStr", "Search actions, blocks to insert, recent files, or steps in your macro...")
    dlg.SetFont("s9", "Segoe UI")
    lv := dlg.AddListView("xm y+8 w680 h320 -Multi +NoSortHdr", ["Category", "Command / Block / File", "Shortcut / Detail"])
    lv.ModifyCol(1, 95), lv.ModifyCol(2, 365), lv.ModifyCol(3, 195)
    btnRun := dlg.AddButton("xm y+8 w120 h28 Default", "Run / Insert")
    btnClose := dlg.AddButton("x+6 yp w90 h28", "Cancel")

    allItems := V7_BuildCommandItems()
    shown := []

    refill(query := "") {
        lv.Opt("-Redraw")
        lv.Delete()
        shown := V7_FilterCommandItems(allItems, query)
        for item in shown
            lv.Add(, item.Cat, item.Title, item.Detail)
        if shown.Length
            lv.Modify(1, "Select Focus Vis")
        lv.Opt("+Redraw")
    }
    runChosen(*) {
        row := lv.GetNext()
        if !row && shown.Length
            row := 1
        if !row || row > shown.Length
            return
        chosen := shown[row]
        dlg.Destroy()
        chosen.Action.Call()
    }
    ed.OnEvent("Change", (ctl, *) => refill(ctl.Value))
    lv.OnEvent("DoubleClick", runChosen)
    btnRun.OnEvent("Click", runChosen)
    btnClose.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    refill("")
    dlg.Show()
    ed.Focus()
}

; @summary Builds the list of searchable items for the Command Palette (actions, blocks, recent files, current steps).
; @tags macro, apple, command-palette, v7
V7_BuildCommandItems() {
    s := VMB()
    items := [
        {Cat: "Action", Title: "🧭 Open V10 Deterministic Inspector & Layout Physics Lab", Detail: "Ctrl+Shift+D / Measure CRC, Pixels & Anchors", Action: V10_ShowDeterministicLab},
        {Cat: "Action", Title: "🎯 Convert Ticked / Selected Steps to Coordinates + Any Window", Detail: "1-click fix for strict steps", Action: (*) => VMB_MakeFlexible("selection", "program")},
        {Cat: "Action", Title: "🌐 Convert ENTIRE Macro to Coordinates + Any Window of Program", Detail: "Fixes strict picture/window failures", Action: (*) => VMB_MakeFlexible("all", "program")},
        {Cat: "Action", Title: "Convert Ticked / Selected Clicks to Coordinates Only", Detail: "Find by recorded spot", Action: (*) => VMB_SetFindMode("spot", "selection")},
        {Cat: "Action", Title: "Convert Ticked / Selected Steps to Any Window of Program", Detail: "Ignore changing window titles", Action: (*) => VMB_SetWinMatch("program", "selection")},
        {Cat: "Action", Title: "⚡ Make Selected Step Vary & Auto-Loop", Detail: "Ctrl+L / Right-click", Action: V8_VarySelectedDialog},
        {Cat: "Action", Title: "📏 Measure Row 1 -> Row 2 Pixel Stride + Auto-Loop", Detail: "F6 twice on screen", Action: V8_QuickMeasureStrideForSelected},
        {Cat: "Action", Title: "🎯 Pick Multiple Click Spots to Cycle Through + Auto-Loop", Detail: "F6 on each spot", Action: V8_QuickPickSpotsForSelected},
        {Cat: "Action", Title: "Where Was I? (Memory & Files Hub)", Detail: "F1 / Ctrl+Shift+M", Action: V7_MemoryHub},
        {Cat: "Action", Title: "Toggle Floating Prototyping HUD", Detail: "Ctrl+Shift+H", Action: V7_ToggleIdleHud},
        {Cat: "Action", Title: "Quick Look Preview of Selected Step", Detail: "Space (in tree)", Action: V7_QuickLook},
        {Cat: "Action", Title: "Start / Stop Recording", Detail: "Ctrl+Shift+R", Action: VMB_ToggleRecord},
        {Cat: "Action", Title: "Play Macro", Detail: "F5 / Ctrl+Shift+P", Action: (*) => VMB_Play()},
        {Cat: "Action", Title: "Step by Step Debugger", Detail: "F10", Action: (*) => VMB_Play(false, "step")},
        {Cat: "Action", Title: "Run to Selected Line", Detail: "Ctrl+F10", Action: VMB_RunToHere},
        {Cat: "Action", Title: "Pin Current Active App / Window", Detail: "Remember window", Action: V7_PinActiveContext},
        {Cat: "Action", Title: "Quick Capture: Add a Click Step Now", Detail: "Point + F6", Action: V7_HudQuickClick},
        {Cat: "Action", Title: "Quick Capture: Add a Wait-for-Image Step", Detail: "Drag rectangle", Action: V7_HudQuickWait},
        {Cat: "Action", Title: "Open Macros Folder in Explorer", Detail: s.Dir, Action: (*) => V7_OpenFolder(s.Dir)},
        {Cat: "Action", Title: "Reveal Running AHK Script in Explorer", Detail: A_ScriptName, Action: V7_OpenScriptFolder},
        {Cat: "Action", Title: "Open Step Grid (Bulk Edit)", Detail: "Window / Find / Wait", Action: VMB_StepGrid},
        {Cat: "Action", Title: "Open Web / CDP Panel", Detail: "Edge / Chrome", Action: V4_WebPanel},
        {Cat: "Action", Title: "Open Code View", Detail: "Read-only pseudocode", Action: VMB_CodeView},
        {Cat: "Action", Title: "Save Macro", Detail: "Ctrl+S", Action: (*) => VMB_SaveTo(s.Path)},
        {Cat: "Action", Title: "Export Standalone Player (.ahk + .txt)", Detail: "Single-file bundle", Action: VMB_ExportPlayer}
    ]
    for group in VMB_PaletteGroups() {
        catName := "Add: " . group[1]
        for entry in group[2] {
            label := entry[1], kind := entry[2], desc := entry[3]
            items.Push({Cat: catName, Title: label, Detail: desc, Action: ((k, *) => V7_InsertBlockByKind(k)).Bind(kind)})
        }
    }
    for mPath in V7_GetRecent("Macros")
        items.Push({Cat: "Recent Macro", Title: mPath, Detail: "Open macro file", Action: ((p, *) => V7_OpenRecentMacro(p)).Bind(mPath)})
    for i, step in VMF_Flatten(s.Macro["blocks"]) {
        sum := VM_StepSummary(step)
        items.Push({Cat: "Go to Step", Title: "#" . i . "  " . sum[1] . "  " . sum[3], Detail: sum[2],
            Action: ((st, *) => VMB_Refresh(st)).Bind(step)})
    }
    return items
}

; @summary Filters Command Palette items by space-separated search tokens (case-insensitive).
; @tags macro, apple, command-palette, v7
V7_FilterCommandItems(items, query) {
    q := Trim(StrLower(query))
    if q = ""
        return items
    tokens := StrSplit(q, " ", " `t")
    out := []
    for item in items {
        hay := StrLower(item.Cat . " " . item.Title . " " . item.Detail)
        matchAll := true
        for tok in tokens {
            if tok != "" && !InStr(hay, tok) {
                matchAll := false
                break
            }
        }
        if matchAll
            out.Push(item)
    }
    return out
}

V7_InsertBlockByKind(kind) {
    if kind = "elif"
        return VMB_AddElifToSelection()
    where := VMB_InsertPoint()
    node := VMB_MakeNode(kind)
    if node
        VMB_InsertNode(node, where.List, where.Index)
}

; @summary Apple Finder-style Quick Look (Spacebar on a macro step, or Quick Look button): pops up a clean inspector
;          showing the captured target BMP image, coordinates, target window, and plain-English behavior without a modal dialog.
; @tags macro, gui, apple, quicklook, v7
V7_QuickLook(*) {
    s := VMB()
    if s.QuickLookGui && DllCall("IsWindowVisible", "Ptr", s.QuickLookGui.Hwnd, "Int") {
        s.QuickLookGui.Destroy()
        s.QuickLookGui := 0
        return
    }
    V7_ShowQuickLookForSelection()
}

V7_RefreshQuickLookIfOpen() {
    s := VMB()
    if s.QuickLookGui && DllCall("IsWindowVisible", "Ptr", s.QuickLookGui.Hwnd, "Int")
        V7_ShowQuickLookForSelection()
}

V7_ShowQuickLookForSelection() {
    s := VMB()
    node := VMB_SelectedTarget()
    if !node
        return VMB_Status("Select a step or block first, then press Space for Quick Look.")
    if s.QuickLookGui {
        try s.QuickLookGui.Destroy()
        s.QuickLookGui := 0
    }
    ql := Gui("+Owner" . s.Gui.Hwnd . " +ToolWindow -MinimizeBox", "Quick Look  (Space or Esc closes)")
    ql.BackColor := "FFFFFF"
    ql.SetFont("s10 bold", "Segoe UI")
    idx := s.FlatIndex.Get(node, 0)
    ql.AddText("xm ym w440 c0A84FF", (idx ? "Step #" . idx . "  —  " : "") . VMF_BlockName(node.Get("type", "")))
    ql.SetFont("s9 norm", "Segoe UI")
    ql.AddEdit("xm y+6 w440 r5 ReadOnly BackgroundF5F7FA", V7_DescribeNodePlain(node))

    pattern := node.Get("pattern", "")
    if SubStr(pattern, 1, 6) = "V4BMP:" {
        try {
            bmpPath := V4_ImageCache(pattern)
            ql.AddText("xm y+8 w440 c606060", "Captured Target Image:")
            ql.AddPicture("xm y+4 Border", bmpPath)
        }
    }
    btnTest := ql.AddButton("xm y+10 w110 h26", "Test Target")
    btnEdit := ql.AddButton("x+6 yp w95 h26", "Edit Step...")
    btnPic := ql.AddButton("x+6 yp w115 h26", "New Picture...")
    btnClose := ql.AddButton("x+6 yp w90 h26 Default", "Close")

    closeQL(*) {
        if s.QuickLookGui {
            try s.QuickLookGui.Destroy()
            s.QuickLookGui := 0
        }
    }
    btnTest.OnEvent("Click", (*) => (closeQL(), VMB_TestSelected()))
    btnEdit.OnEvent("Click", (*) => (closeQL(), VMB_EditSelected()))
    btnPic.OnEvent("Click", (*) => (closeQL(), VMB_NewPicture()))
    btnClose.OnEvent("Click", closeQL)
    ql.OnEvent("Escape", closeQL)
    ql.OnEvent("Close", closeQL)
    s.QuickLookGui := ql
    ql.Show("NA")
}

; @summary Plain-English summary of any step or block for Quick Look and self-tests.
; @tags macro, apple, quicklook, v7
V7_DescribeNodePlain(node) {
    if !(node is Map)
        return "(no step selected)"
    t := node.Get("type", "")
    win := node.Get("win", "")
    winStr := win is Map && VM_WindowLabel(win) != "" ? VM_WindowLabel(win) : "(any active window)"
    matchMode := node.Get("winMatch", "") = "program" ? "Any window of program"
        : node.Get("winMatch", "") = "active" ? "Whatever window is active" : "Exact window title"
    lines := "Action:         " . VMF_BlockName(t)
        . "`r`nTarget Window:  " . winStr . "  [" . matchMode . "]"
    if t = "click" || t = "drag" {
        findHow := node.Get("find", "") = "spot" ? "Coordinates (" . node.Get("scrX", 0) . ", " . node.Get("scrY", 0) . ")"
            : "Embedded Picture (fallback spot " . node.Get("scrX", 0) . ", " . node.Get("scrY", 0) . ")"
        lines .= "`r`nFind Target By: " . findHow . "   •   Button: " . node.Get("button", "Left")
    } else if t = "text" {
        lines .= "`r`nTypes Text:     " . (node.Get("ask", 0) ? "(Asks at runtime: " . node.Get("prompt", "") . ")" : node.Get("text", ""))
    } else if t = "keys" {
        lines .= "`r`nPresses Keys:   " . node.Get("keys", "")
    } else if node.Has("selector") {
        lines .= "`r`nWeb Selector:   " . node.Get("selector", "")
            . (node.Get("frame", "") != "" ? "   [Frame: " . node["frame"] . "]" : "")
            . "   [Match index: " . node.Get("index", 0) . "]"
    } else if !VMF_IsStep(node) {
        lines .= "`r`nSummary:        " . VMF_BlockText(node)
    }
    if node.Get("note", "") != ""
        lines .= "`r`nNote:           " . node["note"]
    return lines
}

; @summary Run bar "Re-capture target..." button: lets you recapture a desktop click/wait/check/if picture right from
;          the paused or failed HUD without stopping the macro run, then press Down to retry immediately.
; @tags macro, playback, debug, hud, v7
V7_FixDesktopTargetFromBar(bar) {
    d := V5_Dbg()
    node := bar.Node, runner := bar.Runner
    if d.Editing || !d.Waiting || !(node is Map) || !IsObject(runner)
        return
    t := node.Get("type", "")
    d.Editing := true
    V5_HideOverlays()
    try {
        if t = "click" || t = "drag" {
            point := VM_UiPickPoint("Point at the exact spot to click and press F6 (Esc cancels).")
            if point {
                fresh := VM_CaptureClickStep(point.X, point.Y, node.Get("button", "Left"), node.Get("count", 1))
                for key in ["x", "y", "scrX", "scrY", "rx", "ry", "offsetX", "offsetY", "q", "pattern"]
                    node[key] := fresh[key]
                VM__SetOrDelete(node, "geo", fresh.Get("geo", ""))
                node["win"] := fresh["win"]
                VM__SetOrDelete(node, "find", "")
                runner.Changed := true
                bar.Next.Text := V5_NodeTitle(runner, node)
                bar.Note("✓ New target picture captured! Press Down (or Try again) to run this step now.")
            }
        } else if RegExMatch(t, "^(wait|check|if|until)$") {
            patternText := VM_UiDragImage("Re-capture image", "Drag a rectangle around the image on screen. Esc cancels.", bar.G)
            if patternText != "" {
                fresh := VM_NewWaitStep(patternText)
                node["pattern"] := fresh["pattern"], node["q"] := fresh["q"]
                runner.Changed := true
                bar.Note("✓ New image captured! Press Down (or Try again) to run this step now.")
            }
        }
    } catch as err
        bar.Note(err.Message, true)
    finally {
        V5_RestoreOverlays()
        d.Editing := false
    }
}

; @summary Run bar "Edit step..." button: opens the step editor for the paused/failed step right from the HUD.
; @tags macro, playback, debug, hud, v7
V7_EditStepFromBar(bar) {
    d := V5_Dbg()
    node := bar.Node, runner := bar.Runner
    if d.Editing || !d.Waiting || !(node is Map) || !IsObject(runner)
        return
    d.Editing := true
    try {
        saved := VMF_IsStep(node) ? VM_UiEditStep(node, "Edit paused step", bar.G.Hwnd, VMB_ColumnChoices()) : VMB_EditBlock(node)
        if saved {
            runner.Changed := true
            bar.Next.Text := V5_NodeTitle(runner, node)
            bar.Note("✓ Step updated! Press Down (or Try again) to run it with your changes.")
        }
    } catch as err
        bar.Note(err.Message, true)
    finally d.Editing := false
}

; @summary Toggles the persistent Floating Prototyping HUD (Ctrl+Shift+H or "Float HUD" button).
; @tags macro, hud, gui, v7
V7_ToggleIdleHud(*) {
    s := VMB()
    if s.IdleHud && s.IdleHud.IsVisible() {
        s.IdleHud.Hide()
        IniWrite(0, s.Ini, "V7", "ShowHud")
        VMB_Status("Floating HUD hidden (press Ctrl+Shift+H or 'Float HUD' to show it again).")
    } else {
        V7_EnsureIdleHud()
        IniWrite(1, s.Ini, "V7", "ShowHud")
        VMB_Status("Floating Prototyping HUD is active — build, record, or play while working in any app.")
    }
}

V7_EnsureIdleHud() {
    s := VMB()
    if !s.IdleHud
        s.IdleHud := V7ProtoHud()
    s.IdleHud.Show()
    V7_SyncIdleHud()
}

V7_SyncIdleHud() {
    s := VMB()
    if s.IdleHud
        s.IdleHud.Refresh()
}

; @summary 1-click rapid prototyping from the HUD: hides the editor, lets you point + F6 to capture a Click step,
;          and appends it right into the macro without switching windows.
; @tags macro, hud, prototype, v7
V7_HudQuickClick(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    wasVis := DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int")
    if wasVis
        s.Gui.Hide()
    V5_HideOverlays()
    try {
        pt := VM_UiPickPoint("Rapid Prototype (+ Click): Point at the button/spot to click and press F6 (Esc cancels).")
        if pt {
            step := VM_CaptureClickStep(pt.X, pt.Y, "Left", 1)
            VMB_ApplyDefaultFind([step])
            where := VMB_InsertPoint()
            VMB_InsertNode(step, where.List, where.Index)
            V7_AutoSaveNow()
            TrayTip("Added Click step (#" . s.FlatIndex.Count . ") at " . pt.X . ", " . pt.Y, "Prototyping HUD", "Iconi")
        }
    } finally {
        V5_RestoreOverlays()
        if wasVis
            s.Gui.Show("NA")
        V7_SyncIdleHud()
    }
}

; @summary 1-click rapid prototyping from the HUD: drag a rectangle around an image on screen to add a Wait-for-Image step.
; @tags macro, hud, prototype, v7
V7_HudQuickWait(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    V5_HideOverlays()
    try {
        pat := VM_UiDragImage("Rapid Prototype (+ Wait for Image)",
            "After OK, drag a rectangle around the image to wait for. Esc cancels.", s.Gui)
        if pat != "" {
            step := VM_NewWaitStep(pat)
            where := VMB_InsertPoint()
            VMB_InsertNode(step, where.List, where.Index)
            V7_AutoSaveNow()
            TrayTip("Added Wait-for-image step (#" . s.FlatIndex.Count . ").", "Prototyping HUD", "Iconi")
        }
    } finally {
        V5_RestoreOverlays()
        V7_SyncIdleHud()
    }
}

; @summary 1-click rapid prototyping from the HUD: prompts for text or {{Column}} to type into the active window.
; @tags macro, hud, prototype, v7
V7_HudQuickText(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    ans := InputBox("Text to type (can include {{Column}}, {{clipboard}}, {{index}}):",
        "Rapid Prototype (+ Type Text)", "w420 h130")
    if ans.Result != "OK" || ans.Value = ""
        return
    step := Map("type", "text", "text", ans.Value, "win", V4_RecordWin())
    where := VMB_InsertPoint()
    VMB_InsertNode(step, where.List, where.Index)
    V7_AutoSaveNow()
    V7_SyncIdleHud()
}

; @summary The V7 Always-On Prototyping Companion HUD: a non-activating (WS_EX_NOACTIVATE) floating bar that stays
;          out of the way in the corner when idle or recording, displays your current macro & "Where Was I" goal,
;          and lets you record, step-debug, or add Click / Wait / Text blocks on the fly. Automatically yields to
;          V5RunBar while playback is running.
; @tags macro, hud, gui, prototype, v7
class V7ProtoHud {
    __New() {
        s := VMB()
        this.Compact := IniRead(s.Ini, "V7", "HudCompact", 0) ? true : false
        this.Suspended := false
        g := Gui("+AlwaysOnTop +ToolWindow -MinimizeBox +E0x08000000", "Visual Macro Blocks V8  -  Prototyping HUD")
        g.MarginX := 10, g.MarginY := 8
        g.BackColor := "FFFFFF"
        g.SetFont("s9 bold", "Segoe UI")
        this.Head := g.AddText("xm ym w390 h24 +0x200 Background1C1C1E cFFFFFF", "   ⚡ Prototyping HUD")
        this.BtnFold := g.AddButton("x+4 yp w72 h24", this.Compact ? "Expand ▾" : "Mini ▴")
        g.SetFont("s8 norm", "Segoe UI")
        this.Goal := g.AddText("xm y+6 w466 c0A84FF +0x4000", "")
        this.Info := g.AddText("xm y+2 w466 c505050 +0x4000", "")

        this.BRec := g.AddButton("xm y+6 w82 h28", "● Record")
        this.BPlay := g.AddButton("x+4 yp w68 h28", "▶ Play")
        this.BStep := g.AddButton("x+4 yp w72 h28", "👣 Step")
        this.BVary := g.AddButton("x+6 yp w84 h28", "⚡ Vary+Loop")
        this.BClick := g.AddButton("x+4 yp w66 h28", "+ Click")
        this.BWait := g.AddButton("x+4 yp w64 h28", "+ Wait")

        this.BMacro := g.AddButton("xm y+6 w112 h24", "Editor (Ctrl+Shift+M)")
        this.BHub := g.AddButton("x+4 yp w118 h24", "🧠 Where Was I?")
        this.BCmd := g.AddButton("x+4 yp w114 h24", "⌘ Command (Ctrl+K)")
        this.BPin := g.AddButton("x+4 yp w110 h24", "📌 Pin active app")

        this.BtnFold.OnEvent("Click", (*) => this.ToggleCompact())
        this.BRec.OnEvent("Click", VMB_ToggleRecord)
        this.BPlay.OnEvent("Click", (*) => VMB_Play())
        this.BStep.OnEvent("Click", (*) => VMB_Play(false, "step"))
        this.BVary.OnEvent("Click", V8_HudVaryButton)
        this.BClick.OnEvent("Click", V7_HudQuickClick)
        this.BWait.OnEvent("Click", V7_HudQuickWait)
        this.BMacro.OnEvent("Click", V7_ShowMainGui)
        this.BHub.OnEvent("Click", V7_MemoryHub)
        this.BCmd.OnEvent("Click", V7_CommandPalette)
        this.BPin.OnEvent("Click", V7_PinActiveContext)
        g.OnEvent("Close", (*) => (this.Hide(), IniWrite(0, VMB().Ini, "V7", "ShowHud"), true))

        this.G := g
        V5_Overlays().Windows[g.Hwnd] := 1
        this.ApplyCompact()
    }
    IsVisible() => DllCall("IsWindowVisible", "Ptr", this.G.Hwnd, "Int") != 0
    Show() {
        if this.Suspended
            return
        s := VMB()
        this.G.Show("Hide AutoSize")
        V5_WindowRect(this.G.Hwnd, , , &w, &h)
        hx := IniRead(s.Ini, "V7", "HudX", ""), hy := IniRead(s.Ini, "V7", "HudY", "")
        x := IsInteger(hx) ? Integer(hx) : "", y := IsInteger(hy) ? Integer(hy) : ""
        if x = "" || y = "" || !V5_OnScreen(x, y, w) {
            MonitorGetWorkArea(MonitorGetPrimary(), , , &right, &bottom)
            x := right - w - 16, y := bottom - h - 16
        }
        this.G.Show("NA x" . x . " y" . y)
        this.Refresh()
    }
    Hide() {
        if DllCall("IsWindow", "Ptr", this.G.Hwnd, "Int") && this.IsVisible() {
            V5_WindowRect(this.G.Hwnd, &x, &y)
            IniWrite(x, VMB().Ini, "V7", "HudX")
            IniWrite(y, VMB().Ini, "V7", "HudY")
        }
        this.G.Hide()
    }
    SuspendForRun(on) {
        this.Suspended := on
        if on
            this.Hide()
        else if IniRead(VMB().Ini, "V7", "ShowHud", 1)
            this.Show()
    }
    ToggleCompact() {
        this.Compact := !this.Compact
        IniWrite(this.Compact ? 1 : 0, VMB().Ini, "V7", "HudCompact")
        this.ApplyCompact()
        if this.IsVisible()
            this.G.Show("NA AutoSize")
    }
    ApplyCompact() {
        this.BtnFold.Text := this.Compact ? "Expand ▾" : "Mini ▴"
        for ctl in [this.Goal, this.Info, this.BMacro, this.BHub, this.BCmd, this.BPin]
            ctl.Visible := !this.Compact
    }
    Refresh() {
        s := VMB()
        name := "Untitled"
        if s.Path != ""
            SplitPath(s.Path, &name)
        if VM_IsRecording() {
            paused := VM_Rec().Paused
            this.Head.Opt("+Background" . (paused ? "FF9F0A" : "D70015"))
            this.Head.Text := "   " . (paused ? "|| PAUSED" : "● REC") . "  •  "
                . (IsObject(s.RecSteps) ? s.RecSteps.Length : 0) . " steps  (Alt+Click or F7 = mark vary)"
            this.BRec.Text := "■ Stop Rec"
            this.BVary.Text := "⚡ Mark F7"
        } else {
            this.Head.Opt("+Background1C1C1E")
            this.Head.Text := "   ⚡ " . name . (s.Dirty ? " *" : "") . "  •  " . s.FlatIndex.Count . " steps"
            this.BRec.Text := "● Record"
            this.BVary.Text := "⚡ Vary+Loop"
        }
        goal := s.Ctl.Has("GoalNote") && Trim(s.Ctl["GoalNote"].Value) != "" ? Trim(s.Ctl["GoalNote"].Value)
            : "(No 'Where Was I' goal set — click 'Where Was I?' to add one)"
        this.Goal.Text := "Goal: " . goal
        pins := V7_GetRecent("PinnedContext")
        pinShort := pins.Length ? StrSplit(pins[1], "|")[1] : "none"
        this.Info.Text := (s.LastSavedAt != "" ? "Saved " . s.LastSavedAt : "Auto-save ready")
            . "  •  Pinned app: " . pinShort . "  •  +Click / +Wait adds steps right here"
    }
}

; ============================================================================
; V8 SMART VARY & 1-CLICK AUTO-LOOP (ZERO-FRICTION RAPID PROTOTYPING)
; ============================================================================

; @summary Returns the 1-based iteration/round number for a varying step during playback.
; @tags macro, vary, loop, v8
V8_RoundNumber(node, runner := 0) {
    if !IsObject(runner)
        return 1
    varName := Trim(node.Get("varyVar", ""))
    if varName != "" {
        if runner.Vars.Has(varName) && IsNumber(runner.Vars[varName])
            return Max(1, Integer(runner.Vars[varName]))
        if StrLower(varName) = "row" && runner.RowNumber > 0
            return runner.RowNumber
        if StrLower(varName) = "index" && runner.LoopIndex > 0
            return runner.LoopIndex
    }
    if runner.LoopIndex > 0
        return runner.LoopIndex
    if runner.RowNumber > 0
        return runner.RowNumber
    for k, v in runner.Vars {
        if IsNumber(v)
            return Max(1, Integer(v))
    }
    return 1
}

; @summary Computes {DX, DY} pixel shift for a click/drag/image step on the current loop round (round 1 = +0, +0).
; @tags macro, vary, click, v8
V8_CalcPixelShift(node, runner := 0) {
    if !(node is Map)
        return {DX: 0, DY: 0}
    stepX := Number(node.Get("varyDX", 0))
    stepY := Number(node.Get("varyDY", 0))
    if stepX = 0 && stepY = 0
        return {DX: 0, DY: 0}
    rIdx := V8_RoundNumber(node, runner)
    mult := Max(0, rIdx - 1)
    return {DX: Round(stepX * mult), DY: Round(stepY * mult)}
}

; @summary Resolves the keys string for a "keys" step, including V8 dynamic key repetition (e.g. press {Down} N times on round N).
; @tags macro, vary, keys, v8
V8_ResolveKeys(node, runner := 0) {
    if !(node is Map)
        return ""
    if node.Get("varyKey", 0) {
        keyName := Trim(node.Get("varyKeyName", "Down"))
        if keyName = ""
            keyName := "Down"
        startCount := Integer(node.Get("varyKeyStart", 1))
        perRound := Integer(node.Get("varyKeyStep", 1))
        rIdx := V8_RoundNumber(node, runner)
        total := startCount + (Max(1, rIdx) - 1) * perRound
        if total <= 0
            return ""
        cleanKey := RegExReplace(keyName, "^\{|\}$")
        return "{" . cleanKey . " " . total . "}"
    }
    raw := node.Get("keys", "")
    return IsObject(runner) ? runner.Expand(raw) : raw
}

; @summary Short badge shown in the macro tree and step summary when a step has V8 Smart Vary enabled.
; @tags macro, vary, gui, v8
V8_VarySummaryBadge(node) {
    if !(node is Map)
        return ""
    spots := node.Get("varySpots", "")
    if spots is Array && spots.Length
        return "⚡[varies: cycles " . spots.Length . " spots]"
    dx := Number(node.Get("varyDX", 0)), dy := Number(node.Get("varyDY", 0))
    if dx != 0 || dy != 0 {
        parts := ""
        if dx != 0
            parts .= (dx > 0 ? "+" : "") . dx . "px X"
        if dy != 0
            parts .= (parts != "" ? ", " : "") . (dy > 0 ? "+" : "") . dy . "px Y"
        return "⚡[varies: " . parts . " / round]"
    }
    if node.Get("varyKey", 0) {
        kName := node.Get("varyKeyName", "Down")
        kStart := node.Get("varyKeyStart", 1)
        kStep := node.Get("varyKeyStep", 1)
        return "⚡[varies: {" . kName . "} " . kStart . "x, +" . kStep . "x / round]"
    }
    if node.Get("type", "") = "text" && InStr(node.Get("text", ""), "{{")
        return "⚡[varies: " . node.Get("text", "") . "]"
    return ""
}

; @summary Extra note shown on the paused Run Bar preview when a step has a V8 variation active.
; @tags macro, vary, debug, v8
V8_VaryPreviewNote(node, runner := 0) {
    badge := V8_VarySummaryBadge(node)
    if badge = ""
        return ""
    rIdx := V8_RoundNumber(node, runner)
    return "  (Round #" . rIdx . " " . badge . ")"
}

; @summary While recording: F7 (or HUD "⚡ Mark F7" button) marks the most recently recorded step (or next click)
;          as the step that varies, so V8 opens the Vary + Auto-Loop wizard automatically when recording stops.
; @tags macro, record, vary, v8
V8_MarkLastRecordedStepVary(*) {
    s := VMB()
    if !VM_IsRecording() || !IsObject(s.RecSteps)
        return
    if s.RecSteps.Length {
        last := s.RecSteps[s.RecSteps.Length]
        last["varyMarked"] := 1
        if last.Get("type", "") = "click"
            last["find"] := "spot"
        ToolTip("⚡ Marked step #" . s.RecSteps.Length . " (" . VMF_BlockName(last.Get("type", "")) . ") as Variable Step!`nWhen you stop recording, the Auto-Loop wizard will open automatically.")
        SetTimer(() => ToolTip(), -2000)
    } else {
        ToolTip("⚡ Hold Alt while clicking the target that changes, or press F7 right after clicking/typing it!")
        SetTimer(() => ToolTip(), -2000)
    }
}

; @summary HUD "⚡ Vary+Loop" / "⚡ Mark F7" button handler: marks the last step while recording, or opens the Vary + Auto-Loop wizard when idle.
; @tags macro, hud, vary, v8
V8_HudVaryButton(*) {
    if VM_IsRecording()
        V8_MarkLastRecordedStepVary()
    else
        V8_VarySelectedDialog()
}

; @summary Clears any V8 variation settings on the selected step.
; @tags macro, vary, gui, v8
V8_ClearVaryOnSelected(*) {
    info := VMB_SelectedNode("the step to clear variation from")
    if !info
        return
    VMB_Snapshot()
    V8_ClearVaryProps(info.Node)
    VMB().Dirty := true
    VMB_Refresh(info.Node)
    V7_AutoSaveNow()
    VMB_Status("Cleared variation on step — it will use its fixed recorded values again.")
}

V8_ClearVaryProps(node) {
    for k in ["varyDX", "varyDY", "varySpots", "varyKey", "varyKeyName", "varyKeyStart", "varyKeyStep", "varyVar"] {
        if node.Has(k)
            node.Delete(k)
    }
}

; @summary Wraps a list of steps (by default the sibling block list containing targetNode) inside a loop container
;          ("repeat", "for", or "foreach"). If targetNode is ALREADY inside a loop, updates that loop instead of double-wrapping!
; @returns the loop container Map
; @tags macro, vary, loop, blocks, v8
V8_AutoWrapInLoop(macroBlocks, targetNode, loopKind := "repeat", loopCount := 10, forVar := "i", forFrom := 1, forStep := 1, scopeList := 0) {
    if loopKind = "none" || loopKind = ""
        return 0
    loc := V8_FindNodeContainer(macroBlocks, targetNode, 0)
    if !loc
        return 0
    ; If the step is already directly inside a Repeat / For / ForEach loop, update that loop's parameters in place.
    if loc.Owner is Map && RegExMatch(loc.Owner.Get("type", ""), "^(repeat|for|foreach)$") {
        loopNode := loc.Owner
        V8_ConfigureLoopNode(loopNode, loopKind, loopCount, forVar, forFrom, forStep)
        return loopNode
    }
    parentList := loc.List
    loopNode := Map("type", loopKind = "for" ? "for" : loopKind = "foreach" ? "foreach" : "repeat", "body", [])
    V8_ConfigureLoopNode(loopNode, loopKind, loopCount, forVar, forFrom, forStep)

    ; Determine which steps in parentList to move into loopNode["body"]
    if scopeList is Array && scopeList.Length {
        scopeSet := Map()
        for st in scopeList
            scopeSet[st] := 1
        firstIdx := 0
        moved := []
        i := 1
        while i <= parentList.Length {
            item := parentList[i]
            if scopeSet.Has(item) {
                if !firstIdx
                    firstIdx := i
                moved.Push(item)
                parentList.RemoveAt(i)
            } else {
                i += 1
            }
        }
        if moved.Length {
            loopNode["body"] := moved
            parentList.InsertAt(VF_Clamp(firstIdx, 1, parentList.Length + 1), loopNode)
            return loopNode
        }
    }
    ; Default: wrap all non-pickdata steps in parentList into the loop
    moved := [], insertIdx := 1
    i := 1
    while i <= parentList.Length {
        item := parentList[i]
        if item is Map && item.Get("type", "") = "pickdata" {
            insertIdx := i + 1
            i += 1
            continue
        }
        moved.Push(item)
        parentList.RemoveAt(i)
    }
    loopNode["body"] := moved
    parentList.InsertAt(VF_Clamp(insertIdx, 1, parentList.Length + 1), loopNode)
    return loopNode
}

V8_ConfigureLoopNode(loopNode, loopKind, loopCount, forVar, forFrom, forStep) {
    for k in ["count", "name", "from", "to", "step"]
        if loopNode.Has(k)
            loopNode.Delete(k)
    switch loopKind {
        case "for":
            loopNode["type"] := "for"
            loopNode["name"] := Trim(forVar) != "" ? Trim(forVar) : "i"
            loopNode["from"] := forFrom
            loopNode["to"] := loopCount
            loopNode["step"] := forStep
        case "foreach":
            loopNode["type"] := "foreach"
        default:
            loopNode["type"] := "repeat"
            loopNode["count"] := Max(1, Integer(loopCount))
    }
}

V8_FindNodeContainer(list, targetNode, owner := 0) {
    for idx, node in list {
        if node = targetNode
            return {List: list, Index: idx, Owner: owner}
        if node is Map {
            for childList in VMF_Children(node) {
                found := V8_FindNodeContainer(childList, targetNode, node)
                if found
                    return found
            }
        }
    }
    return 0
}

; @summary 1-click preset from right-click menu: applies a pixel shift per round to the selected click step and wraps in a loop.
; @tags macro, vary, preset, v8
V8_ApplyQuickPreset(dx, dy, loopKind := "repeat", loopCount := 10) {
    s := VMB()
    info := VMB_SelectedNode("the click step to vary")
    if !info
        return
    node := info.Node
    if node.Get("type", "") != "click" && node.Get("type", "") != "drag"
        return VMB_Status("Select a Click or Drag step for pixel-offset presets (or press Ctrl+L for all step types).")
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["find"] := "spot"
    if dx != 0
        node["varyDX"] := Integer(dx)
    if dy != 0
        node["varyDY"] := Integer(dy)
    V8_AutoWrapInLoop(s.Macro["blocks"], node, loopKind, loopCount)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("⚡ Applied: shift (" . dx . ", " . dy . ") px per round + wrapped in Repeat " . loopCount . "x loop! Press F5 to play or F10 to step.")
}

; @summary 1-click preset from right-click menu: turns the selected step into a dynamic repeated key press per round + wraps in a loop.
; @tags macro, vary, preset, v8
V8_ApplyQuickKeyPreset(keyName, startCount, stepCount, loopKind := "repeat", loopCount := 10) {
    s := VMB()
    info := VMB_SelectedNode("the step to vary")
    if !info
        return
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["type"] := "keys"
    node["keys"] := "{" . keyName . "}"
    node["varyKey"] := 1
    node["varyKeyName"] := keyName
    node["varyKeyStart"] := Integer(startCount)
    node["varyKeyStep"] := Integer(stepCount)
    V8_AutoWrapInLoop(s.Macro["blocks"], node, loopKind, loopCount)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("⚡ Applied: press {" . keyName . "} " . startCount . "x on round 1, +" . stepCount . "x each round + wrapped in Repeat " . loopCount . "x loop!")
}

; @summary 1-click preset from right-click menu: sets a Type step to an incrementing variable/column and wraps in a loop.
; @tags macro, vary, preset, v8
V8_ApplyQuickTextPreset(templateText, loopKind := "repeat", loopCount := 10) {
    s := VMB()
    info := VMB_SelectedNode("the step to vary")
    if !info
        return
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["type"] := "text"
    node["text"] := templateText
    VM__SetOrDelete(node, "ask", "")
    V8_AutoWrapInLoop(s.Macro["blocks"], node, loopKind, loopCount)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("⚡ Applied: type '" . templateText . "' each round + wrapped in Repeat " . loopCount . "x loop!")
}

; @summary 2-Click Row-1 -> Row-2 Auto-Measure on screen: point at Row 1 and press F6, then point at Row 2 and press F6.
;          Automatically calculates the exact DX/DY pixel stride, sets Row 1 as the starting spot, and wraps in a loop!
; @tags macro, vary, measure, v8
V8_MeasureTwoPointsOnScreen() {
    s := VMB()
    wasVis := s.Gui && DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int")
    if wasVis
        s.Gui.Hide()
    V5_HideOverlays()
    try {
        p1 := VM_UiPickPoint("📏 Step 1 of 2: Point at ROW 1 (first click spot) and press F6.   (Esc cancels)")
        if !p1
            return 0
        SoundBeep(750, 90)
        Sleep(180)
        p2 := VM_UiPickPoint("📏 Step 2 of 2: Now point at ROW 2 (next click spot) and press F6.   (Esc cancels)")
        if !p2
            return 0
        SoundBeep(950, 90)
        return {X1: p1.X, Y1: p1.Y, X2: p2.X, Y2: p2.Y, DX: p2.X - p1.X, DY: p2.Y - p1.Y}
    } finally {
        V5_RestoreOverlays()
        if wasVis
            s.Gui.Show()
    }
}

V8_QuickMeasureStrideForSelected(*) {
    s := VMB()
    info := VMB_SelectedNode("the click step to measure Row 1 -> Row 2 for")
    if !info
        return
    m := V8_MeasureTwoPointsOnScreen()
    if !m
        return VMB_Status("Row measurement cancelled.")
    ans := InputBox("Measured exact stride from Row 1 (" . m.X1 . ", " . m.Y1 . ") to Row 2 (" . m.X2 . ", " . m.Y2 . "):`n"
        . "  • Horizontal shift (DX): " . m.DX . " px per round`n"
        . "  • Vertical shift (DY):   " . m.DY . " px per round`n`n"
        . "How many total rounds / rows should the loop run?", "📏 Auto-Measure & Loop", "w420 h190", "10")
    if ans.Result != "OK"
        return
    cnt := RegExMatch(Trim(ans.Value), "^\d+$") ? Max(1, Integer(Trim(ans.Value))) : 10
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    fresh := VM_CaptureClickStep(m.X1, m.Y1, node.Get("button", "Left"), node.Get("count", 1))
    for k in ["x", "y", "scrX", "scrY", "rx", "ry", "offsetX", "offsetY", "q", "pattern", "win"]
        node[k] := fresh[k]
    VM__SetOrDelete(node, "geo", fresh.Get("geo", ""))
    node["find"] := "spot"
    if m.DX != 0
        node["varyDX"] := m.DX
    if m.DY != 0
        node["varyDY"] := m.DY
    V8_AutoWrapInLoop(s.Macro["blocks"], node, "repeat", cnt)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("📏 Measured (" . m.DX . ", " . m.DY . ") px per round and wrapped in a Repeat " . cnt . "x loop!")
}

; @summary Multi-spot screen picker: point at Spot 1, Spot 2, Spot 3... pressing F6 on each, then press Esc when done.
;          Automatically sets the step to cycle through those exact spots and sets the Repeat count to match!
; @tags macro, vary, spots, v8
V8_PickMultipleSpotsOnScreen() {
    s := VMB()
    wasVis := s.Gui && DllCall("IsWindowVisible", "Ptr", s.Gui.Hwnd, "Int")
    if wasVis
        s.Gui.Hide()
    V5_HideOverlays()
    spots := []
    try {
        loop {
            pt := VM_UiPickPoint("🎯 Multi-Spot Picker (" . spots.Length . " captured so far):`nPoint at Spot #" . (spots.Length + 1) . " and press F6.   Press Esc when finished!")
            if !pt
                break
            SoundBeep(800, 70)
            captured := VM_CaptureClickStep(pt.X, pt.Y, "Left", 1)
            spotEntry := Map("scrX", captured["scrX"], "scrY", captured["scrY"])
            if captured.Has("rx")
                spotEntry["rx"] := captured["rx"], spotEntry["ry"] := captured["ry"]
            if captured.Has("geo")
                spotEntry["geo"] := captured["geo"]
            spots.Push(spotEntry)
            Sleep(180)
        }
    } finally {
        V5_RestoreOverlays()
        if wasVis
            s.Gui.Show()
    }
    return spots
}

V8_QuickPickSpotsForSelected(*) {
    s := VMB()
    info := VMB_SelectedNode("the click step to pick multiple spots for")
    if !info
        return
    spots := V8_PickMultipleSpotsOnScreen()
    if !spots.Length
        return VMB_Status("No spots captured.")
    node := info.Node
    VMB_Snapshot()
    V8_ClearVaryProps(node)
    node["type"] := "click"
    node["find"] := "spot"
    node["scrX"] := spots[1]["scrX"], node["scrY"] := spots[1]["scrY"]
    node["varySpots"] := spots
    V8_AutoWrapInLoop(s.Macro["blocks"], node, "repeat", spots.Length)
    s.Dirty := true
    VMB_Refresh(node)
    V7_AutoSaveNow()
    VMB_Status("🎯 Captured " . spots.Length . " spots and wrapped your macro in a Repeat " . spots.Length . "x loop!")
}

; @summary Opens the Smart Vary & 1-Click Auto-Loop wizard for the currently selected step in the macro tree.
; @tags macro, vary, gui, v8
V8_VarySelectedDialog(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    info := VMB_SelectedNode("the step that changes on each round")
    if !info
        return
    if !VMF_IsStep(info.Node)
        return VMB_Status("Select a step (such as a Click, Press keys, or Type text step) to make it vary across rounds.")
    V8_VaryDialog(info.Node)
}

; @summary The V8 "Make This Step Vary & Auto-Loop" dialog: lets you pick how the step changes on each round AND
;          automatically wraps your recorded steps in a Repeat / For / For-Each-Row loop in a single click.
; @tags macro, vary, loop, gui, v8
V8_VaryDialog(node, scopeSteps := 0) {
    s := VMB()
    idx := s.FlatIndex.Get(node, "?")
    t := node.Get("type", "click")
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "⚡ Make Step #" . idx . " Vary & Auto-Loop — Visual Macro Blocks V8")
    dlg.SetFont("s10 bold", "Segoe UI")
    dlg.AddText("xm ym w660 c0A84FF", "⚡ Turn one changing step into a smart loop in 1 click")
    dlg.SetFont("s9 norm", "Segoe UI")
    sum := VM_StepSummary(node)
    dlg.AddText("xm y+4 w660 c505050", "Selected step:   #" . idx . "   " . sum[1] . "   " . sum[3] . (sum[2] != "" ? "   [" . sum[2] . "]" : ""))

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w660", "1. How should this step change on each round of the loop?")
    dlg.SetFont("s9 norm", "Segoe UI")

    hasSpots := node.Get("varySpots", "") is Array && node["varySpots"].Length > 0
    hasKeyVary := node.Get("varyKey", 0) != 0
    defaultMode := hasSpots ? 2 : hasKeyVary ? 3 : t = "keys" ? 3 : t = "text" ? 4 : 1

    rPixel := dlg.AddRadio("xm y+6" . (defaultMode = 1 ? " Checked" : ""), "📍 Move click spot by pixels each round (e.g. next row down in a table or list)")
    dlg.AddText("xm+24 y+6", "Shift X per round (px):")
    edDX := dlg.AddEdit("x+6 yp-3 w65", node.Get("varyDX", 0))
    dlg.AddText("x+14 yp+3", "Shift Y per round (px, + = down):")
    edDY := dlg.AddEdit("x+6 yp-3 w65", node.Get("varyDY", 24))
    btnMeasure := dlg.AddButton("x+12 yp-1 w215 h25", "📏 Point at Row 1 & Row 2 (F6)...")

    dlg.AddText("xm+24 y+6 c606060", "Quick row-height presets:")
    btnP20 := dlg.AddButton("x+8 yp-3 w64 h22", "↓ +20 px")
    btnP24 := dlg.AddButton("x+4 yp w64 h22", "↓ +24 px")
    btnP30 := dlg.AddButton("x+4 yp w64 h22", "↓ +30 px")
    btnP40 := dlg.AddButton("x+4 yp w64 h22", "↓ +40 px")
    btnPRight := dlg.AddButton("x+4 yp w80 h22", "→ +100 px X")

    rSpots := dlg.AddRadio("xm y+12" . (defaultMode = 2 ? " Checked" : ""), "🎯 Cycle through a list of specific screen spots (Spot 1 on round 1, Spot 2 on round 2...)")
    pickedSpots := hasSpots ? node["varySpots"].Clone() : []
    txtSpots := dlg.AddText("xm+24 y+6 w380 c505050", pickedSpots.Length ? pickedSpots.Length . " spot(s) recorded." : "(No multi-spots picked yet)")
    btnPickSpots := dlg.AddButton("x+8 yp-4 w220 h25", "🎯 Pick spots on screen (F6)...")

    rKeys := dlg.AddRadio("xm y+12" . (defaultMode = 3 ? " Checked" : ""), "⌨ Press a key more times each round (e.g. Down arrow 1x, then 2x, then 3x...)")
    dlg.AddText("xm+24 y+6", "Key:")
    cbKey := dlg.AddComboBox("x+6 yp-3 w110", ["Down", "Up", "Tab", "Right", "Left", "PgDn", "Enter", "Space"])
    cbKey.Text := node.Get("varyKeyName", "Down")
    dlg.AddText("x+14 yp+3", "Presses on Round 1:")
    edKeyStart := dlg.AddEdit("x+6 yp-3 w55 Number", node.Get("varyKeyStart", 1))
    dlg.AddText("x+14 yp+3", "Add per round:")
    edKeyStep := dlg.AddEdit("x+6 yp-3 w55", node.Get("varyKeyStep", 1))

    rText := dlg.AddRadio("xm y+12" . (defaultMode = 4 ? " Checked" : ""), "🔢 Type a changing number, counter, or data column ({{index}}, {{i}}, {{Column}})")
    dlg.AddText("xm+24 y+6", "Text / template to type:")
    edText := dlg.AddEdit("x+6 yp-3 w260", node.Get("type", "") = "text" && node.Get("text", "") != "" ? node["text"] : "{{index}}")
    cols := VMB_ColumnChoices()
    ddCol := dlg.AddDropDownList("x+8 yp w140", cols)
    if cols.Length
        ddCol.Value := 1
    btnInsCol := dlg.AddButton("x+4 yp-1 w85 h24", "Insert {{...}}")

    ; Loop auto-wrap section
    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+16 w660", "2. Automatically wrap your steps in a loop (no manual dragging needed):")
    dlg.SetFont("s9 norm", "Segoe UI")
    chkWrap := dlg.AddCheckbox("xm y+6 Checked", "Wrap the macro steps in a loop automatically:")
    ddLoop := dlg.AddDropDownList("x+8 yp-3 w270", [
        "Repeat N times (uses {{index}} = 1, 2, 3...)",
        "For counter variable (e.g. i = 1 to N)",
        "For each row in Data File ({{Column}})"])
    ddLoop.Value := VMB_HasData() && defaultMode = 4 ? 3 : 1
    dlg.AddText("xm+24 y+8", "How many rounds (N):")
    edCount := dlg.AddEdit("x+6 yp-3 w70 Number", pickedSpots.Length ? pickedSpots.Length : 10)
    dlg.AddText("x+16 yp+3", "For variable name:")
    edVar := dlg.AddEdit("x+6 yp-3 w65", "i")
    dlg.AddText("x+12 yp+3", "Start at:")
    edFrom := dlg.AddEdit("x+6 yp-3 w55", "1")
    dlg.AddText("x+12 yp+3", "Step by:")
    edStep := dlg.AddEdit("x+6 yp-3 w55", "1")

    ; Ensure mutual exclusion across all 4 radio buttons
    radios := [rPixel, rSpots, rKeys, rText]
    selectRadio(which, *) {
        for r in radios
            r.Value := (r = which ? 1 : 0)
    }
    for r in radios
        r.OnEvent("Click", selectRadio.Bind(r))

    btnP20.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 20))
    btnP24.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 24))
    btnP30.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 30))
    btnP40.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 0, edDY.Value := 40))
    btnPRight.OnEvent("Click", (*) => (selectRadio(rPixel), edDX.Value := 100, edDY.Value := 0))

    btnMeasure.OnEvent("Click", (*) => (
        dlg.Hide(),
        m := V8_MeasureTwoPointsOnScreen(),
        dlg.Show(),
        m ? (
            selectRadio(rPixel),
            edDX.Value := m.DX,
            edDY.Value := m.DY,
            node["scrX"] := m.X1, node["scrY"] := m.Y1,
            node["x"] := m.X1, node["y"] := m.Y1
        ) : 0
    ))

    btnPickSpots.OnEvent("Click", (*) => (
        dlg.Hide(),
        pts := V8_PickMultipleSpotsOnScreen(),
        dlg.Show(),
        pts.Length ? (
            selectRadio(rSpots),
            pickedSpots := pts,
            txtSpots.Text := pickedSpots.Length . " spot(s) captured! Loop count set to " . pickedSpots.Length . ".",
            edCount.Value := pickedSpots.Length
        ) : 0
    ))

    btnInsCol.OnEvent("Click", (*) => (selectRadio(rText), ddCol.Text != "" ? EditPaste("{{" . ddCol.Text . "}}", edText) : 0))

    btnApply := dlg.AddButton("xm y+16 w210 h30 Default", "⚡ Apply Vary & Auto-Loop")
    btnClear := dlg.AddButton("x+8 yp w150 h30", "Clear Variation")
    btnCancel := dlg.AddButton("x+8 yp w100 h30", "Cancel")

    applyVary(*) {
        try {
            VMB_Snapshot()
            V8_ClearVaryProps(node)
            if rPixel.Value {
                if !IsInteger(Trim(edDX.Value)) || !IsInteger(Trim(edDY.Value))
                    throw Error("Shift X and Shift Y must be whole numbers (e.g. 0 and 24).")
                node["find"] := "spot"
                dx := Integer(Trim(edDX.Value)), dy := Integer(Trim(edDY.Value))
                if dx != 0
                    node["varyDX"] := dx
                if dy != 0
                    node["varyDY"] := dy
            } else if rSpots.Value {
                if !pickedSpots.Length
                    throw Error("Click 'Pick spots on screen (F6)...' to capture at least 1 spot first.")
                node["type"] := "click"
                node["find"] := "spot"
                node["scrX"] := pickedSpots[1]["scrX"], node["scrY"] := pickedSpots[1]["scrY"]
                node["varySpots"] := pickedSpots
            } else if rKeys.Value {
                kName := Trim(cbKey.Text)
                if kName = ""
                    throw Error("Choose or type a key name (such as Down or Tab).")
                node["type"] := "keys"
                node["keys"] := "{" . kName . "}"
                node["varyKey"] := 1
                node["varyKeyName"] := kName
                node["varyKeyStart"] := IsInteger(Trim(edKeyStart.Value)) ? Integer(Trim(edKeyStart.Value)) : 1
                node["varyKeyStep"] := IsInteger(Trim(edKeyStep.Value)) ? Integer(Trim(edKeyStep.Value)) : 1
            } else if rText.Value {
                node["type"] := "text"
                node["text"] := edText.Value
                VM__SetOrDelete(node, "ask", "")
            }
            if chkWrap.Value {
                loopKinds := ["repeat", "for", "foreach"]
                lKind := loopKinds[Max(1, ddLoop.Value)]
                lCount := IsInteger(Trim(edCount.Value)) ? Max(1, Integer(Trim(edCount.Value))) : 10
                fVar := Trim(edVar.Value) != "" ? Trim(edVar.Value) : "i"
                fFrom := IsNumber(Trim(edFrom.Value)) ? Number(Trim(edFrom.Value)) : 1
                fStep := IsNumber(Trim(edStep.Value)) && Number(Trim(edStep.Value)) != 0 ? Number(Trim(edStep.Value)) : 1
                if lKind = "for"
                    node["varyVar"] := fVar
                V8_AutoWrapInLoop(s.Macro["blocks"], node, lKind, lCount, fVar, fFrom, fStep, scopeSteps)
            }
            s.Dirty := true
            dlg.Destroy()
            VMB_Refresh(node)
            V7_AutoSaveNow()
            VMB_Status("⚡ Smart Vary & Auto-Loop applied! Press F5 to play or F10 to step through it.")
        } catch as err {
            MsgBox(err.Message, "Smart Vary & Auto-Loop", "Icon! Owner" . dlg.Hwnd)
        }
    }

    btnApply.OnEvent("Click", applyVary)
    btnClear.OnEvent("Click", (*) => (dlg.Destroy(), V8_ClearVaryOnSelected()))
    btnCancel.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    dlg.Show()
}

; ============================================================================
; V10 CLASSICAL NON-OCR / NON-IMAGE DETERMINISTIC AUTOMATION ENGINE
; - Region CRC32 State-Machine Waits (GDI BitBlt + ntdll\RtlComputeCrc32)
; - Semantic Single-Pixel & Color-Family Sentinels
; - Geometry-Anchored & Edge-Relative Coordinates (TopLeft/BottomCenter/TopRight/Center/Pct)
; - Layout Physics & Deterministic List/Dropdown Row Predictor (Partitioned Sort + Conditional Shift)
; - Human-Physics Mouse (WindMouse / Minimum-Jerk trajectory + Hover-Dwell) & Citrix 3-Stage Field Clear
; - Interactive "Deterministic Inspector & Layout Physics Lab" (Ctrl+Shift+D)
; ============================================================================

; @summary Definitions for all V10 Classical Deterministic blocks in the left toolbox.
; @tags macro, deterministic, crc32, pixel, anchor, layout-physics, v10
V10_DetDefs() {
    static defs := 0
    if defs
        return defs
    defs := Map()
    target := ["target", "Window selector (blank = Macro window, else active/recorded; e.g. ahk_exe wfica32.exe)", "text"]
    defs["det_anchor_click"] := {
        Label: "Anchor-Relative Click (No Image/OCR)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("anchor", "BottomCenter", "dx", -41, "dy", -60, "pctX", 50, "pctY", 50,
            "button", "Left", "count", 1, "hoverMs", 40, "target", ""),
        Fields: [
            ["anchor", "Window Geometry Anchor (why the control sits where it does)", "choice",
                ["TopLeft", "BottomCenter", "TopRight", "BottomRight", "BottomLeft", "Center", "ProportionalPct"]],
            ["dx", "Offset X from anchor in pixels (e.g. -41 from BottomCenter)", "number"],
            ["dy", "Offset Y from anchor in pixels (e.g. -60 from BottomCenter)", "number"],
            ["pctX", "Proportional X % (0-100, used when anchor = ProportionalPct)", "number"],
            ["pctY", "Proportional Y % (0-100, used when anchor = ProportionalPct)", "number"],
            ["button", "Mouse button", "choice", ["Left", "Right", "Middle"]],
            ["count", "Click count (1 or 2)", "number"],
            ["hoverMs", "Hover dwell before click in ms (prevents dropdown/menu auto-close)", "number"],
            target
        ],
        Desc: "Clicks by window layout math (Dialog Right/Bottom Anchors or Proportional %) instead of brittle screen pixels or image search."
    }
    defs["det_human_click"] := {
        Label: "Human-Physics Click (WindMouse + Hover Dwell)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x", 300, "y", 200, "coordRel", "Window", "profile", "MinimumJerk",
            "durationMs", 180, "hoverMs", 65, "button", "Left", "count", 1, "target", ""),
        Fields: [
            ["x", "Target X (supports {{variables}})", "text"],
            ["y", "Target Y (supports {{variables}})", "text"],
            ["coordRel", "Coordinates relative to", "choice", ["Window", "Screen"]],
            ["profile", "Trajectory physics model", "choice", ["MinimumJerk", "WindMouse", "Instant"]],
            ["durationMs", "Movement duration in milliseconds (0 = instant)", "number"],
            ["hoverMs", "Pre-click hover dwell in milliseconds (triggers WM_MOUSEHOVER / menu open)", "number"],
            ["button", "Mouse button", "choice", ["Left", "Right", "Middle"]],
            ["count", "Click count (1 or 2)", "number"],
            target
        ],
        Desc: "Replicates human hand physics (Flash & Hogan minimum-jerk curve or WindMouse gravity/wind) + hover dwell so custom UIs never drop clicks."
    }
    defs["det_predict_row"] := {
        Label: "Predict & Select List/Dropdown Row (Layout Physics)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("wantItem", "{{Product}}", "allItems", "", "tickedItems", "",
            "sortRule", "Partitioned_TickedFirst_AZ", "conditionalShiftItems", "541-RX-CLINIC-IP",
            "selectMethod", "CheckboxClick", "row1X", 175, "row1Y", 388, "rowHeight", 17,
            "maxVisibleRows", 6, "variable", "predicted_row", "target", ""),
        Fields: [
            ["wantItem", "Target item to find/click (or {{Column}} / {{variable}})", "text"],
            ["allItems", "All candidate items (comma or newline separated)", "multiline"],
            ["tickedItems", "Currently ticked/active items (for Partitioned Sort: Ticked A-Z then Unticked A-Z)", "multiline"],
            ["sortRule", "How the application's code orders the list", "choice",
                ["Partitioned_TickedFirst_AZ", "Alphabetical_AZ", "ExactGivenOrder"]],
            ["conditionalShiftItems", "Conditional items omitted when unticked (shifts later rows up by 1)", "text"],
            ["selectMethod", "How to select the predicted row", "choice",
                ["CheckboxClick", "KeyboardHomeDownSpace", "StoreRowOnly"]],
            ["row1X", "Row 1 click X (window-relative)", "number"],
            ["row1Y", "Row 1 click Y (window-relative, e.g. 388)", "number"],
            ["rowHeight", "Exact row stride height in pixels (e.g. 17)", "number"],
            ["maxVisibleRows", "Max visible rows before scrollbar is required (0 = no limit)", "number"],
            ["variable", "Store 1-based predicted row index in variable", "text"],
            target
        ],
        Desc: "Calculates exact row position and pixel Y = row1Y + (row-1)*rowHeight from the app's sort/partition algorithm — zero OCR required."
    }
    defs["det_wait_settled"] := {
        Label: "Wait for Region CRC32 Change & Settle",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x1", 165, "y1", 95, "x2", 660, "y2", 190, "waitForChangeMs", 1500,
            "stableMs", 150, "timeoutMs", 10000, "compareVar", "", "variable", "region_crc", "target", ""),
        Fields: [
            ["x1", "Region Left X1 (window-relative)", "number"],
            ["y1", "Region Top Y1 (window-relative)", "number"],
            ["x2", "Region Right X2 (window-relative)", "number"],
            ["y2", "Region Bottom Y2 (window-relative)", "number"],
            ["waitForChangeMs", "Phase 1: Max ms to wait for region to START changing (0 = skip Phase 1)", "number"],
            ["stableMs", "Phase 2: Ms region must stay 100% identical to count as settled", "number"],
            ["timeoutMs", "Overall timeout in milliseconds", "number"],
            ["compareVar", "Optional variable holding previous CRC32 (sets {{compareVar}}_unchanged = 1 at end-of-list!)", "text"],
            ["variable", "Store final settled 32-bit CRC hex in variable", "text"],
            target
        ],
        Desc: "Hashes rectangle pixels via GDI BitBlt + ntdll\\RtlComputeCrc32. Replaces fixed Sleeps and detects end-of-list when CRC stops changing."
    }
    defs["det_wait_pixel"] := {
        Label: "Wait for Pixel Sentinel (Color / State)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x", 300, "y", 76, "colorMode", "DiscernYellow", "colorHex", "FFFF80",
            "tolerance", 40, "appear", 1, "timeoutMs", 15000, "target", ""),
        Fields: [
            ["x", "Pixel X (window-relative)", "number"],
            ["y", "Pixel Y (window-relative)", "number"],
            ["colorMode", "Semantic color state to check", "choice",
                ["DiscernYellow", "NearHex", "CernerDoorBlue", "HighlightBlue", "DisabledGrey", "WhiteReady"]],
            ["colorHex", "Reference RGB Hex (RRGGBB, used when mode = NearHex)", "text"],
            ["tolerance", "Per-channel RGB tolerance (0-255, used when mode = NearHex)", "number"],
            ["appear", "Wait until state is TRUE (uncheck = wait until state goes away)", "check"],
            ["timeoutMs", "Timeout in milliseconds", "number"],
            target
        ],
        Desc: "Waits for a 1-pixel UI state change (e.g. yellow active input, blue selection highlight, or portal door icon) in <1 ms per check."
    }
    defs["det_if_pixel"] := {
        Label: "If Pixel Sentinel Matches / Else...",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("cond", "pixel", "x", 250, "y", 342, "colorMode", "DiscernYellow",
            "colorHex", "FFFF80", "tolerance", 40, "appear", 1, "target", ""),
        Fields: [
            ["x", "Pixel X (window-relative)", "number"],
            ["y", "Pixel Y (window-relative)", "number"],
            ["colorMode", "Semantic color state to check", "choice",
                ["DiscernYellow", "NearHex", "CernerDoorBlue", "HighlightBlue", "DisabledGrey", "WhiteReady"]],
            ["colorHex", "Reference RGB Hex (RRGGBB, used when mode = NearHex)", "text"],
            ["tolerance", "Per-channel RGB tolerance (0-255)", "number"],
            ["appear", "Condition is TRUE when pixel matches (uncheck = when it does NOT match)", "check"],
            target
        ],
        Desc: "Branches macro execution (IF / ELSE) based on a single-pixel color state (e.g. detecting {Empty} list when Flex rows stay yellow)."
    }
    defs["det_normalize_win"] := {
        Label: "Normalize Window Geometry (Size & Spot)",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("width", 693, "height", 803, "marginX", 20, "marginY", 20, "strictDpiCheck", 1, "maximize", 0, "target", ""),
        Fields: [
            ["width", "Canonical window width in pixels (e.g. 693)", "number"],
            ["height", "Canonical window height in pixels (e.g. 803)", "number"],
            ["marginX", "Left work-area margin in pixels", "number"],
            ["marginY", "Top work-area margin in pixels", "number"],
            ["maximize", "Maximize the window instead (width, height and margins are ignored)", "check"],
            ["strictDpiCheck", "Check the final size (±4 px); a window that can't reach it is noted in the playback log and the run keeps going", "check"],
            target
        ],
        Desc: "Restores the target window to the exact canonical width/height on the primary work area so window-relative coordinates never miss."
            . " Fixed-size dialogs are only moved."
    }
    defs["det_citrix_fill"] := {
        Label: "Citrix-Safe Field Clear & Type",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("x", 300, "y", 76, "value", "{{Product}}", "pressTab", 1, "settleMs", 250, "target", ""),
        Fields: [
            ["x", "Field click X (window-relative; 0 = do not click first)", "number"],
            ["y", "Field click Y (window-relative; 0 = do not click first)", "number"],
            ["value", "Text to enter (supports {{Column}} / {{variable}})", "text"],
            ["pressTab", "Press {Tab} after typing to trigger query/commit", "check"],
            ["settleMs", "Wait after focus/clear in milliseconds", "number"],
            target
        ],
        Desc: "Clicks field, runs 3-stage Citrix-proof clear (2x End+Shift+Home+Delete + Backspace sweep so dropped modifiers never leave text), types, and Tabs."
    }
    defs["det_use_window"] := {
        Label: "Use Window From Here On",
        Group: "V10 Deterministic (No OCR)",
        Defaults: Map("target", "", "waitSec", 10, "activate", 1),
        Fields: [
            ["target", "Window for the next steps (e.g. ahk_exe notepad.exe; blank = back to Macro window)", "text"],
            ["waitSec", "Wait up to this many seconds for the window to appear", "number"],
            ["activate", "Bring the window to the front now", "check"]
        ],
        Desc: "Switches the window for every later step whose Window selector is blank, until the next Use Window block. "
            . "Put one wherever the macro moves to a different program."
    }
    return defs
}

; @summary Short summary string shown in the macro tree for V10 deterministic steps.
; @tags macro, deterministic, gui, v10
V10_DetStepInfo(node) {
    t := node.Get("type", "")
    switch t {
        case "det_anchor_click":
            anc := node.Get("anchor", "BottomCenter")
            return anc = "ProportionalPct"
                ? "Pct (" . node.Get("pctX", 50) . "%, " . node.Get("pctY", 50) . "%)"
                : anc . " (" . (node.Get("dx", 0) >= 0 ? "+" : "") . node.Get("dx", 0) . ", " . (node.Get("dy", 0) >= 0 ? "+" : "") . node.Get("dy", 0) . ")"
        case "det_human_click":
            return node.Get("profile", "MinimumJerk") . " -> (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") dwell " . node.Get("hoverMs", 65) . "ms"
        case "det_predict_row":
            return "'" . node.Get("wantItem", "") . "' [" . node.Get("sortRule", "Partitioned_TickedFirst_AZ") . " -> " . node.Get("selectMethod", "CheckboxClick") . "]"
        case "det_wait_settled":
            return "rect [" . node.Get("x1", 0) . "," . node.Get("y1", 0) . ".." . node.Get("x2", 0) . "," . node.Get("y2", 0) . "] stable " . node.Get("stableMs", 150) . "ms"
        case "det_wait_pixel":
            return "(" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") = " . node.Get("colorMode", "DiscernYellow")
        case "det_normalize_win":
            return V4_Bool(node.Get("maximize", 0)) ? "maximized" : node.Get("width", 693) . "x" . node.Get("height", 803)
        case "det_citrix_fill":
            return "(" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") := " . SubStr(node.Get("value", ""), 1, 40)
        case "det_use_window":
            return node.Get("target", "") = "" ? "(back to Macro window)" : node["target"]
    }
    return ""
}

; @summary Validates a V10 deterministic block before saving or running.
; @tags macro, deterministic, validate, v10
V10_DetValidate(node) {
    t := node.Get("cond", "") = "pixel" ? "det_if_pixel" : node.Get("type", "")
    if !V10_DetDefs().Has(t)
        throw Error("Unknown V10 deterministic block: " . t)
    if t = "det_wait_settled" {
        if Integer(node.Get("x2", 0)) <= Integer(node.Get("x1", 0)) || Integer(node.Get("y2", 0)) <= Integer(node.Get("y1", 0))
            throw Error("Region X2/Y2 must be greater than X1/Y1.")
        if Integer(node.Get("stableMs", 150)) < 10
            throw Error("stableMs must be at least 10 ms.")
    }
    if t = "det_normalize_win" {
        if Integer(node.Get("width", 0)) < 50 || Integer(node.Get("height", 0)) < 50
            throw Error("Window width and height must be at least 50 pixels.")
    }
    if t = "det_predict_row" {
        if Integer(node.Get("rowHeight", 17)) < 1
            throw Error("rowHeight must be at least 1 pixel.")
    }
}

; @summary Window for a step with a blank Window selector: the last "Use Window From Here On", else the Macro window.
; @tags macro, window, v16
V16_FallbackTarget(ctx) {
    if !IsObject(ctx)
        return ""
    if ctx.HasOwnProp("UseTarget") && ctx.UseTarget != ""
        return ctx.UseTarget
    return ctx.HasOwnProp("Settings") ? Trim(ctx.Expand(ctx.Settings.Get("defaultTarget", ""))) : ""
}

; @summary Runs a "Use Window From Here On" block: waits for the window, optionally activates it, and makes it the
;          window for later steps with a blank Window selector (blank target = back to the Macro window).
; @tags macro, window, play, v16
V16_UseWindow(node, ctx) {
    want := Trim(ctx.Expand(node.Get("target", "")))
    ctx.UseTarget := want
    if want = ""
        want := V16_FallbackTarget(ctx)
    if want = ""
        return
    deadline := A_TickCount + Max(0, Number(node.Get("waitSec", 10))) * 1000
    while !(hwnd := WinExist(want)) {
        if A_TickCount >= deadline
            throw Error("Use Window: '" . want . "' did not appear within " . node.Get("waitSec", 10) . " s.")
        ctx.Sleep(100)
    }
    if V4_Bool(node.Get("activate", 1)) {
        WinActivate("ahk_id " . hwnd)
        if !WinWaitActive("ahk_id " . hwnd, , 3)
            throw Error("Use Window: '" . want . "' did not come to the front.")
    }
}

; @summary Resolves the target window HWND for a V10 deterministic step (activates it if needed).
; @tags macro, deterministic, window, v10
V10_ResolveWindow(node, ctx := 0) {
    target := Trim(IsObject(ctx) ? ctx.Expand(node.Get("target", "")) : node.Get("target", ""))
    if target = ""
        target := V16_FallbackTarget(ctx)
    if target != "" {
        hwnd := WinExist(target)
        if !hwnd && V18_Steady(ctx)     ; V18: give the window time to open, then stop with a clear message
            hwnd := V18_WaitTarget(target, ctx)
        if !hwnd
            return V4_Window(node)
        if V18_Steady(ctx)
            V18_Activate(hwnd, ctx, true)
        else if !WinActive("ahk_id " . hwnd) {
            WinActivate("ahk_id " . hwnd)
            WinWaitActive("ahk_id " . hwnd, , 2)
        }
        return hwnd
    }
    return V4_Window(node, ctx)
}

; @summary Computes exact screen and window-relative coordinates from a window geometry anchor:
;          TopLeft, BottomCenter, TopRight, BottomRight, BottomLeft, Center, or ProportionalPct.
; @returns {ScreenX, ScreenY, WinX, WinY, W, H}
; @tags macro, deterministic, anchor, geometry, v10
V10_CalcAnchorPoint(winW, winH, anchor, dx := 0, dy := 0, pctX := 50, pctY := 50, winX := 0, winY := 0) {
    winW := Max(1, Integer(winW)), winH := Max(1, Integer(winH))
    dx := Integer(dx), dy := Integer(dy)
    switch anchor {
        case "BottomCenter":
            rx := (winW // 2) + dx, ry := winH + dy
        case "TopRight":
            rx := winW + dx, ry := dy
        case "BottomRight":
            rx := winW + dx, ry := winH + dy
        case "BottomLeft":
            rx := dx, ry := winH + dy
        case "Center":
            rx := (winW // 2) + dx, ry := (winH // 2) + dy
        case "ProportionalPct":
            rx := Round(winW * (Number(pctX) / 100.0)) + dx
            ry := Round(winH * (Number(pctY) / 100.0)) + dy
        default: ; TopLeft
            rx := dx, ry := dy
    }
    return {WinX: rx, WinY: ry, ScreenX: winX + rx, ScreenY: winY + ry, W: winW, H: winH}
}

; @summary Evaluates a color integer (0xRRGGBB) against a V10 semantic pixel sentinel mode.
; @tags macro, deterministic, pixel, color, v10
V10_MatchColorSentinel(c, mode := "DiscernYellow", hexRef := "FFFF80", tol := 40) {
    c := Integer(c)
    r := (c >> 16) & 0xFF, g := (c >> 8) & 0xFF, b := c & 0xFF
    switch mode {
        case "DiscernYellow":
            ; Cerner Discern Prompt yellow input/row background (FFFF80-ish: high R & G, lower B)
            return r > 0xF0 && g > 0xF0 && b < 0xB0
        case "CernerDoorBlue":
            ; Reporting Portal exit door icon (0x9999FF-ish)
            return Abs(r - 0x99) < 40 && Abs(g - 0x99) < 40 && Abs(b - 0xFF) < 40
        case "HighlightBlue":
            ; Standard Windows / Citrix selection highlight (low R, medium-high G/B or classic Navy 000080 / 0078D7)
            return (b > 0x70 && b > r + 40)
        case "DisabledGrey":
            ; Neutral grey where R, G, B are within 12 of each other and between 0x80 and 0xE8
            return Abs(r - g) <= 12 && Abs(g - b) <= 12 && r >= 0x80 && r <= 0xE8
        case "WhiteReady":
            return r > 0xF0 && g > 0xF0 && b > 0xF0
        default: ; NearHex
            clean := RegExReplace(Trim(hexRef), "i)^0x|^#")
            ref := IsXDigit(clean) && StrLen(clean) ? Integer("0x" . clean) : 0xFFFF80
            rr := (ref >> 16) & 0xFF, rg := (ref >> 8) & 0xFF, rb := ref & 0xFF
            tol := Max(0, Integer(tol))
            return Abs(r - rr) <= tol && Abs(g - rg) <= tol && Abs(b - rb) <= tol
    }
}

IsXDigit(str) => RegExMatch(str, "i)^[0-9a-f]+$") != 0

; @summary Reads a window-relative pixel and checks it against the node's semantic sentinel settings.
; @tags macro, deterministic, pixel, v10
V10_CheckPixelSentinel(node, ctx := 0) {
    hwnd := V10_ResolveWindow(node, ctx)
    WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
    px := wx + Integer(node.Get("x", 0)), py := wy + Integer(node.Get("y", 0))
    V5_HideOverlays(px, py)
    CoordMode("Pixel", "Screen")
    c := PixelGetColor(px, py)
    return V10_MatchColorSentinel(c, node.Get("colorMode", "DiscernYellow"),
        IsObject(ctx) ? ctx.Expand(node.Get("colorHex", "FFFF80")) : node.Get("colorHex", "FFFF80"),
        node.Get("tolerance", 40))
}

; @summary Computes a fast 32-bit hardware CRC32 hash of a window-relative rectangle's pixels using GDI BitBlt + ntdll\RtlComputeCrc32.
;          Takes ~0.3 ms and requires zero disk I/O, zero OCR, and zero image template files.
; @tags macro, deterministic, crc32, gdi, v10
V10_RegionCRC(hwnd, x1, y1, x2, y2) {
    WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
    x := wx + Integer(x1), y := wy + Integer(y1)
    w := Max(1, Integer(x2) - Integer(x1)), h := Max(1, Integer(y2) - Integer(y1))
    V5_HideOverlays()
    hdcScreen := DllCall("GetDC", "Ptr", 0, "Ptr")
    hdcMem := DllCall("CreateCompatibleDC", "Ptr", hdcScreen, "Ptr")
    bi := Buffer(40, 0)
    NumPut("UInt", 40, bi, 0), NumPut("Int", w, bi, 4), NumPut("Int", -h, bi, 8)
    NumPut("UShort", 1, bi, 12), NumPut("UShort", 32, bi, 14)
    bits := 0
    hbm := DllCall("CreateDIBSection", "Ptr", hdcMem, "Ptr", bi, "UInt", 0, "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
    old := DllCall("SelectObject", "Ptr", hdcMem, "Ptr", hbm, "Ptr")
    DllCall("BitBlt", "Ptr", hdcMem, "Int", 0, "Int", 0, "Int", w, "Int", h, "Ptr", hdcScreen, "Int", x, "Int", y, "UInt", 0x00CC0020)
    crc := DllCall("ntdll\RtlComputeCrc32", "UInt", 0, "Ptr", bits, "UInt", w * h * 4, "UInt")
    DllCall("SelectObject", "Ptr", hdcMem, "Ptr", old)
    DllCall("DeleteObject", "Ptr", hbm)
    DllCall("DeleteDC", "Ptr", hdcMem)
    DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcScreen)
    return Format("0x{:08X}", crc & 0xFFFFFFFF)
}

; @summary Two-Phase Region CRC32 State Machine:
;          Phase 1 (optional): Waits up to waitForChangeMs for the region's CRC32 to DIFFER from its initial value (reacting!).
;          Phase 2: Waits until the region's CRC32 remains completely unchanged for stableMs (settled!).
; @tags macro, deterministic, crc32, wait, v10
V10_WaitRegionSettled(hwnd, x1, y1, x2, y2, waitForChangeMs := 1500, stableMs := 150, timeoutMs := 10000, runner := 0) {
    t0 := A_TickCount
    before := V10_RegionCRC(hwnd, x1, y1, x2, y2)
    if waitForChangeMs > 0 {
        while V10_RegionCRC(hwnd, x1, y1, x2, y2) = before && (A_TickCount - t0) < waitForChangeMs {
            if IsObject(runner)
                runner.Sleep(20)
            else
                Sleep(20)
        }
    }
    last := V10_RegionCRC(hwnd, x1, y1, x2, y2), since := A_TickCount
    while (A_TickCount - since) < stableMs && (A_TickCount - t0) < timeoutMs {
        if IsObject(runner)
            runner.Sleep(25)
        else
            Sleep(25)
        cur := V10_RegionCRC(hwnd, x1, y1, x2, y2)
        if cur != last
            last := cur, since := A_TickCount
    }
    return last
}

; @summary Predicts the exact 1-based row position and pixel coordinate of an item inside a sorted/partitioned list or dropdown
;          (such as Cerner Discern Prompt's Pharmacy Selection list where ticked items sort A-Z at the top, followed by unticked A-Z,
;          and conditional items like 541-RX-CLINIC-IP shift subsequent rows when absent).
; @returns {Found, Row, ClickX, ClickY, DownCount, Order, ShiftedByConditional}
; @tags macro, deterministic, layout-physics, list, dropdown, v10
V10_PredictListRow(wantItem, allItemsText, tickedItemsText := "", sortRule := "Partitioned_TickedFirst_AZ",
    conditionalShiftText := "", row1X := 175, row1Y := 388, rowHeight := 17) {
    wantItem := Trim(wantItem)
    allList := V10_SplitListItems(allItemsText)
    tickedSet := Map(), tickedSet.CaseSense := false
    for it in V10_SplitListItems(tickedItemsText)
        tickedSet[it] := true
    condSet := Map(), condSet.CaseSense := false
    for it in V10_SplitListItems(conditionalShiftText)
        condSet[it] := true

    order := []
    if sortRule = "Partitioned_TickedFirst_AZ" {
        tBucket := "", uBucket := ""
        for it in allList {
            ; Conditional items that are NOT currently ticked are omitted by the app's query, shifting later rows up!
            if condSet.Has(it) && !tickedSet.Has(it)
                continue
            if tickedSet.Has(it)
                tBucket .= it . "`n"
            else
                uBucket .= it . "`n"
        }
        for part in [tBucket, uBucket] {
            if part != "" {
                for line in StrSplit(Sort(RTrim(part, "`n")), "`n")
                    if Trim(line) != ""
                        order.Push(Trim(line))
            }
        }
    } else if sortRule = "Alphabetical_AZ" {
        bucket := ""
        for it in allList {
            if condSet.Has(it) && !tickedSet.Has(it)
                continue
            bucket .= it . "`n"
        }
        if bucket != "" {
            for line in StrSplit(Sort(RTrim(bucket, "`n")), "`n")
                if Trim(line) != ""
                    order.Push(Trim(line))
        }
    } else { ; ExactGivenOrder
        for it in allList {
            if condSet.Has(it) && !tickedSet.Has(it)
                continue
            order.Push(it)
        }
    }

    foundRow := 0
    for idx, it in order {
        if StrLower(it) = StrLower(wantItem) {
            foundRow := idx
            break
        }
    }
    if !foundRow {
        for idx, it in order {
            if InStr(it, wantItem) || InStr(wantItem, it) {
                foundRow := idx
                break
            }
        }
    }
    clickX := Integer(row1X)
    clickY := foundRow ? Integer(row1Y) + (foundRow - 1) * Integer(rowHeight) : Integer(row1Y)
    return {
        Found: foundRow > 0,
        Row: foundRow,
        ClickX: clickX,
        ClickY: clickY,
        DownCount: Max(0, foundRow - 1),
        Order: order
    }
}

V10_SplitListItems(text) {
    out := [], seen := Map(), seen.CaseSense := false
    for raw in StrSplit(String(text), ["`n", ",", ";"], " `t`r") {
        val := Trim(raw)
        if val != "" && !seen.Has(val) {
            seen[val] := true
            out.Push(val)
        }
    }
    return out
}

; @summary Generates intermediate trajectory waypoints from (x1, y1) to (x2, y2) using either:
;          • MinimumJerk (Flash & Hogan 1985 bell-shaped velocity profile: 10*t^3 - 15*t^4 + 6*t^5)
;          • WindMouse (BenLand100 gravity + wind + velocity clipping)
; @returns Array of {X, Y} waypoints ending at exact {X: x2, Y: y2}
; @tags macro, deterministic, human-mouse, windmouse, minimum-jerk, v10
V10_GenerateMousePath(x1, y1, x2, y2, profile := "MinimumJerk", steps := 14) {
    x1 := Round(x1), y1 := Round(y1), x2 := Round(x2), y2 := Round(y2)
    pts := []
    dist := Sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)
    if dist < 2 || profile = "Instant" || steps <= 1 {
        pts.Push({X: x2, Y: y2})
        return pts
    }
    if profile = "WindMouse" {
        cx := Float(x1), cy := Float(y1), vx := 0.0, vy := 0.0, wx := 0.0, wy := 0.0
        gravity := 9.0, wind := 2.5, maxStep := Max(8.0, dist / Max(4, steps))
        Loop Max(12, steps * 2) {
            rem := Sqrt((x2 - cx) ** 2 + (y2 - cy) ** 2)
            if rem < 2.0
                break
            wMag := Min(wind, rem)
            ; Deterministic pseudo-random oscillation based on step index so paths are organic yet reproducible
            angle := A_Index * 1.9
            wx := wx / 1.414 + (Cos(angle) * wMag) / 2.236
            wy := wy / 1.414 + (Sin(angle) * wMag) / 2.236
            vx += wx + gravity * (x2 - cx) / rem
            vy += wy + gravity * (y2 - cy) / rem
            vMag := Sqrt(vx * vx + vy * vy)
            limit := rem < 18 ? Max(2.0, rem / 2.5) : maxStep
            if vMag > limit {
                vx := (vx / vMag) * limit
                vy := (vy / vMag) * limit
            }
            cx += vx, cy += vy
            pts.Push({X: Round(cx), Y: Round(cy)})
        }
        pts.Push({X: x2, Y: y2})
        return pts
    }
    ; Default: Minimum-Jerk trajectory (Flash & Hogan 1985: s(t) = 10t^3 - 15t^4 + 6t^5)
    ; Slight natural arc perpendicular to chord (peaks at t=0.5)
    dx := x2 - x1, dy := y2 - y1
    arcMag := Min(12.0, dist * 0.04)
    perpX := dist > 0 ? -dy / dist : 0.0
    perpY := dist > 0 ? dx / dist : 0.0
    steps := VF_Clamp(Integer(steps), 4, 40)
    Loop steps {
        t := A_Index / Float(steps)
        s := (10.0 * (t ** 3)) - (15.0 * (t ** 4)) + (6.0 * (t ** 5))
        arc := 4.0 * t * (1.0 - t) * arcMag * (A_Index = steps ? 0.0 : 1.0)
        px := Round(x1 + dx * s + perpX * arc)
        py := Round(y1 + dy * s + perpY * arc)
        pts.Push({X: px, Y: py})
    }
    pts[pts.Length] := {X: x2, Y: y2}
    return pts
}

; @summary Moves the mouse along a human-physics path, pauses for hoverMs so hover states / dropdown menus register, and clicks.
; @tags macro, deterministic, human-mouse, click, v10
V10_HumanMoveAndClick(targetX, targetY, profile := "MinimumJerk", durationMs := 160, hoverMs := 60, button := "Left", count := 1) {
    CoordMode("Mouse", "Screen")
    MouseGetPos(&startX, &startY)
    V5_HideOverlays(targetX, targetY)
    durationMs := Max(0, Integer(durationMs))
    if durationMs > 0 && profile != "Instant" {
        steps := VF_Clamp( durationMs // 12, 5, 30 )
        stepSleep := Max(1, durationMs // steps)
        pts := V10_GenerateMousePath(startX, startY, targetX, targetY, profile, steps)
        for pt in pts {
            MouseMove(pt.X, pt.Y, 0)
            DllCall("Sleep", "UInt", stepSleep)
        }
    } else {
        MouseMove(targetX, targetY, 0)
    }
    if hoverMs > 0
        DllCall("Sleep", "UInt", Integer(hoverMs))
    if count > 0
        Click(targetX, targetY, button, Integer(count))
}

; @summary Executes a V10 Classical Deterministic block during playback.
; @tags macro, deterministic, playback, v10
V10_DetExecute(node, ctx) {
    t := node["type"]
    if t = "det_use_window"
        return V16_UseWindow(node, ctx)
    hwnd := V10_ResolveWindow(node, ctx)
    WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
    switch t {
        case "det_anchor_click":
            pt := V10_CalcAnchorPoint(ww, wh, node.Get("anchor", "BottomCenter"),
                node.Get("dx", 0), node.Get("dy", 0), node.Get("pctX", 50), node.Get("pctY", 50), wx, wy)
            shift := V8_CalcPixelShift(node, ctx)
            V10_HumanMoveAndClick(pt.ScreenX + shift.DX, pt.ScreenY + shift.DY, "MinimumJerk", 90,
                node.Get("hoverMs", 40), node.Get("button", "Left"), node.Get("count", 1))
        case "det_human_click":
            rawX := Number(ctx.Expand(node.Get("x", 0))), rawY := Number(ctx.Expand(node.Get("y", 0)))
            isWin := node.Get("coordRel", "Window") = "Window"
            sx := (isWin ? wx : 0) + Round(rawX), sy := (isWin ? wy : 0) + Round(rawY)
            shift := V8_CalcPixelShift(node, ctx)
            V10_HumanMoveAndClick(sx + shift.DX, sy + shift.DY, node.Get("profile", "MinimumJerk"),
                node.Get("durationMs", 180), node.Get("hoverMs", 65), node.Get("button", "Left"), node.Get("count", 1))
        case "det_predict_row":
            want := ctx.Expand(node.Get("wantItem", ""))
            allTxt := ctx.Expand(node.Get("allItems", ""))
            tickTxt := ctx.Expand(node.Get("tickedItems", ""))
            condTxt := ctx.Expand(node.Get("conditionalShiftItems", ""))
            pred := V10_PredictListRow(want, allTxt, tickTxt, node.Get("sortRule", "Partitioned_TickedFirst_AZ"),
                condTxt, node.Get("row1X", 175), node.Get("row1Y", 388), node.Get("rowHeight", 17))
            if node.Get("variable", "") != ""
                ctx.Vars[node["variable"]] := pred.Row
            if !pred.Found
                throw Error("Predicted row: item '" . want . "' is not in the candidate list.")
            maxVis := Integer(node.Get("maxVisibleRows", 6))
            method := node.Get("selectMethod", "CheckboxClick")
            if method = "CheckboxClick" {
                if maxVis > 0 && pred.Row > maxVis
                    throw Error("Predicted row #" . pred.Row . " for '" . want . "' is below the visible viewport (maxVisibleRows = " . maxVis . ").")
                V10_HumanMoveAndClick(wx + pred.ClickX, wy + pred.ClickY, "MinimumJerk", 80, 40, "Left", 1)
            } else if method = "KeyboardHomeDownSpace" {
                V10_HumanMoveAndClick(wx + pred.ClickX, wy + Integer(node.Get("row1Y", 388)), "Instant", 0, 30, "Left", 1)
                keys := pred.DownCount > 0 ? "{Home}{Down " . pred.DownCount . "}{Space}" : "{Home}{Space}"
                SendEvent(keys)
            }
        case "det_wait_settled":
            crc := V10_WaitRegionSettled(hwnd, node.Get("x1", 165), node.Get("y1", 95), node.Get("x2", 660), node.Get("y2", 190),
                node.Get("waitForChangeMs", 1500), node.Get("stableMs", 150), node.Get("timeoutMs", 10000), ctx)
            cmpVar := Trim(node.Get("compareVar", ""))
            if cmpVar != "" {
                prev := ctx.Vars.Get(cmpVar, "")
                ctx.Vars[cmpVar . "_unchanged"] := (prev != "" && prev = crc) ? 1 : 0
                ctx.Vars[cmpVar] := crc
            }
            if node.Get("variable", "") != ""
                ctx.Vars[node["variable"]] := crc
        case "det_wait_pixel":
            deadline := A_TickCount + Max(1, Integer(node.Get("timeoutMs", 15000)))
            wantAppear := V4_Bool(node.Get("appear", 1))
            loop {
                matched := V10_CheckPixelSentinel(node, ctx)
                if (wantAppear ? matched : !matched)
                    break
                if A_TickCount >= deadline
                    throw Error("Timed out waiting for pixel sentinel (" . node.Get("colorMode", "DiscernYellow") . ") at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ").")
                ctx.Sleep(50)
            }
        case "det_normalize_win":
            V17_NormalizeWindow(node, hwnd, ctx)
        case "det_citrix_fill":         ; V18: this line was missing in V17, so every Normalize step ALSO cleared the
            ; focused field (End, Shift+Home, Delete x2, 40 Backspaces) and pressed Tab, and a Citrix fill did nothing.
            fx := Integer(node.Get("x", 0)), fy := Integer(node.Get("y", 0))
            settle := Max(50, Integer(node.Get("settleMs", 250)))
            if fx > 0 || fy > 0 {
                V10_HumanMoveAndClick(wx + fx, wy + fy, "MinimumJerk", 70, 35, "Left", 1)
                ctx.Sleep(settle)
            }
            ; 3-stage Citrix-safe clear: twice End + Shift+Home + Delete, then End + Backspace sweep
            Loop 2 {
                SendEvent("{End}{Shift down}{Home}{Shift up}")
                ctx.Sleep(70)
                SendEvent("{Delete}")
                ctx.Sleep(100)
            }
            SendEvent("{End}{BS 40}")
            ctx.Sleep(90)
            val := ctx.Expand(node.Get("value", ""))
            if val != ""
                SendText(val)
            ctx.Sleep(120)
            if V4_Bool(node.Get("pressTab", 1))
                SendEvent("{Tab}")
    }
}

; @summary Step-debugger preview for V10 deterministic steps (shows the target ring and live pixel/CRC/row status).
; @tags macro, deterministic, debug, preview, v10
V10_DetPreview(node, runner) {
    t := node["type"]
    if t = "det_use_window" {
        want := Trim(runner.Expand(node.Get("target", "")))
        if want = ""
            return {Text: "Next steps go back to the Macro window: " . V4_Text(runner.Settings.Get("defaultTarget", "(active window)")), Ok: true}
        return {Text: "Next steps will use " . want . (WinExist(want) ? " (open now)." : " (not open yet - will wait " . node.Get("waitSec", 10) . " s)."), Ok: true}
    }
    try {
        hwnd := V10_ResolveWindow(node, runner)
        WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
        switch t {
            case "det_anchor_click":
                pt := V10_CalcAnchorPoint(ww, wh, node.Get("anchor", "BottomCenter"),
                    node.Get("dx", 0), node.Get("dy", 0), node.Get("pctX", 50), node.Get("pctY", 50), wx, wy)
                return {Text: "Will click anchor " . node.Get("anchor", "BottomCenter") . " -> screen (" . pt.ScreenX . ", " . pt.ScreenY . "), win (" . pt.WinX . ", " . pt.WinY . ").", Ok: true, X: pt.ScreenX, Y: pt.ScreenY}
            case "det_human_click":
                rx := Round(Number(runner.Expand(node.Get("x", 0)))), ry := Round(Number(runner.Expand(node.Get("y", 0))))
                sx := (node.Get("coordRel", "Window") = "Window" ? wx : 0) + rx
                sy := (node.Get("coordRel", "Window") = "Window" ? wy : 0) + ry
                return {Text: "Will move via " . node.Get("profile", "MinimumJerk") . " (" . node.Get("durationMs", 180) . " ms + " . node.Get("hoverMs", 65) . " ms dwell) to (" . sx . ", " . sy . ").", Ok: true, X: sx, Y: sy}
            case "det_predict_row":
                want := runner.Expand(node.Get("wantItem", ""))
                pred := V10_PredictListRow(want, runner.Expand(node.Get("allItems", "")), runner.Expand(node.Get("tickedItems", "")),
                    node.Get("sortRule", "Partitioned_TickedFirst_AZ"), runner.Expand(node.Get("conditionalShiftItems", "")),
                    node.Get("row1X", 175), node.Get("row1Y", 388), node.Get("rowHeight", 17))
                if !pred.Found
                    return {Text: "Predicted row: '" . want . "' NOT found in candidate list.", Ok: false}
                return {Text: "Predicted '" . want . "' at Row #" . pred.Row . " -> win (" . pred.ClickX . ", " . pred.ClickY . ").", Ok: true, X: wx + pred.ClickX, Y: wy + pred.ClickY}
            case "det_wait_settled":
                crc := V10_RegionCRC(hwnd, node.Get("x1", 165), node.Get("y1", 95), node.Get("x2", 660), node.Get("y2", 190))
                return {Text: "Region [" . node.Get("x1", 165) . "," . node.Get("y1", 95) . ".." . node.Get("x2", 660) . "," . node.Get("y2", 190) . "] live CRC32 = " . crc . " (waits until settled " . node.Get("stableMs", 150) . " ms).", Ok: true, X: wx + node.Get("x1", 165), Y: wy + node.Get("y1", 95)}
            case "det_wait_pixel":
                matched := V10_CheckPixelSentinel(node, runner)
                return {Text: "Pixel (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") sentinel " . node.Get("colorMode", "DiscernYellow") . " is currently " . (matched ? "MATCHED" : "not matched") . ".", Ok: true, X: wx + node.Get("x", 0), Y: wy + node.Get("y", 0)}
            case "det_normalize_win":
                if V4_Bool(node.Get("maximize", 0))
                    return {Text: "Will maximize the window (currently " . ww . "x" . wh . ").", Ok: true}
                return {Text: "Will normalize window (currently " . ww . "x" . wh . ") to canonical " . node.Get("width", 693) . "x" . node.Get("height", 803)
                    . (V17_IsResizable(WinGetStyle("ahk_id " . hwnd)) ? "." : " (fixed-size: it will only be moved)."), Ok: true}
            case "det_citrix_fill":
                return {Text: "Will Citrix-safe clear (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") and type: " . V5_Short(runner.Expand(node.Get("value", "")), 50), Ok: true, X: wx + node.Get("x", 0), Y: wy + node.Get("y", 0)}
        }
    } catch as err {
        return {Text: err.Message, Ok: false}
    }
    return {Text: VMF_BlockName(t), Ok: true}
}

; @summary 1-click screen measurement inside any V10 deterministic block editor dialog.
; @tags macro, deterministic, measure, gui, v10
V10_MeasureIntoDialog(kind, controls, dlg) {
    dlg.Hide()
    V5_HideOverlays()
    try {
        if kind = "det_wait_settled" {
            p1 := VM_UiPickPoint("🧭 Region Corner 1: Point at TOP-LEFT of the list/region and press F6 (Esc cancels).")
            if !p1
                return
            SoundBeep(750, 80)
            Sleep(180)
            p2 := VM_UiPickPoint("🧭 Region Corner 2: Point at BOTTOM-RIGHT of the list/region and press F6 (Esc cancels).")
            if !p2
                return
            SoundBeep(950, 80)
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
            controls["x1"].Value := Min(p1.X, p2.X) - wx
            controls["y1"].Value := Min(p1.Y, p2.Y) - wy
            controls["x2"].Value := Max(p1.X, p2.X) - wx
            controls["y2"].Value := Max(p1.Y, p2.Y) - wy
            return
        }
        if kind = "det_predict_row" {
            m := V8_MeasureTwoPointsOnScreen()
            if !m
                return
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
            controls["row1X"].Value := m.X1 - wx
            controls["row1Y"].Value := m.Y1 - wy
            controls["rowHeight"].Value := Max(1, Abs(m.DY))
            return
        }
        pt := VM_UiPickPoint("🧭 Point at the target control/pixel on screen and press F6 (Esc cancels).")
        if !pt
            return
        SoundBeep(850, 80)
        CoordMode("Mouse", "Screen")
        CoordMode("Pixel", "Screen")
        MouseGetPos(, , &hwnd)
        WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
        rx := pt.X - wx, ry := pt.Y - wy
        col := PixelGetColor(pt.X, pt.Y)
        hex := Format("{:06X}", col & 0xFFFFFF)
        if controls.Has("x")
            controls["x"].Value := rx
        if controls.Has("y")
            controls["y"].Value := ry
        if controls.Has("colorHex")
            controls["colorHex"].Value := hex
        if controls.Has("width") && controls.Has("height") {
            controls["width"].Value := ww
            controls["height"].Value := wh
        }
        if kind = "det_anchor_click" {
            anc := ["TopLeft", "BottomCenter", "TopRight", "BottomRight", "BottomLeft", "Center", "ProportionalPct"][Max(1, controls["anchor"].Value)]
            switch anc {
                case "BottomCenter":
                    controls["dx"].Value := rx - (ww // 2), controls["dy"].Value := ry - wh
                case "TopRight":
                    controls["dx"].Value := rx - ww, controls["dy"].Value := ry
                case "BottomRight":
                    controls["dx"].Value := rx - ww, controls["dy"].Value := ry - wh
                case "BottomLeft":
                    controls["dx"].Value := rx, controls["dy"].Value := ry - wh
                case "Center":
                    controls["dx"].Value := rx - (ww // 2), controls["dy"].Value := ry - (wh // 2)
                case "ProportionalPct":
                    controls["pctX"].Value := Round((rx / Max(1.0, ww)) * 100)
                    controls["pctY"].Value := Round((ry / Max(1.0, wh)) * 100)
                    controls["dx"].Value := 0, controls["dy"].Value := 0
                default:
                    controls["dx"].Value := rx, controls["dy"].Value := ry
            }
        }
    } finally {
        V5_RestoreOverlays()
        dlg.Show()
    }
}

; @summary Opens the V10 "🧭 Deterministic Inspector & Layout Physics Lab" (Ctrl+Shift+D or toolbar "🧭 Lab...").
;          Lets you inspect live window geometry anchors, pixel sentinels, region CRC32 hashes, and test list row prediction!
; @tags macro, deterministic, lab, inspector, gui, v10
V10_ShowDeterministicLab(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    V7_ShowMainGui()
    dlg := Gui("+Owner" . s.Gui.Hwnd . " -MinimizeBox", "🧭 V10 Deterministic Inspector & Layout Physics Lab (No OCR / No Image Search)")
    dlg.SetFont("s10 bold", "Segoe UI")
    dlg.AddText("xm ym w780 c0A84FF", "🧭 Classical Non-OCR / Non-Image Automation Lab — Measure Geometry, Pixel Sentinels, CRC32 & List Physics")
    dlg.SetFont("s9 norm", "Segoe UI")
    dlg.AddText("xm y+4 w780 c505050", "Why controls move & how to replicate human accuracy without OCR: anchor offsets, 1-pixel state sentinels, GDI BitBlt CRC32 settle waits, and list sort math.")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w780", "1. Live Screen Probe (Point + F6 on any window, button, or listbox row):")
    dlg.SetFont("s9 norm", "Segoe UI")
    btnProbePt := dlg.AddButton("xm y+6 w230 h28", "🎯 Probe Point / Anchor / Pixel (F6)")
    btnProbeRect := dlg.AddButton("x+8 yp w240 h28", "🔲 Probe Region CRC32 Hash (F6 x2)")
    btnProbeStride := dlg.AddButton("x+8 yp w250 h28", "📏 Probe List Row 1 -> Row 2 Stride (F6 x2)")

    edProbe := dlg.AddEdit("xm y+8 w780 r7 ReadOnly FontConsolas BackgroundF5F7FA",
        "Click one of the Probe buttons above to measure any live window on screen:`r`n"
        . "  • Window Geometry Anchors: Top-Left (rx, ry), Bottom-Center (dx, dy), Top-Right (dx, dy), and Proportional (%)`r`n"
        . "  • Pixel Sentinel: Exact 0xRRGGBB hex + semantic classifier (DiscernYellow, CernerDoorBlue, HighlightBlue, DisabledGrey)`r`n"
        . "  • Region CRC32: Hardware ntdll\RtlComputeCrc32 hash of any list/form rectangle`r`n"
        . "  • Row Stride: Exact row1Y and pixel height between Row 1 and Row 2")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w780", "2. Layout Physics & Partitioned List Row Predictor (Test why a dropdown/listbox item is in its position):")
    dlg.SetFont("s9 norm", "Segoe UI")
    dlg.AddText("xm y+6", "Target item:")
    edWant := dlg.AddEdit("x+6 yp-3 w200", "541-INP-MAIN")
    dlg.AddText("x+12 yp+3", "Sort rule:")
    ddSort := dlg.AddDropDownList("x+6 yp-3 w220", ["Partitioned_TickedFirst_AZ", "Alphabetical_AZ", "ExactGivenOrder"])
    ddSort.Value := 1
    dlg.AddText("x+12 yp+3", "Row1 Y:")
    edR1Y := dlg.AddEdit("x+4 yp-3 w50 Number", "388")
    dlg.AddText("x+8 yp+3", "Stride H:")
    edRH := dlg.AddEdit("x+4 yp-3 w45 Number", "17")

    dlg.AddText("xm y+8 w250", "All candidate items (comma/newline):")
    dlg.AddText("x+14 yp w250", "Currently Ticked items (sorted A-Z first):")
    dlg.AddText("x+14 yp w250", "Conditional items (omitted if unticked):")
    edAll := dlg.AddEdit("xm y+4 w250 r4 +WantReturn", "541-INP-CARES`n541-INP-CLC`n541-INP-DOM`n541-INP-MAIN`n541-RX-CLINIC-IP")
    edTick := dlg.AddEdit("x+14 yp w250 r4 +WantReturn", "541-INP-MAIN`n541-INP-CLC")
    edCond := dlg.AddEdit("x+14 yp w250 r4 +WantReturn", "541-RX-CLINIC-IP")

    btnCalcRow := dlg.AddButton("xm y+8 w220 h26", "🧮 Calculate Predicted Row & Y")
    txtPredOut := dlg.AddText("x+12 yp+4 w540 c0A84FF", "Click 'Calculate' to see the exact predicted row order and click coordinate.")

    dlg.SetFont("s9 bold", "Segoe UI")
    dlg.AddText("xm y+12 w780", "3. 1-Click Insert into Current Macro:")
    dlg.SetFont("s9 norm", "Segoe UI")
    btnAddAnchor := dlg.AddButton("xm y+6 w185 h28", "+ Anchor-Relative Click...")
    btnAddCRC := dlg.AddButton("x+6 yp w185 h28", "+ Region CRC32 Settle...")
    btnAddPixel := dlg.AddButton("x+6 yp w185 h28", "+ Pixel Sentinel Wait...")
    btnAddPred := dlg.AddButton("x+6 yp w205 h28", "+ List Row Predictor Block...")

    btnClose := dlg.AddButton("xm y+12 w110 h28 Default", "Close")

    lastProbe := {Hwnd: 0, W: 693, H: 803, RX: 300, RY: 76, Hex: "FFFF80", X1: 165, Y1: 95, X2: 660, Y2: 190, RowH: 17}

    doProbePt(*) {
        dlg.Hide()
        V5_HideOverlays()
        try {
            pt := VM_UiPickPoint("🎯 Point at any UI control or sentinel pixel and press F6 (Esc cancels).")
            if !pt
                return
            SoundBeep(850, 80)
            CoordMode("Mouse", "Screen")
            CoordMode("Pixel", "Screen")
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " . hwnd)
            wTitle := WinGetTitle("ahk_id " . hwnd), wExe := WinGetProcessName("ahk_id " . hwnd)
            rx := pt.X - wx, ry := pt.Y - wy
            col := PixelGetColor(pt.X, pt.Y)
            hex := Format("{:06X}", col & 0xFFFFFF)
            bc := V10_CalcAnchorPoint(ww, wh, "BottomCenter", rx - (ww // 2), ry - wh, 50, 50, wx, wy)
            tags := ""
            for mName in ["DiscernYellow", "CernerDoorBlue", "HighlightBlue", "DisabledGrey", "WhiteReady"]
                if V10_MatchColorSentinel(col, mName)
                    tags .= (tags = "" ? "" : ", ") . mName
            if tags = ""
                tags := "NearHex (" . hex . ")"
            lastProbe.Hwnd := hwnd, lastProbe.W := ww, lastProbe.H := wh, lastProbe.RX := rx, lastProbe.RY := ry, lastProbe.Hex := hex
            edProbe.Value := "Window:          " . wExe . "  |  " . wTitle . "   (Size: " . ww . " x " . wh . ")`r`n"
                . "Screen / Win XY: Screen (" . pt.X . ", " . pt.Y . ")   |   TopLeft Win-Relative: (" . rx . ", " . ry . ")`r`n"
                . "Anchor Offsets:  BottomCenter: dx=" . (rx - (ww // 2)) . ", dy=" . (ry - wh)
                . "   |   TopRight: dx=" . (rx - ww) . ", dy=" . ry
                . "   |   Proportional: " . Round(rx * 100.0 / Max(1, ww), 1) . "%, " . Round(ry * 100.0 / Max(1, wh), 1) . "%`r`n"
                . "Pixel Sentinel:  0x" . hex . "   ->   Matches semantic state: [ " . tags . " ]"
        } finally {
            V5_RestoreOverlays()
            dlg.Show()
        }
    }

    doProbeRect(*) {
        dlg.Hide()
        V5_HideOverlays()
        try {
            p1 := VM_UiPickPoint("🔲 Point at TOP-LEFT of the region to hash and press F6 (Esc cancels).")
            if !p1
                return
            SoundBeep(750, 80)
            Sleep(180)
            p2 := VM_UiPickPoint("🔲 Point at BOTTOM-RIGHT of the region to hash and press F6 (Esc cancels).")
            if !p2
                return
            SoundBeep(950, 80)
            MouseGetPos(, , &hwnd)
            WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
            x1 := Min(p1.X, p2.X) - wx, y1 := Min(p1.Y, p2.Y) - wy
            x2 := Max(p1.X, p2.X) - wx, y2 := Max(p1.Y, p2.Y) - wy
            crc := V10_RegionCRC(hwnd, x1, y1, x2, y2)
            lastProbe.X1 := x1, lastProbe.Y1 := y1, lastProbe.X2 := x2, lastProbe.Y2 := y2
            edProbe.Value := "Region CRC32:    " . crc . "   (computed via GDI BitBlt + ntdll\RtlComputeCrc32)`r`n"
                . "Window Rect:     x1=" . x1 . ", y1=" . y1 . ", x2=" . x2 . ", y2=" . y2 . "   (Size: " . (x2 - x1) . " x " . (y2 - y1) . " px)`r`n"
                . "Use in V10:      Insert a 'Wait for Region CRC32 Change & Settle' block with these exact coordinates!"
        } finally {
            V5_RestoreOverlays()
            dlg.Show()
        }
    }

    doProbeStride(*) {
        dlg.Hide()
        m := V8_MeasureTwoPointsOnScreen()
        dlg.Show()
        if !m
            return
        MouseGetPos(, , &hwnd)
        WinGetPos(&wx, &wy, , , "ahk_id " . hwnd)
        r1x := m.X1 - wx, r1y := m.Y1 - wy, rh := Max(1, Abs(m.DY))
        edR1Y.Value := r1y, edRH.Value := rh
        lastProbe.RX := r1x, lastProbe.RY := r1y, lastProbe.RowH := rh
        edProbe.Value := "Measured List Geometry:`r`n"
            . "  • Row 1 Window Coordinate: x=" . r1x . ", y=" . r1y . "`r`n"
            . "  • Exact Row Stride (DY):   " . rh . " px per row   (Formula: clickY = " . r1y . " + (row - 1) * " . rh . ")`r`n"
            . "  • Copied Row1 Y (" . r1y . ") and Stride H (" . rh . ") into the Layout Physics predictor below!"
    }

    doCalcRow(*) {
        pred := V10_PredictListRow(edWant.Value, edAll.Value, edTick.Value, ddSort.Text, edCond.Value,
            lastProbe.RX, IsInteger(edR1Y.Value) ? Integer(edR1Y.Value) : 388, IsInteger(edRH.Value) ? Integer(edRH.Value) : 17)
        orderStr := V4_Join(pred.Order, " -> ")
        if pred.Found
            txtPredOut.Text := "✓ '" . edWant.Value . "' is at Row #" . pred.Row . " (Click win Y = " . pred.ClickY . ", or {Home}{Down " . pred.DownCount . "}{Space})  |  Order: " . orderStr
        else
            txtPredOut.Text := "✗ '" . edWant.Value . "' was not found in the active list.  |  Order: " . orderStr
    }

    btnProbePt.OnEvent("Click", doProbePt)
    btnProbeRect.OnEvent("Click", doProbeRect)
    btnProbeStride.OnEvent("Click", doProbeStride)
    btnCalcRow.OnEvent("Click", doCalcRow)
    btnAddAnchor.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_anchor_click")))
    btnAddCRC.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_wait_settled")))
    btnAddPixel.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_wait_pixel")))
    btnAddPred.OnEvent("Click", (*) => (dlg.Destroy(), V7_InsertBlockByKind("det_predict_row")))
    btnClose.OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    doCalcRow()
    dlg.Show()
}

; ============================================================================
; V13 STEP SETTINGS PANEL (beside the macro tree) + PLAIN-ENGLISH TREE LABELS
; ============================================================================

; @summary Builds the Step settings panel to the right of the macro tree; V13_InspLayout positions it on resize.
; @tags macro, gui, blocks, inspector, v13
V13_BuildInspector(g) {
    s := VMB()
    p := {Node: 0, Info: 0, Fields: [], Loaded: [], LoadedOn: 1, Slots: [], Busy: false, Width: 360, RowCount: 0,
        HasGeo: false}
    p.Box := g.AddGroupBox("x0 y0 w10 h10 Hidden", "Step settings")
    g.SetFont("s10 bold")
    p.Title := g.AddText("x0 y0 w10 h20 Hidden", "")
    g.SetFont("s9 norm")
    p.On := g.AddCheckbox("x0 y0 w10 h20 Hidden", "On  (untick = skipped when the macro plays)")
    p.Meaning := g.AddEdit("x0 y0 w10 h52 Hidden ReadOnly +Multi +VScroll -TabStop BackgroundF5F7FA", "")
    p.Empty := g.AddText("x0 y0 w10 h60 Hidden c606060", "")
    loop 16 {
        slot := {ChoiceKey: ""}
        slot.Label := g.AddText("x0 y0 w10 h20 Hidden Right", "")
        slot.Edit := g.AddEdit("x0 y0 w10 r1 -Multi Hidden", "")
        slot.DDL := g.AddDropDownList("x0 y0 w10 Hidden", [])
        slot.Check := g.AddCheckbox("x0 y0 w10 h22 Hidden", "")
        slot.Edit.OnEvent("LoseFocus", V13_InspCommit)
        slot.Edit.OnEvent("Focus", V13_InspFieldHint.Bind(A_Index))
        slot.DDL.OnEvent("Change", V13_InspCommit)
        slot.DDL.OnEvent("Focus", V13_InspFieldHint.Bind(A_Index))
        slot.Check.OnEvent("Click", V13_InspCommit)
        p.Slots.Push(slot)
    }
    p.Hint := g.AddText("x0 y0 w10 h32 Hidden c606060", "")
    p.BtnAll := g.AddButton("x0 y0 w10 h26 Hidden", "All settings...")
    p.BtnTest := g.AddButton("x0 y0 w10 h26 Hidden", "Test target")
    p.BtnLook := g.AddButton("x0 y0 w10 h26 Hidden", "Quick Look")
    p.Explain := g.AddCheckbox("x0 y0 w10 h20 Hidden", "Explain steps in the tree (meaning, wait, window, note)")
    p.Explain.Value := s.ShowMeaning
    p.Columns := g.AddCheckbox("x0 y0 w10 h20 Hidden", "Columns")         ; V22: step list in fixed columns
    p.Columns.Value := s.Columns
    p.Columns.OnEvent("Click", V22_ToggleColumns)
    p.On.OnEvent("Click", V13_InspCommit)
    p.BtnAll.OnEvent("Click", VMB_EditSelected)
    p.BtnTest.OnEvent("Click", VMB_TestSelected)
    p.BtnLook.OnEvent("Click", V7_QuickLook)
    p.Explain.OnEvent("Click", V13_ToggleExplain)
    s.Insp := p
}

; @summary Places the panel at x/y with width w and height h (the macro tree's height); rows that do not fit are hidden.
; @tags macro, gui, inspector, v13
V13_InspLayout(x, y, w, h) {
    p := VMB().Insp
    p.HasGeo := true
    ix := x + 10, iw := w - 20
    p.Box.Move(x, y - 8, w, h + 8)
    cy := y + 12
    p.Title.Move(ix, cy, iw, 20), cy += 22
    p.On.Move(ix, cy, iw, 20), cy += 23
    p.Meaning.Move(ix, cy, iw, 52), cy += 58
    p.Empty.Move(ix, cy, iw, 60)
    footTop := y + h - 94
    labW := 112, cx := ix + labW + 6, cw := iw - labW - 6
    p.RowCount := 0
    for i, slot in p.Slots {
        ry := cy + (i - 1) * 26
        slot.Label.Move(ix, ry + 4, labW, 20)
        slot.Edit.Move(cx, ry, cw)
        slot.DDL.Move(cx, ry, cw)
        slot.Check.Move(ix + 4, ry + 1, iw - 4, 22)
        if ry + 26 <= footTop
            p.RowCount := i
    }
    p.Hint.Move(ix, footTop + 2, iw, 32)
    p.BtnAll.Move(ix, footTop + 38, 106, 26)
    p.BtnTest.Move(ix + 112, footTop + 38, 90, 26)
    p.BtnLook.Move(ix + 208, footTop + 38, 90, 26)
    p.Explain.Move(ix, footTop + 68, iw - 84, 20)
    p.Columns.Move(ix + iw - 80, footTop + 68, 80, 20)
    V13_InspArrange()
}

; @summary Shows only the controls the loaded step needs (edit, drop-down or tick box per row).
; @tags macro, gui, inspector, v13
V13_InspArrange() {
    s := VMB(), p := s.Insp
    if !p || !p.HasGeo
        return
    show := s.InspShown
    for ctl in [p.Box, p.Title, p.Meaning, p.Hint, p.BtnAll, p.BtnTest, p.BtnLook, p.Explain, p.Columns]
        ctl.Visible := show
    p.On.Visible := show && p.Node && p.Info && p.Info.Kind = "node"
    p.Empty.Visible := show && !p.Fields.Length
    rows := show ? Min(p.Fields.Length, p.RowCount, p.Slots.Length) : 0
    for i, slot in p.Slots {
        ftype := i <= rows ? p.Fields[i].Type : ""
        slot.Label.Visible := ftype != "" && ftype != "check"
        slot.Edit.Visible := ftype != "" && ftype != "choice" && ftype != "check"
        slot.DDL.Visible := ftype = "choice"
        slot.Check.Visible := ftype = "check"
    }
    V13_InspHint("")
}

; @summary Hint line under the fields; "" shows the default tip (or how many rows did not fit).
; @tags macro, gui, inspector, v13
V13_InspHint(text, isError := false) {
    p := VMB().Insp
    if !p
        return
    if text = "" {
        more := p.Fields.Length - Min(p.Fields.Length, p.RowCount, p.Slots.Length)
        text := more > 0 ? "+" . more . " more setting(s) - make the window taller or press All settings..."
            : p.Fields.Length ? "Enter, Tab or clicking away applies a change.  Esc puts it back.  Ctrl+Z undoes." : ""
    }
    p.Hint.Opt(isError ? "cC00000" : "c606060")
    p.Hint.Text := text
}

V13_InspFieldHint(i, *) {
    p := VMB().Insp
    if p && i <= p.Fields.Length
        V13_InspHint(p.Fields[i].Short . ": " . p.Fields[i].Long)
}

; @summary Loads the selected step/block into the panel. commitFirst keeps anything typed for the previous step.
; @tags macro, gui, inspector, v13
V13_InspLoad(commitFirst := true) {
    s := VMB(), p := s.Insp
    if !p || p.Busy
        return
    if commitFirst
        V13_InspCommit()
    info := VMB_SelectedInfo()
    node := !info ? 0 : info.Kind = "node" ? info.Node : info.Kind = "elif" ? info.Elif : 0
    p.Node := node, p.Info := info
    p.Fields := node ? V13_InspFields(node) : []
    p.Loaded := []
    p.Busy := true
    try {
        for i, f in p.Fields {
            if i > p.Slots.Length
                break
            slot := p.Slots[i]
            val := node.Get(f.Key, f.Default)
            switch f.Type {
                case "choice":
                    slot.Label.Text := f.Short
                    key := V4_Join(f.Choices, "|")
                    if slot.ChoiceKey != key {
                        slot.DDL.Delete()
                        slot.DDL.Add(f.Choices)
                        slot.ChoiceKey := key
                    }
                    want := Max(1, VM__IndexOf(f.Vals, V4_Text(val)))
                    if slot.DDL.Value != want
                        slot.DDL.Value := want
                    p.Loaded.Push(want)
                case "check":
                    slot.Check.Text := f.Short
                    slot.Check.Value := V4_Bool(val) ? 1 : 0
                    p.Loaded.Push(slot.Check.Value)
                default:
                    slot.Label.Text := f.Short
                    text := V4_Text(val)
                    multi := InStr(text, "`n") > 0
                    slot.Edit.Opt(multi ? "+ReadOnly" : "-ReadOnly")
                    if multi
                        text := StrReplace(StrReplace(text, "`r"), "`n", " ⏎ ")
                    if !(slot.Edit.Value == text)       ; leave the caret alone when nothing changed
                        slot.Edit.Value := text
                    p.Loaded.Push(text)
            }
        }
        p.On.Value := node && !node.Get("disabled", 0) ? 1 : 0
        p.LoadedOn := p.On.Value
        V13_InspHeader()
    } finally
        p.Busy := false
    V13_InspArrange()
}

; @summary Panel title, plain-English description and empty-state text for the loaded line.
; @tags macro, gui, inspector, v13
V13_InspHeader() {
    s := VMB(), p := s.Insp
    node := p.Node, info := p.Info
    if node && info.Kind = "node"
        title := (VMF_IsStep(node) ? "#" . s.FlatIndex.Get(node, "?") . "   " : "") . VMF_BlockName(node.Get("type", ""))
    else if node
        title := "ELSE IF part"
    else if info && info.Kind = "else"
        title := "ELSE part"
    else
        title := info ? "Empty spot" : "No step selected"
    p.Title.Text := title
    p.Meaning.Value := V13_Explain(node, info)
    p.Empty.Text := !node ? (info ? "Drag, record or paste steps here." : "Click a step in the macro to see and change its settings here.")
        : "This block has no quick settings.  Press All settings... (or double-click it in the macro)."
}

; @summary Writes any changed panel values into the loaded step (one Undo step), then relabels it in the tree.
;          Bad values are refused, put back, and explained in red under the fields.
; @tags macro, gui, inspector, v13
V13_InspCommit(*) {
    s := VMB(), p := s.Insp
    if !p || p.Busy || !p.Node || !p.Info || VM_IsPlaying() || VM_IsRecording()
        return
    node := p.Node, owner := p.Info.Kind = "elif" ? p.Info.Node : node
    if !s.NodeItem.Has(owner)            ; the macro was replaced (undo, open...) since this was loaded
        return
    work := node.Clone(), changed := [], onNow := p.On.Value
    onChanged := p.Info.Kind = "node" && onNow != p.LoadedOn
    try {
        for i, f in p.Fields {
            if i > p.Loaded.Length
                break
            slot := p.Slots[i]
            cur := f.Type = "choice" ? slot.DDL.Value : f.Type = "check" ? slot.Check.Value : slot.Edit.Value
            if cur == p.Loaded[i]
                continue
            V13_InspSetField(work, f, cur)
            changed.Push([i, cur, f.Short])
        }
        if !changed.Length && !onChanged
            return
        if onChanged
            VM__SetOrDelete(work, "disabled", onNow ? "" : 1)
        V13_InspFinish(work, node, p.Fields)
    } catch as err {
        V13_InspLoad(false)
        V13_InspHint("⚠ " . err.Message . "  (old value put back)", true)
        return
    }
    hadNotes := s.LastNotes.Count       ; V21: VMB_Snapshot clears them, so the other rows' ⚠ must go too
    VMB_Snapshot()
    keys := Map()
    for k in work
        keys[k] := 1
    for k in node
        keys[k] := 1
    for k in keys {
        if work.Has(k)
            node[k] := work[k]
        else if node.Has(k)
            node.Delete(k)
    }
    s.Dirty := true
    for c in changed
        p.Loaded[c[1]] := c[2]
    p.LoadedOn := onNow
    names := ""
    for c in changed
        names .= (names = "" ? "" : ", ") . c[3]
    if onChanged
        names .= (names = "" ? "" : ", ") . (onNow ? "turned on" : "turned off")
    if onChanged || p.Info.Kind = "elif" || hadNotes {
        VMB_Refresh()                    ; recolours / relabels everything inside
    } else {
        s.AppShow := V21_AppRuns(VMF_Flatten(s.Macro["blocks"]))     ; V21: keep the "in <program>" marks up to date
        r := V22_FillApps(VMF_Flatten(s.Macro["blocks"]), s.Macro["settings"])     ; V22: and the Program column
        s.ColApp := r.App, s.ColStarts := r.Starts
        s.TV.Modify(s.NodeItem[owner], , VMB_NodeLabel(owner))
        V13_InspLoad(false)
    }
    VMB_UpdateTitle()
    VMB_SyncWinMatch()
    V7_RefreshQuickLookIfOpen()
    VMB_Status("Changed " . names . ".  Ctrl+Z undoes - Save to keep it.")
}

; @summary Converts one panel value into the step map (work); throws a plain-English error for bad input.
; @tags macro, inspector, validate, v13
V13_InspSetField(work, f, cur) {
    switch f.Type {
        case "choice":
            VM__SetOrDelete(work, f.Key, f.Vals[cur])
        case "check":
            if f.OffDeletes
                VM__SetOrDelete(work, f.Key, cur ? 1 : "")
            else
                work[f.Key] := cur ? 1 : 0
        case "number":
            v := Trim(cur)
            if v = "" {
                if !f.Blank
                    throw Error(f.Short . " needs a whole number.")
                if work.Has(f.Key)
                    work.Delete(f.Key)
                return
            }
            if !IsInteger(v)
                throw Error(f.Short . " must be a whole number.")
            v := Integer(v)
            if f.Min != "" && v < f.Min
                throw Error(f.Short . " must be " . f.Min . " or more.")
            work[f.Key] := v
        case "decimal":
            if !IsNumber(Trim(cur))
                throw Error(f.Short . " must be a number, for example 1 or -1.")
            work[f.Key] := Number(Trim(cur))
        case "numvar":
            v := Trim(cur)
            if !IsNumber(v) && !InStr(v, "{{")
                throw Error(f.Short . " must be a number or a {{variable}}.")
            work[f.Key] := IsNumber(v) ? Number(v) : v
        case "var":
            if !VMF_ValidVarName(Trim(cur))
                throw Error("Variable names use letters, digits and _ (start with a letter) and cannot be row, index,"
                    . " date, time or clipboard.")
            work[f.Key] := Trim(cur)
        case "path":
            if !FileExist(cur)
                throw Error("That macro file does not exist.")
            work[f.Key] := cur
        default:
            if f.Blank
                VM__SetOrDelete(work, f.Key, Trim(cur))
            else
                work[f.Key] := cur
    }
}

; @summary Side effects and block validation the full edit dialogs also apply (stale offsets, ask = no saved text).
; @tags macro, inspector, validate, v13
V13_InspFinish(work, orig, fields) {
    t := work.Get("type", ""), cond := work.Get("cond", "")
    if (t = "click" || t = "drag") && (work.Get("scrX", 0) != orig.Get("scrX", 0) || work.Get("scrY", 0) != orig.Get("scrY", 0))
        for key in ["rx", "ry", "geo"]
            if work.Has(key)
                work.Delete(key)
    if t = "text" && work.Get("ask", 0)
        work["text"] := ""
    if t = "for" && IsNumber(work.Get("step", 1)) && Number(work.Get("step", 1)) = 0
        throw Error("Step cannot be 0.")
    for f in fields
        if f.FromDefs && !work.Has(f.Key)
            work[f.Key] := f.Default
    isDet := cond = "pixel" || SubStr(t, 1, 4) = "det_"
    isWeb := cond = "web" || SubStr(t, 1, 4) = "web_"
    isInput := SubStr(t, 1, 6) = "input_"
    if (isWeb || isInput) && V4_Bool(work.Get("ask", 0)) && work.Has("value")
        work["value"] := ""
    if isDet
        V10_DetValidate(work)
    else if isInput
        V4_InputValidate(work)
    else if isWeb
        V4_WebValidate(work)
}

; @summary Quick-edit rows for a step or block: [{Key, Short, Type, Long, Choices, Vals, Default, Blank, Min, ...}].
;          Types: text, multiline, number, decimal, numvar, var, path, choice (Choices shown / Vals saved), check.
; @tags macro, inspector, v13
V13_InspFields(node) {
    out := []
    add(key, short, ftype := "text", long := "", extra := 0) {
        f := {Key: key, Short: short, Type: ftype, Long: long = "" ? short : long, Choices: [], Vals: [], Blank: false,
            Min: "", Default: "", OffDeletes: false, FromDefs: false}
        if IsObject(extra)
            for name, value in extra.OwnProps()
                f.%name% := value
        out.Push(f)
    }
    pick(key, short, long, choices, vals, default := "") {
        add(key, short, "choice", long, {Choices: choices, Vals: vals, Default: default})
    }
    t := node.Get("type", ""), cond := node.Get("cond", "")
    kind := cond = "web" ? "web_if" : cond = "pixel" ? "det_if_pixel" : t
    defs := V10_DetDefs().Has(kind) ? V10_DetDefs() : V4_InputDefs().Has(kind) ? V4_InputDefs()
        : V4_WebDefs().Has(kind) ? V4_WebDefs() : 0
    if defs {
        spec := defs[kind]
        for fd in spec.Fields {
            ftype := RegExMatch(fd[3], "^(choice|check|number|multiline)$") ? fd[3] : "text"
            add(fd[1], ftype = "check" ? V13_TrimLabel(fd[2], 46) : V13_ShortLabel(fd[1], fd[2]), ftype, fd[2],
                {Choices: fd.Length > 3 ? fd[4] : [], Vals: fd.Length > 3 ? fd[4] : [],
                Default: spec.Defaults.Get(fd[1], ""), FromDefs: true})
        }
    } else {
        ops := ["=", "!=", "<", ">", "<=", ">=", "contains", "empty", "notempty"]
        opText := ["equals (=)", "is not (!=)", "less than (<)", "more than (>)", "at most (<=)", "at least (>=)",
            "contains", "is empty", "is not empty"]
        switch t {
            case "click", "drag":
                pick("find", "Find by", "How the target is found when playing: the saved picture (follows moved windows)"
                    . " or the exact recorded screen spot.", ["picture", "coordinates (recorded spot)"], ["", "spot"])
                pick("button", "Button", "Mouse button.", ["Left", "Right", "Middle"], ["Left", "Right", "Middle"], "Left")
                if t = "click"
                    pick("count", "Clicks", "Single or double click.", ["single", "double"], [1, 2], 1)
                add("scrX", "Screen X", "number", "Recorded screen X - used for coordinates and as the fallback spot.",
                    {Default: 0})
                add("scrY", "Screen Y", "number", "Recorded screen Y - used for coordinates and as the fallback spot.",
                    {Default: 0})
                if t = "drag" {
                    add("dx", "Drag X (px)", "number", "How far to drag across (negative = left).", {Default: 0})
                    add("dy", "Drag Y (px)", "number", "How far to drag down (negative = up).", {Default: 0})
                }
                add("variation", "Picture variation", "number", "How different the picture may look, 0-255."
                    . " Blank = 60. Higher = more forgiving.", {Blank: true, Min: 0})
            case "text":
                add("text", "Text", "multiline", "Text to type; can use {{Column}}, {{variable}}, {{index}}, {{row}}, {{date}}.")
                add("ask", "Ask me for this text each run", "check", "Asks when the step runs instead of saving the text.",
                    {OffDeletes: true})
                add("prompt", "Ask prompt", "text", "Question shown when 'Ask me' is ticked.", {Blank: true})
            case "keys":
                add("keys", "Keys", "text", "AutoHotkey keys: {Enter} {Tab} {Down} ^a = Ctrl+A, !{F4} = Alt+F4,"
                    . " +{Tab} = Shift+Tab, {Tab 3} = Tab 3 times.")
            case "delay":
                add("ms", "Delay (ms)", "number", "How long to pause, in milliseconds (1000 = 1 second).",
                    {Min: 0, Default: 0})
            case "wait", "check":
                pick("appear", t = "wait" ? "Wait for" : "Check for", "Appear or go away.",
                    ["picture to appear", "picture to go away"], [1, 0], 1)
                add("timeoutMs", "Timeout (ms)", "number", "How long to keep looking. Blank = 10000 ms.",
                    {Blank: true, Min: 0})
                add("variation", "Picture variation", "number", "How different the picture may look, 0-255."
                    . " Blank = 60. Higher = more forgiving.", {Blank: true, Min: 0})
            case "wheel":
                pick("direction", "Direction", "Which way to scroll.", ["down", "up", "left", "right"],
                    ["WheelDown", "WheelUp", "WheelLeft", "WheelRight"], "WheelDown")
                add("count", "Notches", "number", "How many wheel notches.", {Min: 1, Default: 1})
            case "repeat":
                add("count", "Repeat times", "number", "How many times the steps inside run ({{index}} = the round).",
                    {Min: 1, Default: 1})
            case "for":
                add("name", "Variable", "var", "Counter name, used in steps as {{name}}.", {Default: "i"})
                add("from", "From", "numvar", "Start number (or a {{variable}}).", {Default: 1})
                add("to", "To", "numvar", "End number (or a {{variable}}).", {Default: 10})
                add("step", "Step", "numvar", "Count by this much (-1 counts down; cannot be 0).", {Default: 1})
            case "until", "if", "elif":
                if t = "until" {
                    pick("check", "Check", "When the condition is checked.",
                        ["before each round", "after each round (runs once at least)"], ["", "after"])
                    add("max", "At most (rounds)", "number", "The run stops after this many rounds.", {Min: 1, Default: 100})
                }
                if cond = "var" {
                    add("name", "Variable", "var", "Variable to test.")
                    pick("op", "Test", "How to compare.", opText, ops, "=")
                    add("value", "Value", "text", "A number, text or {{another variable / column}}.")
                } else {
                    pick("appear", "Image", "True when the image is on screen, or when it is not.",
                        ["is on screen", "is NOT on screen"], [1, 0], 1)
                    add("timeoutMs", "Look for (ms)", "number", "How long to look for the image. Blank = "
                        . VM_Config().CheckTimeoutMs . " ms.", {Blank: true, Min: 200})
                }
            case "set":
                add("name", "Variable", "var", "Variable name (letters, digits, _).")
                add("value", "Value", "text", "Number or text; can use {{clipboard}}, {{Column}}, {{index}}, {{other}}.")
                add("ask", "Ask me for the value when it runs", "check", "The value above becomes the default answer.",
                    {OffDeletes: true})
                add("prompt", "Ask prompt", "text", "Question to show (blank = 'Value for <name>:').", {Blank: true})
            case "change":
                add("name", "Variable", "var", "Variable to change.")
                add("by", "Change by", "decimal", "Number to add (use -1 to count down).", {Default: 1})
            case "ndc":
                add("name", "Variable", "var", "Variable that gets the 11-digit NDC (no dashes).", {Default: "ndc"})
                add("source", "Barcode from", "text", "Blank = ask the tech to scan. Or {{clipboard}}, {{Column}}, {{other}}.",
                    {Blank: true})
                add("prompt", "Scan prompt", "text", "Question to show (blank = 'Scan the NDC barcode now').", {Blank: true})
            case "ask":
                add("prompt", "Question", "text", "Shown with Continue / Skip this row / Stop.")
            case "stop":
                pick("action", "Does", "What this block does when it runs.",
                    ["exit the loop", "next round", "skip this data row", "end the run (done)", "stop the run"],
                    ["break", "continue", "nextrow", "endrun", "stop"], "break")
            case "call":
                add("path", "Macro file", "path", "Saved macro to run here (uses the current data row and variables).")
            case "pickdata":
                pick("format", "File type", "Data file type to ask for.", ["CSV / TSV", "Text list", "Excel", "Any supported"],
                    ["csv", "text", "excel", "any"], "csv")
                pick("header", "Header row", "Does the file have column names?",
                    ["detect automatically", "first row = column names", "no header row"], ["", "yes", "no"])
                add("columns", "Needs columns", "text", "Comma-separated columns the file must have.", {Blank: true})
                add("prompt", "Picker title", "text", "Title of the file picker (blank = default).", {Blank: true})
        }
    }
    if VMF_IsStep(node) {
        add("delayMs", "Wait before (ms)", "number", "Fixed pause before this step runs, in ms."
            . " Blank = automatic (Speed setting + recorded gap).", {Blank: true, Min: 0})
        if node.Get("win", "") is Map
            pick("winMatch", "Window", "Which window this step uses: the exact recorded one, any window of the same"
                . " program, or whatever is active.", ["exact window", "any window of program", "whatever is active"],
                ["", "program", "active"])
    }
    if t != "elif"
        add("note", "Note", "text", "Your own reminder - shown in the tree.", {Blank: true})
    return out
}

; @summary Short row label for a V4/V10 block field (the long label shows in the hint line on focus).
; @tags macro, inspector, v13
V13_ShortLabel(key, long) {
    static known := Map("target", "Window", "selector", "CSS selector", "frame", "Frame", "index", "Match #",
        "timeoutMs", "Timeout (ms)", "button", "Button", "count", "Clicks", "value", "Value", "prompt", "Ask prompt",
        "mode", "Method", "key", "Key", "variable", "Save in variable", "x", "X", "y", "Y", "dx", "Offset X",
        "dy", "Offset Y", "anchor", "Anchor", "hoverMs", "Hover (ms)", "url", "URL", "by", "Match by",
        "match", "Match text", "port", "Port", "browser", "Browser", "condition", "Condition", "attribute", "Attribute",
        "selectBy", "Select by", "path", "File", "delay", "Key delay (ms)", "duration", "Press time (ms)",
        "colorMode", "Color state", "colorHex", "Color hex", "tolerance", "Tolerance", "pctX", "Percent X",
        "pctY", "Percent Y", "durationMs", "Move time (ms)", "profile", "Motion", "coordRel", "Relative to",
        "x1", "Left X1", "y1", "Top Y1", "x2", "Right X2", "y2", "Bottom Y2", "waitForChangeMs", "Change wait (ms)",
        "stableMs", "Stable (ms)", "compareVar", "Compare var", "width", "Width", "height", "Height",
        "marginX", "Margin X", "marginY", "Margin Y", "wantItem", "Item", "allItems", "All items",
        "tickedItems", "Ticked items", "sortRule", "Sort rule", "conditionalShiftItems", "Shift items",
        "selectMethod", "Select method", "row1X", "Row 1 X", "row1Y", "Row 1 Y", "rowHeight", "Row height",
        "maxVisibleRows", "Visible rows", "settleMs", "Settle (ms)", "scope", "Target", "method", "CDP method",
        "params", "Params", "expression", "Expression")
    return known.Has(key) ? known[key] : V13_TrimLabel(long, 22)
}

V13_TrimLabel(text, maxLen) {
    text := RegExReplace(text, "\s*[(;:].*$")
    return StrLen(text) > maxLen ? SubStr(text, 1, maxLen - 1) . "…" : text
}

; @summary Plain-English meaning of an AutoHotkey Send string, e.g. "^{a}" -> "Ctrl+A: select all",
;          "{Tab 3}" -> "Tab ×3: next field", "ab{Enter}" -> 'types "ab", then Enter: OK / submit / new line'.
; @tags macro, keys, explain, v13
V13_KeysMeaning(keys) {
    static names := Map("esc", "Esc", "escape", "Esc", "bs", "Backspace", "backspace", "Backspace", "del", "Delete",
        "delete", "Delete", "ins", "Insert", "insert", "Insert", "enter", "Enter", "return", "Enter",
        "numpadenter", "Enter", "tab", "Tab", "space", "Space", "up", "Up", "down", "Down", "left", "Left",
        "right", "Right", "home", "Home", "end", "End", "pgup", "Page Up", "pageup", "Page Up", "pgdn", "Page Down",
        "pagedown", "Page Down", "appskey", "Menu key", "ctrl", "Ctrl", "control", "Ctrl", "lctrl", "Ctrl",
        "alt", "Alt", "lalt", "Alt", "shift", "Shift", "lshift", "Shift", "lwin", "Win", "rwin", "Win",
        "printscreen", "PrintScreen")
    static what := Map("Ctrl+A", "select all", "Ctrl+C", "copy", "Ctrl+V", "paste", "Ctrl+X", "cut", "Ctrl+Z", "undo",
        "Ctrl+Y", "redo", "Ctrl+S", "save", "Ctrl+F", "find", "Ctrl+P", "print", "Ctrl+N", "new", "Ctrl+O", "open",
        "Ctrl+W", "close tab", "Ctrl+T", "new tab", "Ctrl+Tab", "next tab", "Ctrl+Shift+Tab", "previous tab",
        "Ctrl+Home", "go to the top", "Ctrl+End", "go to the bottom", "Alt+Tab", "switch window",
        "Alt+F4", "close window", "Alt+Down", "open the drop-down list", "Shift+Tab", "previous field",
        "Tab", "next field", "Enter", "OK / submit / new line", "Esc", "cancel / close", "Backspace", "delete left",
        "Delete", "delete right", "Space", "tick box / press button", "Down", "next item / line",
        "Up", "previous item / line", "Left", "move left", "Right", "move right", "Home", "start of line",
        "End", "end of line", "Shift+Home", "select to start of line", "Shift+End", "select to end of line",
        "Ctrl+Shift+End", "select to the bottom", "Page Down", "page down", "Page Up", "page up", "F5", "refresh",
        "F2", "rename / edit", "Win+D", "show desktop", "Win+E", "File Explorer", "Win+R", "Run box",
        "Ctrl+Shift+Esc", "Task Manager", "Alt+Enter", "properties", "Shift+F10", "right-click menu",
        "Menu key", "right-click menu")
    static mods := [["^", "Ctrl+"], ["!", "Alt+"], ["+", "Shift+"], ["#", "Win+"]]
    out := [], plain := "", pos := 1
    while pos <= StrLen(keys) && RegExMatch(keys, "s)\G([\^!+#]*)(\{[^}]+\}|.)", &m, pos) {
        pos := m.Pos + m.Len
        tok := m[2]
        if m[1] = "" && StrLen(tok) = 1 {
            plain .= tok
            continue
        }
        if plain != ""
            out.Push('types "' . plain . '"'), plain := ""
        inner := tok, count := 1, action := ""
        if StrLen(tok) > 2 && SubStr(tok, 1, 1) = "{" {
            inner := Trim(SubStr(tok, 2, -1))
            if RegExMatch(inner, "i)^(.+?)\s+(down|up)$", &d)
                inner := d[1], action := StrLower(d[2])
            else if RegExMatch(inner, "^(.+?)\s+(\d+)$", &d)
                inner := d[1], count := Integer(d[2])
        }
        combo := ""
        for pair in mods
            if InStr(m[1], pair[1])
                combo .= pair[2]
        combo .= names.Get(StrLower(inner), StrLen(inner) = 1 ? StrUpper(inner) : inner)
        if action != "" {
            out.Push((action = "down" ? "hold " : "let go of ") . combo)
            continue
        }
        text := combo . (count > 1 ? " ×" . count : "")
        if what.Has(combo)
            text .= ": " . what[combo]
        else if RegExMatch(combo, "^Alt\+([A-Z0-9])$", &a)
            text .= ": app menu / shortcut letter " . a[1]
        out.Push(text)
    }
    if plain != ""
        out.Push('types "' . plain . '"')
    return V4_Join(out, ", then ")
}

V13_Ms(ms) {
    ms := IsNumber(ms) ? Number(ms) : 0
    return ms >= 1000 ? Round(ms / 1000, 2) . " s" : Round(ms) . " ms"
}

; @summary Short plain-English meaning of a step for the tree label ("" when the summary already says it).
; @tags macro, explain, gui, v13
V13_StepMeaning(node) {
    t := node.Get("type", "")
    switch t {
        case "keys":
            return V13_KeysMeaning(node.Get("keys", ""))
        case "click", "drag":
            btn := node.Get("button", "Left")
            geo := node.Get("geo", "")
            where := node.Get("find", "") != "spot" ? "on the saved picture"
                : geo is Map ? "at window spot (" . geo["cx"] . ", " . geo["cy"] . ") " . V14_AnchorText(geo)
                : "at screen spot (" . node.Get("scrX", 0) . ", " . node.Get("scrY", 0) . ")"
            if t = "drag"
                return StrLower(btn) . "-drag " . where . " by (" . node.Get("dx", 0) . ", " . node.Get("dy", 0) . ")"
            return (node.Get("count", 1) = 2 ? "double-click " : btn = "Left" ? "click " : StrLower(btn) . "-click ") . where
        case "text":
            if node.Get("ask", 0)
                return "asks you for the text each run, then types it"
            return InStr(node.Get("text", ""), "{{") ? "fills in {{...}} from data / variables" : ""
        case "delay":
            return "pause " . V13_Ms(node.Get("ms", 0))
        case "wait":
            return "wait " . (node.Has("timeoutMs") ? "up to " . V13_Ms(node["timeoutMs"]) . " " : "")
                . "for the picture to " . (V4_Bool(node.Get("appear", 1)) ? "appear" : "go away")
        case "check":
            return "check whether the picture is " . (V4_Bool(node.Get("appear", 1)) ? "on screen" : "gone")
        case "wheel":
            return "scroll " . StrLower(RegExReplace(node.Get("direction", "WheelDown"), "i)^Wheel")) . " ×" . node.Get("count", 1)
        case "input_send", "input_sendinput", "input_sendevent":
            return node.Get("ask", 0) ? "asks you each run, then sends it" : V13_KeysMeaning(node.Get("value", ""))
        case "input_sendtext":
            return node.Get("ask", 0) ? "asks you each run, then types it" : ""
        case "input_keydown":
            return "hold " . node.Get("key", "") . " down"
        case "input_keyup":
            return "let go of " . node.Get("key", "")
    }
    return ""
}

; @summary "from top-left" style text for a geo map's anchors.
; @tags macro, explain, coordinates, v14
V14_AnchorText(geo) {
    y := geo.Get("ay", "T") = "B" ? "bottom" : "top"
    switch geo.Get("ax", "L") {
        case "R": return "from " . y . "-right"
        case "P": return "from " . y . ", scaled across"
    }
    return "from " . y . "-left"
}

; @summary Tree badges after the window: fixed wait-before, loose window matching and the step's note.
; @tags macro, explain, gui, v13
V13_StepBadges(node) {
    out := ""
    if node.Has("delayMs")
        out .= "   ⏱ waits " . V13_Ms(node["delayMs"]) . " first"
    if node.Get("win", "") is Map {
        switch node.Get("winMatch", "") {
            case "program": out .= "   ◇ any window of program"
            case "active": out .= "   ◇ active window"
        }
    }
    if node.Get("note", "") != ""
        out .= "   // " . node["note"]
    return out
}

; @summary Palette description of a block kind ("" when unknown).
; @tags macro, explain, v13
V13_KindDesc(kind) {
    static descs := 0
    if !descs {
        descs := Map()
        for group in VMB_PaletteGroups()
            for item in group[2]
                descs[item[2]] := item[3]
    }
    return descs.Get(kind, "")
}

; @summary Multi-line plain-English description of a step or block for the panel.
; @tags macro, explain, gui, v13
V13_Explain(node, info := 0) {
    if !node
        return info && info.Kind = "else" ? "Runs the steps inside when none of the IF / ELSE IF conditions above are true." : ""
    lines := []
    t := node.Get("type", ""), cond := node.Get("cond", "")
    if node.Get("disabled", 0)
        lines.Push("(OFF - skipped when the macro plays)")
    if VMF_IsStep(node) {
        meaning := V13_StepMeaning(node), sum := VM_StepSummary(node)
        lines.Push("Does: " . VMF_BlockName(t) . (meaning != "" ? " - " . meaning : sum[3] != "" ? " - " . sum[3] : ""))
        if (desc := V13_KindDesc(t)) != ""
            lines.Push(desc)
        win := node.Get("win", "")
        if win is Map && VM_WindowLabel(win) != ""
            lines.Push("In: " . VM_WindowLabel(win) . "  (" . ["exact window", "any window of the program",
                "whatever window is active"][Max(1, VM__IndexOf(["", "program", "active"], node.Get("winMatch", "")))] . ")")
        lines.Push(node.Has("delayMs") ? "Waits " . V13_Ms(node["delayMs"]) . " before it runs."
            : "Wait before: automatic (Speed setting; recorded gap " . V13_Ms(node.Get("gapMs", 0)) . ").")
        if (badge := V8_VarySummaryBadge(node)) != ""
            lines.Push(badge)
        if node.Get("note", "") != ""
            lines.Push("Note: " . node["note"])
    } else {
        lines.Push(t = "elif" ? "ELSE IF " . VMF__CondText(node) : VMF_BlockText(node))
        if VMF_IsContainer(node) || t = "elif"
            lines.Push("Contains " . VMF_CountSteps(VMF_Children(node)[1]) . " line(s).")
        if t = "elif"
            lines.Push("Runs its steps when this is true and the IF / ELSE IF parts above were not.")
        else if (desc := V13_KindDesc(cond = "web" ? "web_if" : cond = "pixel" ? "det_if_pixel" : t)) != ""
            lines.Push(desc)
    }
    return V4_Join(lines, "`r`n")
}

; @summary "Settings panel" button: shows or hides the panel (remembered).
; @tags macro, gui, inspector, v13
V13_ToggleInspector(*) {
    s := VMB()
    s.InspShown := !s.InspShown
    IniWrite(s.InspShown, s.Ini, "V13", "ShowSettingsPanel")
    s.Ctl["InspToggle"].Text := s.InspShown ? "Settings panel ◂" : "Settings panel ▸"
    s.Gui.GetClientPos(, , &w, &h)
    VMB_OnSize(s.Gui, 0, w, h)
    if s.InspShown
        V13_InspLoad()
}

; @summary "Explain steps in the tree" tick box: plain-English meanings and badges on/off (remembered).
; @tags macro, gui, explain, v13
V13_ToggleExplain(ctl, *) {
    s := VMB()
    s.ShowMeaning := ctl.Value
    IniWrite(ctl.Value, s.Ini, "V13", "ExplainSteps")
    VMB_Refresh()
}

; @summary True while a text box in the Step settings panel has the keyboard focus (Enter applies, Esc puts back).
; @tags macro, gui, hotkey, v13
V13_InspFocused(*) {
    s := VMB(), p := s.Insp
    if !p || !s.Gui || !s.InspShown || VM_IsPlaying() || VM_IsRecording() || !WinActive("ahk_id " . s.Gui.Hwnd)
        return false
    focus := DllCall("GetFocus", "Ptr")
    for slot in p.Slots
        if focus = slot.Edit.Hwnd
            return true
    return false
}

; ============================================================================
; NDC FROM BARCODE SCAN (FDA NDC Directory lookup, kept as a local file so it works offline)
; ============================================================================

; @summary Local FDA NDC package list: a header line, then one dashed NDC per line.
; @tags ndc, pharmacy, barcode
NDC_ListPath() => A_MyDocuments . "\VisualMacros\fda-ndc-packages.txt"

; @summary 10-digit NDC -> dashed FDA code(s) ("a|b" if more than one), loaded once from NDC_ListPath().
;          reload = read the file again; override = use this Map instead (self-test).
; @tags ndc, pharmacy, barcode
NDC_List(reload := false, override := 0) {
    static list := 0
    if IsObject(override)
        return list := override
    if list && !reload
        return list
    list := Map()
    if !FileExist(NDC_ListPath())
        return list
    loop parse FileRead(NDC_ListPath(), "UTF-8"), "`n", "`r" {
        if A_LoopField = "" || SubStr(A_LoopField, 1, 1) = "#"
            continue
        key := StrReplace(A_LoopField, "-")
        list[key] := list.Has(key) ? list[key] . "|" . A_LoopField : A_LoopField
    }
    return list
}

; @summary One-line status of the local FDA list (count and download date, or not downloaded).
; @tags ndc, pharmacy
NDC_ListStatus() {
    path := NDC_ListPath()
    if !FileExist(path)
        return "FDA NDC list: not downloaded yet (" . path . ")."
    loop read path
        return "FDA NDC list: " . (SubStr(A_LoopReadLine, 1, 1) = "#" ? LTrim(A_LoopReadLine, "# ")
            : "saved " . FormatTime(FileGetTime(path), "yyyy-MM-dd")) . "."
    return "FDA NDC list: empty."
}

; @summary Downloads the FDA NDC Directory (text zip + excluded-drugs zip), keeps only the dashed package NDCs and
;          writes them to NDC_ListPath(). Returns the number of NDCs saved.
; @tags ndc, pharmacy, download
NDC_DownloadList() {
    tmp := A_Temp . "\vmb-ndc-" . A_TickCount
    DirCreate(tmp)
    codes := Map()
    try {
        for i, url in ["https://www.accessdata.fda.gov/cder/ndctext.zip", "https://www.accessdata.fda.gov/cder/ndc_excluded.zip"] {
            zip := tmp . "\" . i . ".zip", dir := tmp . "\" . i
            try {
                NDC__Fetch(url, zip)
            } catch as err {
                if i = 1
                    throw Error("Could not download the FDA NDC list (" . url . "): " . err.Message)
                continue    ; the excluded-drugs list only adds coverage
            }
            DirCreate(dir)
            if RunWait('tar.exe -xf "' . zip . '" -C "' . dir . '"', , "Hide") != 0
                throw Error("Could not unzip " . url)
            loop files dir . "\*.txt", "R"
                NDC__ReadPackages(A_LoopFileFullPath, codes)
        }
    } finally {
        try DirDelete(tmp, true)
    }
    if codes.Count < 1000
        throw Error("The FDA download did not contain the NDC package list.")
    out := "# " . codes.Count . " NDCs from the FDA NDC Directory, downloaded " . FormatTime(, "yyyy-MM-dd") . "`n"
    for code in codes
        out .= code . "`n"
    V4_Write(NDC_ListPath(), out)
    NDC_List(true)
    return codes.Count
}

; @summary Saves url to path. FDA's bot filter returns an HTML page to the default Download() client, so this sends
;          a browser User-Agent and checks that a zip came back.
; @tags ndc, download
NDC__Fetch(url, path) {
    req := ComObject("MSXML2.XMLHTTP.6.0")
    req.Open("GET", url, false)
    req.SetRequestHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        . " (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0")
    req.Send()
    if req.Status != 200
        throw Error("HTTP " . req.Status)
    st := ComObject("ADODB.Stream")
    st.Type := 1
    st.Open()
    st.Write(req.ResponseBody)
    st.SaveToFile(path, 2)
    st.Close()
    f := FileOpen(path, "r", "CP0")
    head := f.Read(2)
    f.Close()
    if head != "PK"
        throw Error("fda.gov did not send a zip file (blocked or offline).")
}

; @summary Adds every valid dashed NDCPACKAGECODE in a tab-delimited FDA file to codes; other files are skipped.
; @tags ndc, pharmacy
NDC__ReadPackages(path, codes) {
    col := 0
    loop read path {
        cells := StrSplit(A_LoopReadLine, "`t")
        if !col {
            for j, name in cells
                if InStr(name, "NDCPACKAGECODE") {
                    col := j
                    break
                }
            if !col
                return
            continue
        }
        if cells.Length >= col && RegExMatch(Trim(cells[col], ' "'), "^(\d{4,5})-(\d{3,4})-(\d{1,2})$", &m)
            && StrLen(m[1] . m[2] . m[3]) = 10
            codes[m[0]] := 1
    }
}

; @summary Pads the three NDC parts to the 11-digit 5-4-2 form (no dashes).
; @tags ndc, pharmacy
NDC_Pad(labeler, product, package) => SubStr("0" . labeler, -5) . SubStr("0" . product, -4) . SubStr("0" . package, -2)

; @summary "0002-3227-30" -> "00002322730".
; @tags ndc, pharmacy
NDC_DashedTo11(code) {
    parts := StrSplit(code, "-")
    return NDC_Pad(parts[1], parts[2], parts[3])
}

; @summary The three possible dashed readings (4-4-2, 5-3-2, 5-4-1) of a 10-digit NDC.
; @tags ndc, pharmacy
NDC_Readings(d) => [SubStr(d, 1, 4) . "-" . SubStr(d, 5, 4) . "-" . SubStr(d, 9, 2),
    SubStr(d, 1, 5) . "-" . SubStr(d, 6, 3) . "-" . SubStr(d, 9, 2),
    SubStr(d, 1, 5) . "-" . SubStr(d, 6, 4) . "-" . SubStr(d, 10, 1)]

; @summary Reads a scan: dashed NDC, 11 digits, 10 digits, UPC-A (3 + NDC + check), GTIN-13/14 or a GS1 element
;          string ((01) + GTIN-14, then lot/expiry). Returns {D10, Ndc11}; Ndc11 is set when the layout is already known.
; @throws ValueError when it is not an NDC barcode
; @tags ndc, pharmacy, barcode
NDC_Parse(raw) {
    text := Trim(RegExReplace(raw, "[\x00-\x1F]", " "))
    text := RegExReplace(text, "^\][A-Za-z]\d")    ; symbology id such as ]d2 or ]C1
    if RegExMatch(text, "^(\d{4,5})-(\d{3,4})-(\d{1,2})$", &m) {
        d := m[1] . m[2] . m[3]
        if StrLen(d) = 10
            return {D10: d, Ndc11: NDC_Pad(m[1], m[2], m[3])}
        if StrLen(d) = 11 && StrLen(m[1]) = 5 && StrLen(m[2]) = 4
            return {D10: "", Ndc11: d}
    }
    digits := RegExReplace(text, "[\s-]")
    gtin := ""
    if RegExMatch(digits, "^\d{10,14}$") {
        switch StrLen(digits) {
            case 10: return {D10: digits, Ndc11: ""}
            case 11: return {D10: "", Ndc11: digits}
            case 12: gtin := "00" . digits
            case 13: gtin := "0" . digits
            case 14: gtin := digits
        }
    } else if RegExMatch(text, "^\(?01\)?\s*(\d{14})", &m) {
        gtin := m[1]
    }
    if gtin = ""
        throw ValueError("Not an NDC barcode: " . Trim(raw))
    if SubStr(gtin, 2, 2) != "03"     ; drug GTINs are (indicator) 0 3 + 10-digit NDC + check digit
        throw ValueError("This barcode is not a drug NDC: " . Trim(raw))
    return {D10: SubStr(gtin, 4, 10), Ndc11: ""}
}

; @summary Scan -> {Ndc11, Choices, Found}. Ndc11 is "" when the FDA list has no single match; Choices then holds
;          the dashed NDCs to pick from (the FDA matches, or the three possible readings).
; @tags ndc, pharmacy, barcode
NDC_Normalize(raw, list := 0) {
    p := NDC_Parse(raw)
    if p.Ndc11 != ""
        return {Ndc11: p.Ndc11, Choices: [], Found: true}
    list := IsObject(list) ? list : NDC_List()
    hits := list.Has(p.D10) ? StrSplit(list[p.D10], "|") : []
    if hits.Length = 1
        return {Ndc11: NDC_DashedTo11(hits[1]), Choices: hits, Found: true}
    return {Ndc11: "", Choices: hits.Length ? hits : NDC_Readings(p.D10), Found: hits.Length > 0}
}

; @summary Scan -> 11-digit NDC (no dashes). Offers the FDA download once if the list is missing and asks the tech
;          to pick when the list has no single match. Returns "" if cancelled; throws if it is not an NDC barcode.
; @tags ndc, pharmacy, barcode
NDC_FromScan(raw) {
    static offered := false
    if !offered && !NDC_List().Count {
        offered := true
        if MsgBox("The FDA NDC list is not on this PC yet. It shows which way to pad a scanned NDC to 11 digits."
            . "`n`nDownload it now from fda.gov (about 10-20 MB; after that it works offline)?", "NDC from scan",
            "YesNo Icon? 4096") = "Yes" {
            ToolTip("Downloading the FDA NDC list...")
            try NDC_DownloadList()
            catch as err
                MsgBox(err.Message, "FDA NDC list", "Icon! 4096")
            ToolTip()
        }
    }
    r := NDC_Normalize(raw)
    return r.Ndc11 != "" ? r.Ndc11 : NDC_Pick(raw, r)
}

; @summary Lets the tech pick the right NDC from r.Choices. Returns the 11-digit NDC or "" (cancel).
; @tags ndc, pharmacy, gui
NDC_Pick(raw, r) {
    why := r.Found ? "The FDA list has more than one NDC for this scan."
        : NDC_List().Count ? "This NDC is not in the FDA list." : "The FDA NDC list is not downloaded."
    dlg := Gui("+AlwaysOnTop -MinimizeBox", "Pick the NDC")
    dlg.SetFont("s10", "Segoe UI")
    dlg.AddText("w400", "Scanned: " . Trim(RegExReplace(raw, "[\x00-\x1F]", " ")) . "`n" . why
        . "`nCheck the label and pick the NDC that matches it:")
    state := {Value: ""}
    choose(value, *) {
        state.Value := value
        dlg.Destroy()
    }
    for code in r.Choices {
        layout := ""
        for part in StrSplit(code, "-")
            layout .= (layout = "" ? "" : "-") . StrLen(part)
        ndc := NDC_DashedTo11(code)
        dlg.AddButton("xm w400", code . "   (" . layout . ")   ->   " . ndc).OnEvent("Click", choose.Bind(ndc))
    }
    dlg.AddButton("xm w400", "Cancel (stop the macro)").OnEvent("Click", (*) => dlg.Destroy())
    dlg.OnEvent("Escape", (*) => dlg.Destroy())
    hwnd := dlg.Hwnd
    dlg.Show()
    WinWaitClose("ahk_id " . hwnd)
    return state.Value
}

; ============================================================================
; V17 EASY MODE, PICK WINDOW, NORMALIZE ON WINDOW SWITCH, SIZE NOTES
; Easy mode only hides and moves controls; every V16 feature, hotkey and file format is unchanged.
; ============================================================================

; @summary Easy / Full mode toggle (button, tray, Ctrl+Shift+E in the editor). Remembered in the ini.
; @tags macro, gui, easy, v17
V17_ToggleEasy(*) {
    s := VMB()
    if !s.Gui || VM_IsRecording() || VM_IsPlaying()
        return
    s.Easy := s.Easy ? 0 : 1
    IniWrite(s.Easy, s.Ini, "V17", "EasyMode")
    V17_ApplyMode()
    s.Gui.Show()
    VMB_Status(s.Easy ? "Easy mode. 'More features ▸' (Ctrl+Shift+E) shows everything again."
        : "Full mode: every feature is back. '◂ Easy mode' (Ctrl+Shift+E) hides the extras again.")
}

; @summary Every main-window control V17_ApplyMode moves or hides: s.Ctl by name, labels as "lbl:Name", Pal, TV.
; @tags macro, gui, easy, v17
V17_LayoutControls() {
    s := VMB(), all := Map()
    for name, ctl in s.Ctl
        all[name] := ctl
    for name, ctl in s.Lbl
        all["lbl:" . name] := ctl
    all["Pal"] := s.Pal, all["TV"] := s.TV
    return all
}

; @summary Shows the Easy or Full layout. Full positions are saved once at startup; Easy positions come from them.
;          Easy mode also hides the Step settings panel without changing its saved on/off choice.
; @tags macro, gui, easy, v17
V17_ApplyMode() {
    s := VMB(), g := s.Gui
    if !g || !s.Ctl.Has("EasyToggle")
        return
    all := V17_LayoutControls()
    if !(s.FullPos is Map) {
        s.FullPos := Map()
        for name, ctl in all {
            ctl.GetPos(&x, &y, &w, &h)
            s.FullPos[name] := [x, y, w, h]
        }
    }
    DllCall("SendMessage", "Ptr", g.Hwnd, "UInt", 0x000B, "Ptr", 0, "Ptr", 0)      ; WM_SETREDRAW off (no flicker)
    try {
        layout := s.Easy ? V17_EasyLayout(s.FullPos) : s.FullPos
        for name, ctl in all {
            if layout.Has(name) {
                p := layout[name]
                ctl.Move(p[1], p[2], p[3], p[4])
            }
            ctl.Visible := layout.Has(name) && (s.Easy || name != "WinInfo")
        }
        s.InspShown := s.Easy ? 0 : Integer(IniRead(s.Ini, "V13", "ShowSettingsPanel", 1))
        s.Ctl["EasyToggle"].Text := s.Easy ? "More features ▸" : "◂ Easy mode"
        g.Opt(s.Easy ? "+MinSize720x480" : "+MinSize1270x630")
        VMB_FillPalette(s.Ctl["Search"].Value)
        g.GetClientPos(, , &cw, &ch)
        if cw > 0 && ch > 0
            VMB_OnSize(g, 0, cw, ch)
    } finally {
        DllCall("SendMessage", "Ptr", g.Hwnd, "UInt", 0x000B, "Ptr", 1, "Ptr", 0)
        DllCall("RedrawWindow", "Ptr", g.Hwnd, "Ptr", 0, "Ptr", 0, "UInt", 0x0485)     ; erase + all children + frame
    }
    if !s.Easy && s.InspShown
        V13_InspLoad()
    V17_UpdateWinInfo()
    VMB_UpdateTitle()
}

; @summary Easy-mode positions worked out from the Full-mode ones (Map name -> [x, y, w, h]): row 1 = Record, Stop,
;          Play, Step by step, Pick window, More features, ?; row 2 = New, Open, Recent, Save, Save as + window info;
;          toolbox and macro moved up; bottom = Edit, Delete, Move up / down, Into / Out of block.
; @returns Map name -> [x, y, w, h] for the controls Easy mode shows (all others are hidden)
; @tags macro, gui, easy, v17
V17_EasyLayout(full) {
    out := Map()
    place(name, px, py, pw := "", ph := "") {
        q := full[name]
        out[name] := [px, py, pw = "" ? q[3] : pw, ph = "" ? q[4] : ph]
        return px + out[name][3]
    }
    xm := full["Record"][1], y1 := full["Record"][2], h1 := full["Record"][4]
    x := xm
    for name in ["Record", "Stop", "Play", "Step"]
        x := place(name, x, y1) + 6
    x := place("PickWin", x + 10, y1, 130, h1) + 16
    x := place("EasyToggle", x, y1, 130, h1) + 6
    place("Help", x, y1, 30, h1)
    y2 := full["New"][2]
    x := xm
    for name in ["New", "Open", "Recent", "Save", "SaveAs"]
        x := place(name, x, y2) + 6
    place("WinInfo", x + 14, y2 + 5, 760, 20)
    dy := full["lbl:HdrBlocks"][2] - (y2 + full["New"][4] + 14)
    for name in ["lbl:HdrBlocks", "lbl:HdrMacro", "Undo", "Redo", "Search", "Pal", "TV", "ColHead"] {
        q := full[name]
        out[name] := [q[1], q[2] - dy, q[3], q[4]]
    }
    yb := full["Edit"][2], x := xm
    for name in ["Edit", "Delete", "Up", "Down", "In", "Out"]
        x := place(name, x + (name = "Up" ? 5 : 0), yb) + 5
    return out
}

; @summary The 9-block Easy toolbox (same labels, kinds and descriptions as the full toolbox).
; @tags macro, gui, blocks, easy, v17
V17_EasyPaletteGroups() {
    static want := [["Window", ["det_normalize_win", "det_use_window"]],
        ["Actions", ["click", "text", "keys", "det_citrix_fill"]],
        ["Flow", ["delay", "repeat", "ask"]]]
    index := Map()
    for group in VMB_PaletteGroups()
        for item in group[2]
            index[item[2]] := item
    out := []
    for group in want {
        items := []
        for kind in group[2]
            if index.Has(kind)
                items.Push(index[kind])
        out.Push([group[1], items])
    }
    return out
}

; @summary Boxes an Easy-mode popup shows for a block kind (Map key -> label, "" = keep the normal label),
;          or "" when the kind has no short form (its popup shows everything).
; @tags macro, gui, blocks, easy, v17
V17_EasyFieldsFor(kind) {
    switch kind {
        case "det_normalize_win":
            return Map("width", "Window width in pixels  (📐 Pick window fills this in)", "height", "Window height in pixels")
        case "det_use_window":
            return Map("target", "Window to use from here on  (📐 Pick window fills this in)")
        case "det_citrix_fill":
            return Map("value", "Text to type (can use {{Column}})",
                "x", "Box spot X inside the window  (🧭 Measure fills this in)", "y", "Box spot Y inside the window")
        case "text":
            return Map("text", "", "ask", "", "prompt", "")
        case "keys":
            return Map("keys", "")
        case "delay":
            return Map("ms", "")
        case "click":
            return Map("button", "", "count", "")
        case "drag":
            return Map("button", "")
        case "wait", "check":
            return Map("timeoutMs", "", "appear", "")
        case "wheel":
            return Map("direction", "", "count", "")
    }
    return ""
}
V17_EasyFields(kind) => VMB().Easy ? V17_EasyFieldsFor(kind) : ""

; @summary Plain description for an Easy-mode popup (falls back to the block's normal description).
; @tags macro, gui, blocks, easy, v17
V17_EasyDesc(kind, fallback) {
    switch kind {
        case "det_normalize_win":
            return "Puts the window back to this exact size and spot, so every click lands in the same place."
                . " Click 📐 Pick window, then click the window's title bar. Fixed-size dialogs are only moved."
        case "det_use_window":
            return "From here on, steps use this window. It waits up to 10 seconds for the window to open,"
                . " then brings it to the front."
        case "det_citrix_fill":
            return "Clicks a box, clears it fully (safe over Citrix), types the text, then presses Tab."
    }
    return fallback
}

; @summary Easy-mode "?" help: the three-step flow in plain words.
; @tags macro, gui, help, easy, v17
V17_EasyHelp(*) {
    MsgBox("EASY MODE - RECORD, THEN PLAY"
        . "`n`n1. Open the program you want to automate. Click Record (Ctrl+Shift+R)."
        . "`n`n2. Do the task once, at a normal pace. The first program you click becomes the macro's window:"
        . "`n    step #1 puts it back to the same size and spot on every run. When you switch to another"
        . "`n    window, two steps are added: one finds that window, one sets its size."
        . "`n`n3. Click the red REC bar (bottom-left) or press Ctrl+Shift+R to stop."
        . "`n`n4. Click Play (F5). Use Step by step (F10) for the first test. Press Esc to stop."
        . "`n`nSTEADY PLAYBACK (always on for macros recorded here): each step waits for its window to be open"
        . "`nand in front, and each click waits until the screen at that spot looks like it did when you recorded."
        . "`nIf the screen never matches, the recorded spot is clicked and a note is shown at the end."
        . "`n`nFor the most repeatable result: start every run from the same screen of the program, don't touch"
        . "`nthe mouse or keyboard while it plays, and never type passwords while recording."
        . "`n📐 Pick window is only needed to choose a different window for an existing macro."
        . "`n`nTo change a step, double-click it. 'More options...' shows every setting."
        . "`nIf a window can't reach its saved size, the run keeps going and the status bar tells you."
        . "`nLists and pages are scrolled back to where they were when you recorded, before each click (standard"
        . "`nWindows lists and boxes only - not web pages, Citrix or Remote Desktop). For those, start each run from the"
        . "`nsame screen and scroll with the keyboard (Ctrl+Home, PgDn) while recording: key presses replay the same way every time."
        . "`n`nNEW IN V22 - THE STEP LIST IN COLUMNS"
        . "`n• Every step row has fixed columns:  #   Program   Waits   Marks   What it does. The Program column is filled on"
        . "  every row (a Wait step shows the program of the step before it)."
        . "`n• Waits = the pause before the step. A * after the time (500 ms*) = a wait you set by hand."
        . "`n• Marks: ► the task moves to another program here, ↕ the list is scrolled back first, ⚡ changes each round,"
        . "  ◇ uses whatever window is active, ✎ has your note, ⚠ had a note in the last run."
        . "`n• Right-click the list -> Show columns (or the Columns tick box in the Step settings panel) for the V21 lines."
        . "`n`nNeed CSV rows, web pages, pictures or anything else? Click 'More features ▸' (Ctrl+Shift+E)."
        . "`nEmergency exit: Ctrl+Shift+X.", "Visual Macro Blocks V18 - Easy mode", "Iconi")
}

; @summary Waits for one left-click on another program's window and returns its top-level HWND
;          (0 = Esc, or the click was on this editor). Tell the user to click the title bar: the click reaches the app.
; @tags macro, window, pick, v17
V17_ClickWindow(prompt) {
    picked := 0
    ToolTip(prompt)
    try {
        KeyWait("LButton")
        loop {
            if GetKeyState("Esc", "P")
                break
            if GetKeyState("LButton", "P") {
                KeyWait("LButton")
                CoordMode("Mouse", "Screen")
                MouseGetPos(, , &picked)
                picked := picked ? DllCall("GetAncestor", "Ptr", picked, "UInt", 2, "Ptr") : 0    ; GA_ROOT
                try {
                    if picked && WinGetPID("ahk_id " . picked) = DllCall("GetCurrentProcessId")
                        picked := 0
                } catch
                    picked := 0
                break
            }
            Sleep(30)
        }
    } finally ToolTip()
    return picked
}

; @summary Size and spot of a window for a Normalize step. Margins are measured from the primary work area, the same
;          origin the Normalize step uses, so the window goes back to exactly this spot (any monitor).
; @returns {Exe, Cls, X, Y, W, H, MarginX, MarginY, Max, Resizable}
; @tags macro, window, normalize, v17
V17_WindowGeometry(hwnd) {
    id := "ahk_id " . hwnd
    WinGetPos(&wx, &wy, &ww, &wh, id)
    MonitorGetWorkArea(MonitorGetPrimary(), &left, &top)
    exe := ""
    try exe := WinGetProcessName(id)
    return {Exe: exe, Cls: WinGetClass(id), X: wx, Y: wy, W: ww, H: wh, MarginX: wx - left, MarginY: wy - top,
        Max: WinGetMinMax(id) = 1, Resizable: V17_IsResizable(WinGetStyle(id))}
}

; @summary Normalize-step values from V17_WindowGeometry.
; @tags macro, window, normalize, v17
V17_GeometryFields(geo) {
    return Map("width", geo.W, "height", geo.H, "marginX", geo.MarginX, "marginY", geo.MarginY,
        "maximize", geo.Max ? 1 : 0)
}

; @summary True when a window style has a sizing border (WS_THICKFRAME); fixed-size dialogs do not.
; @tags macro, window, normalize, v17
V17_IsResizable(style) => (style & 0x40000) != 0

; @summary Window selector for a program window: class + exe, or exe only when the class changes from run to run
;          (WPF HwndWrapper[...], WinForms, MFC Afx:, ATL:, or a long hex number in the class).
; @tags macro, window, v17
V17_WindowSelector(exe, cls) {
    if exe = ""
        return cls != "" ? "ahk_class " . cls : ""
    if cls = "" || RegExMatch(cls, "i)^(HwndWrapper\[|WindowsForms10\.|Afx:|ATL:)|[0-9A-F]{8,}")
        return "ahk_exe " . exe
    return "ahk_class " . cls . " ahk_exe " . exe
}

; @summary The Normalize step at the top of the macro that sets up the Macro window (blank target or this target).
;          create = insert a new one at the top when there is none.
; @returns the node, or 0
; @tags macro, window, normalize, v17
V17_TopNormalize(blocks, target, create := false) {
    if blocks.Length && blocks[1].Get("type", "") = "det_normalize_win" {
        t := Trim(blocks[1].Get("target", ""))
        if t = "" || t = target
            return blocks[1]
    }
    if !create
        return 0
    node := V4_CreateNode("det_normalize_win")
    blocks.InsertAt(1, node)
    return node
}

; @summary "800x600 at (20, 20)" or "maximized" for a Normalize step.
; @tags macro, window, normalize, v17
V17_NormText(node) {
    if V4_Bool(node.Get("maximize", 0))
        return "maximized"
    return node.Get("width", 693) . "x" . node.Get("height", 803) . " at (" . node.Get("marginX", 20) . ", " . node.Get("marginY", 20) . ")"
}

; @summary "📐 Pick window": click a program's title bar. It becomes the Macro window, and step #1 becomes (or is
;          updated to) a Normalize step with that window's current size and spot.
; @returns true when a window was picked
; @tags macro, window, normalize, gui, v17
V17_PickWindow(*) {
    s := VMB()
    if !s.Gui || VM_IsRecording() || VM_IsPlaying()
        return false
    s.Gui.Hide()
    picked := 0
    try picked := V17_ClickWindow("Click the TITLE BAR of the program this macro should use   (Esc = cancel)")
    finally s.Gui.Show()
    if !picked {
        VMB_Status("Pick window cancelled (Esc, or you clicked this editor).")
        return false
    }
    try geo := V17_WindowGeometry(picked)
    catch as err {
        VMB_Status("Could not read that window: " . err.Message)
        return false
    }
    target := V17_WindowSelector(geo.Exe, geo.Cls)
    if target = "" {
        VMB_Status("Could not read that window's program name. Try another window.")
        return false
    }
    VMB_Snapshot()
    s.Ctl["DefaultTarget"].Value := target
    VMB_ControlsToSettings()
    s.PinHwnd := picked
    norm := V17_TopNormalize(s.Macro["blocks"], target, true)
    for key, value in V17_GeometryFields(geo)
        norm[key] := value
    norm["target"] := ""
    s.Dirty := true
    VMB_Refresh(norm)
    V7_AutoSaveNow()
    VMB_Status("📐 Macro window: " . target . ".  Step #1 puts it back to " . V17_NormText(norm)
        . (geo.Resizable ? "" : " (fixed-size: it is only moved)") . " before each run.  Now press Record.")
    return true
}

; @summary Easy-mode line beside Save as: which window the macro uses and what step #1 sets it to.
; @tags macro, gui, window, easy, v17
V17_UpdateWinInfo() {
    s := VMB()
    if !s.Ctl.Has("WinInfo") || !(s.Macro is Map)
        return
    target := Trim(s.Macro["settings"].Get("defaultTarget", ""))
    norm := target != "" ? V17_TopNormalize(s.Macro["blocks"], target) : 0
    s.Ctl["WinInfo"].Value := target = "" ? (s.Macro["blocks"].Length ? "No window picked yet. Click 📐 Pick window."
        : "Just press Record - the first program you click becomes this macro's window.")
        : "Window: " . target . (norm ? "      Step #1 sets it to " . V17_NormText(norm) : "      (no Normalize step at the top)")
}

; @summary Runs a Normalize step: maximize, or restore + move + resize (fixed-size windows are only moved). A size that
;          is more than 4 px off is noted (status bar + playback log) and the run keeps going.
; @tags macro, window, normalize, playback, v17
V17_NormalizeWindow(node, hwnd, ctx) {
    id := "ahk_id " . hwnd
    if V4_Bool(node.Get("maximize", 0)) {
        if WinGetMinMax(id) != 1 {
            WinMaximize(id)
            ctx.Sleep(250)
        }
        return
    }
    if WinGetMinMax(id) != 0 {
        WinRestore(id)
        ctx.Sleep(150)
    }
    MonitorGetWorkArea(MonitorGetPrimary(), &left, &top)
    wantW := Integer(node.Get("width", 693)), wantH := Integer(node.Get("height", 803))
    mx := Integer(node.Get("marginX", 20)), my := Integer(node.Get("marginY", 20))
    resizable := V17_IsResizable(WinGetStyle(id))
    x := left + mx, y := top + my
    if V18_Steady(ctx) {                ; V21: keep the window on a screen that exists (a different monitor layout)
        rects := []
        Loop MonitorGetCount() {
            MonitorGet(A_Index, &monL, &monT, &monR, &monB)
            rects.Push([monL, monT, monR, monB])
        }
        if !V21_OnAnyScreen(x + 8, y + 8, rects) {
            V14_FitOnMonitor(&x, &y, wantW, wantH)
            V17_Warn(ctx, "Step #" . ctx.Index . ": the saved window spot is off this screen; moved the window onto the main screen.")
        }
    }
    try {
        if resizable
            WinMove(x, y, wantW, wantH, id)
        else
            WinMove(x, y, , , id)
    }
    if resizable                        ; V19: wait until the window has its size, instead of a fixed 250 ms pause
        V19_WaitSize(id, wantW, wantH, ctx)
    else                                ; fixed-size window: only wait until it stops moving
        V19_WaitSize(id, x, y, ctx, , true)
    ctx.Sleep(120)                      ; let the program re-draw its controls
    if !V4_Bool(node.Get("strictDpiCheck", 1))
        return
    WinGetPos(, , &actualW, &actualH, id)
    msg := V17_SizeNote(wantW, wantH, actualW, actualH, resizable)
    if msg != "" {
        exe := "window"
        try exe := WinGetProcessName(id)
        if ctx.HasOwnProp("Settings") && ctx.Settings.Get("sizeMismatch", "") = "stop"     ; V19: stop instead of a note
            throw Error("The window " . V19_MismatchText(msg) . " Fix the window, then retry this step.")
        V17_Warn(ctx, "Step #" . ctx.Index . " (" . exe . ") " . msg)
    }
}

; @summary Plain note when a window did not reach its saved size (more than 4 px off), with the likely reason; "" = fine.
; @tags macro, window, normalize, v17
V17_SizeNote(wantW, wantH, actualW, actualH, resizable) {
    if Abs(actualW - wantW) <= 4 && Abs(actualH - wantH) <= 4
        return ""
    why := !resizable ? "it is a fixed-size window"
        : actualW >= wantW - 4 && actualH >= wantH - 4 ? "it has a minimum size, or the display scaling is different"
        : actualW <= wantW + 4 && actualH <= wantH + 4 ? "it has a maximum size or does not fit the screen, or the display scaling is different"
        : "it has a size limit, or the display scaling is different"
    return "stayed " . actualW . "x" . actualH . " instead of " . wantW . "x" . wantH . " (" . why . "). Kept going."
}

; @summary A note that does not stop the run: kept on the runner (shown at the end), logged, and shown in the status bar.
; @tags macro, playback, log, v17
V17_Warn(ctx, msg) {
    if IsObject(ctx) && ctx.HasOwnProp("Warnings")
        ctx.Warnings.Push(msg)
    V17_Log("NOTE  " . msg)
    try VMB_Status("⚠ " . msg)
}

; @summary Writes a line to last-playback.log (fresh = start a new log). Does nothing when no log path is set.
; @tags macro, playback, log, v17
V17_Log(text, fresh := false) {
    path := VM_Config().LogPath
    if path = ""
        return
    line := FormatTime(, "yyyy-MM-dd HH:mm:ss") . "  " . text . "`r`n"
    try {
        if fresh
            V4_Write(path, line)
        else
            FileAppend(line, path, "UTF-8")
    }
}

; Recording: which window the last step went to, and which windows already got a Normalize step.
V17_RecWin() {
    static r := {On: false, Last: 0, Seen: Map(), MacroHwnd: 0, AutoPick: false, AutoTarget: "", AutoGeo: 0, Trial: []}
    return r
}

; @summary Recording starts: reads "Normalize new windows while recording" and treats the Macro window as already
;          set up (step #1 normalizes it).
; @tags macro, record, window, v17
V17_RecWinStart() {
    s := VMB(), r := V17_RecWin()
    r.On := s.Ctl.Has("AutoNorm") && s.Ctl["AutoNorm"].Value
    r.Seen := Map(), r.Last := 0, r.MacroHwnd := 0, r.Trial := []
    r.AutoPick := r.On && V18_CanAutoPick(), r.AutoTarget := "", r.AutoGeo := 0
    target := Trim(s.Macro["settings"].Get("defaultTarget", ""))
    if target != "" {
        try {
            if s.PinHwnd && WinExist(target . " ahk_id " . s.PinHwnd)
                r.MacroHwnd := s.PinHwnd
            else
                r.MacroHwnd := WinExist(target)
        }
    }
    if r.MacroHwnd
        r.Seen[r.MacroHwnd] := 1, r.Last := r.MacroHwnd
}

; @summary Called before each recorded click, key or typing: when it goes to a different real window, records
;          "Use Window From Here On" for it, plus "Normalize Window Geometry" (its current size and spot) the first time.
; @tags macro, record, window, normalize, v17
V17_RecNoteWindow(hwnd) {
    r := V17_RecWin()
    if !r.On || !hwnd
        return
    hwnd := DllCall("GetAncestor", "Ptr", hwnd, "UInt", 2, "Ptr")
    if !hwnd || hwnd = r.Last
        return
    info := V17_RealWindow(hwnd)
    if !info
        return
    if r.AutoPick && !r.MacroHwnd {     ; V18: the first real window used becomes the Macro window (no steps needed)
        target := V17_WindowSelector(info.Exe, info.Cls)
        try {
            if target != "" {
                r.AutoGeo := V17_WindowGeometry(hwnd)
                r.AutoTarget := target, r.MacroHwnd := hwnd, r.Seen[hwnd] := 1, r.Last := hwnd
                r.Trial.Push({Hwnd: hwnd, Node: 0})     ; V19: its Normalize step is made when recording stops
                return
            }
        }
    }
    isMacro := hwnd = r.MacroHwnd
    selector := isMacro ? "" : V17_WindowSelector(info.Exe, info.Cls)
    if !isMacro && selector = ""
        return
    geo := 0
    if !r.Seen.Has(hwnd)
        try geo := V17_WindowGeometry(hwnd)
    for node in V17_SwitchSteps(selector, geo) {
        V4_RecordAdd(node)
        if node.Get("type", "") = "det_normalize_win"      ; V19: its size is tested when recording stops
            r.Trial.Push({Hwnd: hwnd, Node: node})
    }
    r.Seen[hwnd] := 1
    r.Last := hwnd
}

; @summary Steps recorded when the task moves to another window. selector "" = back to the Macro window.
;          geo (V17_WindowGeometry) = the window is new, so a Normalize step with its size and spot is added too.
; @tags macro, record, window, normalize, v17
V17_SwitchSteps(selector, geo := 0) {
    use := V4_CreateNode("det_use_window")
    use["target"] := selector
    out := [use]
    if IsObject(geo) {
        norm := V4_CreateNode("det_normalize_win")
        for key, value in V17_GeometryFields(geo)
            norm[key] := value
        out.Push(norm)
    }
    return out
}

; @summary {Exe, Cls} for a real program window (title bar, not a tool window, not the taskbar / desktop / a menu /
;          a dropdown / this editor), else 0.
; @tags macro, record, window, v17
V17_RealWindow(hwnd) {
    id := "ahk_id " . hwnd
    try {
        if WinGetPID(id) = DllCall("GetCurrentProcessId")
            return 0
        cls := WinGetClass(id), style := WinGetStyle(id), exStyle := WinGetExStyle(id)
        exe := WinGetProcessName(id)
    } catch
        return 0
    return V17_IsRealWindow(cls, style, exStyle) ? {Exe: exe, Cls: cls} : 0
}

; @summary True for a class / style that is a real program window or dialog (has a title bar, is not a tool window,
;          and is not a shell, menu, tooltip or dropdown class).
; @tags macro, record, window, v17
V17_IsRealWindow(cls, style, exStyle) {
    static shell := "i)^(Shell_TrayWnd|Shell_SecondaryTrayWnd|Progman|WorkerW|#32768|tooltips_class32|ComboLBox"
        . "|NotifyIconOverflowWindow|TopLevelWindowForOverflowXamlIsland|Windows\.UI\.Core\.CoreWindow"
        . "|TaskListThumbnailWnd|XamlExplorerHostIslandWindow|MultitaskingViewFrame|ForegroundStaging|SysShadow"
        . "|Net UI Tool Window|DropDown)$"
    if RegExMatch(cls, shell)
        return false
    if (style & 0xC00000) != 0xC00000       ; WS_CAPTION
        return false
    return !(exStyle & 0x80)                ; WS_EX_TOOLWINDOW
}

; ============================================================================
; V18 ONE-CLICK RECORD + STEADY PLAYBACK
; Record: an empty macro picks its Macro window by itself (the first real window used), recorded steps are tidied
; (double-clicks, wheel runs) and clicks on this editor are ignored.
; Steady playback (macro setting "steady"): every step waits for its window, and every recorded click waits until
; the screen at its spot looks like the recording. Nothing here runs for a macro without the setting.
; Settings read (all optional): steady 0/1, windowWaitSec (10), verifyClicks 0/1 (1), verifyMs (1500).
; The picture check compares pixels itself (the same screen grab the recorder uses) instead of ImageSearch, and only
; ever looks at the recorded spot - it never sends a click somewhere else on the screen.
; ============================================================================

; @summary True when this run uses Steady playback.
; @tags macro, playback, steady, v18
V18_Steady(runner) {
    return IsObject(runner) && runner.HasOwnProp("Settings") && runner.Settings.Get("steady", 0) ? true : false
}

; @summary True when Record may pick the Macro window by itself: an empty macro with no Macro window yet, and
;          "Normalize new windows while recording" on.
; @tags macro, record, window, v18
V18_CanAutoPick() {
    s := VMB()
    if !(s.Macro is Map) || s.Macro["blocks"].Length || Trim(s.Macro["settings"].Get("defaultTarget", "")) != ""
        return false
    return s.Ctl.Has("AutoNorm") && s.Ctl["AutoNorm"].Value ? true : false
}

; @summary True when a window belongs to this script (editor, REC bar, run bar, HUD).
; @tags macro, record, window, v18
V18_OwnWindow(hwnd) {
    if !hwnd
        return false
    try return WinGetPID("ahk_id " . hwnd) = DllCall("GetCurrentProcessId")
    return false
}

; @summary True for a window class that is different on every run (WPF, WinForms, MFC, ATL, or a long hex number),
;          so it can't be used to find the window again.
; @tags macro, window, v18
V18_ClassChanges(cls) => RegExMatch(cls, "i)^(HwndWrapper\[|WindowsForms10\.|Afx:|ATL:)|[0-9A-F]{8,}") != 0

; @summary How long a Steady step waits for its window, in ms (setting windowWaitSec, default 10 s).
; @tags macro, playback, steady, v18
V18_WaitMs(runner) => Max(0, Number(runner.Settings.Get("windowWaitSec", 10))) * 1000

; @summary "1920x1080 @ 100%": the primary screen's size and scaling.
; @tags macro, record, v18
V18_ScreenText() => A_ScreenWidth . "x" . A_ScreenHeight . " @ " . Round(A_ScreenDPI / 96 * 100) . "%"

; @summary Steady playback start: notes when the screen size or scaling is not the one the macro was recorded on.
; @tags macro, playback, steady, v18
V18_ScreenCheck(runner) {
    if !V18_Steady(runner)
        return
    was := runner.Settings.Get("recScreen", ""), now := V18_ScreenText()
    if was != "" && was != now
        V17_Warn(runner, "Recorded on a " . was . " screen, playing on " . now
            . ". Clicks may land differently - record again on this screen if they do.")
}

; @summary Waits (up to 2.5 s) until Ctrl, Shift, Alt and Win are physically released.
; @tags macro, playback, v18
V18_WaitModsUp(timeoutMs := 2500) {
    deadline := A_TickCount + timeoutMs
    for key in ["Ctrl", "Shift", "Alt", "LWin", "RWin"]
        while GetKeyState(key, "P") && A_TickCount < deadline
            Sleep(15)
}

; @summary The open windows a recorded step could mean. Exact = the recorded window class is among them (or the
;          class changes from run to run, so any window of the program counts).
; @returns {List, Exact}
; @tags macro, playback, window, steady, v18
V18_Matches(win) {
    selector := "ahk_exe " . win["exe"]
    cls := win.Get("cls", "")
    if cls != "" && !V18_ClassChanges(cls) {
        list := WinGetList(selector . " ahk_class " . cls)
        return {List: list, Exact: list.Length > 0}
    }
    list := WinGetList(selector)
    return {List: list, Exact: list.Length > 0}
}

; @summary Picks one window from the matches: the recorded title when the step asks for it, else the active window
;          when it is one of them, else the front-most one.
; @tags macro, playback, window, steady, v18
V18_Choose(matches, node, win) {
    if node.Get("winMatch", "") != "program" && win.Get("title", "") != "" {
        wantTitle := win["title"]
        for id in matches
            if WinGetTitle("ahk_id " . id) = wantTitle
                return id
        for id in matches {
            curTitle := WinGetTitle("ahk_id " . id)
            if curTitle != "" && (InStr(curTitle, wantTitle) || InStr(wantTitle, curTitle))
                return id
        }
    }
    active := WinExist("A")
    return VM__IndexOf(matches, active) ? active : matches[1]
}

; @summary Steady playback's V4_Window: waits for the step's program and window kind to be open, brings it to the
;          front and returns it. Throws (so the run pauses / asks) when it never shows up.
; @tags macro, playback, window, steady, v18
V18_Window(node, runner) {
    if node.Get("winMatch", "") = "active"
        return WinExist("A")
    win := node.Get("win", "")
    if !(win is Map) || win.Get("exe", "") = ""
        return WinExist("A")
    waitMs := V18_WaitMs(runner), start := A_TickCount
    loop {
        found := V18_Matches(win)
        if found.Exact || A_TickCount - start >= waitMs
            break
        runner.Sleep(100)
    }
    if !found.Exact {
        secs := Round(waitMs / 1000)
        if WinGetList("ahk_exe " . win["exe"]).Length
            throw Error("The '" . win.Get("cls", "") . "' window of " . win["exe"] . " did not open within " . secs
                . " s. Get the program to that window, then retry this step.")
        throw Error(win["exe"] . " is not open (waited " . secs . " s). Open it, then retry this step.")
    }
    hwnd := V18_Choose(found.List, node, win)
    V18_Activate(hwnd, runner, RegExMatch(node.Get("type", ""), "^(click|drag|wheel)$") = 0)
    return hwnd
}

; @summary Waits for a window selector (Macro window / "Use Window" target) to exist. Throws when it never does.
; @tags macro, playback, window, steady, v18
V18_WaitTarget(target, runner) {
    waitMs := V18_WaitMs(runner), start := A_TickCount
    while !(hwnd := WinExist(target)) {
        if A_TickCount - start >= waitMs
            throw Error("'" . target . "' is not open (waited " . Round(waitMs / 1000) . " s). Open it, then retry this step.")
        runner.Sleep(100)
    }
    return hwnd
}

; @summary Brings a window to the front (restoring it when minimized), trying three times.
;          Menus, dropdowns and other windows without a title bar are left alone for mouse steps - taking the focus
;          would close them. strict = a typing step: failing to get a real window in front throws, because the keys
;          would go to some other window. For mouse steps it is only noted.
; @returns true when the window is active (or needs no activation)
; @tags macro, playback, window, steady, v18
V18_Activate(hwnd, runner, strict := true) {
    id := "ahk_id " . hwnd
    if WinActive(id)
        return true
    real := true
    try real := V17_IsRealWindow(WinGetClass(id), WinGetStyle(id), WinGetExStyle(id))
    if !real && !strict
        return true
    try {
        if WinGetMinMax(id) = -1
            WinRestore(id)
    }
    Loop 3 {
        try WinActivate(id)
        if WinWaitActive(id, , 1)
            return true
        runner.Sleep(150)
    }
    if !real
        return false
    name := "the window"
    try name := WinGetProcessName(id)
    msg := "Could not bring " . name . " to the front (another window may be in the way)."
    if strict
        throw Error(msg . " Close what is blocking it, then retry this step.")
    V17_Warn(runner, "Step #" . runner.Index . ": " . msg . " Clicked anyway.")
    return false
}

; @summary An embedded click picture, decoded once: its size, its pixels and whether it is "plain" (one colour over
;          90% of it - an empty field or blank background, which looks the same everywhere). Cached per picture.
; @returns {W, H, Plain, Buf}  Buf = the BMP bytes (32-bit pixels from byte 54, top row first), 0 when unreadable
; @tags macro, playback, picture, steady, v18
V18_PatchInfo(pattern) {
    static cache := Map()
    if cache.Has(pattern)
        return cache[pattern]
    info := {W: 0, H: 0, Plain: true, Buf: 0}
    try {
        buf := V4_Unbase64(SubStr(pattern, 7))
        if buf.Size >= 54 && NumGet(buf, 0, "UShort") = 0x4D42 && NumGet(buf, 28, "UShort") = 32
            && NumGet(buf, 22, "Int") < 0 {                 ; top-down, the way V4_CaptureBmp writes them
            w := NumGet(buf, 18, "Int"), h := -NumGet(buf, 22, "Int")
            if w > 0 && h > 0 && buf.Size >= 54 + w * h * 4 {
                info.W := w, info.H := h, info.Buf := buf
                info.Plain := V18_IsPlain(buf, w, h)
            }
        }
    }
    if cache.Count >= 400
        cache.Clear()
    cache[pattern] := info
    return info
}

; @summary True when one colour (in steps of 16 per channel) covers at least 90% of a 32-bit BMP's pixels.
; @tags macro, picture, steady, v18
V18_IsPlain(buf, w, h) {
    total := w * h
    if total < 1 || buf.Size < 54 + total * 4
        return true
    counts := Map(), best := 0
    Loop total {
        key := NumGet(buf, 54 + (A_Index - 1) * 4, "UInt") & 0xF0F0F0
        n := counts.Get(key, 0) + 1
        counts[key] := n
        if n > best
            best := n
    }
    return best >= total * 0.9
}

; @summary The screen's pixels in a box, taken the same way a click picture is taken when recording.
; @returns Buffer of w * h 32-bit pixels (top row first), or 0 when the screen can't be read
; @tags macro, playback, picture, steady, v18
V18_GrabPixels(x, y, w, h) {
    if w < 1 || h < 1
        return 0
    dc := DllCall("GetDC", "Ptr", 0, "Ptr")
    mem := 0, bmp := 0, old := 0
    try {
        mem := DllCall("gdi32\CreateCompatibleDC", "Ptr", dc, "Ptr")
        bi := Buffer(40, 0)
        NumPut("UInt", 40, "Int", w, "Int", -h, "UShort", 1, "UShort", 32, bi)
        bits := 0
        bmp := DllCall("gdi32\CreateDIBSection", "Ptr", dc, "Ptr", bi, "UInt", 0, "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
        if !mem || !bmp || !bits
            return 0
        old := DllCall("gdi32\SelectObject", "Ptr", mem, "Ptr", bmp, "Ptr")
        if !DllCall("gdi32\BitBlt", "Ptr", mem, "Int", 0, "Int", 0, "Int", w, "Int", h,
            "Ptr", dc, "Int", x, "Int", y, "UInt", 0x40CC0020)
            return 0
        out := Buffer(w * h * 4)
        DllCall("RtlMoveMemory", "Ptr", out.Ptr, "Ptr", bits, "UPtr", out.Size)
        return out
    } catch
        return 0
    finally {
        if old
            DllCall("gdi32\SelectObject", "Ptr", mem, "Ptr", old)
        if bmp
            DllCall("gdi32\DeleteObject", "Ptr", bmp)
        if mem
            DllCall("gdi32\DeleteDC", "Ptr", mem)
        if dc
            DllCall("ReleaseDC", "Ptr", 0, "Ptr", dc)
    }
}

; @summary True when a click picture matches the grabbed screen pixels with its top-left at (ox, oy) inside them.
;          A pixel matches when each colour channel is within vary; up to 2% of the pixels may differ (a blinking
;          text cursor, a focus dot).
; @tags macro, playback, picture, steady, v18
V18_PixelsMatch(info, scr, scrW, ox, oy, vary := 40) {
    w := info.W, h := info.H, budget := Floor(w * h * 0.02), bad := 0
    pat := info.Buf.Ptr + 54, base := scr.Ptr
    Loop h {
        pRow := pat + (A_Index - 1) * w * 4, sRow := base + ((oy + A_Index - 1) * scrW + ox) * 4
        Loop w {
            off := (A_Index - 1) * 4
            a := NumGet(pRow + off, "UInt") & 0xFFFFFF, b := NumGet(sRow + off, "UInt") & 0xFFFFFF
            if a = b
                continue
            if Abs((a & 255) - (b & 255)) > vary || Abs(((a >> 8) & 255) - ((b >> 8) & 255)) > vary
                || Abs((a >> 16) - (b >> 16)) > vary {
                bad += 1
                if bad > budget
                    return false
            }
        }
    }
    return true
}

; @summary Where a click picture is on the screen right now, looking only at its recorded place (left, top) and up
;          to reach px around it.
; @returns {DX, DY} (0, 0 = exactly in place), or 0 when it is not there
; @tags macro, playback, picture, steady, v18
V18_LocatePatch(info, left, top, reach, vary := 40) {
    w := info.W + 2 * reach, h := info.H + 2 * reach
    scr := V18_GrabPixels(left - reach, top - reach, w, h)
    if !scr
        return 0
    if V18_PixelsMatch(info, scr, w, reach, reach, vary)
        return {DX: 0, DY: 0}
    best := 0, bestDist := 0
    Loop 2 * reach + 1 {
        oy := A_Index - 1
        Loop 2 * reach + 1 {
            ox := A_Index - 1
            dist := Abs(ox - reach) + Abs(oy - reach)
            if dist && (!IsObject(best) || dist < bestDist) && V18_PixelsMatch(info, scr, w, ox, oy, vary)
                best := {DX: ox - reach, DY: oy - reach}, bestDist := dist
        }
    }
    return best
}

; @summary Steady click: moves the mouse to the spot (the picture was taken with the mouse resting there) and waits
;          until the screen at the spot looks like the recorded picture (setting verifyMs, default 1.5 s). A drift of
;          up to 6 px is corrected. When it never matches, the recorded spot is clicked anyway and a note is kept -
;          the run goes on.
;          Skipped for steps that vary each round, steps without a picture, and verifyClicks = 0 / noVerify = 1.
; @returns {X, Y} to click
; @tags macro, playback, picture, steady, v18
V18_VerifySpot(node, hwnd, runner, point) {
    if !runner.Settings.Get("verifyClicks", 1) || node.Get("noVerify", 0)
        return point
    pattern := node.Get("pattern", "")
    if SubStr(pattern, 1, 6) != "V4BMP:" || !node.Has("offsetX") || !node.Has("offsetY")
        return point
    spots := node.Get("varySpots", "")
    if (spots is Array && spots.Length) || Number(node.Get("varyDX", 0)) != 0 || Number(node.Get("varyDY", 0)) != 0
        return point
    info := V18_PatchInfo(pattern)
    if !IsObject(info.Buf) || info.W < 4 || info.H < 4
        return point
    left := point.X - Integer(node["offsetX"]), top := point.Y - Integer(node["offsetY"])
    reach := info.Plain ? 0 : 6         ; a plain picture matches anywhere, so it is only compared in place
    for corner in [[point.X, point.Y], [left - reach, top - reach], [left + info.W + reach, top - reach],
        [left - reach, top + info.H + reach], [left + info.W + reach, top + info.H + reach]]
        V5_HideOverlays(corner[1], corner[2])       ; the run bar must not be in the picture
    MouseMove(point.X, point.Y, 0)
    waitMs := Max(0, Number(runner.Settings.Get("verifyMs", 1500))), start := A_TickCount
    loop {
        at := V18_LocatePatch(info, left, top, reach)
        if IsObject(at)
            return {X: point.X + at.DX, Y: point.Y + at.DY}
        if A_TickCount - start >= waitMs
            break
        runner.Sleep(100)
    }
    V17_Warn(runner, "Step #" . runner.Index . ": the screen at the click spot did not look like the recording (waited "
        . Round(waitMs / 1000, 1) . " s); clicked the recorded spot anyway.")
    return point
}

; @summary Holds down the recorded click modifiers ("^" = Ctrl, "+" = Shift). Returns the keys to release.
; @tags macro, playback, v18
V18_ModsDown(mods) {
    held := []
    for pair in [["^", "Ctrl"], ["+", "Shift"]]
        if InStr(mods, pair[1]) {
            SendEvent("{" . pair[2] . " down}")
            held.Push(pair[2])
        }
    return held
}
V18_ModsUp(held) {
    for key in held
        SendEvent("{" . key . " up}")
}

; @summary A recorded wheel step. When the window under the mouse can be read it also keeps that window and the
;          spot inside it, so playback scrolls the same pane instead of whatever the mouse happens to be over.
; @tags macro, record, wheel, v18
V18_WheelStep(direction, x, y, hwnd) {
    step := Map("type", "wheel", "direction", direction, "count", 1, "win", V4_RecordWin())
    try {
        geo := V14_CaptureGeo(hwnd, x, y)
        if geo is Map {
            win := Map("exe", WinGetProcessName("ahk_id " . hwnd), "cls", WinGetClass("ahk_id " . hwnd), "title", "")
            step["win"] := win, step["geo"] := geo
        }
    }
    scroll := V19_CaptureScroll(x, y)               ; V19: the scroll position before this wheel notch
    if scroll is Map
        step["scroll"] := scroll
    return step
}

; @summary Same window (program + class) for two recorded steps.
; @tags macro, record, v18
V18_SameWin(a, b) {
    wa := a.Get("win", ""), wb := b.Get("win", "")
    if !(wa is Map) || !(wb is Map)
        return false
    return wa.Get("exe", "") = wb.Get("exe", "") && wa.Get("cls", "") = wb.Get("cls", "")
}

; @summary True when click b is the second (or third) press of a double-click that started with click a.
; @tags macro, record, v18
V18_SameClick(a, b, dblMs) {
    if a.Get("type", "") != "click" || b.Get("type", "") != "click"
        return false
    if a.Has("varyMarked") || b.Has("varyMarked") || a.Get("count", 1) >= 3
        return false
    if a.Get("button", "Left") != b.Get("button", "Left") || a.Get("mods", "") != b.Get("mods", "")
        return false
    if !a.Has("scrX") || !b.Has("scrX") || Abs(a["scrX"] - b["scrX"]) > 4 || Abs(a["scrY"] - b["scrY"]) > 4
        return false
    return b.Get("gapMs", 99999) <= dblMs && V18_SameWin(a, b)
}

; @summary True when wheel step b carries on wheel step a (same direction and window, within 0.4 s).
; @tags macro, record, v18
V18_SameWheel(a, b) {
    if a.Get("type", "") != "wheel" || b.Get("type", "") != "wheel"
        return false
    if a.Has("varyMarked") || b.Has("varyMarked")
        return false
    return a.Get("direction", "") = b.Get("direction", "") && b.Get("gapMs", 99999) <= 400 && V18_SameWin(a, b)
}

; @summary Tidies freshly recorded steps in place: a double-click becomes one click step with count 2 (two single
;          clicks replayed with their own waits are often too slow to count as a double-click), and a run of wheel
;          notches becomes one wheel step.
; @returns how many steps were joined into the one before
; @tags macro, record, v18
V18_TidySteps(steps, dblMs := unset) {
    if !(steps is Array)
        return 0
    if !IsSet(dblMs)
        dblMs := DllCall("GetDoubleClickTime", "UInt")
    joined := 0, i := 2
    while i <= steps.Length {
        a := steps[i - 1], b := steps[i]
        isClick := V18_SameClick(a, b, dblMs)
        if isClick || V18_SameWheel(a, b) {
            a["count"] := a.Get("count", 1) + (isClick ? 1 : b.Get("count", 1))
            if b.Has("_tick")
                a["_tick"] := b["_tick"]
            steps.RemoveAt(i), joined += 1
        } else
            i += 1
    }
    return joined
}

; @summary Recording stopped and its steps are in the macro: a macro that was empty gets Steady playback and the
;          screen it was recorded on, and the window Record picked by itself becomes the Macro window with a
;          Normalize step as step #1.
; @returns a short note for the status bar ("" when no window was picked)
; @tags macro, record, window, normalize, v18
V18_FinishRecording() {
    s := VMB(), r := V17_RecWin(), m := s.Macro["settings"], note := ""
    if s.RecWasEmpty {
        m["steady"] := 1
        m["recScreen"] := V18_ScreenText()
    }
    if r.AutoTarget != "" && IsObject(r.AutoGeo) && Trim(m.Get("defaultTarget", "")) = "" {
        m["defaultTarget"] := r.AutoTarget
        s.PinHwnd := r.MacroHwnd
        norm := V17_TopNormalize(s.Macro["blocks"], r.AutoTarget, true)
        for key, value in V17_GeometryFields(r.AutoGeo)
            norm[key] := value
        norm["target"] := ""
        for trial in r.Trial                    ; V19: the auto-picked window's Normalize step exists only now
            if trial.Hwnd = r.MacroHwnd && !IsObject(trial.Node)
                trial.Node := norm
        trialNote := V19_RunSizeTrials(r.Trial)    ; first, so the size in the note below is the saved one
        r.Trial := []
        note := "  Macro window: " . r.AutoTarget . " - step #1 puts it back to " . V17_NormText(norm) . "." . trialNote
    }
    note .= V19_RunSizeTrials(r.Trial)          ; V19: windows that got a Normalize step while recording
    r.Trial := []
    r.AutoTarget := "", r.AutoGeo := 0, r.AutoPick := false
    VMB_SettingsToControls()
    return note
}

; @summary The last picture taken under the resting mouse while recording.
;          V17 took a click's picture when the button went down, at the same moment the program starts redrawing
;          (pressed button, selected row, switched tab), so the picture was sometimes the "before" and sometimes the
;          "after". A timer now takes it whenever the mouse has rested for a moment, and the click uses that one.
; @tags macro, record, picture, v18
V18_PreShot() {
    static p := {X: "", Y: "", Pattern: "", Left: 0, Top: 0, Tick: 0, Used: 0}
    return p
}
V18_PreShotReset() {
    p := V18_PreShot()
    p.X := "", p.Y := "", p.Pattern := "", p.Used := 0
}

; @summary The 40x30 box a click picture covers (the same box VM_CaptureClickStep uses), kept on the screen.
; @returns {Left, Top, W, H}
; @tags macro, record, picture, v18
V18_PatchBox(x, y) {
    left := Max(SysGet(76), Round(x) - 20), top := Max(SysGet(77), Round(y) - 15)
    return {Left: left, Top: top, W: Min(40, SysGet(76) + SysGet(78) - left), H: Min(30, SysGet(77) + SysGet(79) - top)}
}

; @summary Recording timer (every 80 ms): when the mouse is where it was on the last tick, no button is down and it
;          is not over this editor, takes the picture under it.
; @tags macro, record, picture, v18
V18_PreShotTick() {
    p := V18_PreShot()
    if !V4_RecordAllowed() || GetKeyState("LButton") || GetKeyState("RButton") || GetKeyState("MButton")
        return
    CoordMode("Mouse", "Screen")
    MouseGetPos(&x, &y, &hwnd)
    if x != p.X || y != p.Y {
        p.X := x, p.Y := y, p.Pattern := ""
        return
    }
    if V18_OwnWindow(hwnd)
        return
    try {
        box := V18_PatchBox(x, y)
        p.Pattern := V4_CaptureBmp(box.Left, box.Top, box.W, box.H)
        p.Left := box.Left, p.Top := box.Top, p.Tick := A_TickCount
    } catch
        p.Pattern := ""
}

; @summary Gives a just-recorded click the resting-mouse picture when there is a fresh one (taken within 0.4 s, mouse
;          within 2 px). A fast click with no rest keeps the picture taken at the press.
; @returns true when the picture was replaced
; @tags macro, record, picture, v18
V18_UsePreShot(step, x, y, now := unset) {
    p := V18_PreShot()
    if p.Pattern = "" || p.X = "" || Abs(x - p.X) > 2 || Abs(y - p.Y) > 2 || (IsSet(now) ? now : A_TickCount) - p.Tick > 400
        return false
    step["pattern"] := p.Pattern
    step["offsetX"] := Round(x) - p.Left, step["offsetY"] := Round(y) - p.Top
    p.Used += 1
    return true
}

; ============================================================================
; V19 WINDOW SIZE + SCROLL
; A Normalize step waits until the window really has its size (no fixed pause). When recording stops, each new
; window's size is tested once (a window that snaps to its own sizes gets the size it settles at). Setting
; sizeMismatch "stop" stops the run when a window can't take its size. Each recorded click / wheel step remembers
; the scroll position of the standard Windows list or box under it ("scroll"); Steady playback puts it back first.
; ============================================================================

; @summary Decides when to stop waiting for a window size. samples = array of [tickMs, w, h], oldest first.
; @returns "ok" (within 1 px of the wanted size on the last two reads), "stuck" (the size has not changed for
;          300 ms and is not the wanted size: the program refused it), or "" (keep waiting)
; @tags macro, window, normalize, v19
V19_SizeVerdict(samples, wantW, wantH) {
    n := samples.Length
    if !n
        return ""
    last := samples[n]
    lastOk := Abs(last[2] - wantW) <= 1 && Abs(last[3] - wantH) <= 1
    if lastOk && n >= 2 && Abs(samples[n - 1][2] - wantW) <= 1 && Abs(samples[n - 1][3] - wantH) <= 1
        return "ok"
    if lastOk
        return ""
    first := n
    while first > 1 && samples[first - 1][2] = last[2] && samples[first - 1][3] = last[3]
        first -= 1
    return last[1] - samples[first][1] >= 300 ? "stuck" : ""
}

; @summary Waits until a window has the wanted size: reads it every 50 ms (Esc-stoppable when ctx is a runner,
;          a plain Sleep when ctx is 0). byPos = true compares the position (x, y) instead, for a fixed-size window.
; @returns "ok", "stuck" (the program refused the size) or "timeout" (after maxMs, or the window is gone)
; @tags macro, window, normalize, v19
V19_WaitSize(id, wantW, wantH, ctx, maxMs := 2000, byPos := false) {
    samples := [], start := A_TickCount
    loop {
        try WinGetPos(&wx, &wy, &ww, &wh, id)
        catch
            return "timeout"
        samples.Push(byPos ? [A_TickCount, wx, wy] : [A_TickCount, ww, wh])
        verdict := V19_SizeVerdict(samples, wantW, wantH)
        if verdict != ""
            return verdict
        if A_TickCount - start >= maxMs
            return "timeout"
        if IsObject(ctx)
            ctx.Sleep(50)
        else
            Sleep(50)
    }
}

; @summary Result of a size trial: does the window go back to its recorded size after being made bigger?
; @returns {Holds (back within 1 px of the recorded size), W, H (the size it went back to), CanGrow}
; @tags macro, window, normalize, record, v19
V19_TrialResult(recW, recH, grewW, grewH, backW, backH) {
    return {Holds: Abs(backW - recW) <= 1 && Abs(backH - recH) <= 1, W: backW, H: backH,
        CanGrow: grewW > recW || grewH > recH}
}

; @summary Recording stopped: makes the window 60 px bigger, then puts it back, and reads which size it takes.
;          Always ends by moving the window back to where it was. Any error = {Holds: true} (never blocks the user).
; @returns V19_TrialResult object
; @tags macro, window, normalize, record, v19
V19_SizeTrial(hwnd) {
    id := "ahk_id " . hwnd, res := {Holds: true}, read := false
    try {
        WinGetPos(&wx, &wy, &ww, &wh, id)
        read := true
        WinMove(wx, wy, ww + 60, wh + 60, id)
        V19_WaitSize(id, ww + 60, wh + 60, 0)
        WinGetPos(, , &grewW, &grewH, id)
        WinMove(wx, wy, ww, wh, id)
        V19_WaitSize(id, ww, wh, 0)
        WinGetPos(, , &backW, &backH, id)
        res := V19_TrialResult(ww, wh, grewW, grewH, backW, backH)
    }
    if read
        try WinMove(wx, wy, ww, wh, id)
    return res
}

; @summary Recording stopped: runs the size trial once for each window that got a Normalize step and is still open,
;          resizable and not maximized (not this script's windows). A window that snaps to its own sizes gets the
;          size it settles at saved in its Normalize step.
; @returns a note for the status bar, or ""
; @tags macro, window, normalize, record, v19
V19_RunSizeTrials(trials) {
    snapped := false
    for trial in trials {
        node := trial.Node
        if !IsObject(node) || node.Get("sizeChecked", 0) || V4_Bool(node.Get("maximize", 0))
            continue
        open := false
        try {
            id := "ahk_id " . trial.Hwnd
            if WinExist(id) && !V18_OwnWindow(trial.Hwnd) && WinGetMinMax(id) = 0 && V17_IsResizable(WinGetStyle(id)) {
                WinGetPos(, , &curW, &curH, id)
                open := true
            }
        }
        if !open || Abs(curW - node.Get("width", 0)) > 1 || Abs(curH - node.Get("height", 0)) > 1
            continue        ; closed, fixed-size, maximized - or resized after its step was recorded
        res := V19_SizeTrial(trial.Hwnd)
        node["sizeChecked"] := 1
        if !res.Holds {
            node["width"] := res.W, node["height"] := res.H
            snapped := true
        }
    }
    return snapped ? "  This window only takes certain sizes. Saved the size it settles at." : ""
}

; @summary The "size is off" note without its trailing " Kept going." (for the message when the run stops instead).
; @tags macro, window, normalize, v19
V19_MismatchText(msg) => SubStr(msg, -12) = " Kept going." ? SubStr(msg, 1, -12) : msg

; @summary Scroll bar numbers of a control. bar: 0 = horizontal, 1 = vertical.
; @returns {Min, Max, Page, Pos}, or 0 when the control has no such scroll bar
; @tags macro, scroll, v19
V19_ScrollInfo(hwnd, bar) {
    si := Buffer(28, 0)
    NumPut("UInt", 28, "UInt", 0x17, si)        ; cbSize, SIF_ALL
    if !DllCall("GetScrollInfo", "Ptr", hwnd, "Int", bar, "Ptr", si)
        return 0
    return {Min: NumGet(si, 8, "Int"), Max: NumGet(si, 12, "Int"),
        Page: NumGet(si, 16, "UInt"), Pos: NumGet(si, 20, "Int")}
}

; @summary True when a scroll bar (V19_ScrollInfo result, or 0) can actually scroll: the content is longer than a page.
; @tags macro, scroll, v19
V19_CanScroll(info) => IsObject(info) && info.Max > info.Min && info.Max - info.Min + 1 > info.Page

; @summary The scroll position read back from a control, or "" when it has no such scroll bar.
; @tags macro, scroll, v19
V19_ScrollPos(hwnd, bar) {
    info := V19_ScrollInfo(hwnd, bar)
    return IsObject(info) ? info.Pos : ""
}

; @summary The list / box / pane under a screen point that has a scroll bar that can scroll (the control itself or
;          up to 7 parents). Never a window of this script.
; @returns its hwnd, or 0 when nothing there scrolls
; @tags macro, scroll, v19
V19_ScrollPane(x, y) {
    x := Round(x), y := Round(y)
    h := DllCall("WindowFromPoint", "Int64", (y << 32) | (x & 0xFFFFFFFF), "Ptr")
    desk := DllCall("GetDesktopWindow", "Ptr")
    loop 8 {
        if !h || h = desk || V18_OwnWindow(h)
            return 0
        if V19_CanScroll(V19_ScrollInfo(h, 1)) || V19_CanScroll(V19_ScrollInfo(h, 0))
            return h
        h := DllCall("GetAncestor", "Ptr", h, "UInt", 1, "Ptr")     ; GA_PARENT
    }
    return 0
}

; @summary Recording: the scroll position of the pane under a click / wheel spot.
; @returns Map("cls", class, and per bar that can scroll "v" / "vMax" / "vPage" or "h" / "hMax" / "hPage"), or ""
; @tags macro, scroll, record, v19
V19_CaptureScroll(x, y) {
    try {
        pane := V19_ScrollPane(x, y)
        if !pane
            return ""
        out := Map("cls", WinGetClass("ahk_id " . pane))
        for pair in [["v", 1], ["h", 0]] {
            info := V19_ScrollInfo(pane, pair[2])
            if V19_CanScroll(info)
                out[pair[1]] := info.Pos, out[pair[1] . "Max"] := info.Max, out[pair[1] . "Page"] := info.Page
        }
        return out
    }
    return ""
}

; @summary A wanted scroll position kept inside what the bar allows: lo (Min) .. hi (Max) - page + 1 (page 0 counts as 1).
; @tags macro, scroll, v19
V19_ClampScroll(want, lo, hi, page) => VF_Clamp(want, lo, Max(lo, hi - Max(page, 1) + 1))

; @summary What to send next to step a scroll bar from pos towards want. far (a page or more away, page > 1) =
;          page up / down, else line up / down. Done after 2 flips (stepped over the target twice) or at the target.
; @returns {Code: 0 line up | 1 line down | 2 page up | 3 page down | 8 end (when Done), Done}
; @tags macro, scroll, v19
V19_ScrollStep(pos, want, page, flips) {
    delta := want - pos
    if delta = 0 || flips >= 2
        return {Code: 8, Done: true}
    far := page > 1 && Abs(delta) >= page
    return {Code: delta > 0 ? (far ? 3 : 1) : (far ? 2 : 0), Done: false}
}

; @summary Scrolls one bar of a pane to a position: first a jump (SB_THUMBPOSITION), then line / page steps, reading
;          the position back after each. Every message has a 500 ms timeout so a hung program can't hang the macro.
; @returns true when the bar ends exactly at want (after clamping)
; @tags macro, scroll, playback, v19
V19_ScrollTo(pane, bar, want, runner) {
    msg := bar = 1 ? 0x115 : 0x114            ; WM_VSCROLL / WM_HSCROLL
    info := V19_ScrollInfo(pane, bar)
    if !IsObject(info)
        return false
    want := V19_ClampScroll(want, info.Min, info.Max, info.Page)
    pos := info.Pos
    if pos = want
        return true
    if want >= 0 && want <= 65535 {           ; way 1: jump
        try SendMessage(msg, (want << 16) | 4, 0, pane, , , , , 500)     ; SB_THUMBPOSITION
        try SendMessage(msg, 8, 0, pane, , , , , 500)                    ; SB_ENDSCROLL
        pos := V19_ScrollPos(pane, bar)
        if pos = want
            return true
        if pos = ""
            return false
    }
    flips := 0, lastSign := 0                 ; way 2: step
    loop 600 {
        next := V19_ScrollStep(pos, want, info.Page, flips)
        if next.Done
            break
        try SendMessage(msg, next.Code, 0, pane, , , , , 500)
        now := V19_ScrollPos(pane, bar)
        if now = "" || now = pos
            break
        sign := now < want ? 1 : now > want ? -1 : 0
        if sign && lastSign && sign != lastSign
            flips += 1
        if sign
            lastSign := sign
        pos := now
        if Mod(A_Index, 50) = 0
            runner.Sleep(1)
    }
    try SendMessage(msg, 8, 0, pane, , , , , 500)                        ; SB_ENDSCROLL
    return pos = want                         ; way 3: give up (the caller notes it); the spot is never shifted
}

; @summary Steady playback, before a click / wheel step with a recorded "scroll": scrolls the list or box under the spot
;          back to where it was when recording. Skipped when the macro setting restoreScroll is 0.
; @returns true when the pane is where it was; false after a note (the step still clicks). Throws instead of the
;          "could not scroll" note when the macro setting sizeMismatch is "stop".
; @tags macro, scroll, playback, steady, v19
V19_RestoreScroll(node, point, runner) {
    if !runner.Settings.Get("restoreScroll", 1)
        return false
    rec := node["scroll"], isWheel := node.Get("type", "") = "wheel"
    V5_HideOverlays(point.X, point.Y)          ; the run bar must not hide the list from WindowFromPoint
    pane := V19_ScrollPane(point.X, point.Y), cls := ""
    if pane
        try cls := WinGetClass("ahk_id " . pane)
    if !pane || cls != rec.Get("cls", "") {
        V17_Warn(runner, "Step #" . runner.Index . ": the list that was scrolled when recording was not found at the "
            . (isWheel ? "mouse spot. Scrolled anyway." : "click spot. Clicked anyway."))
        return false
    }
    changed := false, missed := "", longer := false
    for pair in [["v", 1], ["h", 0]] {
        key := pair[1]
        if !rec.Has(key)
            continue
        want := rec[key], info := V19_ScrollInfo(pane, pair[2])
        if IsObject(info) && info.Pos = want
            continue
        if IsObject(info) && rec.Has(key . "Max") && info.Max != rec[key . "Max"]
            longer := true
        changed := true
        if !V19_ScrollTo(pane, pair[2], want, runner) || V19_ScrollPos(pane, pair[2]) != want {     ; V20: also when the list is now too short
            now := V19_ScrollPos(pane, pair[2])
            missed .= (missed = "" ? "" : "; ") . "now at " . (now = "" ? "?" : now) . ", recorded " . want
        }
    }
    if missed != "" {
        text := "Step #" . runner.Index . ": could not scroll the list back to where it was (" . missed . ")"
            . (longer ? " (the list is a different length than when it was recorded)" : "") . "."
        if runner.Settings.Get("sizeMismatch", "") = "stop"
            throw Error(text . " Scroll it back by hand, then retry this step.")
        V17_Warn(runner, text . (isWheel ? " Scrolled anyway." : " Clicked anyway."))
        return false
    }
    if changed
        runner.Sleep(80)                       ; let the pane re-draw before the picture check
    return true
}

; ============================================================================
; V20 STEP LINES
; Each step in the macro list reads as one plain sentence: what is done, to what, in which program, and whereabouts
; in the window - then small tags for anything unusual (a long pause, a list scrolled back first, a note).
; While recording, a click also remembers WHAT was under the mouse ("what": a button's caption, a menu item's
; text, or just the kind of control). Text inside boxes, lists and labels is never saved - only captions of
; buttons, tabs and menu items.
; ============================================================================

; @summary A length of time for a step line: "500 ms", "1.5 s", "2 s", "12 s".
; @tags macro, explain, v20
V20_Time(ms) {
    ms := IsNumber(ms) ? Number(ms) : 0
    return ms < 1000 ? Round(ms) . " ms" : RegExReplace(Format("{:.1f}", ms / 1000), "\.0$") . " s"
}

; @summary Program name for a step line: "notepad" from "notepad.exe" ("" when unknown).
; @tags macro, explain, v20
V20_AppName(exe) => RegExReplace(Trim(exe), "i)\.exe$")

; @summary Program name out of a window selector such as "ahk_class Notepad ahk_exe notepad.exe" (else the selector).
; @tags macro, explain, v20
V20_TargetName(target) {
    if RegExMatch(target, "i)ahk_exe\s+(\S+)", &m)
        return V20_AppName(m[1])
    return RegExMatch(target, "i)ahk_class\s+(\S+)", &m) ? m[1] : target
}

; @summary Rough place of a spot inside a window, in words: "top-left", "middle", "bottom-right" ... (3 x 3 grid).
; @tags macro, explain, v20
V20_Zone(cx, cy, cw, ch) {
    col := cx < cw / 3 ? "left" : cx >= cw * 2 / 3 ? "right" : ""
    row := cy < ch / 3 ? "top" : cy >= ch * 2 / 3 ? "bottom" : ""
    if row = "" && col = ""
        return "middle"
    return row = "" ? "middle-" . col : col = "" ? row . " middle" : row . "-" . col
}

; @summary Shortens text for a step line and makes line breaks visible.
; @tags macro, explain, v20
V20_Short(text, maxLen := 60) {
    text := StrReplace(StrReplace(StrReplace(String(text), "`r`n", "⏎"), "`n", "⏎"), "`t", "⇥")
    return StrLen(text) > maxLen ? SubStr(text, 1, maxLen - 1) . "…" : text
}

; @summary A caption that is safe and short enough to show: one line, "&" shortcut marks and menu shortcuts
;          ("`tCtrl+S") removed, at most 40 characters. "" when there is nothing usable.
; @tags macro, explain, record, v20
V20_CleanCaption(text) {
    text := String(text)
    if (tab := InStr(text, "`t"))
        text := SubStr(text, 1, tab - 1)
    text := Trim(RegExReplace(StrReplace(StrReplace(text, "&&", Chr(1)), "&"), "[\r\n]+.*$"))
    text := StrReplace(text, Chr(1), "&")
    return StrLen(text) > 40 ? SubStr(text, 1, 39) . "…" : text
}

; @summary Kind of control from its window class and style, in plain words. caption = true when the control's own
;          text is a caption that may be shown (buttons, tick boxes, tabs) - never for boxes, lists or labels.
; @returns {Kind, Caption}
; @tags macro, explain, record, v20
V20_KindOf(cls, style := 0) {
    if cls = "#32768"
        return {Kind: "menu item", Caption: false}
    if RegExMatch(cls, "i)^(Button|TButton|TBitBtn|TSpeedButton|TCheckBox|TRadioButton|ThunderRT6(CommandButton|CheckBox|OptionButton)|WindowsForms10\.BUTTON)") {
        kind := "button"
        if cls = "Button" {
            bs := style & 0xF
            kind := (bs = 2 || bs = 3 || bs = 5 || bs = 6) ? "tick box" : (bs = 4 || bs = 9) ? "option" : bs = 7 ? "group box" : "button"
        } else if RegExMatch(cls, "i)Check")
            kind := "tick box"
        else if RegExMatch(cls, "i)Radio|Option")
            kind := "option"
        return {Kind: kind, Caption: kind != "group box"}
    }
    static kinds := [["i)^(Edit|RichEdit|RICHEDIT|TEdit|TMemo|TRichEdit|TMaskEdit|ThunderRT6TextBox|WindowsForms10\.EDIT)", "text box"],
        ["i)ComboBox|TComboBox|ComboLBox", "drop-down list"],
        ["i)^(ListBox|TListBox|TCheckListBox|SysListView32|TListView|ThunderRT6ListBox|WindowsForms10\.LISTBOX)", "list"],
        ["i)Grid|TStringGrid|TDBGrid", "grid"],
        ["i)^(SysTreeView32|TTreeView)", "tree"],
        ["i)^(SysTabControl32|TPageControl|TTabControl)", "tab strip"],
        ["i)^(ToolbarWindow32|TToolBar|ReBarWindow32)", "toolbar"],
        ["i)^SysHeader32", "column header"],
        ["i)^msctls_statusbar32|TStatusBar", "status bar"],
        ["i)^ScrollBar", "scroll bar"],
        ["i)^(msctls_trackbar32|TTrackBar)", "slider"],
        ["i)^(SysDateTimePick32|SysMonthCal32|TDateTimePicker)", "date picker"],
        ["i)^(Shell_TrayWnd|Shell_SecondaryTrayWnd|MSTaskListWClass|MSTaskSwWClass)", "taskbar"]]
    for pair in kinds
        if RegExMatch(cls, pair[1])
            return {Kind: pair[2], Caption: false}
    return {Kind: "", Caption: false}
}

; @summary Part of a window frame from a WM_NCHITTEST result ("" for the inside of the window).
; @tags macro, explain, record, v20
V20_FramePart(hit) {
    static parts := Map(2, "title bar", 3, "window menu (top-left icon)", 5, "menu bar", 6, "scroll bar", 7, "scroll bar",
        8, "Minimize button", 9, "Maximize button", 20, "Close button (X)", 21, "Help button")
    if parts.Has(hit)
        return parts[hit]
    return hit >= 10 && hit <= 17 ? "window edge" : ""
}

; @summary Text of the menu item under a screen point in a menu (popup menu window or a window's menu bar).
; @returns the item's text, or ""
; @tags macro, explain, record, v20
V20_MenuText(owner, hMenu, x, y) {
    if !hMenu
        return ""
    pos := DllCall("MenuItemFromPoint", "Ptr", owner, "Ptr", hMenu, "Int64", (y << 32) | (x & 0xFFFFFFFF), "Int")
    if pos < 0
        return ""
    buf := Buffer(260 * 2, 0)
    if !DllCall("GetMenuStringW", "Ptr", hMenu, "UInt", pos, "Ptr", buf, "Int", 259, "UInt", 0x400, "Int")    ; MF_BYPOSITION
        return ""
    return V20_CleanCaption(StrGet(buf, "UTF-16"))
}

; @summary What is under a screen point, for the step line: the kind of control and - only for buttons, tick boxes,
;          tabs' own captions and menu items - its caption. Called when a click is recorded, before the program
;          reacts. Every read has a short timeout and any failure just means "unknown".
; @returns Map("kind", ..., "text", ...) or "" when nothing useful is known
; @tags macro, explain, record, v20
V20_CaptureWhat(x, y) {
    try {
        x := Round(x), y := Round(y)
        pt := (y << 32) | (x & 0xFFFFFFFF)
        h := DllCall("WindowFromPoint", "Int64", pt, "Ptr")
        if !h || V18_OwnWindow(h)
            return ""
        root := DllCall("GetAncestor", "Ptr", h, "UInt", 2, "Ptr")      ; GA_ROOT
        cls := WinGetClass("ahk_id " . h)
        if cls = "#32768" {
            text := ""
            try text := V20_MenuText(0, SendMessage(0x1E1, 0, 0, h, , , , , 200), x, y)      ; MN_GETHMENU
            return V20_What("menu item", text)
        }
        hit := 0
        try hit := SendMessage(0x84, 0, (y << 16) | (x & 0xFFFF), root, , , , , 200)          ; WM_NCHITTEST
        part := V20_FramePart(hit)
        if part = "menu bar" {
            text := ""
            try text := V20_MenuText(root, DllCall("GetMenu", "Ptr", root, "Ptr"), x, y)
            return V20_What(text != "" ? "menu" : "menu bar", text)
        }
        if part != "" && h = root
            return V20_What(part, "")
        style := 0
        try style := WinGetStyle("ahk_id " . h)
        info := V20_KindOf(cls, style)
        text := ""
        if info.Caption
            try text := V20_CleanCaption(ControlGetText(h))
        return info.Kind = "" && text = "" ? "" : V20_What(info.Kind, text)
    }
    return ""
}

; @summary Builds the "what" Map of a click step.
; @tags macro, explain, record, v20
V20_What(kind, text) {
    out := Map("kind", kind)
    if text != ""
        out["text"] := text
    return out
}

; @summary "the "OK" button" / "a text box" / "menu item "Save As..."" from a step's "what" ("" when it has none).
; @tags macro, explain, v20
V20_WhatText(node) {
    what := node.Get("what", "")
    if !(what is Map)
        return ""
    kind := what.Get("kind", ""), text := what.Get("text", "")
    if text != ""
        return (kind = "menu item" || kind = "menu") ? kind . ' "' . text . '"' : 'the "' . text . '"' . (kind != "" ? " " . kind : "")
    if kind = ""
        return ""
    if RegExMatch(kind, "i)^(title bar|menu bar|taskbar|status bar|toolbar|tab strip|window edge|scroll bar|Close|Minimize|Maximize|Help|window menu)")
        return "the " . kind
    return (RegExMatch(kind, "i)^[aeiou]") ? "an " : "a ") . kind
}

; @summary Keys in plain words for a step line: "Ctrl+A (select all)", "Tab ×3 (next field)". Falls back to the raw keys.
; @tags macro, explain, v20
V20_KeysText(keys) {
    meaning := V13_KeysMeaning(keys)
    if meaning = ""
        return keys
    return RegExReplace(meaning, ": ([^,]+?)(?=, then |$)", " ($1)")
}

; @summary "in notepad" for a step with a recorded window ("" when unknown). show: true = " in notepad",
;          2 = " → in notepad" (V21: the program changed here), false = "" (V21: same program as the step before).
; @tags macro, explain, v20
V20_InApp(node, show := true) {
    win := node.Get("win", "")
    if !show || !(win is Map) || win.Get("exe", "") = ""
        return ""
    return (show = 2 ? " → in " : " in ") . V20_AppName(win["exe"])
}

; @summary Whereabouts of a click for a step line: " — top-left (40, 20)" from the window-locked spot, or the
;          screen spot for old steps.
; @tags macro, explain, v20
V20_WhereText(node) {
    if node.Get("find", "") != "spot"
        return " — wherever the saved picture is found"
    geo := node.Get("geo", "")
    if geo is Map
        return " — " . V20_Zone(geo["cx"], geo["cy"], geo["cw"], geo["ch"]) . " (" . geo["cx"] . ", " . geo["cy"] . ")"
    return " — screen spot (" . node.Get("scrX", node.Get("x", 0)) . ", " . node.Get("scrY", node.Get("y", 0)) . ")"
}

; @summary The main sentence of a step line - what the step does, in plain words. V21: web blocks, basic-input blocks
;          and the measuring blocks get theirs from V21_MoreSentence; "" for kinds that keep the older form.
; @tags macro, explain, v20
V20_StepSentence(node) {
    t := node.Get("type", "")
    switch t {
        case "click", "drag":
            mods := node.Get("mods", "")
            held := (InStr(mods, "^") ? "Ctrl+" : "") . (InStr(mods, "+") ? "Shift+" : "")
            btn := node.Get("button", "Left"), count := Integer(node.Get("count", 1))
            what := V20_WhatText(node)
            if t = "drag" {
                dx := node.Get("dx", 0), dy := node.Get("dy", 0)
                move := (dx ? Abs(dx) . (dx > 0 ? " right" : " left") : "") . (dx && dy ? ", " : "") . (dy ? Abs(dy) . (dy > 0 ? " down" : " up") : "")
                return held . (btn = "Left" ? "Drag" : btn . "-drag") . (what != "" ? " " . what : "") . V20_InApp(node, V21_ShowApp(node))
                    . V20_WhereText(node) . (move != "" ? ", " . move : "")
            }
            verb := (btn = "Left" ? "" : btn . "-") . (count = 2 ? "double-click" : count >= 3 ? "triple-click" : "click")
            verb := held . (held = "" ? StrUpper(SubStr(verb, 1, 1)) . SubStr(verb, 2) : verb)
            return verb . (what != "" ? " " . what : "") . V20_InApp(node, V21_ShowApp(node)) . V20_WhereText(node)
        case "wheel":
            n := Integer(node.Get("count", 1))
            return "Scroll " . StrLower(RegExReplace(node.Get("direction", "WheelDown"), "i)^Wheel")) . " " . n
                . (n = 1 ? " notch" : " notches") . V20_InApp(node, V21_ShowApp(node))
        case "text":
            if node.Get("ask", 0)
                return "Type what you answer when asked (each run)"
            text := node.Get("text", "")
            return 'Type "' . V20_Short(text) . '"' . (InStr(text, "{{") ? "  (the {{...}} part is filled in each round)" : "") . V20_InApp(node, V21_ShowApp(node))
        case "keys":
            return "Press " . V20_KeysText(node.Get("keys", "")) . V20_InApp(node, V21_ShowApp(node))
        case "delay":
            return "Wait " . V20_Time(node.Get("ms", 0))
        case "wait":
            return "Wait " . (node.Has("timeoutMs") ? "up to " . V20_Time(node["timeoutMs"]) . " " : "") . "for the saved picture to "
                . (V4_Bool(node.Get("appear", 1)) ? "appear" : "go away")
        case "check":
            return "Check that the saved picture is " . (V4_Bool(node.Get("appear", 1)) ? "on screen" : "gone")
        case "det_normalize_win":
            who := Trim(node.Get("target", "")) = "" ? "the window" : "the " . V20_TargetName(node["target"]) . " window"
            if V4_Bool(node.Get("maximize", 0))
                return "Maximize " . who
            return "Put " . who . " back to " . node.Get("width", 693) . " × " . node.Get("height", 803) . " at ("
                . node.Get("marginX", 20) . ", " . node.Get("marginY", 20) . ")"
        case "det_use_window":
            target := Trim(node.Get("target", ""))
            return target = "" ? "Go back to the macro's main window" : "Switch to the " . V20_TargetName(target) . " window  (waits up to "
                . node.Get("waitSec", 10) . " s for it)"
        case "det_citrix_fill":
            return "Click the box at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . "), clear it, type " . '"' . V20_Short(node.Get("value", ""), 40) . '"'
                . (V4_Bool(node.Get("pressTab", 1)) ? ", press Tab" : "")
    }
    return V21_MoreSentence(node)
}

; @summary Small tags after the sentence, only for what is out of the ordinary: a fixed or long pause before the
;          step, a list scrolled back first, a step that changes each round, "whatever window is active", a note.
; @tags macro, explain, v20
V20_StepTags(node) {
    out := ""
    if node.Has("delayMs")
        out .= "   ⏱ waits " . V20_Time(node["delayMs"]) . " first"
    else if IsNumber(node.Get("gapMs", 0)) && node.Get("gapMs", 0) >= 1500
        out .= "   ⏱ after a " . V20_Time(node["gapMs"]) . " pause"
    if node.Get("scroll", "") is Map
        out .= "   ↕ list scrolled back first"
    if (vary := V8_VarySummaryBadge(node)) != ""
        out .= "   " . vary
    if node.Get("win", "") is Map && node.Get("winMatch", "") = "active"
        out .= "   ◇ whatever window is active"
    if node.Get("note", "") != ""
        out .= "   // " . node["note"]
    return out
}

; @summary The whole text of a step in the macro list (after its number): sentence + tags, or "" to use the older form.
; @tags macro, explain, gui, v20
V20_StepLine(node) {
    sentence := V20_StepSentence(node)
    return sentence = "" ? "" : sentence . V20_StepTags(node)
}

; ============================================================================
; V21 STEP LIST
; The macro list reads at a glance: the program is named only where it changes, every kind of step and block gets a
; plain sentence, and the steps that had a note in the last run are marked. Nothing here is saved to the macro file.
; ============================================================================

; @summary Which steps should name their program in the macro list. flatSteps = VMF_Flatten(blocks), in order.
; @returns Map step -> 1 (the first step with a program: show " in notepad"), 2 (the program differs from the step
;          before that had one: show " → in notepad") or 0 (same program: do not show it). Steps without a recorded
;          window (no "win" / no "exe") get no entry and do not break a run.
; @tags macro, explain, gui, v21
V21_AppRuns(flatSteps) {
    out := Map(), lastExe := ""
    for step in flatSteps {
        if !(step is Map)
            continue
        win := step.Get("win", "")
        if !(win is Map) || win.Get("exe", "") = ""
            continue
        exe := win["exe"]
        out[step] := lastExe = "" ? 1 : exe != lastExe ? 2 : 0       ; != ignores upper / lower case
        lastExe := exe
    }
    return out
}

; @summary How V20_InApp should name this step's program: the editor's AppShow entry (0, 1 or 2), or true when there
;          is no editor map or no entry (so a loose step, for example in the self-test, always names its program).
; @tags macro, explain, gui, v21
V21_ShowApp(node) {
    if VMB().Gui && VMB().Columns       ; V22: column mode in the editor (with no editor: as in V21)
        return false
    appShow := VMB().AppShow
    return appShow is Map ? appShow.Get(node, true) : true
}

; @summary A short, readable name for a web element from its CSS selector, for a step line: "#submit" -> "submit" in
;          quotes; [name="email"], [aria-label="Search"], [data-testid="save-btn"] -> the value; otherwise the last
;          simple part, plus the nearest "#id" to its left ("form#login button.primary" -> "button.primary in #login").
;          At most 40 characters (V20_Short). "" for a blank selector.
; @tags macro, explain, web, v21
V21_SelectorName(selector) {
    sel := Trim(String(selector))
    if sel = ""
        return ""
    parts := [], part := "", depth := 0, quote := ""
    Loop Parse, sel {
        ch := A_LoopField
        if quote != "" {                        ; inside a quoted attribute value: spaces and > do not split
            part .= ch
            if ch = quote
                quote := ""
            continue
        }
        if ch = '"' || ch = "'" {
            quote := ch, part .= ch
            continue
        }
        if ch = "[" || ch = "("
            depth += 1
        else if ch = "]" || ch = ")"
            depth := Max(0, depth - 1)
        if depth = 0 && (ch = " " || ch = "`t" || ch = ">" || ch = "+" || ch = "~") {
            if part != ""
                parts.Push(part)
            part := ""
            continue
        }
        part .= ch
    }
    if part != ""
        parts.Push(part)
    if !parts.Length
        return V20_Short(sel, 40)
    lastPart := parts[parts.Length]
    if RegExMatch(lastPart, "^#([\w-]+)$", &m)
        return V20_Short('"' . m[1] . '"', 40)
    if RegExMatch(lastPart, "i)^[\w-]*\[(?:name|aria-label|data-testid)\s*=\s*([`"']?)(.*?)\1\s*\]$", &m)
        name := m[2]
    else
        name := lastPart
    loop parts.Length - 1 {
        if RegExMatch(parts[parts.Length - A_Index], "#([\w-]+)", &m) {
            name .= " in #" . m[1]
            break
        }
    }
    return V20_Short(name, 40)
}

; @summary A web address for a step line: host + path only, no "https://", no query string or #part
;          ("https://example.com/orders?id=5" -> "example.com/orders").
; @tags macro, explain, web, v21
V21_UrlText(url) {
    url := RegExReplace(Trim(String(url)), "[?#].*$")
    url := RegExReplace(url, "i)^[a-z][a-z0-9+.\-]*://")
    return RegExReplace(url, "(?<=.)/$")
}

; @summary The sentence of a step that V20_StepSentence does not handle: web blocks, basic-input blocks and the
;          measuring blocks. Reads the fields named in V4_WebDefs / V4_InputDefs / V10_DetDefs. "" for any other kind
;          (the older "Name   details" form is shown then).
; @tags macro, explain, web, v21
V21_MoreSentence(node) {
    static colours := Map("DiscernYellow", "yellow (the active box)", "CernerDoorBlue", "the door-icon blue",
        "HighlightBlue", "the selection blue", "DisabledGrey", "greyed out", "WhiteReady", "white (ready)")
    static places := Map("TopLeft", "top left", "BottomCenter", "bottom centre", "TopRight", "top right",
        "BottomRight", "bottom right", "BottomLeft", "bottom left", "Center", "centre")
    t := node.Get("type", "")
    el := V21_SelectorName(node.Get("selector", ""))
    el := el = "" ? "the element" : el
    frame := Trim(node.Get("frame", ""))
    inFrame := frame = "" ? "" : "  (inside frame " . V21_SelectorName(frame) . ")"
    keep := Trim(node.Get("variable", ""))
    keepText := keep = "" ? "" : ", remember it as " . keep
    btn := node.Get("button", "Left"), count := node.Get("count", 1)
    clickVerb := (btn = "Left" ? "" : StrLower(btn) . "-") . (count = 2 ? "double-click" : "click")
    switch t {
        case "web_launch":
            browser := RegExReplace(RegExReplace(node.Get("browser", "Edge"), ".*[\\/]"), "i)\.exe$")
            return "Web: open the " . browser . " browser for the macro (port " . node.Get("port", 9222) . ")"
        case "web_connect", "web_tab":
            match := node.Get("match", "")
            if match = ""
                return t = "web_connect" ? "Web: connect to the only open tab" : "Web: switch to the other tab"
            return (t = "web_connect" ? "Web: connect to the tab" : "Web: switch to the tab") . " whose " . node.Get("by", "url")
                . (node.Get("mode", "contains") = "exact" ? " is " : " contains ") . '"' . V20_Short(match, 40) . '"'
        case "web_navigate":
            return "Web: go to " . V21_UrlText(node.Get("url", ""))
        case "web_newtab":
            url := V21_UrlText(node.Get("url", "about:blank"))
            return url = "" || url = "about:blank" ? "Web: open a new empty tab" : "Web: open a new tab at " . url
        case "web_back": return "Web: go back a page"
        case "web_forward": return "Web: go forward a page"
        case "web_reload": return "Web: reload the page"
        case "web_close": return "Web: close the tab"
        case "web_disconnect": return "Web: let go of the browser (it stays open)"
        case "web_wait":
            cond := node.Get("condition", "visible")
            how := cond = "present" ? "be on the page" : cond = "hidden" ? "be hidden" : cond = "absent" ? "go away"
                : cond = "text" ? 'show "' . V20_Short(node.Get("value", ""), 30) . '"' : "appear"
            return "Web: wait for " . el . " to " . how . " (up to " . V20_Time(node.Get("timeoutMs", 10000)) . ")" . inFrame
        case "web_click":
            return "Web: " . clickVerb . " " . el . inFrame
        case "web_fill":
            if V4_Bool(node.Get("ask", 0))              ; asked each run: never show the text
                return "Web: type what you answer when asked into " . el . inFrame
            return 'Web: type "' . V20_Short(node.Get("value", ""), 40) . '" into ' . el . inFrame
        case "web_select":
            return 'Web: pick "' . V20_Short(node.Get("value", ""), 40) . '" in ' . el . inFrame
        case "web_check":
            return "Web: " . (V4_Bool(node.Get("checked", 1)) ? "tick " : "untick ") . el . inFrame
        case "web_read":
            attr := node.Get("attribute", "textContent")
            return "Web: read " . (RegExMatch(attr, "i)^(textContent|innerText)$") ? "the text" : "the " . attr) . " of " . el
                . keepText . inFrame
        case "web_count":
            return "Web: count how many " . el . " there are" . keepText . inFrame
        case "web_exists":
            return "Web: check whether " . el . " is there" . keepText . inFrame
        case "web_focus":
            return "Web: put the cursor in " . el . inFrame
        case "web_scroll":
            return "Web: scroll " . el . " into view" . inFrame
        case "web_keys":
            return "Web: press " . node.Get("key", "Enter") . (Trim(node.Get("selector", "")) = "" ? "" : " in " . el) . inFrame
        case "web_screenshot":
            return "Web: save a picture of the page as " . RegExReplace(node.Get("path", ""), ".*[\\/]")
        case "web_eval":
            return 'Web: run the script "' . V20_Short(node.Get("expression", ""), 40) . '"' . keepText
        case "web_cdp":
            return "Web: send the browser command " . node.Get("method", "") . keepText
        case "input_send", "input_sendinput", "input_sendevent":
            if V4_Bool(node.Get("ask", 0))
                return "Send keys: what you answer when asked (each run)"
            return "Send keys: " . V20_KeysText(node.Get("value", ""))
        case "input_sendtext":
            if V4_Bool(node.Get("ask", 0))
                return "Type what you answer when asked (each run)"
            return 'Type "' . V20_Short(node.Get("value", "")) . '"'
        case "input_keydown":
            return "Hold " . node.Get("key", "Ctrl") . " down"
        case "input_keyup":
            return "Let go of " . node.Get("key", "Ctrl")
        case "det_wait_settled":
            return "Wait until the area (" . node.Get("x1", 0) . ", " . node.Get("y1", 0) . ")–(" . node.Get("x2", 0) . ", "
                . node.Get("y2", 0) . ") stops changing"
        case "det_wait_pixel":
            mode := node.Get("colorMode", "DiscernYellow")
            colour := mode = "NearHex" ? "close to #" . node.Get("colorHex", "") : colours.Get(mode, mode)
            return "Wait until the dot at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ") is "
                . (V4_Bool(node.Get("appear", 1)) ? "" : "no longer ") . colour
        case "det_anchor_click":
            clickVerb := StrUpper(SubStr(clickVerb, 1, 1)) . SubStr(clickVerb, 2)
            anchor := node.Get("anchor", "BottomCenter")
            if anchor = "ProportionalPct"
                return clickVerb . " at " . node.Get("pctX", 50) . "% across and " . node.Get("pctY", 50) . "% down the window"
            place := places.Get(anchor, anchor)
            dx := node.Get("dx", 0), dy := node.Get("dy", 0)
            dx := IsNumber(dx) ? Number(dx) : 0, dy := IsNumber(dy) ? Number(dy) : 0
            move := (dx ? Abs(dx) . " px " . (dx > 0 ? "right" : "left") : "") . (dx && dy ? " and " : "")
                . (dy ? Abs(dy) . " px " . (dy > 0 ? "down" : "up") : "")
            return clickVerb . " " . (move = "" ? "at the " : move . " from the ") . place . " of the window"
        case "det_human_click":
            clickVerb := StrUpper(SubStr(clickVerb, 1, 1)) . SubStr(clickVerb, 2)
            return clickVerb . " at (" . node.Get("x", 0) . ", " . node.Get("y", 0) . ")" . (node.Get("coordRel", "Window") = "Screen" ? " on the screen" : "")
                . (node.Get("profile", "MinimumJerk") = "Instant" ? "" : " with a human-like move")
        case "det_predict_row":
            item := V20_Short(node.Get("wantItem", ""), 40)
            if node.Get("selectMethod", "CheckboxClick") = "StoreRowOnly"
                return 'Work out which row "' . item . '" is in the list (no click)'
            return 'Pick "' . item . '" in the list (row is worked out)'
    }
    return ""
}

; @summary A condition in plain words for the macro list. For a variable: "amount is 250", "amount is not 250",
;          "name contains x", "name is empty", "name is not empty" ...; other conditions use VMF__CondText.
; @tags macro, explain, gui, v21
V21_CondText(node) {
    static ops := Map("=", "is", "!=", "is not", "<", "is less than", ">", "is more than", "<=", "is at most",
        ">=", "is at least", "contains", "contains")
    if node.Get("cond", "image") != "var"
        return VMF__CondText(node)
    name := node.Get("name", "?"), op := node.Get("op", "=")
    if op = "empty" || op = "notempty"
        return name . (op = "empty" ? " is empty" : " is not empty")
    return name . " " . ops.Get(op, op) . " " . node.Get("value", "")
}

; @summary The text of a container / control row in the macro list, in the same plain style as the step lines
;          ("Repeat 5 times  (4 steps inside)", "If amount is 250", "Leave the loop" ...), with the "  // note" suffix.
;          Kinds it does not know use VMF_BlockText. VMF_BlockText itself is unchanged (code view, saved text).
; @tags macro, explain, gui, v21
V21_BlockLine(node) {
    static stops := Map("break", "Leave the loop", "continue", "Go on with the next round of the loop",
        "nextrow", "Skip this data row (it counts as failed)", "endrun", "End the run here (it counts as done)",
        "stop", "Stop the run")
    t := node.Get("type", "")
    inside := ""
    if VMF_IsContainer(node) {
        n := VMF_CountSteps(VMF_Children(node)[1])
        inside := n = 0 ? "  (no steps inside yet)" : "  (" . n . (n = 1 ? " step" : " steps") . " inside)"
    }
    switch t {
        case "repeat":
            count := node.Get("count", 1)
            line := "Repeat " . count . (count = 1 ? " time" : " times") . inside
        case "foreach":
            line := "For each row of the list" . inside
        case "for":
            stepBy := node.Get("step", 1)
            line := "Count " . node.Get("name", "i") . " from " . node.Get("from", 1) . " to " . node.Get("to", 10)
                . (stepBy = 1 ? "" : " in steps of " . stepBy) . inside
        case "until":
            line := "Repeat until " . V21_CondText(node) . (node.Get("check", "") = "after" ? ", checked after each round" : "")
                . "  (at most " . node.Get("max", 100) . " times)"
        case "if":
            line := "If " . V21_CondText(node)
        case "set":
            name := node.Get("name", "?"), value := node.Get("value", "")
            line := node.Get("ask", 0) ? "Ask me for " . name . (value = "" ? "" : ' (suggests "' . V20_Short(value, 40) . '")')
                : 'Remember "' . V20_Short(value, 40) . '" as ' . name
        case "change":
            name := node.Get("name", "?"), by := node.Get("by", 1)
            line := IsNumber(by) && by < 0 ? "Take " . Abs(by) . " from " . name : "Add " . by . " to " . name
        case "ask":
            line := "Ask me: " . node.Get("prompt", "")
        case "stop":
            action := node.Get("action", "break")
            line := stops.Get(action, action)
        case "call":
            line := "Run the macro " . RegExReplace(node.Get("path", ""), ".*[\\/]")
        default:
            return VMF_BlockText(node)
    }
    return line . (node.Get("note", "") = "" ? "" : "  // " . node["note"])
}

; @summary Which steps had a note in a run: result.Warnings (note texts, each "Step #<n> ...") -> Map step number ->
;          the first note text for that step. Texts that do not start with "Step #<n>" are left out.
; @tags macro, playback, gui, v21
V21_NoteSteps(warnings) {
    out := Map()
    if !(warnings is Array)
        return out
    for text in warnings {
        if RegExMatch(String(text), "^Step #(\d+)", &m) && !out.Has(Integer(m[1]))
            out[Integer(m[1])] := String(text)
    }
    return out
}

; @summary The tag a step row gets when the step had a note in the last run: "   ⚠ last run: <note>", the note
;          without its "Step #n: " start and at most 70 characters.
; @tags macro, playback, gui, v21
V21_NoteTag(text) => "   ⚠ last run: " . V20_Short(RegExReplace(String(text), "^Step #\d+:?\s*"), 70)

; @summary True when the point (x, y) lies on one of the screens. rects = array of [left, top, right, bottom]
;          (as MonitorGet gives them; right and bottom are just outside the screen).
; @tags macro, window, monitor, normalize, v21
V21_OnAnyScreen(x, y, rects) {
    for rect in rects
        if x >= rect[1] && x < rect[3] && y >= rect[2] && y < rect[4]
            return true
    return false
}

; ============================================================================
; V22 COLUMNS
; The step list in fixed columns: number, program (on every row), waits, marks, then the sentence. The tree uses a
; monospace font and each column is padded with spaces; deeper rows give back the tree's own indent so the columns
; line up at every depth. Display only - nothing here is saved to the macro file or changes playback.
; ============================================================================

; @summary Exactly width characters: text padded with spaces, or cut to width - 1 characters plus "…".
;          Every character counts as one column (StrLen).
; @tags macro, gui, columns, v22
V22_Pad(text, width) {
    text := String(text)
    if width < 1
        return ""
    if StrLen(text) > width
        return SubStr(text, 1, width - 1) . "…"
    return Format("{:-" . width . "}", text)
}

; @summary The column layout of the step list: number, program, waits, marks (widths in characters). The gap
;          between columns is always 1 space; the sentence follows after the last column.
; @tags macro, gui, columns, v22
V22_Cols() {
    static cols := [{Key: "num", W: 5}, {Key: "app", W: 14}, {Key: "wait", W: 9}, {Key: "marks", W: 7}]
    return cols
}

; @summary The spaces in front of a row: 8 * indentChars for a top-level row, depth * indentChars fewer for a
;          deeper row (the tree's own indent makes up the difference), never fewer than none.
; @tags macro, gui, columns, v22
V22_Margin(depth, indentChars) {
    n := Max(0, (8 - Max(0, depth)) * indentChars)
    return n ? Format("{:" . n . "}", "") : ""
}

; @summary The program of one step for the Program column ("" when the step itself has none): the recorded
;          window's program; for det_* / input_* steps with a "target" field the program of that target, or of the
;          Macro window (settings "defaultTarget") when it is blank; "web page" for web steps.
; @tags macro, gui, columns, v22
V22_AppOf(node, settings := 0) {
    win := node.Get("win", "")
    if win is Map && win.Get("exe", "") != ""
        return StrLower(V20_AppName(win["exe"]))        ; V22.1: lower case for the column only
    t := node.Get("type", "")
    if SubStr(t, 1, 4) = "web_"
        return "web page"
    if (SubStr(t, 1, 4) = "det_" || SubStr(t, 1, 6) = "input_") && node.Has("target") {
        target := Trim(node["target"])
        if target = "" && settings is Map
            target := Trim(settings.Get("defaultTarget", ""))
        return target = "" ? "" : StrLower(V20_TargetName(target))     ; V22.1: lower case for the column only
    }
    return ""
}

; @summary The Program column for every step: a step with no program of its own (a Delay ...) takes the program of
;          the nearest earlier step that had one. flatSteps = VMF_Flatten(blocks); blocks that are not steps are skipped.
; @returns {App: Map step -> program text, Starts: Map step -> true for the first step and each step whose program
;          differs (upper / lower case ignored) from the step before}
; @tags macro, gui, columns, v22
V22_FillApps(flatSteps, settings := 0) {
    apps := Map(), starts := Map(), prevApp := "", isFirst := true
    for step in flatSteps {
        if !(step is Map) || !VMF_IsStep(step)
            continue
        own := V22_AppOf(step, settings)
        filled := own != "" ? own : prevApp
        apps[step] := filled
        if isFirst || filled != prevApp
            starts[step] := true
        isFirst := false, prevApp := filled
    }
    return {App: apps, Starts: starts}
}

; @summary The Waits column: a wait set by hand ("delayMs") as "500 ms*", else a recorded pause of 300 ms or more
;          ("2.4 s"), else "".
; @tags macro, gui, columns, v22
V22_WaitText(node) {
    if node.Has("delayMs")
        return V20_Time(node["delayMs"]) . "*"
    gap := node.Get("gapMs", 0)
    return IsNumber(gap) && gap >= 300 ? V20_Time(gap) : ""
}

; @summary The Marks column, one character each, in this order and only when it applies: list scrolled back first,
;          changes each round, whatever window is active, has a note, had a note in the last run.
; @tags macro, gui, columns, v22
V22_Marks(node, lastNote := "") {
    chars := V22_MarkChars(), out := ""
    if node.Get("scroll", "") is Map
        out .= chars["scroll"]
    if V8_VarySummaryBadge(node) != ""
        out .= chars["vary"]
    if node.Get("winMatch", "") = "active"
        out .= chars["active"]
    if node.Get("note", "") != ""
        out .= chars["note"]
    if lastNote != ""
        out .= chars["warn"]
    return out
}

; @summary The sentence at the end of a step row: V20_StepSentence (or the older "name   details" when it has
;          none), then "   // <note>", then the last-run note tag.
; @tags macro, gui, columns, v22
V22_Sentence(node, lastNote := "") {
    text := V20_StepSentence(node)
    if text = "" {
        sum := VM_StepSummary(node)
        text := sum[1] . "   " . sum[3]
    }
    return text . (node.Get("note", "") != "" ? "   // " . node["note"] : "") . (lastNote != "" ? V21_NoteTag(lastNote) : "")
}

; @summary One whole step row in fixed columns: margin, number (with "►" in its last character when the task
;          moves to another program here, not on step 1), program, waits, marks, then the sentence.
; @tags macro, gui, columns, v22
V22_Row(num, app, startsApp, wait, marks, sentence, depth, indentChars) {
    cols := V22_Cols()
    numCol := V22_Pad(num, cols[1].W)
    if startsApp && num != 1
        numCol := SubStr(numCol, 1, cols[1].W - 1) . V22_MarkChars()["start"]
    return V22_Margin(depth, indentChars) . numCol . " " . V22_Pad(app, cols[2].W) . " " . V22_Pad(wait, cols[3].W)
        . " " . V22_Pad(marks, cols[4].W) . " " . sentence
}

; @summary The column names, built with the same margin and widths as a top-level row.
; @tags macro, gui, columns, v22
V22_Header(indentChars) {
    cols := V22_Cols()
    return V22_Margin(0, indentChars) . V22_Pad("#", cols[1].W) . " " . V22_Pad("Program", cols[2].W) . " "
        . V22_Pad("Waits", cols[3].W) . " " . V22_Pad("Marks", cols[4].W) . " What it does"
}

; @summary The mark characters of the Marks column and the "►" of the number column, in one place. plain = 1 gives
;          plain ASCII letters instead (for a PC where the symbols show as boxes or are too wide). With no argument the
;          ini value [V22] PlainMarks (default 0) decides; it is read once, so a change needs a restart.
; @tags macro, gui, columns, v22
V22_MarkChars(plain := "") {
    static fromIni := 0
    if plain = "" {
        if !fromIni {
            ini := VMB().Ini
            fromIni := V22_MarkChars(ini != "" && IniRead(ini, "V22", "PlainMarks", 0) = "1" ? 1 : 0)
        }
        return fromIni
    }
    return plain ? Map("scroll", "S", "vary", "V", "active", "A", "note", "N", "warn", "!", "start", ">")
        : Map("scroll", "↕", "vary", "⚡", "active", "◇", "note", "✎", "warn", "⚠", "start", "►")
}

; @summary How deep a tree item is: the number of tree levels above it (0 = top level). ELSE rows and "(empty)"
;          placeholders are tree items too, so this counts tree levels, not block levels.
; @tags macro, gui, columns, v22
V22_DepthOf(item) {
    s := VMB(), depth := 0
    while item && (item := s.TV.GetParent(item))
        depth += 1
    return depth
}

; @summary Sets the macro tree's font - Consolas in column mode, else Segoe UI - and, in column mode, makes the tree's
;          indent exactly s.IndentChars characters wide (raised when Windows will not take an indent that small).
;          Leaving column mode puts the tree's own indent back. refresh = rebuild the rows when IndentChars changed.
; @tags macro, gui, columns, v22
V22_ApplyTreeFont(refresh := true) {
    static defaultIndent := 0
    s := VMB()
    if !s.TV
        return
    if !defaultIndent
        defaultIndent := SendMessage(0x1106, 0, 0, s.TV)                  ; TVM_GETINDENT, before any change
    s.TV.SetFont("s" . s.FontSize, s.Columns ? "Consolas" : "MS Shell Dlg 2")     ; a font name that is missing keeps
    if !s.Columns                                                                  ; the old font, so Segoe UI comes second
        s.TV.SetFont(, "Segoe UI")
    if !s.Columns {
        SendMessage(0x1107, defaultIndent, 0, s.TV)                        ; TVM_SETINDENT
        return
    }
    hFont := SendMessage(0x31, 0, 0, s.TV)                                 ; WM_GETFONT
    hdc := DllCall("GetDC", "Ptr", s.TV.Hwnd, "Ptr")
    oldFont := DllCall("SelectObject", "Ptr", hdc, "Ptr", hFont, "Ptr")
    ext := Buffer(8, 0)
    DllCall("GetTextExtentPoint32W", "Ptr", hdc, "Str", "0000000000", "Int", 10, "Ptr", ext)
    DllCall("SelectObject", "Ptr", hdc, "Ptr", oldFont, "Ptr")
    DllCall("ReleaseDC", "Ptr", s.TV.Hwnd, "Ptr", hdc)
    charW := Max(1, NumGet(ext, 0, "Int") / 10)
    before := s.IndentChars
    want := Round(charW * s.IndentChars)
    SendMessage(0x1107, want, 0, s.TV)
    actual := SendMessage(0x1106, 0, 0, s.TV)
    if actual > want {                                                     ; Windows refused an indent this small
        s.IndentChars := Ceil(actual / charW)
        SendMessage(0x1107, Round(charW * s.IndentChars), 0, s.TV)
    }
    s.IndentSeen := "char " . charW . " px, asked " . want . " px, got " . actual . " px, " . s.IndentChars . " characters"
    if refresh && s.IndentChars != before
        VMB_Refresh()
}

; @summary Puts the column-name line right above the macro tree, its left edge where the first row's text starts
;          (TVM_GETITEMRECT, text part), in the tree's font and size. Hidden when the macro is empty or columns are off.
; @tags macro, gui, columns, v22
V22_PlaceHeader() {
    s := VMB()
    if !s.TV || !s.Gui || !s.Ctl.Has("ColHead") || !(s.Macro is Map)
        return
    head := s.Ctl["ColHead"]
    first := s.TV.GetNext()
    show := s.Columns && first && s.Macro["blocks"].Length
    if show {
        head.SetFont("s" . s.FontSize, "Consolas")
        head.Text := V22_Header(s.IndentChars)
        rc := Buffer(16, 0)
        NumPut("Ptr", first, rc)
        if SendMessage(0x1104, 1, rc.Ptr, s.TV) {                         ; TVM_GETITEMRECT, wParam 1 = text only
            pt := Buffer(8, 0)
            NumPut("Int", NumGet(rc, 0, "Int"), "Int", 0, pt)
            DllCall("MapWindowPoints", "Ptr", s.TV.Hwnd, "Ptr", s.Gui.Hwnd, "Ptr", pt, "UInt", 1)     ; tree -> window
            s.TV.GetPos(&tx, &ty, &tw)
            hx := Round(NumGet(pt, 0, "Int") * 96 / A_ScreenDPI)           ; the window's controls use 96-dpi units
            head.Move(hx, ty - 16, Max(50, tx + tw - hx), 16)
        }
    }
    head.Visible := show
}

; @summary "Columns" tick box / "Show columns" menu entry: step list in fixed columns on or off (remembered).
; @tags macro, gui, columns, v22
V22_ToggleColumns(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    s.Columns := s.Columns ? 0 : 1
    IniWrite(s.Columns, s.Ini, "V22", "Columns")
    if s.Insp && s.Insp.HasOwnProp("Columns")
        s.Insp.Columns.Value := s.Columns
    V22_ApplyTreeFont(false)
    VMB_Refresh()
}

; @summary The whole story of one step in one line for the status bar, only the parts that apply, joined with " · ":
;          "Step 6 · notepad · waits 3.2 s first · <sentence> · list is scrolled back first · ... · last run: <note>".
;          num = the step number ("" leaves it out), app = its Program column, lastNote = its note in the last run.
; @tags macro, gui, columns, v22
V22_Detail(node, app, lastNote, num := "") {
    parts := []
    if num != ""
        parts.Push("Step " . num)
    if app != ""
        parts.Push(app)
    if node.Has("delayMs")
        parts.Push("waits " . V20_Time(node["delayMs"]) . " first (set by hand)")
    else if IsNumber(node.Get("gapMs", 0)) && node.Get("gapMs", 0) >= 300
        parts.Push("waits " . V20_Time(node["gapMs"]) . " first")
    text := V20_StepSentence(node)
    if text = "" {
        sum := VM_StepSummary(node)
        text := Trim(sum[1] . "   " . sum[3])
    }
    parts.Push(text)
    if node.Get("scroll", "") is Map
        parts.Push("list is scrolled back first")
    if (vary := V8_VarySummaryBadge(node)) != ""
        parts.Push(RegExReplace(vary, "^⚡\[(.*)\]$", "$1"))
    if node.Get("winMatch", "") = "active"
        parts.Push("whatever window is active")
    if node.Get("note", "") != ""
        parts.Push("note: " . node["note"])
    if lastNote != ""
        parts.Push("last run: " . V20_Short(RegExReplace(String(lastNote), "^Step #\d+:?\s*"), 120))
    out := ""
    for part in parts
        out .= (A_Index > 1 ? " · " : "") . part
    return out
}

; @summary Tree ItemSelect (after what it already did): the status bar spells out the selected step with V22_Detail.
;          Not while recording or playing (the status bar is in use then), not for blocks, and not again for the
;          same step (the list re-selects it after every change, which would hide that change's own message).
; @tags macro, gui, columns, v22
V22_ShowDetail() {
    static lastNode := 0
    if VM_IsRecording() || VM_IsPlaying()
        return
    s := VMB()
    info := VMB_SelectedInfo()
    if !info || info.Kind != "node" || !VMF_IsStep(info.Node) {
        lastNode := 0
        return
    }
    node := info.Node
    if node == lastNode
        return
    lastNode := node
    num := s.FlatIndex.Get(node, "")
    app := s.ColApp is Map && s.ColApp.Has(node) ? s.ColApp[node] : V22_AppOf(node, s.Macro["settings"])
    VMB_Status(V22_Detail(node, app, s.LastNotes.Get(num, ""), num))
}

; ============================================================================
; V4 STARTUP / SINGLE-FILE PLAYER EXPORT
; ============================================================================
; <V4_EMBEDDED_MACRO>
V4_Embedded() {
    return ""
}
; </V4_EMBEDDED_MACRO>
V4_Start(*) {
    if A_Args.Length && A_Args[1] = "--qa"
        return
    if A_Args.Length && A_Args[1] = "--self-test" {
        V4_SelfTest(A_Args.Length > 1 ? A_Args[2] : A_ScriptDir . "\V10-self-test.txt")
        return
    }
    encoded := V4_Embedded()
    if encoded != "" {
        OnExit(VMB_OnExit)
        try {
            raw := V4_Unbase64(encoded)
            macro := JSON.Parse(StrGet(raw, raw.Size, "UTF-8"))
            if MsgBox("Run the exported macro '" . macro.Get("name", "Untitled") . "'?"
                . "`n`nOnly run macros you trust. Esc requests stop; Ctrl+Shift+X exits immediately.",
                "Visual Macro Blocks V10 player", "YesNo Icon?") != "Yes"
                ExitApp()
            options := {}
            data := macro["settings"].Get("data", "")
            if data is Map && data.Get("path", "") != "" && !VMF_DataPickBlock(macro["blocks"]) {
                options.Data := VM_LoadData(data["path"], data.Get("header", "auto"))
                options.FirstRow := Max(1, data.Get("firstRow", 1))
                options.LastRow := data.Get("lastRow", 0)
            }
            result := VM_Play(macro, options)
            MsgBox(result.Message . (result.Warnings.Length ? "`n`nNotes:`n" . V4_Join(result.Warnings, "`n") : ""),
                "V10 player", result.Ok ? "Iconi" : "Icon!")
            ExitApp(result.Ok ? 0 : 1)
        } catch as err {
            MsgBox(err.Message, "V10 player error", "Iconx")
            ExitApp(1)
        }
    }
    VMB_Main()
}
V4_PlayerSource(source, macro) {
    text := JSON.Stringify(macro)
    raw := V4_Utf8(text)
    raw.Size -= 1
    encoded := V4_Base64(raw)
    replacement := "; <V4_EMBEDDED_MACRO>`nV4_Embedded() {`n    text := `"`"`n"
    pos := 1
    while pos <= StrLen(encoded) {
        replacement .= "    text .= `"" . SubStr(encoded, pos, 960) . "`"`n"
        pos += 960
    }
    replacement .= "    return text`n}`n; </V4_EMBEDDED_MACRO>"
    ; Match only the marker at the beginning of a line, not the string above.
    source := RegExReplace(source, "ms)^; <V4_EMBEDDED_MACRO>.*?^; </V4_EMBEDDED_MACRO>", replacement, &count, 1)
    if count != 1
        throw Error("The source's V4 embedded-macro marker was not found.")
    return source
}
V4_ExportPlayer(*) {
    s := VMB()
    if VM_IsRecording() || VM_IsPlaying()
        return
    VMB_ControlsToSettings()
    if !s.Macro["blocks"].Length
        return VMB_Status("Add some blocks first.")
    errors := VM_Validate(s.Macro)
    if errors.Length {
        MsgBox(V4_Join(errors, "`n"), "Fix these blocks before exporting", "Icon!")
        return
    }
    if !VMB_PrivacyCheck()
        return
    if VMB__CountCalls(s.Macro["blocks"]) && MsgBox("Run another macro blocks still reference external macro files."
        . "`nThose files are not bundled. Continue?", "Export player", "YesNo Icon!") != "Yes"
        return
    safe := RegExReplace(s.Macro.Get("name", "") = "" ? "macro" : s.Macro["name"], '[\\/:*?"<>|\r\n]', "_")
    out := FileSelect("S16", s.Dir . "\export\" . safe . "-player-V10.ahk", "Export V10 player and identical TXT", "AutoHotkey (*.ahk)")
    if out = ""
        return
    base := RegExReplace(out, "i)\.(ahk|txt)$")
    if !RegExMatch(base, "i)V10$")
        base .= "-V10"
    try {
        text := V4_PlayerSource(FileRead(A_ScriptFullPath, "UTF-8"), s.Macro)
        if FileExist(base . ".txt") && MsgBox("Replace the existing matching TXT file?"
            . "`n" . base . ".txt", "Export", "YesNo Icon?") != "Yes"
            return
        V4_Write(base . ".ahk", text)
        V4_Write(base . ".txt", text)
        VMB_Status("Exported one-file player and identical TXT: " . base)
        MsgBox("Exported:`n" . base . ".ahk`n" . base . ".txt"
            . "`n`nBoth contain the same source. AutoHotkey v2 and the target applications must be installed.",
            "V10 export complete", "Iconi")
    } catch as err
        MsgBox(err.Message, "V10 export failed", "Iconx")
}
V4_Help(*) {
    MsgBox("NEW IN V22 (step list in columns):"
        . "`n• Every step row has fixed columns:  #   Program   Waits   Marks   What it does. The Program column is filled on"
        . "  every row (a Wait step shows the program of the step before it)."
        . "`n• Waits = the pause before the step. A * after the time (500 ms*) = a wait you set by hand."
        . "`n• Marks: ► the task moves to another program here, ↕ the list is scrolled back first, ⚡ changes each round,"
        . "  ◇ uses whatever window is active, ✎ has your note, ⚠ had a note in the last run."
        . "`n• Right-click the list -> Show columns (or the Columns tick box in the Step settings panel) for the V21 lines."
        . "`n`nNEW IN V21 (a step list you can read at a glance):"
        . "`n• The program is named only where the task moves to another one:  Type `"5`" → in calc."
        . "`n• Web, basic-input and measuring steps read as sentences too (Web: click `"submit`"), and so do REPEAT, FOR, IF,"
        . "  SET and the other blocks (Repeat 5 times  (4 steps inside), If amount is 250)."
        . "`n• After a run, the steps that had a note are marked ⚠ with the note at the end of the line, so you do not have to"
        . "  open the log. The marks go away when you change the macro."
        . "`n• Steady playback: if a window's saved spot is off every screen (another monitor layout), it is put on the main"
        . "  screen instead, with a note."
        . "`n`nNEW IN V20 (step lines you can read at a glance):"
        . "`n• Each step is one plain sentence: Click the `"OK`" button in notepad — bottom-right (410, 300). Tags show a long pause,"
        . "  a list that is scrolled back first, or your note. Untick 'Explain steps' in the Step settings panel for the old lines."
        . "`n• New recordings remember what was clicked: a button's caption, a menu item's text, or just 'a text box' / 'a list'."
        . "  Text inside boxes, lists and labels is never saved."
        . "`n`nNEW IN V19 (window size + scroll):"
        . "`n• Lists and pages are scrolled back to where they were when you recorded, before each click (standard Windows lists"
        . "  and boxes only - not web pages, Citrix or Remote Desktop). For those, start each run from the same screen and scroll"
        . "  with the keyboard (Ctrl+Home, PgDn) while recording, because key presses replay the same way every time."
        . "`n`nNEW IN V18 (one-click Record + Steady playback):"
        . "`n• Record on an empty macro needs no window pick: the first program you use becomes the Macro window (step #1 normalizes it)."
        . "`n• Click the red REC bar to stop. The recording notice appears the first time only. Clicks on the editor are never recorded."
        . "`n• Fixed: every Normalize Window step also cleared the focused field and pressed Tab (and Citrix fill did nothing)."
        . "`n• Fixed: Enter, Tab and Esc were recorded twice (key + typed character) and so played twice."
        . "`n• Double-clicks, wheel notches (with their spot) and Ctrl / Shift+clicks are recorded as what they were."
        . "`n• 'Steady playback' (on for new macros): steps wait for their window, a window that can't come to the front stops the step,"
        . "  and each click waits up to 1.5 s for the screen at the spot to look like the recording (small drift is corrected)."
        . "`n`nNEW IN V17 (Easy mode):"
        . "`n• '◂ Easy mode' (Ctrl+Shift+E) hides everything except Record, Play, Pick window, Save and 9 blocks."
        . "`n• '📐 Pick window': click the app's title bar once. It becomes the Macro window and step #1 normalizes its size and spot."
        . "`n• While recording, switching to another window adds 'Use Window From Here On' + 'Normalize Window Geometry' for it"
        . "  (untick 'Normalize new windows while recording' to stop that). Fixed-size dialogs are only moved."
        . "`n• A window that can't reach its saved size no longer stops the run: it is noted in the status bar and last-playback.log."
        . "`n`nNEW IN V16 (record the web side via CDP):"
        . "`n• Connect a tab in Web / CDP first, then press Record. Clicks, typing, dropdowns, checkboxes and"
        . "  Enter / Tab / Escape inside that tab are saved as web blocks with CSS selectors (no screen coordinates)."
        . "`n• Desktop clicks / typing that duplicate a web action are dropped; the address bar, other apps and"
        . "  cross-origin frames stay desktop steps. Password fields become 'ask each time' fills."
        . "`n`nNEW IN V15 (steadier playback):"
        . "`n• Each click / drag finds and resizes its window once, so there is less window flicker between steps."
        . "`n• 'Lock window size' now waits until the window really reaches its size (Esc stops the wait)."
        . "`n• 'Auto' speed watches the active window on whichever monitor it is on, not just the main screen."
        . "`n• New Variables block 'NDC from barcode scan': the tech scans a drug barcode and the 11-digit NDC (no dashes)"
        . "  goes into {{ndc}}, padded the right way using the FDA NDC list (downloaded once, then works offline)."
        . "`n`nNEW IN V14 (window-locked coordinates):"
        . "`n• Recorded clicks are saved relative to the window, not the screen, so moving the window never breaks them."
        . "`n• 'Lock window size' (on by default) puts each resizable window back to its recorded size / maximized state"
        . "  before clicking. If it can't (fixed dialogs, other monitor), spots follow the nearest window edge instead."
        . "`n• Clicks recorded in V13 or earlier keep their old coordinates - re-record or 'New picture' to upgrade them."
        . "`n`nNEW IN V10 (Classical Non-OCR / Non-Image Deterministic Engine):"
        . "`n• ZERO-OCR, ZERO-IMAGE DETERMINISTIC BLOCKS (in the left toolbox under 'V10 Deterministic (No OCR)'):"
        . "`n   1. Wait for Region CRC32 Change & Settle: hashes rectangle pixels via GDI BitBlt + ntdll\RtlComputeCrc32 in <0.3 ms."
        . "      Waits for the region to start changing, then until it stays unchanged for N ms (plus detects end-of-list!)."
        . "`n   2. Wait for / If Pixel Sentinel: 1-pixel state check (DiscernYellow, CernerDoorBlue, HighlightBlue, DisabledGrey, or NearHex)."
        . "`n   3. Anchor-Relative Click: clicks by dialog geometry (BottomCenter, TopRight, Proportional %) so resized windows never break."
        . "`n   4. Predict & Select List/Dropdown Row (Layout Physics): computes exact 1-based row and pixel Y from the app's sort/partition"
        . "      rules (e.g. Ticked A-Z first, then Unticked A-Z, plus conditional item shifts)."
        . "`n   5. Human-Physics Click (Minimum-Jerk / WindMouse + hover dwell) & Citrix-Safe Field Clear."
        . "`n   6. Press Ctrl+Shift+D (or click '🧭 Lab...') to open the live Deterministic Inspector & Layout Physics Lab!"
        . "`n`nV8 FEATURES (Smart Vary & 1-Click Auto-Loop):"
        . "`n• Hold Alt while clicking during recording (or press F7 / Ctrl+L) to turn any step into a loop with pixel stride, multi-spot,"
        . "  dynamic key repetition, or counter/column variables.",
        "Visual Macro Blocks V18 - help", "Iconi")
}


; Built-in non-destructive tests: --self-test "C:\path\report.txt"
V4_SelfTest(path) {
    rows := [], failures := 0
    check(name, actual, expected := true) {
        ok := actual = expected
        rows.Push((ok ? "PASS" : "FAIL") . " | " . name)
        if !ok
            failures += 1
    }
    rejects(name, callback) {
        caught := false
        try callback.Call()
        catch
            caught := true
        check(name, caught)
    }
    try {
        check("AutoHotkey major version", SubStr(A_AhkVersion, 1, 2), "2.")
        check("JSON quote/unicode roundtrip", JSON.Parse(JSON.Stringify(Map("x", "Hello `"world`" \ ä 😀")))["x"], "Hello `"world`" \ ä 😀")
        check("JSON booleans", V4_Bool(JSON.Parse("true")) && !V4_Bool(JSON.Parse("false")))
        check("JSON null roundtrip", JSON.Stringify(JSON.Parse("null")), "null")
        check("JSON arrays", JSON.Parse("[1,2,3]")[3], 3)
        rejects("Malformed JSON rejected", () => JSON.Parse('{"a":1,}'))
        rejects("Duplicate JSON keys rejected", () => JSON.Parse('{"a":1,"a":2}'))
        check("CSV quoted comma", V4_ParseDelimited('a,"b,c"`n1,2')[1][2], "b,c")
        check("CSV escaped quotes", V4_ParseDelimited('"a""b",c')[1][1], 'a"b')
        check("Variable validation", VMF_ValidVarName("input_value"))
        check("Reserved variable rejected", !VMF_ValidVarName("clipboard"))
        ctx := V4Runner(VMF_NewMacro(), {})
        ctx.Vars["name"] := "A&B"
        check("Placeholder expansion", ctx.Expand("Hello {{name}}"), "Hello A&B")
        node := V4_CreateNode("input_sendinput")
        check("SendInput is a leaf step", VMF_IsStep(node))
        check("SendInput validation", VM_Validate(Map("blocks", [node])).Length, 0)
        check("Basic input definitions", V4_InputDefs().Count, 8)
        rejects("Negative key delay rejected", () => V4_InputValidate(Map("type","input_keydelay","delay",-2,"duration",10)))
        rejects("External WebSocket endpoint rejected", () => V4Socket("ws://example.com:9222/devtools/page/test"))
        rejects("Invalid port rejected", () => V4_Port(80))
        webif := V4_CreateNode("web_if")
        check("Web IF is a container", VMF_IsContainer(webif) && webif["cond"] = "web")
        macro := VMF_NewMacro()
        macro["settings"]["onFail"] := "stop"
        macro["blocks"] := [Map("type","set","name","total","value",0),
            Map("type","repeat","count",3,"body",[Map("type","change","name","total","by",2)])]
        runner := V4Runner(macro, {})
        runner.Run(macro["blocks"])
        check("Repeat and variable execution", runner.Vars["total"], 6)
        ndcList := Map("0002322730", "0002-3227-30", "5024204062", "50242-040-62", "6050525191", "60505-2519-1")
        check("NDC 4-4-2 from 10 digits", NDC_Normalize("0002322730", ndcList).Ndc11, "00002322730")
        check("NDC 5-3-2 from UPC-A", NDC_Normalize("350242040620", ndcList).Ndc11, "50242004062")
        check("NDC 5-4-1 from GS1 DataMatrix", NDC_Normalize("]d2010036050525191717261231" . Chr(29) . "10AB12", ndcList).Ndc11,
            "60505251901")
        check("NDC 5-4-1 from (01) GTIN-14", NDC_Normalize("(01)00360505251917", ndcList).Ndc11, "60505251901")
        check("NDC typed with dashes", NDC_Normalize("0002-3227-30", Map()).Ndc11, "00002322730")
        check("NDC 11 digits passes through", NDC_Normalize("00002322730", Map()).Ndc11, "00002322730")
        unknown := NDC_Normalize("1234567890", ndcList)
        check("NDC not in list gives 3 readings", unknown.Ndc11 = "" && unknown.Choices.Length = 3
            && NDC_DashedTo11(unknown.Choices[2]) = "12345067890")
        rejects("Non-drug UPC rejected", () => NDC_Normalize("012345678905", ndcList))
        check("NDC block validates", VM_Validate(Map("blocks", [Map("type", "ndc", "name", "ndc", "source", "")])).Length, 0)
        ndcRun := V4Runner(VMF_NewMacro(), {})
        ndcRun.Vars["scan"] := "0002322730"
        NDC_List(false, ndcList)
        ndcRun.Run([Map("type", "ndc", "name", "ndc", "source", "{{scan}}")])
        NDC_List(true)
        check("NDC block sets variable", ndcRun.Vars.Get("ndc", ""), "00002322730")
        ; V5 step debugger: scripted keys instead of the keyboard; Log = the step numbers it paused at ("!" = failed).
        sample() => [Map("type","set","name","total","value",0),
            Map("type","repeat","count",2,"body",[Map("type","change","name","total","by",2)]),
            Map("type","set","name","done","value",1)]
        dbgRun(blocks, script, startMode := "step", runTo := 0) {
            m := VMF_NewMacro()
            m["blocks"] := blocks
            opts := {Debug: true, StartMode: startMode}
            if runTo
                opts.RunTo := runTo
            d := V5_Dbg()
            d.Script := script, d.Log := []
            r := V4Runner(m, opts)
            V5_DbgBegin(opts)
            try r.Run(m["blocks"])
            finally {
                missed := V5_DbgEnd()
                d.Script := 0
            }
            return {Runner: r, Log: V4_Join(d.Log, ","), Missed: missed}
        }
        res := dbgRun(sample(), ["step", "step", "step", "run"])
        check("Step into pauses before every block, each loop round", res.Log, "1,2,3,3")
        check("Stepping still runs every block", res.Runner.Vars["total"], 4)
        res := dbgRun(sample(), ["step", "over", "step"])
        check("Step over runs a whole loop without pausing", res.Log, "1,2,4")
        check("Step over still runs the loop", res.Runner.Vars["total"], 4)
        res := dbgRun(sample(), ["step", "step", "out", "step"])
        check("Finish block pauses after the loop", res.Log, "1,2,3,4")
        res := dbgRun(sample(), ["step", "step", "skip", "run"])
        check("Skip leaves that block out", res.Log . "|" . res.Runner.Vars["total"], "1,2,3,3|2")
        blocks := sample(), blocks[2]["body"][1]["breakpoint"] := 1
        res := dbgRun(blocks, ["run", "run"], "run")
        check("Breakpoint pauses every time it is reached", res.Log, "3,3")
        blocks := sample()
        res := dbgRun(blocks, ["run"], "run", blocks[3])
        check("Run to here pauses only at the chosen line", res.Log . "|" . res.Missed, "4|0")
        blocks := sample()
        res := dbgRun(blocks, [], "run", Map("type", "delay", "ms", 0))
        check("Run to an unreached line is reported", res.Log . "|" . res.Missed, "|1")
        res := dbgRun([Map("type","change","name","n","by","abc")], ["run", "skip"], "run")
        check("Failure waits in the bar: retry, then skip", res.Log . "|" . res.Runner.Skipped, "1!,1!|1")
        check("Plain runs never consult the debugger", V4Runner(VMF_NewMacro(), {}).Dbg, false)
        ; V6 element tree: the browser-free parts (selector builder, verdicts, wiring)
        built := [Map("group","attr","css",'[name="q"]'), Map("group","tag","css","input"),
            Map("group","class","css",".big"), Map("group","parent","css","form#f > ")]
        check("Element tree builder keeps CSS order", V6_ComposeSelector(built), 'form#f > input.big[name="q"]')
        check("Element tree builder adds the shadow prefix",
            V6_ComposeSelector([Map("group","class","css",".x")], "my-app >>> "), "my-app >>> .x")
        check("Element tree builder never yields an empty selector",
            V6_ComposeSelector([Map("group","inside","css","#main ")]), "#main *")
        verdict := V6_MatchText(Map("count",3,"pos",2,"error",""), true, 0, true)
        check("Several matches: the index follows the chosen element", verdict.Index, 2)
        verdict := V6_MatchText(Map("count",1,"pos",1,"error",""), true, 4, true)
        check("A unique match resets the index to 0", verdict.Index . "|" . verdict.Color, "0|107C10")
        verdict := V6_MatchText(Map("count",0,"pos",0,"error",""), true, 0, true)
        check("No match is reported in red", verdict.Color, "C00000")
        verdict := V6_MatchText(Map("count",2,"pos",0,"error",""), true, 1, true)
        check("Matches that miss the chosen element leave the index alone", verdict.Index, "")
        verdict := V6_MatchText(Map("count",2,"pos",0,"error",""), false, 0)
        check("Ambiguous without a chosen element is a warning", verdict.Color, "B25E00")
        verdict := V6_MatchText(Map("count",2,"pos",0,"error",""), false, 3)
        check("An index past the matches is an error", verdict.Color, "C00000")
        check("Element tree JS is embedded", InStr(V6_TreeJS(), "__VMB_V6_TREE") > 0 && InStr(V6_TreeJS(), "`"use strict`"") > 0)
        rejects("Element tree needs a connected tab", () => V6_ElementTree(Map("selector", "#x")))
        dbg := V5_Dbg(), dbg.Editing := true
        check("Step keys stand down while the element tree is open", !V5_DbgKeys() && !V5_DbgArrowKeys())
        dbg.Editing := false
        res := dbgRun([Map("type","set","name","n","value",1)], ["run"])
        check("Corrections flag starts clear", res.Runner.Changed, false)
        ; V7 Apple UX, ADHD Memory Hub & Prototyping HUD checks
        sampleCmds := [{Cat: "Action", Title: "Where Was I? (Memory & Files Hub)", Detail: "F1", Action: 0},
            {Cat: "Add: Loops", Title: "Repeat N times", Detail: "loop rounds", Action: 0}]
        check("V7 Command Palette multi-token filter", V7_FilterCommandItems(sampleCmds, "where memory").Length, 1)
        check("V7 Command Palette empty query returns all", V7_FilterCommandItems(sampleCmds, "").Length, 2)
        qlDesc := V7_DescribeNodePlain(Map("type", "click", "find", "spot", "scrX", 120, "scrY", 340, "button", "Left",
            "win", Map("exe", "notepad.exe", "title", "Test"), "note", "Submit button"))
        check("V7 Quick Look summary includes coordinates and note",
            InStr(qlDesc, "120, 340") > 0 && InStr(qlDesc, "Submit button") > 0 && InStr(qlDesc, "notepad.exe") > 0)
        apps := V7_CollectMacroApps([Map("type", "click", "win", Map("exe", "msedge.exe", "title", "")),
            Map("type", "text", "text", "hi", "win", Map("exe", "notepad.exe", "title", ""))])
        check("V7 ADHD Hub collects target apps", apps, "msedge.exe, notepad.exe")
        check("V7 privacy pre-check passes clean macro", !V7_HasPrivacyFindings(macro))
        ; V8 Smart Vary & Auto-Loop checks
        vRun := V4Runner(VMF_NewMacro(), {})
        vStep := Map("type", "click", "find", "spot", "scrX", 100, "scrY", 200, "varyDX", 10, "varyDY", 25, "winMatch", "active")
        vRun.LoopIndex := 1
        sh1 := V8_CalcPixelShift(vStep, vRun)
        vRun.LoopIndex := 4
        sh4 := V8_CalcPixelShift(vStep, vRun)
        check("V8 pixel shift round 1 is 0,0 and round 4 is +30,+75", sh1.DX . "," . sh1.DY . "|" . sh4.DX . "," . sh4.DY, "0,0|30,75")
        kStep := Map("type", "keys", "keys", "{Down}", "varyKey", 1, "varyKeyName", "Down", "varyKeyStart", 1, "varyKeyStep", 1)
        vRun.LoopIndex := 1
        k1 := V8_ResolveKeys(kStep, vRun)
        vRun.LoopIndex := 3
        k3 := V8_ResolveKeys(kStep, vRun)
        check("V8 dynamic key repetition scales per round", k1 . "|" . k3, "{Down 1}|{Down 3}")
        kStep0 := Map("type", "keys", "keys", "{Down}", "varyKey", 1, "varyKeyName", "Down", "varyKeyStart", 0, "varyKeyStep", 1)
        vRun.LoopIndex := 1
        check("V8 dynamic key repetition 0 on round 1 skips send", V8_ResolveKeys(kStep0, vRun), "")
        spStep := Map("type", "click", "find", "spot", "winMatch", "active",
            "varySpots", [Map("scrX", 10, "scrY", 20), Map("scrX", 30, "scrY", 40)])
        vRun.LoopIndex := 2
        spPt := V4_Spot(spStep, vRun)
        check("V8 multi-spot list picks spot #2 on round 2", spPt.X . "," . spPt.Y, "30,40")
        s1 := Map("type", "click", "scrX", 10, "scrY", 10)
        s2 := Map("type", "text", "text", "{{index}}")
        bList := [s1, s2]
        loopWrap := V8_AutoWrapInLoop(bList, s1, "repeat", 7)
        check("V8 AutoWrapInLoop wraps steps inside Repeat block",
            bList.Length = 1 && bList[1]["type"] = "repeat" && bList[1]["count"] = 7 && bList[1]["body"].Length = 2)
        V8_AutoWrapInLoop(bList, s1, "for", 12, "rowIdx", 1, 1)
        check("V8 AutoWrapInLoop updates existing loop without double-wrapping",
            bList.Length = 1 && bList[1]["type"] = "for" && bList[1]["to"] = 12 && bList[1]["name"] = "rowIdx")
        check("V8 summary badge describes pixel variation", InStr(V8_VarySummaryBadge(vStep), "+25px Y") > 0)
        ; V10 Classical Non-OCR / Non-Image Deterministic Engine checks
        check("V10 deterministic block definitions", V10_DetDefs().Count, 9)
        ancPt := V10_CalcAnchorPoint(693, 803, "BottomCenter", -41, -60, 50, 50, 100, 50)
        check("V10 BottomCenter anchor math (693x803, dx=-41, dy=-60 -> 305, 743)",
            ancPt.WinX . "," . ancPt.WinY . "|" . ancPt.ScreenX . "," . ancPt.ScreenY, "305,743|405,793")
        pctPt := V10_CalcAnchorPoint(800, 600, "ProportionalPct", 0, 0, 25, 75, 0, 0)
        check("V10 ProportionalPct anchor math (25%, 75% of 800x600 -> 200, 450)", pctPt.WinX . "," . pctPt.WinY, "200,450")
        check("V10 DiscernYellow pixel sentinel classifier",
            V10_MatchColorSentinel(0xFFFF80, "DiscernYellow") && !V10_MatchColorSentinel(0x404040, "DiscernYellow"))
        check("V10 CernerDoorBlue pixel sentinel classifier",
            V10_MatchColorSentinel(0x989AFF, "CernerDoorBlue") && !V10_MatchColorSentinel(0xFF0000, "CernerDoorBlue"))
        check("V10 NearHex pixel sentinel classifier",
            V10_MatchColorSentinel(0x107EB3, "NearHex", "107EB3", 10) && !V10_MatchColorSentinel(0x907EB3, "NearHex", "107EB3", 10))
        pred1 := V10_PredictListRow("541-INP-CARES",
            "541-INP-CARES`n541-INP-CLC`n541-INP-DOM`n541-INP-MAIN`n541-RX-CLINIC-IP",
            "541-INP-MAIN`n541-INP-CLC", "Partitioned_TickedFirst_AZ", "541-RX-CLINIC-IP", 175, 388, 17)
        check("V10 Partitioned sort places ticked items A-Z first, then unticked A-Z (541-INP-CARES -> Row 3, Y=422)",
            pred1.Row . "," . pred1.ClickY, "3,422")
        predCondOff := V10_PredictListRow("541-ZZZ-WARD",
            "541-INP-MAIN`n541-RX-CLINIC-IP`n541-ZZZ-WARD",
            "541-INP-MAIN", "Partitioned_TickedFirst_AZ", "541-RX-CLINIC-IP", 175, 388, 17)
        predCondOn := V10_PredictListRow("541-ZZZ-WARD",
            "541-INP-MAIN`n541-RX-CLINIC-IP`n541-ZZZ-WARD",
            "541-INP-MAIN`n541-RX-CLINIC-IP", "Partitioned_TickedFirst_AZ", "541-RX-CLINIC-IP", 175, 388, 17)
        check("V10 Conditional item omission shifts later rows up by 1 (Row 2 when unticked vs Row 3 when ticked)",
            predCondOff.Row . "|" . predCondOn.Row, "2|3")
        mjPath := V10_GenerateMousePath(10, 20, 310, 220, "MinimumJerk", 10)
        wmPath := V10_GenerateMousePath(10, 20, 310, 220, "WindMouse", 10)
        check("V10 MinimumJerk & WindMouse trajectories land on exact target coordinates",
            mjPath[mjPath.Length].X . "," . mjPath[mjPath.Length].Y . "|" . wmPath[wmPath.Length].X . "," . wmPath[wmPath.Length].Y, "310,220|310,220")
        detIf := V4_CreateNode("det_if_pixel")
        check("V10 det_if_pixel is a container with cond=pixel", VMF_IsContainer(detIf) && detIf["cond"] = "pixel")
        ; V13 settings panel rules + plain-English labels (no window needed)
        check("V13 keys meaning: Ctrl+A", V13_KeysMeaning("^{a}"), "Ctrl+A: select all")
        check("V13 keys meaning: repeat count", V13_KeysMeaning("{Tab 3}"), "Tab ×3: next field")
        check("V13 keys meaning: Alt+letter", V13_KeysMeaning("!{e}"), "Alt+E: app menu / shortcut letter E")
        check("V13 keys meaning: typed text then a key", V13_KeysMeaning("ab{Enter}"),
            'types "ab", then Enter: OK / submit / new line')
        check("V13 keys meaning: modifier order", V13_KeysMeaning("+^{Tab}"), "Ctrl+Shift+Tab: previous tab")
        v13Click := Map("type", "click", "find", "spot", "scrX", 5, "scrY", 6, "win", Map("exe", "a.exe", "title", ""))
