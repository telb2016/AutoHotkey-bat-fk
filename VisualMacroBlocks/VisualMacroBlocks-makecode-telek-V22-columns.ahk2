        check("V17 context menu is not a real window", V17_IsRealWindow("#32768", 0x94C80000, 0), false)
        check("V17 taskbar is not a real window", V17_IsRealWindow("Shell_TrayWnd", 0x96C00000, 0), false)
        check("V17 popup without a title bar is not a real window", V17_IsRealWindow("Chrome_WidgetWin_1", 0x96000000, 0), false)
        check("V17 tool window is not a real window", V17_IsRealWindow("MyPalette", 0x14CF0000, 0x80), false)
        check("V17 selector uses class + exe", V17_WindowSelector("CPRSChart.exe", "TfrmFrame"), "ahk_class TfrmFrame ahk_exe CPRSChart.exe")
        check("V17 selector skips a WPF per-run class", V17_WindowSelector("App.exe", "HwndWrapper[App.exe;;1a2b]"), "ahk_exe App.exe")
        check("V17 selector skips a WinForms class", V17_WindowSelector("x.exe", "WindowsForms10.Window.8.app.0.2bf8098_r6_ad1"), "ahk_exe x.exe")
        check("V17 selector skips a class with a long hex number", V17_WindowSelector("y.exe", "Afx:00400000:b"), "ahk_exe y.exe")
        check("V17 selector without exe uses the class", V17_WindowSelector("", "TfrmFrame"), "ahk_class TfrmFrame")
        check("V17 resizable = has a sizing border", V17_IsResizable(0x14CF0000) . V17_IsResizable(0x94C800C4), "10")
        v17Geo := {W: 800, H: 600, MarginX: 10, MarginY: -8, Max: false}
        v17Sw := V17_SwitchSteps("ahk_class #32770 ahk_exe a.exe", v17Geo)
        check("V17 new window: Use Window then Normalize", v17Sw.Length . v17Sw[1]["type"] . "," . v17Sw[2]["type"],
            "2det_use_window,det_normalize_win")
        check("V17 new window: Use Window targets it", v17Sw[1]["target"], "ahk_class #32770 ahk_exe a.exe")
        check("V17 new window: Normalize has its size and spot, blank target",
            v17Sw[2]["width"] . "x" . v17Sw[2]["height"] . "@" . v17Sw[2]["marginX"] . "," . v17Sw[2]["marginY"]
            . "|" . v17Sw[2]["maximize"] . "|" . v17Sw[2]["target"], "800x600@10,-8|0|")
        v17Back := V17_SwitchSteps("", 0)
        check("V17 back to a known window: only Use Window (blank = Macro window)", v17Back.Length . "|" . v17Back[1]["target"], "1|")
        v17Blocks := []
        v17Top := V17_TopNormalize(v17Blocks, "ahk_exe a.exe", true)
        check("V17 Pick window adds Normalize as step #1", v17Blocks.Length = 1 && v17Blocks[1] = v17Top)
        check("V17 Pick window reuses its own Normalize step", V17_TopNormalize(v17Blocks, "ahk_exe a.exe", true) = v17Top && v17Blocks.Length = 1)
        v17Blocks[1]["target"] := "ahk_exe b.exe"
        check("V17 a Normalize for another window is not reused", V17_TopNormalize(v17Blocks, "ahk_exe a.exe"), 0)
        check("V17 Normalize text", V17_NormText(Map("width", 800, "height", 600, "marginX", 10, "marginY", 20)), "800x600 at (10, 20)")
        check("V17 maximized Normalize text and tree info", V17_NormText(Map("maximize", 1)) . "|"
            . V10_DetStepInfo(Map("type", "det_normalize_win", "maximize", 1)), "maximized|maximized")
        check("V17 Normalize has a Maximize option, off by default", V10_DetDefs()["det_normalize_win"].Defaults["maximize"], 0)
        check("V17 size within 4 px is fine", V17_SizeNote(800, 600, 803, 597, true), "")
        check("V17 size note: minimum size", InStr(V17_SizeNote(800, 600, 900, 650, true), "minimum size") > 0)
        check("V17 size note: maximum size", InStr(V17_SizeNote(800, 600, 640, 480, true), "maximum size") > 0)
        check("V17 size note: fixed-size window", InStr(V17_SizeNote(800, 600, 500, 400, false), "fixed-size") > 0)
        check("V17 size note says the run kept going", InStr(V17_SizeNote(800, 600, 500, 400, true), "Kept going") > 0)
        v17Ctx := {Warnings: []}
        V17_Warn(v17Ctx, "test note")
        check("V17 size notes are kept on the run", v17Ctx.Warnings.Length, 1)
        check("V17 runner starts with no notes", V4Runner(VMF_NewMacro(), {}).Warnings.Length, 0)
        v17Kinds := ""
        for v17G in V17_EasyPaletteGroups()
            for v17I in v17G[2]
                v17Kinds .= v17I[2] . ","
        check("V17 Easy toolbox has exactly the 9 blocks", v17Kinds,
            "det_normalize_win,det_use_window,click,text,keys,det_citrix_fill,delay,repeat,ask,")
        v17F := V17_EasyFieldsFor("det_normalize_win")
        check("V17 Easy Normalize popup shows width + height only", v17F.Count . v17F.Has("width") . v17F.Has("marginX"), "210")
        check("V17 web blocks keep their full popup", V17_EasyFieldsFor("web_click"), "")
        check("V17 Easy click popup hides the coordinates", V17_EasyFieldsFor("click").Has("scrX"), false)
        v17Full := Map()
        for v17N in ["Record", "Stop", "Play", "Step", "PickWin", "EasyToggle", "Help", "New", "Open", "Recent", "Save", "SaveAs",
            "WinInfo", "lbl:HdrBlocks", "lbl:HdrMacro", "Undo", "Redo", "Search", "Pal", "TV", "ColHead", "Edit", "Delete", "Up", "Down", "In", "Out"]
            v17Full[v17N] := [100, 500, 50, 24]
        v17Full["Record"] := [10, 10, 105, 30], v17Full["Stop"] := [121, 10, 65, 30]
        v17Full["New"] := [10, 50, 56, 26], v17Full["lbl:HdrBlocks"] := [10, 200, 200, 20], v17Full["TV"] := [250, 230, 940, 400]
        v17L := V17_EasyLayout(v17Full)
        check("V17 Easy layout shows 27 controls (V22: + the column header)", v17L.Count, 27)
        check("V22 Easy layout moves the column header up with the tree", v17L["ColHead"][2], 500 - (200 - (50 + 26 + 14)))
        check("V17 Easy row 1: Stop right after Record", v17L["Stop"][1] . "," . v17L["Stop"][2], "121,10")
        check("V17 Easy row 1: Pick window on the top row", v17L["PickWin"][2] . "," . v17L["PickWin"][4], "10,30")
        check("V17 Easy layout moves the macro up under row 2", v17L["lbl:HdrBlocks"][2] . "," . v17L["TV"][2], "90,120")
        v13Work := v13Click.Clone()
        V13_InspSetField(v13Work, v13F[7], "250")
        check("V13 wait-before stores a number", v13Work["delayMs"], 250)
        V13_InspSetField(v13Work, v13F[7], "")
        check("V13 blank wait-before goes back to automatic", v13Work.Has("delayMs"), false)
        V13_InspSetField(v13Work, v13F[1], 1)
        check("V13 Find by picture removes the spot flag", v13Work.Has("find"), false)
        rejects("V13 rejects a non-number", () => V13_InspSetField(v13Work, v13F[4], "abc"))
        v13Rep := Map("type", "repeat", "count", 3, "body", [])
        rejects("V13 rejects Repeat 0 times", () => V13_InspSetField(v13Rep, V13_InspFields(v13Rep)[1], "0"))
        v13Web := V4_CreateNode("web_click")
        check("V13 web click panel uses the block's own fields", V13_InspFields(v13Web)[1].Key, "selector")
        check("V13 badges show wait and window", V13_StepBadges(Map("type", "keys", "delayMs", 200, "winMatch", "program",
            "win", Map("exe", "x.exe"))), "   ⏱ waits 200 ms first   ◇ any window of program")
        ; V12 multi-select editing, run on a hidden tree
        msS := VMB(), msOldGui := msS.Gui, msOldTV := msS.TV, msOldMacro := msS.Macro
        msGui := Gui()
        msS.Gui := msGui, msS.TV := msGui.AddTreeView("w300 h300 Checked")
        msMk(n) => Map("type", "delay", "ms", 1, "note", n)
        msNames(list) {
            out := ""
            for nd in list
                out .= (out = "" ? "" : ",") . (nd["type"] = "repeat" ? "L" : nd["note"])
            return out
        }
        msTick(nodes*) {
            msS.Checked := Map()
            for nd in nodes
                msS.Checked[nd] := 1
            VMB_Refresh()
        }
        ma := msMk("a"), mb := msMk("b"), mc := msMk("c"), mlp := Map("type", "repeat", "count", 2, "body", [])
        msS.Macro := VMF_NewMacro(), msS.Macro["blocks"] := [ma, mb, mc, mlp]
        msTick(ma, mb, mc, mlp)
        VMB_MoveNodes(VMB_TopTicked(), mlp["body"], 1)
        check("V12 multi: ticked lines drag into a ticked loop (loop itself skipped)",
            msNames(msS.Macro["blocks"]) . "|" . msNames(mlp["body"]), "L|a,b,c")
        msTick(ma, mb)
        VMB_Outdent()
        check("V12 multi: Outdent moves ticked lines out in order",
            msNames(msS.Macro["blocks"]) . "|" . msNames(mlp["body"]), "L,a,b|c")
        VMB_Indent()
        check("V12 multi: Indent moves ticked lines into the loop above",
            msNames(msS.Macro["blocks"]) . "|" . msNames(mlp["body"]), "L|c,a,b")
        VMB_MoveSelected(-1)
        check("V12 multi: Move up shifts the ticked run together", msNames(mlp["body"]), "a,b,c")
        msTick(ma)
        VMB_MoveSelected(1)
        check("V12 multi: Move down", msNames(mlp["body"]), "b,a,c")
        msTick(ma, mc)
        VMB_Duplicate()
        check("V12 multi: Duplicate puts copies after the ticked group", msNames(mlp["body"]), "b,a,c,a,c")
        msTick(mb, mc)
        VMB_Copy()
        msS.TV.Modify(msS.NodeItem[mlp], "Select")
        VMB_Paste()
        check("V12 multi: Copy / Paste ticked lines", msNames(mlp["body"]), "b,a,c,a,c,b,c")
        msTick(ma, mb)
        VMB_ToggleBreakpoint()
        check("V12 multi: Breakpoint toggles every ticked line",
            ma.Get("breakpoint", 0) && mb.Get("breakpoint", 0) && !mc.Get("breakpoint", 0))
        SetTimer(V7_AutoSaveNow, 0)
        msGui.Destroy()
        msS.Gui := msOldGui, msS.TV := msOldTV, msS.Macro := msOldMacro, msS.Checked := Map()
        source := FileRead(A_ScriptFullPath, "UTF-8")
        ; V18 one-click Record + Steady playback
        check("V18 new macros use Steady playback", VMF_NewMacro()["settings"].Get("steady", 0), 1)
        check("V18 a macro without the setting is not steady", V18_Steady(V4Runner(Map("settings", Map(), "blocks", []), {})), false)
        check("V18 a new macro's run is steady", V18_Steady(V4Runner(VMF_NewMacro(), {})), true)
        check("V18 no runner is not steady", V18_Steady(0), false)
        check("V18 old step-list macros stay as they were", VMF_FromSteps(Map("steps", []))["settings"].Has("steady"), false)
        check("V18 window wait defaults to 10 s", V18_WaitMs(V4Runner(VMF_NewMacro(), {})), 10000)
        check("V18 per-run window classes are not used to find a window",
            V18_ClassChanges("HwndWrapper[App.exe;;1a2b]") . V18_ClassChanges("WindowsForms10.Window.8.app.0.2bf8098_r6_ad1")
            . V18_ClassChanges("Afx:00400000:b") . V18_ClassChanges("Notepad") . V18_ClassChanges("#32770"), "11100")
        check("V18 screen text", RegExMatch(V18_ScreenText(), "^\d+x\d+ @ \d+%$") > 0)
        v18Win := Map("exe", "a.exe", "cls", "Main", "title", "")
        v18Click(x, y, gap, extra*) {
            node := Map("type", "click", "button", "Left", "count", 1, "scrX", x, "scrY", y, "gapMs", gap, "win", v18Win)
            Loop extra.Length // 2
                node[extra[A_Index * 2 - 1]] := extra[A_Index * 2]
            return node
        }
        v18Steps := [v18Click(100, 100, 900), v18Click(101, 99, 120, "_tick", 777), v18Click(300, 100, 100)]
        check("V18 double-click becomes one step", V18_TidySteps(v18Steps, 500) . "|" . v18Steps.Length . "|" . v18Steps[1]["count"]
            . "|" . v18Steps[1]["_tick"] . "|" . v18Steps[2]["count"], "1|2|2|777|1")
        v18Steps := [v18Click(100, 100, 0), v18Click(100, 100, 100), v18Click(100, 100, 100), v18Click(100, 100, 100)]
        check("V18 triple-click stops at 3", V18_TidySteps(v18Steps, 500) . "|" . v18Steps.Length . "|" . v18Steps[1]["count"], "2|2|3")
        v18Steps := [v18Click(100, 100, 0), v18Click(100, 100, 800)]
        check("V18 two slow clicks stay two steps", V18_TidySteps(v18Steps, 500) . "|" . v18Steps.Length, "0|2")
        v18Steps := [v18Click(100, 100, 0), v18Click(100, 100, 100, "button", "Right")]
        check("V18 left then right click stay two steps", V18_TidySteps(v18Steps, 500), 0)
        v18Steps := [v18Click(100, 100, 0), v18Click(100, 100, 100, "mods", "^")]
        check("V18 click then Ctrl+click stay two steps", V18_TidySteps(v18Steps, 500), 0)
        v18Steps := [v18Click(100, 100, 0), v18Click(100, 100, 100, "win", Map("exe", "b.exe", "cls", "Main", "title", ""))]
        check("V18 clicks in two programs stay two steps", V18_TidySteps(v18Steps, 500), 0)
        v18Steps := [v18Click(100, 100, 0, "type", "drag", "dx", 50, "dy", 0), v18Click(100, 100, 100)]
        check("V18 drag then click stay two steps", V18_TidySteps(v18Steps, 500), 0)
        v18Steps := [v18Click(100, 100, 0, "varyMarked", 1), v18Click(100, 100, 100)]
        check("V18 a step marked as varying is never joined", V18_TidySteps(v18Steps, 500), 0)
        v18Wheel(dir, gap) => Map("type", "wheel", "direction", dir, "count", 1, "gapMs", gap, "win", v18Win)
        v18Steps := [v18Wheel("WheelDown", 500), v18Wheel("WheelDown", 60), v18Wheel("WheelDown", 60), v18Wheel("WheelUp", 60),
            v18Wheel("WheelUp", 900)]
        check("V18 wheel notches join per direction and pause", V18_TidySteps(v18Steps, 500) . "|" . v18Steps.Length . "|"
            . v18Steps[1]["count"] . v18Steps[2]["count"] . v18Steps[3]["count"], "2|3|311")
        check("V18 tidy ignores a non-list", V18_TidySteps(0, 500), 0)
        v18Bmp(w, h, paint) {
            buf := Buffer(54 + w * h * 4, 0)
            NumPut("UShort", 0x4D42, "UInt", buf.Size, buf)
            NumPut("UInt", 54, buf, 10)
            NumPut("UInt", 40, "Int", w, "Int", -h, "UShort", 1, "UShort", 32, buf, 14)
            Loop w * h
                NumPut("UInt", paint.Call(Mod(A_Index - 1, w), (A_Index - 1) // w), buf, 54 + (A_Index - 1) * 4)
            return "V4BMP:" . V4_Base64(buf)
        }
        v18Blank := V18_PatchInfo(v18Bmp(40, 30, (x, y) => 0xFFFFFF))
        check("V18 picture size is read from the BMP", v18Blank.W . "x" . v18Blank.H, "40x30")
        check("V18 a blank picture is plain", v18Blank.Plain, true)
        check("V18 a field with a thin border is plain", V18_PatchInfo(v18Bmp(40, 30, (x, y) => y = 0 ? 0x808080 : 0xFFFFFF)).Plain, true)
        check("V18 a picture with content is not plain", V18_PatchInfo(v18Bmp(40, 30, (x, y) => Mod(x, 4) < 2 ? 0x000000 : 0xFFFFFF)).Plain, false)
        check("V18 a broken picture has no size and is never compared", V18_PatchInfo("V4BMP:AAAA").W . IsObject(V18_PatchInfo("V4BMP:AAAA").Buf), "00")
        ; a 60x50 "screen" with a striped 20x10 picture at (23, 17)
        v18Paint := (x, y) => Mod(x * 7 + y * 13, 5) < 2 ? 0x102030 : 0xE0E0E0
        v18Pic := V18_PatchInfo(v18Bmp(20, 10, v18Paint))
        v18Scr := Buffer(60 * 50 * 4, 0)
        Loop 60 * 50 {
            sx := Mod(A_Index - 1, 60), sy := (A_Index - 1) // 60
            inside := sx >= 23 && sx < 43 && sy >= 17 && sy < 27
            NumPut("UInt", inside ? v18Paint.Call(sx - 23, sy - 17) : 0xFFFFFF, v18Scr, (A_Index - 1) * 4)
        }
        check("V18 picture matches where it is", V18_PixelsMatch(v18Pic, v18Scr, 60, 23, 17), true)
        check("V18 picture does not match 5 px away", V18_PixelsMatch(v18Pic, v18Scr, 60, 28, 17), false)
        NumPut("UInt", 0x0000FF, v18Scr, (17 * 60 + 23) * 4), NumPut("UInt", 0x0000FF, v18Scr, (18 * 60 + 23) * 4)
        check("V18 a couple of odd pixels (text cursor) still match", V18_PixelsMatch(v18Pic, v18Scr, 60, 23, 17), true)
        Loop 8
            NumPut("UInt", 0x0000FF, v18Scr, ((17 + A_Index) * 60 + 30) * 4)
        check("V18 more than 2% different pixels do not match", V18_PixelsMatch(v18Pic, v18Scr, 60, 23, 17), false)
        NumPut("UInt", 0x152535, v18Scr, (20 * 60 + 40) * 4)
        v18Dim := Buffer(20 * 10 * 4, 0)
        Loop 200
            NumPut("UInt", v18Paint.Call(Mod(A_Index - 1, 20), (A_Index - 1) // 20) + 0x0A0A0A, v18Dim, (A_Index - 1) * 4)
        check("V18 slightly different shades match", V18_PixelsMatch(v18Pic, v18Dim, 20, 0, 0), true)
        check("V18 a shade outside the tolerance does not", V18_PixelsMatch(v18Pic, v18Dim, 20, 0, 0, 5), false)
        v18Live := V18_GrabPixels(SysGet(76), SysGet(77), 12, 9)
        check("V18 screen grab returns w x h pixels", IsObject(v18Live) ? v18Live.Size : 0, 12 * 9 * 4)
        check("V18 an empty box is not grabbed", V18_GrabPixels(0, 0, 0, 5), 0)
        v18Run := V4Runner(VMF_NewMacro(), {})
        v18Pt := {X: 5, Y: 6}
        check("V18 a click without a picture is not checked", V18_VerifySpot(Map("type", "click", "find", "spot"), 0, v18Run, v18Pt) = v18Pt)
        check("V18 a click that varies each round is not checked",
            V18_VerifySpot(Map("type", "click", "pattern", v18Bmp(8, 8, (x, y) => 0), "offsetX", 4, "offsetY", 4, "varyDY", 17), 0, v18Run, v18Pt) = v18Pt)
        v18Run.Settings["verifyClicks"] := 0
        check("V18 verifyClicks = 0 turns the picture check off",
            V18_VerifySpot(Map("type", "click", "pattern", v18Bmp(8, 8, (x, y) => 0), "offsetX", 4, "offsetY", 4), 0, v18Run, v18Pt) = v18Pt)
        check("V18 no modifiers held for a plain click", V18_ModsDown("").Length, 0)
        v18Gone := Map("type", "text", "text", "x", "win", Map("exe", "v18-no-such-program.exe", "cls", "Nope", "title", ""))
        v18Run := V4Runner(Map("settings", Map("steady", 1, "windowWaitSec", 0), "blocks", []), {})
        rejects("V18 steady: a step for a program that is not open stops", () => V4_Window(v18Gone, v18Run))
        check("V18 not steady: the same step still falls back to the active window", V4_Window(v18Gone) = WinExist("A"))
        rejects("V18 steady: a missing Macro window stops", () => V18_WaitTarget("ahk_exe v18-no-such-program.exe", v18Run))
        check("V18 steady: 'whatever is active' steps never wait", V4_Window(Map("type", "text", "winMatch", "active", "win", v18Gone["win"]), v18Run) = WinExist("A"))
        v18Run := V4Runner(Map("settings", Map("steady", 1, "recScreen", "1x1 @ 100%"), "blocks", []), {})
        V18_ScreenCheck(v18Run)
        check("V18 a different screen is noted", v18Run.Warnings.Length, 1)
        v18Run := V4Runner(Map("settings", Map("steady", 1, "recScreen", V18_ScreenText()), "blocks", []), {})
        V18_ScreenCheck(v18Run)
        check("V18 the same screen is not noted", v18Run.Warnings.Length, 0)
        v18Rec := VM_Rec(), v18Keep := [v18Rec.Active, v18Rec.Paused, v18Rec.Steps, v18Rec.Opts]
        v18Rec.Active := true, v18Rec.Paused := false, v18Rec.Steps := [], v18Rec.Opts := {}, v18Rec.Last := A_TickCount
        V17_RecWin().On := false, V17_RecWin().AutoPick := false
        if V4_RecordAllowed() {
            V4_RecordChar(0, "a"), V4_RecordChar(0, "`n"), V4_RecordChar(0, "`t"), V4_RecordChar(0, Chr(27)), V4_RecordChar(0, "b")
            check("V18 Enter / Tab / Esc characters are not recorded as typed text",
                v18Rec.Steps.Length . "|" . (v18Rec.Steps.Length ? v18Rec.Steps[1]["text"] : ""), "1|ab")
        }
        v18Rec.Active := v18Keep[1], v18Rec.Paused := v18Keep[2], v18Rec.Steps := v18Keep[3], v18Rec.Opts := v18Keep[4]
        v18Shot := V18_PreShot(), v18Old := [v18Shot.X, v18Shot.Y, v18Shot.Pattern, v18Shot.Left, v18Shot.Top, v18Shot.Tick, v18Shot.Used]
        v18Shot.X := 500, v18Shot.Y := 300, v18Shot.Pattern := "V4BMP:rest", v18Shot.Left := 480, v18Shot.Top := 285, v18Shot.Tick := 1000
        v18Step := Map("type", "click", "pattern", "V4BMP:press", "offsetX", 1, "offsetY", 1)
        check("V18 a click after a rest uses the resting-mouse picture", V18_UsePreShot(v18Step, 501, 300, 1200) . "|" . v18Step["pattern"]
            . "|" . v18Step["offsetX"] . "," . v18Step["offsetY"], "1|V4BMP:rest|21,15")
        v18Step := Map("type", "click", "pattern", "V4BMP:press")
        check("V18 a click somewhere else keeps its own picture", V18_UsePreShot(v18Step, 540, 300, 1200) . "|" . v18Step["pattern"], "0|V4BMP:press")
        check("V18 an old resting picture is not used", V18_UsePreShot(v18Step, 500, 300, 1500), 0)
        v18Shot.Pattern := ""
        check("V18 no resting picture: the click keeps its own", V18_UsePreShot(v18Step, 500, 300, 1200), 0)
        v18Shot.X := v18Old[1], v18Shot.Y := v18Old[2], v18Shot.Pattern := v18Old[3], v18Shot.Left := v18Old[4], v18Shot.Top := v18Old[5]
        v18Shot.Tick := v18Old[6], v18Shot.Used := v18Old[7]
        v18Box := V18_PatchBox(SysGet(76) + 100, SysGet(77) + 100)
        check("V18 picture box is 40x30 around the spot", (v18Box.Left - SysGet(76)) . "," . (v18Box.Top - SysGet(77)) . " " . v18Box.W . "x" . v18Box.H, "80,85 40x30")
        check("V19 size wait: reaches the size", V19_SizeVerdict([[0, 800, 600], [50, 850, 650], [100, 900, 700], [150, 900, 700]], 900, 700), "ok")
        check("V19 size wait: within 1 px counts", V19_SizeVerdict([[0, 800, 600], [50, 899, 701], [100, 900, 700]], 900, 700), "ok")
        check("V19 size wait: never moves = stuck", V19_SizeVerdict([[0, 800, 600], [100, 800, 600], [200, 800, 600], [300, 800, 600]], 900, 700), "stuck")
        check("V19 size wait: not moving for under 300 ms keeps waiting", V19_SizeVerdict([[0, 800, 600], [100, 800, 600], [250, 800, 600]], 900, 700), "")
        check("V19 size wait: moves then stops short = stuck",
            V19_SizeVerdict([[0, 800, 600], [50, 850, 650], [100, 880, 690], [200, 880, 690], [300, 880, 690], [400, 880, 690]], 900, 700), "stuck")
        check("V19 size wait: reaches the size on the last read only keeps waiting", V19_SizeVerdict([[0, 800, 600], [50, 850, 650], [100, 900, 700]], 900, 700), "")
        check("V19 size wait: no reads yet keeps waiting", V19_SizeVerdict([], 900, 700), "")
        check("V19 size wait: a window that is gone times out", V19_WaitSize("ahk_id 0x7FFFFFF0", 900, 700, 0, 200), "timeout")
        v19T := V19_TrialResult(800, 600, 860, 660, 800, 600)
        check("V19 size trial: a window that goes back holds", v19T.Holds . "|" . v19T.W . "x" . v19T.H . "|" . v19T.CanGrow, "1|800x600|1")
        check("V19 size trial: within 1 px still holds", V19_TrialResult(800, 600, 860, 660, 801, 599).Holds, 1)
        v19T := V19_TrialResult(803, 610, 900, 700, 800, 600)
        check("V19 size trial: a window that snaps does not hold", v19T.Holds . "|" . v19T.W . "x" . v19T.H, "0|800x600")
        check("V19 size trial: a window at its biggest size cannot grow", V19_TrialResult(800, 600, 800, 600, 800, 600).CanGrow, 0)
        check("V19 size trial: a window that is gone never blocks", V19_SizeTrial(0x7FFFFFF0).Holds, 1)
        v19N := Map("type", "det_normalize_win", "width", 800, "height", 600, "maximize", 0)
        check("V19 size trial: a closed window is skipped", V19_RunSizeTrials([{Hwnd: 0x7FFFFFF0, Node: v19N}]) . "|" . v19N.Get("sizeChecked", 0), "|0")
        check("V19 size trial: a maximized step is skipped", V19_RunSizeTrials([{Hwnd: 0, Node: Map("maximize", 1)}]), "")
        check("V19 size trial: an auto-picked window without a step is skipped", V19_RunSizeTrials([{Hwnd: 0, Node: 0}]), "")
        check("V19 size stop: the note loses 'Kept going.'",
            V19_MismatchText(V17_SizeNote(900, 700, 640, 480, true)), "stayed 640x480 instead of 900x700 (it has a maximum size or does not fit the screen, or the display scaling is different).")
        check("V19 size stop: other text is kept as it is", V19_MismatchText("stayed 1x1."), "stayed 1x1.")
        check("V19 size stop: new macros keep going (off by default)", VMF_NewMacro()["settings"].Get("sizeMismatch", ""), "")
        check("V19 scroll: no scroll bar cannot scroll", V19_CanScroll(0), false)
        check("V19 scroll: a long list can scroll", V19_CanScroll({Min: 0, Max: 299, Page: 30, Pos: 0}), true)
        check("V19 scroll: a list that fits on one page cannot", V19_CanScroll({Min: 0, Max: 29, Page: 30, Pos: 0}), false)
        check("V19 scroll: an empty bar cannot", V19_CanScroll({Min: 0, Max: 0, Page: 0, Pos: 0}), false)
        check("V19 scroll: a wanted spot inside the range is kept", V19_ClampScroll(150, 0, 299, 30), 150)
        check("V19 scroll: beyond the end is clamped to the last page", V19_ClampScroll(500, 0, 299, 30), 270)
        check("V19 scroll: before the start is clamped to the top", V19_ClampScroll(-5, 0, 299, 30), 0)
        check("V19 scroll: page 0 counts as 1", V19_ClampScroll(500, 0, 299, 0), 299)
        v19S := V19_ScrollStep(40, 40, 30, 0)
        check("V19 scroll step: already there", v19S.Done . "|" . v19S.Code, "1|8")
        v19S := V19_ScrollStep(40, 41, 30, 0)
        check("V19 scroll step: one line down", v19S.Done . "|" . v19S.Code, "0|1")
        check("V19 scroll step: one line up", V19_ScrollStep(41, 40, 30, 0).Code, 0)
        check("V19 scroll step: several pages down", V19_ScrollStep(0, 150, 30, 0).Code, 3)
        check("V19 scroll step: several pages up", V19_ScrollStep(150, 0, 30, 0).Code, 2)
        check("V19 scroll step: page 1 always steps by line", V19_ScrollStep(0, 150, 1, 0).Code, 1)
        check("V19 scroll step: stops after stepping over twice", V19_ScrollStep(10, 12, 30, 2).Done, 1)
        check("V19 scroll: a window without scroll bars reads 0", V19_ScrollInfo(0, 1), 0)
        check("V19 scroll: nothing off the screen scrolls", V19_CaptureScroll(-32000, -32000), "")
        check("V19 new macros restore the scroll position", VMF_NewMacro()["settings"].Get("restoreScroll", 0), 1)
        v19Run := V4Runner(Map("settings", Map("steady", 1, "restoreScroll", 0), "blocks", []), {})
        check("V19 restoreScroll = 0 skips it without a note",
            V19_RestoreScroll(Map("type", "click", "scroll", Map("cls", "Edit", "v", 5)), {X: -32000, Y: -32000}, v19Run) . "|" . v19Run.Warnings.Length, "0|0")
        v19Run := V4Runner(Map("settings", Map("steady", 1), "blocks", []), {})
        check("V19 a list that is not at the spot is noted",
            V19_RestoreScroll(Map("type", "click", "scroll", Map("cls", "Edit", "v", 5)), {X: -32000, Y: -32000}, v19Run) . "|" . v19Run.Warnings.Length, "0|1")
        ; V20 step lines
        check("V20 program name drops .exe", V20_AppName("Notepad.EXE") . "|" . V20_AppName(""), "Notepad|")
