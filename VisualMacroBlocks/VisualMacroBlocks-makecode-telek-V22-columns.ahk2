        check("V20 maximized Normalize line", V20_StepLine(Map("type", "det_normalize_win", "maximize", 1)), "Maximize the window")
        check("V20 Use Window lines", V20_StepLine(Map("type", "det_use_window", "target", "")) . "|" . V20_StepLine(Map("type", "det_use_window", "target", "ahk_class #32770 ahk_exe a.exe")),
