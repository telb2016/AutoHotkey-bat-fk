            v13Keys .= f.Key . ","
        check("V13 click panel fields", v13Keys, "find,button,count,scrX,scrY,variation,delayMs,winMatch,note,")
        check("V13 click meaning uses coordinates", V13_StepMeaning(v13Click), "click at screen spot (5, 6)")
        ; V14 window-locked coordinates
        check("V14 anchor picks: left / right / middle x", V14_PickAnchor(100, 1000, "x") . V14_PickAnchor(900, 1000, "x")
            . V14_PickAnchor(550, 1000, "x"), "LRP")
        check("V14 anchor picks: top rows, bottom bar", V14_PickAnchor(300, 800, "y") . V14_PickAnchor(760, 800, "y"), "TB")
        check("V14 axis math L / R / P (800 -> 1000 wide)", V14_Axis(100, 800, 1000, "L") . "," . V14_Axis(700, 800, 1000, "R")
            . "," . V14_Axis(400, 800, 1000, "P"), "100,900,500")
        check("V14 axis math bottom anchor shrinks with window", V14_Axis(570, 600, 500, "B"), 470)
        v14Click := Map("type", "click", "find", "spot", "scrX", 5, "scrY", 6,
            "geo", Map("cx", 40, "cy", 20, "cw", 800, "ch", 600, "ww", 816, "wh", 639, "max", 0, "ax", "R", "ay", "T"))
