        check("V20 typed text with a column", InStr(V20_StepLine(Map("type", "text", "text", "{{Name}}")), 'Type "{{Name}}"  (the {{...}} part is filled in each round)') = 1)
        check("V20 ask-each-run text never shows text", V20_StepLine(Map("type", "text", "text", "secret", "ask", 1)), "Type what you answer when asked (each run)")
        check("V20 keys in words", V20_StepLine(Map("type", "keys", "keys", "^{a}", "win", v20Win)), "Press Ctrl+A (select all) in notepad")
        check("V20 several keys", V20_KeysText("{Tab 3}{Enter}"), "Tab ×3 (next field), then Enter (OK / submit / new line)")
        check("V20 wheel line", V20_StepLine(Map("type", "wheel", "direction", "WheelDown", "count", 3, "win", v20Win)), "Scroll down 3 notches in notepad")
        check("V20 delay line", V20_StepLine(Map("type", "delay", "ms", 1500)), "Wait 1.5 s")
        check("V20 times", V20_Time(500) . "|" . V20_Time(1500) . "|" . V20_Time(2000) . "|" . V20_Time(2440) . "|" . V20_Time(12040), "500 ms|1.5 s|2 s|2.4 s|12 s")
        check("V20 Normalize line", V20_StepLine(Map("type", "det_normalize_win", "width", 520, "height", 360, "marginX", 60, "marginY", 40)),
