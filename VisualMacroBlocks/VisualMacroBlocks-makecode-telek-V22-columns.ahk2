        check("V14 click meaning uses window spot", V13_StepMeaning(v14Click), "click at window spot (40, 20) from top-right")
        check("V14 lock skipped without a run", V14_LockWindow(v14Click, 1, 0), false)
        check("V14 new macros lock window size", VMF_NewMacro()["settings"]["lockWindowSize"], 1)
        winCtx := {Settings: Map("defaultTarget", "ahk_exe a.exe"), UseTarget: "", Expand: (this, v) => v}
        check("V16 blank step uses Macro window", V16_FallbackTarget(winCtx), "ahk_exe a.exe")
        winCtx.UseTarget := "ahk_exe b.exe"
        check("V16 Use Window overrides Macro window", V16_FallbackTarget(winCtx), "ahk_exe b.exe")
        check("V16 Use Window block is in the palette", V10_DetDefs().Has("det_use_window"))
        v15Pt := V4_Spot(Map("type", "click", "find", "spot", "scrX", 5, "scrY", 6), 0, 0)
        check("V15 spot uses the window it is given (no second lookup)", v15Pt.X . "," . v15Pt.Y, "5,6")
        v16Desk := [Map("type", "click", "_tick", 1000, "gapMs", 1000, "win", Map("exe", "msedge.exe")),
            Map("type", "click", "_tick", 5000, "gapMs", 4000, "win", Map("exe", "notepad.exe")),
            Map("type", "text", "text", "hi", "_tick", 6000, "gapMs", 1000, "win", Map("exe", "msedge.exe")),
            Map("type", "click", "_tick", 20000, "gapMs", 14000, "win", Map("exe", "msedge.exe"))]
