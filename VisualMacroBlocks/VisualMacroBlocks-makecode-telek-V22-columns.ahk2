            throw Error("CDP request exceeds the 4 MB send limit.")
        offset := size < 126 ? 2 : size <= 65535 ? 4 : 10
        frame := Buffer(offset + 4 + size, 0)
        NumPut("UChar", 0x80 | opcode, "UChar", 0x80 | (size < 126 ? size : size <= 65535 ? 126 : 127), frame)
        if size >= 126 {
            bytes := offset - 2
            Loop bytes
                NumPut("UChar", (size >> ((bytes - A_Index) * 8)) & 255, frame, A_Index + 1)
        }
        mask := V4_RandomBytes(4)
        DllCall("RtlMoveMemory", "Ptr", frame.Ptr + offset, "Ptr", mask, "UPtr", 4)
        Loop size
            NumPut("UChar", NumGet(data, A_Index - 1, "UChar") ^ NumGet(mask, Mod(A_Index - 1, 4), "UChar"),
                frame, offset + 3 + A_Index)
