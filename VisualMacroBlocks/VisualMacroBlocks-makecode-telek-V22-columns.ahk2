        check("V20 caption cleaned", V20_CleanCaption("&Save As...`tCtrl+Shift+S") . "|" . V20_CleanCaption("Fish && Chips") . "|" . V20_CleanCaption("one`r`ntwo"),
            "Save As...|Fish & Chips|one")
        check("V20 long caption shortened", StrLen(V20_CleanCaption("a very long caption that goes on and on and on forever")), 40)
        check("V20 kinds", V20_KindOf("Button", 0x50010000).Kind . "," . V20_KindOf("Button", 0x50010003).Kind . "," . V20_KindOf("Button", 0x50000009).Kind
            . "," . V20_KindOf("Edit").Kind . "," . V20_KindOf("SysListView32").Kind . "," . V20_KindOf("TBitBtn").Kind . "," . V20_KindOf("#32768").Kind
            . "," . V20_KindOf("SomethingElse").Kind, "button,tick box,option,text box,list,button,menu item,")
        check("V20 only button-like captions may be shown", V20_KindOf("Button", 0).Caption . V20_KindOf("TCheckBox").Caption . V20_KindOf("Edit").Caption
            . V20_KindOf("ListBox").Caption . V20_KindOf("Static").Caption, "11000")
        check("V20 frame parts", V20_FramePart(2) . "," . V20_FramePart(20) . "," . V20_FramePart(5) . "," . V20_FramePart(12) . "," . V20_FramePart(1),
